# HEADROOM, not a workaround. This project is the harness tools/esp_run.sh and
# tools/esp_flash.sh link arbitrary programs into, so it should not be the
# thing that fails when someone hands it a deeply recursive one. The stock
# 3584-byte stacks DO work for ordinary code since windowed frames stopped
# costing a flat 256 bytes each (bug-a-xtensa-windowed-frame-minimum-256-bytes);
# a normal project of your own needs no such line.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192

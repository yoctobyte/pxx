# SPDX-License-Identifier: 0BSD
# A static Python application for the ESP32-C3, the ESP32-S3 and the classic
# ESP32 (nilpy-c3, nilpy-s3 and nilpy-esp32 share this file by symlink):
# a class, a list, a loop and print, compiled by pxx straight to an object and
# linked by the normal ESP-IDF build. No interpreter on the chip -- this IS
# the machine code.
# Its output is CPython's own, byte for byte (build.sh qemu-assert checks).

class Boat:
    def __init__(self, name, speed):
        self.name = name
        self.speed = speed

    def eta(self, dist):
        return dist // self.speed

def main():
    fleet = [Boat("Aurora", 6), Boat("Wind", 8), Boat("Kees", 5)]
    total = 0
    for b in fleet:
        t = b.eta(120)
        total += t
        print(b.name, t)
    print("total", total, len(fleet))

main()

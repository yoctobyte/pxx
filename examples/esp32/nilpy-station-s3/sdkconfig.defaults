CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 32 KiB: at 16 KiB an interpreted lambda call (~10 KiB of windowed frames)
# on top of a large module body (8 KiB of per-statement temps) overflowed
# the main task on silicon (test_nilpy_wide_call_through_a_callable_value).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_WL_SECTOR_SIZE_4096=y

# Three shapes from a real application:
#  - a METHOD delegating to the module-level function it shadows: in Python a
#    bare name is never a method, so this is the function, not itself;
#  - str.format with a spec;
#  - a QUALIFIED exception class in an except clause.
import tkinter as tk


def act():
    return "module function"


class C:
    def act(self):
        return act()


print(C().act())
print("Tap BPM: {:.1f}".format(92.456))

try:
    raise tk.TclError("clipboard")
except tk.TclError as e:
    print("caught:", e)

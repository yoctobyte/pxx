# An event callback's Event object and the widgets winfo_children() returns are
# released once nothing refers to them. Both were boxed with an extra retain on
# top of the reference the Variant owns, so every <Configure> leaked an Event
# and its strings, and every winfo_children() leaked each child and its path
# (pin v451: live grew by 3 per event and by 2 per child per call). Needs a
# display: the suite runs it under Xvfb. `keep` holds the results, the positive
# control: it must trip the bound.
import sys
import tkinter as tk

mode = sys.argv[1] if len(sys.argv) > 1 else "drop"
n = int(sys.argv[2]) if len(sys.argv) > 2 else 300
count = 0
kept = []


def on_conf(event):
    global count
    count += 1
    if mode == "keep":
        kept.append(event)


root = tk.Tk()
f = tk.Frame(root, width=100, height=100)
f.pack()
f.bind("<Configure>", on_conf)
for j in range(3):
    tk.Label(f, text="x")
root.update()
seen = 0
for i in range(n):
    f.configure(width=100 + (i % 2) * 10)
    root.update()
    kids = f.winfo_children()
    seen += len(kids)
    if mode == "keep":
        kept.append(kids)
kids[0].destroy()
print(count > 0, seen, len(f.winfo_children()))
root.destroy()

# hello.npy — a Tk window from Nil-Python, via the thin `lib/pcl/tk.pas` embed.
#
# The whole GUI is Tcl/Tk command strings through TkEval — the CPython-tkinter
# model, minus tkinter's weight. The unit binds the system libtcl/libtk 8.6
# directly (no -dev headers, no wrapper boilerplate). Build:
#   pxx -Fulib/pcl examples/tk/hello.npy hello  &&  xvfb-run -a ./hello
# `tk` is a PASCAL unit, so it is named with its extension: a bare NilPy import
# resolves to Python (.py/.npy) only, plus a curated list of units WRITTEN TO BE
# the Python module of that name
# (decide-nilpy-imports-that-collide-with-a-pascal-rtl-unit, user 2026-08-19).
# `lib/pcl/tk.pas` is deliberately not on that list: its own header calls it the
# layer to build a tkinter-shaped surface ON TOP OF, and `lib/pcl/tkinter.pas`
# is the one written to BE the Python module. Keeping `tk` off the list also
# means a program that has `pip install tk`'d (the PyPI package exists) gets its
# own module rather than silently binding to this Tcl/Tk embed.
import 'tk.pas' as tk

def main() -> None:
    if not TkInit():
        print("TkInit failed")
        return
    TkEval("wm title . {hello}")
    TkEval("label .l -text {hello tk from nilpy}")
    TkEval("pack .l -padx 40 -pady 20")
    TkEval("after 400 {destroy .}")   # auto-close so a headless smoke terminates
    TkMainLoop()
    print("ok: nilpy tk window shown and closed")

main()

# Callable options: a bound method, a plain def and a lambda all reach Tk, and a
# variable trace fires. Compiled by the suite, run under Xvfb by hand — it needs
# a display. See feature-nilpy-tk-callbacks.
import tkinter as tk
from tkinter import BooleanVar, StringVar


def on_plain(event):
    print("plain", event.width)


class App:
    def __init__(self, root):
        self.hits = 0
        self.frame = tk.Frame(root, width=200, height=100)
        self.frame.bind("<Configure>", self.on_configure)
        self.frame.bind("<Enter>", on_plain, add="+")
        # a lambda whose body is a CALL is LIFTED to a real proc: `self` is
        # bound as a capture and the method call compiles, so keyword args bind
        # by name and no interpreter runs in the callback
        # (feature-nilpy-lambda-compiled-closure)
        self.frame.bind("<Configure>", lambda event: self.on_lifted(event), add="+")
        self.frame.pack(fill="both", expand=True)
        self.flag = BooleanVar(value=False)
        self.flag.trace_add("write", lambda *args: print("trace fired"))
        # an Entry's textvariable is a StringVar, so the trace an editable
        # field uses is THIS one — it had no trace_add at all, and an
        # unresolved method compiles clean and jumps to 0.
        self.text = StringVar(value="a")
        self.text.trace_add("write", lambda *args: print("str trace fired"))
        # a canvas item is named by its id OR by a tag: bbox("all") is the
        # commonest call in the widget and an Integer parameter refused it.
        self.canvas = tk.Canvas(root, width=50, height=50)
        self.canvas.create_rectangle(1, 1, 10, 10)
        # scroll wiring: Python passes the other widget's own METHOD, and Tk is
        # wired straight to it (a bound method into a string option used to
        # produce a garbage Tcl script, which hung the event loop)
        self.bar = tk.Scrollbar(root, orient="vertical", command=self.canvas.yview)
        self.canvas.configure(yscrollcommand=self.bar.set)

    def on_lifted(self, event):
        print("lifted", event.width, event.height)

    def on_configure(self, event):
        self.hits = self.hits + 1
        print("configure", event.width, event.height)


root = tk.Tk()
app = App(root)
root.update()
app.flag.set(True)
app.text.set("b")
root.update()
print("bbox", app.canvas.bbox("all"))
print("hits", app.hits)

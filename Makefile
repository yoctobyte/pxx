	    tools/expect_same.sh $$arch/test_feaddr_$$arch "$$(tools/run_target.sh $$arch $(TESTTMP)/test_feaddr_$$arch)" "FLOAT-ELEM-ADDR OK checked=11" \
	      || { echo "cross float-element address FAIL on $$arch"; exit 1; }; \

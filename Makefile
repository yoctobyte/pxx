	tools/expect_same.sh test_nestdynres26 "$$($(TESTTMP)/test_nestdynres26)" "$$(cat test/test_a_nested_dynamic_array_result.expected)"
	# `Length('ab' + s)` was a PARSE ERROR while `Length(s + 'ab')` compiled: the

	    || { echo "FAIL: StrToFloat diverges from CPython"; exit 1; }; \
	else echo "  lib-test: python3 absent, skipping the StrToFloat oracle diff"; fi
	# The `six` shim (feature-nilpy-six-and-warnings-shims). A DIFFERENTIAL:

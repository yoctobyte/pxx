	tools/expect_same.sh i386/test_cdecl_wide "$$(tools/run_target.sh i386 $(TESTTMP)/test_cdecl_wide_i386)" "CDECL-WIDE OK checks=3"
	@if command -v qemu-riscv32 >/dev/null 2>&1; then \

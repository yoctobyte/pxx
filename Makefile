	PXXDBG='a.reload:*' ./$(COMPILER) -O3 test/test_opt_store_reload.pas $(TESTTMP)/test_opt_sr_O3c 2>&1 | grep 'a.reload DECLINED' > $(TESTTMP)/test_opt_sr_declined.log

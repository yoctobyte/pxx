	# deleted the call and every "the arm is gone" row still passed.
	# $(COMPILER), not $(PXX_STABLE): the pin has no such fold.
	# feature-c-corpus-busybox-multi-applet
	./$(COMPILER) test/c_and_zero_dead_arm.c $(TESTTMP)/c_andzero26

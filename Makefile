	# <linux/loop.h> and <asm/unistd.h>. THIS TEST EXISTS FOR ONE TYPE:
	# __kernel_old_dev_t has THREE widths and its name says nothing about which
	# -- `unsigned long' on x86-64, `unsigned short' on i386, `unsigned int' for

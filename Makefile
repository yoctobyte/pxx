	./$(COMPILER) --target=wasm32 test/test_frozen_string_cross_b305.pas $(TESTTMP)/w32_b305.wasm
	./$(COMPILER) test/test_frozen_string_cross_b305.pas $(TESTTMP)/w32_b305_x64

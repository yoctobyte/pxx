	tools/expect_same.sh test_erlang_skeleton26 "$$($(TESTTMP)/test_erlang_skeleton26)" "$$(printf 'fact(5) is 120\nfib(10) is 55\nclassify: 1 2 3 4\ndiv gives 5 rem 1')"

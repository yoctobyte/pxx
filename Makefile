	  cd $(TESTTMP) && ./lib_settextbuf_fpc > lib_settextbuf.oracle || { echo "lib_settextbuf: the FPC oracle FAILED to run"; exit 1; }; \
	else \
	  echo "SKIP lib_settextbuf -- fpc absent, no oracle"; echo settextbuf >> $(TESTTMP)/lib-test.skipped; \
	fi

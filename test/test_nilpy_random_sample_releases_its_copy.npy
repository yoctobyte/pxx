# random.sample copies the population and builds a new list; both must be
# released. `drop` discards each sample, `keep` holds them all (the positive
# control: its live count must grow with the loop).
import random
import sys

mode = sys.argv[1] if len(sys.argv) > 1 else "drop"
n = int(sys.argv[2]) if len(sys.argv) > 2 else 5000
pop = [1, 2, 3, 4, 5, 6, 7, 8]
kept = []
total = 0
for i in range(n):
    s = random.sample(pop, 3)
    total += len(s)
    if mode == "keep":
        kept.append(s)
print(total)

# An escaping closure's captures are LIFTED onto its signature, so a call
# through the bound-fn bridge passes own-params + captures as one argument list.
# The bridge had a type per arity with GAPS in it (no 10, no 12, nothing past
# 13) and rounded UP to the next one it had — a 10-parameter body called
# through an 11-argument type. That does not degrade, it SEGFAULTS, so every
# closure landing on a missing arity crashed: uforth's MARKER (1 own + 11
# captures) took the ANS coreext and block word sets down with it. Past 12
# bound values the frontend gave up entirely and emitted the bare code address,
# which reads captures out of the dead parent frame.
# bug-nilpy-uforth-ans-word-set-suite-4-of-13-open
# Every expectation here is CPython's own output.

# One closure per capture count across the whole supported range (the ceiling
# is PY_MAX_CAPS = 20 bound values). The counts that used to crash are 9, 11,
# and everything from 13 up; the neighbours are here to keep the boundary
# honest rather than testing only the broken cells.
def mk8(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    def inner(v):
        return v + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8
    return inner

def mk9(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    s9 = a + 9
    def inner(v):
        return v + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9
    return inner

def mk11(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    s9 = a + 9
    s10 = a + 10
    s11 = a + 11
    def inner(v):
        return v + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11
    return inner

def mk13(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    s9 = a + 9
    s10 = a + 10
    s11 = a + 11
    s12 = a + 12
    s13 = a + 13
    def inner(v):
        return v + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11 + s12 + s13
    return inner

def mk20(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    s9 = a + 9
    s10 = a + 10
    s11 = a + 11
    s12 = a + 12
    s13 = a + 13
    s14 = a + 14
    s15 = a + 15
    s16 = a + 16
    s17 = a + 17
    s18 = a + 18
    s19 = a + 19
    s20 = a + 20
    def inner(v):
        return (v + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10
                + s11 + s12 + s13 + s14 + s15 + s16 + s17 + s18 + s19 + s20)
    return inner

print(mk8(100)(7))
print(mk9(100)(7))
print(mk11(100)(7))
print(mk13(100)(7))
print(mk20(100)(7))

# TWO own parameters on top of the captures — own args come first, so this
# lands on a different arity than the one-argument shape above.
def mk11two(a):
    s1 = a + 1
    s2 = a + 2
    s3 = a + 3
    s4 = a + 4
    s5 = a + 5
    s6 = a + 6
    s7 = a + 7
    s8 = a + 8
    s9 = a + 9
    s10 = a + 10
    s11 = a + 11
    def inner(v, w):
        return v + w + s1 + s2 + s3 + s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11
    return inner

print(mk11two(100)(7, 8))

# The uforth MARKER shape itself: a closure stored on an object's Callable-typed
# field, called long after the enclosing call returned, and mutating the object
# it is handed. 1 own parameter + 11 captures = the arity that crashed.
class VM:
    def __init__(self):
        self.a = 0
        self.b = 0
        self.c = 0
        self.here = 0

class Word:
    def __init__(self, name, native=None):
        self.name = name
        self.native = native

def snapshot(vm, table):
    s1 = vm.a
    s2 = vm.b
    s3 = vm.c
    s4 = vm.here
    s5 = vm.here + 1
    s6 = vm.here + 2
    s7 = vm.here + 3
    s8 = vm.here + 4
    s9 = vm.here + 5
    s10 = vm.here + 6
    s11 = vm.here + 7
    def restore(v):
        v.a = s1
        v.b = s2
        v.c = s3
        v.here = s4 + s5 + s6 + s7 + s8 + s9 + s10 + s11
    table["M"] = Word("M", native=restore)

vm = VM()
vm.a = 1
vm.b = 2
vm.c = 3
vm.here = 10
table = {}
snapshot(vm, table)
vm.a = 99
vm.b = 99
vm.c = 99
vm.here = 99
w = table["M"]
w.native(vm)
print(vm.a, vm.b, vm.c, vm.here)

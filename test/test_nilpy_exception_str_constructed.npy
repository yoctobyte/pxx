# bug-nilpy-exception-str-and-repr-diverge-from-cpython — the str() half
#
# `str(ValueError("v"))` on an exception that was CONSTRUCTED and never raised
# gave `<__main__.ValueError object at 0x...>`, while a CAUGHT one gave its
# message — two paths disagreeing about the same object. An address is also not
# stable run to run, so nothing could pin it.
#
# Both routes are asserted side by side here, which is the point: fixing the
# constructed one while leaving the caught one alone is exactly the kind of
# divergence that produced the bug.
#
# The user-__str__ case was parked here as "NOT asserted, filed separately" and
# is now fixed and asserted at the bottom
# (bug-nilpy-user-str-dunder-on-an-exception-subclass-is-ignored). It was not one
# short-circuit but THREE copies of the same Exception-then-dunder decision —
# print(), str() and the f-string's pystr_of — each with the Exception/.msg arm
# FIRST. Fixing one moved print(e) and left str(e) and f-strings wrong, which is
# why they are now one routine (PyClassStrNode) and why every route is asserted
# below rather than the one that was reported.
#
# NOT asserted either: KeyError, whose message is stored already repr'd and so
# cannot be rendered correctly from a Message alone until `e.args` exists — see
# the ticket.
#
# Expectations are CPython's own output.

class MyErr(Exception):
    pass

for e in [ValueError("v"), TypeError("t"), MyErr("m"), Exception("x")]:
    print(str(e), "|", repr(e), "|", "%s" % e)
print(str(ValueError()), "|", repr(ValueError()))
try:
    raise ValueError("caught")
except ValueError as e:
    print(str(e), repr(e))
try:
    raise MyErr("mine")
except Exception as e:
    print(str(e), type(e).__name__)
print("msg: " + str(ValueError("concat")))

# --- a user __str__ / __repr__ on an Exception subclass, through EVERY route.
# The routes must agree; disagreeing routes are what this whole file is about.

class WithStr(Exception):
    def __str__(self):
        return "CUSTOM-STR"

class WithRepr(Exception):
    def __repr__(self):
        return "CUSTOM-REPR"

class Sub(WithStr):
    pass

ws = WithStr("ignored")
print("str  ", str(ws))
print("print", ws)
print("fstr ", f"{ws}")
print("pct  ", "%s" % ws)
print("inherited", str(Sub("ignored")))
print("repr ", repr(WithRepr("ignored")))
try:
    raise WithStr("ignored")
except WithStr as e:
    print("caught", str(e))

# CONTROL: an exception declaring NEITHER dunder still renders its message, so
# the reordering did not cost the .msg fallback this file's top half pins.
class NoDunder(Exception):
    pass
print("nodunder", str(NoDunder("plain")), "|", "%s" % NoDunder("plain"))

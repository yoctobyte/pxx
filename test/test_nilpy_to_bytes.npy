b = (10).to_bytes(8, "little", signed=True)
print(len(b))
print(b[0])
print(b[1])
print(int.from_bytes(b, "little", signed=True))
n = -2
c = n.to_bytes(8, 'little', signed=True)
print(c[0])
print(c[7])
print(int.from_bytes(c, 'little', signed=True))
d = (255).to_bytes(2, "little", signed=False)
print(d[0])
print(d[1])
print(int.from_bytes(d, "little", signed=False))
e = (-1).to_bytes(1, "little", signed=True)
print(int.from_bytes(e, "little", signed=True))
print(int.from_bytes(e, "little", signed=False))

# bug-nilpy-to-bytes-on-a-variant-receiver-does-not-compile
#
# Everything above has a STATICALLY int receiver. The intrinsic was gated on
# exactly that, so a VARIANT one — an untyped parameter, a container element,
# `int(x)` where x is dynamic — fell through to closed-world class dispatch and
# died at COMPILE time with "no class declares a method or callable field
# .to_bytes()", which reads as a missing user class rather than a missing
# intrinsic. It is what stopped the uforth corpus compiling at all, at its
# `int(value).to_bytes(8, "little", signed=True)`.
#
# The intrinsic now accepts a variant receiver and unboxes it with pyvar_to_int.
# It declines when any user class declares `to_bytes`, so it can never shadow a
# real method — that case is unchanged from before and is covered separately in
# test_nilpy_to_bytes_user_class_wins.npy.


def via_untyped_param(v):
    return v.to_bytes(8, "little", signed=True)


def via_int_call(v):
    return int(v).to_bytes(8, "little", signed=True)


# an untyped parameter is a variant
p = via_untyped_param(300)
print(len(p))
print(p[0])
print(p[1])
print(int.from_bytes(p, "little", signed=True))

# int() of a dynamic value — the uforth shape
q = via_int_call(300)
print(int.from_bytes(q, "little", signed=True))

# a container element is a variant too
vals = [1, 258]
r = vals[1].to_bytes(4, "little", signed=True)
print(len(r))
print(int.from_bytes(r, "little", signed=True))

# negative through the variant path
print(int.from_bytes(via_untyped_param(-2), "little", signed=True))


# bug-n-int-bit-length-is-not-implemented
#
# `.bit_length()` / `.bit_count()` join `.to_bytes(` in the SAME intercept, so
# they live in the same test. The three intercept sites (the lvalue member
# path, ParseFactor's suffix loop, the postfix-chain loop) are now name-driven
# via PyIsIntMethodName rather than each carrying a `= 'to_bytes'` literal, so
# every receiver shape exercised above must work for these too.
#
# Both are defined on the MAGNITUDE — the sign is ignored — and both take a
# Variant so an arbitrary-precision receiver stays EXACT: an Int64 parameter
# would narrow `2**70` mod 2^64 and answer confidently wrong, the trap
# pyvar_to_float records. (2**70).bit_length() is 71, not a machine-int answer.

print(int("42").bit_length())
print((255).bit_length(), (0).bit_length(), (-8).bit_length())
print((1).bit_length(), (2).bit_length(), (3).bit_length())

# arbitrary precision — the machine-int path would be wrong for all of these
print((2 ** 70).bit_length())
print((2 ** 70 - 1).bit_length())
print((-(2 ** 70)).bit_length())
big = 1 << 200
print(big.bit_length())

# a plain variable, and a variant receiver (untyped parameter)
small = 1023
print(small.bit_length())


def bl(x):
    return x.bit_length()


print(bl(255), bl(2 ** 100))

# a container element is a variant too
nums = [1, 258]
print(nums[1].bit_length())

# bit_count
print((255).bit_count(), (0).bit_count(), (-8).bit_count())
print((2 ** 70).bit_count(), (2 ** 70 - 1).bit_count())

# in a larger expression, and in a comprehension
print((255).bit_length() + 1)
print([x.bit_length() for x in [1, 2, 255]])

# `a.b.c = d.e.f = v` — a CHAINED assignment whose targets are NESTED attributes.
#
# PyParseChainAssign admitted NAME and NAME.field (one level). A two-level target
# fell through to the nested right-associative reading `X = (Y = v)` — a second
# implementation of the same concept — which is why this reported
# `expected newline after statement` at the second `=` rather than naming a gap.
#
# lekkerzeilen/app.py:3204 is `self.icon.visible = self.menu.visible = False`, and
# it was the closure wall; clearing it moved 3215 -> 3305.
#
# A receiver that is a PARAMETER silently stores NOTHING through this path, on the
# pinned compiler too — pre-existing and filed separately as
# bug-n-an-unpack-or-chain-store-whose-receiver-is-a-parameter-silently-does-nothing.
# Do not "fix" a red here by switching a row to a parameter; that is the open bug.
#
# VARIANT-typed receivers ARE covered, as of 2026-09-12 — see the VAR* rows at the
# bottom. They were refused by name until then, and VARAMBIG is the arrangement
# lekkerzeilen/app.py:3204 actually needs.

class W:
    def __init__(self, v=True):
        self.visible = v

class N:
    # `inner` is a W from the start, so this is the STATICALLY typed three-level
    # case. The variant-typed spelling is exercised by the VAR* rows below; it was
    # refused until 2026-09-12 and now routes through the statement path's own
    # dispatched write.
    def __init__(self):
        self.inner = W()

class A:
    def __init__(self):
        self.icon = W()
        self.menu = W()
        self.s = 0
        self.t = 0
        self.d = {}
        self.nest = N()

    # TWONESTED -- app.py:3204's own shape, and the row the parse error was on.
    def two_nested(self):
        self.icon.visible = self.menu.visible = False

    # MIXEDA / MIXEDB -- one level and two levels in one chain, BOTH ORDERS.
    # Both are here because the store arm is selected per target: a fix that
    # handled only the deeper target would pass whichever order put it first.
    def mixed_a(self):
        self.s = self.icon.visible = 11

    def mixed_b(self):
        self.menu.visible = self.t = 22

    # THREE levels, so the receiver fold is exercised more than once.
    def three(self):
        self.nest.inner.visible = self.icon.visible = 33

    # ONELEVEL -- the shape that already worked. Kept so that a widening which
    # breaks it reds visibly instead of passing.
    def one_level(self):
        self.s = self.t = 44

    # SUBS -- a subscript target beside a nested attribute one. The subscript
    # base is built during the target walk, so it has to start from the folded
    # receiver rather than from the bare name.
    def subs(self):
        self.d["k"] = self.icon.visible = 55

    # ONCE -- Python binds every target to ONE evaluation of the RHS. This is the
    # property that forbids desugaring to `b = f(); a = f()`, and no value
    # assertion on the targets alone can see it, so the call is counted.
    def once(self, f):
        self.icon.visible = self.menu.visible = f()

o = A()
o.two_nested(); print(o.icon.visible, o.menu.visible)
o.mixed_a();    print(o.s, o.icon.visible)
o.mixed_b();    print(o.menu.visible, o.t)
o.three();      print(o.nest.inner.visible, o.icon.visible)
o.one_level();  print(o.s, o.t)
o.subs();       print(o.d["k"], o.icon.visible)

calls = []
def f():
    calls.append(1)
    return 7

o.once(f);      print(o.icon.visible, o.menu.visible, len(calls))


# ---------------------------------------------------------------------------
# VARIANT-TYPED RECEIVERS. Until 2026-09-12 a chain whose target receiver had no
# static class was refused by name, because the fold's store fell to the dynamic
# setter while a DECLARED field's read kept using the field — two doors, and the
# statement stored nothing while compiling clean (`11 True` where CPython says
# `11 11`). The fix asks the statement path's two existing arms instead.

class One:
    def __init__(self):
        self.slot = 0

def mk_one(n):
    return One()            # a FACTORY, so the field holding it is variant-typed

class Holder:
    def __init__(self):
        self.a = mk_one(1)
        self.b = mk_one(2)
    # VARDECL -- one class declares `slot`, so the store is placed directly.
    def decl(self):
        self.a.slot = self.b.slot = 11
    # VARFRESH -- NO class declares `brand`, so Python creates the attribute and
    # the dynamic setter is correct; the dynamic getter reads it back, so there is
    # no second door. This row was refused along with the genuinely undecidable
    # case, and it is the control that separates the two reasons a store cannot be
    # placed statically: they want OPPOSITE answers.
    def fresh(self):
        self.a.brand = self.b.brand = 22

h = Holder()
h.decl();  print(h.a.slot, h.b.slot)
h.fresh(); print(h.a.brand, h.b.brand)

# VARAMBIG -- THE LOAD-BEARING ROW, and app.py:3204's own shape: TWO classes
# declare `tag` at DIFFERENT offsets, so no single placement is correct and the
# write has to dispatch on the receiver's run-time class. `visible` in
# lekkerzeilen/ui.py is declared twice exactly like this. If this row is ever
# "simplified" by giving Pair and Solo the same layout it stops testing anything:
# both would then take the single-placement arm above.

class Pair:
    def __init__(self):
        self.pad = 0
        self.tag = 1        # tag at a LATER offset

class Solo:
    def __init__(self):
        self.tag = 2        # tag at offset 0

def mk_tagged(n):
    if n:
        return Pair()
    return Solo()

class Two:
    def __init__(self):
        self.x = mk_tagged(1)
        self.y = mk_tagged(0)
    def go(self):
        self.x.tag = self.y.tag = 9

t = Two()
t.go(); print(t.x.tag, t.y.tag)

# CPython DEFINES key=None as "no key function", so passing it explicitly is
# ordinary — most often when an optional key is threaded through a helper's own
# key=None default. It picked the two-argument NUMERIC overload and raised
# "expected a number, got object", comparing the list against None.
# bug-nilpy-builtin-surface-gaps-found-by-the-2026-08-12-sweep item 1
print(min([3, 1], key=None), max([3, 1], key=None))
k = None
print(min([3, 1], key=k), max([3, 1], key=k))


def show(xs, key=None):
    return (min(xs, key=key), max(xs, key=key))


print(show([5, 2, 9]))
print(min("cab", key=None), max("cab", key=None))
print(min(range(3), key=None), max(range(3), key=None))
# controls: a real key, the plain forms, and the two-argument numeric form
print(min([3, 1], key=lambda x: -x), max([3, 1], key=lambda x: -x))
print(min(1, 2), max(1, 2), min([1, 2]), max([1, 2]))
print(min([2.5, 1.5]), max("ab"))
print(min([(2, 1), (1, 9)]), max([[1], [2]]))

# collections.Counter(x), the qualified spelling, selects by the argument's
# type as the from-import spelling does: a str counts characters, a list its
# elements, a mapping adds its values. It is still a Counter afterwards.
# bug-n-collections-counter-qualified-does-not-compile
import collections
from collections import Counter

c = collections.Counter("abca")
print(c)
print(c == Counter("abca"))
print(c["a"], c["z"])
print(c.most_common(1))

d = collections.Counter([1, 2, 1, 3, 1])
print(d)
print(d.most_common(2))

e = collections.Counter({"x": 3, "y": 1})
print(e)

f = collections.Counter()
f.update("hello")
print(f)

g = collections.Counter(range(3))
print(g)


def count(t):
    return collections.Counter(t)


print(count("mississippi"))
print(count(["a", "b", "a"]))
h = collections.Counter((1, 1, 2))
print(h)
print(type(c).__name__)

# A local some nested def declares `nonlocal` becomes ONE heap cell shared by
# the frame and every closure over it. Nothing ever freed that cell: ~23 bytes
# per call of the enclosing def, plus whatever the cell held -- a list cell
# kept every list it was ever rebound to alive through the last value.
# The cell is refcounted now: the frame holds one reference, each closure
# bound over it one more, and it dies with the last of them.
#
# The HEAP_DEBUG run checks the lifetimes that must NOT end early: a counter
# still counting after its frame returned, two closures sharing one cell, a
# cell captured by a generator's helper, a closure outliving a sibling.
# `leak N` / `keep N` drive the census through the list-valued cell, which is
# census-visible (a scalar cell is a raw block the census does not count; its
# RSS went flat as well: 8.2 MB -> 0.6 MB over 320k closures).
import sys


def counter():
    c = 0

    def inc():
        nonlocal c
        c = c + 1
        return c
    return inc


def accumulator():
    xs = []

    def add(v):
        nonlocal xs
        xs = xs + [v]
        return len(xs)

    def get():
        return xs
    return add, get


def in_place(n):
    total = 0

    def bump(k):
        nonlocal total
        total += k
    for i in range(n):
        bump(i)
    return total


def gen_cell(n):
    c = 0

    def inc():
        nonlocal c
        c += 1
        return c
    for i in range(n):
        yield inc()


def show():
    f = counter()
    print(f(), f(), f())
    add, get = accumulator()
    add("a")
    add("b")
    del add
    print(get())
    print(in_place(5), list(gen_cell(3)))
    g = counter()
    del f
    print(g(), g())
    fs = [counter() for i in range(3)]
    print([h() + h() for h in fs])


def passes(n, keep):
    t = 0
    for i in range(n):
        f = counter()
        t += f() + f()
        add, get = accumulator()
        add(i)
        add([i])
        t += len(get()) + in_place(3) + sum(gen_cell(2))
        if keep is not None:
            keep.append(accumulator())
    print(t)


if len(sys.argv) < 2:
    show()
elif sys.argv[1] == "leak":
    passes(int(sys.argv[2]), None)
else:
    passes(int(sys.argv[2]), [])

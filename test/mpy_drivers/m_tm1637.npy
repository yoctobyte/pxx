# Driver census: mcauser/micropython-tm1637, unchanged (tools/mpy_driver_census.sh).
import tm1637
from machine import Pin

tm = tm1637.TM1637(clk=Pin(10), dio=Pin(11))
tm.brightness(3)
tm.show('help')
tm.numbers(12, 59)
tm.hex(0xdead)
tm.temperature(24)
print("tm1637:", tm.encode_string('1234'))

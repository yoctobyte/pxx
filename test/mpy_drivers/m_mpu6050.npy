# Driver census: micropython-IMU/micropython-mpu9x50 (MPU6050 class), unchanged.
from machine import Pin, I2C
from imu import MPU6050

i2c = I2C(0, scl=Pin(9), sda=Pin(8))
try:
    imu = MPU6050(i2c)
    print("mpu6050: accel", imu.accel.xyz, "gyro", imu.gyro.xyz, "temp", imu.temperature)
except OSError as e:
    print("mpu6050: no device:", e)

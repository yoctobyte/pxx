# Every return shape ClassifyProcResultFresh judges (the bodies of
# test/test_result_fresh_verdicts.pas, in test/nilpy_freshseam/freshseam.pas),
# called from NilPy, discarded and rebound N times each. A wrong verdict is a
# leak (FRESH read as borrowed: alive grows by N) or a double free (BORROWED read
# as fresh: the receiver dies, gone passes made). Each row prints how many of
# the shape's objects are still alive afterwards -- 0 for every shape -- and the
# last line checks both receivers survived their borrowed calls.
#
#   check  (default) the rows below; built -dPXX_ALLOC_CENSUS the Makefile also
#          bounds live= with tools/assert_no_leak.sh
#   keep   the positive control: holds every fresh result, so alive and the
#          census must both grow
# Run with -Futest/nilpy_freshseam. The same program runs on i386 under qemu.
#
# TA.Mixed returns Self OR a new object (`if v > 0 then Exit(Self); Result :=
# TA.Create`). Until 2026-09-28 it read as a borrow, so its FRESH arm leaked
# every object it made: 500 of 500 alive after N discards and after N rebinds
# (pin v443 and HEAD, x86-64 and i386). ClassifyProcResultFresh now marks it
# fresh-or-arg, and a call whose argument is a plain name is lowered as
# PXXObjRetainIfSame(call, argument): owned on both arms. Mixed.fresh is z's
# (v = 0), Mixed.self is p's. No function in lib/rtl or pylib has the shape.
#
# Fld, Element and Cached return a FIELD, an element of an array field and a
# global. Until 2026-09-27 their verdict (not fresh, no parameter returned) read
# as OWNED, so each rebind released an object the receiver still held:
# -dPXX_HEAP_DEBUG "RELEASE of a FREED object" 199 times in 200 on pin v443, and
# re.compile -- MakePattern returns its cache's entry -- crashed the second time
# a function bound it. ClassifyProcResultFresh now gives such a store its own
# verdict (arg=-3), read as a borrow. The re.compile row counts no TA; it is
# for the -dPXX_HEAP_DEBUG build, which must print no pxx-heap line.
import sys
import re
import 'freshseam.pas' as fs

mode = sys.argv[1] if len(sys.argv) > 1 else "check"
N = 500
p = fs.TA(1)
z = fs.TA(0)
p.Fill()
fs.Cached()


def alive():
    return fs.made() - fs.gone()


def d_Fresh():
    for i in range(N):
        z.Fresh()


def r_Fresh():
    s = 0
    for i in range(N):
        t = z.Fresh()
        s = s + (t.v)
    return s

def d_Via():
    for i in range(N):
        z.Via()


def r_Via():
    s = 0
    for i in range(N):
        t = z.Via()
        s = s + (t.v)
    return s

def d_Named():
    for i in range(N):
        z.Named()


def r_Named():
    s = 0
    for i in range(N):
        t = z.Named()
        s = s + (t.v)
    return s

def d_ViaLocal():
    for i in range(N):
        z.ViaLocal()


def r_ViaLocal():
    s = 0
    for i in range(N):
        t = z.ViaLocal()
        s = s + (t.v)
    return s

def d_OrNil_fresh():
    for i in range(N):
        z.OrNil()


def r_OrNil_fresh():
    s = 0
    for i in range(N):
        t = z.OrNil()
        s = s + (t.v)
    return s

def d_MakeA():
    for i in range(N):
        fs.MakeA()


def r_MakeA():
    s = 0
    for i in range(N):
        t = fs.MakeA()
        s = s + (t.v)
    return s

def d_MkLocal():
    for i in range(N):
        fs.MkLocal()


def r_MkLocal():
    s = 0
    for i in range(N):
        t = fs.MkLocal()
        s = s + (t.v)
    return s

def d_Me():
    for i in range(N):
        p.Me()


def r_Me():
    s = 0
    for i in range(N):
        t = p.Me()
        s = s + (t.v)
    return s

def d_NamedSelf():
    for i in range(N):
        p.NamedSelf()


def r_NamedSelf():
    s = 0
    for i in range(N):
        t = p.NamedSelf()
        s = s + (t.v)
    return s

def d_Mixed_fresh():
    for i in range(N):
        z.Mixed()


def r_Mixed_fresh():
    s = 0
    for i in range(N):
        t = z.Mixed()
        s = s + (t.v)
    return s

def d_Mixed_self():
    for i in range(N):
        p.Mixed()


def r_Mixed_self():
    s = 0
    for i in range(N):
        t = p.Mixed()
        s = s + (t.v)
    return s

def d_PassThrough():
    for i in range(N):
        fs.PassThrough(p)


def r_PassThrough():
    s = 0
    for i in range(N):
        t = fs.PassThrough(p)
        s = s + (t.v)
    return s

def d_OrNil_nil():
    for i in range(N):
        p.OrNil()


def r_OrNil_nil():
    s = 0
    for i in range(N):
        t = p.OrNil()
        s = s + (1 if t is None else 0)
    return s

def d_Fld():
    for i in range(N):
        p.Fld()


def r_Fld():
    s = 0
    for i in range(N):
        t = p.Fld()
        s = s + (t.v)
    return s

def d_Element():
    for i in range(N):
        p.Element(2)


def r_Element():
    s = 0
    for i in range(N):
        t = p.Element(2)
        s = s + (t.v)
    return s

def d_Cached():
    for i in range(N):
        fs.Cached()


def r_Cached():
    s = 0
    for i in range(N):
        t = fs.Cached()
        s = s + (t.v)
    return s


def d_re_compile():
    for i in range(N):
        re.compile("a+b")


def r_re_compile():
    s = 0
    for i in range(N):
        t = re.compile("a+b")
        s = s + len(t.search("xaab").group(0))
    return s


def row(name, d, r):
    a0 = alive()
    d()
    a1 = alive()
    r()
    a2 = alive()
    print(name, "discard", a1 - a0, "rebind", a2 - a1)


if mode == "keep":
    kept = []
    for i in range(N):
        kept.append(z.ViaLocal())
        kept.append(fs.MakeA())
    print("keep alive", alive() - 2)
else:
    row("Fresh", d_Fresh, r_Fresh)
    row("Via", d_Via, r_Via)
    row("Named", d_Named, r_Named)
    row("ViaLocal", d_ViaLocal, r_ViaLocal)
    row("OrNil.fresh", d_OrNil_fresh, r_OrNil_fresh)
    row("MakeA", d_MakeA, r_MakeA)
    row("MkLocal", d_MkLocal, r_MkLocal)
    row("Me", d_Me, r_Me)
    row("NamedSelf", d_NamedSelf, r_NamedSelf)
    row("Mixed.fresh", d_Mixed_fresh, r_Mixed_fresh)
    row("Mixed.self", d_Mixed_self, r_Mixed_self)
    row("PassThrough", d_PassThrough, r_PassThrough)
    row("OrNil.nil", d_OrNil_nil, r_OrNil_nil)
    row("Fld", d_Fld, r_Fld)
    row("Element", d_Element, r_Element)
    row("Cached", d_Cached, r_Cached)
    row("re.compile", d_re_compile, r_re_compile)
    print("borrowed", p.Fld().v, p.Element(2).v, fs.Cached().v)
    print("receivers", p.v, z.v, "alive", alive(), "gone <= made", fs.gone() <= fs.made())

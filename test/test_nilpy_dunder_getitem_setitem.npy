# A class defining __getitem__/__setitem__ (no Pascal default property --
# only pylib's own TPyList/TPyDict declare one) must route subscript
# read/write through them. Before this, `obj[i]` fell through to the
# generic array/pointer-arithmetic fallback and silently read a WRONG value
# (0 observed) off the instance -- worse than the ticket's original finding
# of a compile error, since by the time this was picked up `C()[1]` had
# started to silently (mis)compile. `obj[i] = v` on a class with
# __getitem__ but no __setitem__ raises a genuine catchable TypeError,
# matching CPython's "does not support item assignment".
# bug-nilpy-dunder-protocols-ignored-fall-back-to-handle-arithmetic
# Every expectation is CPython's own output.

class Box:
    def __init__(self):
        self.items = [10, 20, 30]
    def __getitem__(self, i):
        return self.items[i]
    def __setitem__(self, i, v):
        self.items[i] = v

b = Box()
print(b[1])
b[1] = 99
print(b[1])
print(b.items)

class Dicty:
    def __init__(self):
        self.data = {}
    def __getitem__(self, k):
        return self.data.get(k, -1)
    def __setitem__(self, k, v):
        self.data[k] = v

dd = Dicty()
dd["x"] = 42
print(dd["x"])
print(dd["missing"])

class NoSet:
    def __getitem__(self, i):
        return i * 2

ns = NoSet()
print(ns[5])
try:
    ns[5] = 1
except Exception as e:
    print("caught:", type(e).__name__)

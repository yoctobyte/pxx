# M4 "a real extension from PyPI" (feature-nilpy-cpyext-c-api-from-source):
# MarkupSafe 3.0.3's real, unmodified _speedups.c
# (test/nilpy_units/vendor/markupsafe_speedups.c), compiled by cfront against
# pxx's own Python.h and imported from NilPy. Expectation is the SAME
# extension's own output under real CPython (verified with
# `PYTHONPATH=<sdist target> python3 -c "from markupsafe._speedups import
# _escape_inner; ..."`), not a hand-typed guess.
import markupsafe_ext

print(markupsafe_ext.escape("<b>hi & \"bye\" 'all'</b>"))
print(markupsafe_ext.escape("plain text, no specials"))
print(markupsafe_ext.escape(""))

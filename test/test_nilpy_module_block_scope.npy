# A name FIRST bound inside a module-level if/for block (no pre-declaration)
# must be visible to a LATER top-level assignment's RHS -- Python has no
# block scope, so `if True: payload = 3` followed by `documents = payload + 1`
# is ordinary code. The module-level type-inference pre-pass only recognized
# a bare-name assignment at INDENT DEPTH 0, so a block-nested one was invisible
# to it; a later statement referencing that name from an assignment RHS
# trial-parsed against a pre-pass that had never seen it and Halted the whole
# compile with "undefined variable". `print(name)` (an expression statement,
# not trial-parsed the same way) already worked, which is what made this easy
# to miss. def/class bodies are genuinely new scopes and must NOT leak their
# locals into module scope, unlike if/for/while/with/try.
# bug-nilpy-module-level-name-bound-in-a-block-is-invisible-to-a-later-assignment
# Every expectation is CPython's own output.

if True:
    payload = 3
print(payload)
documents = payload + 1
print(documents)

for i in [1]:
    looped = 3
counted = looped + 1
print(counted)

def helper():
    local_only = 5
    return local_only

class C:
    def __init__(self):
        self.class_only = 7

print(helper())
c = C()
print(c.class_only)

# ...and the same rule when the RHS is a CALL, which no token shape can type.
# The pre-pass's depth>0 arm recognised a short list of safe RHS shapes (a
# literal, a subscript of a known name, a constructor of a known class); a
# METHOD CALL was not one, so the name was never registered at all and the very
# next bare assignment reading it Halted with "undefined variable" -- while
# `print(len(raw))` one line earlier was fine, because only a bare assignment's
# RHS is trial-parsed. Registering a PHANTOM (a scratch symbol withheld from the
# widening harvest) is what closes it without asserting a type the earlier
# attempts got wrong.
# bug-nilpy-name-bound-by-a-method-call-in-a-block-is-undefined-later


class Src:
    def read(self):
        return "hello"


src = Src()
with open("test/nilpy_data.txt") as fh:
    fileraw = fh.read()
filelen = len(fileraw)
print(filelen > 0)

if True:
    methraw = src.read()
methlen = len(methraw)
print(methlen)

for ix in [1, 2, 3]:
    strv = str(ix)
copied = strv
print(copied)

while True:
    wrapped = "a-b".split("-")
    break
print(len(wrapped))

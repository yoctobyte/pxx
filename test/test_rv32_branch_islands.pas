{ riscv32: a conditional jump is one branch straight to its label, and a
  forward one still waiting after ~1 KiB gets a veneer in an island the code
  jumps over. Every comparison, signed and unsigned, both ways; forward jumps
  over blocks of ~0.1, ~2 and ~6 KiB (past a B-type branch's 4 KiB reach); and
  a loop whose test sits far from its exit; and repeat-until loops
  whose backward branch is near, and past 4 KiB. Output must match x86-64. }
program test_rv32_branch_islands;

var
  acc: LongWord;

function Cmp(a, b: Integer; x, y: LongWord): Integer;
begin
  Result := 0;
  if a = b then Result := Result + 1;
  if a <> b then Result := Result + 2;
  if a < b then Result := Result + 4;
  if a <= b then Result := Result + 8;
  if a > b then Result := Result + 16;
  if a >= b then Result := Result + 32;
  if x < y then Result := Result + 64;
  if x <= y then Result := Result + 128;
  if x > y then Result := Result + 256;
  if x >= y then Result := Result + 512;
  if a <> 0 then Result := Result + 1024;
end;

procedure Mix(n: LongWord);
begin
  acc := acc * 31 + n;
end;

function Small(k: Integer): LongWord;
var i: Integer;
begin
  acc := 7;
  if k > 2 then
  begin
    acc := acc * 33 + 1 + LongWord(k);
    acc := acc * 33 + 8 + LongWord(k);
    acc := acc * 33 + 15 + LongWord(k);
    acc := acc * 33 + 22 + LongWord(k);
    acc := acc * 33 + 29 + LongWord(k);
    acc := acc * 33 + 36 + LongWord(k);
    acc := acc * 33 + 43 + LongWord(k);
    acc := acc * 33 + 50 + LongWord(k);
  end
  else
    acc := acc + 1;
  i := 0;
  while i < k do
  begin
    Mix(LongWord(i));
    if i = 3 then
    begin
      acc := acc xor 5;
      acc := acc xor 18;
      acc := acc xor 31;
      acc := acc xor 44;
    end;
    i := i + 1;
  end;
  i := 0;
  repeat
    Mix(LongWord(i));
    acc := acc + 2 * LongWord(i);
    acc := acc + 5 * LongWord(i);
    acc := acc + 8 * LongWord(i);
    acc := acc + 11 * LongWord(i);
    i := i + 1;
  until i >= k;
  Result := acc;
end;


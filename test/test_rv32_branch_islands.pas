begin
  for a := -2 to 2 do
    for b := -2 to 2 do
      Write(Cmp(a, b, 0, 0), ' ');
  WriteLn;
  x := $FFFFFFF0; y := 5;
  WriteLn(Cmp(1, 1, x, y), ' ', Cmp(1, 1, y, x), ' ', Cmp(-1, 1, x, x));
  for a := 0 to 5 do
    WriteLn(a, ' ', Small(a), ' ', Mid(a), ' ', Far(a));
end.

# Python's repr(float) is the SHORTEST decimal that reads back as the same
# double, and str() is the same function. Six divergences used to be silent
# here: a dropped digit (1/3), 0.1+0.2 printing 0.3 (the representation error
# HIDDEN by rounding), 1e-20 printing different digits, the wrong
# scientific-notation threshold, and over-expansion.
#
# float(str) is the other half: the parser reconstructed with float arithmetic
# and did not land on the nearest double.

vals = [0.1, 1/3, 1e20, 1e-20, 2.0, -0.0, 100.0, 1.5e300, 3.0e-5,
        123456789.123, 0.0, 1.0, -1.5, 7/2, 1e-300, 2.5, 0.5]
for v in vals:
    print(v)

print("arith:", 0.1 + 0.2, 1/3 + 1/3, 7//2, 7.0//2)

# both notation thresholds, from either side
print("thresholds:", 1e-4, 9.9e-5, 1e16, 9.9e15)

# subnormals and the extremes
print("extremes:", 5e-324, 2.2250738585072014e-308, 1.7976931348623157e308)
print("neg extremes:", -5e-324, -1.7976931348623157e308)

# non-finite
print("nonfinite:", float("inf"), float("-inf"), float("nan"))

# float(str) must land on the nearest double: these three all disagreed with
# the identical literals before the correctly-rounded parser was wired in
print("parse:", float("1e308"), float("0.3333333333333333"),
      float("2.2250738585072011e-308"))
print("parse eq:", float("1e308") == 1e308,
      float("0.3333333333333333") == 0.3333333333333333,
      float("2.2250738585072011e-308") == 2.2250738585072011e-308,
      float("5e-324") == 5e-324)

# Python's spelling rules the parser still has to honour
print("spellings:", float("  1_000.5  "), float("3."), float(".5"),
      float("+2.5"), float("1E+2"), float("-0.0"))

# the round-trip property itself, over the whole table
ok = True
for v in vals:
    if float(str(v)) != v:
        ok = False
print("roundtrip:", ok)

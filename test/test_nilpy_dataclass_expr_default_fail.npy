# A dataclass field default that is an EXPRESSION must be REFUSED, not silently
# truncated to its first token.
#
# The scalar path claimed the `2` and skipped the rest of the line, so this
# compiled and the field held 2 instead of 5 — a wrong value with no diagnostic.
# Expression defaults are not evaluated yet (a dataclass default travels as a
# folded constant in the PyDc* tables that build the generated ctor), so the
# honest behaviour is to say so: see
# feature-nilpy-dataclass-expression-field-default.
#
# Third sighting of one shape in a single day — a constant fast-path that claims
# a literal token without checking it ENDED the construct. The other two were
# `def f(b=1+2)` and a class attribute `g = 2 + 3`; both are now EVALUATED.
from dataclasses import dataclass


@dataclass
class P:
    x: int = 2 + 3


print(P().x)

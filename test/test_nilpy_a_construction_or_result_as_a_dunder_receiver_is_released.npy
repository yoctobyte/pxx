# A fresh object as the RECEIVER of an operator or protocol dunder had no
# owner, one instance per evaluation:
#
#   V(1) + w, -V(k), V(1) * 3 + w     -- __add__ / __neg__ / __mul__
#   V(1)[i], len(V(1)), 1 in V(1)     -- __getitem__ / __len__ / __contains__
#   (V(1) + w).x, V(1)[i].x, w[i].x   -- a dunder RESULT read by a selector
#   io.StringIO(s).read()             -- a module-qualified construction
#
# The IR spills an owned argument from position 1 on, and an owned call result
# at position 0, but not a construction at position 0 (a method's receiver),
# and a dunder's result followed by `.`/`[` was not bound the way a method
# chain's link is.
#
# No argument: prints, diffed against CPython under -dPXX_HEAP_DEBUG. `leak N`
# / `keep N` drive the census.
import io
import sys


class V:
    def __init__(self, x):
        self.x = x

    def __repr__(self):
        return "V(%d)" % self.x

    def __add__(self, o):
        return V(self.x + o.x)

    def __mul__(self, k):
        return V(self.x * k)

    def __neg__(self):
        return V(-self.x)

    def __len__(self):
        return 3

    def __getitem__(self, i):
        return V(self.x * 10 + i)

    def __contains__(self, v):
        return v == self.x

    def __bool__(self):
        return self.x != 0


def show():
    w = V(5)
    print(V(1) + w, -V(2), V(1) * 3 + w, (V(1) + w).x, (-V(4)).x)
    print(V(1)[2], len(V(1)), 1 in V(1), 2 in V(1), V(3)[4].x, w[6].x)
    print((V(1) * 3 + V(2)).x, "y" if V(1) else "n", "y" if V(0) else "n")
    print(io.StringIO("abc").read(), len(io.StringIO("abcd").read()), io.BytesIO(b"xy").read())
    acc = V(0)
    for i in range(3):
        acc = acc + V(i) * 2
    print(acc, [V(i)[1].x for i in range(3)])


def passes(n, keep):
    w = V(1)
    t = 0
    for i in range(n):
        t += (V(i) + w).x + (-V(i)).x + (V(i) * 3 + w).x + V(i)[1].x + w[i].x
        t += len(V(i)) + (1 if i in V(i) else 0) + len(io.StringIO("ab").read())
        if V(i):
            t += 1
        if keep is not None:
            keep.append(V(i) + w)
    print(t)


if len(sys.argv) < 2:
    show()
elif sys.argv[1] == "leak":
    passes(int(sys.argv[2]), None)
else:
    passes(int(sys.argv[2]), [])

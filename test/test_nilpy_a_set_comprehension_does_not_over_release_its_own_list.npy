# A set comprehension used to hand its list back BORROWED while the caller
# released it as owned, so the refcount went negative and the block was freed
# while still referenced. The visible half is the RETURNED one: the set escapes
# the function, is freed on the way out, and the caller reads an empty
# container. `return {x for x in xs}` answered 0 before the fix and 3 after,
# which is why this fixture leads with it -- a value assertion that the defect
# can actually fail.
#
# The stressor below is the other half: allocate between the build and the
# read, so a recycled block shows up as wrong CONTENTS rather than as a
# quietly-early free.
#
# bug-n-a-set-comprehension-over-releases-its-own-list


def escaping(xs):
    return {x for x in xs}


def bound(xs):
    s = {x for x in xs}
    return len(s)


def frozen(xs):
    return frozenset(x for x in xs)


rows = [3, 1, 2, 3, 1]

r = escaping(rows)
print(len(r), sorted(r), type(r).__name__)
print(bound(rows))

f = frozen(rows)
print(len(f), sorted(f), type(f).__name__)

# the set survives allocations made after it was built
kept = escaping(rows)
noise = []
for i in range(64):
    noise.append([i, i + 1, i + 2])
print(sorted(kept), len(noise))

# nested, and inside a comprehension of its own
print([sorted({q % 3 for q in range(n)}) for n in range(5)])

# the tags still read right, and the operators still take a set
s = escaping(rows)
print(sorted(s - {1}), sorted(s & {1, 2}), sorted(s | {9}), sorted(s ^ {1, 9}))
print(isinstance(s, set), isinstance(f, frozenset), f == frozenset([1, 2, 3]))

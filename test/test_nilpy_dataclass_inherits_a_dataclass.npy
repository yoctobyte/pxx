# A @dataclass that inherits a @dataclass: the generated ctor takes the
# base's fields first, then its own, as CPython's does, with inherited
# defaults; __repr__, __eq__ and order=True cover the whole field tuple and
# are regenerated for the subclass unless its OWN body defines one. Before,
# Kid(1, 2.5) segfaulted (the ctor took Kid's own field only).
# bug-n-a-dataclass-that-inherits-a-dataclass-segfaults-on-construction
from dataclasses import dataclass, field


@dataclass
class Base:
    a: int
    s: str = "d"


@dataclass
class Kid(Base):
    b: float = 0.25


class Plain:
    z = 1


@dataclass
class P2(Plain):
    q: int


k = Kid(1, "x", 2.5)
print(k.a, k.s, k.b)
k2 = Kid(4)
print(k2.a, k2.s, k2.b)
k3 = Kid(5, b=9.5)
print(k3.a, k3.s, k3.b)
print(k3)
print(Kid(1, "x", 2.5) == Kid(1, "x", 2.5))
print(P2(3).q)
print(Base(7).a, Base(7).s)
print(Kid(1, "x", 2.5) == Kid(1, "x", 3.5))
print(Base(1) == Base(1), Base(1))


@dataclass(order=True)
class OB:
    a: int


@dataclass(order=True)
class OK(OB):
    b: int


print(OK(1, 2) < OK(1, 3), OK(2, 0) < OK(1, 9), OK(1, 2) <= OK(1, 2))


@dataclass
class R(Base):
    c: int = 3

    def __repr__(self):
        return "R!"


print(R(1), R(1, "y", 4) == R(1, "y", 4))


# an inherited EXPRESSION default and default_factory: the base's hidden
# default global, evaluated at the base's class statement
K = 4


@dataclass
class EB:
    x: int = 2 + K
    xs: list = field(default_factory=list)


@dataclass
class EC(EB):
    y: int = K * 3


ec = EC()
ec.xs.append(1)
print(ec.x, ec.xs, ec.y, EC(), EC(1, [2], 3))

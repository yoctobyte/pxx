# A subscript STORE whose receiver is not a name — a call result, a method
# call, a construction. The receiver reaches no lvalue route, so the plain `=`
# form was a parse error and every augmented form compiled and silently threw
# the store away.
# bug-n-a-subscript-store-whose-receiver-is-a-call-result-does-not-parse


class Store:
    def __init__(self):
        self.d = {}

    def __getitem__(self, k):
        return self.d[k]

    def __setitem__(self, k, v):
        self.d[k] = v


gd = {"n": 1}
gl = [1, 2, 3]
gs = Store()
gs["n"] = 1


def get_dict():
    return gd


def get_list():
    return gl


def get_store():
    return gs


# a dict, a list and a user class with __setitem__ all through a call result
get_dict()["n"] = 5
get_dict()["n"] += 2
print(gd["n"])

get_list()[0] = 9
get_list()[0] += 1
print(gl)

get_store()["n"] = 50
get_store()["n"] += 1
print(gs["n"])

# the receiver is evaluated ONCE, not once per accessor
calls = []


def counted():
    calls.append(1)
    return gd


counted()["n"] += 100
print(len(calls), gd["n"])

# every augmented operator
gd["n"] = 24
get_dict()["n"] *= 3
get_dict()["n"] -= 5
get_dict()["n"] //= 5
get_dict()["n"] **= 2
print(gd["n"])

gd["n"] = 24
get_dict()["n"] /= 3
print(gd["n"])
gd["n"] = 24
get_dict()["n"] %= 7
get_dict()["n"] &= 10
get_dict()["n"] |= 5
get_dict()["n"] ^= 3
get_dict()["n"] <<= 2
get_dict()["n"] >>= 1
print(gd["n"])

# a CONSTRUCTION receiver — this used to report its failure at a LATER,
# unrelated statement
Store()["x"] = 1
print("construction store survived")


# a METHOD-call receiver, and a chain of calls
class Holder:
    def __init__(self):
        self.d = {"n": 1}

    def data(self):
        return self.d


h = Holder()
h.data()["n"] += 4
print(h.d)


def mk():
    return gs


def outer():
    return mk


outer()()["n"] *= 2
print(gs["n"])

# a nested subscript whose OUTER receiver is a call result
gg = {"row": [1, 2, 3]}


def get_grid():
    return gg


get_grid()["row"][1] = 9
get_grid()["row"][1] += 1
print(gg)

# a SLICE through a call result still works
get_list()[1:3] = [7, 8]
print(gl)


# ...and a class with __getitem__ but no __setitem__ is still refused
class RO:
    def __init__(self):
        self.d = {"n": 1}

    def __getitem__(self, k):
        return self.d[k]


def get_ro() -> RO:
    return RO()


try:
    get_ro()["n"] += 1
    print("NOT REACHED")
except TypeError as e:
    print("read-only receiver refused:", e)


# ...and the STATICALLY typed receivers: the chained arms in
# PyParseClassRecordSelectors peeked only for '=', so `+=` through an
# annotated call result escaped to the shared compound tail and vanished.
def typed_store() -> Store:
    return gs


gs["n"] = 40
typed_store()["n"] = 41
typed_store()["n"] += 1
print(gs["n"])


def typed_dict() -> dict:
    return gd


gd["n"] = 40
typed_dict()["n"] = 41
typed_dict()["n"] += 1
typed_dict()["n"] **= 2
print(gd["n"])


def typed_list() -> list:
    return gl


gl = [1, 2, 3]
typed_list()[0] = 4
typed_list()[0] += 1
print(gl)


# the key is evaluated ONCE on the augmented path too
keys = []


def one_key():
    keys.append(1)
    return "n"


gd["n"] = 5
typed_dict()[one_key()] += 1
print(len(keys), gd["n"])

# the named / attribute / element controls must not have moved
gs["n"] = 1
stores = [Store()]
stores[0]["k"] = 2
stores[0]["k"] += 3
print(stores[0]["k"])
d2 = {}
d2["a"] = 1
d2["a"] += 1
print(d2["a"])

# An attribute that does not exist must raise AttributeError whatever the
# RECEIVER is. This is the SCALAR arm of
# done/bug-nilpy-missing-attribute-yields-none-instead-of-attributeerror, which
# fixed only the class-instance arm.
#
# EVERY EXPECTED VALUE HERE IS A RAISE, NEVER A VALUE, AND THAT IS DELIBERATE.
# The broken compiler answers the RECEIVER for an int (`(5).foo` -> 5), so a
# fixture asserting "not None" or "falsy" passes on the bug. Only "did it
# raise" separates them.
#
# Measured before the fix: (5).foo -> 5, "abc".foo -> 6513249 (a raw internal
# handle surfaced as an integer), (1.5).bar -> 0, (5).foo + 1 -> 6, and
# `None.foo = 1` silently no-ops. CPython raises AttributeError for all five.

ok = True

def expect_raise(label, fn):
    global ok
    try:
        v = fn()
        print("%-18s NO RAISE -> %s   FAIL" % (label, repr(v)))
        ok = False
    except AttributeError:
        print("%-18s AttributeError" % label)

def r_int():
    i = 5
    return i.foo

def r_str():
    s = "abc"
    return s.foo

def r_float():
    f = 1.5
    return f.bar

def r_arith():
    i = 5
    return i.foo + 1

def w_none():
    n = None
    n.foo = 1
    return "written"

expect_raise("int.foo", r_int)
expect_raise("str.foo", r_str)
expect_raise("float.bar", r_float)
expect_raise("int.foo + 1", r_arith)
expect_raise("None.foo = 1", w_none)

# POSITIVE CONTROL: attributes that DO exist must still work, or a fix that
# raises unconditionally would pass every row above.
class C:
    def __init__(self):
        self.a = 7

c = C()
i5 = 5
f15 = 1.5
if c.a == 7:
    print("control: real attribute still reads")
else:
    print("control: real attribute BROKE")
    ok = False

d = {"k": 1}
if len("abc") == 3 and d.get("k") == 1 and "AB".lower() == "ab":
    print("control: scalar methods still work")
else:
    print("control: scalar methods BROKE")
    ok = False

# THE COLLISION ROWS, and they are why a "raise on every unresolved scalar
# attribute" fix is WRONG. int and float carry four real attributes, and the
# offset-0 read answered TWO of them correctly BY ACCIDENT: the first machine
# word of an int IS the int, and CPython's int.real and int.numerator ARE the
# int. A fix that raises unconditionally turns two RIGHT answers into
# AttributeError while fixing the wrong ones, and no row above can see it.
# float has no numerator/denominator at all, which is the asymmetry that stops
# this being "ints and floats both have four".
if i5.real == 5 and i5.imag == 0 and i5.numerator == 5 and i5.denominator == 1:
    print("control: int real/imag/numerator/denominator")
else:
    print("control: int real-attrs BROKE")
    ok = False

if f15.real == 1.5 and f15.imag == 0.0:
    print("control: float real/imag")
else:
    print("control: float real-attrs BROKE")
    ok = False

try:
    v = f15.numerator
    print("control: float.numerator NO RAISE -> %s   FAIL" % repr(v))
    ok = False
except AttributeError:
    print("control: float.numerator AttributeError")

if ok:
    print("SCALARATTR OK")
else:
    print("SCALARATTR FAIL")

# A BOXED int passed to an inlined Pascal leaf. At -O2 the inliner bound the
# argument by raw lowering, and a boxed value's raw lowering is not its value:
# a promotable int (`w = 7 - 1`, anything arithmetic) arrived as its slot
# ADDRESS and a Variant as its TAG. -O0 was right, and so was a method call,
# which is not inlined. Found through `time.ticks_diff(1, (1 << 30) - 1)`.
# The expected values are the plain ones: every row prints what CPython-level
# arithmetic says, so a boxed row printing an address or 1 is the defect.
import 'nilpy_inline_boxed_unit.pas' as u
import time
from time import ticks_diff

w = 7 - 1                  # tyPromoInt64
big = (1 << 64) + 300      # past 64 bits: narrowed mod 2**64, as the call path does
xs = [205, "x"]
v = xs[0]                  # Variant
print("int64", u.id64(w), "int32", u.id32(w), "byte", u.idb(w), "word", u.idw(w))
bl = [False, True]
print("bool", u.idbool(bl[0]), u.idbool(bl[1]), "double", u.idd(w))
print("second arg", u.sub2(100, w), "first arg", u.sub2(w, 100), "both", u.sub2(w * 3, w))
print("inline expr", u.id64(7 * 11 - 2), u.id64(w + 1))
print("wraps", u.id64(big))
print("variant", u.id64(v), u.id32(v), u.idb(v), u.sub2(1000, v))

def inside():
    k = 40 + 2
    return u.id64(k), u.sub2(k, 2)

print("in a def", inside())
# the real hit, through a shim: MicroPython's ticks wrap at 2**30
print("ticks", time.ticks_diff(1, (1 << 30) - 1), ticks_diff(w, 1), time.ticks_add((1 << 30) - 1, w))
print("INLINE BOXED OK")

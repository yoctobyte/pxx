# Network census: library compiled unchanged (tools/mpy_driver_census.sh net).
import asyncio
import uaiohttpclient as aiohttp


async def fetch(url):
    resp = await aiohttp.request("GET", url)
    print("uaiohttpclient:", resp.status)
    body = await resp.read()
    print("uaiohttpclient:", len(body), "bytes")


asyncio.run(fetch("http://10.0.2.2:8080/"))

# Rung 3 of feature-nilpy-star-args-kwargs: forwarding a COLLECTED *args into a
# callee with ordinary parameters — songformatter's settings.py getF/getI shape.
#
# The argument count is only known at run time, so this is a DESUGARING: a
# dispatch on len(args) over the arities the callee accepts, with a runtime check
# that fails loudly outside them and refuses forwarded keyword arguments (binding
# a runtime dict onto named parameters needs a call protocol NilPy does not have).


def join2(a, b):
    return str(a) + "/" + str(b)


def fwd(*args):
    return join2(*args)


def join3(a, b, c):
    return str(a) + "/" + str(b) + "/" + str(c)


def fwd3(*args):
    return join3(*args)


print(fwd("UI", "size"))
print(fwd(1, 2))
print(fwd3("a", "b", "c"))


# A CONTAINER-typed callee parameter. pylib's `sum(l: TPyList)` is class-typed,
# and the forwarder used to refuse it at COMPILE time ("parameter l has a type
# no runtime argument can be coerced to") — a refusal of a valid CPython
# program, the one direction NilPy's upward-compatibility rule forbids. The
# layer below already knew how: IRLowerCallArg unboxes a variant into a class
# parameter, tag-checked, which is why the ordinary `sum(d["k"])` always worked.
# bug-nilpy-star-forwarder-refuses-a-container-typed-parameter
print(sum(*[[1, 2]]))
print(sorted(*[[3, 1, 2]]))
print(len(*[[1, 2, 3]]))
print(sum(*[[1.5, 2.5]]))
print("-".join(*[["a", "b"]]))


# ...and into a USER def taking a list, plus a mixed container+scalar callee.
def take(xs):
    return sum(xs)


def two(xs, n):
    return sum(xs) + n


print(take(*[[5, 6]]))
print(two(*[[1, 2], 10]))


# The CONTROL: a parameter no variant can become (sorted's `key` is a callable)
# must still not be mis-bound. It no longer refuses the whole call at compile
# time — CPython's `sorted(*[xs])` supplies one argument and never reaches
# `key` — but supplying it anyway is a run-time TypeError, which is what CPython
# raises for the same program.
try:
    print(sorted(*[[3, 1], "notakey"]))
except TypeError:
    print("TypeError")

# unary minus dunder (__neg__) on a user class -- every expectation is
# CPython's own output.

class Neg:
    def __init__(self, v):
        self.v = v
    def __neg__(self):
        return Neg(-self.v)
    def __repr__(self):
        return f"Neg({self.v})"

n = Neg(5)
print(-n)
print(-Neg(-3))

x = 5
print(-x)
print(-(x + 1))
print(-7 // 2)

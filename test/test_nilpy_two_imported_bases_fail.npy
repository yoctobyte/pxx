# is the one outcome worse than not supporting the shape.
# bug-nilpy-multiple-inheritance-from-an-imported-base-is-refused
# mixinproto is a PASCAL unit, so it is named with its extension: a bare NilPy
# import resolves to Python (.py/.npy) only
# (decide-nilpy-imports-that-collide-with-a-pascal-rtl-unit, user 2026-08-19).
import 'mixinproto.pas' as mixinproto
# mixinproto2 is a PASCAL unit, so it is named with its extension: a bare NilPy
# import resolves to Python (.py/.npy) only
# (decide-nilpy-imports-that-collide-with-a-pascal-rtl-unit, user 2026-08-19).
import 'mixinproto2.pas' as mixinproto2


class Two(mixinproto.Protocol, mixinproto2.Protocol2):

# socket, the IPv4 TCP subset (lib/rtl/mimic_socket.pas), against CPython:
# the .expected is python3's output of this file. One process, no threads:
# connect() completes against the listen backlog before accept() runs, so a
# client and a server fit in one straight-line script.
#
# ALSO THE REGRESSION ROW FOR A COMPILER FIX (pasparser_name.inc,
# ConsumeUnitQualifier): the shim's class is named `socket`, like the module,
# and accept() builds a new one with `socket.Create`. Before the fix, inside
# the shim that qualifier resolved to the pending unit entry `socket`, the
# constructor ran on Self instead of making a connection object, and this
# script segfaulted at `srv.accept()` (measured 2026-09-25, pin v425). Pin
# v426 carries the fix; lib-test builds this with $(PXX_STABLE).
import socket

srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
srv.bind(("127.0.0.1", 0))
srv.listen(4)
host, port = srv.getsockname()
print("bound", host, port > 0)

srv.setblocking(False)
try:
    srv.accept()
    print("accept: unexpected connection")
except OSError:
    print("accept: nothing pending -> OSError")
srv.setblocking(True)

cli = socket.socket()
cli.connect(("localhost", port))
cli.sendall(b"GET / HTTP/1.0\r\n\r\n")
conn, addr = srv.accept()
print("peer", addr[0])
req = conn.recv(512)
print("request", req)
n = conn.send(b"HTTP/1.0 200 OK\r\n\r\nhello")
print("sent", n)
conn.close()
reply = b""
while True:
    chunk = cli.recv(4)
    if not chunk:
        break
    reply = reply + chunk
print("reply", reply)
cli.close()
try:
    socket.socket().connect(("no.such.host.invalid", 1))
except OSError:
    print("unknown host -> OSError")
with socket.socket() as s:
    print("with ok", s.fileno() >= 0)

# ERRORS AND TIMEOUTS: CPython's OSError subclass and its exact str().
srv.setblocking(False)
try:
    srv.accept()
except OSError as e:
    print("non-blocking accept:", str(e))
print("gettimeout after setblocking(False):", srv.gettimeout())
srv.settimeout(0.2)
print("gettimeout:", srv.gettimeout())
try:
    srv.accept()
    print("accept: unexpected connection")
except TimeoutError as e:
    print("accept with timeout: TimeoutError", str(e))
cli = socket.socket()
cli.connect(("127.0.0.1", port))
conn, addr = srv.accept()
conn.settimeout(0.1)
try:
    conn.recv(16)
    print("recv: unexpected data")
except TimeoutError as e:
    print("recv with timeout: TimeoutError", str(e))
cli.sendall(b"late")
print("recv after data:", conn.recv(16))
conn.close()
cli.close()
srv.settimeout(None)
print("gettimeout after None:", srv.gettimeout())
try:
    srv.settimeout(-1)
except ValueError as e:
    print("negative timeout: ValueError", str(e))

# a port nobody listens on: bound, then closed, so it is free and closed
gone = socket.socket()
gone.bind(("127.0.0.1", 0))
dead = gone.getsockname()[1]
gone.close()
for t in [None, 1.0]:
    c = socket.socket()
    c.settimeout(t)
    try:
        c.connect(("127.0.0.1", dead))
        print("connect: unexpected success")
    except ConnectionRefusedError as e:
        print("refused connect, timeout", t, ": ConnectionRefusedError", str(e))
    c.close()
srv.close()
print("done")

# After a `for i in range(...)`, the name holds the LAST VALUE YIELDED — not the
# value that failed the test, and not `start` when the loop never ran.
#
# The counted-loop desugar used to make the user's variable BE the counter, which
# is one choice producing two silent wrong values: it is initialised before the
# guard and incremented before the guard is re-tested, so on normal exit it held
# the failing value (`range(3)` left 3, `range(0, 10, 3)` left 12 against
# CPython's 9 — not a uniform off-by-one), and on ZERO iterations it held `start`,
# so an unentered loop overwrote whatever the name already had.
# bug-nilpy-for-range-counter-survives-with-the-wrong-value
#
# Fixed by looping on a hidden counter and assigning the user's variable from it
# at the top of each body iteration. Measured cost at -O2 over a 200 x 200000
# `for i in range(n)` accumulate: min 1.29s with the copy vs 1.31s without, mean
# 1.491 vs 1.513 over 8 runs each — i.e. inside the run-to-run noise, and if
# anything faster. So the cheap-but-partial alternative (subtract the step on
# exit, plus an entry guard) was not needed.
#
# Every line below is diffed against CPython.


# the plain form — no explicit step, which is the arm `range(n)` takes
for i in range(3):
    pass
print("i", i)

# an explicit start
for j in range(5, 8):
    pass
print("j", j)

# an explicit STEP, where the old bug was not an off-by-one but off-by-step
for k in range(0, 10, 3):
    pass
print("k", k)

# a DESCENDING step
for d in range(10, 0, -3):
    pass
print("d", d)

# an EMPTY range must leave an existing binding completely alone
m = 99
for m in range(0):
    pass
print("m", m)

# ...and an empty range with a start/stop that never enters
p = 7
for p in range(5, 5):
    pass
print("p", p)

# NESTED loops: both variables independently correct
for a in range(3):
    for b in range(2):
        pass
print("nested", a, b)

# `break` leaves the value AT the break point — this was already correct before
# the fix and had to stay so, which is why the hidden counter is copied at the top
# of the body rather than corrected after the loop
for n in range(10):
    if n == 4:
        break
print("break", n)

# a loop that runs exactly once
for o in range(1):
    pass
print("once", o)

# the body may READ the variable, so the copy has to be the FIRST statement
tot = 0
for r in range(4):
    tot = tot + r
print("sum", tot, "last", r)

# reassigning the loop variable INSIDE the body must not be undone by the next
# iteration's copy being missing — CPython re-binds from the iterator each time
for w in range(3):
    w = w * 10
print("rebound", w)

# a COMPREHENSION's loop name must NOT leak into the enclosing scope. It already
# loops on a hidden name, which is why comprehensions keep the old shape and pay
# nothing for this fix.
q = 'untouched'
vals = [q for q in range(3)]
print("comp", vals, q)

# and a comprehension over a stepped range
vals2 = [z * 2 for z in range(0, 6, 2)]
print("comp2", vals2)

# range over a computed (non-literal) bound, which takes the runtime-step path
def upto(x):
    return x

for t in range(upto(3)):
    pass
print("computed", t)

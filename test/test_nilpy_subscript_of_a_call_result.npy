# bug-nilpy-subscript-of-a-call-result-ignores-the-index
#
# Two silent wrong answers on one shape — a subscript applied directly to a CALL
# RESULT rather than to a name.
#
# 1. A str-returning call was indexed by PASCAL's rule: 1-based, no negatives,
#    no slices. So `f()[1]` yielded character 0, `f()[-1]` yielded nothing, and
#    `f()[1:2]` did not compile. `f()[0]` was "correct", which is exactly how it
#    survived — any probe must use a NON-ZERO index.
#
# 2. A chained subscript `f()[0][0]` produced the FIRST subscript's value again
#    (`['a', 1]` instead of `'a'`), or None, or SEGFAULTED for a dict of dicts.
#    The first subscript of a container-returning call yields a variant, and the
#    chained-selector loop had no arm for indexing one.
#
# Both now go through the SAME builders a named receiver uses — PyMakeStrIndex
# and PyMakeSuffixIndex — so the two spellings agree by construction rather than
# by two paths happening to match. That is the point of the paired assertions
# below: every case is checked as `f()[...]` AND as `x = f(); x[...]`, because
# this whole family is one path learning what the other already knew.
#
# Found by a realistic CSV-parsing program, not a probe: it printed four correct
# lines and then crashed on `sorted(rows, key=...)[0]["name"]`.
#
# Expectations are CPython's own output.


def s():
    return "abcde"


def rows():
    return [["a", 1], ["b", 2]]


def deep():
    return {"k": {"j": 7}}


def dicts():
    return [{"k": "v"}, {"k": "w"}]


def nested():
    return [[[1, 2]]]


def one(n):
    return "xyz"


# --- 1. a str-returning call: index, negative index, slices ---
print(s()[1], s()[0], s()[4], s()[-1], s()[-5])
print(s()[1:3], s()[:2], s()[2:], s()[::-1], s()[::2], s()[1:4:2])
print(one(0)[1], one(0)[-1])

# the same through a NAME — must agree
t = s()
print(t[1], t[0], t[4], t[-1], t[-5])
print(t[1:3], t[:2], t[2:], t[::-1], t[::2], t[1:4:2])

# --- 2. chained subscripts ---
print(rows()[0][0], rows()[0][1], rows()[1][0])
print(deep()["k"]["j"])
print(dicts()[0]["k"], dicts()[1]["k"])
print(nested()[0][0][1])

# the same through a NAME — must agree
r = rows()
print(r[0][0], r[0][1], r[1][0])
d = deep()
print(d["k"]["j"])

# --- builtin calls in the same positions ---
print(sorted([["b", 2], ["a", 1]])[0][0])
print(list([["a", 1]])[0][0])
print("a-b-c".split("-")[1])
print(sorted(["bb", "a"], key=len)[0])

# a lambda key over dicts — the shape that crashed
ds = [{"a": "3"}, {"a": "1"}]
print(sorted(ds, key=lambda x: int(x["a"]))[0]["a"])

# --- a call result indexed then METHOD-called, and a slice then indexed ---
print(s()[1:4].upper())
print(rows()[0][0].upper())
print(s()[::-1][0])

# --- controls: literals and names, which were always correct ---
print("abcde"[1], [["a", 1]][0][0], {"k": {"j": 7}}["k"]["j"])
xs = [["a", 1]]
print(xs[0][0])

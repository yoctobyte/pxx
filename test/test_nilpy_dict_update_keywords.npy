# dict.update() with KEYWORD arguments — the keywords are dict KEYS, not
# parameter names. Every receiver shape in one file, because they reach the
# call through different routes: a plain name goes through
# FindUMethOverloadAhead, a subscript result and an unannotated parameter go
# through the dynamic-dispatch path.
#
# bug-nilpy-small-builtin-surface-gaps-found-by-the-2026-08-13-sweep

# one keyword, then two, then three — the COUNT is what used to change the
# answer: the arity filter counted the keywords, so two of them matched no
# overload and fell through to update(l: TPyList), which then received a
# TPyDict and segfaulted.
a = {"k": 0}
a.update(z=6)
print(a)

b = {"k": 0}
b.update(z=7, y=8)
print(b)

c = {"k": 0}
c.update(z=7, y=8, w=9)
print(c)

# a `**` spread, which is not an expression and so could not be probed at all
d = {"k": 0}
d.update(**{"z": 7})
print(d)

# mixed: a spread and a keyword, later keys winning
e = {"k": 0}
e.update(**{"z": 1}, y=2)
print(e)

f = {"k": 0, "z": 1}
f.update(**{"z": 99})
print(f)

# no keywords at all — the ordinary dict argument must keep working
g = {"k": 0}
g.update({"z": 7, "y": 8})
print(g)

# dict() itself, the sibling that shares the builder
print(dict(p=1, q=2))
print(dict(**{"p": 1}, q=2))
print(dict())

# values that are ordinary expressions, not literals
n = 5
h = {}
h.update(sum=n + 1, txt="a" + "b", none=None, lst=[1, 2])
print(h)

# a FIELD receiver
class W:
    def __init__(self):
        self.d = {}

w = W()
w.d.update(p=1, q=2)
print(w.d)

# a SUBSCRIPT-result receiver — the dynamic path
xs = [{}]
xs[0].update(r=1, s=2)
print(xs[0])

# an unannotated PARAMETER — also dynamic, and `update` is a name TPyList and
# TPySet carry too, so this used to resolve against TPyList.setupdate
def fill(m):
    m.update(a=1, b=2)
    m.update(**{"c": 3})
    return m

print(fill({}))

# the receiver keeps its identity — update mutates in place
orig = {"x": 1}
alias = orig
alias.update(y=2)
print(orig)
print(orig is alias)

# A POSITIONAL mapping BEFORE the keyword run -- `d.update(m, c=2)`, which is
# `{**m, 'c': 2}` and was the row of this gate never built. It refused with
# "unexpected token c", because both the argument loops and the OVERLOAD
# lookahead only ever asked whether the run started at the FIRST token.
#
# The overload half is what makes this more than a parse fix: with the seed
# counted as an argument the call looked like arity 2, no update arm has that
# arity, and the caller fell through to the first-declared arm -- update(TPyList)
# reading a TPyDict -- and SEGFAULTED. Exactly the failure PyDictKwOverloadAhead
# was written to remove, reached by the one shape its lookahead did not cover.
# bug-nilpy-dict-update-mixed-positional-and-keyword-args
h2 = {"a": 0}
h2.update({"b": 1}, c=2)
print(h2)

# ...through dict() too, and with a `**` spread in the same run
m2 = {"k": 1}
print(dict(m2, y=2))
print(dict(m2, **{"z": 9}, w=5))

# the seed is a mapping OR an iterable of pairs -- which one is a RUN-TIME
# fact, so it dispatches on the object's class. A list seed used to be the
# worse outcome: it compiled and then segfaulted.
g2 = {}
g2.update([("x", 1)], b=2)
print(g2)

# a keyword belonging to a NESTED call is not one of ours
def mk(a=0):
    return {"f": a}

h3 = {}
h3.update(mk(a=7))
print(h3)

# and the empty / no-seed forms still take the same route
print(dict())
print(dict(**{"q": 1}))

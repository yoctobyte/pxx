# bug-nilpy-one-line-def-and-class-bodies-do-not-parse — the CLASS half
#
# `class C: pass` was a hard compile error ("unexpected token"): the class header
# required `: NEWLINE INDENT`. It is the idiomatic empty placeholder and appears
# constantly in stubs, exception hierarchies and protocol classes.
#
# A one-line class body with real CONTENT works too, and matches CPython — the
# lexer synthesises the header's NEWLINE/INDENT/DEDENT whenever real code follows
# the colon, so it takes the ordinary indented path. That was accidental (the
# parser still carries a `only pass is supported` branch, now unreachable and
# documented as such), so the rows below turn it into an intended capability.
# bug-nilpy-one-line-class-body-restraint-is-no-longer-enforced

class Empty: pass


class Sub(Empty): pass


class Indented:
    pass


# the one-line class is a real class: constructible, subclassable, and its
# instances carry dynamic attributes like any other
e = Empty()
s = Sub()
print(type(e).__name__, type(s).__name__)
print(isinstance(s, Empty))

e.tag = 7
print(e.tag)


# it also mixes with ordinary classes declared either way
class Holder:
    def __init__(self):
        self.inner = Empty()

    def name(self):
        return type(self.inner).__name__


print(Holder().name())
print(type(Indented()).__name__)


# a one-line body with real content — an assignment, and a def
class WithField: x = 1
print(WithField.x)


class WithMethod: pass
print(type(WithMethod()).__name__)


class Two: y = 5
print(Two.y, Two().y)

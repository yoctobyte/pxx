# A method that RETURNS AN ATTRIBUTE leaks that attribute's whole graph, once
# per call, whenever the receiver is short-lived.
#
# THIS IS THE SAME DEFECT AS
# test_nilpy_a_variant_carried_method_result_does_not_leak.npy AND IT IS THE
# ONLY SHAPE OF IT AN RSS GAUGE CAN SEE. The defect is a leaked REFERENCE, and
# a reference costs no bytes while its referent is long-lived -- which is what
# every earlier rate table in this family measured, and why several of them
# read 0 for a shape that leaks. Give the receiver a SHORT life (build it
# inside the loop, drop it at the bottom) and the same leaked reference keeps
# a dead object's graph alive, one graph per call, forever.
#
# MEASURED 2026-09-15 at cfee5d6255237332, N=40000, site-attributed with
# -dPXX_OBJTRACE plus sys.stderr.write markers:
#
#   bare        return self.q                     1095 bytes/call
#   ifexp       return self.q if c else self.r    1095
#   vialocal    x = self.q; return x              1096
#   computed    work, then return self.q          1095
#   discard     h.bare(), result not stored       1095
#   index       return self.q[0]  (a scalar)         0
#   chain       return self.n     (a scalar)         0
#   variantrecv via an UNANNOTATED receiver           0
#   control     build the receiver, call nothing     0
#
# DISCARD LEAKING THE SAME AMOUNT IS THE LOAD-BEARING ROW. With no store there
# is no store-retain, so the surplus is not the store's: the RETURN mints +1
# and the direct call path never drops it. Keep that row.
#
# THE UNANNOTATED-RECEIVER ROW IS THE OTHER CONTROL AND IT IS NOT DECORATION.
# That path routes the result through a hidden __py_vt_N Variant temp whose own
# scope-release consumes the +1, so it is BALANCED -- and a fix that repairs
# the direct path by removing a retain breaks THAT path instead, which is
# exactly what c304147cdebded94 shipped: it freed the receiver's attribute and
# SIGSEGV'd on the third pass. Both columns must stay at 0.
#
# THRESHOLD IS A RELATION. The smallest real leak here is 199 (the slice form,
# which is a separate surplus and deliberately not asserted); the smallest
# leaking row asserted is 1095. 150 sits below the first and far above noise
# at 40000 iterations.

class H:
    def __init__(self):
        self.q = [0] * 64
        self.r = [1] * 64
        self.n = 7
        self.on = True

    def bare(self):
        return self.q

    def ifexp(self):
        return self.q if self.on else self.r

    def vialocal(self):
        x = self.q
        return x

    def computed(self):
        t = self.n + 1
        if t > 0:
            return self.q
        return self.r

    def index(self):
        return self.q[0]

    def chain(self):
        return self.n


def via(o):
    return o.bare()


def rss_kb():
    f = open("/proc/self/statm")
    s = f.read()
    f.close()
    return int(s.split()[1]) * 4


N = 40000
LEAK_LIMIT = 150
held = []


def r_bare(n):
    for i in range(n):
        h = H()
        k = h.bare()


def r_ifexp(n):
    for i in range(n):
        h = H()
        k = h.ifexp()


def r_vialocal(n):
    for i in range(n):
        h = H()
        k = h.vialocal()


def r_computed(n):
    for i in range(n):
        h = H()
        k = h.computed()


def r_discard(n):
    for i in range(n):
        h = H()
        h.bare()


def r_index(n):
    for i in range(n):
        h = H()
        k = h.index()


def r_chain(n):
    for i in range(n):
        h = H()
        k = h.chain()


def r_variantrecv(n):
    for i in range(n):
        h = H()
        k = via(h)


def r_control(n):
    for i in range(n):
        h = H()


def r_retain(n):
    for i in range(n):
        held.append([0] * 16)


ok = True
rows = [("bare", r_bare), ("ifexp", r_ifexp), ("vialocal", r_vialocal),
        ("computed", r_computed), ("discard", r_discard),
        ("index", r_index), ("chain", r_chain),
        ("variantrecv", r_variantrecv), ("control", r_control)]

for name, fn in rows:
    fn(1000)
    base = rss_kb()
    fn(N)
    per = ((rss_kb() - base) * 1024) // N
    if per < LEAK_LIMIT:
        print("%s LEAKFREE" % name)
    else:
        print("%s LEAKS %d bytes/call" % (name, per))
        ok = False

# The positive control. Every row above asserts a number stays near ZERO, so a
# broken gauge -- statm unreadable, the parse returning 0, the loop not
# running -- passes all of them. This one MUST move.
r_retain(1000)
base = rss_kb()
r_retain(N)
ctrl = ((rss_kb() - base) * 1024) // N
if ctrl > 100:
    print("control MOVES")
else:
    print("control DEAD %d -- every LEAKFREE above is meaningless" % ctrl)
    ok = False

if ok:
    print("GETTERLIVE OK")
else:
    print("GETTERLIVE FAIL")

# A comprehension whose element is a conditional with branches of DIFFERENT
# types, over a variant-typed parameter — and the same comprehension assigned
# back to that parameter. The first used to stringify the numbers silently
# ([0,'x',2] came out ['0','x','2']); the second did not compile at all.
def shift(values, by):
    return ["x" if v == "x" else v - by for v in values]


def shift_in_place(values, by):
    values = ["x" if v == "x" else v - by for v in values]
    return values


print(shift([1, "x", 3], 1))
print(shift_in_place([1, "x", 3], 1))

# a fresh name is still born as the list itself (the path above must not
# capture it): tuple-unpacking comprehension targets keep working
pairs = [(1, "a"), (2, "b")]
names = [n for _, n in pairs]
print(names)

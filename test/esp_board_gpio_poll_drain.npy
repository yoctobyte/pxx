# SPDX-License-Identifier: 0BSD
# BOARD ONLY: interrupts.poll() is a drain point for PYTHON too, and the budget
# defers rather than drops.
#
#   PXX=$PWD/compiler/pascal26 PXX_MAIN=$PWD/test/esp_board_gpio_poll_drain.npy \
#     tools/esp_flash.sh --project examples/esp32/gpio-edge-s3 --no-verify --seconds 25
#
# (For the C3, --project examples/esp32/gpio-edge-c3.)
#
# The Pascal twin is test/esp_board_gpio_poll_drain.pas and carries the full
# reasoning. This file exists because the owner's settled model is about PYTHON
# draining the event, and a Pascal-only proof leaves the language the model is
# written for untested on silicon. examples/esp32/gpio-edge-{c3,s3} drain with
# time.sleep(); poll() was hosted-only until this row.
#
# THIS ASSERTS THE SAME FOUR CLAIMS AT THE SAME STRENGTH AS THE PASCAL TWIN.
# An earlier version of this header claimed the Python surface could not reach
# the drain budget or the in-drain flag, because interrupts' lowercase surface is
# only events/poll/pending/dropped/delivered/on_event. That was WRONG, and it was
# a limitation inferred from a listing instead of measured: NilPy calls the
# Pascal names directly. Measured on x86-64 hosted, and by frankd-90 on x86-64,
# i386, arm32 and riscv32 under qemu:
#
#   interrupts.IntSetDrainBudget(4); interrupts.IntDrainBudget()  -> 4
#   10 pushed, one poll()                                         -> 4, 6 left
#   interrupts.IntInDrain() inside a handler                      -> True
#
# There are simply no lowercase aliases for those three. So the BUDGET row below
# asserts against IntDrainBudget() read at run time, exactly as the Pascal twin
# does, rather than against a hardcoded 16 -- which would pass for the wrong
# reason the day the default moves.
#
# NO WIRING NEEDED: the pin is INPUT_OUTPUT and the pad drives its own input.
# Under QEMU there are NO edges (no GPIO input path modelled), and a run with
# zero edges satisfies every invariant below trivially -- so it fails loudly
# instead of passing vacuously.

import interrupts
import 'espgpio.pas' as gpio

PIN = 5
N_SMALL = 10
N_OVER = 40

seen = [0, 0]          # count, wrong-id count
nested = [-1, 0, 0]    # poll rc inside a handler, probe-armed, in-drain seen
fails = [0]


def check(ok):
    if not ok:
        fails[0] = fails[0] + 1


def on_edge(ev):
    seen[0] = seen[0] + 1
    if ev.id != PIN:
        seen[1] = seen[1] + 1
    if nested[1] == 1:
        if interrupts.IntInDrain():
            nested[2] = 1
        nested[0] = interrupts.poll()
        nested[1] = 0


def settle():
    # Busy, and deliberately NOT time.sleep: a sleep here would make this a
    # test of the sleep drain, which gpio-edge already covers. The GPIO status
    # bit is a latch, so the ISR must run between edges.
    k = 0
    while k < 400:
        k = k + 1


def pulses(n):
    for i in range(n):
        gpio.gpio_write(PIN, 0)
        settle()
        gpio.gpio_write(PIN, 1)
        settle()


def drain_all(limit):
    polls = 0
    while interrupts.pending() > 0 and polls < limit:
        interrupts.poll()
        polls = polls + 1
    return polls


def main():
    print("inout", gpio.gpio_inout(PIN))
    gpio.gpio_write(PIN, 0)
    interrupts.on_event(interrupts.INT_SRC_GPIO, on_edge)
    print("armed", gpio.on_rising(PIN))
    budget = interrupts.IntDrainBudget()
    print("budget", budget)
    check(budget > 0)

    # ORDERING: edges, no sleep, no poll -> nothing delivered.
    pulses(N_SMALL)
    isr0 = gpio.gpio_edges()
    print("after-edges isr", isr0, "pending", interrupts.pending(),
          "delivered", interrupts.delivered(), "seen", seen[0])

    if isr0 == 0:
        print("POLL-DRAIN-NO-EDGES isr", isr0)
        print("POLL-DRAIN-PY-DONE failures", 1)
        return

    check(seen[0] == 0)
    check(interrupts.delivered() == 0)
    check(interrupts.pending() > 0)

    # POLL: one call, no sleep anywhere before it.
    n1 = interrupts.poll()
    print("poll1 returned", n1, "seen", seen[0], "pending", interrupts.pending())
    check(n1 > 0)
    check(seen[0] == n1)
    check(interrupts.pending() == 0)
    check(seen[1] == 0)
    check(gpio.gpio_edges() == interrupts.delivered() + interrupts.dropped())

    # BUDGET: more pending than one poll takes. The property, not the number.
    isr1 = gpio.gpio_edges()
    dropped_before = interrupts.dropped()
    pulses(N_OVER)
    pend = interrupts.pending()
    print("over-budget isr-added", gpio.gpio_edges() - isr1,
          "pending", pend, "dropped", interrupts.dropped())
    check(pend > budget)
    check(interrupts.dropped() == dropped_before)   # fits the ring: no drops

    n2 = interrupts.poll()
    left = interrupts.pending()
    print("poll2 returned", n2, "budget", budget, "pending-left", left)
    # EXACTLY the budget, against the value read at run time.
    check(n2 == budget)
    check(left == pend - n2)  # the rest is PENDING, i.e. deferred
    check(left > 0)
    check(interrupts.dropped() == dropped_before)   # deferred, NOT dropped

    polls = drain_all(100)
    print("drained polls", polls + 1, "pending", interrupts.pending())
    check(interrupts.pending() == 0)
    check(polls < 100)
    check(seen[0] == interrupts.delivered())
    check(gpio.gpio_edges() == interrupts.delivered() + interrupts.dropped())

    # NESTED: a poll from inside a handler is refused.
    nested[0] = -1
    nested[1] = 1
    pulses(3)
    interrupts.poll()
    drain_all(100)
    print("nested rc", nested[0], "in-drain", nested[2])
    check(nested[0] == 0)
    check(nested[2] == 1)

    print("off", gpio.edge_off(PIN))
    print("final isr", gpio.gpio_edges(), "delivered", interrupts.delivered(),
          "dropped", interrupts.dropped(), "seen", seen[0])
    check(gpio.gpio_edges() == interrupts.delivered() + interrupts.dropped())
    check(seen[0] == interrupts.delivered())

    print("POLL-DRAIN-PY-DONE failures", fails[0])


main()

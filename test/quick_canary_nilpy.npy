# Quick-tier NilPy canary (feature-t-quick-canary-for-nilpy-and-c).
#
# BROAD, not deep: one or two lines per layer that actually breaks, so a Track N
# or shared-parser change gets a cheap signal inside the ~12s dev loop. It is a
# CANARY, not coverage -- coverage is `make test-nilpy` and Track T's matrix.
#
# House rule for .npy: the expectation is CPython's own output, so this file
# must run unmodified under `python3` and print exactly the same thing.
#
# Every section prints its own `ok <n>` BEFORE the summary, so a failure
# localises instead of collapsing to one opaque mismatch. The last line is the
# oracle the Makefile compares.

ok = 0


def chk(n, cond):
    global ok
    if cond:
        ok = ok + 1
        print("ok " + str(n))
    else:
        print("FAIL " + str(n))


# --- containers -------------------------------------------------------------
xs = [3, 1, 2]
xs.append(4)
chk(1, len(xs) == 4)
chk(2, xs[0] == 3 and xs[-1] == 4)
d = {"a": 1, "b": 2}
d["c"] = 3
chk(3, len(d) == 3 and d["b"] == 2)
chk(4, "a" in d and "z" not in d)

# --- str methods ------------------------------------------------------------
s = "Hello,World"
chk(5, s.upper() == "HELLO,WORLD")
chk(6, s.lower() == "hello,world")
parts = s.split(",")            # two-step: bug-n-nilpy-subscript-of-split-on-a-variable-receiver
chk(7, parts[1] == "World")
chk(8, s.replace(",", " ") == "Hello World")
chk(9, len(s) == 11 and s[0] == "H")
chk(10, "  pad  ".strip() == "pad")

# --- int promotion / arithmetic ---------------------------------------------
big = 1000000
chk(11, big * big == 1000000000000)
chk(12, 7 // 2 == 3 and 7 % 2 == 1)
chk(13, -7 // 2 == -4)
chk(14, 2 ** 10 == 1024)

# --- classes and dunders ----------------------------------------------------
class Vec:
    def __init__(self, x, y):
        self.x = x
        self.y = y

    def __add__(self, other):
        return Vec(self.x + other.x, self.y + other.y)

    def __eq__(self, other):
        return self.x == other.x and self.y == other.y

    def total(self):
        return self.x + self.y


a = Vec(1, 2)
b = Vec(3, 4)
c = a + b
chk(15, c.x == 4 and c.y == 6)
chk(16, c.total() == 10)
chk(17, Vec(1, 2) == a)


class Base:
    def name(self):
        return "base"


class Derived(Base):
    def name(self):
        return "derived"


chk(18, Base().name() == "base" and Derived().name() == "derived")

# --- exceptions -------------------------------------------------------------
caught = 0
try:
    raise ValueError("boom")
except ValueError:
    caught = 1
chk(19, caught == 1)

caught2 = 0
try:
    _ = [1, 2] + "x"
except TypeError:
    caught2 = 1
chk(20, caught2 == 1)

# --- closures ---------------------------------------------------------------
def adder(n):
    def add(v):
        return v + n
    return add


add5 = adder(5)
chk(21, add5(10) == 15)

# --- control flow -----------------------------------------------------------
tot = 0
for i in range(5):
    if i % 2 == 0:
        continue
    tot = tot + i
chk(22, tot == 4)

w = 0
n = 0
while n < 4:
    w = w + n
    n = n + 1
chk(23, w == 6)

# --- string literal handles -------------------------------------------------
# A string literal is a HANDLE, and several passes now hand back a shared,
# refcounted .data block instead of a fresh allocation per evaluation
# (EmitStaticLitHandle / EmitStaticLitHandleA64, promoted to -O2 2026-08-30).
# This section exists because that whole class can pass every gate available at
# PUSH time and still be broken: `make test-nilpy` is full-tier only, so a
# literal-handle bug reaches the pin shadow before anything sees it. It cost 24
# red jobs on 2026-08-30 (`x = "a" * 3` gave 285, reverted in 72b4c47a7), and
# the failing line was two characters long.
# Checks 24-27 have been VERIFIED TO FAIL on the bug they were written for, not
# merely observed to pass: a compiler built at 9588c8535 (the reverted
# string-literal marshalling opt, real fixedpoint fe797c461687, 2 rounds) prints
# `total ok 26 / 27` here, failing 24 and ONLY 24. A canary nobody has watched
# fail is indistinguishable from one that is not measuring.
chk(24, len("a" * 3) == 3)              # the exact 24-job repro
lit_v = "a"
chk(25, len(lit_v * 3) == 3)            # ...and via a variable, which stayed correct


def take_lit(s):
    return len(s)


chk(26, take_lit("hello") == 5)         # a literal reaching a callee's parameter
tmp = ""
for _ in range(200):
    tmp = "loop literal"                # re-evaluated; must not walk a shared
chk(27, tmp == "loop literal" and len(tmp) == 12)   # refcount down to a free

# --- star and keyword CALL FORMS --------------------------------------------
# The arms that served these lived in TWO places: pyparser.inc's own argument
# loop, and a dead copy inside the shared Pascal one (ParseFactorCore), guarded
# by `isNilPy` where the question was `PyExprMode`. The dead copy was deleted
# 2026-08-31 after every arm was shown never to fire
# (bug-a-the-nilpy-arms-in-the-shared-call-loop-are-dead-and-guarded-by-the-wrong-flag).
# These checks are what says the SURVIVING copy is the one doing the work. They
# are here and not in the full tier for the reason the section above records:
# `make test-nilpy` runs after the push, and this class of change is exactly the
# one that can look green at push time.
def two(a, b):
    return a * 10 + b


def collect(*args):
    n = 0
    for v in args:
        n = n + v
    return n


star_xs = [3, 4]
chk(28, two(*star_xs) == 34)            # star into a callee's fixed slots
chk(29, two(1, *[9]) == 19)             # ...and a star that is NOT the first argument
star_more = [5, 6, 7]
chk(30, collect(*star_more) == 18)      # star spliced into a collecting callee
chk(31, collect(1, *star_more) == 19)   # ...mixed with a written argument
chk(32, sum(v * 2 for v in [1, 2]) == 6)   # a BARE generator expression as an argument
chk(33, dict(a=1, b=2) == {"a": 1, "b": 2})   # keyword names are dict KEYS
kw_src = {"c": 3}
chk(34, dict(**kw_src) == {"c": 3})     # ...and a mapping spread
chk(35, sorted(["bb", "a"], key=len) == ["a", "bb"])   # a callable in a callback slot

# A VARIABLE operand above and a LITERAL one here, deliberately: they do not
# take the same path. With pyparser.inc's splice arm disabled as a control,
# every variable form was REJECTED ("expected expression") and `collect(*[..])`
# still compiled and answered 18 -- so a literal-only check watches nothing.
chk(36, collect(*[5, 6, 7]) == 18)      # ...and the literal operand's own path
print("total ok " + str(ok) + " / 36")

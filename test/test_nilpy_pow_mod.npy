# pow(base, exp, mod) — modular exponentiation, item 1 of
# bug-nilpy-sweep-gaps-pow-thousands-sep-stepped-slice. It is genuinely a
# different algorithm rather than `(a ** b) mod m`: the intermediate power
# overflows long before the modulus does, which is the whole reason the
# three-argument form exists.
#
# Three things here are easy to get subtly wrong, so each is pinned:
#   * the result carries the SIGN OF THE MODULUS — pow(2, 3, -5) is -2, not 3
#     (Python's floored modulo, not what a plain `mod` gives);
#   * a NEGATIVE exponent is the modular INVERSE raised to |exp| (CPython 3.8+),
#     and raises ValueError when the base is not coprime with the modulus;
#   * every intermediate product is accumulated by doubling, because a plain
#     `a * b` overflows Int64 as soon as the operands pass 2^31 even though the
#     RESULT is bounded by m — the 2^62 rows are what catch that.
#
# Every expectation is CPython's.

print(pow(2, 10, 1000), pow(2, 10), pow(3, 0, 7), pow(0, 0, 1))
print(pow(5, 3, 13), pow(2, 3, -5), pow(-2, 3, 5), pow(-2, 3, -5))
print(pow(123456789, 65537, 1000000007))
print(pow(2, 62, 4611686018427387903), pow(7, 1, 1))
print(pow(2, -1, 5), pow(3, -1, 7), pow(10, -3, 17))
print(pow(2, -5, 1000000007))
try:
    print(pow(2, 3, 0))
except ValueError:
    print("ValueError-zero-mod")
try:
    print(pow(2, -1, 4))
except ValueError:
    print("ValueError-not-invertible")

# the other two items of that ticket, already fixed by the time it was picked
# up — pinned here so they stay fixed
print("{:,}".format(1234567))
print("abcdef"[1:5:2], [1, 2, 3, 4, 5, 6][1:5:2], "abcdef"[::2], "abcdef"[::-1])

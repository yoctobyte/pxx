# A USER-CLASS instance must not leak because of HOW its value is consumed.
#
# Found 2026-09-14/15 while chasing lekkerzeilen's frame leak. TWO defects, both
# fixed now, and this file covers both.
#
# A USER OPERATOR ON A VARIANT OPERAND -- `a + b` where __add__ returns an
# object. pylib's PyUserArithCall1 retained the dunder's result on the way into
# the variant, but a NilPy routine already hands back an owned +1, so every
# operation leaked its whole result. Measured: 100 iterations, 100 leaked
# instances; 63-64 bytes/call in RSS -> under the limit after.
#
# A CONSTRUCTION CONSUMED AS A METHOD RECEIVER -- `Quat(...).normalized()`.
# `C(...)` followed by `.` exited the construction arm to be "picked up
# downstream", and downstream the ATTRIBUTE spelling hoisted the construction
# into an ARC-eligible `__py_recv_N` while the METHOD spelling passed the
# conduit local straight through as arg 0, where nothing ever released it.
# Fixed by routing `.` into the same selector path the `[` spelling already
# used, which hoists. ctor_recv ASSERTED THIS LEAK DELIBERATELY until
# 2026-09-15 and now asserts LEAKFREE like its siblings.
#
# DO NOT "FIX" THIS BY MAKING THE ARG SPILL OWN PARAM 0. That is the obvious
# patch, it takes this row to zero, it passes all 963 tests of `make
# test-nilpy`, and it SEGFAULTS the lekkerzeilen demo in 3.0 s of frame loop --
# it releases the receiver at CALL END, and a bound callable outlives that.
# The hoist works because `__py_recv_N` is released at SCOPE exit instead.
# Banked in done/bug-n-a-construction-consumed-as-a-method-receiver-leaks.
#
# BOTH ARE ROUTE TRAPS AND THAT IS WHY THIS FIXTURE IS SHAPED THE WAY IT IS.
# The identical work spelled a different way is CLEAN in both cases:
#   c = a.add(b)      clean          c = a + b        leaked one per call
#   p = P(1, 2)       clean          P(1, 2).sum()    leaks one per call
# so a fixture that exercises the concept rather than the ROUTE certifies the
# bug. `add` and `__add__` below are byte-identical bodies on purpose, and both
# are asserted: the named one is the control that says the class itself is fine.
#
# AND THE OPERATOR ROUTE ONLY EXISTS WHEN AN OPERAND IS A VARIANT. The parser
# dispatches a statically-typed operand at compile time, and that path was always
# balanced. Every operand here arrives as an unannotated PARAMETER, which is what
# makes it a variant -- annotate them and this fixture stops testing anything.
#
# CPython agrees with every row now, verdict included -- which it did NOT while
# ctor_recv asserted a pxx defect CPython does not have. If a row is ever
# flipped to assert a defect again, restore that warning with it.
#
# THE THRESHOLD IS A RELATION. V is 32 bytes and Q is 40, so a one-per-call leak
# shows as 32-40 bytes of object plus allocator overhead -- measured at 63-72
# bytes/call before the fix. 16 is comfortably below that and far above noise at
# 12000 iterations.

def rss_kb():
    f = open("/proc/self/statm")
    s = f.read()
    f.close()
    return int(s.split()[1]) * 4


class V:
    def __init__(self, x=0.0, y=0.0, z=0.0):
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def add(self, o):
        return V(self.x + o.x, self.y + o.y, self.z + o.z)

    def __add__(self, o):
        return V(self.x + o.x, self.y + o.y, self.z + o.z)

    def __sub__(self, o):
        return V(self.x - o.x, self.y - o.y, self.z - o.z)

    def __mul__(self, s):
        return V(self.x * s, self.y * s, self.z * s)

    def sum3(self):
        return self.x + self.y + self.z


class Q:
    def __init__(self, w=1.0, x=0.0, y=0.0, z=0.0):
        self.w = float(w)
        self.x = float(x)
        self.y = float(y)
        self.z = float(z)

    def norm(self):
        return self.w + self.x + self.y + self.z


N = 12000
LEAK_LIMIT = 16          # bytes per call
held = []


def f_ctor_recv(n):
    t = 0.0
    for i in range(n):
        t = t + Q(1.0, 2.0, 3.0, 4.0).norm()
    return t


def f_ctor_bound(n):
    # the CONTROL for f_ctor_recv: same construction, bound instead of consumed
    t = 0.0
    for i in range(n):
        q = Q(1.0, 2.0, 3.0, 4.0)
        t = t + q.norm()
    return t


def f_op_add(n, a, b):
    t = 0.0
    for i in range(n):
        c = a + b
        t = t + c.x
    return t


def f_op_sub(n, a, b):
    t = 0.0
    for i in range(n):
        c = a - b
        t = t + c.x
    return t


def f_op_mul(n, a):
    t = 0.0
    for i in range(n):
        c = a * 2.0
        t = t + c.x
    return t


def f_op_discard(n, a, b):
    t = 0.0
    for i in range(n):
        t = t + (a + b).x
    return t


def f_named(n, a, b):
    # the CONTROL for the operator rows: identical body, reached by name
    t = 0.0
    for i in range(n):
        c = a.add(b)
        t = t + c.x
    return t


def f_retain(n):
    for i in range(n):
        held.append([0] * 16)


A = V(1.0, 2.0, 3.0)
B = V(4.0, 5.0, 6.0)
ok = True

# Each shape runs TWICE before anything is asserted. A first pass can move for
# one-off reasons (an arena page, a cache); a second pass on the same shape
# cannot, and it is the second that is measured.
base = rss_kb()
for r in range(2):
    f_ctor_recv(N)
    f_ctor_bound(N)
    f_op_add(N, A, B)
    f_op_sub(N, A, B)
    f_op_mul(N, A)
    f_op_discard(N, A, B)
    f_named(N, A, B)
    base = rss_kb()

second = {}
base = rss_kb()

f_ctor_recv(N)
now = rss_kb()
second["ctor_recv"] = ((now - base) * 1024) // N
base = now

f_ctor_bound(N)
now = rss_kb()
second["ctor_bound"] = ((now - base) * 1024) // N
base = now

f_op_add(N, A, B)
now = rss_kb()
second["op_add"] = ((now - base) * 1024) // N
base = now

f_op_sub(N, A, B)
now = rss_kb()
second["op_sub"] = ((now - base) * 1024) // N
base = now

f_op_mul(N, A)
now = rss_kb()
second["op_mul"] = ((now - base) * 1024) // N
base = now

f_op_discard(N, A, B)
now = rss_kb()
second["op_discard"] = ((now - base) * 1024) // N
base = now

f_named(N, A, B)
now = rss_kb()
second["named"] = ((now - base) * 1024) // N
base = now

for name in ["ctor_bound", "op_add", "op_sub", "op_mul", "op_discard",
             "named"]:
    if second[name] < LEAK_LIMIT:
        print("%s LEAKFREE" % name)
    else:
        print("%s LEAKS %d bytes/call" % (name, second[name]))
        ok = False

# Asserted like its siblings since 2026-09-15. It is still the row drawn from
# the right population -- a REAL one-per-call object leak of the exact size and
# shape this fixture is about, where `retain` below is a synthetic list any
# working instrument sees -- so it is worth keeping distinct in the output.
if second["ctor_recv"] < LEAK_LIMIT:
    print("ctor_recv LEAKFREE")
else:
    print("ctor_recv LEAKS %d bytes/call" % second["ctor_recv"])
    ok = False

f_retain(N)
now = rss_kb()
ctrl = ((now - base) * 1024) // N
if ctrl > 100:
    print("control MOVES")
else:
    print("control DEAD %d -- every LEAKFREE above is meaningless" % ctrl)
    ok = False

if ok:
    print("OBJLIFE OK")
else:
    print("OBJLIFE FAIL")

function Cert(const h: AnsiString): TCert;
begin
  Result := X509Parse(Hx(h));
end;

procedure Link(const tag: AnsiString; const c, iss: TCert);
var t: TCert;
begin
  SayBool(tag + '-parses', c.Ok and iss.Ok);
  SayBool(tag + '-verifies', X509VerifySig(c, iss));
  t := c;
  t.TbsRaw[40] := Chr(Ord(t.TbsRaw[40]) xor 1);
  SayBool(tag + '-tbs-changed-refused', not X509VerifySig(t, iss));
  t := c;
  t.SigValue[Length(t.SigValue) - 3] := Chr(Ord(t.SigValue[Length(t.SigValue) - 3]) xor 1);
  SayBool(tag + '-sig-changed-refused', not X509VerifySig(t, iss));
end;

begin
  nOk := 0; nFail := 0;
  { letsencrypt.org leaf, P-256 key, signed ecdsa-SHA384 by YE2's P-384 key }
  Link('leleaf-by-leye2', Cert(LELEAFHEX), Cert(LEYE2HEX));
  { Let's Encrypt YE2 by Root YE, P-384/SHA-384 }
  Link('leye2-by-lerootye', Cert(LEYE2HEX), Cert(LEROOTYEHEX));
  { Root YE by ISRG Root X2, P-384/SHA-384 }
  Link('lerootye-by-isrgx2', Cert(LEROOTYEHEX), Cert(ISRGX2HEX));
  { Sectigo DV E36 (github.com's issuer) by Root E46, P-384/SHA-384 }
  Link('ghe36-by-ghe46', Cert(GHE36HEX), Cert(GHE46HEX));
  { synthetic: P-384 leaf by a P-384 root, SHA-384 }
  Link('leafa-by-roota', Cert(LEAFAHEX), Cert(ROOTAHEX));
  { synthetic: self-signed P-384 root, SHA-384 }
  Link('roota-by-roota', Cert(ROOTAHEX), Cert(ROOTAHEX));
  { synthetic: sha384WithRSAEncryption }
  Link('leafb-by-rootb', Cert(LEAFBHEX), Cert(ROOTBHEX));
  { synthetic: self-signed RSA root, SHA-384 }
  Link('rootb-by-rootb', Cert(ROOTBHEX), Cert(ROOTBHEX));
  { synthetic: a P-256 key signing with SHA-384 }
  Link('leafc-by-rootc', Cert(LEAFCHEX), Cert(ROOTCHEX));
  { synthetic: a P-384 key signing with SHA-256 }
  Link('leafd-by-rootd', Cert(LEAFDHEX), Cert(ROOTDHEX));
  { synthetic: a P-384 key signing with SHA-512 }
  Link('leafe-by-roote', Cert(LEAFEHEX), Cert(ROOTEHEX));
  { system root Certum Trusted Network CA 2, sha512WithRSAEncryption }
  Link('certum2-by-certum2', Cert(CERTUM2HEX), Cert(CERTUM2HEX));

  { the wrong issuer, and a level skipped }
  SayBool('leafa-by-rootc-refused', not X509VerifySig(Cert(LEAFAHEX), Cert(ROOTCHEX)));
  SayBool('leafc-by-roota-refused', not X509VerifySig(Cert(LEAFCHEX), Cert(ROOTAHEX)));
  SayBool('leleaf-by-rootye-refused', not X509VerifySig(Cert(LELEAFHEX), Cert(LEROOTYEHEX)));
  SayBool('leafb-by-rootd-refused', not X509VerifySig(Cert(LEAFBHEX), Cert(ROOTDHEX)));

  { the whole link check on a synthetic P-384 chain: name, signature, dates, host }
  SayBool('chain-a-localhost', X509VerifyChain(Cert(LEAFAHEX), Cert(ROOTAHEX), '20261001000000', 'localhost'));
  SayBool('chain-a-other-host-refused', not X509VerifyChain(Cert(LEAFAHEX), Cert(ROOTAHEX), '20261001000000', 'example.org'));

  writeln('ok=', nOk, ' fail=', nFail);
end.

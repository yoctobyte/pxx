program lib_x509_sha384;
{ X509VerifySig on ecdsa-with-SHA384/512 and sha384/512WithRSAEncryption
  certificates and on P-384 issuer keys. Until 2026-09-29 every one of these
  answered FALSE (fail closed), so the native TLS client refused
  letsencrypt.org and github.com. Real certificates (letsencrypt.org's chain
  and ISRG Root X2, github.com's Sectigo E36/E46, fetched 2026-09-29; Certum
  Trusted Network CA 2 from the system store) and synthetic ones made with
  openssl 3 cover P-256 with SHA-256/384 and P-384 with SHA-256/384/512. Each
  link below was first checked with Python cryptography's
  verify_directly_issued_by. The rejections are the half that matters: a TBS
  byte changed, a signature byte changed, the wrong issuer, a skipped level.
  With the lib before this fix, every "-verifies" row and chain-a-localhost
  FAIL and every rejection row passes. }
uses x509;

var nOk, nFail: Integer;

procedure SayBool(const tag: string; b: Boolean);
begin
  if b then begin writeln(tag, '=ok'); nOk := nOk + 1; end
  else begin writeln(tag, '=FAIL'); nFail := nFail + 1; end;
end;

function Nyb(c: Char): Integer;
begin
  if (c >= '0') and (c <= '9') then Nyb := Ord(c) - Ord('0')
  else Nyb := Ord(c) - Ord('a') + 10;
end;

function Hx(const h: AnsiString): AnsiString;
var i: Integer;
begin
  Result := ''; i := 1;
  while i < Length(h) do begin Result := Result + Chr(Nyb(h[i]) * 16 + Nyb(h[i+1])); i := i + 2; end;
end;


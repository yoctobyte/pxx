# `def a(): q = Item(5); return q.n` was typed tyClass — the RECEIVER's class —
# while the value returned is the field's own type. It PRINTED correctly, because
# an integer field renders through the integer path and the value is an integer,
# so the wrong type and the right value cancelled out. `type(a()).__name__` on
# it SEGFAULTED, and so does anything else that treats a tyClass node as an
# object (which is how this was found: a rendering fix turned it into a crash).
# bug-nilpy-a-def-returning-a-field-is-typed-as-the-receivers-class
# Every expectation is CPython's own output.


class Item:
    def __init__(self, n):
        self.n = n


class Ann:
    def __init__(self):
        self.n: int = 5
        self.s: str = "x"


class Inner:
    def __init__(self):
        self.v = 42

    def get(self):
        return self.v


class Outer:
    def __init__(self):
        self.inner = Inner()
        self.name = "o"
        self.items = [1, 2]
        self.ratio = 1.5
        self.flag = True


def unannotated():
    q = Item(5)
    return q.n


def annotated_int():
    q = Ann()
    return q.n


def annotated_str():
    q = Ann()
    return q.s


def via_local():
    q = Item(5)
    v = q.n
    return v


print(type(unannotated()).__name__, unannotated())
print(type(annotated_int()).__name__, annotated_int())
print(type(annotated_str()).__name__, annotated_str())
print(type(via_local()).__name__, via_local())


def f_cls():
    o = Outer()
    return o.inner


def f_str():
    o = Outer()
    return o.name


def f_list():
    o = Outer()
    return o.items


def f_float():
    o = Outer()
    return o.ratio


def f_bool():
    o = Outer()
    return o.flag


print(type(f_cls()).__name__, f_cls().v, f_cls().get())
print(type(f_str()).__name__, f_str(), f_str().upper())
print(type(f_list()).__name__, f_list(), len(f_list()), f_list()[0])
print(type(f_float()).__name__, f_float(), f_float() + 0.5)
print(type(f_bool()).__name__, f_bool())


# the METHOD spelling of the same body — its signature is decided in a
# different pass, and the two must agree
class Node:
    def __init__(self, n):
        self.n = n

    def field(self):
        return self.n


print(Node(7).field(), type(Node(7).field()).__name__)
print(Node("s").field(), type(Node("s").field()).__name__)

# the result is usable as its real type, not just printable
print(unannotated() + 1, annotated_str() + "y", f_str() + "!")
print(sum([f_list()[0], f_list()[1]]))


# --- the METHOD sibling of every row above -------------------------------
# `def a(): q = Item(5); return q.n` was fixed; `return q.get()` was not, and
# the two shapes of one concept then answered differently. The call form is the
# WORSE half: a field read printed the right value because an int renders
# through the int path, while a method returning a str handed back a string
# handle the caller read as an object pointer and SEGFAULTED — no wrong value
# to notice first. It reproduces with no inheritance, no name collision and no
# None: one local, one method. The two-statement spelling `t = q.get(); return
# t` was correct throughout, which is what identifies this as the return-type
# scan rather than the call.
# regression-test-nilpy-test-nilpy-parent-call-after-instantiation


class Box:
    def __init__(self, n):
        self.n = n

    def get_int(self):
        return self.n

    def get_str(self):
        return "b" + str(self.n)

    def get_inner(self):
        return Inner()

    def plus(self, k):
        return self.n + k


class SubBox(Box):
    def get_str(self):
        return "sub:" + Box.get_str(self)


def make_box():
    return Box(3)


def m_int():
    q = Box(3)
    return q.get_int()


def m_str():
    q = Box(3)
    return q.get_str()


def m_cls():
    q = Box(3)
    return q.get_inner()


def m_args():
    q = Box(3)
    return q.plus(4)


def m_from_def():
    q = make_box()          # receiver bound from a DEF, not a constructor
    return q.get_str()


def m_inherited():
    q = SubBox(3)
    return q.get_str()


def m_via_local():
    q = Box(3)
    t = q.get_str()         # the spelling that always worked — the control
    return t


print(type(m_int()).__name__, m_int(), m_int() + 1)
print(type(m_str()).__name__, m_str(), m_str().upper())
print(type(m_cls()).__name__, m_cls().v, m_cls().get())
print(type(m_args()).__name__, m_args(), m_args() * 2)
print(type(m_from_def()).__name__, m_from_def(), m_from_def() + "!")
print(type(m_inherited()).__name__, m_inherited())
print(type(m_via_local()).__name__, m_via_local())


# controls: a MODULE-qualified call and a builtin conversion are not method
# calls on a local and must keep their own routes — the exact pair the
# intrinsic-collision fixes had to protect.
import math


def c_mod():
    return math.sqrt(9.0)


def c_conv():
    x = 7
    return str(x)


def c_strmeth():
    s = "abc"
    return s.upper()


print(type(c_mod()).__name__, c_mod())
print(type(c_conv()).__name__, c_conv())
print(type(c_strmeth()).__name__, c_strmeth())

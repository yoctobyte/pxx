from typing import Optional

class A:
    def __init__(self) -> None:
        self.f: Optional[str] = None

    def check(self, word: str) -> str:
        if self.f and word.upper() != self.f:
            return "skip"
        return "show"

a = A()
print(a.f is None)
print(a.check("dup"))
a.f = "DUP"
print(a.f is None)
print(a.check("dup"))
print(a.check("swap"))
a.f = None
print(a.f is None)
print(a.check("swap"))


# The RETURN path is the sibling of the assignment above, and only the
# assignment had the rule. `return None` from a str-returning def lowered the
# nil literal through variant->string and handed back the TEXT 'None', so
# `tok is None` was FALSE and the value was truthy — the exact failure the
# field case was fixed for, one statement kind over.
#
# `-> Optional[str]` is how every "no more input" accessor is spelled, so the
# shape that breaks is a loop whose only exit is `if x is None: break`. uforth's
# `.(` is that loop: it ran past the end of the line and appended the string
# 'None' forever, which is why `.( abc)` printed nothing and an isolated copy of
# the same body hung.
# bug-nilpy-return-none-from-a-str-returning-def-yields-the-text-None


class Src:
    def __init__(self) -> None:
        self.k = 0

    def next_token(self) -> Optional[str]:
        self.k = self.k + 1
        if self.k > 2:
            return None
        return "t" + str(self.k)

    def always(self) -> Optional[str]:
        return None

    def never(self) -> Optional[str]:
        return "x"


s = Src()
print(s.always() is None, s.never() is None)

# the loop shape, with a runaway guard so a broken build FAILS rather than hangs
got = []
n = 0
while True:
    tok = s.next_token()
    n = n + 1
    if n > 6:
        got.append("RUNAWAY")
        break
    if tok is None:
        break
    got.append(tok)
print(got, n)

# The case the block above used to say was NOT asserted, now asserted:
# `""` and None were the SAME value for a NilPy str, because Pascal's empty
# AnsiString IS a nil handle. Fixed by PXX_NILPY_STR, which stops a NilPy
# zero-length string collapsing to nil, so nil means only None again
# (bug-nilpy-empty-str-and-none-are-the-same-value).
#
# The rule the rows below pin is TAGGED vs UNTAGGED, not literal vs computed:
# a value that reaches `is None` as a runtime VARIANT (a list element, a dict
# value, an Optional) always carried its own tag and was already right; a value
# whose static type is plain `str` is a bare AnsiString handle and was wrong.
# So the plain-`str` rows are the regression surface and the variant rows are
# the control that must not move.


class E:
    def opt(self) -> Optional[str]:
        return ""

    def plain(self) -> str:
        return ""


def retnone() -> str:
    return None


# untagged: bare literal, annotated local, plain-`str` return
e = ""
print("" is None, e is None, E().plain() is None, E().opt() is None)

# untagged AND computed — every one of these is a pylib `: AnsiString` result,
# which is the half an earlier down-scoping of this ticket wrongly recorded as
# already correct. They reach `is None` with no tag, exactly like a literal.
print("abc".replace("abc", "") is None, "abc"[0:0] is None,
      "".join([]) is None, "  ".strip() is None, "x" * 0 is None)

# the OTHER direction, and the reason a constant-fold of `x is None` to False
# on a plain-`str` slot is not available: CPython does not enforce the
# annotation, so a `-> str` def may genuinely return None. This answered True
# by ACCIDENT before the fix — via the same nil that made "" wrong — so it is
# the row that catches a fix which only stops the collapse and forgets that
# pystr_none must still hand back nil.
print(retnone() is None)

# tagged: the control. Container-derived and Optional values were always right
# and must stay right.
print(["", "x"][0] is None, {"k": ""}["k"] is None)

# "" must still behave as an ordinary empty string in every other respect --
# a non-nil zero-length handle must not change length, truthiness or compares.
print(len(""), len(E().plain()), "" == "", E().plain() == "", bool(""))

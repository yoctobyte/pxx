# min/max take ANY number of positional arguments in Python. They are ordinary
# overloaded functions here, so 3 and 4 had hand-written all-Variant overloads
# and 5 had nothing; 3+ now folds through the 2-argument overload instead.
# feature-nilpy-min-max-variadic-more-than-two-args
print(min(3, 1, 2))
print(max(3, 1, 2))
print(min(3, 1, 2, 0))
print(max(1, 2, 3, 4, 5))
print(min(9, 8, 7, 6, 5, 4, 3))
print(max(2.5, 1.5, 3.5))
print(min(2.5, 1.5, 3.5, 0.5))
print(max("b", "a", "c"))
print(min("b", "a", "c"))

a = 4
b = 11
c = 7
print(min(a, b, c), max(a, b, c))
print(max(a + 1, b - 20, c * 2))

# the 1- and 2-argument forms must be untouched
print(min(3, 1))
print(max(3, 1))
print(min([4, 2, 9]))
print(max([4, 2, 9]))
print(max("hello"))


# a user shadow at an arity the fold would otherwise claim still wins
def min(a: int, b: int, c: int, d: int, e: int) -> int:
    return 100


print(min(1, 2, 3, 4, 5))

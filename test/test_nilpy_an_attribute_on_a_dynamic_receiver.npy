        self.pad13 = 13
        self.pad14 = 14
        self.pad15 = 15
        self.pad16 = 16
        self.tag = "k17"


def tag_of(o):
    return o.tag


for obj in [K1(), K2(), K3(), K4(), K5(), K6(), K7(), K8(), K9(), K10(), K11(), K12(), K13(), K14(), K15(), K16(), K17()]:
    print("F", tag_of(obj))

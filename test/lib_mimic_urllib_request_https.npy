"""urlopen over https with no backend registered by the program.

Driven by tools/urllib_https_devtest.sh against `openssl s_server -tls1_3
-www` on localhost, with SSL_CERT_FILE naming the CA that signed it.
urlopen installs the native TLS 1.3 backend itself, as CPython always has
ssl. Usage: <url> [timeout]
"""
import sys
import urllib.request
import urllib.error

url = sys.argv[1]
try:
    if len(sys.argv) > 2:
        r = urllib.request.urlopen(url, timeout=float(sys.argv[2]))
    else:
        r = urllib.request.urlopen(url)
    body = r.read()
    print("status", r.status, len(body) > 0)
    print("HTTPS OK")
except urllib.error.URLError as e:
    print("URLError", e.reason)

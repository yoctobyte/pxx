# `@dataclass(frozen=True)` was refused here until ae615953df (10-09), which
# accepted it with a warning for the TSP port: a program that runs on CPython
# never assigns to a frozen instance. The row now checks that the warning is
# given, since the class is not actually frozen.
from dataclasses import dataclass


@dataclass(frozen=True)
class D:
    v: int


d = D(1)
d.v = 2          # CPython: FrozenInstanceError
print(d)

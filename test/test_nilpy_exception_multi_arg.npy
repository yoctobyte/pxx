# bug-nilpy-multi-arg-exception-constructor-segfaults
#
# `raise MyErr("boom", 42)` on `class MyErr(Exception): pass` SEGFAULTED. So did
# a bare `e = MyErr("a", 1)` that was never raised — so a program could die
# building a value it never threw.
#
# Ordinary Python: Exception takes *args and str(e) renders the TUPLE. The RTL's
# Create(msg) takes exactly one, and the surplus arguments were emitted anyway.
# The UNDER-call (`MyErr()` with a required msg) was already handled; the
# over-call was not, which is the same asymmetry twice over.
#
# One argument is deliberately untouched: str(MyErr("boom")) is `boom`, not
# `('boom',)`, so the fold only fires above one — both are asserted, since a
# fold that also caught the single case would look right in the two-arg test.
#
# Zero, one, two and three arguments; a subclass two deep; a built-in exception;
# non-string arguments (int, float, list) and a VARIABLE argument, because the
# first version of the fix used pyrepr_of — which is overloaded, and FindProc
# resolves by name without consulting overloads, so the integer 42 was passed to
# a routine expecting a string handle and it crashed in a NEW place. Anything
# but a string literal is the case that catches that.
#
# Expectations are CPython's own output.

class MyErr(Exception):
    pass
class SubErr(MyErr):
    pass

def show(label, fn):
    try:
        fn()
        print(label, "no raise")
    except MyErr as e:
        print(label, "caught", str(e))

def r2():
    raise MyErr("boom", 42)
def r3():
    raise MyErr("a", 1, 2.5)
def r1():
    raise MyErr("solo")
def r0():
    raise MyErr()
def rs():
    raise SubErr("sub", 7)

show("two  ", r2)
show("three", r3)
show("one  ", r1)
show("zero ", r0)
show("sub  ", rs)

print("built  ", str(MyErr("a", 1)))
print("nested ", str(MyErr("x", [1, 2])))
print("strs   ", str(MyErr("x", "y")))
print("builtin", str(ValueError("v", 9)))
v = 5
print("var    ", str(MyErr("dyn", v)))


# ---- ...and `args` is the real TUPLE, not the rendered text ----------------
#
# bug-nilpy-multi-arg-exception-args-is-a-1-tuple-of-rendered-text
#
# The fold above renders the arguments into the one message CPython prints,
# which made str(e) right and `args` wrong: it came back as
# ("('no such user', 404)",) -- ONE element, the rendered text -- where CPython
# gives ('no such user', 404). So `code = e.args[1]`, the exact idiom args
# exists for, read the wrong thing, and len(e.args) was 1 for every
# multi-argument exception in the language.
#
# Fixed by inverting the order: the arguments go into a TUPLE once, and the
# message is derived FROM that tuple at run time. That is also what keeps each
# argument evaluated EXACTLY ONCE -- building both from the argument nodes would
# have run any side effect twice, which is the obstacle recorded when args
# first shipped and the reason this waited.

calls = []


def side(v):
    calls.append(v)
    return v


try:
    raise MyErr("no such user", 404)
except MyErr as e:
    print("args   ", e.args, len(e.args))
    print("index  ", e.args[0], e.args[1])
    print("istuple", isinstance(e.args, tuple))

try:
    raise MyErr("a", 1, 2.5)
except MyErr as e:
    print("args3  ", e.args, len(e.args))

# each argument evaluated exactly once -- `calls` is the witness
try:
    raise MyErr(side("x"), side(7))
except MyErr as e:
    print("sides  ", e.args, calls)

# the arities the fold does NOT touch keep their own args shapes
try:
    raise MyErr("solo")
except MyErr as e:
    print("args1  ", e.args, len(e.args))
try:
    raise MyErr()
except MyErr as e:
    print("args0  ", e.args, len(e.args))
try:
    raise ValueError("v", 2)
except ValueError as e:
    print("argsbi ", e.args, len(e.args))
try:
    {}["nope"]
except KeyError as e:
    print("argskey", e.args, len(e.args), str(e))

def hi(n):
    print("hi", n)

def two(a, b):
    return a * b

def zero():
    print("zero")

g = hi
g(5)
funcs = [hi]
funcs[0](7)
d = {"a": hi}
d["a"](8)
f2 = d["a"]
f2(9)
t = two
print(t(3, 4))
z = zero
z()

def use(cb):
    return cb("x")

def cat(ch):
    return "hi " + ch

print(use(cat))
q = cat
print(use(q))
print(q("y"))
lam = lambda x: x * 2
print(lam(5))
add2 = lambda a, b: a + b
print(add2(2, 3))
plain = lambda: 42
print(plain())
lams = [lambda x: x + 1]
print(lams[0](4))
dl = {"k": lambda x: x * 3}
print(dl["k"](5))

class D:
    def __init__(self):
        self.n = 7
    def voidm(self, ch):
        print("void", ch)
    def intm(self, a, b):
        return a + b + self.n
    def strm(self, s):
        return "s:" + s

dd = D()
bv = dd.voidm
bv("x")
bi = dd.intm
print(bi(1, 2))
bs = dd.strm
print(bs("q"))

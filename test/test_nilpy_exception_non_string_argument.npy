# raise SomeError(x) where x is not a string. Every builtin exception's ctor
# took an AnsiString, so an integer arrived as a string handle and the raise
# SEGFAULTED with no diagnostic.
# bug-nilpy-raise-keyerror-with-a-non-string-argument-segfaults
#
# `e.args` is NOT asserted here: it was removed again the same day, because
# pylib's Exception cannot carry a member sysutils' Exception lacks —
# decide-pylib-exception-vs-sysutils-exception. str() and repr() below are the
# part that survives, and they are CPython-exact.
try:
    raise KeyError(42)
except KeyError as e:
    print("int:", str(e), repr(e))
try:
    raise KeyError("k")
except KeyError as e:
    print("str:", str(e), repr(e))
try:
    raise KeyError((1, 2))
except KeyError as e:
    print("tup:", str(e))
try:
    raise KeyError()
except KeyError as e:
    print("empty:", repr(str(e)))
try:
    raise ValueError(42)
except ValueError as e:
    # repr() is NOT asserted for a non-KeyError with a non-string argument:
    # pxx says ValueError('42') where CPython says ValueError(42), because the
    # argument reaches the string ctor and its type is gone. That is the
    # residual filed as
    # bug-nilpy-non-keyerror-exception-args-loses-the-argument-type.
    print("ve:", str(e))
try:
    raise ValueError(3.5)
except ValueError as e:
    print("vf:", str(e))
try:
    raise IndexError(True)
except IndexError as e:
    print("ib:", str(e))


class MyErr(Exception):
    pass


try:
    raise MyErr(7)
except MyErr as e:
    print("user:", str(e))
# controls: the shapes that already worked
try:
    raise MyErr("a", 42)
except MyErr as e:
    print("multi:", str(e))
d = {"a": 1}
try:
    d[7]
except KeyError as e:
    print("miss:", str(e), repr(e))

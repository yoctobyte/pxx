# bug-nilpy-exception-args-attribute-missing
#
# `e.args` raised AttributeError. It is how code inspects an exception's payload
# without parsing its message, and it is the natural partner of the multi-arg
# constructor.
#
# A pxx Exception carries ONE Message string, so args is DERIVED rather than
# stored: `()` for an empty message and `(msg,)` otherwise, which is CPython's
# own relationship between args and str(e) for the one-argument case — every
# builtin raise and almost all user code. A PROPERTY, so no frontend change was
# needed at all: the NilPy member path already resolves Pascal properties.
#
# The exception to that is KeyError, and it is why `argsv` exists as a stored
# override: PyKeyError stores its message ALREADY REPR'D (CPython's KeyError is
# the one builtin whose str() is the repr of its argument), so deriving args
# from the message would hand back the QUOTED form for a real missing key. The
# raise site now stashes the raw key instead.
#
# That in turn settled `repr(KeyError(...))`, which had been excluded from the
# exception repr entirely: quoting the stored message gives KeyError("'nope'")
# and not quoting it gives KeyError(k) for a user-constructed one — both wrong,
# in opposite cases, depending on WHO raised. Repr the ARGUMENT and the two
# cases agree, which is what the user/miss pair below pins.
#
# NOT fixed, and not asserted:
#  - a MULTI-argument raise. Its arguments are folded to a rendered string at
#    the construction site, so args comes back as a 1-tuple of that text. It
#    needs the fold to stash the real tuple, which is frontend work.
#
# Expectations are CPython's own output.

try:
    raise ValueError("boom")
except ValueError as e:
    print("single   ", e.args, len(e.args), e.args[0])

try:
    raise RuntimeError()
except RuntimeError as e:
    print("no arg   ", e.args, len(e.args))


class MyErr(Exception):
    pass


try:
    raise MyErr("mine")
except MyErr as e:
    print("custom   ", e.args, str(e))

try:
    raise KeyError("inner")
except KeyError as e:
    print("keyerror ", e.args, repr(e), str(e))

try:
    {}["nope"]
except KeyError as e:
    print("real miss", e.args, repr(e), str(e))

# the payload use this exists for: reading an argument rather than the message
try:
    raise ValueError("code")
except ValueError as e:
    if e.args[0] == "code":
        print("branched ", "ok")

# other exceptions' repr must not have moved
try:
    raise ValueError("v")
except ValueError as e:
    print("repr     ", repr(e), str(e))

# an INT key: CPython's KeyError reprs its argument, and repr(7) is 7 — the
# quoting is the repr's, not a rule about keys, which is what a raise site that
# has ALREADY rendered its key must not have applied to it twice
nums = {1: "a"}
try:
    nums[7]
except KeyError as e:
    print("int key  ", str(e), repr(e), e.args)

# THE BARE ROOT. Its absence from this file is exactly why
# bug-nilpy-exception-repr-and-type-name-say-pyexception shipped: every row
# above uses a NAMED subclass, and each of those declares its own Python
# spelling, so they all stayed correct while `Exception` itself reported the
# internal name `PyException`. `type(e).__name__` is not cosmetic -- ordinary
# Python branches on it, and NilPy's rule is that code working on CPython must
# work here.
e = Exception("x")
print("bare root", repr(e), str(e), type(e).__name__, e.args)

try:
    raise Exception("raised")
except Exception as e:
    print("bare cat ", type(e).__name__, repr(e), e.args)

# a subclass's __name__ must still be the SUBCLASS, not the root it inherits
print("sub name ", type(MyErr("m")).__name__, type(ValueError("v")).__name__)

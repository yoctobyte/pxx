# bug-n-math-trunc-and-log-need-frontend-intercepts, the math.log row.
#
# `math.log(x)` died as `undefined variable (log)` while log10 and log2 worked:
# the RTL spells the natural log `Ln`, so `import math` had nothing to resolve
# `log` to. A pure NAME difference — both are Double->Double and agree — so the
# stdlib call table maps it, the same way math.floor/ceil/trunc are mapped for
# a CONTRACT difference.
#
# math.log(x, base) is deliberately still refused: CPython computes it as an
# unsnapped log(x)/log(base) and the RTL's LogN snaps to an exact integer for
# powers of the base, so mapping it there would answer 3.0 where CPython says
# 2.9999999999999996 — a silently wrong value in the last place, which is worse
# than a refusal. The refusal names math.log rather than the internal Ln, and
# the exact quotient a user writes instead is the last row here.
#
# Expectations are CPython's own output.

import math

print("e        ", math.log(2.718281828459045))
print("1        ", math.log(1))
print("10       ", math.log(10))
print("log10    ", math.log10(1000))
print("log2     ", math.log2(8))
print("floor/ceil", math.floor(-2.5), math.ceil(-2.5))
print("trunc    ", math.trunc(-2.5), math.trunc(2.5))
print("copysign ", math.copysign(3, -1))
print("base by hand", math.log(1000) / math.log(10))

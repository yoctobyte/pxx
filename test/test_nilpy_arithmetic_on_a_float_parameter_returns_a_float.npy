# `def a(x: float): return x * 2` -- the return type was inferred by joining
# the annotated float parameter with the int literal, answered int, and the
# double's raw bits printed (4617315517961601024 for a(2.5)). Python makes
# arithmetic on a float a float. A name inside a call (`int(x) * 2`) or a
# comparison (`x > 1`) is not such an operand.
def a(x: float):
    return x * 2
def e(x: float):
    return x + 1
def k(x: float, n: int):
    return (x - n) * 3
def m(v: float):
    return -v // 2
def p(x: float):
    return x ** 2
def f(x: float):
    return int(x) * 2
def g(n: int, x: float):
    return n * 2
def h(x: float):
    return x > 1
print(a(2.5), e(2.5), k(2.5, 1), m(5.0), p(3.0))
print(f(2.5), g(3, 1.0), h(2.0))
r = a(2.5)
print(r + 1)
# A conditional whose arms are that float and a PROMOTABLE int (`6 * f(w)`) is a
# variant, not a refusal: each arm survives as itself (TSP app.py).
def hs(w: int) -> int:
    return 2 if w > 10 else 1
def pick(w: int, x: float, flag: bool):
    m = 6 * hs(w)
    below = a(x) + 3 * x if flag else m
    print(below, max(below, 3))
pick(20, 2.5, True)
pick(20, 2.5, False)

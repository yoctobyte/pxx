import sys

# `del x` releases the object the way `x = None` does, and a module-level
# print() argument temp is released when its statement ends instead of
# being held (one per print line) until exit. With `keep` every object and
# every printed string is retained instead: the positive control.
keep = len(sys.argv) > 1
held = []

class Node:
    def __init__(self, v):
        self.v = v

def work(n):
    t = 0
    for i in range(n):
        x = Node(i)
        t += x.v
        if keep:
            held.append(x)
        del x
    return t


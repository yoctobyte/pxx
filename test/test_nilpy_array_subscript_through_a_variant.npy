# `array.array` indexed where the compiler does NOT know the receiver's class.
#
# The default property on lib/rtl/mimic_array's array_ is resolved by the
# FRONTEND against a known class, so `a[0]` on a typed local always worked and
# every other spelling raised `TypeError: object is not subscriptable`:
# an attribute, an element, an unannotated parameter.  Those go through
# pyvar_getitem / pyvar_setitem, which have only the handle and look for
# `__getitem__` / `__setitem__` in the class RTTI.
#
# THE TYPED-LOCAL ROW IS HERE AS THE CONTROL AND IT MUST NOT BE THE ONLY ONE:
# it was green throughout, so a fixture written the ordinary way -- one array,
# one local, one subscript -- certifies the bug.  The interesting receivers are
# the ones with no static class.
#
# Found in lekkerzeilen: world.py's Grid.at reads `self.values[row]` four times
# per bilinear height sample, and the tile loader caught every one of them and
# reported `tile (86, 220): object is not subscriptable`, one line per tile,
# with the world silently never arriving.
#
# The negative rows are CPython's index rule at the Python surface. ByteAt is
# the storage primitive and still refuses a negative index it is handed
# literally; at()/put() apply the rule before calling it.
import array


class G:
    def __init__(self, data):
        self.values = array.array("h")
        self.values.frombytes(data)

    def read(self, i):
        return self.values[i]

    def write(self, i, v):
        self.values[i] = v


d = b"\x01\x00\x02\x00\x03\x00\x04\x00"

a = array.array("h")
a.frombytes(d)
print("typed local", a[0], a[3])
print("typed local neg", a[-1], a[-4])

g = G(d)
print("attribute", g.values[1])
print("through a method", g.read(2))


def first(v):
    return v[0]


def nth(v, i):
    return v[i]


print("unannotated param", first(a), nth(a, 2), nth(a, -2))

pack = [array.array("h"), a]
print("element of a list", pack[1][3])

g.write(0, 9)
print("attribute write", g.values[0])
a[-1] = 7
print("negative write", a[3])

print("ok")

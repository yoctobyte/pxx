# A pylib function that builds a TPyList as a LOCAL TEMPORARY must release it.
#
# pxx objects ARE refcounted (PXXObjRetain/Release, finalizer on zero), but a
# PASCAL local does not participate -- the frontend emits retain/release for
# NilPy locals, and pylib.pas is Pascal. So a list built in a pylib function and
# dropped there is never released by anything, and the call leaks on every
# invocation, forever.
#
# MEASURED 2026-09-14, before the fix: "{}".format(i) leaked 199-200 bytes per
# call and set(L) 583, both LINEAR across two passes, both 0 under CPython.
# The dict rows are the same defect in pylib/pyeval and were measured the same
# evening: dict(D) 1168 bytes per call, repr(D) 584, sorted(D) 584, CPython 0
# for all three. They snapshot keys/values into a fresh TPyList and drop it.
#
# THE THRESHOLD IS A RELATION, NOT A RATE. Asserting "0 bytes" would make this
# fixture flap on any unrelated page the process happens to fault in; asserting
# "under 200 bytes per call" would pass on the unfixed compiler, which leaked
# exactly 199. 50 is comfortably below the smallest defect (199) and far above
# ordinary noise at 40000 iterations.
#
# `retain` IS THE POSITIVE CONTROL AND THE FIXTURE IS WORTHLESS WITHOUT IT:
# every other row here asserts a number stays near ZERO, so a broken instrument
# -- statm unreadable, the parse returning 0, the loop not running -- passes all
# of them. retain deliberately keeps its allocations and MUST show growth.

from collections import Counter


def rss_kb():
    f = open("/proc/self/statm")
    s = f.read()
    f.close()
    return int(s.split()[1]) * 4

# Counter.most_common builds a (key, count) pair per emitted row and appends
# it to the result list. res.append(pair) reaches PyVarSlotSet, which retains an
# object payload, so the result list takes its own reference and the
# CONSTRUCTOR's rc=1 was never dropped -- one leaked TPyList per pair.
# Measured 2026-09-22 before the fix: most_common(4) 800 bytes/call and
# most_common() over 16 entries 3200, against 0/0 under CPython. PER PAIR and
# linear in the pair count, which is what distinguishes it from a per-call
# cost. BOTH ARITIES are asserted deliberately: a fix that dropped the pair
# only on the truncating path would leave the full form leaking, and the n=4
# row alone cannot tell the two apart.
C16 = Counter()
for i in range(16):
    C16["c%d" % i] = i

# pylist_setslice builds `keep` -- prefix + src + suffix -- copies it back into
# the list element by element and drops it. Measured 2026-09-22 before the fix:
# 584 bytes/call on a 32-element list, 1096 when the assignment grew it past 32.
# The number tracks keep's CAPACITY rather than its length (32 slots x 16 bytes
# plus header, then 64), which is what identifies one leaked list object per
# call rather than a per-element cost. CPython 0.
#
# THE RECEIVER IS PERSISTENT AND THE REPLACEMENT IS SAME-LENGTH ON PURPOSE.
# Building the list inside the loop would fold in `x = list(range(32))`, which
# leaks 384 bytes/call on its own for an unrelated reason (reported separately)
# -- the row would then be measuring two defects and could not be read. Holding
# SS outside and replacing 4 elements with 4 keeps its length at 32 forever, so
# the only thing that can move is setslice's own temporary.
SS = ["s%d" % i for i in range(32)]
SS4 = ["a", "b", "c", "d"]

L = list(range(32))
A32 = list(range(32))
D16 = {}
for i in range(16):
    D16["m%d" % i] = i
D = {}
for i in range(32):
    D["k%d" % i] = i
N = 12000
LEAK_LIMIT = 50          # bytes per call
held = []

def f_format_one(n):
    for i in range(n):
        s = "{}".format(i)

def f_format_three(n):
    for i in range(n):
        s = "{} {} {}".format(i, i + 1, "z")

def f_set(n):
    for i in range(n):
        s = set(L)

def f_dictcopy(n):
    for i in range(n):
        s = dict(D)

def f_dictrepr(n):
    for i in range(n):
        s = repr(D)

def f_dictsorted(n):
    for i in range(n):
        s = sorted(D)

def f_items(n):
    for i in range(n):
        s = list(D.items())

def f_dcopy(n):
    for i in range(n):
        s = D.copy()

def f_popitem(n):
    for i in range(n):
        d2 = dict(D)
        s = d2.popitem()

# zip/enumerate materialise through the LAZY CURSOR, not through pyzip/
# pyenumerate -- patching the eager builders moved these by ONE BYTE. Fixing the
# cursor's pair took them 7000 -> 800 and 6800 -> 599, and removing the surplus
# retain on the cursor's own FBox took both to 0. The 800/599 was per-CALL
# machinery (3 prefetch boxes), not per-pair: it was FLAT at ~4 leaked objects
# per call across 4, 8 and 32 elements, which is what told the two apart.
def f_zip(n):
    for i in range(n):
        s = list(zip(L, A32))

def f_enum(n):
    for i in range(n):
        s = list(enumerate(L))

def f_mostcommon(n):
    for i in range(n):
        s = C16.most_common(4)


def f_mostcommon_all(n):
    for i in range(n):
        s = C16.most_common()


def f_setslice(n):
    for i in range(n):
        SS[4:8] = SS4


# THE pyiter_drain(pyiter_of_*(...)) FAMILY: seven sites built a cursor inline,
# drained it and dropped it. pyiter_drain cannot take ownership of its argument
# -- list(it: TPyIter) hands it a cursor the CALLER owns -- so each site has to
# release its own. The four AGGREGATES leaked twice, the cursor and the drained
# list, because sum/tuple/any/all only READ that list.
#
# Measured 2026-09-22 over range(32), bytes per call, CPython 0 for all:
#     list(range)                384   cursor only; the list is the result
#     sum/tuple/any/all(range)   968 = 384 cursor + 584 drained list
# The 384 is FLAT across range(8) through range(128) and the 584 is a 32-slot
# list (32 x 16 plus header) -- that is how the two were told apart, and it is
# why all five arities are here rather than one representative. One site was
# found first; the other six came from grepping for the shape.
#
# NOT COVERED HERE, DELIBERATELY: list(<user iterable>) still leaks ~63
# bytes/call after this fix, in pyiter_of_userobj rather than at these sites --
# the `itv` Variant holding __iter__'s result is retained and never dropped.
# It is a different routine and a separate row in the ticket; a fixture row for
# it would be red on arrival.
def f_listrange(n):
    for i in range(n):
        x = list(range(32))


def f_sumrange(n):
    for i in range(n):
        x = sum(range(32))


def f_tuplerange(n):
    for i in range(n):
        x = tuple(range(32))


def f_anyrange(n):
    for i in range(n):
        x = any(range(32))


def f_allrange(n):
    for i in range(n):
        x = all(range(32))


def f_retain(n):
    for i in range(n):
        held.append([0] * 16)

ok = True
base = rss_kb()

# Each shape runs TWICE. A first pass can move for one-off reasons (an arena
# page, a cache); a SECOND pass on the same shape cannot, and it is the second
# that is asserted.
for name, fn in [("format1", f_format_one), ("format1", f_format_one),
                 ("format3", f_format_three), ("format3", f_format_three),
                 ("set", f_set), ("set", f_set),
                 ("dictcopy", f_dictcopy), ("dictcopy", f_dictcopy),
                 ("dictrepr", f_dictrepr), ("dictrepr", f_dictrepr),
                 ("dictsorted", f_dictsorted), ("dictsorted", f_dictsorted),
                 ("items", f_items), ("items", f_items),
                 ("dcopy", f_dcopy), ("dcopy", f_dcopy),
                 ("popitem", f_popitem), ("popitem", f_popitem),
                 ("zip", f_zip), ("zip", f_zip),
                 ("enum", f_enum), ("enum", f_enum),
                 ("mostcommon", f_mostcommon), ("mostcommon", f_mostcommon),
                 ("mostcommonall", f_mostcommon_all), ("mostcommonall", f_mostcommon_all),
                 ("setslice", f_setslice), ("setslice", f_setslice),
                 ("listrange", f_listrange), ("listrange", f_listrange),
                 ("sumrange", f_sumrange), ("sumrange", f_sumrange),
                 ("tuplerange", f_tuplerange), ("tuplerange", f_tuplerange),
                 ("anyrange", f_anyrange), ("anyrange", f_anyrange),
                 ("allrange", f_allrange), ("allrange", f_allrange)]:
    fn(N)
    now = rss_kb()
    per = ((now - base) * 1024) // N
    base = now

second = {}
base = rss_kb()
for name, fn in [("format1", f_format_one), ("format3", f_format_three), ("set", f_set),
                 ("dictcopy", f_dictcopy), ("dictrepr", f_dictrepr),
                 ("dictsorted", f_dictsorted), ("items", f_items),
                 ("dcopy", f_dcopy), ("popitem", f_popitem),
                 ("zip", f_zip), ("enum", f_enum),
                 ("mostcommon", f_mostcommon), ("mostcommonall", f_mostcommon_all),
                 ("setslice", f_setslice), ("listrange", f_listrange),
                 ("sumrange", f_sumrange), ("tuplerange", f_tuplerange),
                 ("anyrange", f_anyrange), ("allrange", f_allrange)]:
    fn(N)
    now = rss_kb()
    second[name] = ((now - base) * 1024) // N
    base = now

for name in ["format1", "format3", "set", "dictcopy", "dictrepr", "dictsorted",
             "items", "dcopy", "popitem", "zip", "enum",
             "mostcommon", "mostcommonall", "setslice",
             "listrange", "sumrange", "tuplerange", "anyrange", "allrange"]:
    if second[name] < LEAK_LIMIT:
        print("%s LEAKFREE" % name)
    else:
        print("%s LEAKS %d bytes/call" % (name, second[name]))
        ok = False

f_retain(N)
now = rss_kb()
ctrl = ((now - base) * 1024) // N
if ctrl > 100:
    print("control MOVES")
else:
    print("control DEAD %d -- every LEAKFREE above is meaningless" % ctrl)
    ok = False

if ok:
    print("PYLEAK OK")
else:
    print("PYLEAK FAIL")

# `[x + y for x in range(2) for y in [10]]` was "undefined variable (y)": a
# second `for` clause worked only when the FIRST iterable was a container, and a
# range() there took a counted path with no arm for the rest of the header.
# bug-nilpy-a-second-for-clause-fails-when-the-first-iterable-is-a-range
# Every expectation is CPython's own output.

print([x + y for x in range(2) for y in [10]])
print([x + y for x in range(2) for y in range(3)])
print([(x, y) for x in range(2) for y in range(2)])
print([[x, y] for x in range(2) for y in range(2)])
print([x for x in range(2) for y in range(2)])
print([x + y for x in [10] for y in range(2)])
print([x * 10 + y for x in [1, 2] for y in [3, 4]])
rng = [0, 1]
print([x + y for x in rng for y in rng])
print([c for r in [[1, 2], [3]] for c in r])
print([x + y for x in range(3) for y in range(x)])
print([x + y for x in range(4) for y in range(3) if y > 1])
print([x + y + z for x in range(2) for y in range(2) for z in range(2)])
print({x + y for x in range(2) for y in range(2)})
print({(x, y): x + y for x in range(2) for y in range(2)})
print(sum([x * y for x in range(3) for y in range(3)]))

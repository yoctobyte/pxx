# bug-nilpy-to-bytes-on-a-variant-receiver-does-not-compile — the guard half.
#
# The `.to_bytes(` intrinsic now claims a VARIANT receiver (see
# test_nilpy_to_bytes.npy). It must NOT do so when a user class declares a
# method of that name, or the intrinsic would silently shadow real code.
#
# This behaviour is unchanged from before the fix — verified against the pinned
# binary, which produces this same output — and the test exists so the guard
# cannot be dropped later by someone widening the intrinsic.
#
# Consequence worth knowing: because the guard is whole-PROGRAM, a file that
# declares its own `to_bytes` keeps the old behaviour for variant INT receivers
# too (a runtime AttributeError). Also unchanged from before, and the reason
# the int cases live in the other file rather than here.


class Packet:
    def __init__(self, tag):
        self.tag = tag

    def to_bytes(self, n, order, signed=False):
        return "packet:" + str(self.tag)


class Frame:
    def __init__(self, k):
        self.k = k

    def to_bytes(self, n, order, signed=False):
        return "frame:" + str(self.k)


def use(p):
    return p.to_bytes(8, "little", signed=True)


# statically typed receiver
print(Packet(7).to_bytes(8, "little", signed=True))

# through an untyped parameter — a variant receiver, the case the intrinsic
# would have claimed without the guard
print(use(Packet(1)))
print(use(Frame(2)))


# bug-n-int-bit-length-is-not-implemented — the same guard, for the methods
# that joined the intercept. PyIsIntMethodBaseTk asks PyAnyClassDeclares with
# the ACTUAL method name rather than a hardcoded 'to_bytes', so a user class
# declaring `bit_length` must keep it for a variant receiver exactly as Packet
# keeps `to_bytes` above. Hardcoding the name here is the mistake that would
# let the intrinsic shadow real code.


class Register:
    def __init__(self, w):
        self.w = w

    def bit_length(self):
        return "reg:" + str(self.w)

    def bit_count(self):
        return "regcount:" + str(self.w)


def widen(r):
    return r.bit_length()


print(Register(16).bit_length())
print(widen(Register(32)))
print(Register(8).bit_count())

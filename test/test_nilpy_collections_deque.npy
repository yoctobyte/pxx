# collections.deque -- pylib's TPyDeque, reached three ways.
#
# THE QUALIFIED SPELLING IS THE LOAD-BEARING ONE. `collections.deque()` is what
# every real program writes (all of the lekkerzeilen corpus uses `module.name`,
# none of it uses `from module import name`), and it is the spelling that was
# broken: `collections` HAS a backing Pascal unit, so the qualifier resolved
# against lib/rtl/collections.pas -- a generic TList that has never heard of
# `deque` -- and answered "no member deque came of the qualifier collections".
#
# The .expected was generated by CPython 3, not by us.
import collections

q = collections.deque()
print(len(q))
if not q:
    # truthiness on a non-container class goes through __len__ and nothing else
    print("empty falsy")
for i in range(5):
    q.append(i)
print(len(q), q[0], q[-1])
out = []
while q:
    out.append(q.popleft())
print(out)

d = collections.deque([1, 2, 3])
d.appendleft(0)
d.append(4)
print(len(d), d[0], d[4], d.pop(), d.popleft(), len(d))

# popleft is O(1) AMORTISED, not O(n): every element enters and leaves exactly
# once, which is what the measured caller (a breadth-first flood fill) does. A
# list.pop(0) implementation makes this quadratic -- correct, and slow enough to
# matter on a raster.
big = collections.deque()
for i in range(20000):
    big.append(i)
tot = 0
while big:
    tot += big.popleft()
print(tot)

# The bare and from-import spellings reach pylib's `deque` overloads directly,
# because those are plain pylib procs; they worked all along and are here so a
# change that fixes the qualified form by BREAKING them cannot pass.
q2 = collections.deque()
q2.appendleft(7)
q2.appendleft(8)
print(q2.popleft(), q2.popleft())

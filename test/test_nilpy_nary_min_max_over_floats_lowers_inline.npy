# min/max with any number of all-float or all-int arguments lower inline,
# folded left with CPython's rule (the first extreme wins, NaN included); a
# mixed int/float call keeps the dynamic path, which returns the object as is.
import math
nan = float("nan")
calls = []
def t(x: float) -> float:
    calls.append(x)
    return x
def m(a: float, b: float, c: float) -> float:
    return max(a, min(1.0, b / max(c, 1e-6)), math.cos(0.5))
print(m(0.2, 0.5, 2.0), m(0.95, 0.5, 2.0))
print(max(t(1.0), t(3.0), t(2.0)), min(t(4.0), t(-1.0), t(-1.0), t(0.0)), calls)
print(max(nan, 1.0, 2.0), max(1.0, nan, 2.0), min(2.0, 1.0, nan), max(-0.0, 0.0, -0.0))
i = 3
j = 7
print(max(i, j, 5), min(i, j, 5, -2), max(i * 10 ** 20, j, 1), min(len([1, 2]) - 2, 4, 9))
print(max(1, 2.5, 2), min(3, 1.0, 1), max(0.5, 1, 0.75))
xs = [3.0, 1.0]
print(max(xs), min(2.0, 3.0))

program lib_strtofloat_lemire;
{ Guards the Eisel-Lemire fast path in lib/rtl/sysutils.pas against CPython.

  WHY THIS EXISTS SEPARATELY FROM lib_strtofloat_roundtrip. That test proves
  FloatToStrExact(x,17) -> StrToFloat returns x, which is a strong check but
  only ever feeds the parser strings that are already the 17-digit spelling of
  a real double. Those are not the strings that break a float parser. The ones
  that do are arbitrary decimals whose value lands near a rounding boundary,
  and for those the only honest oracle is a second correctly-rounded
  implementation — CPython's float().

  It matters here specifically because the parser now carries a GENERATED
  696-entry table of 128-bit powers of ten. A single wrong digit in that table
  is invisible to every self-consistent check: the parser would simply return a
  plausible neighbouring double. This test is what makes such an entry fail.
  Verified to be capable of failing, which is the property a guard needs:
  flipping one bit in every table high word produces 191 mismatches here.

  Emits `<decimal-string> <parsed-bits-hex>` and lets the harness diff it. No
  expectation is stored in-tree — the expectation IS python3's answer, so this
  cannot drift into agreeing with a bug of our own.

  Track B (library). Gate: make lib-test. }
uses sysutils;

var seed: Int64;

function Rnd(n: Integer): Integer;
begin
  seed := (seed * 6364136223846793005 + 1442695040888963407);
  Rnd := Integer(((seed shr 33) and $7FFFFFFF) mod n);
end;

procedure Emit(const s: AnsiString);
var d: Double; b: Int64;
begin
  d := StrToFloatDef(s, 0.0);
  b := PInt64(@d)^;
  writeln(s, ' ', IntToHex(b, 16));
end;

{ nd random digits, first one nonzero }
function Digits(nd: Integer): AnsiString;
var k: Integer; s: AnsiString;
begin
  s := '';
  for k := 1 to nd do
    if k = 1 then s := s + Chr(Ord('1') + Rnd(9))
    else s := s + Chr(Ord('0') + Rnd(10));
  Digits := s;
end;

var i, q: Integer;
begin
  seed := 88172645463325252;

  { 1..19 digits over the whole decimal exponent range — the window where
    Eisel-Lemire is asked to decide, and where it ACCEPTS most of the time. }
  for i := 1 to 60000 do
  begin
    q := Rnd(700) - 350;
    Emit(Digits(1 + Rnd(19)) + 'e' + IntToStr(q));
  end;

  { The normal/subnormal boundary, where Lemire must DECLINE and hand over to
    the exact search rather than guess with too few bits.

    These counts were 1500 and deliberately small: each of these values ran the
    exact ~765-digit DECIMAL expansion and cost ~500 us, so a large count bought
    little and cost the gate seconds. ExBinNearest compares in binary big
    integers instead and took them to ~10 us
    (bug-b-strtofloat-is-3600x-slower-than-cpython-for-small-exponents), so the
    coverage that was priced out is now affordable and is taken. }
  for i := 1 to 20000 do
  begin
    q := -(300 + Rnd(45));
    Emit(Digits(1 + Rnd(19)) + 'e' + IntToStr(q));
  end;

  { More digits than a u64 significand holds: Lemire must not be reached at
    all. Same cost argument as the block above, and the same relief. }
  for i := 1 to 20000 do
  begin
    q := Rnd(700) - 350;
    Emit(Digits(20 + Rnd(26)) + 'e' + IntToStr(q));
  end;

  { Significands far past any midpoint's length, which drive the digit cap and
    its sticky bit, and — past the size ExBinNearest will accept — the decline
    to ExDecNearest, which has no limit. Both layers must land on the same
    double as CPython, since the whole design is that each declines rather than
    guesses. }
  for i := 1 to 2000 do
  begin
    q := Rnd(900) - 500;
    Emit(Digits(100 + Rnd(500)) + 'e' + IntToStr(q));
  end;

  { EXACT MIDPOINTS — the round-to-even decision, which nothing else here
    reaches. Random decimals essentially never land exactly halfway between two
    doubles, and this was measured, not assumed: inverting the tie rule
    (`(mant mod 2) = 0` to `= 1`) leaves every other block in this file passing.
    Against these twelve it produces 9065 mismatches in a 9078-value sweep.

    Each string is the EXACT midpoint between the named double and the next one
    up, so the correct answer is the neighbour with the even mantissa — which is
    stated per line and alternates, so a rule that always rounded one way fails
    half of them. Generated once from CPython's Fraction; the checker derives
    the expected bits independently, so a wrong constant here fails loudly
    rather than quietly agreeing with itself. The subnormal ones run to ~1077
    digits because 2^-1075 does, and there is no shorter spelling of a tie down
    there. }
  { smallest subnormal, mantissa 1 (bits 1); mantissa is odd, so round-to-even goes UP }

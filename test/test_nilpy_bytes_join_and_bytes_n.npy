# Two refusals of things CPython accepts, in the same family: a bytes surface
# that was narrower than str's for no stated reason.
#
# 1. b"".join(reversed(rows)) -- str.join has always taken an ITERATOR and
#    bytes.join took only a list, so the bytes spelling was a COMPILE error
#    ("no overload of join matches these arguments") while the str spelling
#    beside it worked and `b"".join(list(reversed(rows)))` worked too. The only
#    missing step was materialising.
# 2. bytes(n) -- n zero bytes. bytearray(n) always had that overload and
#    bytes(n) did not, so the immutable spelling was a compile error.
#
# Both are the same shape: two spellings of one concept, and the one nobody
# extended is the one that stayed broken. NilPy is UPWARD compatible with
# CPython, one direction, so refusing what CPython accepts is a defect.
#
# The .expected was generated by CPython 3, not by us.
rows = [b"ab", b"cd", b"ef"]

print(b"".join(reversed(rows)))
print(b"-".join(reversed(rows)))
print(b"".join(rows))
print(b"".join(sorted([b"b", b"a"])))
print(b",".join(tuple(rows)))

# the str twin of each, which worked all along -- here so a change that fixes
# bytes by breaking str cannot pass
print("".join(reversed(["ab", "cd"])))
print("-".join(sorted(["b", "a"])))

print(bytes(0), len(bytes(0)))
print(bytes(4), len(bytes(4)))
print(bytes(3) == bytearray(3))
b = bytes(2)
print(b[0], b[1])

# 3. sorted() over BYTES. list/tuple/set compare lexicographically because they
#    are one class here; bytes is a different one and fell through to the
#    numeric path, so this raised "expected a number, got object" while the str
#    and int spellings beside it worked.
#
# THE HIGH-BIT ROWS ARE THE LOAD-BEARING ONES. CPython compares bytes as
# UNSIGNED values 0..255, so b"\xff" > b"\x01". Reading them as signed inverts
# every pair with the top bit set -- and still returns a sorted-looking list, so
# only a value assertion over such a pair can tell a correct fix from a
# plausible one.
print(sorted([b"cd", b"ab"]))
print(sorted([b"b", b"a", b"c"]))
print(sorted([b"\xff", b"\x01"]))
print(sorted([b"\x80", b"\x7f", b"\x00"]))
print(sorted([b"ab", b"a", b"abc"]))
print(b"\xff" > b"\x01", b"a" < b"b", b"ab" > b"a")
print(sorted(["cd", "ab"]), sorted([2, 1]))

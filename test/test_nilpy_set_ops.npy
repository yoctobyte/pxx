# set operators (&, |, -, ^) and PEP 584 dict union (|).
# Sets share the list representation; two TPyList operands make these four
# operators unambiguous (a list itself supports none of them).
# Every expectation is CPython's own output.

a = {1, 2, 3}
b = {2, 3, 4}

print(sorted(a & b))
print(sorted(a | b))
print(sorted(a - b))
print(sorted(a ^ b))

d1 = {"x": 1, "y": 2}
d2 = {"y": 20, "z": 3}
d3 = d1 | d2
print(sorted(d3.items()))

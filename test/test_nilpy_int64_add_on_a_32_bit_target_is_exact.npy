def walk():
    t = 9223372036854775000
    i = 0
    while i < 5:
        t = t + 300
        print(t)
        i = i + 1
    while i > 0:
        t = t - 9223372036854775807
        print(t)
        i = i - 1
    u = 2147483000
    j = 0
    while j < 3:
        u = u + 400
        print(u, u - 2147483648)
        j = j + 1
    while j > 0:
        u = u - 700
        print(u)
        j = j - 1

def churn(k):
    t = 3000000000
    s = -9000000000000000000
    i = 0
    while i < k:
        t = t + 2001 + i
        s = s - i + 7
        i = i + 1
    return t + s

pairs()
mixed()
walk()
print(churn(20000))

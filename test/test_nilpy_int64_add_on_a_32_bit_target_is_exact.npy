# SPDX-License-Identifier: MPL-2.0
#
# + and - across the Int64 edges, promo with promo and promo with a machine int.
# On a 32-bit target a value from 2^31 to 2^63 lives on the heap tier, and
# PXXPromoAdd/Sub/AddInt/SubInt compute it in Int64 without building a bignum
# when operands and result fit; this pins every boundary of that fast path:
# 2^31 (the inline word), 1e9 and 1e18 (limb counts), 2^63 on both sides
# (Int64 overflow falls back to the bignum tier), and results that demote.
# churn() is the ESP shape that motivated it (a counter past 2^31 in a loop),
# and is long enough that the -dPXX_ALLOC_CENSUS rows see a per-iteration leak
# of the heap payloads the fast path writes.

def pairs():
    a = 0
    b = 0
    print(a + b, a - b, b - a)
    a = 0
    b = 1
    print(a + b, a - b, b - a)
    a = 0
    b = -1
    print(a + b, a - b, b - a)
    a = 0
    b = 2147483647
    print(a + b, a - b, b - a)
    a = 0
    b = 2147483648
    print(a + b, a - b, b - a)
    a = 0
    b = -2147483648
    print(a + b, a - b, b - a)
    a = 0
    b = -2147483649

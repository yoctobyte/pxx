# `import queue` -> lib/rtl/mimic_queue.pas, the mimic_ shim fallback.
#
# Every row is a shape lekkerzeilen writes (gauges.py:401/443, app.py:569/575/
# 1345) or a control for one. The .expected is generated by CPython.
#
# DELIBERATELY ABSENT: a blocking get() on an EMPTY queue and a blocking put()
# on a FULL one. In CPython, single-threaded, both HANG FOREVER -- there is no
# other thread that could satisfy them -- so there is no CPython output to
# compare against and a row here would deadlock the oracle, not the shim. The
# shim raises with a message naming the reason; that arm becomes a real wait
# when mimic_threading lands. See the shim's header.

import queue

# ---- the unbounded queue: gauges.py:401 and app.py:569 ---------------------
q = queue.Queue()
print(q.qsize(), q.empty(), q.full(), q.maxsize)
q.put(1)
q.put("two")
q.put(3.5)
print(q.qsize(), q.empty())

# put() returns None, exactly as CPython's does
print(q.put(4))
print(q.qsize())

# ---- FIFO order, which is the entire contract -------------------------------
print(q.get(), q.get(), q.get(), q.get())
print(q.qsize(), q.empty())

# ---- Empty as control flow: the render-loop shape, verbatim -----------------
# gauges.py:443 and app.py:1345 both poll with get_nowait under this handler.
try:
    q.get_nowait()
    print("no exception")
except queue.Empty:
    print("caught Empty")

# ---- the bounded queue: app.py:575, maxsize=2 -------------------------------
# The keyword spelling is the one app.py uses, and it is the one that needed a
# single defaulted constructor rather than two overloads to bind at all.
b = queue.Queue(maxsize=2)
print(b.maxsize, b.empty(), b.full())
b.put(10)
print(b.qsize(), b.full())
b.put(20)
print(b.qsize(), b.full())

try:
    b.put_nowait(30)
    print("no exception")
except queue.Full:
    print("caught Full")

print(b.get_nowait(), b.get_nowait())
print(b.qsize(), b.empty(), b.full())

# ---- maxsize <= 0 is unbounded, which is CPython's own encoding -------------
u = queue.Queue(0)
print(u.maxsize, u.full())
u.put(1)
u.put(2)
u.put(3)
print(u.qsize(), u.full())

# ---- a blocking get() that IS satisfiable answers exactly as CPython does ---
# This is the common case and it is not a subset of anything: app.py:1294's
# loader thread reaches this line every time an order is already waiting.
s = queue.Queue()
s.put("ready")
print(s.get())
print(s.empty())

# ---- a bounded put() with room is likewise just a put -----------------------
r = queue.Queue(maxsize=2)
r.put("a")
r.put("b")
print(r.qsize(), r.full())
print(r.get(), r.get())
print(r.empty())

# ---- values survive round-tripping by type ---------------------------------
t = queue.Queue()
t.put(0)
t.put(-1)
t.put("")
t.put(2.25)
print(t.get(), t.get(), t.get(), t.get())

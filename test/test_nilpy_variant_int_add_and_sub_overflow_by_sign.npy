# PyVarNumFast tests add/sub overflow by sign inline (multiply still calls
# PyIntOpOverflows). Every pair around both Int64 limits must promote or not
# exactly as before, and mixed float/bool operands stay on their arms.
def add(a, b): return a + b
def sub(a, b): return a - b
def mul(a, b): return a * b
M = 2 ** 63 - 1
m = -2 ** 63
vals = [0, 1, -1, 2, -2, M, m, M - 1, m + 1, 2 ** 62, -2 ** 62, 12345, -98765]
out = []
for x in vals:
    for y in vals:
        out.append((add(x, y), sub(x, y), mul(x, y)))
print(len(out), sum(a + b + c for a, b, c in out) % 1000003)
print(add(M, 1), sub(m, 1), add(m, -1), sub(M, -1), add(M, m), sub(0, m), add(2.5, 1), sub(1, 0.5), add(True, 1))

# A field assigned from a MODULE-LEVEL constant — `self.state = NEW`, the most
# ordinary Python constant idiom there is. Every global type was rejected with
# "cannot infer the type of field", uniformly, so a class CPython runs unchanged
# needed an annotation to compile at all.
# bug-nilpy-a-field-assigned-from-a-module-global-has-no-inferable-type

NEW = "NEW"
LIMIT = 7
RATE = 1.5
DEFAULTS = [1, 2]
VERBOSE = True


class Order:
    def __init__(self, customer):
        self.customer = customer
        self.state = NEW
        self.limit = LIMIT
        self.rate = RATE
        self.tags = DEFAULTS
        self.verbose = VERBOSE

    def promote(self):
        self.state = "SHIPPED"


o = Order("bob")
print(o.customer, o.state, o.limit, o.rate, o.verbose)
print(o.tags[0], o.tags[1], len(o.tags))
print(o.limit + 1, o.rate * 2)
o.promote()
print(o.state)

# the global is read as a value, not copied by name: reassigning it afterwards
# does not touch the field (CPython binds the value at __init__ time)
NEW = "OLD"
p = Order("ann")
print(o.state, p.state)


# an ANNOTATED field still wins over the global's inferred type
class Ann:
    def __init__(self):
        self.n: int = LIMIT


print(Ann().n)


# a global holding a value assigned LATER in the module is still not typeable
# here, and an unannotated ctor PARAMETER remains variant — both unchanged
class Passthrough:
    def __init__(self, v):
        self.v = v


print(Passthrough(3).v, Passthrough("x").v)


# ---- ...and a global holding a class INSTANCE ------------------------------
#
# `G = K()` then `self.k = G`. This one needs the class IDENTITY as well as the
# kind, and that is what the first attempt at it missed: typed bare tyClass the
# field had no idea WHICH class it held, so `C().k.z` read at the wrong layout
# and printed 5887615 where CPython says 9 (typed tyVariant, 7). Two plausible
# numbers, neither the field -- which is why the recognition was withdrawn and
# the loud "cannot infer" diagnostic kept instead.
#
# The store was never implicated: an explicitly annotated `self.k: K = G` has
# always worked, and that is the control that isolates it.
# bug-nilpy-a-field-assigned-from-a-class-instance-global-reads-garbage


class Inst:
    def __init__(self, n):
        self.z = n

    def doubled(self):
        return self.z * 2

    def bump(self):
        self.z = self.z + 1


GA = Inst(9)
GB = Inst(100)

# the bind-to-a-local control, which worked all along
la = GA
print("ctor-local:", la.z, la.doubled())


class HoldsInstance:
    def __init__(self):
        self.a = GA
        self.b = GB

    def via(self):
        return self.a.doubled()


hi = HoldsInstance()
print("ctor-field:", hi.a.z, hi.b.z)
print("ctor-method:", hi.a.doubled(), hi.via())

# IDENTITY, not a copy: mutating through the field is visible on the global
hi.a.bump()
print("ctor-shared:", GA.z, hi.a.z, la.z)

# a global whose right-hand side is not WHOLLY a construction must not be typed
# as one -- the lesson `wrapped = "a-b".split("-")` recorded for the literals
NOTCTOR = Inst(1).doubled()
print("ctor-notctor:", NOTCTOR)

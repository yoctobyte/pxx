# `import array` -> lib/rtl/mimic_array.pas, the mimic_ shim fallback.
#
# THIS FILE IS ALSO THE POSITIVE CONTROL FOR THE RESERVED-WORD CONSTRUCTOR FIX.
# The class the shim declares is `array_`, because `array` is a Pascal reserved
# word; `array.array(...)` reaches it only because the qualified-member mapper
# (PyMapReservedMember, `tk.END` -> END_) is now applied on the CONSTRUCTOR path
# as well as the value and call paths. Before that it was not: every line below
# that constructs an array compiled fine and produced garbage -- the first one
# printed 104, which is ord('h'), and the program segfaulted shortly after. So
# a regression in that fix cannot pass this file quietly; it fails on values.
#
# The .expected was generated by CPython 3, not by us.
import array

a = array.array("h")
print(a.itemsize, a.typecode, len(a))

# A BYTES initialiser is raw bytes (== frombytes). bytes(n) is n zero bytes --
# an overload `bytearray(n)` always had and `bytes(n)` did not, so this line was
# a compile error until it was added.
b = array.array("h", bytes(6))
print(len(b), b[0], b[1], b[2])
b[0] = 1000
b[1] = -1000
b[2] = 32767
print(b[0], b[1], b[2])
print(b.tobytes())

# ...while a LIST initialiser is element VALUES. The same argument position
# meaning two different things is CPython's rule, and it is why the shim
# dispatches on the runtime type.
c = array.array("f", [1.5, -2.25, 0.0])
print(len(c), c[0], c[1], c[2], c.itemsize)

d = array.array("h")
d.frombytes(b.tobytes())
print(len(d), d[0], d[1], d[2])
d.byteswap()
print(d[0], d[1])
d.byteswap()
print(d[0], d[1], d[2])

e = array.array("B", bytes(3))
e[0] = 255
print(e[0], e.itemsize, e.typecode)

f = array.array("q", [1, -2, 4611686018427387904])
print(f[0], f[1], f[2], f.itemsize)

g = array.array("d", [0.5, -0.25])
print(g[0], g[1], g.itemsize, g.typecode)

# A QUALIFIED BASE CLASS whose name is a Pascal reserved word. The shim's class
# is `array_`, so `class Grid(array.array)` resolves only because the
# reserved-word mapping is applied in the base-class position too -- the FIFTH
# and last site that consumes a unit qualifier, and the one that never had it.
# It REFUSED rather than building garbage ("unknown base class array"), which is
# why it sat unnoticed while the constructor site did not.
class Grid(array.array):
    pass

gr = Grid("h")
print(gr.itemsize, gr.typecode, len(gr))
gr.frombytes(bytes(4))
print(len(gr), gr[0], gr[1])

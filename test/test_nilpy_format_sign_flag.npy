# The format-spec SIGN flag: '+' shows a sign on positives too, '-' is the
# default (negatives only), ' ' puts a space where '+' would go.
# It was unhandled, so f"{n:+d}" raised "unsupported format spec".
# bug-nilpy-format-spec-sign-flag-unsupported

n = 42
z = 0
fl = 3.14159
big = 1234567

# ints
print(f"{n:+d}")
print(f"{-n:+d}")
print(f"{n:-d}")
print(f"{-n:-d}")
print(f"{n: d}")
print(f"{-n: d}")
print(f"{z:+d}")
print(f"{z: d}")

# no type letter after the sign
print(f"{n:+}")
print(f"{-n:+}")

# with a width, alignment and fill
print(f"{n:+5d}|")
print(f"{n:+<8d}|")
print(f"{n:+>8d}|")
print(f"{n:+^8d}|")

# zero padding goes BETWEEN the sign and the digits
print(f"{n:+06d}")
print(f"{-n:+06d}")
print(f"{n: 06d}")

# floats
print(f"{fl:+.2f}")
print(f"{-fl:+.2f}")
print(f"{fl: .2f}")
print(f"{fl:+10.2f}|")
print(f"{fl:+010.2f}")

# combined with the thousands separator
print(f"{big:+,}")
print(f"{-big:+,}")
print(f"{fl:+,.2f}")

# other bases
print(f"{n:+x}")
print(f"{n:+b}")

# and through .format() rather than an f-string
print("{:+d}".format(n))
print("{:+.1f}".format(fl))
print("{: d}".format(n))

# '#' — ALTERNATE form, prefixing the base. Grammar position is after the sign
# and before the zero-pad, and the zero padding sits INSIDE the prefix:
# f"{42:#010x}" is 0x0000002a, not 00000x2a.
# bug-nilpy-format-spec-alt-form-hash
print(f"{n:#x}")
print(f"{n:#X}")
print(f"{n:#o}")
print(f"{n:#b}")
print(f"{z:#x}")
print(f"{-n:#x}")
print(f"{n:#010x}")
print(f"{-n:#010x}")
print(f"{n:#10x}|")
print(f"{n:#<10x}|")
print(f"{n:+#x}")
print(f"{big:#x}")
print("{:#x}".format(n))

# '_' is a grouping separator too, exactly like ','
# bug-nilpy-format-spec-underscore-separator
print(f"{big:_}")
print(f"{-big:_}")
print(f"{n:_}")
print(f"{big:_d}")
print(f"{big:+_}")

# 'c' renders an int as the character with that codepoint
print(f"{65:c}")
print(f"{n:c}")

# .precision on a STRING TRUNCATES it (a maximum, where width is a minimum),
# and an unsupported string spec now RAISES instead of aborting the process
s = "abcdef"
print(f"{s:.2}")
print(f"{s:.99}")
print(f"{s:.0}|")
print(f"{s:8.3}|")
print(f"{s:>8.3}|")
try:
    print(f"{s:Q}")
except ValueError:
    print("string spec ValueError caught")
print("still running")

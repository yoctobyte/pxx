# `**` (didn't parse at all before), `/=` (true-division augmented assign,
# distinct from `//=`), and `divmod()` (missing). Precision on a genuinely
# fractional exponent (2 ** 0.5) is bounded by this compiler's own
# already-known float-str precision gap (same as math.sqrt(2)) -- not
# retested here since it isn't this ticket's concern.
# feature-nilpy-power-operator-and-divmod
# Every expectation is CPython's own output.

print(2 ** 10)
print(2 ** -2)
print(0 ** 0)
print(-2 ** 2)
print((-2) ** 3)
print(2 ** 3 ** 2)
print(2.0 ** 3)
print(3 ** 2.0)

def divtest():
    f = 1.5
    f /= 2
    print(f)
    n = 7
    n /= 2
    print(n)
divtest()

print(divmod(7, 2))
print(divmod(-7, 2))
print(divmod(7.5, 2))

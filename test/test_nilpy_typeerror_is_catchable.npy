# PyTypeError and the ValueError diagnostics next to it RAISE; they used to
# writeln + Halt, so no handler could see them.
# bug-nilpy-pytypeerror-halts-instead-of-raising
x = 2.5
try:
    print("ab" * x)
except TypeError:
    print("caught repeat")

try:
    print(len(3))
except TypeError:
    print("caught len")

try:
    print(int("junk"))
except ValueError:
    print("caught int")

try:
    print("%q" % (1,))
except ValueError:
    print("caught fmt")

try:
    print("a,b".split(""))
except ValueError:
    print("caught sep")

empty = []
try:
    print(max(empty))
except ValueError:
    print("caught max")

# calling a None binding: the one raise of this family that lived in pyeval
# rather than pylib, so it was catchable only as `except Exception:`
nothing = None
try:
    nothing()
except TypeError:
    print("caught call-None")

# the second sweep of the same family: diagnostics that still printed and
# Halt(1)'d after the first pass converted PyTypeError and the ValueError ones
try:
    print(ord("ab"))
except TypeError:
    print("caught ord")
try:
    print("abc"[9])
except IndexError:
    print("caught strindex")
try:
    print(set(5))
except TypeError:
    print("caught set")
try:
    print(",".join([1, 2]))
except TypeError:
    print("caught join")
buf = bytearray(2)
try:
    print(buf[9])
except IndexError:
    print("caught bytearray")
try:
    with open("/tmp/pxx_absent_file_zz.txt", "r") as fh:
        print(fh.read())
except FileNotFoundError:
    print("caught fnf")

# TypeError is a subclass of Exception, so a bare handler still sees it
try:
    print(len(3))
except Exception:
    print("as Exception")

print("after")

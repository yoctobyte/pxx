# A field written through a receiver OTHER than `self` must widen the way a
# `self.` store does. The class pre-pass joined only `self.NAME = ...`, so a
# float stored from a free def into a field its own methods keep int landed as
# its IEEE BITS (1.5 printed 4609434218613702656), a float literal was
# truncated, and an int into a float field printed 3.0. The .expected is
# CPython's own output for this file. PXXDBG=n.fjforeign prints the join
# each store took.
#
# C and D are BYSTANDERS: an unrelated class with a same-named field that only
# ever holds ints, one declared before the widened class and one after. Their
# rows must print exactly what CPython prints -- the join for an untyped
# receiver is name-wide, so they are where its blast radius would show.
# bug-n-a-store-through-a-non-self-receiver-never-widens-the-field-so-a-float-lands-as-raw-bits


class C:
    def __init__(self):
        self.s = 7


class A:
    def __init__(self):
        self.s = 0
        self.f = 0.5
        self.u = 0
        self.t = "x"


class D:
    def __init__(self):
        self.s = 9


def var_into_int(b):
    y = 1.5
    b.s = y
    print(b.s)


def field_into_int(b):
    b.s = b.f
    print(b.s)


def int_into_float(b):
    b.f = 3
    print(b.f)


def local_recv():
    a = A()
    y = 2.5
    a.s = y
    print(a.s)


def literal(b):
    b.s = 1.5
    print(b.s)


def chain(b):
    b.s = b.u = 0.25
    print(b.s, b.u)


def tuple_target(b: A):
    b.s, x = 4.5, 2
    print(b.s, x)


# SETTER shapes: the value is a bare PARAMETER. Typed from its call sites
# when they agree (an int into the float field); when they disagree (a float
# and a str into the int field) the tokens cannot type it, and the scalar
# field it reaches becomes a variant. Before: 2, 3.0, and a segfault.
def set_s(b, y):
    b.s = y


def set_f(b, y):
    b.f = y


def set_t(b, y):
    b.t = y


def bystander(c):
    print(c.s, c.s == 7 or c.s == 9, c.s // 2, "%d" % c.s, str(c.s), c.s + 1)


var_into_int(A())
field_into_int(A())
int_into_float(A())
local_recv()
literal(A())
chain(A())
tuple_target(A())

p = A()
set_s(p, 2.5)
print(p.s)
set_s(p, "str")
print(p.s)
set_f(p, 3)
print(p.f)
set_t(p, 4)
print(p.t)

m = A()
m.s = "text"
print(m.s)

bystander(C())
bystander(D())
c = C()
c.s = c.s * 3
print(c.s, type(c.s).__name__)

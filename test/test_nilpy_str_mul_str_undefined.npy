# bug-nilpy-same-kind-undefined-operators-still-compute — the `str * str` slice
#
# `"ab" * "ab"` is a TypeError in Python. pxx multiplied the two string HANDLES
# and printed whatever address product fell out — a different garbage integer per
# run, which is the worst failure mode this repo recognises: silent, and not even
# reproducible enough to look like a bug.
#
# The rest of the ticket's same-kind table (`list - list` and friends) stays open
# and is NOT tested here: pxx backs a Python `set` with TPyList, so `list - list`
# may be a set difference and there is no static way to tell. `str` is the
# exception the ticket itself identifies as the safe slice — it carries no
# set-like alter ego.
#
# The REPETITION forms below are the point of the controls: multiply across
# differing kinds is defined in Python, in either operand order, so the rejection
# must not touch them.

try:
    print("ab" * "ab")
except TypeError:
    print("str * str raises")

# repetition, both orders, str and list
print("ab" * 3)
print(3 * "ab")
print([1] * 3)
print(3 * [1])

# ordinary arithmetic is untouched
print(2 * 3)
print(2.0 * 3)

# the three that were already rejected, kept as neighbours so a regression in
# the shared rule shows up here rather than only in the ticket
for expr in range(1):
    try:
        print("ab" - "ab")
    except TypeError:
        print("str - str raises")
    try:
        print("ab" / "ab")
    except TypeError:
        print("str / str raises")

# ...and string concatenation, which must keep working
print("ab" + "cd")

# `nonlocal` through an ESCAPING closure — the textbook counter.
#
# A `nonlocal` capture is lifted as a BY-REF trailing parameter, so the body
# stores THROUGH the bound word. Every binder passed a VALUE, so the store went
# to the value-as-address: `c = 0` then `c = 5` wrote to address 0 and the
# process died. Measured as `mov %eax,(%rcx)` with rcx holding the captured
# value (0, and 4096 when the initialiser was changed to 4096).
#
# Fixed by binding an 8-byte heap CELL seeded with the current value and passing
# its ADDRESS (pyboundfn_bind_cell). The cell outliving the enclosing frame is
# what gives an escaped counter its state across calls, the way CPython's cell
# does. bug-nilpy-nonlocal-capture-in-an-escaping-closure-fails-to-parse
#
# Every line below is diffed against CPython. The cases that still DIVERGE —
# where the enclosing frame's own name and the escaped closure's cell are
# separate storage — are deliberately NOT here; they are
# bug-nilpy-an-escaped-nonlocal-cell-is-not-shared-with-the-enclosing-frame.


# the bare write that used to segfault: no read, no return, still fatal
def mk():
    c = 0
    def bump():
        nonlocal c
        c = 5
    return bump

f = mk()
print("before")
f()
print("after")


# the counter: state must PERSIST across calls to one escaped closure
def counter():
    n = 0
    def bump():
        nonlocal n
        n += 1
        return n
    return bump

bp = counter()
print(bp())
print(bp())
print(bp())


# ...and two counter() results must have INDEPENDENT cells
c1 = counter()
c2 = counter()
print(c1(), c1(), c2())


# called while the parent frame is still ALIVE, which takes the real by-ref
# parameter rather than a cell — this arm always worked and must stay working
def alive():
    c = 0
    def bump():
        nonlocal c
        c += 1
    bump()
    bump()
    return c
print("alive:", alive())


# a read-only capture (no `nonlocal`) is a by-VALUE parameter and unaffected
def ro():
    k = 7
    def get():
        return k
    return get
print("readonly:", ro()())


# TWO nonlocals in one closure: each needs its own cell, and the bind index
# must not confuse them
def two():
    a = 1
    b = 10
    def step():
        nonlocal a, b
        a += 1
        b += 10
        return a * 1000 + b
    return step
s = two()
print("two:", s(), s())


# a non-integer cell: the 8-byte cell has to hold a float payload too
def flt():
    x = 0.5
    def add():
        nonlocal x
        x += 0.25
        return x
    return add
g = flt()
print("float:", g(), g())


# the list-cell idiom Python programmers use to avoid `nonlocal` must keep
# working — it never went through the by-ref path at all
def viaList():
    box = [0]
    def bump():
        box[0] += 1
        return box[0]
    return bump
h = viaList()
print("list:", h(), h())


# A nested def taken as a VALUE THROUGH A LOCAL, not returned directly. This is a
# different lowering: `return inner` goes through ParseFactor, which has always
# called PyNestedDefClosureValue, while `f = inner` goes through
# PyMakeFuncValueFor — which built a bare code address with NO captures bound, so
# the callee read them out of the dead parent frame. Measured before the fix:
# `def peek(): return c` over `c = 41` printed 5580016 (a raw address) and the
# nonlocal form printed a constant 8 for every value of c, while `return peek` on
# the identical body printed 41.
def viaLocalPlain():
    c = 41
    def peek():
        return c
    f = peek
    return f
print("assign plain:", viaLocalPlain()())

def viaLocalNonlocal():
    c = 41
    def peek():
        nonlocal c
        return c
    f = peek
    return f
print("assign nonlocal:", viaLocalNonlocal()())

# ...and the counter, reached the same way, so the CELL survives the assignment
# path too rather than only the return path
def viaLocalCounter():
    n = 0
    def bump():
        nonlocal n
        n += 1
        return n
    f = bump
    return f
q = viaLocalCounter()
print("assign counter:", q(), q(), q())


# ONE SHARED CELL between the enclosing frame and every closure over it — the
# residue this file's earlier cases did not reach, because they only ever used
# the closure OR the frame's own name, never both. pxx used to bind a fresh
# 8-byte copy per closure seeded at the `def`, so the two storages split the
# moment both sides were used: these three printed 0, 0, 0.
# (bug-nilpy-an-escaped-nonlocal-cell-is-not-shared-with-the-enclosing-frame)

# (a) the frame reads its OWN name after an escaped closure wrote it
def sharedFrameSeesWrite():
    c = 0
    def bump():
        nonlocal c
        c += 1
    f = bump
    f()
    return c
print("shared a:", sharedFrameSeesWrite())

# (b) the closure reads the name after the frame wrote it POST-def
def sharedClosureSeesLateWrite():
    c = 0
    def peek():
        nonlocal c
        return c
    f = peek
    c = 99
    return f
print("shared b:", sharedClosureSeesLateWrite()())

# (c) two closures over one frame must share — no ordering between them, which
# is why nothing short of one cell can be right
def sharedTwoClosures():
    c = 0
    def inc():
        nonlocal c
        c += 1
    def get():
        nonlocal c
        return c
    a = inc
    b = get
    a()
    return b()
print("shared c:", sharedTwoClosures())

# a READ-ONLY sibling closure sees the writer's updates too: CPython gives it
# the same cell, so pxx must not hand it a by-value snapshot
def sharedReadOnlySibling():
    c = 5
    def inc():
        nonlocal c
        c += 10
    def get():
        return c
    w = inc
    r = get
    w()
    return r()
print("shared d:", sharedReadOnlySibling())

# a PARAMETER claimed by a nested def: the incoming value must reach the cell
def sharedParam(c):
    def bump():
        nonlocal c
        c += 1
    f = bump
    f()
    f()
    return c
print("shared e:", sharedParam(7))

# the cell OUTLIVES the frame and stays shared across calls
def sharedEscapes():
    c = 0
    def bump():
        nonlocal c
        c += 1
        return c
    def peek():
        nonlocal c
        return c
    return (bump, peek)
bp, pk = sharedEscapes()
bp()
bp()
print("shared f:", pk())


# A `nonlocal` capture reached ONLY through a direct call needs no frame cell:
# the call site passes the address of the enclosing slot and the by-ref parameter
# writes through it, so the two already share one storage. Promoting anyway cost
# a heap cell per ACTIVATION, never freed — 2M calls of this exact shape went
# from 1 MB flat to 48 MB. Correctness is what this prints; the allocation
# behaviour is what the shape is here to pin down.
def directOnly():
    c = 0
    def bump():
        nonlocal c
        c += 1
    bump()
    bump()
    return c
print("direct:", directOnly())

# ...and the same frame once the def IS taken as a value: the cell comes back,
# because the closure now outlives the frame
def directAndLifted():
    c = 0
    def bump():
        nonlocal c
        c += 1
    bump()
    f = bump
    f()
    return c
print("both:", directAndLifted())

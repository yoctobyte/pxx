# Ordering dunders (__lt__/__le__/__gt__/__ge__) on a user class.
# Without dispatch these fell through to a raw POINTER compare, so the answer
# was the allocation order of the operands with the method sitting unused —
# silent and wrong. bug-nilpy-comparison-dunders-not-dispatched.
# Expectation is CPython's own output.


class Full:
    def __init__(self, v):
        self.v = v

    def __lt__(self, o):
        return self.v < o.v

    def __le__(self, o):
        return self.v <= o.v

    def __gt__(self, o):
        return self.v > o.v

    def __ge__(self, o):
        return self.v >= o.v


class OnlyLt:
    # CPython answers `a > b` from the REFLECTED `b.__lt__(a)`, so one method
    # is enough for both directions. That fallback is the half a naive
    # implementation drops.
    def __init__(self, v):
        self.v = v

    def __lt__(self, o):
        return self.v < o.v


class Bare:
    def __init__(self, v):
        self.v = v


a = Full(3)
b = Full(1)
print(a < b)
print(b < a)
print(a <= b)
print(a >= b)
print(a > b)
print(b > a)

# a and b are allocated low-to-high, so a pointer compare would answer these
# the other way round — this pair is what actually catches a regression.
c = OnlyLt(3)
d = OnlyLt(1)
print(c < d)
print(c > d)

# no ordering dunder at all: CPython raises, it does NOT fall back to identity
# the way `==` does.
try:
    print(Bare(1) < Bare(2))
except TypeError:
    print("caught lt: TypeError")

# `==` keeps its identity fallback — unchanged by the ordering fix.
print(Bare(1) == Bare(1))

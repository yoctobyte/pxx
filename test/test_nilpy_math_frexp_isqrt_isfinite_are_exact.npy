# math.frexp / math.isqrt / math.isfinite — the EXACT operations, no rounding
# question, so none of them inherits the "do not map a 1-ulp-off RTL routine"
# policy that keeps log/pow/atan2 out of the frontend's intercept table.
#
# frexp is here for a SECOND reason and it is the interesting one. NilPy's
# `import math` binds the same-named PASCAL unit and resolves names against it
# case-insensitively, so a Python spelling reaches a Pascal routine whenever one
# bears the name. `math.ldexp` hit Pascal's `Ldexp(x, e): Double` and AGREED --
# by luck, because that signature happens to match CPython's. `math.frexp` hit
# Pascal's `procedure Frexp(x; var m; var e)` and REFUSED with "no overload of
# frexp matches these arguments", a Pascal sentence for someone who wrote
# Python, because CPython returns a PAIR. Neither routine was written as a
# Python entry point: both sit AFTER the unit's "Python math surface" block.
#
# So these rows are also the control on that carrier: each must be answered by
# the intercept, not by the Pascal routine. CPython is the oracle throughout.

import math

ok = True

def eq(label, got, want):
    global ok
    if got == want:
        print("%-30s %s" % (label, repr(got)))
    else:
        print("%-30s got %r want %r   FAIL" % (label, got, want))
        ok = False

# ---- frexp: x == mantissa * 2**exponent, with mantissa in [0.5, 1) ----
eq("frexp(8.0)", math.frexp(8.0), (0.5, 4))
eq("frexp(0.0)", math.frexp(0.0), (0.0, 0))
eq("frexp(-0.75)", math.frexp(-0.75), (-0.75, 0))
eq("frexp(1.0)", math.frexp(1.0), (0.5, 1))
# A SUBNORMAL, which is the whole reason the implementation scales by 2**64:
# a subnormal has a zero exponent field and no implicit leading 1, so without
# the scaling the entire subnormal range reports exponent -1022 with a mantissa
# far below 0.5. 5e-324 is the smallest positive double.
eq("frexp(5e-324) subnormal", math.frexp(5e-324), (0.5, -1073))
eq("frexp(inf)", math.frexp(float("inf")), (float("inf"), 0))

# ---- isqrt: the largest r with r*r <= n, EXACT ----
eq("isqrt(0)", math.isqrt(0), 0)
eq("isqrt(1)", math.isqrt(1), 1)
eq("isqrt(16) perfect square", math.isqrt(16), 4)
eq("isqrt(17) just above", math.isqrt(17), 4)
eq("isqrt(24) just below", math.isqrt(24), 4)
eq("isqrt(25) perfect square", math.isqrt(25), 5)
# DO NOT "SIMPLIFY" THE NEXT TWO ROWS TO SMALL NUMBERS. Every isqrt row above
# this point passes under BOTH a correct integer algorithm and a float-sqrt
# rounded back, so on their own they certify either implementation and cannot
# fail for the defect this function exists to avoid. 9007199254740993 is
# 2**53+1, the first integer a double CANNOT represent: the float route loads
# it as 2**53, takes a sqrt, and answers a neighbour, while "exact by
# definition" is the whole contract. The row is large on purpose; the size IS
# the assertion, and it is why the implementation uses neither Sqrt nor a cast.
eq("isqrt(2**53+1)", math.isqrt(9007199254740993), 94906265)
eq("isqrt(2**62)", math.isqrt(4611686018427387904), 2147483648)

# ---- isfinite: a PREDICATE, so no rounding question at all ----
eq("isfinite(1.0)", math.isfinite(1.0), True)
eq("isfinite(-0.0)", math.isfinite(-0.0), True)
eq("isfinite(inf)", math.isfinite(float("inf")), False)
eq("isfinite(-inf)", math.isfinite(float("-inf")), False)
eq("isfinite(nan)", math.isfinite(float("nan")), False)

# ---- the ROUND TRIP, which is the real contract between the pair ----
eq("ldexp(*frexp(123.456))", math.ldexp(*math.frexp(123.456)), 123.456)
eq("ldexp(*frexp(-1e-300))", math.ldexp(*math.frexp(-1e-300)), -1e-300)

# ---- isqrt refuses a negative, as CPython does ----
try:
    v = math.isqrt(-4)
    print("isqrt(-4) NO RAISE -> %r   FAIL" % v)
    ok = False
except ValueError:
    print("isqrt(-4)                      ValueError")

if ok:
    print("MATHEXACT OK")
else:
    print("MATHEXACT FAIL")

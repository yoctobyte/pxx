# A bytes slice, bytes(b), extend and slice assignment copy with one block
# Move, and a bytearray grows its buffer geometrically (TPyBytes.FCap) rather
# than reallocating per append. Shrinks, regrowth over stale bytes, views
# and the NUL-terminated buffer must all read exactly as before.
x = bytes(range(40))
print(x[0:0], x[3:9], x[-4:], x[38:100], x[:1], x[10:5], x[5:-30])
ba = bytearray(b"abcdefgh")
s = ba[2:6]
print(s, type(s).__name__, type(x[1:3]).__name__)
s[0] = 90
print(ba, s)
m = memoryview(x)
print(bytes(m[2:5]), bytes(m[1:2]))
big = bytes(100000)
print(len(big[10:99990]), sum(big[5:7]))
b = bytearray()
for i in range(1000):
    b.append(i & 255)
print(len(b), sum(b), b[:5], b[-3:])
b.extend(b"xyz")
b.extend(b)
print(len(b), b[1000:1006], b[-4:])
c = bytearray(b"hello")
c[1:3] = b"EL"
print(c)
c[1:3] = b"eeee"
print(c, len(c))
c[0:4] = b""
print(c, len(c))
c.append(33)
c.extend([65, 66])
print(c, bytes(c), len(c))
d = bytes(c)
d2 = bytearray(d)
d2.append(1)
print(d, d2)
e = bytearray(3)
e[0:2] = b""
e.extend(b"Q")
print(e, list(e))
f = b"ab" + b"cd" + bytes(2)
print(f, len(f))
m = memoryview(bytearray(b"abcdef"))
print(bytes(m[1:4]))

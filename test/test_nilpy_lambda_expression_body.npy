# bug-nilpy-lambda-body-expression-around-a-call-cannot-call-a-def
#
# A lambda whose body is an EXPRESSION AROUND a call was not lifted — only a
# body that WAS exactly one call. Everything else fell to the pyeval closure,
# which has no access to the program's compiled procs, so it died at RUN time
# with `pyeval: unknown call: f()`. Pinned prints `5` for the first line here
# and then dies on the second.
#
# Nothing in the lifted path was specific to a bare call; the predicate was the
# only thing holding it back. It now accepts any FLAT expression that contains
# a call, built from tokens the source reconstruction can write back out.
#
# f9 was the control: a body with no call at all still took the old path.
# NO LONGER TRUE as of 2026-08-10 — bug-nilpy-every-lambda-is-interpreted-
# instead-of-compiled dropped the sawCall requirement entirely, because the
# "no gain" premise quoted below was measured false (6.9x per call). f9 is now
# lifted like the rest; its assertion is unchanged and still passes, but it is
# a plain case here, not a control for the old route.
# Diffed against CPython (tools/pydiff.py).

def top():
    return 5

def dbl(x):
    return x * 2

class C:
    def __init__(self):
        self.n = 3
    def m(self):
        return self.n

h = 0
def hh():
    global h
    h += 1
    return 0

f1 = lambda: top()
f2 = lambda: top() + 1
f3 = lambda: hh() or 4
f4 = lambda x: dbl(x) * 2
f5 = lambda x: dbl(x) + dbl(x)
f6 = lambda: top() > 4
f7 = lambda x: dbl(x) if x > 0 else top()

print(f1())
print(f2())
print(f3(), h)
print(f4(5))
print(f5(3))
print(f6())
print(f7(2), f7(-1))

c = C()
f8 = lambda: c.m() + 1
print(f8())

# a body with NO call — lifted too since 2026-08-10 (see the header note)
f9 = lambda x: x + 1
print(f9(41))


# --- step 2 of that ticket, deferred there and taken now:
# bug-nilpy-curried-lambda-fails-at-runtime
#
# `lambda a: lambda b: a + b` was rejected by this same predicate twice — no
# call anywhere in the outer body, and the inner `:` outside its token set — so
# it fell to the pyeval closure, which has no `lambda` keyword and died at RUN
# time with "pyeval: name not defined: lambda". The predicate's justification
# for requiring a call ("a call-less body already works through pyeval, and
# lifting it would be a behaviour change for no gain") does not hold where the
# interpreter cannot run the body at all.
#
# Relaxed ONLY for a body that begins with `lambda`, so every other call-less
# body keeps its existing route.
#
# The open question the ticket recorded — whether the capture scan sees the
# INNER lambda's free variables — is answered by the two-step and reuse cases
# below: `a` is the outer's parameter and survives being partially applied,
# stored, and called twice.

add = lambda a: lambda b: a + b
print(add(3)(4))

held = add(10)
print(held(5), held(1))

three = lambda a: lambda b: lambda c: a + b + c
print(three(1)(2)(3))

pair = lambda a: lambda b: str(a) + "," + str(b)
print(pair("x")("y"))

def apply2(fn, x, y):
    return fn(x)(y)
print(apply2(lambda a: lambda b: a - b, 10, 4))

# CONTROLS: the two shapes that already worked must be unchanged
def outer(a):
    return lambda b: a + b
print(outer(1)(2))
inc = lambda a: a + 1
print(inc(41))

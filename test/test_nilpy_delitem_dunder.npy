# bug-nilpy-delitem-dunder-not-supported
#
# `del c[k]` on a user class was a compile error ("del is supported on a dict
# subscript, a list index or a list slice") — `__delitem__` was the one member
# of the subscript protocol never dispatched, while `__getitem__`/`__setitem__`
# already were.
#
# TWO node shapes have to work, and testing one hides the other: the subscript
# arm only claims a class that declares `__getitem__`, so a class declaring
# BOTH lowers the read to a CALL of __getitem__ (rewritten here), while a class
# declaring ONLY __delitem__ falls through to a generic AN_INDEX node. The
# second is not exotic — it is what a class that supports removal but not
# reading looks like, and CPython allows it. `Store` covers the first shape and
# `OnlyDel` the second.
#
# `del s[which()]` pins that the key expression is evaluated EXACTLY ONCE —
# the node is rewritten rather than re-parsed, and a rewrite that rebuilt the
# subscript would duplicate the call. "key evaluated" appearing twice is the
# failure this catches.
#
# A class with no __delitem__ raises a RUNTIME TypeError, not a compile error,
# so the try/except around it still builds — same rule as __setitem__.
#
# Controls: dict / list index / list slice `del` are unchanged.
#
# Expectations are CPython's own output.


class Store:
    def __init__(self):
        self.items = {"a": 1, "b": 2, "c": 3}
    def __getitem__(self, k):
        return self.items[k]
    def __setitem__(self, k, v):
        self.items[k] = v
    def __delitem__(self, k):
        print("del", k)
        del self.items[k]
    def keys(self):
        return sorted(self.items.keys())

class OnlyDel:
    # NO __getitem__: the read falls through to a generic index node, so this
    # is the other of the two shapes the rewrite has to recognise.
    def __delitem__(self, k):
        print("onlydel", k)


class NoDel:
    def __getitem__(self, k):
        return k

def which():
    print("key evaluated")
    return "b"

s = Store()
print("read  ", s["a"])
s["d"] = 4
print("keys  ", s.keys())
del s["a"]
print("after ", s.keys())
del s[which()]              # the key expression must run exactly once
print("after2", s.keys())

o = OnlyDel()
del o[7]

try:
    n = NoDel()
    del n["x"]
    print("nodel ", "NO ERROR")
except TypeError:
    print("nodel ", "TypeError")

# controls: dict / list index / list slice are unchanged
d = {"x": 1, "y": 2}
del d["x"]
print("dict  ", d)
xs = [0, 1, 2, 3, 4]
del xs[1]
print("index ", xs)
del xs[1:3]
print("slice ", xs)

# float repr finds its digit count by binary search over the exact interval
# test; every value here must print as CPython (incl. powers of two, the
# asymmetric case, which keeps the linear walk).
vals = [0.1, 0.2, 0.30000000000000004, 1/3, 2/3, 1e-20, 3e-5, 123456789.123, 1e16, 1e22, 5e-324,
        2.2250738585072014e-308, 1.7976931348623157e308, 0.6101212000480055, 4609.4340731198845,
        9007199254740993.0, 0.5, 100.0, 1e15, 1e17, 2.5e-5, 1234.5, 0.000123]
x = 0.123456789
for i in range(3000):
    x = x * 3.9 * (1.0 - x)
    vals.append(x * 10000.0 + i)
    vals.append(x / (i + 1.0) * 1e-200)
    vals.append(x * (i + 1.0) * 1e250)
k = -1070
while k < 1020:
    vals.append(2.0 ** k)
    k += 7
h = 0
for v in vals:
    for c in repr(v):
        h = (h * 131 + ord(c)) % 1000000007
print(len(vals), h)
print([repr(v) for v in vals[:23]])

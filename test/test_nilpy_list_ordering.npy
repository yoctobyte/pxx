# Ordering two lists is LEXICOGRAPHIC in Python. On the static path it was a raw
# HANDLE compare, so the answer came from the two objects' heap addresses and
# ignored their contents — `[9,9] < [1,1]` answered True.
# bug-nilpy-list-ordering-compares-heap-addresses.
#
# The cases below deliberately DEFEAT allocation order: the list written (and so
# allocated) first is the one that must sort LAST. A test whose expected order
# happens to match allocation order proves nothing here — that coincidence is
# exactly what let this survive, including in an existing passing assertion.
#
# Expectation is CPython's own output.

# allocated first, sorts LAST — the case that breaks the address coincidence
big_first = [9, 9]
small_second = [1, 1]
print("content <", big_first < small_second)
print("content >", big_first > small_second)
print("content <=", big_first <= small_second)
print("content >=", big_first >= small_second)

# equal lists: the strict/non-strict boundary
e1 = [1, 2]
e2 = [1, 2]
print("eq <", e1 < e2)
print("eq <=", e1 <= e2)
print("eq >", e1 > e2)
print("eq >=", e1 >= e2)

# a common PREFIX: the shorter sequence sorts first, whatever the addresses
long_first = [1, 0]
short_second = [1]
print("prefix <", long_first < short_second)
print("prefix >", long_first > short_second)

# element order still decides when it disagrees with nothing
print("plain <", [1, 2] < [1, 3])

# nested lists compare by their elements, recursively
print("nested <", [[2], [1]] < [[1], [2]])

# equality was already correct (pylist_eq was wired); keep it that way
print("eq ==", e1 == e2)
print("ne !=", e1 != long_first)

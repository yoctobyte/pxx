# A nested unpacking target may hold attribute leaves: Vloot's
# `(self.enc, self.enc_value), (self.dec, self.dec_value) = pair(...)`.
# The .expected is python3's.


class O:
    pass


def pair(a):
    return (a, a * 10), (a + 1, a * 20)


(a, b), (c, d) = [(1, 2), (3, 4)]
print(a, b, c, d)
a, (b, c) = 1, (2, 3)
print(a, b, c)

o = O()
(o.x, o.y), (o.z, o.w) = [(1, 2), (3, 4)]
print(o.x, o.y, o.z, o.w)


class G:
    def build(self):
        (self.enc, self.enc_value), (self.dec, self.dec_value) = pair(5)
        a, (self.p, q) = 1, (2, 3)
        return a + q


g = G()
print(g.build(), g.enc, g.enc_value, g.dec, g.dec_value, g.p)


def f():
    (a, b), (c, d) = [(1, 2), (3, 4)]
    return a + b + c + d


print(f())

# `def __eq__(self, o): return isinstance(o, P) and o.v == self.v` -- the
# spelling CPython's docs use -- was ignored by every container: the `and` of
# two bools types the def's result as a Variant, and the runtime dunder
# dispatcher only called a Boolean-returning __eq__. Declined, the comparison
# fell back to identity, so an equal key missed in a dict, `in` answered
# False, and a set kept duplicates. A direct `a == b` was always right.
# Diffed against CPython.


class P:
    def __init__(self, v):
        self.v = v

    def __eq__(self, o):
        return isinstance(o, P) and o.v == self.v

    def __hash__(self):
        return self.v


class Q:
    def __init__(self, v):
        self.v = v

    def __eq__(self, o):
        r = isinstance(o, Q) and self.v == o.v
        return r

    def __hash__(self):
        return hash(self.v)


d = {P(1): "one", P(2): "two"}
print(d.get(P(1)), d[P(2)], P(1) in d, P(3) in d, d.get(P(3)))
print(P(1) in [P(1)], P(1) in [P(2), 3, "x"], [P(2), P(1)].index(P(1)), [P(1), P(1), P(2)].count(P(1)))
print(len({P(1), P(1), P(2)}), P(1) in {P(1)}, P(1) == P(1), P(1) != P(1), P(1) == 3)
q = {Q("a"): [1]}
q[Q("a")].append(2)
print(q[Q("a")], len(q), Q("a") in q, Q("b") in q)
del d[P(1)]
print(list(k.v for k in d), d.pop(P(2)), len(d))

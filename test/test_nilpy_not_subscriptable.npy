# bug-nilpy-subscript-read-without-getitem-yields-garbage
#
# `w["x"]` on a class declaring no __getitem__ fell through to the generic
# AN_INDEX — pointer arithmetic on the instance handle — and yielded a plausible
# NUMBER or ended the program. CPython raises
# `TypeError: 'W' object is not subscriptable`.
#
# Declaring a SIBLING member did not rescue it: the getter arm tests
# `__getitem__` specifically, so a class with `__setitem__` or `__delitem__`
# still read as garbage. That is what made "this class clearly supports
# subscripting" and "the read is silently wrong" coexist.
#
# The refusal is at RUN time, not compile time, and that is load-bearing:
# `try: obj[k] / except TypeError:` is ordinary Python and must still COMPILE.
# The test is written that way throughout, so a compile-time refusal would fail
# it rather than pass it.
#
# Only a READ is taken over. The same closing-bracket peek the `__getitem__` arm
# uses decides that, because `obj[k] = v` is a different path — otherwise this
# refusal would have broken the very shape that motivated it.
#
# The WRITE half — `so["k"] = 1` on a class with `__setitem__` but NO
# `__getitem__` — was parked here as "not asserted, filed separately" and is now
# fixed and asserted below
# (bug-nilpy-setitem-without-getitem-write-does-not-compile). The gate was an
# else-if CHAIN keyed on `__getitem__`, so a setitem-only class matched the
# refusal arm and never reached the write path the comment said it would fall
# through to. All four cells of the 2x2 are pinned now, because the old gate
# conflated two of them.
#
# Expectations are CPython's own output.

class G:
    def __getitem__(self, k):
        return "got:" + str(k)

class SetOnly:
    def __setitem__(self, k, v):
        self.last = k

class Plain:
    def __init__(self):
        self.v = 1

g = G()
print(g["x"], g[0], g["a"])

so = SetOnly()
try:
    print(so["k"])
except TypeError as e:
    print("read:", e)

p = Plain()
try:
    print(p[0])
except TypeError as e:
    print("plain:", e)

xs = [1, 2, 3]
d = {"a": 1}
s = "abc"
print(xs[1], d["a"], s[1], xs[-1], s[-1], xs[0:2], s[0:2])
print(sorted(d.items())[0][0])

# --- the 2x2: {__getitem__?} x {__setitem__?}, read AND write for each.
# Written with try/except throughout for the same run-time-not-compile-time
# reason as above.

class WriteOnly:
    def __init__(self):
        self.last = "none"
    def __setitem__(self, k, v):
        self.last = str(k) + "=" + str(v)

class ReadOnly:
    def __getitem__(self, k):
        return "r:" + str(k)

class Both:
    def __init__(self):
        self.d = {}
    def __setitem__(self, k, v):
        self.d[k] = v
    def __getitem__(self, k):
        return self.d[k]

w = WriteOnly()
w["k"] = 1
print("wo-write", w.last)
try:
    print(w["k"])
except TypeError as e:
    print("wo-read", e)

r = ReadOnly()
print("ro-read", r["x"])
try:
    r["x"] = 2
    print("ro-write NO-RAISE")
except TypeError as e:
    # the full MESSAGE now: PyNoSetitemError names the class exactly as CPython
    # does, so the write half no longer reads worse than the read half
    # (bug-nilpy-nosetitem-error-does-not-name-the-class).
    print("ro-write", e)

bo = Both()
bo["a"] = 5
print("both", bo["a"])

pl = Plain()
try:
    pl["q"] = 3
    print("neither-write NO-RAISE")
except TypeError as e:
    print("neither-write", e)

+        for (m = LoaderStaticModules; m->name; m++)
+            if (n == strlen(m->name) + 10 && !strncmp(name, m->name, n - 10) &&
+                !strcmp(name + n - 10, "ModuleData"))
+                return m->data;
+    }
+
     p = dlsym(RTLD_DEFAULT, name);
     if (p != NULL)
         return p;
@@ -136,6 +197,17 @@
 LoaderSymbolFromModule(void *handle, const char *name)
 {
     ModuleDescPtr mod = handle;
+    const LoaderStaticModule *m;
+
+    for (m = LoaderStaticModules; m->name; m++)
+        if (mod->handle == (void *) m) {
+            size_t n = strlen(name);
+
+            if (n == strlen(m->name) + 10 && !strncmp(name, m->name, n - 10) &&
+                !strcmp(name + n - 10, "ModuleData"))
+                return m->data;
+            return NULL;
+        }
     return dlsym(mod->handle, name);
 }
 

diff -ru a/xorg-server-21.1.16/hw/xfree86/loader/loader.c b/xorg-server-21.1.16/hw/xfree86/loader/loader.c
--- a/hw/xfree86/loader/loader.c	2025-02-25 19:56:05.000000000 +0100
+++ b/hw/xfree86/loader/loader.c	2026-11-25 20:13:58.645448747 +0100
@@ -92,11 +92,61 @@
 
 /* Public Interface to the loader. */
 
+/*
+ * pathb: modules linked into a static Xorg. A binary built by pxx has no
+ * dynamic loader, so the drivers are linked in and LoadModule finds them
+ * here before it searches ModulePath. The table is empty in the server
+ * itself (a weak definition); the Path B link adds a strong one naming the
+ * modules it linked (tools/pathb/files/xorg-static-modules.c).
+ */
+_X_EXPORT __attribute__((weak)) LoaderStaticModule LoaderStaticModules[] = { { NULL, NULL } };
+
+static const LoaderStaticModule *
+LoaderStaticFind(const char *module)
+{
+    const LoaderStaticModule *m;
+
+    for (m = LoaderStaticModules; m->name; m++)
+        if (!strcmp(m->name, module))
+            return m;
+    return NULL;
+}
+
+static Bool
+LoaderStaticIsHandle(void *handle)
+{
+    const LoaderStaticModule *m;
+
+    for (m = LoaderStaticModules; m->name; m++)
+        if (handle == (void *) m)
+            return TRUE;
+    return FALSE;
+}
+
+Bool
+LoaderStaticHas(const char *module)
+{
+    return LoaderStaticFind(module) != NULL;
+}
+
+#define LOADER_STATIC_PREFIX "static:"
+
 void *
 LoaderOpen(const char *module, int *errmaj)
 {
     void *ret;
 
+    if (!strncmp(module, LOADER_STATIC_PREFIX, strlen(LOADER_STATIC_PREFIX))) {
+        const LoaderStaticModule *m =
+            LoaderStaticFind(module + strlen(LOADER_STATIC_PREFIX));
+
+        LogMessage(X_INFO, "Using built-in module %s\n",
+                   module + strlen(LOADER_STATIC_PREFIX));
+        if (!m && errmaj)
+            *errmaj = LDR_NOENT;
+        return (void *) m;
+    }
+
 #if defined(DEBUG)
     ErrorF("LoaderOpen(%s)\n", module);
 #endif

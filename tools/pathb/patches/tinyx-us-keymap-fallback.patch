+static void usFallbackMapping(void)
+{
+	int i, n = sizeof usKeys / sizeof usKeys[0];
+	int lo = usKeys[0].code, hi = usKeys[n - 1].code;
+
+	for (i = 0; i < (hi - lo + 1) * KD_MAX_WIDTH; i++)
+		kdKeymap[i] = NoSymbol;
+	for (i = 0; i < n; i++) {
+		KeySym *k = kdKeymap + (usKeys[i].code - lo) * KD_MAX_WIDTH;
+		k[0] = usKeys[i].plain;
+		k[1] = usKeys[i].shift;
+	}
+	kdMinScanCode = lo;
+	kdMaxScanCode = hi;
+}

--- a/compiler/defs.inc
+++ b/compiler/defs.inc
@@ -1589,6 +1589,15 @@ const
   IR_IO_UNLOCK     = 67; { release the I/O statement lock (depth-counted; owner cleared at depth 0). }
   MAX_LOOPSYM_SCAN = 64; { -O3 loop-residency: cap on distinct syms tallied inside a body's loop ranges (UnifiedResidencyAssign); overflow just means later syms are not residency candidates. }
   RC_RESIDENT_SLOTS = 6;  { GPR residency table size — the LARGEST pool any backend assigns from (aarch64 x19..x24; x86-64 uses 4 of them, r12..r15). See the RcResident* declarations: sizing it by x86-64's pool is what made aarch64 -O3 write past the end of three parallel arrays. }
+  { THE -O2 PROMOTION SWITCH for the float loop residency (xmm8..13 on x86-64,
+    d8..d13 on aarch64) and the x86-64 in-tree XMM fusion. False: both stay
+    -O3-only and -O2 codegen is unchanged. True: -O2 gets them too, and the
+    INTEGER residency stays -O3. Flip it only with the O-lane gates met: PROMISE
+    (feature-opt-double-code-is-2-to-4x-fpc-and-o3-already-halves-it: mandelbrot
+    4.0x -> 1.35x fpc at -O3) and PROOF (T's opt sweep at -O3, green,
+    skip_holes 0). `--o2-float-residency` turns it on for one compile, so the
+    promoted -O2 can be swept and measured before anyone flips this. }
+  PROMOTE_FLOAT_RESIDENCY = False;
   FR_RESIDENT_MAX  = 6;  { -O3 float loop residency: max tyDouble locals/params held in xmm8..xmm13 (xmm14/15 kept free as general scratch). Callee-saved in the pxx internal ABI, save-iff-used — allowed in bodies with calls (see FrResidentCount). }
   IR_CONST_DATA    = 68; { generic data-reference constant: IRIVal = Data[] offset OR a negative dataref sentinel (RECORD_RTTI/CLASSREF/SYM_RTTI bases, resolved by the pre-link fixup pass). Value = absolute data address in the accumulator. Lets IR-level CALLS pass descriptor addresses (e.g. a record layout descriptor to PXXDynArrayRetainImmediate) instead of needing a bespoke per-backend op. }
   IR_MULHI         = 69; { __pxxmulhi_u64(a, b): IRA = a, IRB = b. UNSIGNED widening 64x64->128 multiply, yielding the HIGH 64 bits in the accumulator (the low half is an ordinary tkStar multiply). x86-64 = `mul r64` (RDX:RAX), aarch64 = `umulh`. 64-BIT TARGETS ONLY -- IRLowerAST rejects it on the 32-bit targets, which have no such instruction, so the 32-bit backends never see this op and need no case. Callers get a portable path via lib/rtl's MulHiU64 wrapper ({$IFDEF CPU64} intrinsic {$ELSE} Pascal fallback). Exists so bignum/field arithmetic can use saturated 64-bit limbs instead of a reduced radix. }
@@ -3922,6 +3931,7 @@ var
   DumpIR : Boolean;
   DumpProcMap : Boolean;  { --proc-map: print 'PROC hexvaddr name' per routine to stderr (profiler symbolication) }
   EmitMapFile : Boolean;  { emit <out>.map (addr->proc symbol table). ON by default — it is the ONLY symbolication for the stripped binaries, so a crash address stays lookup-able. --no-map suppresses it (clean output dirs / release), --map forces it. }
+  PromoteFloatResidency : Boolean;  { PROMOTE_FLOAT_RESIDENCY, or --o2-float-residency; read only through FloatResidencyOn }
   OptLevel : Integer;     { -O0..-O3: optimization level. 0 (default) = the historic 1:1 emission — the self-host byte-identity gate runs at -O0 and is NEVER affected by opt passes; each pass gates on OptLevel >= its tier. }
   WarnedMissedFold : Boolean;  { one-shot latch for IROptWarnMissedFold: a foldable const-const / identity IR_BINOP reached codegen (const-fold was measured 0-fire and not shipped; this tripwire flags a future pass that starts producing them). }
   WarnedMissedFoldBranch : Boolean;  { the SECOND latch, one per detector. One latch served all three, and the const-const BINOP detector fires on nearly every -O2 compile (inline produces foldable BINOPs), so it set the shared latch first and the const-condition BRANCH detector -- quiet, and the guard for a load-time bug -- was never reached. Measured 2026-08-30: --warn-missed-fold on a program whose `if True` kept its dead arm reported the BINOP and said nothing about the branch. A noisy detector must not be able to silence a quiet one. bug-a-a-constant-if-condition-keeps-its-dead-arm-and-the-binary-will-not-start }

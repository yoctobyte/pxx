+{ MicroPython's CODE-EMITTER decorators: `@micropython.native`,
+  `@micropython.viper`, `@micropython.bytecode`. They are compiler directives
+  there, not calls -- MicroPython reads them without `micropython` being bound,
+  which is why st7789py.py can write them after a fallback that defines a
+  `micropython` class only when `time.sleep_ms` is missing. Each one picks how
+  the def is compiled and none changes what it computes, so here they are no-
+  ops: the def is compiled the way every def is. The names viper code reads
+  (ptr8/ptr16/ptr32, `uint`) are answered where names are read, not here.
+
+  At k (the token after `@`): 1 for a no-op emitter, 2 for an inline-assembler
+  emitter (`asm_thumb`, `asm_xtensa`: the body is machine code in Python
+  syntax, which this frontend does not assemble), 0 for anything else. Only a
+  bare `micropython.<name>` line qualifies -- a call or a subscript after it is
+  some other decorator. }
+function PyCodeEmitterDecoratorAt(k: Integer): Integer;
+var nm: AnsiString;
+begin
+  Result := 0;
+  if (k < 0) or (k + 3 >= TokCount) then Exit;
+  if (Tokens[k].Kind <> tkIdent) or (GetTokenStr(k) <> 'micropython') or
+     (Tokens[k + 1].Kind <> tkDot) or (Tokens[k + 2].Kind <> tkIdent) or
+     (Tokens[k + 3].Kind <> tkNewline) then Exit;
+  nm := GetTokenStr(k + 2);
+  if (nm = 'native') or (nm = 'viper') or (nm = 'bytecode') then Result := 1
+  else if (nm = 'asm_thumb') or (nm = 'asm_xtensa') or (nm = 'asm_rv32') then
+    Result := 2;
+end;
+
+{ CurTok is the token after `@`. Consume a code-emitter decorator and answer
+  True, or consume nothing and answer False. An assembler emitter is refused by
+  name rather than falling into the caller's generic "unsupported decorator". }
+function PyEatCodeEmitterDecorator: Boolean;
+begin
+  Result := False;
+  case PyCodeEmitterDecoratorAt(TokPos - 1) of
+    1: begin Next; Next; Next; Result := True; end;
+    2: Error('Nil Python: @micropython.' + GetTokenStr(TokPos + 1) + ' marks a '
+             + 'function written in MicroPython''s inline assembler, and this '
+             + 'compiler does not assemble it; write the function in Python');
+  end;
+end;
+
+{ The last token of the decorator line nearest ABOVE the `def` at defIdx,
+  stepping over newlines and over every code-emitter line, or the token before
+  the def when it has no decorator. Every backward decorator test asks this, so
+  `@micropython.viper` stacked above OR below `@staticmethod` reads the same:
+  st7789py.py writes it above, and the lookbacks used to see only the nearest
+  line. }
+function PyDecoratorTailBefore(defIdx: Integer): Integer;
+begin
+  Result := defIdx - 1;
+  while (Result >= 0) and (Tokens[Result].Kind in [tkNewline, tkIndent, tkDedent]) do
+    Dec(Result);
+  while (Result >= 3) and (Tokens[Result - 3].Kind = tkAt) and
+        (PyCodeEmitterDecoratorAt(Result - 2) = 1) do
+  begin
+    Result := Result - 4;
+    while (Result >= 0) and (Tokens[Result].Kind in [tkNewline, tkIndent, tkDedent]) do
+      Dec(Result);
+  end;
+end;

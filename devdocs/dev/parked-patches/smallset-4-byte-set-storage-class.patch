@@ -0,0 +1,181 @@
+{ A set whose elements all fit 0..31 is FOUR bytes, not 32 — tySmallSet.
+
+  Every row here is a shape that reads or writes the bitmap, because the
+  narrow storage class changes the WIDTH of every one of them: the copy, the
+  four binary operators, the six comparisons, membership, Include/Exclude, the
+  by-value parameter push and the callee spill, the hidden-destination result,
+  and the layout of a record or array that contains one. A width that is right
+  in some of those and wrong in others produces a plausible wrong value, not a
+  crash, which is why they are all here rather than a representative few.
+
+  THE OUT-OF-RANGE ELEMENT ROWS ARE THE POINT OF THE FILE. `x in s` and
+  Include(s, x) used to clamp the element to 0..255 so it could not deref past
+  a 32-byte set; against a four-byte one that same clamp reads and WRITES up to
+  28 bytes past the object, and `var x: Integer; x := 100; x in s` is ordinary
+  code FPC accepts and answers False for. Nothing else in the corpus reaches it.
+
+  Sizes are FPC 3.2.2's own rule, measured 2026-09-02: four bytes when the
+  element's HIGH ordinal is <= 31, thirty-two above it, and NOT rebased to the
+  low bound -- so `set of 200..207` is wide in both compilers.
+  bug-a-a-set-is-32-bytes-whatever-its-bounds-and-the-ir-opcode-says-so }
+program test_small_set_width;
+
+type
+  TE   = (eA, eB, eC, eD);
+  TES  = set of TE;
+  TS8  = set of 0..7;
+  TS31 = set of 0..31;
+  TS32 = set of 0..32;      { one past the small-set ceiling: WIDE }
+  THi  = set of 200..207;   { low-bounded only in FPC's imagination: WIDE }
+  TSC  = set of Char;
+
+  TRec = record
+    a: Byte;
+    s: TS8;
+    b: Byte;
+  end;
+
+const
+  CPreset: TES = [eA, eC];
+
+var
+  s1, s2, s3: TS8;
+  es: TES;
+  r: TRec;
+  arr: array[0..2] of TS8;
+  i, oor: Integer;
+  wide: TSC;
+
+function Bits(const s: TS8): Integer;
+{ by-VALUE narrow set parameter: the caller pushes its bitmap and the callee
+  spills it into its own slot }
+var k, n: Integer;
+begin
+  n := 0;
+  for k := 0 to 7 do
+    if k in s then n := n + (1 shl k);
+  Bits := n;
+end;
+
+function MakeSet(lo, hi: Integer): TS8;
+{ a narrow set RESULT: returned through the caller-owned hidden destination,
+  whose copy size is the set's own width }
+var k: Integer; acc: TS8;
+begin
+  acc := [];
+  for k := lo to hi do
+    Include(acc, k);
+  MakeSet := acc;
+end;
+
+procedure Widen(var s: TS8; v: Integer);
+{ a VAR narrow set: the callee writes through the caller's object }
+begin
+  Include(s, v);
+end;
+
+procedure ShowE(const nm: string; const e: TES);
+var k: TE;
+begin
+  write(nm, '=');
+  for k := eA to eD do
+    if k in e then write(Ord(k));
+  writeln;
+end;
+
+begin
+  { sizes — the headline, and FPC's exact answers }
+  writeln('sz ', SizeOf(TES), ' ', SizeOf(TS8), ' ', SizeOf(TS31), ' ',
+          SizeOf(TS32), ' ', SizeOf(THi), ' ', SizeOf(TSC));
+  writeln('rec ', SizeOf(TRec), ' arr ', SizeOf(arr));
+
+  { assignment (IR_SET_COPY at the narrow width) and membership }
+  s1 := [1, 3, 5];
+  s2 := s1;
+  writeln('copy ', Bits(s1), ' ', Bits(s2));
+
+  { the four binary operators }
+  s1 := [1, 2, 3];
+  s2 := [3, 4, 5];
+  writeln('union ', Bits(s1 + s2));
+  writeln('inter ', Bits(s1 * s2));
+  writeln('diff  ', Bits(s1 - s2));
+  writeln('symd  ', Bits(s1 >< s2));
+
+  { the six comparisons }
+  s3 := [1, 2, 3];
+  write('cmp ');
+  if s1 = s3  then write('1') else write('0');
+  if s1 <> s2 then write('1') else write('0');
+  if s1 <= s3 then write('1') else write('0');
+  if s1 >= s3 then write('1') else write('0');
+{$ifdef FPC}
+  { FPC 3.2.2 REFUSES `<` and `>` on sets -- "Operation not implemented for
+    sets" -- so the oracle gets proper-subset spelled the long way and pxx gets
+    the operator. Same value either way; the point of keeping both is that
+    tkLt/tkGt are their own arm of SET_CMP and the narrow width has to reach
+    them too. }
+  if ([1,2] <= s1) and ([1,2] <> s1) then write('1') else write('0');
+  if (s1 >= [1,2]) and (s1 <> [1,2]) then write('1') else write('0');
+{$else}
+  if [1,2] < s1 then write('1') else write('0');
+  if s1 > [1,2] then write('1') else write('0');
+{$endif}
+  writeln;
+
+  { membership with an OUT-OF-RANGE element — must be False and must not read
+    past the four bytes }
+  oor := 100;
+  s1 := [1, 3];
+  write('oor ');
+  if oor in s1 then write('1') else write('0');
+  oor := 40;
+  if oor in s1 then write('1') else write('0');
+  oor := 3;
+  if oor in s1 then write('1') else write('0');
+  writeln;
+
+  { Include/Exclude, including out of range: the WRITE direction of the same
+    clamp. The set must be unchanged and the neighbouring fields intact. }
+  r.a := 9; r.s := [2]; r.b := 11;
+  { the element is a VARIABLE on purpose: a constant 100 is folded (and
+    range-check-warned) by FPC before it ever reaches the bit write, so a
+    literal would test the constant folder and not the clamp. }
+  oor := 100;
+  Include(r.s, oor);
+  Include(r.s, 5);
+  oor := 200;
+  Exclude(r.s, oor);
+  writeln('incl ', r.a, ' ', Bits(r.s), ' ', r.b);
+
+  { by-value parameter, var parameter, function result }
+  s1 := [0, 7];
+  writeln('byval ', Bits(s1));
+  Widen(s1, 4);
+  writeln('varp  ', Bits(s1));
+  writeln('result ', Bits(MakeSet(2, 4)));
+
+  { an array of narrow sets: the element stride is the set's own width }
+  for i := 0 to 2 do
+    arr[i] := MakeSet(i, i + 1);
+  writeln('arr ', Bits(arr[0]), ' ', Bits(arr[1]), ' ', Bits(arr[2]));
+
+  { an enum-element narrow set, a named set constant, and for-in }
+  es := CPreset;
+  ShowE('const', es);
+  es := es + [eB];
+  ShowE('plusB', es);
+  write('forin=');
+  for i := 0 to 7 do
+    if i in MakeSet(3, 5) then write(i);
+  writeln;
+
+  { a WIDE set beside them, to prove the wide class still works unchanged }
+  wide := ['a'..'e'];

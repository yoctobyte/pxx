diff --git a/tools/pysig_layout.py b/tools/pysig_layout.py
new file mode 100755
index 0000000000..c459bcebc8
--- /dev/null
+++ b/tools/pysig_layout.py
@@ -0,0 +1,251 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: MPL-2.0
+"""The callable-signature record has THREE copies of one layout. Pin them.
+
+A NilPy `def` reached as a VALUE is called through a static signature record:
+the compiler writes it (`EmitPySignatures`, rtti_emit.inc) against byte offsets
+in `compiler/defs.inc`, and `compiler/builtin/pylib.pas` reads it back through a
+Pascal `record` whose field order IS those offsets. Nothing related the two, and
+a third copy -- the prose `+N name` table above the constants -- reads as a
+census of the layout.
+
+THE THIRD COPY WAS ALREADY STALE WHEN THIS WAS WRITTEN, which is why the table
+is pinned and not merely the two machine-readable halves. It stopped at `+32`
+while `+40` (Names) existed and had for some time, each later field having been
+documented in its own comment further down instead. Nobody re-derived the table,
+because a table does not look like a claim.
+
+WHAT A DISAGREEMENT COSTS, and it is this repo's expensive shape rather than a
+crash: the record is filled by ONE producer and read by ONE consumer, so a
+half-applied `PYSIG_SIZE` bump does not fail to link and does not fault. The
+reader simply lands one field short or one field long and returns a plausible
+wrong value -- a default read out of a name pointer, a keyword matched against a
+`ty*` word. The dispatcher has no way to notice: every field is 8 bytes and
+every bit pattern is a legal Int64.
+
+BOTH SIDES ARE DERIVED FROM THEIR OWN SOURCE. A hand-written table of expected
+offsets in this file would be a FOURTH copy of the thing that was already wrong
+once, and it would have passed on the day the prose table went stale.
+
+Two independent properties, because they fail differently:
+  - SIZE     PYSIG_SIZE must equal the record's own total width. Catches a field
+             added on one side only, which is the realistic drift.
+  - ORDER    the Nth `PYSIG_OFF_*` constant, the Nth record field and the Nth
+             prose row must all name the same slot. Catches a REORDER, which the
+             offsets alone cannot see -- two swapped 8-byte fields occupy the
+             same two offsets.
+
+The ORDER check needs no name map: a constant's token (`PYSIG_OFF_STAR` ->
+`STAR`) must be a PREFIX of the uppercased field name (`Star`, or a later
+`StarIdx`). That is a rule, not a third list, so it cannot itself go stale --
+and it is why `PYSIG_OFF_PARAMKINDS` is spelled out rather than abbreviated to
+`PKINDS`, which no rule could relate to `ParamKinds`.
+
+Run: tools/pysig_layout.py [--verbose] [--self-check]   (exit 0 = pass)
+"""
+import os
+import re
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+DEFS = os.path.join(ROOT, "compiler", "defs.inc")
+PYLIB = os.path.join(ROOT, "compiler", "builtin", "pylib.pas")
+
+# Widths of the Pascal types this record is ALLOWED to use, in bytes. An unknown
+# type is a hard error and not an assumed 8: the record's own header says "all
+# fields 8 bytes", and a future `Integer` field silently counted as 8 would make
+# this guard pass on the exact layout it exists to refuse.
+WIDTHS = {"pointer": 8, "int64": 8}
+
+
+def fail(msg):
+    print("pysig_layout: FAIL  " + msg)
+    return False
+
+
+def strip_braces(text):
+    """Pascal `{ ... }` comments out, so a comment cannot look like a field."""
+    out, depth = [], 0
+    for ch in text:
+        if ch == "{":
+            depth += 1
+        elif ch == "}":
+            if depth:
+                depth -= 1
+        elif depth == 0:
+            out.append(ch)
+    return "".join(out)
+
+
+def read_constants(defs_src):
+    """[(name, offset)] in DECLARATION order, plus PYSIG_SIZE."""
+    size = None
+    m = re.search(r"^\s*PYSIG_SIZE\s*=\s*(\d+)\s*;", defs_src, re.M)
+    if m:
+        size = int(m.group(1))
+    offs = []
+    for m in re.finditer(r"^\s*PYSIG_OFF_([A-Z0-9_]+)\s*=\s*(\d+)\s*;", defs_src, re.M):
+        offs.append((m.group(1), int(m.group(2))))
+    return size, offs
+
+
+def read_record(pylib_src):
+    """[(field, offset)] for TPySigRec, offsets computed from the widths."""
+    m = re.search(r"^\s*TPySigRec\s*=\s*record\b(.*?)^\s*end\s*;", pylib_src,
+                  re.M | re.S)
+    if not m:
+        return None, "TPySigRec = record ... end; not found in pylib.pas"
+    body = strip_braces(m.group(1))
+    fields, off = [], 0
+    for decl in body.split(";"):
+        decl = decl.strip()
+        if not decl:
+            continue
+        if ":" not in decl:
+            return None, "cannot parse a field declaration: %r" % decl
+        names, ty = decl.split(":", 1)
+        ty = ty.strip().lower()
+        if ty not in WIDTHS:
+            return None, ("field type %r is not one this layout may use "
+                          "(known: %s) -- see WIDTHS in tools/pysig_layout.py"
+                          % (ty, ", ".join(sorted(WIDTHS))))
+        for name in names.split(","):
+            name = name.strip()
+            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name):
+                return None, "cannot parse a field name: %r" % name
+            fields.append((name, off))
+            off += WIDTHS[ty]
+    return fields, off
+
+
+def read_prose(defs_src):
+    """[(name, offset)] from the `+N name` rows of the layout table."""
+    m = re.search(r"All fields 8 bytes, matching the RTTI blobs next door:\n(.*?)\n\s*\n",
+                  defs_src, re.S)
+    if not m:
+        return None, ("the prose layout table was not found. It is pinned on "
+                      "purpose (it was stale once); if it moved, move this "
+                      "anchor with it rather than deleting the check.")
+    rows = []
+    for line in m.group(1).split("\n"):
+        r = re.match(r"^\s*\+(\d+)\s+([A-Za-z_][A-Za-z0-9_]*)", line)
+        if r:
+            rows.append((r.group(2), int(r.group(1))))
+    return rows, None
+
+
+def check(defs_src, pylib_src, verbose=False):
+    ok = True
+    size, consts = read_constants(defs_src)
+    if size is None:
+        return fail("PYSIG_SIZE not found in compiler/defs.inc")
+    if not consts:
+        return fail("no PYSIG_OFF_* constants found in compiler/defs.inc")
+    fields, err = read_record(pylib_src)
+    if fields is None:
+        return fail(err)
+    prose, err = read_prose(defs_src)
+    if prose is None:
+        return fail(err)
+    _, recsize = read_record(pylib_src)
+
+    if verbose:
+        print("  consts: " + ", ".join("%s@%d" % c for c in consts))
+        print("  record: " + ", ".join("%s@%d" % f for f in fields))
+        print("  prose : " + ", ".join("%s@%d" % p for p in prose))
+
+    # SIZE -- the realistic drift: a field added on one side only.
+    if recsize != size:
+        ok = fail("PYSIG_SIZE is %d but TPySigRec is %d bytes wide (%d fields). "
+                  "A half-applied layout change does not fail to link and does "
+                  "not fault; the reader lands one field off and returns a "
+                  "plausible wrong value."
+                  % (size, recsize, len(fields)))
+
+    # ORDER -- three sequences, same slots, same offsets.
+    for label, seq in (("TPySigRec (pylib.pas)", fields),
+                       ("the prose layout table (defs.inc)", prose)):
+        if len(seq) != len(consts):
+            ok = fail("%d PYSIG_OFF_* constants but %d entries in %s. Every "
+                      "field of this record needs a named offset, and every "
+                      "named offset needs a field."
+                      % (len(consts), len(seq), label))
+            continue
+        for i, ((cname, coff), (fname, foff)) in enumerate(zip(consts, seq)):
+            if coff != foff:
+                ok = fail("slot %d: PYSIG_OFF_%s = %d but %s has %s at +%d"
+                          % (i, cname, coff, label, fname, foff))
+            if not fname.upper().startswith(cname):
+                ok = fail("slot %d: PYSIG_OFF_%s does not name %s in %s. The "
+                          "constant's token must be a PREFIX of the field name "
+                          "-- a reorder on one side leaves the offsets intact "
+                          "and this is the only thing that sees it."
+                          % (i, cname, fname, label))
+    return ok
+
+
+def self_check():
+    """Every mutation below MUST be refused. A guard that cannot fail is not one.
+
+    Each is a real drift someone could commit, not a scrambled file: a field
+    added on one side, a SIZE bumped without the field, two fields swapped, and
+    the prose table left one row short -- which is the drift that actually
+    happened."""
+    defs = open(DEFS, encoding="utf-8", errors="surrogateescape").read()
+    pylib = open(PYLIB, encoding="utf-8", errors="surrogateescape").read()
+
+    if not check(defs, pylib):
+        print("pysig_layout: SELF-CHECK CANNOT RUN -- the tree is already RED")
+        return False
+
+    cases = []
+    # a field added to the record, nothing else touched
+    cases.append(("a field added to TPySigRec only", defs,
+                  pylib.replace("    ParamKinds: Pointer;\n",
+                                "    ParamKinds: Pointer;\n    Extra: Int64;\n", 1)))
+    # PYSIG_SIZE bumped without the field
+    cases.append(("PYSIG_SIZE bumped without a field", 
+                  re.sub(r"(PYSIG_SIZE\s*=\s*)\d+", r"\g<1>72", defs, count=1), pylib))
+    # two fields swapped in the record: same offsets, wrong slots
+    cases.append(("two record fields swapped", defs,
+                  pylib.replace("    Dflts: Pointer;", "    XDfltsX: Pointer;", 1)
+                       .replace("    Names: Pointer;", "    Dflts: Pointer;", 1)
+                       .replace("    XDfltsX: Pointer;", "    Names: Pointer;", 1)))
+    # the prose table left one row short -- the drift that actually happened
+    cases.append(("a row dropped from the prose table",
+                  re.sub(r"^ +\+56 ParamKinds.*\n", "", defs, count=1, flags=re.M),
+                  pylib))
+    # a constant whose token no longer names its field
+    cases.append(("a constant renamed away from its field",
+                  defs.replace("PYSIG_OFF_PARAMKINDS", "PYSIG_OFF_PKINDS"), pylib))
+
+    ok = True
+    for name, d, p in cases:
+        if d == defs and p == pylib:
+            print("pysig_layout: SELF-CHECK BROKEN -- %r mutated nothing, so it "
+                  "proves nothing. The anchor it edits has moved." % name)
+            ok = False
+            continue
+        print("  positive control: %s" % name)
+        if check(d, p):
+            print("pysig_layout: SELF-CHECK FAILED -- %r was ACCEPTED" % name)
+            ok = False
+    if ok:
+        print("pysig_layout: self-check OK -- %d mutations, all refused" % len(cases))
+    return ok
+
+
+def main():
+    verbose = "--verbose" in sys.argv
+    if "--self-check" in sys.argv:
+        return 0 if self_check() else 1
+    defs = open(DEFS, encoding="utf-8", errors="surrogateescape").read()
+    pylib = open(PYLIB, encoding="utf-8", errors="surrogateescape").read()
+    if not check(defs, pylib, verbose):
+        return 1
+    print("pysig_layout: OK -- the three copies of the signature layout agree")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

+++ b/test/test_nilpy_micropython_native_and_viper_pointer_views.npy
@@ -0,0 +1,52 @@
+# MicroPython's code-emitter decorators and viper's pointer views.
+# native / viper / bytecode compile as ordinary defs; ptr8/ptr16/ptr32(buf) are
+# little-endian views over a bytearray, a store keeping the element's low bits.
+# The expected output is written out by hand (CPython has neither decorator
+# nor view), and is the byte layout MicroPython's viper produces on the board.
+
+
+class Pack:
+    @micropython.viper
+    @staticmethod
+    def pack16(glyphs, idx: uint, fg: uint, bg: uint):
+        buffer = bytearray(8)
+        bitmap = ptr16(buffer)
+        glyph = ptr8(glyphs)
+        byte = glyph[idx]
+        for i in range(4):
+            bitmap[i] = fg if byte & (0x80 >> i) else bg
+        return buffer
+
+    @staticmethod
+    @micropython.native
+    def twice(x):
+        return 2 * x
+
+    @micropython.native
+    def plus(self, a, b):
+        return a + b
+
+
+@micropython.viper
+def words32(n: uint):
+    b = bytearray(8)
+    p = ptr32(b)
+    p[0] = n
+    p[1] = 0x1122334455          # wider than 32 bits: the low 32 are kept
+    return b
+
+
+@micropython.bytecode
+def readback(b):
+    p = ptr16(b)
+    return [p[0], p[1], p[2], p[3]]
+
+
+print(list(Pack.pack16(bytes([0x00, 0xA0]), 1, 0xF800, 0x001F)))
+print(readback(Pack.pack16(bytes([0x50]), 0, 0x1234, 0xABCD)))
+print(list(words32(0x01020304)))
+print(Pack.twice(21), Pack().plus(2, 3))
+q = ptr8(bytearray(2))
+q[1] = 0x1FF                  # low 8 bits
+print(q[0], q[1])
+print("VIPER OK")

+procedure EmitFrozenStrStoreBodyA64(srcTk: TTypeKind; strCap: Integer);
+{ ONE lowering for "write a value into a frozen `string[N]` buffer", with the
+  destination address already in x6 and the source already in x5 -- a char
+  ordinal, a managed handle, or a frozen-string address, per srcTk. Writes
+  [len:8][chars] at x6, clamped to strCap. Clobbers x4, x9, x10.
+
+  It exists because this body was DUPLICATED between IR_STORE_SYM (`s := v`) and
+  IR_STORE_MEM (`p^ := v`), identical instruction for instruction and differing
+  only in where the capacity comes from -- SymStrCap[si] against
+  Integer(IRIVal[node]). The two copies had drifted: the SYM copy handled a
+  tyChar source and the MEM copy raised
+  "char-to-inline-string store through pointer not yet supported", so `s := c`
+  compiled and `p^ := c` did not, on this backend and on i386 and arm32 alike
+  (bug-a-char-into-shortstring-through-a-pointer-is-x86-64-only). Sharing the
+  body is what makes that unrepresentable rather than fixed: there is no longer
+  a second arm to leave behind. normalise-dont-special-case.md. }
+var pNilPos, pDonePos: Integer;
+begin
+  if srcTk = tyChar then
+  begin
+    { x5 = char ordinal -> [len=1][char] }
+    EmitLoadImmA64(9, 1);
+    EmitI32($F90000C9);                    { str x9, [x6] (len=1) }
+    EmitI32($390020C5);                    { strb w5, [x6,#8] }
+    Exit;
+  end;
+  if srcTk = tyAnsiString then
+  begin
+    { Managed source -> frozen dest: x5 = handle (char pointer), length at
+      [x5,#-8]; nil handle -> empty. }
+    pNilPos := CodeLen;
+    EmitI32($B4000005);                    { cbz x5, empty (patched) }
+    EmitI32($F85F80A9);                    { ldur x9, [x5,#-8] (len) }
+    EmitClampLenToStrCapA64(9, strCap);
+    EmitI32($F90000C9);                    { str x9, [x6] (length word) }
+    EmitI32($AA0903E4);                    { mov x4, x9 (count) }
+    EmitI32($910020C6);                    { add x6, x6, #8 }
+    EmitA64CopyBytes(4, 5, 6);
+    pDonePos := CodeLen;
+    EmitI32($14000000);                    { b done (patched) }
+    Patch32(pNilPos, $B4000005 or ((((CodeLen - pNilPos) div 4) and $7FFFF) shl 5));
+    EmitI32($F90000DF);                    { empty: str xzr, [x6] (len=0) }
+    Patch32(pDonePos, $14000000 or (((CodeLen - pDonePos) div 4) and $3FFFFFF));
+    Exit;
+  end;
+  { frozen -> frozen: copy the length prefix, clamp, then the chars. }
+  EmitI32($F94000A9);                      { ldr x9, [x5] (len prefix) }
+  EmitClampLenToStrCapA64(9, strCap);      { truncate to string[N] capacity }
+  EmitI32($F90000C9);                      { str x9, [x6] }
+  EmitI32($AA0903E4);                      { mov x4, x9 (count) }
+  EmitI32($910020A5);                      { add x5, x5, #8 }
+  EmitI32($910020C6);                      { add x6, x6, #8 }
+  EmitA64CopyBytes(4, 5, 6);
+end;

      else if augTk = tkXor then setOp := 'setsymdiff'
      else setOp := 'setdiff';
      Result := PyCallMeth1(PyNodeListCi(PyMakeIdent(symIdx)), setOp,
                            PyMakeIdent(symIdx), CurASTNode);
      if Result < 0 then
        Error('Nil Python: pylib TPyList.' + setOp + ' not loaded');
      Exit;
    end;
    { a USER class instance: __iadd__, else __add__ and rebind (Python's rule).
      Checked after the TPyList case, which has its own in-place meaning. }
    node := PyAugClassDunder(symIdx, augTk, CurASTNode);
    if node >= 0 then
    begin
      Result := node;
      Exit;
    end;
    { `x @= y` on anything that is not a user class declaring the dunder: a
      runtime TypeError, never the AN_BINOP below. No builtin type implements
      `@`, so there is nothing for the arithmetic path to mean
      (bug-nilpy-matmul-operator-does-not-parse). }
    if augTk = tkAt then
    begin
      Result := PyMakeUnsupportedOperand;
      Exit;
    end;
    { `xs *= 2` / `s *= 2` on a SEQUENCE — the repeat, see PyAugMulNode }
    if augTk = tkStar then
    begin
      node := PyAugMulNode(PyMakeIdent(symIdx), CurASTNode);
      if node >= 0 then
      begin
        Result := AllocNode(AN_ASSIGN);
        ASTLeft[Result] := PyMakeIdent(symIdx);
        ASTRight[Result] := node;
        Exit;
      end;
    end;
    { `n = 7; n /= 2` -- unlike a plain rebind (`n = n / 2`), an augmented
      assignment reuses the EXISTING symIdx rather than allocating a fresh
      Syms[] entry, so the widening harvest in PyCollectLocalsAST/
      PyCollectModuleLocalsAST -- which unions types by seeing MULTIPLE
      entries for the same name -- never learns `n` needs to be a float:
      the frame slot stayed Int64 and `print(n)` read the Double's raw bits
      through an integer formatter. Note the constraint explicitly, the same
      way a for-loop target does, so the target's OWN declared type widens
      across trial-parse rounds rather than only the local node's.
      feature-nilpy-power-operator-and-divmod }
    if PyTypingPass and (augTk = tkSlash) and (Syms[symIdx].TypeKind <> tyDouble) then
      PyNoteLocalType(name, FloatBinopResultTk(Syms[symIdx].TypeKind,
                                               IntToTypeKind(ASTTk[CurASTNode])), REC_NONE);
    PyNoteOptionalTaint(symIdx, CurASTNode);
    PyCoerceAssignmentRHS(Syms[symIdx].TypeKind, CurASTNode);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(augTk);
    ASTLeft[node] := PyMakeIdent(symIdx); ASTRight[node] := CurASTNode;
    { see the twin lhs-expression site's note: a variant target's `+=` must
      extend a runtime list IN PLACE rather than rebind
      (bug-nilpy-augmented-add-on-variant-list-is-not-in-place). }
    if (augTk = tkPlus) and (Syms[symIdx].TypeKind = tyVariant) then
      ASTSLen[node] := PY_BINOP_AUGADD;
    { `/=` is always a float (see the twin lhs-expression site's note); widen,
      don't copy the target type otherwise: `n -= 0x10000000000000000` on an
      int target must type the binop PROMO (see the twin lhs-expression site) }
    if augTk = tkSlash then
      ASTTk[node] := Ord(FloatBinopResultTk(Syms[symIdx].TypeKind,
                                            IntToTypeKind(ASTTk[CurASTNode])))
    else
      ASTTk[node] := Ord(PyWiden(Syms[symIdx].TypeKind,
                                 IntToTypeKind(ASTTk[CurASTNode])));
    { An accumulator written the AUGMENTED way is still an accumulator, and
      Python ints have no ceiling. The PLAIN spelling already promotes — module
      scope through PyBlkIntArith ("an accumulator: `n = n * 2`"), inside a def
      through the AST pre-pass — but this site hand-builds its AN_BINOP and
      typed it with PyWiden alone, and PyWiden(Int64, Int64) is Int64. So
      `a = 1; for i in range(1,22): a *= i` wrapped mod 2^64 (21! came back
      -4249290049419214848) while `a = a * i` printed 51090942171709440000.
      Two spellings of one operation answering differently is the tell.

      Only the operators that can GROW the value: `//=` `%=` `&=` cannot exceed
      their operands, and `/=` is float and already handled above. tkShl is
      included for the same reason PyParseShift promotes unconditionally —
      `1 << 64` must reach past Int64.

      The local's own constraint is noted too, not just the node: the frame SLOT
      has to widen across the trial-parse rounds, which is the rule `/=` and
      `**=` each needed one scope over. }
    if ((augTk = tkPlus) or (augTk = tkMinus) or (augTk = tkStar) or
        (augTk = tkShl)) and
       (IntToTypeKind(ASTTk[node]) in [tyInteger, tyInt64, tyBoolean]) then
    begin
      ASTTk[node] := Ord(tyPromoInt64);
      if PyTypingPass then PyNoteLocalType(name, tyPromoInt64, REC_NONE);
    end;
    { …and the same rule for EVERY widening, not just the promo one above and
      `/=` further up. PyWiden already gave the NODE the right type — the gap
      was that the target's own slot never heard about it, so `tot = 0` then
      `tot += v` over a list holding a float kept an Int64 frame slot and
      truncated the sum to 3 where CPython says 3.5. No crash, no diagnostic:
      the node said variant and the slot said int, and the store split the
      difference. (At MODULE scope the same shape hit RunError 219 instead —
      the token-shape arm in PyCollectModuleLocalsAST carries the twin of this
      fix.) bug-nilpy-int-local-accumulating-a-float-from-a-list-crashes-219 }
    if PyTypingPass and (IntToTypeKind(ASTTk[node]) <> Syms[symIdx].TypeKind) then
      PyNoteLocalType(name, IntToTypeKind(ASTTk[node]), REC_NONE);
    rhsNode := node;
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := rhsNode;
    Result := node;
    Exit;
  end;
  { Annotated assignment `NAME : ann = expr`.

    The annotation goes through PyAnnTypeAt, the same grammar a FIELD or a
    parameter gets. It used to be read by PyTypeFromTokenIndex and the match
    required the '=' to sit exactly two tokens after the name — so the
    annotation had to be a SINGLE token, and `d: Dict[str, int] = {}` at
    module or function scope failed while the identical `self.d: Dict[...]`
    worked. Same class of bug as the method-parameter one: two readers for one
    grammar, and the narrow one wins wherever it is still wired up. }
  if (CurTok.Kind = tkIdent) and (TokPos + 2 < TokCount) and
     (Tokens[TokPos].Kind = tkColon) then
  begin
    annIdx := TokPos + 1;
    tk := PyAnnTypeAt(annIdx);
    ci := PyAnnLastCi;
    annSig := PyAnnLastProcSig;
    if (tk = tyUnknown) and (annIdx < TokCount) and
       (Tokens[annIdx].Kind = tkAssign) then
    begin
      { An annotation this reader cannot interpret must not push the statement
        off this path entirely: `v: Sequence[int] = [1, 2]` then matched NO arm
        and the name was simply never bound, so the failure surfaced as
        `undefined variable (v)` at the first USE, naming the variable and not
        the annotation. Degrade to Any and take the ordinary annotated route.
        bug-n-an-uninterpretable-annotation-refuses-the-program }
      PyWarnUnreadAnnotation('variable ' + CurTok.SVal, CurTok.Line);
      tk := tyVariant;
      ci := -1;
      annSig := -1;
    end;
    if (tk <> tyUnknown) and (annIdx < TokCount) and
       (Tokens[annIdx].Kind = tkAssign) then
    begin
      name := CurTok.SVal;
      TokPos := annIdx;
      Next;                      { CurTok = '=' }
      Expect(tkAssign, '=');
      { The right-hand side gets EXACTLY the treatment the unannotated path
        gives it (see `cb = handler` further down): a bare def NAME becomes a
        function VALUE, and a lambda's closure/bound-fn pointer is boxed. This
        path did neither — it went straight to PyParseBoolExpr — so an
        ANNOTATED local was the one spelling that missed both.

        Invisible until a `Callable` annotation became a VARIANT: before that
        `g: Callable[[VM], None] = w_ten` made g a POINTER holding a bare code
        address and the typed indirect call worked. As a variant it holds an
        unboxed address the dynamic dispatcher then misreads — a SEGFAULT on
        `g(vm)`, where the identical `g = w_ten` (no annotation) was fine.
        Sibling branches: one rule, two statement spellings, and only one of
        them had it.
        bug-nilpy-annotated-callable-local-assigned-a-bare-def-segfaults }
      rhsNode := -1;
      if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
         (Tokens[TokPos].Kind in [tkNewline, tkDedent, tkEOF]) then
        rhsNode := PyMakeFuncValue;
      if rhsNode < 0 then
      begin
        PyParseBoolExpr;
        rhsNode := PyBoxCallableValue(CurASTNode);
      end;
      CurASTNode := rhsNode;
      symIdx := PyAssignTargetSym(name);
      if symIdx < 0 then
      begin
        { `s: str` means an UNBOUNDED Python string, so the local is managed —
          tyString is the frozen kind and truncated at 255 characters, silently
          (bug-nilpy-string-local-truncates-at-255). Class FIELDS have mapped
          str this way all along; locals now agree with them. }
        if tk = tyString then tk := tyAnsiString;
        symIdx := AllocVar(name, tk);
        if (tk = tyClass) and (ci >= 0) then
          Syms[symIdx].RecName := REC_UCLASS_BASE + ci;
        { ...but NOT for a variant. A `Callable` annotation yields a VARIANT
          now, and a recorded signature makes the call site marshal the name as
          a procedural value — a typed indirect call straight through the
          16-byte slot. The FIELD case keeps its signature deliberately (it is
          the marker that says "this field is callable"); a LOCAL has no such
          need and only the ABI reads it here. }
        if (annSig >= 0) and (tk <> tyVariant) then SymProcSig[symIdx] := annSig;
        SymSyncTypeRef(symIdx);
      end;
      lhsNode := PyMakeIdent(symIdx);
      PyNoteOptionalTaint(symIdx, CurASTNode);
    PyCoerceAssignmentRHS(Syms[symIdx].TypeKind, CurASTNode);
      node := AllocNode(AN_ASSIGN);
      ASTLeft[node] := lhsNode;
      ASTRight[node] := CurASTNode;
      Result := node;
      Exit;
    end;
  end;
  { CHAINED assignment `a = b = RHS`. Python binds every target to ONE
    evaluation of the right-hand side, so `a = b = f()` calls f once — which is
    why this cannot desugar to `b = f(); a = f()`. It goes through a hidden temp
    instead, assigned once and then stored to each target LEFT TO RIGHT, which
    is also CPython's order.

    Before this the statement was read as `a = (b = RHS)` and reported
    "undefined variable (b)" — a diagnostic that names the wrong thing entirely
    (bug-nilpy-chained-assign-power-assign-and-semicolon-statements).

    PLAIN NAME targets only. `d[k] = d2[k2] = f()` has targets with side effects
    of their own and is refused by name below rather than guessed at — the temp
    would be right for it too, but the STORE path for a subscript target is a
    different lowering and quietly getting it half-right is the failure mode
    this frontend is trying to avoid. }
  if (CurTok.Kind = tkIdent) and (TokPos + 2 < TokCount) and
     (Tokens[TokPos].Kind = tkAssign) and
     (Tokens[TokPos + 1].Kind = tkIdent) and
     (Tokens[TokPos + 2].Kind = tkAssign) then
  begin
    chainN := 0;
    while (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
          (Tokens[TokPos].Kind = tkAssign) do
    begin
      if chainN >= 8 then
        Error('Nil Python: at most 8 targets in a chained assignment');
      chainNames[chainN] := CurTok.SVal;
      Inc(chainN);
      Next;
      Expect(tkAssign, '=');
    end;
    PyParseBoolExpr;
    chainTmp := AllocVar(PyHiddenName('chain'), IntToTypeKind(ASTTk[CurASTNode]));
    Syms[chainTmp].RecName := ResolveNodeRec(CurASTNode);
    SymSyncTypeRef(chainTmp);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(chainTmp);
    ASTRight[node] := CurASTNode;
    chainSeq := PySeqAppend(-1, node);
    for chainI := 0 to chainN - 1 do
    begin
      symIdx := PyAssignTargetSym(chainNames[chainI]);
      if symIdx < 0 then
      begin
        symIdx := AllocVar(chainNames[chainI], Syms[chainTmp].TypeKind);
        Syms[symIdx].RecName := Syms[chainTmp].RecName;
        SymSyncTypeRef(symIdx);
      end;
      if PyTypingPass then
        PyNoteLocalType(chainNames[chainI], Syms[chainTmp].TypeKind,
                        ResolveNodeRec(PyMakeIdent(chainTmp)));
      node := AllocNode(AN_ASSIGN);
      ASTLeft[node] := PyMakeIdent(symIdx);
      ASTRight[node] := PyMakeIdent(chainTmp);
      chainSeq := PySeqAppend(chainSeq, node);
    end;
    Result := chainSeq;
    Exit;
  end;
  if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkAssign) then
  begin
    name := CurTok.SVal;
    symIdx := PyAssignTargetSym(name);
    Next;
    Expect(tkAssign, '=');
    { `target = [EXPR for VAR in ITER]` — a list comprehension. Desugared to an
      empty-list init plus an appending loop, so the whole statement IS that
      sequence, not an ordinary assignment. }
    if PyIsListCompAhead then
    begin
      { A name being introduced HERE is born as the list itself; only a name
        that already exists with some other type needs the detour below. }
      cmpExisted := symIdx >= 0;
      if symIdx < 0 then symIdx := AllocVar(name, tyClass);
      if cmpExisted and (PyNodeListCi(PyMakeIdent(symIdx)) < 0) then
      begin
        { The name already exists with a type that is not a list — a variant
          PARAMETER being rebound is the common case, and songformatter writes
          exactly that (`fret_positions = [... for fret in fret_positions]`).
          The loop appends INTO the target, so a non-list target left the
          append with no class to resolve against and the whole comprehension
          failed with a misleading "pylib TPyList.append/add not loaded".
          Build into a hidden list and assign it across instead. }
        cmpTmp := AllocVar(PyHiddenName('comp'), tyClass);
        Syms[cmpTmp].RecName := REC_UCLASS_BASE + FindUClass('TPyList');
        SymSyncTypeRef(cmpTmp);
        cmpSeq := PyParseListComp(cmpTmp);
        cmpAsgn := AllocNode(AN_ASSIGN);
        ASTLeft[cmpAsgn] := PyMakeIdent(symIdx);
        ASTRight[cmpAsgn] := PyMakeIdent(cmpTmp);
        Result := PySeqAppend(cmpSeq, cmpAsgn);
        Exit;
      end;
      Result := PyParseListComp(symIdx);
      Exit;
    end;
    { a brace comprehension with a colon key — a dict comprehension. }
    if PyIsDictCompAhead then
    begin
      if symIdx < 0 then symIdx := AllocVar(name, tyClass);
      Syms[symIdx].RecName := REC_UCLASS_BASE + FindUClass('TPyDict');
      SymSyncTypeRef(symIdx);
      Result := PyParseDictComp(symIdx);
      Exit;
    end;
    { `res = None` stores a real None (VT_EMPTY), exactly as the `self.x = None`
      and `d[k] = None` routes already did. Without it the nil literal lowered
      to a plain zero, so the local was born non-variant and the very next
      `res = <int>` failed to widen — "annotate the type / too dynamic" on the
      ordinary Python idiom of seeding a result with None
      (bug-nilpy-none-assign-to-plain-local). Sibling branches again. }
    if PyBareNoneHere then
    begin
      Next;
      rhsNode := PyMakeNone;
    end
    else if (CurTok.Kind = tkIdent) and IsClassType(CurTok.SVal) and
       (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
       (not PyCtorSuffixAhead) and PyCtorEndsRhs then
      { ...but `x = Cls().method(...)` is not a construction ASSIGNMENT: the
        construction is the RECEIVER. Leave it to the expression parser, whose
        factor path builds the construction and then applies the method suffix
        (bug-nilpy-method-call-on-fresh-construction). }
      rhsNode := PyClassCreate
    else if PyIsEmptySetCall then
      rhsNode := PyParseEmptySet
    else if PyIsCountCall then
      rhsNode := PyParseCountCreate
    else
    begin
      { `cb = handler` — a bare def NAME as the whole right-hand side is
        Python's function object, the same value an ARGUMENT position already
        builds (PyMakeFuncValue: a pybound_new pair, tyVariant). Parsed as an
        ordinary read the local came out non-variant, so the later `cb(...)`
        never reached the dynamic-call path and the call did nothing at all.
        PyMakeFuncValue returns -1 (consuming nothing) unless the token really
        is a def name in a value position. }
      rhsNode := -1;
      if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
         (Tokens[TokPos].Kind in [tkNewline, tkDedent, tkEOF]) then
        rhsNode := PyMakeFuncValue;
      if rhsNode < 0 then
      begin
        PyParseBoolExpr;
        rhsNode := CurASTNode;
        { `g = lambda ...`: box the closure/bound-fn pointer so the name is a
          variant and `g(...)` reaches the dynamic-call path at all. }
        rhsNode := PyBoxCallableValue(rhsNode);
      end;
    end;
    if symIdx < 0 then
    begin
      tk := IntToTypeKind(ASTTk[rhsNode]);
      if CurProc < 0 then
      begin
        ci := PyFindModuleConstraint(name);
        if ci >= 0 then tk := PyModuleLocals[ci].TypeKind;
      end;
      { see the annotated branch above: a NilPy string variable is managed }
      if tk = tyString then tk := tyAnsiString;
      symIdx := AllocVar(name, tk);
    end;
    if (ASTKind[rhsNode] = AN_CALL) and (ASTIVal[rhsNode] = -Ord(tkGetMem)) then
      Syms[symIdx].RecName := ASTRight[rhsNode]
    else if (ASTKind[rhsNode] = AN_CALL) and (ASTIVal[rhsNode] >= 0) and
            (Procs[ASTIVal[rhsNode]].RetType = tyClass) then
      { class-returning call (e.g. a chained list-literal append): carry the
        result class so methods/subscripts on the variable resolve }
      Syms[symIdx].RecName := ProcRetRecId[ASTIVal[rhsNode]]
    else if (Syms[symIdx].TypeKind = tyClass) and
            (ResolveNodeRec(rhsNode) >= REC_UCLASS_BASE) then
      { any other class-valued RHS — notably a FIELD access, `x = o.inner`.
        Without this the local was declared tyClass with no RecName, so the
        later `x.name` had no class to resolve against and read the object
        pointer as the field (bug-nilpy-class-typed-field-loses-identity). }
      Syms[symIdx].RecName := ResolveNodeRec(rhsNode);
    SymSyncTypeRef(symIdx);

    { Trial parse: every assignment widens the local, not just the first one
      (the symbol only remembers the first). }
    if PyTypingPass then
    begin
      PyNoteLocalType(name, IntToTypeKind(ASTTk[rhsNode]), ResolveNodeRec(rhsNode));
    end;
    lhsNode := PyMakeIdent(symIdx);
    PyNoteOptionalTaint(symIdx, rhsNode);
    PyCoerceAssignmentRHS(Syms[symIdx].TypeKind, rhsNode);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := lhsNode;
    ASTRight[node] := rhsNode;
    Result := node;
    Exit;
  end;
  PyParseBoolExpr;
  { `buf[a:b] = src` on a plain local. Unlike `self.buf[a:b] = src` this never
    reaches an assignment route: a slice is not an ordinary lvalue, so the
    expression path returned the READ call and left the '=' sitting there. }
  if PyIsBytesSliceCall(CurASTNode) and (CurTok.Kind = tkAssign) then
  begin
    lhsNode := CurASTNode;
    Next;
    PyParseBoolExpr;
    Result := PyRewriteSliceAssign(lhsNode, CurASTNode);
    Exit;
  end;
  Result := CurASTNode;
end;

function PyParseBlock: Integer;
var stmt: Integer;
begin
  Result := -1;
  PySkipNewlines;
  while not (CurTok.Kind in [tkDedent, tkEOF]) do
  begin
    stmt := PyParseStatement;
    Result := PyFlushHoist(Result);
    Result := PySeqAppend(Result, stmt);
    { `u = int(vm.pop()); addr = int(vm.pop())` — Python allows several simple
      statements on one line, separated by ';'. Consumed here so the newline
      check below still applies to the LAST one on the line. }
    while CurTok.Kind = tkSemicolon do
    begin
      Next;
      if CurTok.Kind in [tkNewline, tkDedent, tkEOF] then Break;  { trailing ';' }
      stmt := PyParseStatement;
      Result := PyFlushHoist(Result);
      Result := PySeqAppend(Result, stmt);
    end;
    if CurTok.Kind = tkNewline then PySkipNewlines
    else if (stmt >= 0) and (ASTKind[stmt] in [AN_IF, AN_WHILE, AN_FOR,
                                               AN_TRY_EXCEPT, AN_TRY_FINALLY]) then
      continue
    else if PyStmtAteBlock then
    begin
      { a nested `def`: like if/while/for it consumed its own indented block
        (and the DEDENT that closes it), but it produces no statement node
        (feature-nilpy-nested-defs) }
      PyStmtAteBlock := False;
      continue;
    end
    else if not (CurTok.Kind in [tkDedent, tkEOF]) then
      Error('Nil Python: expected newline after statement');
  end;
end;

{ Type a body's implicit locals by PARSING it, not by scanning its tokens.

  Python declares a local by assigning to it, and a local's type can WIDEN
  across branches (`x = 1` then `x = "s"` -> variant), so the frame cannot be
  laid out until every assignment has been seen. That constraint is real; the
  old answer to it was not. PyCollectLocals met it with a token scanner
  (PyInferExprType and friends) that re-implemented expression typing a second
  time and drifted from the parser that actually builds the call — a str method
  returning a class was invisible to it, and `"a,b".split(",")` was invisible
  because the scan only inspected IDENT tokens.

  So: keep the pre-pass, drop the scanner. Parse the body to AST in a scratch
  scope and let the ordinary assignment path type each local from ASTTk of the
  node it just built (pyparser's `symIdx < 0` branch already does exactly
  that — this only gives it a second look at the body). Then throw the scratch
  AST and scratch symbols away and keep the widened name->type table. Nothing
  here can drift from the real parse because it IS the real parse — the same
  shape rparser.inc:RParseLet and zparser.inc:ZParseVarDecl already use.

  Iterated to a fixed point: round 1 types `x` from its FIRST assignment, so a
  `y = x + 1` between two assignments to `x` still sees the pre-widening `x`.
  Re-seeding the scratch scope from the widened table and re-parsing settles
  it. PyWiden only ever widens, so the loop is monotone; PY_INFER_ROUNDS caps
  it anyway rather than trusting that forever.

  Safe to run over the same tokens repeatedly: NilPy statement and expression
  parsing allocates AST nodes and scope-local symbols and emits NO code (the
  prologue is emitted by the caller, after this returns), and both allocations
  are rolled back here. }
const PY_INFER_ROUNDS = 4;

{ PXXDBG=n.locals — the inferred local table, after the fixed-point rounds.
  The other probe hand-patched during the same hunt: "what type did NilPy
  actually give this local" was previously unanswerable without a rebuild. }
procedure PyDbgDumpLocals(const whose: AnsiString);
var i, si: Integer;
begin
  if not PxxDbgEnabled('n.locals') then Exit;
  for i := 0 to PyLocalCount - 1 do
  begin
    si := PyProgSym(PyLocals[i].Name);
    if si >= 0 then
      WriteLn('PXXDBG n.locals ', whose, ' ', PyLocals[i].Name,
              ' tk=', Ord(PyLocals[i].TypeKind), ' rec=', PyLocals[i].RecCi,
              ' | sym=', si, ' symtk=', Ord(Syms[si].TypeKind),
              ' symrec=', Syms[si].RecName, ' kind=', Ord(Syms[si].Kind))
    else
      WriteLn('PXXDBG n.locals ', whose, ' ', PyLocals[i].Name,
              ' tk=', Ord(PyLocals[i].TypeKind), ' rec=', PyLocals[i].RecCi,
              ' | sym=<none>');
  end;
end;

procedure PyCollectLocalsAST(bodyStart: Integer);
var rnd, i, si, savedTok, savedAST, savedSC, savedCur, savedFS: Integer;
    savedDefInit: Integer;
    newCi, oldCi: Integer;
    changed: Boolean;
    tk, w: TTypeKind;
    nm: AnsiString;
begin
  PyLocalCount := 0;
  { The def-time default initialisers queued by the HEADER we were called from
    are already pending, and each trial round below clears the queue. Park them
    on a fresh chain — not merely saved, since appending to a live chain mutates
    the old tail in place — and put them back afterwards. Missing this silently
    dropped every non-constant default's initialiser and the hidden global read
    as zero. }
  savedDefInit := PyDefInitHead;
  PyDefInitHead := -1;
  rnd := 0;
  repeat
    changed := False;
    PyTypingChanged := False;
    PyTypingPass := True;
    savedTok := TokPos;
    savedAST := ASTNodeCount;
    savedCur := CurASTNode;
    savedSC := SymCount;
    savedFS := FrameSize;
    { seed the scratch scope with what the previous round learned }
    for i := 0 to PyLocalCount - 1 do
      if PyAssignTargetSym(PyLocals[i].Name) < 0 then
      begin
        si := AllocVar(PyLocals[i].Name, PyLocals[i].TypeKind);
        if (PyLocals[i].TypeKind = tyClass) and (PyLocals[i].RecCi >= 0) then
        begin
          Syms[si].RecName := REC_UCLASS_BASE + PyLocals[i].RecCi;
          SymSyncTypeRef(si);
        end;
      end;
    TokPos := bodyStart;
    Next;
    PyParseBlock;
    { harvest every symbol the body declared, widening against the table }
    for i := savedSC to SymCount - 1 do
    begin
      nm := Syms[i].Name;
      if nm = '' then Continue;
      { Hidden for-in temps are re-created by the real parse with fresh
        serials, so harvesting the trial pass's ones would reserve frame slots
        that nothing ever reads — one wasted triple per loop per round. }
      if Copy(nm, 1, 5) = '__py_' then Continue;
      tk := Syms[i].TypeKind;
      si := PyFindConstraint(nm);
      if si < 0 then
      begin
        if PyLocalCount >= PY_MAX_LOCALS then
          Error('Nil Python: too many inferred locals');
        PyLocals[PyLocalCount].Name := nm;
        PyLocals[PyLocalCount].TypeKind := tk;
        if Syms[i].RecName >= REC_UCLASS_BASE then
          PyLocals[PyLocalCount].RecCi := Syms[i].RecName - REC_UCLASS_BASE
        else
          PyLocals[PyLocalCount].RecCi := -1;
        PyLocals[PyLocalCount].Poly := False;
        Inc(PyLocalCount);
        changed := True;
      end
      else
      begin
        w := PyWidenBinding(PyLocals[si].TypeKind, tk);
        if w <> PyLocals[si].TypeKind then
        begin
          PyLocals[si].TypeKind := w;
          changed := True;
        end;
        { NOT guarded on RecCi already being SET (the original form of this
          rule): a name reassigned across ROUNDS to a call returning a
          DIFFERENT class kept its FIRST round's class identity forever, so
          `with open(p,"w") as f: ...` then a later plain `f = open(p, "r")`
          left f dispatching as a TPyFile while it now held a TPyList --
          .readlines() / len() read the wrong class's layout and printed the
          RTTI blob (the same disclosure shape as
          bug-nilpy-file-write-drops-data-and-read-to-print-dumps-rtti-memory,
          via a different trigger than that ticket's write() overload). Take
          the latest resolved class whenever it differs. }
        { ...but "the latest" is only right when the two classes are RELATED,
          i.e. one refines the other. A name that genuinely holds instances of
          two UNRELATED classes has no single static layout, and picking either
          one makes every member access on the other read a field at the wrong
          offset -- `o = DC(...); o.native(1); o = PC(...); o.native(2)`
          segfaulted before printing anything, because it JUMPED through
          whatever sat at DC's `native` offset inside a PC.
          (It only bites when the layouts differ, which is why it hid for so
          long behind same-offset shapes.) The honest answer there is the one
          the method and field scans already reach: no single answer, so go
          dynamic. Poly is sticky -- see TPyLocalConstraint.
          bug-nilpy-local-reassigned-across-classes-keeps-one-static-class }
        if (Syms[i].RecName >= REC_UCLASS_BASE) and (not PyLocals[si].Poly) then
        begin
          newCi := Syms[i].RecName - REC_UCLASS_BASE;
          oldCi := PyLocals[si].RecCi;
          if oldCi <> newCi then
          begin
            if (oldCi >= 0) and (not IsSubclassOf(newCi, oldCi))
                            and (not IsSubclassOf(oldCi, newCi)) then
            begin
              PyLocals[si].Poly := True;
              PyLocals[si].RecCi := -1;
              PyLocals[si].TypeKind := tyVariant;
              changed := True;
            end
            else
            begin
              PyLocals[si].RecCi := newCi;
              changed := True;
            end;
          end;
        end;
      end;
    end;
    PyTypingPass := False;
    if PyTypingChanged then changed := True;
    SymRollbackTo(savedSC);
    ASTNodeCount := savedAST;
    FrameSize := savedFS;
    CurASTNode := savedCur;
    { hoisted setup statements queued during the TRIAL parse reference AST
      nodes the rollback just discarded — flushing them into the real parse
      lowered recycled node ids (IR_UNSUPPORTED kind 9 after a multi-expr
      f-string, once the literal bind-then-append hoist landed). Nothing can
      be legitimately pending here: trials start at statement boundaries,
      where the suite builders have already flushed. }
    PyHoistHead := -1;
    { and the def-time default initialisers, for exactly the same reason: a
      trial round that parses a `def` queues one, the rollback then re-issues
      the same node id to something else, and the duplicate guard would refuse
      to queue the REAL one — so the module ran the recycled statement and the
      default global stayed zero. }
    PyDefInitHead := -1;
    { Re-READ the saved token rather than restoring a saved copy of CurTok:
      Next does SetLength(CurTok.SVal, ...) in place, so a record copy taken
      before the trial parse shares that buffer and comes back holding whatever
      token the trial stopped on (a compiler segfault, not a subtle wrong
      type). Tokens[] is the only trustworthy source. }
    TokPos := savedTok - 1;
    Next;
    Inc(rnd);
  until (not changed) or (rnd >= PY_INFER_ROUNDS);
  PyDefInitHead := savedDefInit;
end;

{ Type MODULE-level names by PARSING the module body, the same way
  PyCollectLocalsAST types a function's locals.

  The token-scanning version this replaces (PyCollectModuleLocals, and
  PyInferExprType under it) was the last of the eight scanners: a second
  implementation of expression typing that drifted from the parser which
  actually builds the call. It could not see a brace literal as a dict, a str
  method returning a class, or anything whose type came from a real overload.

  Why this could not be done until now: a module statement can call a def
  declared further down the file, and until PyRegisterDefShells there was no
  Proc to resolve against, so a trial parse would have failed on ordinary
  Python. With the signatures registered up front, the module body parses.

  The scan starts at the CURRENT cursor — the real parser is positioned just
  past the imports when this runs, which is exactly the module body — and
  skips `def` and `class` spans, since PyParseStatement cannot parse those and
  their bodies are not module scope anyway.

  Rolls back the AST, the symbols, the frame and BSSSize: a module-level
  AllocVar allocates a BSS global, so without the BSSSize restore every
  iteration would leak the whole module's globals again. }
{ Does this name already stand for an INTEGER at module scope? Asked by the
  token-shape probe below, which may not parse and so cannot ask the AST. }
function PyBlkIntName(const nm: AnsiString): Boolean;
var ci, si: Integer;
begin
  PyBlkIntName := False;
  ci := PyFindConstraint(nm);
  if ci >= 0 then
  begin
    PyBlkIntName := PyIsMachineIntTk(PyLocals[ci].TypeKind) or
                    TypeIsPromoInt(PyLocals[ci].TypeKind);
    Exit;
  end;
  si := PyProgSym(nm);
  if si >= 0 then
    PyBlkIntName := PyIsMachineIntTk(Syms[si].TypeKind) or
                    TypeIsPromoInt(Syms[si].TypeKind);
end;

{ The kind a module-scope name holds when that kind is INTEGER-ish, else
  tyUnknown. Companion to PyBlkIntName, which only answers yes/no.

  Used by the bare-name COPY shape (`a = b`), which otherwise types every
  constrained source as a variant. That is safe for most kinds but it BREAKS
  AN ACCUMULATOR CHAIN: Fibonacci is `c = a + b; a = b; b = c`, so once `a`
  became a variant, PyBlkIntArith no longer saw `a + b` as integer arithmetic,
  `c` stopped being promotable, and the module-scope loop wrapped at 2^63
  while the same code inside a def was exact. Preserving the source's own
  integer kind keeps the chain closed, and the pre-pass's fixpoint rounds then
  carry promo backwards through it. }
function PyBlkIntNameKind(const nm: AnsiString): TTypeKind;
var ci, si: Integer;
begin
  PyBlkIntNameKind := tyUnknown;
  ci := PyFindConstraint(nm);
  if ci >= 0 then
  begin
    if PyIsMachineIntTk(PyLocals[ci].TypeKind) or
       TypeIsPromoInt(PyLocals[ci].TypeKind) then
      PyBlkIntNameKind := PyLocals[ci].TypeKind;
    Exit;
  end;
  si := PyProgSym(nm);
  if si >= 0 then
    if PyIsMachineIntTk(Syms[si].TypeKind) or TypeIsPromoInt(Syms[si].TypeKind) then
      PyBlkIntNameKind := Syms[si].TypeKind;
end;

{ Is `i` the start of a TUPLE-UNPACK TARGET LIST — `a, b[, c] =` — made only of
  plain identifiers separated by commas and terminated by a single '='? Answers
  the '=' position in `tupEnd`.

  Identifiers ONLY, deliberately: `d[k], x = ...` and `obj.f, y = ...` are legal
  Python but bind through a subscript or a field rather than declaring a module
  name, and this scan exists purely to declare names. Anything else in the run
  makes it answer False and the statement is left alone, exactly as before.
  bug-nilpy-tuple-unpacked-name-undefined-in-a-later-assignment }
function PyTupleTargetRun(i: Integer; var tupEnd: Integer): Boolean;
var k: Integer; wantIdent: Boolean;
begin
  PyTupleTargetRun := False;
  tupEnd := -1;
  k := i;
  wantIdent := True;
  while k < MainProgramTokCount do
  begin
    if wantIdent then
    begin
      if Tokens[k].Kind <> tkIdent then Exit;
      wantIdent := False;
    end
    else if Tokens[k].Kind = tkComma then wantIdent := True
    else if Tokens[k].Kind = tkAssign then
    begin
      tupEnd := k;
      PyTupleTargetRun := True;
      Exit;
    end
    else Exit;
    Inc(k);
  end;
end;

{ Is `i` the start of a FOR TARGET LIST — `a` or `a, b[, c]` — terminated by
  `in`? Answers the name COUNT in `cnt` and the `in` position in `inIdx`.

  Identifiers only, like PyTupleTargetRun and for the same reason: a NESTED
  (`for n, (p, q) in …`) or STARRED target is refused by the real parser with
  its own diagnostic, and this scan exists purely to note names.
  bug-nilpy-multi-name-for-target-reuses-a-module-name-and-reads-garbage }
function PyForTargetRun(i: Integer; var cnt, inIdx: Integer): Boolean;
var k: Integer; wantIdent: Boolean;
begin
  PyForTargetRun := False;
  cnt := 0;
  inIdx := -1;
  k := i;
  wantIdent := True;
  while k < MainProgramTokCount do
  begin
    if wantIdent then
    begin
      if Tokens[k].Kind <> tkIdent then Exit;
      Inc(cnt);
      wantIdent := False;
    end
    else if Tokens[k].Kind = tkComma then wantIdent := True
    else if Tokens[k].Kind = tkIn then
    begin
      inIdx := k;
      PyForTargetRun := True;
      Exit;
    end
    else Exit;
    Inc(k);
  end;
end;

{ `name = <integer arithmetic>` as the shape of a statement, read from TOKENS.

  The module pre-pass may not trial-parse a right-hand side that sits inside a
  control-flow block — the block has not run for real yet, so a reference to
  anything the pre-pass cannot also see calls Error() and Halts the compile
  (the landmine documented at both callers). So the shapes it trusts there are
  recognised token by token, and this adds one more: an accumulator.

  It exists because that is precisely where an accumulator LIVES. The headline
  case of bug-nilpy-int-promotion-decided-statically is

      n = 1
      for i in range(70):
          n = n * 2

  and without this the loop body never widens `n`, so it stays the tyInteger
  its initialiser made it and wraps at 2^63 in silence. Inside a def the AST
  pre-pass sees the same statement and widens it correctly; only module scope
  had the hole.

  Recognises ONLY int literals, `+ - *`, GROUPING parens, and names already
  known to be integers — no dots, no subscripts. A `(` is accepted only when
  it does NOT directly follow an ident, which is what keeps the original
  invariant that an ident here can never be a call: `f * (i + 1)` is grouping,
  `f * g(1)` is not and bails. Anything else returns False and the caller
  behaves exactly as before. At least one operator must appear, or this is a
  plain copy and the existing bare-name arm types it better. }
function PyBlkIntArith(j: Integer): Boolean;
var k, depth: Integer; sawOp: Boolean;
begin
  PyBlkIntArith := False;
  sawOp := False;
  depth := 0;
  k := j;
  while (k < MainProgramTokCount) and
        (not (Tokens[k].Kind in [tkNewline, tkDedent, tkSemicolon])) do
  begin
    if Tokens[k].Kind in [tkPlus, tkMinus, tkStar] then
      sawOp := True
    else if Tokens[k].Kind = tkInteger then
      { an int literal — fine }
    else if Tokens[k].Kind = tkLParen then
    begin
      { grouping only: a paren directly after an ident is a CALL, whose result
        this probe cannot type, so bail exactly as it did before parens were
        allowed at all. }
      if (k > j) and (Tokens[k - 1].Kind = tkIdent) then Exit;
      depth := depth + 1;
    end
    else if Tokens[k].Kind = tkRParen then
    begin
      depth := depth - 1;
      if depth < 0 then Exit;
    end
    else if Tokens[k].Kind = tkIdent then
    begin
      if not PyBlkIntName(GetTokenStr(k)) then Exit;
    end
    else
      Exit;
    k := k + 1;
  end;
  if depth <> 0 then Exit;
  PyBlkIntArith := sawOp;
end;

function PyIsPhantom(const nm: AnsiString): Boolean;
{ Was this name registered by the pre-pass PURELY so a later trial parse could
  resolve it? See the PyPhantomNames declaration. }
var i: Integer;
begin
  PyIsPhantom := False;
  for i := 0 to PyPhantomCount - 1 do
    if PyPhantomNames[i] = nm then begin PyIsPhantom := True; Exit; end;
end;

procedure PyNotePhantom(const nm: AnsiString);
begin
  if PyIsPhantom(nm) then Exit;
  if PyPhantomCount >= PY_MAX_LOCALS then Exit;   { silently stop: a phantom is
    an aid, never a requirement — running out costs the old "undefined
    variable", not a wrong answer }
  PyPhantomNames[PyPhantomCount] := nm;
  Inc(PyPhantomCount);
end;

function PyHasUnkBinding(const nm: AnsiString): Boolean;
var i: Integer;
begin
  PyHasUnkBinding := False;
  for i := 0 to PyUnkBindCount - 1 do
    if PyUnkBindNames[i] = nm then begin PyHasUnkBinding := True; Exit; end;
end;

procedure PyNoteUnkBinding(const nm: AnsiString);
{ Same silent-stop discipline as PyNotePhantom: running out costs the widening,
  never a wrong answer, because this table is only ever read to make a name MORE
  general than the shapes the arm managed to read. }
begin
  if PyHasUnkBinding(nm) then Exit;
  if PyUnkBindCount >= PY_MAX_LOCALS then Exit;
  PyUnkBindNames[PyUnkBindCount] := nm;
  Inc(PyUnkBindCount);
end;

function PyTopTarget(const nm: AnsiString): Boolean;
var i: Integer;
begin
  PyTopTarget := False;
  for i := 0 to PyTopTargetCount - 1 do
    if PyTopTargets[i] = nm then begin PyTopTarget := True; Exit; end;
end;

procedure PyCollectTopTargets;
{ One linear pass over the module's tokens, collecting every name that is bound
  at DEPTH 0 — the shapes the depth-0 arms of PyCollectModuleLocalsAST already
  handle (a bare or annotated assignment, an augmented assignment, a tuple
  target list, a `for` target). Those names get their type from the depth-0
  arm's own trial parse, so a phantom for them would swallow real information;
  everything else is fair game.

  Deliberately OVER-inclusive — it takes any statement-initial identifier
  followed by `=`/`:`/`,`/an augmented operator, without checking the shape
  closes. A false positive only means "no phantom for that name", i.e. exactly
  the behaviour that shipped before phantoms existed, which is the safe
  direction. One O(n) pass, run once per collect: the quadratic trap the
  `def`/`class` skip note warns about is why this is not a per-name scan. }
var k, d, m, forCnt, forIn: Integer;
    atStart, isFor: Boolean;

  procedure NoteTop(const nm: AnsiString);
  begin
    if PyTopTargetCount >= PY_MAX_LOCALS then Exit;
    if PyTopTarget(nm) then Exit;
    PyTopTargets[PyTopTargetCount] := nm;
    Inc(PyTopTargetCount);
  end;

begin
  PyTopTargetCount := 0;
  d := 0;
  k := PyScanLo;
  while k < MainProgramTokCount do
  begin
    if Tokens[k].Kind = tkIndent then Inc(d)
    else if Tokens[k].Kind = tkDedent then Dec(d)
    else if d = 0 then
    begin
      atStart := (k = PyScanLo) or
                 (Tokens[k - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]);
      if atStart then
      begin
        if (Tokens[k].Kind = tkIdent) and (k + 1 < MainProgramTokCount) and
           (Tokens[k + 1].Kind in [tkAssign, tkColon, tkComma, tkTrueDivEq, tkPowEq,
                                   tkPlusEq, tkMinusEq, tkStarEq, tkShlEq]) then
          NoteTop(GetTokenStr(k));
        isFor := (Tokens[k].Kind = tkFor) or
                 ((Tokens[k].Kind = tkIdent) and CaseEqual(GetTokenStr(k), 'for'));
        if isFor and (k + 1 < MainProgramTokCount) and
           (Tokens[k + 1].Kind = tkIdent) and PyForTargetRun(k + 1, forCnt, forIn) then
        begin
          for m := k + 1 to forIn - 1 do
            if Tokens[m].Kind = tkIdent then NoteTop(GetTokenStr(m));
          k := forIn;
        end;
      end;
    end;
    Inc(k);
  end;
end;

function PyModuleGlobalCtorClass(const name: AnsiString): Integer;
{ `G = K()` at MODULE level — the class index of K, or -1.

  The twin of PyModuleGlobalLiteralType, and separate from it because the
  answer is not a TTypeKind: a class field needs its class IDENTITY as well as
  its kind, and that is the whole reason recognising this shape "was easy and
  the result was WRONG" the first time. Reporting bare `tyClass` left `fldRec`
  at REC_NONE, so `self.k = G` then `C().k.z` read at the wrong layout and
  printed 5887615 where CPython says 9. The store was never the problem — an
  explicitly annotated `self.k: K = G` has always worked, which is the control
  that isolates it — the field simply did not know WHICH class it held.

  So this returns the ci, and the call site sets fldRec from it exactly as the
  PyInferExprType arm above already does for a construction written inline.
  bug-nilpy-a-field-assigned-from-a-class-instance-global-reads-garbage }
var k, d: Integer;
    atStart: Boolean;
begin
  Result := -1;
  d := 0;
  k := PyScanLo;
  while k < MainProgramTokCount do
  begin
    if Tokens[k].Kind = tkIndent then Inc(d)
    else if Tokens[k].Kind = tkDedent then Dec(d)
    else if d = 0 then
    begin
      atStart := (k = PyScanLo) or
                 (Tokens[k - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]);
      if atStart and (Tokens[k].Kind = tkIdent) and
         (k + 3 < MainProgramTokCount) and (Tokens[k + 1].Kind = tkAssign) and
         (GetTokenStr(k) = name) and (Tokens[k + 2].Kind = tkIdent) and
         (Tokens[k + 3].Kind = tkLParen) then
      begin
        { the WHOLE right-hand side must be the construction — `G = K().wrap()`
          holds whatever wrap returns, which is the lesson the literal shapes
          next door record. A CALL needs PyBlkRhsEndsAfterCall, not
          PyBlkRhsEndsAt: the latter asks whether ONE token ends the statement,
          which `K()` never does, so it silently declined every instance. }
        if PyBlkRhsEndsAfterCall(k + 3) then
          Result := FindUClassNonRecord(GetTokenStr(k + 2));
        Exit;
      end;
    end;
    Inc(k);
  end;
end;

function PyModuleGlobalLiteralType(const name: AnsiString): TTypeKind;
{ What type does the module-level LITERAL global `name` hold — `NEW = "NEW"`,
  `LIMIT = 7`? Answers tyUnknown for anything it cannot read straight off the
  tokens.

  Why a per-name scan instead of a pre-pass that types every global once:
  PyLocals is the one table for inferred types, and it is shared with DEF-local
  inference. Seeding module globals into it before the class-field pre-pass —
  the obvious implementation, and the first one tried — made a def-local loop
  target inherit the type of a same-named module global: `i = "not an int"` at
  module level, `for i in range(n): t = t + i` in a method, and the method
  stopped compiling ("invalid IR node reference in store_sym"). That collision
  is exactly what `test_nilpy_loop_target_in_a_def_is_local.npy` exists to
  catch, and it caught it. So this asks about ONE name, on demand, and stores
  nothing.

  Only shapes whose type is visible in the tokens, and whose literal is the
  WHOLE right-hand side (PyBlkRhsEndsAt — the lesson of
  `wrapped = "a-b".split("-")` typing as a string). Called once per field the
  other scanners could not type at all, which is rare; the linear scan is not
  on any hot path.

  Deliberately NOT a constructor call, `G = K()` — that shape has its own
  routine, PyModuleGlobalCtorClass, because its answer is a class INDEX and not
  a TTypeKind. Returning bare `tyClass` from here is what made the first attempt
  print 5887615 for `C().k.z` where CPython says 9: the kind was right and the
  field had no idea WHICH class it held, so it read at the wrong layout. Fixed
  by carrying the identity, not by changing the store — an annotated
  `self.k: K = G` always worked, which is the control that proves it.
  bug-nilpy-a-field-assigned-from-a-class-instance-global-reads-garbage. }
var k, d, rhs: Integer;
    atStart: Boolean;
begin
  Result := tyUnknown;
  d := 0;
  k := PyScanLo;
  while k < MainProgramTokCount do
  begin
    if Tokens[k].Kind = tkIndent then Inc(d)
    else if Tokens[k].Kind = tkDedent then Dec(d)
    else if d = 0 then
    begin
      atStart := (k = PyScanLo) or
                 (Tokens[k - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]);
      if atStart and (Tokens[k].Kind = tkIdent) and
         (k + 2 < MainProgramTokCount) and (Tokens[k + 1].Kind = tkAssign) and
         (GetTokenStr(k) = name) then
      begin
        rhs := k + 2;
        if (Tokens[rhs].Kind = tkString) and PyBlkRhsEndsAt(rhs) then
          { AnsiString, not the tyString PyTypeFromTokenIndex answers for a
            literal: this is a NAME holding a string, and that is what the
            depth-0 arm of PyCollectModuleLocalsAST records for it too. }
          Result := tyAnsiString
        else if (Tokens[rhs].Kind = tkInteger) and PyBlkRhsEndsAt(rhs) then
          Result := tyInt64
        else if (Tokens[rhs].Kind = tkFloat) and PyBlkRhsEndsAt(rhs) then
          Result := tyDouble
        else if (Tokens[rhs].Kind in [tkTrue, tkFalse]) and PyBlkRhsEndsAt(rhs) then
          Result := tyBoolean
        else if (Tokens[rhs].Kind in [tkLBrack, tkBegin]) and
                PyBlkRhsEndsAfterGroup(rhs) then
          { a list or dict literal — variant, exactly as the depth>0 arm of
            PyCollectModuleLocalsAST types the same shape }
          Result := tyVariant
        else
          { the name IS bound here and this binding is unreadable: a LATER
            rebinding cannot make it more certain, so stop rather than let a
            second assignment of the same name answer for the first }
          Result := tyUnknown;
      end;
    end;
    Inc(k);
  end;
end;

procedure PyCollectModuleLocalsAST;
var rnd, i, si, depth, bodyIx, forJ, forCi: Integer;
    newCi, oldCi: Integer;
    savedTok, savedAST, savedSC, savedCur, savedFS, savedBSS: Integer;
    changed, savedExprMode: Boolean;
    tk, w, forElemTk: TTypeKind;
    nm, forName: AnsiString;
    blockIsDef: array[0..255] of Boolean;   { blockIsDef[d] = body at depth d is a def/class, not if/for/while/with/try }
    pendingDefClass: Boolean;
    blkJ: Integer; blkTk: TTypeKind; blkName: AnsiString;
    blkRec: Integer;   { class rec for a `name = Cls(...)` inside a block }
    tupEnd: Integer;   { the '=' of a tuple-unpack target list }
    forCnt, forIn: Integer;   { a for target list: name count, and the `in` }
    blkSrcVar: Boolean;   { an augmented assign whose SOURCE is a variant }
begin
  PyLocalCount := 0;
  PyCollectTopTargets;   { the phantom guard — see PyPhantomNames }
  rnd := 0;
  repeat
    changed := False;
    PyTypingChanged := False;
    PyUnkBindCount := 0;   { per-ROUND, like the phantoms below: the arm that
      fills it re-runs every round }
    PyPhantomCount := 0;   { phantoms are per-ROUND: their symbols die with the
      scratch scope below, and the block statement that creates each one is
      re-scanned before any statement that reads it }
    savedTok := TokPos;
    savedAST := ASTNodeCount;
    savedCur := CurASTNode;
    savedSC := SymCount;
    savedFS := FrameSize;
    savedBSS := BSSSize;
    for i := 0 to PyLocalCount - 1 do
      if PyAssignTargetSym(PyLocals[i].Name) < 0 then
      begin
        si := AllocVar(PyLocals[i].Name, PyLocals[i].TypeKind);
        if (PyLocals[i].TypeKind = tyClass) and (PyLocals[i].RecCi >= 0) then
        begin
          Syms[si].RecName := REC_UCLASS_BASE + PyLocals[i].RecCi;
          SymSyncTypeRef(si);
        end;
      end;
    PyTypingPass := True;
    { The real parser turns PyExprMode on only AFTER this pre-pass, but a
      trial parse needs it: without it `a and b` / `not x` take Pascal's
      precedence and `print(2 > 1 and 3 > 2)` fails to close its paren. }
    savedExprMode := PyExprMode;
    PyExprMode := True;
    i := savedTok - 1;
    depth := 0;
    pendingDefClass := False;
    blockIsDef[0] := False;
    while i < MainProgramTokCount do
    begin
      { Track, for the block about to be entered, whether its HEADER was
        `def`/`class` (a real new scope: names bound inside are NOT module
        globals) versus `if`/`for`/`while`/`with`/`try`/… (control flow only:
        Python has no block scope, so a name bound inside IS the same module
        global a statement after the block reads). Reset at every statement
        BOUNDARY so it reflects the line about to end, then pushed the
        moment its INDENT actually arrives — a one-line-ahead flag, not a
        parse of anything. }
      { The layout tokens are NOT statement starts, and must not recompute the
        flag: a body's tkIndent is itself preceded by tkNewline, so it passed
        the boundary test below and reset pendingDefClass to False (an INDENT is
        not tkFunction) in the SAME iteration that the indent branch then read
        it. blockIsDef was therefore False for EVERY block, def bodies included,
        and a def-local assignment was harvested as a module global — widening

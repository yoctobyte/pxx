    keyN := AllocVar(PyHiddenName('i'), tyInt64);
    node := AllocNode(AN_ASSIGN);              { x = __py_i (boxes the int) }
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := PyMakeIdent(keyN);
    incNode := PySeqAppend(-1, node);
    bodyNode := PySeqAppend(incNode, bodyNode);
    symIdx := keyN;
  end;

  if rngStep >= 0 then
  begin
    { An explicit step -> a while-loop desugar (general, handles a negative
      step): `i = start; while i </> stop: body; i = i + step`. The direction
      of the guard depends on the step's SIGN, known for a literal step (every
      censused use, e.g. range(n-1, -1, -1)); a non-literal step assumes
      ascending. }
    node := AllocNode(AN_ASSIGN);                { i = start }
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := startNode;
    Result := PySeqAppend(-1, node);

    { The guard's direction follows the step's SIGN. For a literal step that is
      known here, and the single-comparison lowering below is kept for it —
      `range(n-1, -1, -1)` is the overwhelmingly common shape and pays nothing.

      For a step only known at RUN time it was not known, and the code assumed
      ascending: `range(a, b, s)` with a negative `s` terminated immediately and
      yielded an empty range, silently
      (bug-nilpy-range-negative-runtime-step-yields-empty). }
    stepKnown := (ASTKind[rngStep] = AN_NEG) or
                 ((ASTKind[rngStep] = AN_INT_LIT) and (ASTIVal[rngStep] <> 0));
    if stepKnown then
    begin
      cmpNode := AllocNode(AN_BINOP);              { i < stop  or  i > stop }
      { a negative step (`-1` is AN_NEG over a literal; a bare negative literal is
        AN_INT_LIT<0) counts DOWN, so the guard flips to `>` }
      if (ASTKind[rngStep] = AN_NEG) or
         ((ASTKind[rngStep] = AN_INT_LIT) and (ASTIVal[rngStep] < 0)) then
        ASTIVal[cmpNode] := Ord(tkGt)
      else
        ASTIVal[cmpNode] := Ord(tkLt);
      ASTLeft[cmpNode] := PyMakeIdent(symIdx);
      ASTRight[cmpNode] := stopNode;
      ASTTk[cmpNode] := Ord(tyBoolean);
    end
    else
    begin
      { Runtime step: bind the step AND the stop to hidden temps, then test the
        direction at run time — `(step < 0) ? (i > stop) : (i < stop)`.

        Both need a temp because each is now read twice (the step by the
        direction test and the increment, the stop by the two ternary arms), and
        re-reading an expression with side effects would run it again. Binding
        them ALSO evaluates each exactly once for the whole loop, which is what
        CPython does with range()'s arguments — the previous lowering re-ran the
        stop expression on every iteration. }
      rngStepSym := AllocVar(PyHiddenName('step'), tyInt64);
      rngStopSym := AllocVar(PyHiddenName('stop'), tyInt64);
      node := AllocNode(AN_ASSIGN);
      ASTLeft[node] := PyMakeIdent(rngStepSym);
      ASTRight[node] := rngStep;
      Result := PySeqAppend(Result, node);
      node := AllocNode(AN_ASSIGN);
      ASTLeft[node] := PyMakeIdent(rngStopSym);
      ASTRight[node] := stopNode;
      Result := PySeqAppend(Result, node);
      { a zero step never advances, so the loop would hang; Python raises }
      rngChkPi := FindProc('pyrange_check_step');
      if rngChkPi >= 0 then
      begin
        rngChkArg := AllocNode(AN_ARG);
        ASTLeft[rngChkArg] := PyMakeIdent(rngStepSym);
        ASTRight[rngChkArg] := -1;
        node := AllocNode(AN_CALL);
        ASTIVal[node] := rngChkPi;
        ASTTk[node] := Ord(tyUnknown);
        ASTLeft[node] := rngChkArg;
        Result := PySeqAppend(Result, node);
      end;
      rngDown := AllocNode(AN_BINOP);              { step < 0 }
      ASTIVal[rngDown] := Ord(tkLt);
      ASTLeft[rngDown] := PyMakeIdent(rngStepSym);
      rngZero := AllocNode(AN_INT_LIT);
      ASTIVal[rngZero] := 0;
      ASTTk[rngZero] := Ord(tyInteger);
      ASTRight[rngDown] := rngZero;
      ASTTk[rngDown] := Ord(tyBoolean);
      rngGt := AllocNode(AN_BINOP);                { i > stop }
      ASTIVal[rngGt] := Ord(tkGt);
      ASTLeft[rngGt] := PyMakeIdent(symIdx);
      ASTRight[rngGt] := PyMakeIdent(rngStopSym);
      ASTTk[rngGt] := Ord(tyBoolean);
      rngLt := AllocNode(AN_BINOP);                { i < stop }
      ASTIVal[rngLt] := Ord(tkLt);
      ASTLeft[rngLt] := PyMakeIdent(symIdx);
      ASTRight[rngLt] := PyMakeIdent(rngStopSym);
      ASTTk[rngLt] := Ord(tyBoolean);
      rngPair := AllocNode(AN_PAIR);
      ASTLeft[rngPair] := rngGt;
      ASTRight[rngPair] := rngLt;
      cmpNode := AllocNode(AN_TERNARY);
      ASTLeft[cmpNode] := rngDown;
      ASTRight[cmpNode] := rngPair;
      ASTTk[cmpNode] := Ord(tyBoolean);
      rngStep := PyMakeIdent(rngStepSym);          { the increment reads the temp }
    end;

    incNode := AllocNode(AN_BINOP);              { i + step }
    ASTIVal[incNode] := Ord(tkPlus);
    ASTLeft[incNode] := PyMakeIdent(symIdx);
    ASTRight[incNode] := rngStep;
    ASTTk[incNode] := Ord(tyInteger);
    node := AllocNode(AN_ASSIGN);                { i = i + step }
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := incNode;
    { append the increment as the last statement of the body. The parsed block
      is already an AN_SEQ chain; a comprehension body is a single node that
      must be wrapped into a chain first, or PySeqAppend walks a non-sequence. }
    if ASTKind[bodyNode] <> AN_SEQ then bodyNode := PySeqAppend(-1, bodyNode);
    bodyNode := PySeqAppend(bodyNode, node);
    { ...and the user's variable is assigned from the hidden counter FIRST, so it
      only ever holds a value the loop actually yielded — see the note where the
      counter is allocated. Prepended rather than appended: the body reads it. }
    if userSym >= 0 then bodyNode := PyPrependLoopVarCopy(bodyNode, userSym, symIdx);

    whileNode := AllocNode(AN_WHILE);
    ASTLeft[whileNode] := cmpNode;
    ASTRight[whileNode] := bodyNode;
    Result := PySeqAppend(Result, whileNode);
    if hoistPre >= 0 then Result := PySeqAppend(hoistPre, Result);
    PyStmtAteBlock := True;
    Exit;
  end;

  { tyInt64, not tyInteger — the LIMIT is the third 64-bit cell this lowering
    needs, beside the visible counter and the variant path's hidden one, and it
    was the one left 32-bit. `stop - 1` computed in a 4-byte cell wraps for any
    stop at or past 2^31: `range(0, 3000000000)` got a limit of -1294967297, so
    the AN_FOR guard failed on the first test and the loop ran ZERO times —
    the mirror image of the never-terminates bug the counter's own note
    describes, and just as silent. `list(range(...))` stayed correct throughout,
    which is again what pins it to the counted-loop lowering.
    bug-nilpy-for-range-limit-is-32-bit-and-yields-an-empty-loop }
  oneNode := AllocNode(AN_INT_LIT);
  ASTIVal[oneNode] := 1;
  ASTTk[oneNode] := Ord(tyInt64);
  limitNode := AllocNode(AN_BINOP);
  ASTIVal[limitNode] := Ord(tkMinus);
  ASTLeft[limitNode] := stopNode;
  ASTRight[limitNode] := oneNode;
  ASTTk[limitNode] := Ord(tyInt64);
  lhsNode := PyMakeIdent(symIdx);
  pair1 := AllocNode(AN_PAIR);
  ASTLeft[pair1] := startNode;
  ASTRight[pair1] := limitNode;
  stepNode := AllocNode(AN_INT_LIT);
  ASTIVal[stepNode] := 0;
  ASTTk[stepNode] := Ord(tyInteger);
  { The no-explicit-step shape is a Pascal AN_FOR over `start..stop-1`, and it
    needs the same copy the stepped shape above gets: the AN_FOR counter is left
    one past the limit on normal exit and is initialised whether or not the body
    runs. This is the arm `for i in range(3)` takes — the commonest form of all —
    so it was the one producing `i = 3` and the empty-range clobber. }
  if userSym >= 0 then bodyNode := PyPrependLoopVarCopy(bodyNode, userSym, symIdx);
  pair2 := AllocNode(AN_PAIR);
  ASTLeft[pair2] := stepNode;
  ASTRight[pair2] := bodyNode;
  pair3 := AllocNode(AN_PAIR);
  ASTLeft[pair3] := pair1;
  ASTRight[pair3] := pair2;
  node := AllocNode(AN_FOR);
  ASTLeft[node] := lhsNode;
  ASTRight[node] := pair3;
  if hoistPre >= 0 then
  begin
    PyStmtAteBlock := True;
    node := PySeqAppend(hoistPre, node);
  end;
  Result := node;
end;

{ Map an augmented-assignment token to its binary operator, tkEOF if none. }
{ `base ** exp` lowered. Factored out of ParseFactor's `**` case so the
  AUGMENTED spelling `p **= e` produces the IDENTICAL node — including the
  dunder dispatch, which a second hand-built pypow_v call would have silently
  dropped (bug-nilpy-chained-assign-power-assign-and-semicolon-statements).

  `obj ** n` on a user class dispatches its __pow__; without it the base went to
  pypow_v as a boxed handle and raised "expected a number, got object" where
  CPython returned the method's result. Reflected `__rpow__` (`3 ** C(4)`) is
  tried FIRST, and only when the BASE is not itself a user class, so a class
  base keeps left-operand priority. pylib's own rows are excluded so
  container/scalar powers keep today's behaviour. }
{ Is this node a compile-time constant whose value is a whole number? `2`,
  `2.0`, `-3` are; `1/3` and any variable are not. Drives the one decision the
  float `**` path cannot defer: an integral exponent is real for every base. }
function PyNodeIsIntegralConst(n: Integer): Boolean;
var d: Double;
begin
  Result := False;
  if n < 0 then Exit;
  if ASTKind[n] = AN_NEG then begin Result := PyNodeIsIntegralConst(ASTLeft[n]); Exit; end;
  if ASTKind[n] = AN_FLOAT_LIT then
  begin
    d := ExDecBitsToDouble(ASTIVal[n]);
    Result := d = Int(d);
    Exit;
  end;
  Result := (ASTKind[n] = AN_INT_LIT) and TypeIsOrdinal(IntToTypeKind(ASTTk[n]));
end;

function PyMakePow(ppBase, ppExp: Integer): Integer;
var ppPi, ppArgSeq, ppArgSeq2, node: Integer;
    ppDomPi, ppDomArg, ppDomArg2, ppDomCall, ppBaseVal: Integer;
    ppRngPi, ppRngArg, ppRngArg2, ppRngArg3, ppRngCall: Integer;
begin
  { `z ** w`, `2j ** 2`, `2 ** 1j` — either operand complex. First, because
    complex is a pylib class and every dunder arm below excludes those. }
  if PyExprMode and (PyNodeIsComplex(ppBase) or PyNodeIsComplex(ppExp)) then
  begin
    ppPi := FindProc('pycomplex_pow');
    if ppPi >= 0 then
    begin
      ppArgSeq := AllocNode(AN_ARG);
      ASTLeft[ppArgSeq] := PyComplexCoerce(ppBase);
      ppArgSeq2 := AllocNode(AN_ARG);
      ASTLeft[ppArgSeq2] := PyComplexCoerce(ppExp);
      ASTRight[ppArgSeq] := ppArgSeq2;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := ppPi;
      ASTTk[node] := Ord(tyClass);
      ASTRight[node] := ProcRetRecId[ppPi];
      ASTLeft[node] := ppArgSeq;
      PyMakePow := node;
      Exit;
    end;
  end;
  if PyExprMode and (IntToTypeKind(ASTTk[ppBase]) <> tyClass) then
  begin
    node := PyReflectedDunder('__rpow__', ppBase, ppExp);
    if node >= 0 then begin PyMakePow := node; Exit; end;
  end;
  if PyExprMode and (IntToTypeKind(ASTTk[ppBase]) = tyClass) and
     (ResolveNodeRec(ppBase) >= REC_UCLASS_BASE) and
     not PyRecIsPylibOwnClass(ResolveNodeRec(ppBase)) and
     (FindUMeth(ResolveNodeRec(ppBase) - REC_UCLASS_BASE, '__pow__') >= 0) then
  begin
    node := PyCallMeth1(ResolveNodeRec(ppBase) - REC_UCLASS_BASE,
                        '__pow__', ppBase, ppExp);
    if node >= 0 then begin PyMakePow := node; Exit; end;
  end;
  { A FLOAT power goes to the RTL's `Power`, which is what `math.pow` already
    resolves to and is measured bit-exact against CPython. pylib's own
    `pypow_v` carries a hand-rolled series ln/exp — good to a few ulp over most
    of the domain and 1282 ulp out at `1.0001 ** 10000`, i.e. wrong in the 12th
    significant digit of the ordinary compound-interest shape, and NilPy's float
    repr prints full precision so a user sees it.

    Not a second implementation, the OPPOSITE: `math.pow(x, y)` and `x ** y`
    were two answers to one question, and this makes the float case one.
    FindProcArityDouble for the same reason math.pow needs it — `Power(Integer,
    Integer)` is declared first and would give the truncating integer power.

    Only when an operand is STATICALLY float. An int ** int must stay CPython's
    exact integer power (pypow_v's own path), and a VARIANT receiver has to
    dispatch at run time — pylib cannot reach `Power` from a builtin unit, which
    is the wall this route goes around rather than through. Measured while
    trying to go through it: adding `uses math` to pylib compiles, and then the
    RTL's `Abs` overload set hides pylib's, so `abs(2.5)` fails to resolve with
    only `abs(LongInt)` offered. That is a real overload-merge question and it
    is not this ticket's.
    bug-a-nilpy-star-star-has-its-own-low-precision-pow }
  { A float power whose exponent is not a known integer cannot be TYPED here:
    CPython answers a float for a non-negative base and a COMPLEX for a negative
    one, and which it is depends on the VALUES. So it becomes one variant-
    returning call, and the decision moves to run time where it belongs.

    Gated on the exponent, not on the base, and that is the whole point of the
    gate: an integral exponent is real for every base (`x ** 2`), so the common
    shape keeps its Double typing, its direct RTL `Power` call and its static
    overflow guard. Only the genuinely value-dependent case widens.
    bug-nilpy-no-complex-number-type }
  if PyExprMode and
     (TypeIsFloat(IntToTypeKind(ASTTk[ppBase])) or
      TypeIsFloat(IntToTypeKind(ASTTk[ppExp]))) and
     not PyNodeIsIntegralConst(ppExp) then
  begin
    ppPi := FindProc('pypow_cx');
    if ppPi >= 0 then
    begin
      ppArgSeq := AllocNode(AN_ARG); ASTLeft[ppArgSeq] := ppBase;
      ppArgSeq2 := AllocNode(AN_ARG); ASTLeft[ppArgSeq2] := ppExp;
      ASTRight[ppArgSeq] := ppArgSeq2;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := ppPi;
      ASTTk[node] := Ord(tyVariant);
      ASTLeft[node] := ppArgSeq;
      PyMakePow := node;
      Exit;
    end;
  end;
  if PyExprMode and
     (TypeIsFloat(IntToTypeKind(ASTTk[ppBase])) or
      TypeIsFloat(IntToTypeKind(ASTTk[ppExp]))) then
  begin
    ppPi := FindProcArityDouble('Power', 2);
    ppDomPi := FindProc('pypow_dom');
    if (ppPi >= 0) and (ppDomPi >= 0) then
    begin
      { The base goes through `pypow_dom` first — a negative base with a
        fractional exponent is a COMPLEX number in CPython, and NilPy's named
        refusal for it has to survive the move off pypow_v. Without it the RTL's
        Power answers NaN, which is a silent wrong value where there used to be
        a sentence. Same argument-wrapping shape math.sqrt/log/pow already use. }
      { The exponent reaches BOTH the guard and Power itself, so it is parked
        in a temp first: the AST is a tree, and a node referenced twice is
        EMITTED twice — `1.5 ** f()` called f() twice and CPython calls it
        once. math.pow's site two thousand lines up already does this and its
        comment says why; this arm was written from that one and did not copy
        the line. Cloning does not help — a clone is a second subtree, so it is
        a second call.
        bug-nilpy-the-float-power-operator-evaluates-its-exponent-twice }
      ppExp := PyEvalOnce(ppExp);
      ppBase := PyEvalOnce(ppBase);
      ppBaseVal := ppBase;
      ppDomArg2 := AllocNode(AN_ARG);
      ASTLeft[ppDomArg2] := CloneAST(ppExp); ASTRight[ppDomArg2] := -1;
      ppDomArg := AllocNode(AN_ARG);
      ASTLeft[ppDomArg] := ppBase; ASTRight[ppDomArg] := ppDomArg2;
      ppDomCall := AllocNode(AN_CALL);
      ASTIVal[ppDomCall] := ppDomPi;
      ASTTk[ppDomCall] := Ord(tyDouble);
      ASTLeft[ppDomCall] := ppDomArg;
      ppBase := ppDomCall;
      ppArgSeq := AllocNode(AN_ARG); ASTLeft[ppArgSeq] := ppBase;
      ppArgSeq2 := AllocNode(AN_ARG); ASTLeft[ppArgSeq2] := ppExp; ASTRight[ppArgSeq2] := -1;
      ASTRight[ppArgSeq] := ppArgSeq2;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := ppPi;
      ASTLeft[node] := ppArgSeq;
      ASTTk[node] := Ord(tyDouble);
      { OVERFLOW: `2.0 ** 10000` is an OverflowError in CPython, not `inf`.
        On the RESULT, with both operands along, because an infinite INPUT is
        not an overflow (`float('inf') ** 2` is inf on both sides) and because
        `1e300 * 1e300` — an operator, not a call — really is inf in CPython
        too. Both operands are already temps by now, so naming them again is
        free. bug-nilpy-float-overflow-answers-inf-where-cpython-raises }
      ppRngPi := FindProc('pypow_range');
      if ppRngPi >= 0 then
      begin
        ppRngArg3 := AllocNode(AN_ARG);
        ASTLeft[ppRngArg3] := CloneAST(ppExp); ASTRight[ppRngArg3] := -1;
        ppRngArg2 := AllocNode(AN_ARG);
        ASTLeft[ppRngArg2] := CloneAST(ppBaseVal); ASTRight[ppRngArg2] := ppRngArg3;
        ppRngArg := AllocNode(AN_ARG);
        ASTLeft[ppRngArg] := node; ASTRight[ppRngArg] := ppRngArg2;
        ppRngCall := AllocNode(AN_CALL);
        ASTIVal[ppRngCall] := ppRngPi;
        ASTTk[ppRngCall] := Ord(tyDouble);
        ASTLeft[ppRngCall] := ppRngArg;
        node := ppRngCall;
      end;
      LastExprTk := tyDouble;
      PyMakePow := node;
      Exit;
    end;
  end;
  ppPi := FindProc('pypow_v');
  if ppPi < 0 then Error('Nil Python: pylib (pypow_v) not loaded');
  ppArgSeq := AllocNode(AN_ARG); ASTLeft[ppArgSeq] := ppBase;
  ppArgSeq2 := AllocNode(AN_ARG); ASTLeft[ppArgSeq2] := ppExp; ASTRight[ppArgSeq2] := -1;
  ASTRight[ppArgSeq] := ppArgSeq2;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := ppPi;
  ASTLeft[node] := ppArgSeq;
  ASTTk[node] := Ord(Procs[ppPi].RetType);
  PyMakePow := node;
end;

{ `x *= n` where x is a SEQUENCE: the REPEAT node, not an arithmetic multiply.

  `xs *= 2` on a list and `s *= 2` on a str both produced an EMPTY value —
  silently — because the three augmented-assignment sites build an AN_BINOP
  with the token PyAugBinTok gives, while `x = x * n` is decided by three
  special arms in ParseTerm (list repeat, bytes repeat, and the str tag) that
  none of them consult. One operation, two spellings, different answers: the
  same tell as the `|=`-on-a-set case two hundred lines down, which was found
  the same way.

  Answers -1 for a pair that really is arithmetic, so every other `*=` keeps
  its path.

  DIVERGENCE, recorded rather than hidden: CPython's list `*=` mutates in
  place, so an alias taken beforehand sees the repeat; this rebinds. `+=`
  already has the in-place form (TPyList.extend) and `*=` has no in-place
  primitive to call yet — bug-nilpy-augmented-sequence-repeat-rebinds-instead-
  of-mutating. An empty list was the strictly worse answer.
  bug-nilpy-augmented-multiply-on-a-sequence-yields-empty }
function PyAugMulNode(left, right: Integer): Integer;
var node, ipPi, ipA, ipB: Integer;
begin
  Result := -1;
  PyAugMulInPlace := False;
  if (left < 0) or (right < 0) then Exit;
  if PyListRepeatPair(left, right) then
  begin
    { IN PLACE — this is the augmented form, and Python mutates the list rather
      than binding a fresh one, so an alias taken beforehand sees the new
      contents. `+=` has always mutated (TPyList.extend); building a fresh list
      here made the two augmented sequence operators disagree, silently and
      only through an alias.
      bug-nilpy-augmented-sequence-repeat-rebinds-instead-of-mutating }
    ipPi := FindProc('pylist_repeat_inplace');
    if PyNodeIsPyList(left) and (ipPi >= 0) then
    begin
      ipA := AllocNode(AN_ARG); ASTLeft[ipA] := left;
      ipB := AllocNode(AN_ARG); ASTLeft[ipB] := right; ASTRight[ipB] := -1;
      ASTRight[ipA] := ipB;
      Result := AllocNode(AN_CALL);
      ASTIVal[Result] := ipPi;
      ASTTk[Result] := Ord(tyClass);
      ASTLeft[Result] := ipA;
      { the caller must NOT wrap this in an assignment: the call mutates the
        object the target already holds, and storing the same handle back
        through a FIELD target released the list before the append ran —
        `h.xs *= 2` came out EMPTY while the identical local did not. The
        mutation IS the statement. }
      PyAugMulInPlace := True;
      Exit;
    end;
    Result := PyMakeListRepeat(left, right);
    Exit;
  end;
  if PyBytesRepeatPair(left, right) then
  begin
    Result := PyMakeBytesRepeat(left, right);
    Exit;
  end;
  { a VARIANT target — an unannotated parameter, a dict value, a list element.
    Nothing here can tell a list from an int, so the decision moves to run time:
    pymul_v_inplace repeats a mutable list in place and answers the same handle,
    and is the ordinary pymul_v for everything else. The store around it STAYS
    (unlike the statically-typed arm above): when the fallback runs, the product
    is a new value the target must receive. }
  if (IntToTypeKind(ASTTk[left]) = tyVariant) and
     PyIsRepeatCountTk(IntToTypeKind(ASTTk[right])) then
  begin
    ipPi := FindProc('pymul_v_inplace');
    if ipPi >= 0 then
    begin
      ipA := AllocNode(AN_ARG); ASTLeft[ipA] := left;
      ipB := AllocNode(AN_ARG); ASTLeft[ipB] := PyForceVariant(right);
      ASTRight[ipB] := -1;
      ASTRight[ipA] := ipB;
      Result := AllocNode(AN_CALL);
      ASTIVal[Result] := ipPi;
      ASTTk[Result] := Ord(tyVariant);
      ASTLeft[Result] := ipA;
      Exit;
    end;
  end;
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[left])) and
     (not PyIsStrBaseTk(IntToTypeKind(ASTTk[right]))) then
  begin
    node := AllocNode(AN_BINOP);
    ASTIVal[node] := Ord(tkStar);
    ASTLeft[node] := left;
    ASTRight[node] := right;
    ASTTk[node] := Ord(tyAnsiString);
    Result := node;
  end;
end;

function PyAugBinTok(k: TTokenKind): TTokenKind;
begin
  case k of
    tkPlusEq:  Result := tkPlus;
    tkMinusEq: Result := tkMinus;
    tkStarEq:  Result := tkStar;
    tkSlashEq: Result := tkDiv;   { //= — integer division, like // }
    tkTrueDivEq: Result := tkSlash;   { /= — true division, like / }
    tkModEq:   Result := tkMod;
    tkAmpEq:   Result := tkAnd;
    tkPipeEq:  Result := tkOr;
    tkXorEq:   Result := tkXor;
    tkShlEq:   Result := tkShl;
    tkShrEq:   Result := tkShr;
    tkAtEq:    Result := tkAt;    { @= — in-place matrix multiply }
    else Result := tkEOF;
  end;
end;

function PyAugDunderName(binTk: TTokenKind; inPlace: Boolean): AnsiString;
{ The dunder an augmented assignment asks for. Python tries the IN-PLACE form
  first (`__iadd__`) and falls back to the binary one (`__add__`), rebinding the
  name with its result. Keyed on the BINARY token PyAugBinTok already produced,
  so NilPy's `//=`-is-tkDiv / `/=`-is-tkSlash split (which is the reverse of
  Pascal's reading — see project_shared_token_means_different_operators_per_
  frontend) is honoured in one place rather than re-derived here. }
begin
  case binTk of
    tkPlus:  if inPlace then Result := '__iadd__'      else Result := '__add__';
    tkMinus: if inPlace then Result := '__isub__'      else Result := '__sub__';
    tkStar:  if inPlace then Result := '__imul__'      else Result := '__mul__';
    tkSlash: if inPlace then Result := '__itruediv__'  else Result := '__truediv__';
    tkDiv:   if inPlace then Result := '__ifloordiv__' else Result := '__floordiv__';
    tkMod:   if inPlace then Result := '__imod__'      else Result := '__mod__';
    tkAnd:   if inPlace then Result := '__iand__'      else Result := '__and__';
    tkOr:    if inPlace then Result := '__ior__'       else Result := '__or__';
    tkXor:   if inPlace then Result := '__ixor__'      else Result := '__xor__';
    tkShl:   if inPlace then Result := '__ilshift__'   else Result := '__lshift__';
    tkShr:   if inPlace then Result := '__irshift__'   else Result := '__rshift__';
    tkAt:    if inPlace then Result := '__imatmul__'   else Result := '__matmul__';
    { `**` has no binary token in this frontend — it lowers through PyMakePow,
      not AN_BINOP — so the ASSIGNMENT token is what keys this one. Everything
      else here is keyed on the binary token PyAugBinTok produced, and there is
      none to produce. }
    tkPowEq: if inPlace then Result := '__ipow__'       else Result := '__pow__';
    else Result := '';
  end;
end;

function PyAugClassDunder(symIdx: Integer; binTk: TTokenKind; rhsNode: Integer): Integer;
{ `obj += x` where obj is a USER class instance: dispatch __iadd__, else fall
  back to __add__ and REBIND — Python's own rule. Returns the whole assignment
  statement, or -1 when the target is not a user class (caller keeps its path).

  Without this the target fell through to the numeric AN_BINOP below, which
  operated on the instance HANDLE and left the name holding 0 — silently, on an
  ordinary accumulator idiom, and equally with only `__add__` declared.
  bug-nilpy-augmented-assign-on-a-class-instance-silently-yields-zero }
var ci, rec, callNode, asgn: Integer; nm: AnsiString;
begin
  PyAugClassDunder := -1;
  if Syms[symIdx].TypeKind <> tyClass then Exit;
  rec := Syms[symIdx].RecName;
  if rec < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(rec) then Exit;   { TPyList `+=` is extend, handled above }
  ci := rec - REC_UCLASS_BASE;
  nm := PyAugDunderName(binTk, True);
  if (nm = '') or (FindUMeth(ci, nm) < 0) then
    nm := PyAugDunderName(binTk, False);
  if (nm = '') or (FindUMeth(ci, nm) < 0) then
  begin
    { NEITHER dunder: CPython raises "unsupported operand type(s) for +=".
      Falling through to the numeric path here is what produced the silent 0
      this ticket is about, so refuse it — and refuse it at RUN time, so a
      `try/except TypeError` around the statement still compiles, the same
      shape every other missing-dunder site in this frontend uses. }
    callNode := FindProc('PyUnsupportedOperandError');
    if callNode < 0 then Exit;    { pylib absent: leave the old path alone }
    asgn := AllocNode(AN_CALL);
    ASTIVal[asgn] := callNode;
    ASTTk[asgn] := Ord(tyUnknown);
    ASTLeft[asgn] := -1;
    PyAugClassDunder := asgn;
    Exit;
  end;
  callNode := PyCallMeth1(ci, nm, PyMakeIdent(symIdx), rhsNode);
  if callNode < 0 then Exit;
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(symIdx);
  ASTRight[asgn] := callNode;
  PyAugClassDunder := asgn;
end;

function PyAugClassDunderNode(lhsNode: Integer; binTk: TTokenKind; rhsNode: Integer): Integer;
{ `obj.field += x` / `self.field += x` where the FIELD holds a user class
  instance: the node-target twin of PyAugClassDunder, which is keyed on a
  symbol and so only reaches a bare NAME target. Same rule, same fallbacks.

  Without it the field target fell through to the numeric AN_BINOP below, which
  added the two instance HANDLES and stored the result into a class slot — the
  field read back as 0, silently, with the dunder never called.
  bug-nilpy-augmented-assign-to-a-class-typed-FIELD-silently-yields-zero

  The target subtree is CLONEd for the store, not shared: one node index sitting
  in two places is emitted twice, and an AST DAG is not what the rest of the
  pipeline expects. }
var ci, rec, callNode, asgn: Integer; nm: AnsiString;
begin
  PyAugClassDunderNode := -1;
  if lhsNode < 0 then Exit;
  if IntToTypeKind(ASTTk[lhsNode]) <> tyClass then Exit;
  rec := ResolveNodeRec(lhsNode);
  if rec < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(rec) then Exit;   { pylib containers keep their own path }
  ci := rec - REC_UCLASS_BASE;
  nm := PyAugDunderName(binTk, True);
  if (nm = '') or (FindUMeth(ci, nm) < 0) then
    nm := PyAugDunderName(binTk, False);
  if (nm = '') or (FindUMeth(ci, nm) < 0) then
  begin
    { NEITHER dunder — CPython raises. Refuse at RUN time so a try/except
      TypeError around the statement still compiles, exactly as the name twin. }
    callNode := FindProc('PyUnsupportedOperandError');
    if callNode < 0 then Exit;    { pylib absent: leave the old path alone }
    asgn := AllocNode(AN_CALL);
    ASTIVal[asgn] := callNode;
    ASTTk[asgn] := Ord(tyUnknown);
    ASTLeft[asgn] := -1;
    PyAugClassDunderNode := asgn;
    Exit;
  end;
  callNode := PyCallMeth1(ci, nm, lhsNode, rhsNode);
  if callNode < 0 then Exit;
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := CloneAST(lhsNode);
  ASTRight[asgn] := callNode;
  PyAugClassDunderNode := asgn;
end;

{ Register a nested def's SHELL and queue its body for later compilation.
  Returns an empty statement: the def itself produces no code where it stands.
  The typing pre-pass trial-parses the enclosing body too, so this must stay
  idempotent — a shell already carrying a BodyAddr means the real parse already
  compiled it, and re-registering would give the enclosing calls a second,
  bodyless Proc. }
{ Which registered proc a bare reference to `qname` means AT token position
  `at`. With no redefinition — every ordinary program — the table is empty and
  this is the plain qualified name. Otherwise it is the last binding whose
  `def` statement PRECEDES the reference, so code between two same-named nested
  defs still sees the earlier one, and everything after the second sees the
  second. A def's own BODY resolves to the last binding, which is also what
  CPython does: a nested body looks the name up in the enclosing frame when it
  RUNS, not when it is defined. }
function PyRedefBindingAt(const qname: AnsiString; at: Integer): AnsiString;
var i, bestTok: Integer;
begin
  Result := qname;
  bestTok := -1;
  for i := 0 to PyRedefN - 1 do
    if (PyRedefQName[i] = qname) and (PyRedefTok[i] < at) and
       (PyRedefTok[i] > bestTok) then
    begin
      bestTok := PyRedefTok[i];
      Result := PyRedefProc[i];
    end;
end;

{ Record that the def at `defTok` binds `qname` to the proc named `procName`.
  Idempotent by (qname, defTok): the enclosing body is parsed more than once
  (the local-typing trial pass, then for real) and must reach the same answer
  every time. }
procedure PyRedefNote(const qname: AnsiString; defTok: Integer;
                      const procName: AnsiString);
var i: Integer;
begin
  for i := 0 to PyRedefN - 1 do
    if (PyRedefQName[i] = qname) and (PyRedefTok[i] = defTok) then Exit;
  if PyRedefN > 127 then Exit;   { past the table: keep the old first-wins }
  PyRedefQName[PyRedefN] := qname;
  PyRedefTok[PyRedefN] := defTok;
  PyRedefProc[PyRedefN] := procName;
  Inc(PyRedefN);
end;

{ The name a NESTED def registers under. Plain `outer.name` for the first one
  in its scope; a REDEFINITION gets its own proc keyed by its `def` token, and
  is recorded so PyQualifyNested can resolve bare references by position.

  ONE helper, because two places derive this name — the queueing pass that
  registers the shell and collects captures, and PyParseDef which compiles the
  body into it. They must agree exactly: when they did not, the second def's
  body was compiled into a proc no name resolved to and the link failed with
  "unresolved forward". The existing proc is THIS def revisited (the trial pass,
  or the deferred body parse) rather than a redefinition exactly when it carries
  this def's token. }
function PyNestedDefQName(defTok: Integer; const baseName: AnsiString): AnsiString;
var j: Integer; plain: AnsiString;
begin
  Result := baseName;
  if PyNestPrefix = '' then Exit;
  plain := PyNestPrefix + '.' + baseName;
  Result := plain;
  j := FindProc(plain);
  if (j < 0) or (PyDefTokOf[j] = defTok + 1) then Exit;
  PyRedefNote(plain, PyDefTokOf[j] - 1, plain);        { the first binding }
  Result := plain + '$' + PyIntLiteralText(defTok);
  PyRedefNote(plain, defTok, Result);
end;

{ The name a call inside a nested def should actually look up. A def nested in
  another def registers as `outer.inner`; inside the enclosing body it is called
  unqualified. Walks the qualifier outwards — `a.b.c` then `a.b` then `a` — so an
  inner sibling shadows an outer one, like Python's scope chain. Returns the name
  unchanged when nothing qualified exists, which is every ordinary global call. }
function PyQualifyNested(const name: AnsiString): AnsiString;
var pfx: AnsiString; cut, i: Integer;
begin
  Result := name;
  pfx := PyNestPrefix;
  while pfx <> '' do
  begin
    { Only a nested DEF qualifies. A CLASS prefix must not: Python reaches a
      method through `self.` and never by a bare name, so inside a method the
      unqualified call names the module-level function even when the class has
      one of the same name — songformatter's `def select_image(self):
      select_image()` delegates exactly that way, and qualifying turned it into
      a call of ITSELF with no arguments. }
    if (FindProc(pfx + '.' + name) >= 0) and (FindUClass(pfx) < 0) then
    begin
      { Position matters only for a reference in the SAME scope as the defs:
        `w()` written between two `def w`s means the first. From an INNER def's
        body (pfx is an ancestor of the current prefix, not the current one)
        Python looks the name up in the enclosing frame when the body RUNS, so
        the last binding is the right answer there, whatever the token order. }
      if pfx = PyNestPrefix then
        Result := PyRedefBindingAt(pfx + '.' + name, TokPos)
      else
        Result := PyRedefBindingAt(pfx + '.' + name, TokCount + 1);
      Exit;
    end;
    cut := 0;
    for i := 1 to Length(pfx) do
      if pfx[i] = '.' then cut := i;
    if cut = 0 then pfx := '' else pfx := Copy(pfx, 1, cut - 1);
  end;
end;

{ A nested def OUTRANKS a module-level variable of the same spelling — the
  question every `FindSym(name) < 0` gate around PyQualifyNested was really
  asking, and getting wrong.

  `def m(b): def g(x): ... ; return g` with a module-level `g = m(10)` returned
  None: the `def` binds a LOCAL of the enclosing scope in Python, so it shadows
  the global unconditionally, but the gates read "a symbol of this name exists
  at all" and handed `return g` the global — which the assignment being parsed
  was still waiting on. Loud, but it blamed the caller ("the name is None"), and
  it needs only the outer name to match, which is exactly what a factory whose
  product keeps the factory's own inner name looks like
  (bug-nilpy-a-nested-def-shadowed-by-an-outer-name-binds-to-None).

  A skGlobal only. A genuine LOCAL of the same name is a REBINDING in the same
  scope (`def g(): ...` then `g = 5`) and must keep winning; the redefinition
  machinery above is what settles def-vs-def.

  Not handled: an enclosing body that declares `global g`, where Python gives
  the module binding back. PyBodyDeclaresNonlocal is the shape a fix would
  follow; no corpus needs it yet. }
function PyNestedDefOutranksSym(const name: AnsiString): Boolean;
var si: Integer;
begin
  Result := False;
  if not isNilPy then Exit;
  if PyNestPrefix = '' then Exit;
  si := FindSym(name);
  if si < 0 then Exit;                  { the caller's own gate already passes }
  if Syms[si].Kind <> skGlobal then Exit;
  { PyQualifyNested answers the BARE name when nothing qualified exists, so
    FindProc on its result asks "is there ANY proc called this?" — and proc
    lookup is case-INSENSITIVE, so a module global named `counter` matched
    pylib's `Counter` and every read of it became a function value
    (`n=4727019`, a code address). The question here is only ever "does a
    NESTED def of this name outrank the global", so the qualification must
    actually have happened. }
  if PyQualifyNested(name) = name then Exit;
  Result := FindProc(PyQualifyNested(name)) >= 0;
end;

{ Does the body span declare `nonlocal <name>`? Scanned from tokens, like the
  capture scan itself, because the body is not parsed until later. A `global`
  declaration is NOT this: that one names a module global, which the nested body
  already reaches directly. }
function PyBodyDeclaresNonlocal(bodyStart, bodyEnd: Integer;
                                const nm: AnsiString): Boolean;
var i: Integer;
begin
  Result := False;
  i := bodyStart;
  while i < bodyEnd do
  begin
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = 'nonlocal') then
    begin
      Inc(i);
      while (i < bodyEnd) and (Tokens[i].Kind = tkIdent) do
      begin
        if GetTokenStr(i) = nm then begin Result := True; Exit; end;
        Inc(i);
        if (i < bodyEnd) and (Tokens[i].Kind = tkComma) then Inc(i) else Break;
      end;
    end
    else
      Inc(i);
  end;
end;

{ May `nm` become a FRAME CELL — one heap word both this frame and every
  closure over it read and write? Only an unmanaged, at-most-word-sized scalar
  qualifies: the cell is 8 raw bytes, so a 16-byte variant, a managed string, a
  record, an array and a refcounted class instance are all left on the old
  copy-per-closure path rather than half-fitted into it. }
function PyCellPromotable(si: Integer): Boolean;
var tk: TTypeKind;
begin
  Result := False;
  if si < 0 then Exit;
  if SymCellPtr[si] >= 0 then Exit;                { already promoted }
  if not (Syms[si].Kind in [skLocal, skParam]) then Exit;
  if Syms[si].IsArray then Exit;
  tk := Syms[si].TypeKind;
  { A by-ref symbol is already an alias for storage somewhere else — a variant
    PARAMETER (this dialect passes variants const-by-ref) is the one shape where
    that is merely the calling convention and the name is still an ordinary
    rebindable Python local, so it may take a cell; anything else by-ref is a
    capture of an OUTER frame and promoting it would cut that chain. }
  if Syms[si].IsRef and not ((tk = tyVariant) and (Syms[si].Kind = skParam)) then Exit;
  Result := (tk = tyVariant) or
            (tk = tyInteger) or (tk = tyBoolean) or (tk = tyChar) or
            (tk = tyInt8) or (tk = tyUInt8) or (tk = tyInt16) or (tk = tyUInt16) or
            (tk = tyInt32) or (tk = tyUInt32) or (tk = tyInt64) or (tk = tyUInt64) or
            (tk = tyNativeInt) or (tk = tyNativeUInt) or
            (tk = tySingle) or (tk = tyDouble);
end;

{ Is the name in scope here a frame cell? Guards the -1 PyProgSym answers for
  a name that does not resolve. }
function PyNameIsCell(const nm: AnsiString): Boolean;
var si: Integer;
begin
  si := PyProgSym(nm);
  PyNameIsCell := (si >= 0) and (SymCellPtr[si] >= 0);
end;

{ Promote `nm` to a frame cell and append its prologue initialiser to `seq`.
  The name keeps its symbol and its logical type; what changes is that
  SymCellPtr points at a hidden pointer local, and PyMakeIdent then spells every
  use of the name `hidden^`. A PARAMETER additionally copies its incoming value
  into the cell — the caller wrote the slot, and from here on the slot is dead. }
{ The by-SYMBOL half of PyPromoteCell. Split out because the generator path
  promotes symbols it has in hand (every variant LOCAL of a generator body)
  rather than names it read out of the source. }
function PyPromoteCellSym(si, seq: Integer): Integer;
var ps, newPi, callNode, asgn, rawNode, derefNode: Integer;
begin
  Result := seq;
  if not PyCellPromotable(si) then Exit;
  newPi := FindProc('pycell_new');
  if newPi < 0 then Exit;
  ps := AllocVar('', tyPointer);
  Syms[ps].PtrElemTk := Syms[si].TypeKind;
  SymCellPtr[si] := ps;

  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := newPi;
  ASTLeft[callNode] := -1;
  ASTTk[callNode] := Ord(tyPointer);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeCellPtr(si);
  ASTRight[asgn] := callNode;
  Result := PySeqAppend(Result, asgn);

  if Syms[si].Kind = skParam then
  begin
    rawNode := AllocNode(AN_IDENT);          { the slot, NOT PyMakeIdent — that
                                               already reads through the cell }
    ASTIVal[rawNode] := si;
    ASTTk[rawNode] := Ord(Syms[si].TypeKind);
    derefNode := AllocNode(AN_DEREF);
    ASTLeft[derefNode] := PyMakeCellPtr(si);
    ASTTk[derefNode] := Ord(Syms[si].TypeKind);
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := derefNode;
    ASTRight[asgn] := rawNode;
    Result := PySeqAppend(Result, asgn);
  end;
end;

function PyPromoteCell(const nm: AnsiString; seq: Integer): Integer;
begin
  PyPromoteCell := PyPromoteCellSym(PyProgSym(nm), seq);
end;

{ Every name a NESTED def in this body declares `nonlocal` becomes a frame cell.
  Returns the prologue statements that allocate them, to be prepended to the
  body — the cell must exist before the body's first assignment runs.

  Depth >= 2 on purpose: `nonlocal x` written at depth 1 is THIS body's own
  declaration about its *enclosing* frame, not a claim on a local of ours.
  Called once, from the real parse, after the locals are laid out and before the
  body is parsed — so the body, the nested defs' capture scan and the closure
  binders all see the same answer. }
{ Is any def nested in this body taken AS A VALUE — assigned, returned, passed —
  rather than only called by name?

  This is what decides whether a frame cell is needed at all. A `nonlocal` capture
  reached only through a DIRECT call has always been correct without one: the call
  site passes `@c`, the address of the enclosing slot, and the by-ref parameter
  writes straight through it, so the frame and the callee already share one
  storage for free. The cell exists solely because a def taken as a value OUTLIVES
  the frame, and a stack slot cannot.

  Promoting regardless cost a heap cell per ACTIVATION of the enclosing function,
  never freed — 2M calls of a direct-call-only counter went from 1 MB flat to
  48 MB, a leak in a shape that previously did not allocate at all. Measured, and
  it was mine: the cell fix (bug-nilpy-an-escaped-nonlocal-cell-is-not-shared-
  with-the-enclosing-frame) introduced it.

  Conservative in the safe direction: over-answering True costs the old leak,
  under-answering gives wrong VALUES, so anything that is not unambiguously a
  call counts as a value. A name is a call only when it is immediately followed
  by '(' ; `return bump`, `f = bump`, `xs.append(bump)` all read as values. }
function PyBodyLiftsANestedDef(bodyStart: Integer): Boolean;
var i, depth, j, n: Integer;
    names: array[0..PY_MAX_NESTED-1] of AnsiString;
    nm: AnsiString;
begin
  Result := False;
  n := 0;
  { pass 1 — the names this body declares as nested defs }
  i := bodyStart;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth <= 0 then Break;
    end
    else if (Tokens[i].Kind = tkFunction) and (i + 1 < TokCount) and
            (Tokens[i + 1].Kind = tkIdent) then
    begin
      if n < PY_MAX_NESTED then
      begin
        names[n] := GetTokenStr(i + 1);
        Inc(n);
      end
      else
      begin
        { out of room to track them — assume a value, which only costs the
          old behaviour rather than a wrong answer }
        Result := True;
        Exit;
      end;
      Inc(i);
    end;
    Inc(i);
  end;
  if n = 0 then Exit;
  { pass 2 — is any of them mentioned other than as `def NAME` or `NAME(` ? }
  i := bodyStart;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth <= 0 then Break;
    end
    else if Tokens[i].Kind = tkIdent then
    begin
      nm := GetTokenStr(i);
      for j := 0 to n - 1 do
        if names[j] = nm then
        begin
          if (i > 0) and (Tokens[i - 1].Kind = tkFunction) then Break;  { the header }
          if (i + 1 < TokCount) and (Tokens[i + 1].Kind = tkLParen) then Break;  { a call }
          Result := True;
          Exit;
        end;
    end;
    Inc(i);
  end;
end;

{ Does the body starting at `bodyStart` REBIND the parameter `nm` — `p = ...`
  or an augmented `p += ...`? Python's rule is that rebinding a parameter is
  local to the call; this dialect passes a variant parameter CONST-BY-REF, so
  the name is an alias for the caller's own slot and the store went straight
  into it. `def h(p): p = p + [9]` then grew the CALLER's list, and a recursive
  walker built `['0-1-2', '0-1-2-2', '0-1-2-2-1-2', ...]` where CPython builds
  four identical paths.

  Augmented assignment counts, and counts CORRECTLY: `p += [x]` on a list
  mutates the object in place and the caller sees it either way (the copy holds
  the same handle), while `p += 1` on an int rebinds and the caller must NOT see
  it — which is exactly what a private slot holding the same value gives.

  Bounded by the body's own DEDENT, so a LATER def rebinding the same parameter
  name does not make this one pay for a copy.
  bug-nilpy-rebinding-a-list-parameter-aliases-the-callers-list }
function PyParamRebound(bodyStart: Integer; const nm: AnsiString): Boolean;
var i, depth: Integer;
begin
  Result := False;
  i := bodyStart;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth <= 0 then Exit;
    end
    else if (Tokens[i].Kind = tkIdent) and (i + 1 < TokCount) and
            (Tokens[i + 1].Kind in [tkAssign, tkPlusEq, tkMinusEq, tkStarEq,
                                    tkSlashEq, tkModEq, tkTrueDivEq, tkAmpEq,
                                    tkPipeEq, tkXorEq, tkShlEq, tkShrEq,
                                    tkAtEq]) and
            (GetTokenStr(i) = nm) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyPromoteNonlocalCells(bodyStart: Integer): Integer;
var i, depth: Integer;
begin
  Result := -1;
  { No nested def escapes this frame -> no cell is needed, and allocating one
    per activation would leak. See PyBodyLiftsANestedDef. }
  if not PyBodyLiftsANestedDef(bodyStart) then Exit;
  i := bodyStart;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth <= 0 then Break;
    end
    else if (depth >= 2) and (Tokens[i].Kind = tkIdent) and (i > 0) and
            (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]) and
            (GetTokenStr(i) = 'nonlocal') then
    begin
      Inc(i);
      while (i < TokCount) and (Tokens[i].Kind = tkIdent) do
      begin
        Result := PyPromoteCell(GetTokenStr(i), Result);
        Inc(i);
        if (i < TokCount) and (Tokens[i].Kind = tkComma) then Inc(i) else Break;
      end;
      Continue;
    end;
    Inc(i);
  end;
end;

{ Does the def body spanning [bodyStart, bodyEnd) BIND `nm` itself — i.e. is
  `nm` this def's own local rather than something to capture?

  Python's rule, and the one this implements: a name ASSIGNED anywhere in a
  function body is local to that body for the whole of it. The capture scan
  needs it because it runs BEFORE the body is parsed, so it has no locals table
  and asks `FindSym`. In a flattened nested-def world that question is answered
  by whatever symbol happens to exist — including a SIBLING def's local of the
  same name, already parsed into the same symbol space. Two siblings each with
  `op = 1` therefore each recorded `op` as a CAPTURE of the enclosing scope.

  That was invisible while the capture was merely useless (it is immediately
  overwritten by the body's own assignment — values stayed correct). It became
  a hard error the moment a THIRD sibling forward-called one of them: the
  transitive-capture rule made the caller forward `op` too, the caller has no
  `op`, and the call site reported "nested def captures op, which is not in
  scope at this call". A recursive-descent parser written as nested defs —
  factor/term/expr, each with its own `op` — is exactly that shape
  (bug-nilpy-a-nested-defs-own-local-is-recorded-as-a-capture).

  A name declared `nonlocal` is NOT this body's local: it must still be
  captured (by ref), so the caller checks that first and never asks here.

  Deliberately only PLAIN `nm =` and `for nm in`, not the augmented forms:
  `nm += 1` on a name this body never bound is an UnboundLocalError in CPython,
  so it cannot legitimately mean "local" — and treating it as one here would
  silently change what today's by-value-capture-then-overwrite code does. Kept
  narrow on purpose; widen only with a measurement. }
function PyBodyBindsLocal(bodyStart, bodyEnd: Integer;
                          const nm: AnsiString): Boolean;
var i: Integer;
begin
  Result := False;
  i := bodyStart;
  while i < bodyEnd do
  begin
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = nm) then
    begin
      { `nm = ...` — an assignment, hence a binding. }
      if (i + 1 < bodyEnd) and (Tokens[i + 1].Kind = tkAssign) then
      begin
        Result := True;
        Exit;
      end;
      { `for nm in ...` — the loop target is a binding too. }
      if (i > bodyStart) and (Tokens[i - 1].Kind = tkFor) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(i);
  end;
end;

{ The token index of a sibling nested `def <nm>` that appears LATER in the
  enclosing body. Scanned exactly like PyEnclosingAssigns — forward from fromTok
  until the enclosing block's own DEDENT — so it never leaves the scope. -1 when
  the enclosing body has no such def ahead. }
function PyFindSiblingDefTok(fromTok: Integer; const nm: AnsiString): Integer;
var i, depth: Integer;
begin
  PyFindSiblingDefTok := -1;
  i := fromTok;
  while (i < MainProgramTokCount) and (Tokens[i].Kind in [tkDedent, tkNewline]) do Inc(i);
  depth := 0;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth < 0 then Exit;          { left the enclosing body }
    end
    else if (depth = 0) and (Tokens[i].Kind = tkFunction) and
            (i + 1 < MainProgramTokCount) and (Tokens[i + 1].Kind = tkIdent) and
            (GetTokenStr(i + 1) = nm) then
    begin
      PyFindSiblingDefTok := i;
      Exit;
    end;
    Inc(i);
  end;
end;

{ The INDENT that opens the body of the def whose `def` keyword is at defTok —
  the same index PyParseDefHeader leaves behind, so PyFindBodyEnd agrees. }
function PySiblingDefBodyStart(defTok: Integer): Integer;
var i, depth: Integer;
begin
  PySiblingDefBodyStart := -1;
  i := defTok;
  depth := 0;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack] then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkIndent) then
    begin
      PySiblingDefBodyStart := i;
      Exit;
    end;
    Inc(i);
  end;
end;

{ The names a call to nested def `calleeName` must forward, into PyFwdCapNm.
  Why this is not simply `PyCapName[FindProc(callee)]`: a nested def's capture
  set is read when the CALLER is queued, and the callee may not be registered
  yet — it is defined later in the same body — so the set read was empty and the
  forwarded arguments were missing, making a legal program compile or fail on
  definition ORDER alone. Worse, the chain is multi-level (a lambda inside one
  sibling calling another), so one parse round per level never settles it.
  This walks the transitive closure of sibling-def bodies from tokens in one go:
  a registered callee contributes its final set, an unregistered one contributes
  its body's free names and queues the siblings IT calls. The caller filters
  every name against the enclosing scope, so over-collecting a name that is not
  an enclosing local costs nothing (bug-nilpy-nested-def-capture-sets-are-not-final). }
procedure PyCollectCalleeCaps(const calleeName: AnsiString; searchFrom: Integer);
const PAR_MAX = 32;
var wlAt, i, j, k, q, pi, dt, bS, bE, depth, nPar: Integer;
    pars: array[0..PAR_MAX-1] of AnsiString;
    nm, s, c: AnsiString; dup: Boolean;
begin
  PyFwdCapN := 0;
  PyFwdWlN := 1; PyFwdWl[0] := calleeName;
  wlAt := 0;
  while wlAt < PyFwdWlN do
  begin
    nm := PyFwdWl[wlAt];
    Inc(wlAt);
    { already registered — its capture set is final, take it verbatim }
    pi := FindProc(PyQualifyNested(nm));
    if (pi >= 0) and (PyCapCount[pi] > 0) then
    begin
      for k := 0 to PyCapCount[pi] - 1 do
      begin
        c := PyCapName[pi * PY_MAX_CAPS + k];
        dup := False;
        for q := 0 to PyFwdCapN - 1 do
          if PyFwdCapNm[q] = c then dup := True;
        if (not dup) and (PyFwdCapN < PY_MAX_CAPS) then
        begin
          PyFwdCapNm[PyFwdCapN] := c;
          Inc(PyFwdCapN);
        end;
      end;
      Continue;
    end;
    if pi >= 0 then Continue;          { registered and captures nothing }
    dt := PyFindSiblingDefTok(searchFrom, nm);
    if dt < 0 then Continue;
    bS := PySiblingDefBodyStart(dt);
    if bS < 0 then Continue;
    bE := PyFindBodyEnd(bS);
    { the callee's OWN parameters are bound at its call site, never captured }
    nPar := 0;
    i := dt + 2;                       { past `def` `name` }
    depth := 0;
    while i < bS do
    begin
      if Tokens[i].Kind = tkLParen then Inc(depth)
      else if Tokens[i].Kind = tkRParen then
      begin
        Dec(depth);
        if depth = 0 then Break;
      end
      else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
              (Tokens[i - 1].Kind in [tkLParen, tkComma]) then
      begin
        if nPar < PAR_MAX then
        begin
          pars[nPar] := GetTokenStr(i);
          Inc(nPar);
        end;
      end;
      Inc(i);
    end;
    for i := bS to bE - 1 do
      if (Tokens[i].Kind = tkIdent) and (Tokens[i - 1].Kind <> tkDot) then
      begin
        s := GetTokenStr(i);
        if s = nm then Continue;
        dup := False;
        for j := 0 to nPar - 1 do
          if pars[j] = s then dup := True;
        if dup then Continue;
        { a name that is itself a sibling def: what IT captures must travel too }
        if (FindProc(PyQualifyNested(s)) >= 0) or
           (PyFindSiblingDefTok(searchFrom, s) >= 0) then
        begin
          dup := False;
          for q := 0 to PyFwdWlN - 1 do
            if PyFwdWl[q] = s then dup := True;
          if (not dup) and (PyFwdWlN <= 15) then
          begin
            PyFwdWl[PyFwdWlN] := s;
            Inc(PyFwdWlN);
          end;
        end
        else
        begin
          dup := False;
          for q := 0 to PyFwdCapN - 1 do
            if PyFwdCapNm[q] = s then dup := True;
          if (not dup) and (PyFwdCapN < PY_MAX_CAPS) then
          begin
            PyFwdCapNm[PyFwdCapN] := s;
            Inc(PyFwdCapN);
          end;
        end;
      end;
  end;
end;

function PyQueueNestedDef: Integer;
var defTok, procIdx, bodyStart, bodyEnd, i, j, k, nCaps, nOwn, csym, csym2, capCi: Integer;
    qname, cname, cn2: AnsiString; already: Boolean;
    capNames: array[0..PY_MAX_CAPS-1] of AnsiString;
    capTypes: array[0..PY_MAX_CAPS-1] of TTypeKind;
    capRecs: array[0..PY_MAX_CAPS-1] of Integer;
    savedDefInit, defAssigns: Integer;
begin
  defTok := TokPos - 1;
  { Evaluate non-constant parameter defaults HERE, at the `def` statement. That
    is where Python evaluates them, and the one point the enclosing scope is
    still live: the body is compiled after the enclosing routine's epilogue, so
    evaluating there reports the enclosing names undefined — which is why
    PyParseDef switches evaluation off for a nested def, and why these defaults
    silently stayed None.
    The queued `$pdef.<nest>.<def>.<param> := <expr>` assignments are taken back
    out here and returned as this statement's own contribution to the enclosing
    body (see the Result at the end). They must NOT ride the normal def-init
    queue: only the MODULE statement loop flushes that, so the assignment would
    land at module scope, where an enclosing local does not exist.
    bug-nilpy-non-constant-parameter-defaults-silently-become-none }
  savedDefInit := PyDefInitHead;
  PyDefInitHead := -1;
  PyDefaultEvalMode := True;
  PyParseDefHeader;
  PyDefaultEvalMode := False;
  defAssigns := PyFlushDefInit(-1);
  PyDefInitHead := savedDefInit;
  qname := PyNestedDefQName(defTok, PyHdrName);
  bodyStart := TokPos - 1;
  bodyEnd := PyFindBodyEnd(bodyStart);
  { CAPTURE: every enclosing local/parameter the body mentions becomes a
    trailing by-value parameter, filled in at each call site. Scanned from the
    body's tokens because the body itself is not parsed until later — a name is
    captured when it resolves to a local or parameter of the ENCLOSING scope and
    is not one of this def's own parameters. A name the body ASSIGNS before
    reading is captured too and simply overwritten, which lands on Python's
    answer anyway (there it would be a plain local). }
  nCaps := 0;
  if PyNestPrefix <> '' then
    for i := bodyStart to bodyEnd - 1 do
      if Tokens[i].Kind = tkIdent then
      begin
        cname := GetTokenStr(i);
        already := False;
        for j := 0 to PyHdrNParams - 1 do
          if PyHdrPNames[j] = cname then already := True;
        for j := 0 to nCaps - 1 do
          if capNames[j] = cname then already := True;
        if not already then
        begin
          { THIS body binds the name itself -> it is our own LOCAL, not a
            capture. Asked before FindSym, which cannot tell an enclosing local
            from a SIBLING def's local of the same name in the flattened symbol
            space — see PyBodyBindsLocal for the whole story. `nonlocal nm` is
            the exception: that IS a capture (by ref), so it is excluded here. }
          if PyBodyBindsLocal(bodyStart, bodyEnd, cname) and
             not PyBodyDeclaresNonlocal(bodyStart, bodyEnd, cname) then
            Continue;
          csym := FindSym(cname);
          { assigned LATER in the enclosing body — materialise it now so it is
            captured like any other name }
          if (csym < 0) and PyEnclosingAssigns(bodyEnd, cname) then
            csym := AllocVar(cname, tyVariant);
          if (csym >= 0) and (Syms[csym].Kind in [skLocal, skParam]) and
             not Syms[csym].IsArray and
             (Syms[csym].TypeKind <> tyRecord) then
          begin
            if nCaps >= PY_MAX_CAPS then
              Error('Nil Python: a nested def may capture at most 8 enclosing names');
            capNames[nCaps] := cname;
            { A PROMOTABLE INT is captured as a VARIANT. Its rvalue is the
              frame SLOT ADDRESS, so a by-value promo parameter hands the
              callee a pointer into a frame it does not own — deep2's `bot`
              captured `y = m + x` and returned a stack address. Boxing is the
              same answer the promo RETURN path already reaches (inline ->
              VT_INT64, heap -> VT_PROMO_INT64), and it is lossless, unlike
              narrowing. A PromoInt PARAMETER cannot reach the runtime at all
              today (bug-a-promoint-shr-yields-nothing-...), so this is also
              the only shape that works. }
            capTypes[nCaps] := Syms[csym].TypeKind;
            if TypeIsPromoInt(capTypes[nCaps]) then capTypes[nCaps] := tyVariant;
            { A captured CLASS/RECORD-ID object must keep its class identity, or
              inside the nested body `obj.field` cannot resolve and every value
              read off it defaults to Integer (slices/methods on it then fail to
              parse). TParam carries no rec id, so carry it through capRecs ->
              ProcParamRecId (the persistent per-proc-param rec store). }
            if Syms[csym].TypeKind = tyClass then
              capRecs[nCaps] := Syms[csym].RecName
            else
              capRecs[nCaps] := REC_NONE;
            Inc(nCaps);
          end
          else
          begin
            { TRANSITIVE capture: the name is a SIBLING nested def that itself
              captures enclosing locals not in scope inside a THIRD sibling.
              CPython binds those at the sibling's def site; pxx flattens, so
              this def must forward them. Pull each of the callee's captures
              that resolves in the CURRENT enclosing scope into our own set
              (uforth's _open_file_common -> _file_open_mode -> FAM_RO).
              Filed decide-nilpy-transitive-nested-def-capture. }
            csym := FindProc(PyQualifyNested(cname));
            if (csym >= 0) or (PyFindSiblingDefTok(bodyEnd, cname) >= 0) then
            begin
              PyCollectCalleeCaps(cname, bodyEnd);
              for k := 0 to PyFwdCapN - 1 do
              begin
                cn2 := PyFwdCapNm[k];
                already := False;
                for j := 0 to PyHdrNParams - 1 do
                  if PyHdrPNames[j] = cn2 then already := True;
                for j := 0 to nCaps - 1 do
                  if capNames[j] = cn2 then already := True;
                if not already then
                begin
                  csym2 := FindSym(cn2);
                  if (csym2 >= 0) and (Syms[csym2].Kind in [skLocal, skParam]) and
                     not Syms[csym2].IsArray and (Syms[csym2].TypeKind <> tyRecord) then
                  begin
                    if nCaps >= PY_MAX_CAPS then
                      Error('Nil Python: a nested def may capture at most 8 enclosing names');
                    capNames[nCaps] := cn2;
                    capTypes[nCaps] := Syms[csym2].TypeKind;
                    { promo -> variant, same reason as the site above }
                    if TypeIsPromoInt(capTypes[nCaps]) then
                      capTypes[nCaps] := tyVariant;
                    if Syms[csym2].TypeKind = tyClass then
                      capRecs[nCaps] := Syms[csym2].RecName
                    else
                      capRecs[nCaps] := REC_NONE;
                    Inc(nCaps);
                  end;
                end;
              end;
            end;
          end;
        end;
      end;
  if PxxDbgEnabled('n.caps') then
  begin
    Write('PXXDBG n.caps def ', qname, ' caps=');
    for j := 0 to nCaps - 1 do Write(capNames[j], ' ');
    WriteLn;
  end;
  procIdx := FindProc(qname);
  if procIdx < 0 then
  begin
    nOwn := PyHdrNParams;
    for j := 0 to nCaps - 1 do
    begin
      if PyHdrNParams >= 32 then Error('Nil Python: too many parameters after capture');
      PyHdrPNames[PyHdrNParams] := capNames[j];
      PyHdrPTypes[PyHdrNParams] := capTypes[j];
      if (capTypes[j] = tyClass) and (capRecs[j] >= REC_UCLASS_BASE) then
        PyHdrPCis[PyHdrNParams] := capRecs[j] - REC_UCLASS_BASE
      else
        PyHdrPCis[PyHdrNParams] := -1;
      PyHdrDefHas[PyHdrNParams] := False;
      Inc(PyHdrNParams);
    end;
    procIdx := RegisterProc(qname, not PyHdrIsProc, PyHdrRetType, PyHdrNParams,
                            PyHdrPNames, PyHdrPTypes);
    PyApplyDefSignature(procIdx);
    Procs[procIdx].BodyAddr := -1;
    { A captured parameter is never written at the call site by the user, so
      overload matching must accept a call that supplies only the declared
      arguments — the same "trailing params may be omitted" rule defaults use.
      The call site then appends the captured actuals. }
    PyCapCount[procIdx] := nCaps;
    for j := 0 to nCaps - 1 do
    begin
      PyCapName[procIdx * PY_MAX_CAPS + j] := capNames[j];
      if nOwn + j < MAX_PROC_PARAMS then
      begin
        ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + nOwn + j] := True;
        { persist the captured object's class so the deferred body parse can
          restore PyHdrPCis (TParam has no rec-id field of its own) }
        if capRecs[j] >= REC_UCLASS_BASE then
          ProcParamRecId[procIdx * MAX_PROC_PARAMS + nOwn + j] := capRecs[j];
        { `nonlocal x` in the body means a WRITE must land in the enclosing
          frame. A capture is normally a by-VALUE trailing parameter, so the
          write went to the callee's copy and the enclosing local never changed
          (songformatter's parseParams set `song_title`, and the renderer still
          saw None). Declaring THAT parameter by-ref makes the store write
          through to the enclosing local the call site passes. }
          { A CELL name is by-ref even when THIS def only reads it: the frame's
            one storage is the cell, and a by-value snapshot taken at the call
            would miss every later write — `def get(): return c` beside a
            sibling `def inc(): nonlocal c` must answer what inc left, which is
            what CPython's shared cell gives. }
        if PyBodyDeclaresNonlocal(bodyStart, bodyEnd, capNames[j]) or
           PyNameIsCell(capNames[j]) then
        begin
          Procs[procIdx].Params[nOwn + j].IsRef := True;
          ProcParamCapRef[procIdx * MAX_PROC_PARAMS + nOwn + j] := True;
        end;
      end;
    end;
  end
  else
    { ALREADY REGISTERED — by the enclosing body's local-typing TRIAL parse,
      which runs BEFORE the frame's cells exist. The by-ref decision above was
      therefore taken without them, and a read-only sibling of a cell name
      (`def get(): return c` beside `def inc(): nonlocal c`) kept a by-value
      parameter while the call site passed the cell — it read the pointer as a
      value. Re-apply it here, where the promotion is known; the nonlocal arm is
      token-based and so already agreed across the two passes. }
    for j := 0 to PyCapCount[procIdx] - 1 do
    begin
      nOwn := Procs[procIdx].ParamCount - PyCapCount[procIdx];
      if (nOwn + j < MAX_PROC_PARAMS) and (nOwn >= 0) and
         PyNameIsCell(PyCapName[procIdx * PY_MAX_CAPS + j]) then
      begin
        Procs[procIdx].Params[nOwn + j].IsRef := True;
        ProcParamCapRef[procIdx * MAX_PROC_PARAMS + nOwn + j] := True;
      end;
    end;
  { The def-time default globals, re-recorded on EVERY pass for the same reason
    the cells above are: the trial parse registered this Proc, so the branch
    that carries a signature onto it does not run again — and the `$pdef.<def>.
    <param>` symbol the trial allocated was ROLLED BACK with the rest of the
    trial's scope. The real parse allocates it afresh, at whatever index is free
    NOW, and the two disagree exactly when the enclosing body declared a local
    in between: the call then read the OTHER symbol that inherited the index.
    `r = h()` answered None while the identical `return h()` was right, because
    with no `r` there was no index to lose. Recycled index, plausible wrong
    value — project_tsymbol_field_landmine's neighbour.
    PyParseDef carries the same loop for the top-level shape.
    bug-nilpy-a-nested-defs-default-parameter-is-read-from-a-rolled-back-symbol }
  if not PyTypingPass then
    for j := 0 to PyHdrNParams - 1 do
      if (j < MAX_PROC_PARAMS) and PyHdrDefHas[j] and (PyHdrDefSym[j] >= 0) then
      begin
        ProcParamDefaultSym[procIdx * MAX_PROC_PARAMS + j] := PyHdrDefSym[j];
        ProcParamDefaultGName[procIdx * MAX_PROC_PARAMS + j] := PyHdrDefGName[j];
        ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + j] := True;
        ProcParamDefaultIsNone[procIdx * MAX_PROC_PARAMS + j] := False;
      end;
  { record the def's token position: a nested def taken AS A VALUE re-lowers
    from this span as a value-binding closure (see PyNestedDefClosureValue) }
  PyDefTokOf[procIdx] := defTok + 1;
  { skip the body: PyParseDefHeader stopped on the INDENT that opens it }
  { land ON the DEDENT that closes the nested body, then consume it, so the
    enclosing block resumes at the statement after the def }
  TokPos := bodyEnd;
  Next;
  if CurTok.Kind = tkDedent then Next;
  PySkipNewlines;
  PyStmtAteBlock := True;
  if not PyTypingPass then
  begin
    if PyPendNestCount >= PY_MAX_NESTED then
      Error('Nil Python: too many nested defs in one body');
    PyPendNestTok[PyPendNestCount] := defTok;
    PyPendNestPfx[PyPendNestCount] := PyNestPrefix;
    PyPendNestSelf[PyPendNestCount] := CurSelfClass;
    Inc(PyPendNestCount);
  end;
  { The nested def statement emits no code of its own — but its non-constant
    parameter defaults do, and they belong here, at the def statement in the
    enclosing body. -1 when there are none, as before. }
  Result := defAssigns;
end;

{ ONE store of an unpacking assignment: a plain NAME (created on first
  assignment, as everywhere in NilPy), a declared ATTRIBUTE `obj.field`, or an
  attribute the class never declared — Python creates that on assignment, and
  it goes through the same dynamic store `obj.name = v` already uses. `newTk`
  is the type a freshly created plain name takes. }
{ `base[idx]` as a NODE — the READ mirror of PyMakeSubscriptStore below, for
  the same caller. A target list's INNER steps are reads: in
  `m[i][j], m[j][i] = ...` only the last bracket is stored into, and everything
  left of it has to be evaluated the ordinary way.
  bug-nilpy-tuple-assignment-to-subscript-targets-does-not-parse }
{ A callable ARGUMENT heading for a Pointer-typed parameter — `map(f, xs)`,
  `filter(f, xs)`. A callable VALUE is a 16-byte variant, and dropping one into
  a pointer slot passes its TAG word as the code address: `map(obj.method, xs)`
  jumped to 8 and SEGFAULTED. pyvar_callable_ptr yields the payload — the
  {code, recv} pair for a bound method, which is exactly what PyCallKey1 on the
  other side tests for first.

  The generic call path already coerces every variant argument to a Pointer
  parameter this way (parser.inc); the map/filter intercepts build their call by
  hand and so must do it themselves.
  bug-nilpy-map-over-a-bound-method-segfaults }
function PyMakeCallablePtrArg(node: Integer; const what: AnsiString): Integer;
var procIdx, a0, a1, nameNode, btPi, argN, code, wrapPi: Integer;
begin
  Result := node;
  if IntToTypeKind(ASTTk[node]) <> tyVariant then Exit;
  { A builtin TYPE as the callable — `map(bool, xs)`, `filter(str, xs)`. It is
    the `pybtype(<code>)` variant, whose payload is a small CODE, and the
    unwrap below hands a payload straight to the dispatcher as an address: the
    program jumped to 4 and died with no diagnostic. `sorted(xs, key=bool)`
    never did, because the ordinary call path rewrites the argument in
    PyFixCallableTypeArgs — and map/filter build their callable here instead,
    so they never saw that rewrite. Same rewrite, at the second site, rather
    than a second mechanism (devdocs/dev/normalise-dont-special-case.md).
    bug-nilpy-a-builtin-type-passed-to-map-or-filter-segfaults }
  btPi := FindProc('pybtype');
  if (btPi >= 0) and (ASTKind[node] = AN_CALL) and (ASTIVal[node] = btPi) then
  begin
    argN := ASTLeft[node];
    if (argN >= 0) and (ASTLeft[argN] >= 0) and
       (ASTKind[ASTLeft[argN]] = AN_INT_LIT) then
    begin
      code := Integer(ASTIVal[ASTLeft[argN]]);
      wrapPi := PyBuiltinTypeCallbackProc(code);
      if wrapPi >= 0 then
      begin
        Result := AllocNode(AN_PROCADDR);
        ASTIVal[Result] := wrapPi;
        ASTTk[Result] := Ord(tyPointer);
        Exit;
      end;
    end;
  end;
  procIdx := FindProc('pyvar_callable_ptr');
  if procIdx < 0 then Exit;
  nameNode := AllocNode(AN_STR_LIT);
  ASTSOffset[nameNode] := PyStoredName(what);
  ASTSLen[nameNode] := Length(what);
  ASTTk[nameNode] := Ord(tyString);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := node;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode; ASTRight[a1] := -1;
  ASTRight[a0] := a1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyPointer);
  ASTLeft[Result] := a0;
end;

function PyMakeSubscriptLoad(baseNode, idxNode: Integer): Integer;
var ci, pri, i, idxN, idxArg: Integer;
begin
  if IntToTypeKind(ASTTk[baseNode]) <> tyClass then
  begin
    PyMakeSubscriptLoad := PyMakeVariantGetItem(PyForceVariant(baseNode), idxNode);
    Exit;
  end;
  ci := -1;
  i := ResolveNodeRec(baseNode);
  if i >= REC_UCLASS_BASE then ci := i - REC_UCLASS_BASE;
  pri := -1;
  if ci >= 0 then pri := FindDefaultProp(ci);
  if pri < 0 then
  begin
    PyMakeSubscriptLoad := PyMakeVariantGetItem(PyForceVariant(baseNode), idxNode);
    Exit;
  end;
  idxN := idxNode;
  if PyClassWantsIntIndex(ci) then
  begin
    i := PyIndexNotIntKind(PyIndexSeqKindCi(ci), idxN);
    if i >= 0 then idxN := i else idxN := PyIndexCoerce(idxN);
  end;
  idxArg := AllocNode(AN_ARG);
  ASTLeft[idxArg] := idxN;
  ASTRight[idxArg] := -1;
  PyMakeSubscriptLoad := PyMakeSubscriptRead(baseNode, idxArg, ci, pri);
end;

{ `base[idx] = val` as a NODE, for a caller that already has all three and no
  tokens left to read — the tuple-unpack target list (`h[i], h[j] = h[j], h[i]`).

  The same four-way fork the inline `x[k] = v` path in parser.inc makes, written
  once: a VARIANT base dispatches at run time, a class with a Pascal default
  property (pylib's TPyList/TPyDict) calls its setter, a user class calls
  `__setitem__`, a class with neither raises CPython's TypeError at run time,
  and anything else is an ordinary indexed store. A fifth copy of that fork is
  what devdocs/dev/normalise-dont-special-case.md warns about; the inline path
  keeps its own parse-interleaved arms (augmented ops, multi-index property
  args, chained assignment) and this builder covers the single-index store the
  target list needs.

  bug-nilpy-tuple-assignment-to-subscript-targets-does-not-parse }
function PyMakeSubscriptStore(baseNode, idxNode, valNode: Integer): Integer;
var ci, pri, mmi, mpi, selfArg, idxArg, valArg, callNode, asgn, idxN: Integer;
    methName: AnsiString;
    i: Integer;
begin
  if IntToTypeKind(ASTTk[baseNode]) = tyVariant then
  begin
    PyMakeSubscriptStore := PyMakeVariantSetItem(baseNode, idxNode, valNode);
    Exit;
  end;
  ci := -1;
  if IntToTypeKind(ASTTk[baseNode]) = tyClass then
  begin
    i := ResolveNodeRec(baseNode);
    if i >= REC_UCLASS_BASE then ci := i - REC_UCLASS_BASE;
  end;
  if ci >= 0 then
  begin
    { pylib's own containers: the Pascal default property carries the setter,
      and a SEQUENCE wants the index coerced through __index__ exactly as the
      inline path coerces it. }
    pri := FindDefaultProp(ci);
    idxN := idxNode;
    if PyClassWantsIntIndex(ci) then
    begin
      i := PyIndexNotIntKind(PyIndexSeqKindCi(ci), idxN);
      if i >= 0 then idxN := i else idxN := PyIndexCoerce(idxN);
    end;
    if pri >= 0 then
    begin
      if UPropWriteMLen[pri] <= 0 then
        Error('Nil Python: this container is read-only');
      methName := '';
      for i := 0 to UPropWriteMLen[pri] - 1 do
        AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
      mmi := FindUMeth(ci, methName);
      if mmi < 0 then Error('Nil Python: setter method not found: ' + methName);
    end
    else
      mmi := FindUMeth(ci, '__setitem__');
    if mmi < 0 then
    begin
      { neither a default property nor __setitem__: CPython's TypeError, at RUN
        time, so `try: obj[k] = v / except TypeError:` still compiles }
      PyMakeSubscriptStore := PyClassErrCallNode('PyNoSetitemError', ci);
      if PyMakeSubscriptStore < 0 then
        Error('Nil Python: pylib (PyNoSetitemError) not loaded');
      Exit;
    end;
    mpi := UMthProc_[mmi];
    if UMthVirSlot[mmi] >= 0 then
    begin
      callNode := AllocNode(AN_VIRTUAL_CALL);
      ASTRight[callNode] := UMthVirSlot[mmi];
    end
    else
      callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(Procs[mpi].RetType);
    selfArg := AllocNode(AN_ARG); ASTLeft[selfArg] := baseNode;
    idxArg := AllocNode(AN_ARG); ASTLeft[idxArg] := idxN;
    valArg := AllocNode(AN_ARG); ASTLeft[valArg] := valNode;
    ASTRight[selfArg] := idxArg; ASTRight[idxArg] := valArg; ASTRight[valArg] := -1;
    ASTLeft[callNode] := selfArg;
    PyMakeSubscriptStore := callNode;
    Exit;
  end;
  { an ordinary indexed lvalue — a static array or a pointer base }
  asgn := AllocNode(AN_INDEX);
  ASTLeft[asgn] := baseNode;
  ASTRight[asgn] := idxNode;
  ASTTk[asgn] := ASTTk[baseNode];
  PyMakeSubscriptStore := AllocNode(AN_ASSIGN);
  ASTLeft[PyMakeSubscriptStore] := asgn;
  ASTRight[PyMakeSubscriptStore] := valNode;
end;

{ `obj.name` as a NODE — a declared FIELD read where the class declares one,
  the dynamic attribute route otherwise. The read half of the attribute logic in
  PyUnpackTargetStore below, needed once a target may continue into a subscript
  (`self.grid[i], self.grid[j] = ...`).
  bug-nilpy-tuple-assignment-to-subscript-targets-does-not-parse }
{ `z.real` / `z.imag` on a complex. The Python attribute names cannot BE the
  pylib field names: `real` lexes as a TYPE token in the Pascal lexer, so a
  field so named is unreachable from inside pylib itself (`z.real` there is
  "no such member"). NilPy has its own lexer where `real` is an ordinary
  identifier, so the two names are mapped onto the fields here — at the one
  place attribute reads resolve. bug-nilpy-no-complex-number-type }
{ Is this record id pylib's TPyComplex? Complex is a pylib class, and pylib
  classes are deliberately excluded from every dunder-dispatch arm, so each
  place that would have dispatched `__abs__` / `__add__` / ... needs to name
  complex explicitly. bug-nilpy-no-complex-number-type }
function PyRecIsComplex(recId: Integer): Boolean;
begin
  Result := (recId >= REC_UCLASS_BASE) and
            CaseEqual(PyRawName(UClsNOff[recId - REC_UCLASS_BASE],
                                UClsNLen[recId - REC_UCLASS_BASE]), 'TPyComplex');
end;

function PyComplexFieldName(ci: Integer; const fld: AnsiString): AnsiString;
begin
  Result := fld;
  if ci < 0 then Exit;
  if not CaseEqual(PyRawName(UClsNOff[ci], UClsNLen[ci]), 'TPyComplex') then Exit;
  if CaseEqual(fld, 'real') then Result := 'FRe'
  else if CaseEqual(fld, 'imag') then Result := 'FIm';
end;

function PyMakeAttrLoad(baseNode: Integer; const fld: AnsiString): Integer;
var ci, fi, node: Integer; rfld: AnsiString;
begin
  ci := -1;
  if IntToTypeKind(ASTTk[baseNode]) = tyClass then
  begin
    fi := ResolveNodeRec(baseNode);
    if fi >= REC_UCLASS_BASE then ci := fi - REC_UCLASS_BASE;
  end;
  rfld := PyComplexFieldName(ci, fld);
  fi := -1;
  if ci >= 0 then fi := FindUField(ci, rfld);
  if fi < 0 then
  begin
    PyMakeAttrLoad := PyMakeDynAttrGet(baseNode, fld);
    Exit;
  end;
  node := AllocNode(AN_FIELD);
  ASTLeft[node] := baseNode;
  ASTSOffset[node] := PyStoredName(rfld);
  ASTSLen[node] := Length(rfld);
  ASTTk[node] := UFldTk[fi];
  ASTRight[node] := UFldRec_[fi];
  PyMakeAttrLoad := node;
end;

function PyUnpackTargetStore(const nm, fld: AnsiString; valNode: Integer;
                            newTk: TTypeKind; newRec: Integer): Integer;
var symIdx, ci, fi, lhs: Integer;
begin
  symIdx := PyProgSym(nm);
  if fld = '' then
  begin
    if symIdx < 0 then symIdx := AllocVar(nm, newTk);
    { Carry the CLASS IDENTITY, not just the type kind. `a, b = C(3), C(3)`
      typed each target tyClass but left RecName unset, so the target was a
      class-shaped value with no class — and everything that resolves against
      the class silently stopped working: a method call on it did not parse,
      and `len(a)` / `a == b` / `str(a)` / `x in a` skipped dunder dispatch and
      answered 1 / False / a POINTER. Two separate assignments of the same
      constructions were always correct, which is what pinned it here
      (bug-nilpy-constructor-call-in-unpack-rhs-fails-to-parse).

      Set when the symbol has no identity yet, including a fresh one; an
      existing name REBOUND to a different class is left alone here, since a
      name that genuinely holds two classes over its life is the widening case
      the module/local tables own. }
    if (newTk = tyClass) and (newRec >= REC_UCLASS_BASE) and
       (Syms[symIdx].RecName < REC_UCLASS_BASE) then
    begin
      Syms[symIdx].RecName := newRec;
      SymSyncTypeRef(symIdx);
    end;
    lhs := PyMakeIdent(symIdx);
  end
  else
  begin
    if symIdx < 0 then
      Error('Nil Python: ' + nm + ' is not defined, so ' + nm + '.' + fld
            + ' cannot be assigned');
    ci := -1;
    if (Syms[symIdx].TypeKind = tyClass) and (Syms[symIdx].RecName >= REC_UCLASS_BASE) then
      ci := Syms[symIdx].RecName - REC_UCLASS_BASE;
    fi := -1;
    if ci >= 0 then fi := FindUField(ci, fld);
    if fi < 0 then
    begin
      { NOT a declared field — Python creates the attribute on assignment, and
        the ordinary `obj.name = v` path already stores it dynamically }
      PyUnpackTargetStore := PyMakeDynAttrSet(PyMakeIdent(symIdx), fld, valNode);
      Exit;
    end;
    lhs := AllocNode(AN_FIELD);
    ASTLeft[lhs] := PyMakeIdent(symIdx);
    ASTSOffset[lhs] := PyStoredName(fld);
    ASTSLen[lhs] := Length(fld);
    ASTTk[lhs] := UFldTk[fi];
  end;
  PyUnpackTargetStore := AllocNode(AN_ASSIGN);
  ASTLeft[PyUnpackTargetStore] := lhs;
  ASTRight[PyUnpackTargetStore] := valNode;
end;

{ `a, b = x, y` — SIMULTANEOUS assignment. Every right-hand side is evaluated
  into a hidden temp before ANY target is stored, which is the whole reason this
  is not just a sequence of assignments: `a, b = b, a` would otherwise become
  `a = b; b = a` and lose the old `a` (feature-nilpy-tuple-unpack). }
{ Two builders for the STARRED unpack in PyParseUnpackAssign — a slice and a
  length over a value that may be a static TPyList or a bare variant. Written
  once each rather than inline at three call sites, because the list/variant
  fork has to be made identically every time and that is exactly the kind of
  duplication this frontend keeps getting bitten by.
  feature-nilpy-starred-and-nested-unpacking }
function PyMakeSliceOf(baseNode, loNode, hiNode: Integer; listCi: Integer): Integer;
var pn: AnsiString; pi, a1, a2, a3: Integer;
begin
  if listCi >= 0 then pn := 'pylist_slice' else pn := 'pyvar_slice';
  pi := FindProc(pn);
  if pi < 0 then Error('Nil Python: pylib (' + pn + ') not loaded');
  a3 := AllocNode(AN_ARG); ASTLeft[a3] := hiNode; ASTRight[a3] := -1;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := loNode; ASTRight[a2] := a3;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := baseNode; ASTRight[a1] := a2;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := pi;
  ASTLeft[Result] := a1;
  ASTTk[Result] := Ord(Procs[pi].RetType);
  ASTRight[Result] := ProcRetRecId[pi];
end;

function PyMakeLenOf(baseNode: Integer; listCi: Integer): Integer;
var pi, a1: Integer;
begin
  if listCi >= 0 then
  begin
    Result := PyCallMeth1(listCi, 'count', baseNode, -1);
    if Result < 0 then Error('Nil Python: pylib (TPyList.count) not loaded');
    Exit;
  end;
  pi := FindProc('pylen_v');
  if pi < 0 then Error('Nil Python: pylib (pylen_v) not loaded');
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := baseNode; ASTRight[a1] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := pi;
  ASTLeft[Result] := a1;
  ASTTk[Result] := Ord(tyInteger);
end;

function PyParseAsgNestGroup(slot: Integer): AnsiString;
{ `(b, c)` as one element of an assignment target list. Consumed here, returned
  as the HIDDEN name its slot binds to, with the inner names recorded for
  PyEmitNestedAsgUnpacks. The twin of PyParseForTargetSlot's group arm; kept
  separate because an assignment target element also admits attributes,
  subscripts and a star, none of which may appear inside a group here.
  feature-nilpy-starred-and-nested-unpacking }
var n: Integer;
begin
  if (slot < 0) or (slot > PY_FOR_NEST_SLOTS) then
    Error('Nil Python: too many unpacking targets');
  Next;                                  { '(' }
  n := 0;
  repeat
    if CurTok.Kind = tkStar then
      Error('Nil Python: a STARRED name inside a nested assignment target is '
            + 'not supported yet');
    if CurTok.Kind = tkLParen then
      Error('Nil Python: an assignment target nested more than one level deep '
            + '(`a, ((b, c), d) = ...`) is not supported yet');
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: expected a name inside the nested assignment target');
    if n > PY_FOR_NEST_NAMES then
      Error('Nil Python: too many names in a nested assignment target');
    PyAsgNestName[slot][n] := CurTok.SVal;
    Inc(n);
    Next;
  until not Eat(tkComma);
  Expect(tkRParen, ')');
  if n < 2 then
    Error('Nil Python: a nested assignment target needs at least two names');
  PyAsgNestCount[slot] := n;
  Result := PyHiddenName('anst');
  PyAsgNestHost[slot] := Result;
end;

function PyEmitNestedAsgUnpacks(seq: Integer): Integer;
{ `a, (b, c) = ...` — the inner names of every NESTED group in the target list,
  read out of the hidden name its slot was bound to. Called at BOTH of
  PyParseUnpackAssign's exits (the one-sequence branch and the
  value-per-target one) so the two cannot diverge.

  Emitted AFTER every outer store, which is what makes `(a, b), a = x, y` do
  what Python does: the whole right-hand side is already in temps by then, so
  ordering only affects which store wins, exactly as it does there.
  feature-nilpy-starred-and-nested-unpacking }
var i, j, hostSym, sym, node: Integer;
begin
  Result := seq;
  for i := 0 to PY_FOR_NEST_SLOTS do
  begin
    if PyAsgNestCount[i] = 0 then Continue;
    hostSym := PyProgSym(PyAsgNestHost[i]);
    if hostSym < 0 then Continue;
    for j := 0 to PyAsgNestCount[i] - 1 do
    begin
      sym := PyAssignTargetSym(PyAsgNestName[i][j]);
      if sym < 0 then sym := AllocVar(PyAsgNestName[i][j], tyVariant);
      node := AllocNode(AN_ASSIGN);
      ASTLeft[node] := PyMakeIdent(sym);
      ASTRight[node] := PyPairItem(PyMakeIdent(hostSym), j);
      Result := PySeqAppend(Result, node);
    end;
  end;
end;

function PyParseUnpackAssign: Integer;
var names: array[0..7] of AnsiString;
    flds: array[0..7] of AnsiString;    { attribute target, or '' for a plain name }
    tmps: array[0..7] of Integer;
    { a SUBSCRIPT target — `h[i], h[j] = h[j], h[i]`. subIdx is the index node
      of the LAST bracket and subBase the value it indexes (already a read for
      an inner step, e.g. `m[i]` in `m[i][j]`); -1 when the target is a plain
      name or an attribute.
      bug-nilpy-tuple-assignment-to-subscript-targets-does-not-parse }
    subBase: array[0..7] of Integer;
    subIdx: array[0..7] of Integer;
    tgtBase: Integer;
    nTargets, nValues, i, symIdx, node, seq, tk: Integer;
    unpCi, unpIdx, unpElem: Integer;
    starAt, unpCnt, unpHi, unpTrail: Integer;   { `a, *rest = xs` }
begin
  nTargets := 0;
  starAt := -1;
  for i := 0 to PY_FOR_NEST_SLOTS do PyAsgNestCount[i] := 0;
  repeat
    if CurTok.Kind = tkStar then
    begin
      { `*rest` — takes a LIST of the surplus. Python allows exactly one per
        target list; a second is a hard error there too. }
      if starAt >= 0 then
        Error('Nil Python: two starred targets in one assignment — Python '
              + 'allows at most one');
      starAt := nTargets;
      Next;
    end;
    if nTargets >= 8 then Error('Nil Python: at most 8 unpacking targets');
    { a NESTED group — `a, (b, c) = ...`. Bound to a hidden name here like any
      other target, and unpacked into the user's names after every outer store;
      the same desugar the nested LOOP target uses, and for the same reason
      (this target list is flat end to end). }
    if CurTok.Kind = tkLParen then
    begin
      names[nTargets] := PyParseAsgNestGroup(nTargets);
      flds[nTargets] := '';
      subBase[nTargets] := -1;
      subIdx[nTargets] := -1;
      Inc(nTargets);
      Continue;
    end;
    if CurTok.Kind <> tkIdent then Error('Nil Python: expected a name in the assignment target');
    names[nTargets] := CurTok.SVal;
    flds[nTargets] := '';
    subBase[nTargets] := -1;
    subIdx[nTargets] := -1;
    Next;
    { An ATTRIBUTE target — `self.x, self.y = x, y`, which is how a class
      records a position in one line. Only the object.field shape is taken;
      anything deeper reports its own error. }
    if (CurTok.Kind = tkDot) and (TokPos < TokCount) and (Tokens[TokPos].Kind = tkIdent) then
    begin
      Next;
      flds[nTargets] := CurTok.SVal;
      Next;
    end;
    { A SUBSCRIPT target — `h[i], h[j] = h[j], h[i]`, the swap every sort and
      heap is written with. Only the LAST bracket is a store; the ones before it
      are ordinary reads that build the base (`m[i][j]` stores into `m[i]`).
      The base is captured as a NODE here and the store built after the values
      are in temps, so Python's "evaluate everything first" order holds. }
    if CurTok.Kind = tkLBrack then
    begin
      symIdx := PyProgSym(names[nTargets]);
      if symIdx < 0 then
        Error('Nil Python: ' + names[nTargets] + ' is not defined, so '
              + names[nTargets] + '[...] cannot be assigned');
      tgtBase := PyMakeIdent(symIdx);
      if flds[nTargets] <> '' then
        tgtBase := PyMakeAttrLoad(tgtBase, flds[nTargets]);
      while CurTok.Kind = tkLBrack do
      begin
        Next;                          { consume '[' }
        PyParseBoolExpr;
        node := CurASTNode;
        Expect(tkRBrack, ']');
        if subIdx[nTargets] >= 0 then
          tgtBase := PyMakeSubscriptLoad(tgtBase, subIdx[nTargets]);
        subBase[nTargets] := tgtBase;
        subIdx[nTargets] := node;
      end;
    end;
    Inc(nTargets);
  until not Eat(tkComma);
  Expect(tkAssign, '=');

  { values into temps, left to right }
  seq := -1;
  nValues := 0;
  repeat
    PyParseBoolExpr;
    if nValues >= nTargets then
      Error('Nil Python: too many values to unpack');
    { `w, h = map(int, s.split("x"))` — a cursor cannot be indexed, so it is
      drained here first. CPython unpacks an iterator the same way. }
    CurASTNode := PyDrainIfCursor(CurASTNode);
    tk := ASTTk[CurASTNode];
    if IntToTypeKind(tk) = tyString then tk := Ord(tyAnsiString);
    tmps[nValues] := AllocVar(PyHiddenName('unp'), IntToTypeKind(tk));
    if IntToTypeKind(tk) = tyClass then
      Syms[tmps[nValues]].RecName := ResolveNodeRec(CurASTNode);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(tmps[nValues]);
    ASTRight[node] := CurASTNode;
    seq := PySeqAppend(seq, node);
    Inc(nValues);
  until not Eat(tkComma);
  { `pfx, content = cs` — ONE value for several targets means the value is a
    SEQUENCE to be indexed, not a shortfall. Our tuples are TPyLists, so this
    is the shape a function returning a tuple produces. }
  if (nValues = 1) and (nTargets > 1) then
  begin
    unpCi := PyNodeListCi(PyMakeIdent(tmps[0]));
    { A VARIANT value (e.g. `k, v = stack.pop()` — pop yields a variant holding a
      pair) is indexed at run time via pyvar_getitem, which unboxes to the list
      it holds. A static list uses TPyList.at. }
    if (unpCi < 0) and (IntToTypeKind(ASTTk[PyMakeIdent(tmps[0])]) <> tyVariant) then
      Error('Nil Python: cannot unpack this value into several names — it is '
            + 'not a list, tuple or variant');
    { With a STAR, the index of a target after it depends on the sequence's
      LENGTH, so the fixed ones are counted from each end and the starred one
      takes the slice between. `a, *rest = xs` -> a = xs[0], rest = xs[1:len].
      `*init, last = xs` -> init = xs[0:len-1], last = xs[len-1].
      unpTrail is how many fixed targets follow the star. }
    unpTrail := 0;
    if starAt >= 0 then
    begin
      unpTrail := nTargets - starAt - 1;
      { CPython raises ValueError when the source is shorter than the FIXED
        targets. Without this the indexed stores raise IndexError, a different
        type, so an `except ValueError` around the unpack would not catch it. }
      unpCnt := FindProc('pyunpack_check');
      if unpCnt < 0 then Error('Nil Python: pylib (pyunpack_check) not loaded');
      unpHi := AllocNode(AN_INT_LIT);
      ASTIVal[unpHi] := nTargets - 1;
      ASTTk[unpHi] := Ord(tyInteger);
      unpIdx := AllocNode(AN_ARG);
      ASTLeft[unpIdx] := unpHi;
      ASTRight[unpIdx] := -1;
      unpElem := AllocNode(AN_ARG);
      ASTLeft[unpElem] := PyMakeLenOf(PyMakeIdent(tmps[0]), unpCi);
      ASTRight[unpElem] := unpIdx;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := unpCnt;
      ASTLeft[node] := unpElem;
      ASTTk[node] := Ord(tyInteger);
      seq := PySeqAppend(seq, node);
    end;
    for i := 0 to nTargets - 1 do
    begin
      if (starAt >= 0) and (i = starAt) then
      begin
        { the surplus: xs[starAt : count - unpTrail]. The high bound is a
          RUNTIME expression, which is the whole reason a star cannot be a
          compile-time slot count. }
        unpIdx := AllocNode(AN_INT_LIT);
        ASTIVal[unpIdx] := starAt;
        ASTTk[unpIdx] := Ord(tyInteger);
        unpCnt := PyMakeLenOf(PyMakeIdent(tmps[0]), unpCi);
        if unpTrail = 0 then
          unpHi := unpCnt
        else
        begin
          unpElem := AllocNode(AN_INT_LIT);
          ASTIVal[unpElem] := unpTrail;
          ASTTk[unpElem] := Ord(tyInteger);
          unpHi := AllocNode(AN_BINOP);
          ASTIVal[unpHi] := Ord(tkMinus);
          ASTLeft[unpHi] := unpCnt;
          ASTRight[unpHi] := unpElem;
          ASTTk[unpHi] := Ord(tyInteger);
        end;
        unpElem := PyMakeSliceOf(PyMakeIdent(tmps[0]), unpIdx, unpHi, unpCi);
        { ...and force it to a LIST. The slice copies the source's kind, which
          is right for an ordinary slice (a slice of a tuple is a tuple) and
          wrong here: `a, *b = (1,2,3)` gives b == [2, 3] in CPython, a list. }
        if unpCi >= 0 then unpCnt := FindProc('pylist_mark_list')
        else unpCnt := FindProc('pyvar_mark_list');
        if unpCnt < 0 then Error('Nil Python: pylib (mark_list) not loaded');
        unpHi := AllocNode(AN_ARG);
        ASTLeft[unpHi] := unpElem;
        ASTRight[unpHi] := -1;
        unpIdx := AllocNode(AN_CALL);
        ASTIVal[unpIdx] := unpCnt;
        ASTLeft[unpIdx] := unpHi;
        ASTTk[unpIdx] := Ord(Procs[unpCnt].RetType);
        ASTRight[unpIdx] := ProcRetRecId[unpCnt];
        unpElem := unpIdx;
        if subIdx[i] >= 0 then
          node := PyMakeSubscriptStore(subBase[i], subIdx[i], unpElem)
        else
          node := PyUnpackTargetStore(names[i], flds[i], unpElem, tyVariant, REC_NONE);
        seq := PySeqAppend(seq, node);
        Continue;
      end;
      if (starAt >= 0) and (i > starAt) then
      begin
        { counted from the END: the k-th target after the star is
          xs[count - (nTargets - 1 - i) - 1] }
        unpCnt := PyMakeLenOf(PyMakeIdent(tmps[0]), unpCi);
        unpElem := AllocNode(AN_INT_LIT);
        ASTIVal[unpElem] := nTargets - i;
        ASTTk[unpElem] := Ord(tyInteger);
        unpIdx := AllocNode(AN_BINOP);
        ASTIVal[unpIdx] := Ord(tkMinus);
        ASTLeft[unpIdx] := unpCnt;
        ASTRight[unpIdx] := unpElem;
        ASTTk[unpIdx] := Ord(tyInteger);
      end
      else
      begin
        unpIdx := AllocNode(AN_INT_LIT);
        ASTIVal[unpIdx] := i;
        ASTTk[unpIdx] := Ord(tyInteger);
      end;
      if unpCi >= 0 then
      begin
        unpElem := PyCallMeth1(unpCi, 'at', PyMakeIdent(tmps[0]), unpIdx);
        if unpElem < 0 then Error('Nil Python: pylib (TPyList.at) not loaded');
      end
      else
        unpElem := PyMakeVariantGetItem(PyMakeIdent(tmps[0]), unpIdx);
      if subIdx[i] >= 0 then
        node := PyMakeSubscriptStore(subBase[i], subIdx[i], unpElem)
      else
        node := PyUnpackTargetStore(names[i], flds[i], unpElem, tyVariant, REC_NONE);
      seq := PySeqAppend(seq, node);
    end;
    Result := PyEmitNestedAsgUnpacks(seq);
    Exit;
  end;
  if starAt >= 0 then
    Error('Nil Python: a starred target needs ONE sequence to unpack '
          + '(`a, *rest = xs`); several values (`a, *rest = 1, 2, 3`) '
          + 'is not supported yet');
  if nValues <> nTargets then
    Error('Nil Python: not enough values to unpack');

  { then the stores }
  for i := 0 to nTargets - 1 do
  begin
    if subIdx[i] >= 0 then
      node := PyMakeSubscriptStore(subBase[i], subIdx[i], PyMakeIdent(tmps[i]))
    else
      node := PyUnpackTargetStore(names[i], flds[i], PyMakeIdent(tmps[i]),
                                  Syms[tmps[i]].TypeKind, Syms[tmps[i]].RecName);
    seq := PySeqAppend(seq, node);
  end;
  Result := PyEmitNestedAsgUnpacks(seq);
end;

{ Step over any `[...]` groups a target element ends with, so the lookahead
  below sees `h[i], h[j] = ...` as a target LIST. Without it the statement was
  not recognised as an unpack at all and the first name died as an expression
  statement ("undefined variable (a)" for `a, h[0] = ...`), which is the
  different message the ticket's mixed row records.
  bug-nilpy-tuple-assignment-to-subscript-targets-does-not-parse }
function PySkipTargetSubscripts(i: Integer): Integer;
var depth: Integer;
begin
  while (i < TokCount) and (Tokens[i].Kind = tkLBrack) do
  begin
    depth := 0;
    while i < TokCount do
    begin
      if Tokens[i].Kind = tkLBrack then Inc(depth)
      else if Tokens[i].Kind = tkRBrack then
      begin
        Dec(depth);
        if depth = 0 then begin Inc(i); Break; end;
      end;
      Inc(i);
    end;
  end;
  Result := i;
end;

function PySkipTargetGroup(i: Integer): Integer;
{ Step over a `(a, b)` group in a target list, answering the index just past its
  `)`, or -1 when it is not a plain comma-separated NAME list — a parenthesised
  expression, a call's arguments, anything deeper. -1 rather than the index, so
  the lookahead declines the whole statement instead of half-claiming it.
  feature-nilpy-starred-and-nested-unpacking }
var n: Integer;
begin
  Result := -1;
  if (i >= TokCount) or (Tokens[i].Kind <> tkLParen) then Exit;
  Inc(i);
  n := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind <> tkIdent then Exit;
    Inc(i); Inc(n);
    if (i < TokCount) and (Tokens[i].Kind = tkComma) then begin Inc(i); Continue; end;
    if (i < TokCount) and (Tokens[i].Kind = tkRParen) then
    begin
      if n < 2 then Exit;
      Result := i + 1;
      Exit;
    end;
    Exit;
  end;
end;

{ Does an `a, b = ...` target list start here? Only a bare comma-separated name
  list followed by `=` qualifies — anything else is left to the ordinary paths. }
function PyUnpackTargetAhead: Boolean;
var i, nstar: Integer; grp: Boolean;
begin
  grp := False;
  { A STAR is accepted as a target element now — `a, *rest = xs` and
    `*init, last = xs`. Exactly one, anywhere in the list, which is Python's own
    rule; a second one is left to PyParseUnpackAssign to refuse by name rather
    than being silently declined here (a decline reads as "undefined variable"
    at the first name, which is the message this whole area was fixed to stop
    producing). feature-nilpy-starred-and-nested-unpacking }
  Result := False;
  nstar := 0;
  i := TokPos - 1;                { the CURRENT token }
  if Tokens[i].Kind = tkStar then
  begin
    Inc(nstar);
    Inc(i);
    if (i >= TokCount) or (Tokens[i].Kind <> tkIdent) then Exit;
  end
  else if Tokens[i].Kind = tkLParen then
  begin
    { the FIRST element may be the group — `(a, b), c = ...`. A flag, not a
      look-back at Tokens[i-1]: after the skip, i points past the group's ')',
      and inferring "was that a group?" from the token behind it also answers
      yes for an ordinary name that merely follows a ')' on the previous line. }
    grp := True;
    i := PySkipTargetGroup(i);
    if i < 0 then Exit;
  end
  else if Tokens[i].Kind <> tkIdent then Exit;
  if not grp then
  begin
    Inc(i);                       { past the name }
    { an ATTRIBUTE target counts as one name — `self.x, self.y = x, y` }
    if (i + 1 < TokCount) and (Tokens[i].Kind = tkDot) and
       (Tokens[i + 1].Kind = tkIdent) then Inc(i, 2);
    i := PySkipTargetSubscripts(i);
  end;
  if (i >= TokCount) or (Tokens[i].Kind <> tkComma) then Exit;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkComma then
    begin
      Inc(i);
      if (i < TokCount) and (Tokens[i].Kind = tkStar) then
      begin
        Inc(nstar);
        if nstar > 1 then Exit;   { two stars: not ours, say so elsewhere }
        Inc(i);
      end;
      { a NESTED group is one target element — `a, (b, c) = ...`. Without this
        the list is not recognised as an unpack at all and the first NAME dies
        as an expression statement, which is the "undefined variable (a)"
        message this whole area exists to stop producing. }
      if (i < TokCount) and (Tokens[i].Kind = tkLParen) then
      begin
        i := PySkipTargetGroup(i);
        if i < 0 then Exit;
      end
      else
      begin
        if (i >= TokCount) or (Tokens[i].Kind <> tkIdent) then Exit;
        Inc(i);
        if (i + 1 < TokCount) and (Tokens[i].Kind = tkDot) and
           (Tokens[i + 1].Kind = tkIdent) then Inc(i, 2);
        i := PySkipTargetSubscripts(i);
      end;
    end
    else if Tokens[i].Kind = tkAssign then begin Result := True; Exit; end
    else Exit;
  end;
end;

{ An unpacking target we do not support YET — a STAR (`a, *rest = xs`) or a
  NESTED group (`a, (b, c) = ...`). PyUnpackTargetAhead requires every element to
  be a plain name, so these fall through to the ordinary expression statement and
  die on the FIRST name with `undefined variable (first)` — a message pointing at
  a perfectly good name, indistinguishable from a typo in the user's own code.
  The forms are unsupported, not wrong; say so.

  Deliberately narrow, because a false positive here would reject valid code: the
  statement must OPEN the target (an ident or a leading star), there must be a
  depth-0 `=` before the end of the logical line, and the star or `(` must sit
  where a target element begins — at the start or straight after a depth-0 comma.
  feature-nilpy-starred-and-nested-unpacking. }
function PyUnsupportedUnpackTargetAhead(var isStar: Boolean): Boolean;
var i, depth: Integer; atElem, sawComma: Boolean;
begin
  Result := False;
  isStar := False;
  if not (CurTok.Kind in [tkIdent, tkStar]) then Exit;
  isStar := CurTok.Kind = tkStar;
  if isStar then Result := True;
  atElem := False;
  sawComma := False;
  depth := 0;
  i := TokPos - 1;                { re-read the current token too }
  while i < TokCount do
  begin
    { end of the logical line with no depth-0 `=` seen: not an assignment target
      at all. Must clear Result, which a star or a group may already have set —
      otherwise `for n, (p, q) in xs:` (no `=` anywhere) is reported as a nested
      ASSIGNMENT target, stealing the for-loop's own diagnostic. }
    if Tokens[i].Kind in [tkNewline, tkDedent, tkEOF, tkSemicolon] then
    begin
      Result := False;
      Exit;
    end;
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then
    begin
      { a group where a target ELEMENT begins is a nested target }
      if (depth = 0) and atElem and (Tokens[i].Kind = tkLParen) then Result := True;
      Inc(depth);
    end
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkComma) then
    begin
      sawComma := True;
      atElem := True;
      Inc(i);
      Continue;
    end
    else if (depth = 0) and (Tokens[i].Kind = tkStar) and atElem then
    begin
      Result := True;
      isStar := True;
    end
    else if (depth = 0) and (Tokens[i].Kind = tkAssign) then
    begin
      { a plain `a = ...` is not an unpack at all }
      Result := Result and sawComma;
      Exit;
    end;
    atElem := False;
    Inc(i);
  end;
  Result := False;   { no `=` on this line — not an assignment target }
end;

{ Does the statement start `name[...]` and CONTINUE into `.member`? That is a
  STORE target this parser never admitted — `xs[0].n = 9`, the ordinary Python
  spelling for mutating an object held in a list — because the branch below is
  entered only on `name .`. Reading the same chain always worked, and so did
  `xs[0].n += 1`, which is why it failed loudly and narrowly: only the plain-`=`
  spelling had nowhere to go.
  Deliberately NOT true for a bare `xs[0] = v`, which has its own lowering
  (setitem) and must keep it — the '.' after the closing bracket is the whole
  test.
  bug-nilpy-assigning-to-an-attribute-of-a-list-element-does-not-parse }
function PySubscriptThenMemberAhead: Boolean;
var j, depth: Integer;
begin
  Result := False;
  if (CurTok.Kind <> tkIdent) or (TokPos >= TokCount) then Exit;
  if Tokens[TokPos].Kind <> tkLBrack then Exit;
  j := TokPos;
  depth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkLBrack then Inc(depth)
    else if Tokens[j].Kind = tkRBrack then
    begin
      Dec(depth);
      if depth = 0 then
      begin
        { another subscript may follow — `grid[i][j].n` }
        if (j + 1 < TokCount) and (Tokens[j + 1].Kind = tkLBrack) then
        begin
          Inc(j);
          Continue;
        end;
        Result := (j + 1 < TokCount) and (Tokens[j + 1].Kind = tkDot);
        Exit;
      end;
    end
    else if Tokens[j].Kind in [tkNewline, tkEOF] then Exit;
    Inc(j);
  end;
end;

function PyParseStatement: Integer;
var name: AnsiString; symIdx, lhsNode, node, ci, rhsNode, annIdx, delBase: Integer; tk: TTypeKind;
    unpStar: Boolean;   { the unsupported-unpack diagnostic below }
    annSig: Integer;   { Callable signature of an annotated target, or -1 }
    augTk: TTokenKind;
    mmi, mpi, selfArg, lastArg, argNode, kwIdx, j, k: Integer;   { inherited (super()) call }
    cmpTmp, cmpSeq, cmpAsgn: Integer;   { comprehension into a non-list target }
    cmpExisted: Boolean;
    asrtCond, asrtMsg, asrtProc, asrtA0, asrtA1: Integer;   { assert statement }
    chainN, chainI, chainTmp, chainSeq: Integer;   { chained assignment a = b = v }
    chainNames: array[0..7] of AnsiString;
    delCi, delRecv, delKey: Integer;   { `del c[k]` on a user class }
    delSavedInDel: Boolean;
    setOp: AnsiString;                 { the in-place set op for |= &= ^= -= }
begin
  Result := -1;
  PyStmtAteBlock := False;
  PyExprHadOptionalMissing := False;
  { `nonlocal x, y` / `global x, y` — a scope DECLARATION, parsed and skipped.
    The nested-def capture already exposes the enclosing name for reading; a
    WRITE does not yet propagate back to the enclosing frame (capture is
    by-value) — filed as feature-nilpy-nonlocal-write-propagation. }
  if PyIsIdent('nonlocal') or PyIsIdent('global') then
  begin
    Next;
    while CurTok.Kind = tkIdent do
    begin
      Next;
      if not Eat(tkComma) then Break;
    end;
    Result := -1;
    Exit;
  end;
  if PyUnpackTargetAhead then begin Result := PyParseUnpackAssign; Exit; end;
  { ...and if it is an unpacking target of a shape we do not support yet, say
    which shape. Untouched, `first, *rest = xs` reached the ordinary expression
    path and reported `undefined variable (first)` — pointing at a name that is
    fine, and reading like a typo rather than a missing feature. }
  if PyUnsupportedUnpackTargetAhead(unpStar) then
  begin
    if unpStar then
      Error('Nil Python: a STARRED assignment target (`a, *rest = xs`) is not '
            + 'supported yet — assign the sequence and slice it '
            + '(`rest = xs[1:]`)')
    else
      Error('Nil Python: a NESTED assignment target (`a, (b, c) = ...`) is not '
            + 'supported yet — unpack the outer level first, then the inner');
  end;
  { Nested `def`: register the shell here (the enclosing body's calls resolve
    against it), remember where the body starts, and skip it — PyParseDef
    compiles the queued bodies after its own epilogue, because emitting one in
    place would drop it into the middle of the enclosing routine's code
    (feature-nilpy-nested-defs). }
  if CurTok.Kind = tkFunction then begin Result := PyQueueNestedDef; Exit; end;
  if CurTok.Kind = tkIf then begin Result := PyParseIf; Exit; end;
  if CurTok.Kind = tkWhile then begin Result := PyParseLoopMaybeElse(False); Exit; end;
  if CurTok.Kind = tkTry then
  begin
    { the fallback-import idiom is decided at compile time, not caught at
      runtime — see PyParseFallbackImportTry }
    if PyIsFallbackImportTry then Result := PyParseFallbackImportTry
    else Result := PyParseTry;
    Exit;
  end;
  if PyIsIdent('with') then begin Result := PyParseWith; Exit; end;
  { `raise <expr>` and bare `raise` (re-raise inside a handler). }
  if CurTok.Kind = tkRaise then
  begin
    Next;
    node := AllocNode(AN_RAISE);
    if CurTok.Kind in [tkNewline, tkDedent, tkEOF] then
      ASTLeft[node] := -1
    else
    begin
      { the bare CLASS form first — `raise StopIteration`, `raise ValueError`,
        which is how an exception carrying no message is normally written (and
        how an `__next__` body ends). CPython instantiates it; so does this,
        through the ordinary ctor path. Anything else falls through unchanged. }
      if (CurTok.Kind = tkIdent) and (TokPos <= TokCount) and
         ((Tokens[TokPos].Kind in [tkNewline, tkDedent, tkEOF]) or
          ((Tokens[TokPos].Kind = tkIdent) and
           CaseEqual(GetTokenStr(TokPos), 'from'))) and
         (PyRaiseBareClassCi(CurTok.SVal) >= 0) then
      begin
        PyCtorNoParens := True;
        CurASTNode := PyClassCreate;
        LastExprTk := tyClass;
      end
      else
      PyParseBoolExpr;
      { A VARIANT operand — `raise xs[0]`, `raise d[k]`, `raise cls(msg)`
        through a class value, a for-in variable. IR_RAISE wants the instance
        POINTER; handed the 16-byte variant it jumped through the tag word and
        SEGFAULTED, with no diagnostic. `raise E("x")` and `raise e` on a
        class-typed local were always fine, so this is the variant arm of the
        same static-vs-variant split `__eq__` had
        (bug-nilpy-raising-a-variant-segfaults).

        Unboxed to Exception rather than to a specific class: the static type
        is exactly what a variant does not have, and it is not needed — handler
        matching reads the object's own VMT, so the base class is the honest
        static answer. A non-object tag unboxes to nil and pyraise_check turns
        that into the TypeError CPython raises for `raise 5`. }
      { ...and the same for any operand that is not a class at all — `raise 42`,
        `raise "x"`, `raise 3.5`. Those never reached the variant arm (an int
        literal is tyInteger, not tyVariant), so the raw value went to IR_RAISE
        where an instance pointer belongs and the process died with no
        diagnostic — where CPython gives the very TypeError this check exists to
        produce. Boxed first, so one path answers for every non-instance shape.
        bug-nilpy-raise-of-a-bare-exception-class-is-refused-at-runtime }
      if (PyLibExceptionCi >= 0) and
         (IntToTypeKind(ASTTk[CurASTNode]) <> tyClass) then
        CurASTNode := PyUnboxVariantToClass(
                        PyRaiseCheckVariant(PyForceVariant(CurASTNode)),
                        PyLibExceptionCi);
      ASTLeft[node] := CurASTNode;
      { `raise X from e` — PEP 3134 exception chaining. The cause is metadata
        (it sets __cause__ for the traceback); the raise itself is unchanged, so
        `from EXPR` is consumed and dropped. }
      if PyIsIdent('from') then
      begin
        Next;
        PyParseBoolExpr;
      end;
    end;
    Result := node;
    Exit;
  end;
  { `assert cond` / `assert cond, msg`. Lowered to a pylib call rather than an
    if/raise tree: the CONDITION goes through PyMakeTruthy, so Python's
    truthiness rules for str/containers/None are the same ones every other
    condition uses instead of a second copy, and pyassert raises a catchable
    AssertionError. The message is optional and defaults to EMPTY — CPython's
    bare `assert x` gives str(e) == '', not a synthesised description.
    bug-nilpy-assert-statement-not-supported }
  if PyIsIdent('assert') then
  begin
    Next;
    PyParseBoolExpr;
    asrtCond := PyMakeTruthy(CurASTNode);
    if CurTok.Kind = tkComma then
    begin
      Next;
      PyParseBoolExpr;
      asrtMsg := CurASTNode;
    end
    else
    begin
      asrtMsg := AllocNode(AN_STR_LIT);
      ASTSOffset[asrtMsg] := 0;
      ASTSLen[asrtMsg] := 0;
      ASTTk[asrtMsg] := Ord(tyAnsiString);
    end;
    asrtProc := FindProc('pyassert');
    if asrtProc < 0 then Error('Nil Python: pylib (pyassert) not loaded');
    asrtA1 := AllocNode(AN_ARG); ASTLeft[asrtA1] := asrtMsg; ASTRight[asrtA1] := -1;
    asrtA0 := AllocNode(AN_ARG); ASTLeft[asrtA0] := asrtCond; ASTRight[asrtA0] := asrtA1;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := asrtProc;
    ASTLeft[Result] := asrtA0;
    ASTTk[Result] := Ord(tyUnknown);
    Exit;
  end;
  if (CurTok.Kind = tkFor) or PyIsIdent('for') then begin Result := PyParseLoopMaybeElse(True); Exit; end;
  if PyIsIdent('pass') then begin Next; Exit; end;
  { `yield E` — Nil Python generator. No lexer token: `yield` arrives as an
    ordinary identifier and is recognised here, at statement position, the same
    way `pass` is. The def containing it was already marked a stackless
    generator by PyDefBodyHasYield (Python decides generator-ness from the body
    at compile time), so the context flag is set before this body is parsed —
    which is why the check below is an internal error rather than the user
    diagnostic: a yield outside a def is caught by the marking pass. The node is
    the SAME AN_YIELD the Pascal frontend builds, and it lowers through the same
    stackless state-machine transform (SLLowerYield, parser.inc). }
  if PyIsIdent('yield') then
  begin
    if not CurProcIsStackless then
      Error('Nil Python: yield outside a function body');
    Next;
    { A bare `yield` yields None. }
    if CurTok.Kind in [tkNewline, tkDedent, tkEOF, tkSemicolon] then
      node := PyMakeNone
    else
    begin
      PyParseBoolExpr;
      { `yield a, b, c` yields a TUPLE, exactly as `return a, b` returns one —
        html5lib's optionaltags slider is written that way. The same builder, so
        the two spellings cannot drift apart. }
      if CurTok.Kind = tkComma then
        node := PyMakeTupleFrom(CurASTNode)
      else
        node := CurASTNode;
    end;
    Result := AllocNode(AN_YIELD);
    ASTLeft[Result] := node;
    ASTIVal[Result] := -1;   { stackful self sym; the stackless lowering passes its own }
    CurGenSeenYield := True;
    Exit;
  end;
  { `break` / `continue`. The lexer already maps break to tkBreak, but no
    statement rule ever consumed either, so both died as "expected expression"
    INSIDE a loop that otherwise worked — including a plain while. }
  if (CurTok.Kind = tkBreak) or PyIsIdent('break') then
  begin
    Next;
    Result := AllocNode(AN_BREAK);
    { record that THIS loop was left by a break, so its `else` is skipped.
      PyLoopElseFlag is the innermost loop's flag and is -1 unless that loop
      actually has an else clause, so nothing is emitted for a normal break. }
    if PyLoopElseFlag >= 0 then
      Result := PySeqAppend(PySeqAppend(-1, PyMakeFlagSet(PyLoopElseFlag, True)), Result);
    Exit;
  end;
  if (CurTok.Kind = tkContinue) or PyIsIdent('continue') then
  begin
    Next;
    Result := AllocNode(AN_CONTINUE);
    Exit;
  end;
  { `del d[k]` -> d.remove(k). Only the dict-subscript form is supported; the
    other censused use is `del lst[a:]`, which needs slices and is not this
    ticket. Parsed as a statement rather than through the expression grammar
    because `d[k]` on its own would compile to a subscript READ. }
  { An `import` in the body — Python allows one anywhere, and a real file puts a
    block of them after its docstring or a try/except. Same code as the leading
    run (PyParseImportRun); before this they were consumed and dropped. }
  if (CurTok.Kind = tkUses) or (PyIsIdent('from') and (TokPos < TokCount) and
      (Tokens[TokPos].Kind in [tkIdent, tkDot])) then
  begin
    { ONE import statement, not a run: inside a block the trailing NEWLINE
      terminates the statement and belongs to the block parser, while
      PyParseImportRun skips newlines to reach the next import — which made the
      following line read as a continuation. The unit is registered exactly as
      the run would; only the newline handling differs.
      bug-nilpy-function-level-import-drops-body. }
    PyParseOneImport;
    Result := -1;
    Exit;
  end;
  if PyIsIdent('del') then
  begin
    Next;
    { `del name` on a plain LOCAL is accepted and emits nothing. Python unbinds
      the name, so a later read raises NameError; NilPy has no binding to remove
      and does not diagnose that later read — laxity in the same direction as
      the keyword-only marker (we accept programs CPython rejects, and run every
      program we accept the same way). The censused use is `del sections` as an
      explicit "this parameter is deliberately unused". }
    if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind in [tkNewline, tkDedent, tkEOF]) and
       (FindSym(CurTok.SVal) >= 0) then
    begin
      Next;
      Result := -1;
      Exit;
    end;
    { Parse the whole `d[k]` normally — it lowers to TPyDict.fetch(d, k) via
      the default indexed property — then REWRITE that call to .remove(d, k).
      Parsing the base and the subscript separately would mean re-implementing
      the postfix grammar (`del vm.file_handles[fid]` has a field base), which
      is exactly the duplication this frontend keeps getting bitten by. }
    { see PyInDelTarget: a del TARGET is not a read, so the getter-less
      not-subscriptable refusal must not claim it — a class declaring only
      __delitem__ needs the plain AN_INDEX this rewrite reads back. }
    delSavedInDel := PyInDelTarget;
    PyInDelTarget := True;
    PyParseBoolExpr;
    PyInDelTarget := delSavedInDel;
    delBase := CurASTNode;
    { `del l[lo:hi]` — the read lowered to a pylist_slice COPY; swap the proc to
      the in-place delete (same l, lo, hi arguments). }
    if (ASTKind[delBase] = AN_CALL) and (FindProc('pylist_slice') >= 0) and
       (ASTIVal[delBase] = FindProc('pylist_slice')) then
    begin
      symIdx := FindProc('pylist_del_slice');
      if symIdx < 0 then Error('Nil Python: pylib (pylist_del_slice) not loaded');
      ASTIVal[delBase] := symIdx;
      ASTTk[delBase] := Ord(Procs[symIdx].RetType);
      Result := delBase;
      Exit;
    end;
    { `del l[i]` — the read lowered to TPyList.at(l, i); swap it for the
      in-place single-element delete, which takes the index as ONE argument so
      the index expression is not duplicated (`del l[f()]` must call f once).
      bug-nilpy-del-of-a-list-index-is-unsupported }
    ci := FindUClass('TPyList');
    symIdx := -1;
    if ci >= 0 then symIdx := FindUMeth(ci, 'at');
    if (symIdx >= 0) and (ASTKind[delBase] = AN_CALL) and
       (ASTIVal[delBase] = UMthProc_[symIdx]) then
    begin
      symIdx := FindProc('pylist_del_at');
      if symIdx < 0 then Error('Nil Python: pylib (pylist_del_at) not loaded');
      ASTIVal[delBase] := symIdx;
      ASTTk[delBase] := Ord(Procs[symIdx].RetType);

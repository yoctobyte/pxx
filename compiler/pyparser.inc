        begin
          { A hand-written __init__ rather than a @dataclass: fill the hole from
            the CTOR PARAMETER's declared default, the same table the trailing
            fill below reads. Without this, keyword arguments had to cover a
            contiguous PREFIX of the parameters, so skipping one optional was an
            error — `W(master, text="x")` with a `width` in between. That is the
            normal shape of every widget call a tkinter-style façade takes
            (`tk.Canvas(self, highlightthickness=0)`), which is what made such a
            façade impossible to write. Param 0 is self, so user arg kwI is
            param kwI+1. }
          kwCtorMi := FindUMeth(ci, 'create');
          if kwCtorMi < 0 then
            Error('Nil Python: ' + name + '() has no constructor to take defaults from');
          kwCtorPi := UMthProc_[kwCtorMi];
          kwPk := kwI + 1;
          if (kwPk >= MAX_PROC_PARAMS) or
             (not ProcParamHasDefault[kwCtorPi * MAX_PROC_PARAMS + kwPk]) then
            Error('Nil Python: ' + name + '() is missing a value for parameter ' +
                  AIntToStr(kwI + 1) + ', which has no default');
          if ProcParamDefaultIsStr[kwCtorPi * MAX_PROC_PARAMS + kwPk] then
          begin
            kwVal := AllocNode(AN_STR_LIT);
            ASTSOffset[kwVal] := ProcParamDefaultSOff[kwCtorPi * MAX_PROC_PARAMS + kwPk];
            ASTSLen[kwVal] := ProcParamDefaultSLen[kwCtorPi * MAX_PROC_PARAMS + kwPk];
            ASTTk[kwVal] := Ord(tyString);
          end
          else if ProcParamDefaultIsFloat[kwCtorPi * MAX_PROC_PARAMS + kwPk] then
          begin
            kwVal := AllocNode(AN_FLOAT_LIT);
            ASTIVal[kwVal] := ProcParamDefaultVal[kwCtorPi * MAX_PROC_PARAMS + kwPk];
            ASTTk[kwVal] := Ord(tyDouble);
          end
          else if Procs[kwCtorPi].Params[kwPk].TypeKind = tyVariant then
            { A VARIANT hole. Two things go wrong with a bare ordinal here: the
              parameter is passed by REFERENCE, so the callee dereferences it
              (`tk.Label(root, textvariable=sv)` skipped `font` and segfaulted),
              and a library's `= 0` means "not supplied", which every façade
              reads as `pyvartag(v) <> 0`. None is both — an addressable empty
              variant. Same rule as DefaultArgValueNode, which the non-ctor
              paths use. }
            kwVal := PyMakeNone
          else
          begin
            kwVal := AllocNode(AN_INT_LIT);
            ASTIVal[kwVal] := ProcParamDefaultVal[kwCtorPi * MAX_PROC_PARAMS + kwPk];
            { the LITERAL's type, not the parameter's: tagged as the parameter's
              it looked like a value that needed no conversion, and the
              call-argument boxing never ran }
            ASTTk[kwVal] := Ord(Procs[kwCtorPi].Params[kwPk].TypeKind);
          end;
          argNode := AllocNode(AN_ARG);
          ASTLeft[argNode] := kwVal;
          ASTRight[argNode] := -1;
        end;
      end;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
    nArgs := kwMax + 1;
  end;
  { A hand-written ctor's declared parameter DEFAULTS. PyClassCreate builds
    the call itself — GetMem size, then the user args — so it never passes
    through the shared path that fills omitted trailing args, and `C()` on a
    ctor with defaults handed the body uninitialised stack (a segfault, not a
    diagnostic). Param 0 is self, so user arg n is param n+1. }
  ctorMi := FindUMeth(ci, 'create');
  if ctorMi >= 0 then
  begin
    ctorPi := UMthProc_[ctorMi];
    { `*args` / `**kwargs` on the CONSTRUCTOR. This builder assembles the call
      itself — GetMem size, then the user arguments — and so, as the comment
      above says, never passes through the shared path; that path is also where
      the surplus arguments get packed into the star parameter's TPyList. It
      did not happen at all here, so `C(1, 2)` on `def __init__(self, *args)`
      handed the ctor a raw 2 where a list pointer belongs and SEGFAULTED, with
      no diagnostic. The plain-`def` and ordinary-METHOD twins both worked,
      which is what said the packing machinery is fine and one construction
      path skipped it (bug-nilpy-a-fixed-parameter-before-star-args-segfaults).

      selfSlots = 1: the chain here holds only the user arguments, while the
      ctor's signature counts Self at slot 0. Packing runs BEFORE the
      trailing-defaults loop below, which then finds every slot filled and does
      nothing — PyPackStarArgs fills the gap itself, keyword bindings included. }
    if (ProcPyStarIdx[ctorPi] >= 0) or (ProcPyKwIdx[ctorPi] >= 0) then
    begin
      { the keywords destined for **kwargs, appended after the slot-ordered
        chain: PyPackStarArgs pulls every negatively-marked node out into the
        dict, so their position among the others does not matter — only that
        they are IN the chain it walks }
      if kwExtraHead >= 0 then
      begin
        if lastArg >= 0 then ASTRight[lastArg] := kwExtraHead
        else ASTRight[szArgNode] := kwExtraHead;
        lastArg := kwExtraLast;
      end;
      starHead := ASTRight[szArgNode];
      PyPackStarArgs(ctorPi, starHead, lastArg, nArgs, 1);
      ASTRight[szArgNode] := starHead;
      if lastArg < 0 then lastArg := szArgNode;
    end;
    while nArgs < Procs[ctorPi].ParamCount - 1 do
    begin
      k := nArgs + 1;
      if (k >= MAX_PROC_PARAMS) or
         (not ProcParamHasDefault[ctorPi * MAX_PROC_PARAMS + k]) then Break;
      { DefaultArgValueNode, not a private copy of it. This loop used to build
        the value itself and had drifted from that funnel in two ways, both
        silent:

          - it never consulted ProcParamDefaultSym, so a NON-CONSTANT ctor
            default (`def __init__(self, items=[])`) ignored the hidden global
            evaluated at class-body time;
          - it mapped EVERY tyVariant parameter to None, where the funnel does
            that only when the default really IS None (or the routine is a
            library façade whose `= 0` means "not supplied"). An unannotated
            parameter is tyVariant, so `def __init__(self, v=7)` — a plain
            CONSTANT — filled v with None.

        That second one is why the constructor half of
        bug-nilpy-non-constant-parameter-defaults-silently-become-none looked
        unrelated to non-constant defaults at all: it broke for `v=7` too.
        bug-nilpy-constructor-parameter-defaults-are-ignored.

        The ProcParamHasDefault guard above is what keeps the funnel's
        "no default" Error unreachable from here. }
      valNode := DefaultArgValueNode(ctorPi, k);
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := valNode;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(nArgs);
    end;
  end;
  { @dataclass: fill omitted trailing args from field defaults. }
  { An INHERITED constructor whose remaining parameters are still unfilled.
    `class E(Exception): pass` then `E()` is the case that matters: NilPy's
    `Exception` resolves to the RTL's, whose `Create(msg)` takes a REQUIRED
    message, and the default-fill loop above stops at a parameter with no
    declared default. The call was emitted one argument short, so the callee
    read whatever was in the register as its message — a segfault, or a silent
    skip of the `except` clause, depending on the build
    (bug-nilpy-raise-of-empty-exception-subclass-with-no-args).

    `Exception()` with no arguments is valid Python and `str(Exception())` is
    the empty string, so an empty message is the right value rather than a
    diagnostic. Restricted to STRING parameters: those are the ones with a
    meaningful empty value, and it keeps this from quietly papering over an
    under-called ctor of any other shape, which should stay visible. }
  { The OPPOSITE of the under-call above: MORE arguments than the inherited
    ctor takes. `raise MyErr("boom", 42)` on `class MyErr(Exception): pass` is
    ordinary Python — Exception takes *args and str(e) renders the TUPLE — but
    the RTL's Create(msg) takes exactly one, so the surplus arguments were
    emitted anyway and the call SEGFAULTED. Not only on `raise`: a bare
    `e = MyErr("a", 1)` crashed too, so a program could die building a value it
    never threw.
    Folded into the single message CPython would print: '(' + repr(a) + ', ' +
    ... + ')'. One argument is left completely alone — `str(MyErr("boom"))` is
    `boom`, not `('boom',)` — which is why this only fires above one.
    bug-nilpy-multi-arg-exception-constructor-segfaults }
  { ONE argument that is not a string — `raise KeyError(42)`, `ValueError(3.5)`,
    ordinary Python and a SEGFAULT here: every builtin exception's Create takes
    `const m: AnsiString`, so the integer was read as a string handle and the
    process died at the raise with no diagnostic
    (bug-nilpy-raise-keyerror-with-a-non-string-argument-segfaults).

    Two shapes, because KeyError is the one builtin whose str() is the REPR of
    its argument: KeyError's ctor now takes a VARIANT and reprs it itself (so
    `args` keeps the key's own type and an int key stays unquoted), while every
    other exception keeps its string ctor and gets the argument rendered by
    pyexc_msgstr — CPython's str(). Both run BEFORE the multi-arg fold's
    condition is read, and neither can fire with it: this is nArgs = 1, that is
    nArgs > 1. }
  if (ctorMi >= 0) and (nArgs = 1) and (Procs[ctorPi].ParamCount - 1 = 1) then
  begin
    excFoldCi := PyLibExceptionCi;
    if (excFoldCi >= 0) and ((ci = excFoldCi) or IsSubclassOf(ci, excFoldCi)) then

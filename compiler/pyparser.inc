      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := excFoldStr;
      ASTRight[argNode] := -1;
      ASTRight[ASTLeft[node]] := argNode;
      lastArg := argNode;
      nArgs := 1;
    end;
  end;
  if (ci < PY_MAX_DC_FIELDS) and PyDcClassIsDc[ci] then
  begin

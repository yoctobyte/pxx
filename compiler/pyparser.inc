    dcBase := -1; k := 0;
    for i := 0 to PyDcCount - 1 do
      if PyDcCi[i] = ci then begin dcBase := i; break; end;
    if dcBase >= 0 then
      while nArgs < UClsFCount[ci] do
      begin
        valNode := PyDcDefaultNode(ci, dcBase, nArgs);
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := valNode;
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
        Inc(nArgs);
      end;
  end;
  { Any STRING parameter still unsupplied gets an empty literal. This runs LAST,
    AFTER the dataclass defaults above — it used to run BEFORE them and filled
    every trailing string slot with '', so a @dataclass `s: str = "t"` silently
    defaulted to the empty string while the int/float/bool defaults beside it
    were all correct. It also meant PyDcDefaultNode was never reached for a str
    field at all, which is what made this so hard to localise: three separate
    default-builders could each be proved NOT to be in the path, because the
    slot had already been consumed here.
    bug-nilpy-dataclass-str-field-default-is-dropped }
  { …and the same for the one exception whose message parameter is a VARIANT
    (KeyError, see above): `raise KeyError()` is valid Python. Filled with None
    rather than an empty literal because an empty VARIANT is what the ctor reads
    as "no argument"; a boxed '' would be a real empty-string key. Narrow to the
    exception tree on purpose — filling any class's unsupplied variant slot
    would paper over under-calls that should stay visible. }
  if (ctorMi >= 0) and (nArgs = 0) and (Procs[ctorPi].ParamCount - 1 = 1) and
     (Procs[ctorPi].Params[1].TypeKind = tyVariant) then
  begin
    excFoldCi := PyLibExceptionCi;
    if (excFoldCi >= 0) and ((ci = excFoldCi) or IsSubclassOf(ci, excFoldCi)) then
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := PyMakeNone;
      ASTRight[argNode] := -1;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(nArgs);
    end;
  end;
  if ctorMi >= 0 then
    while (nArgs < Procs[ctorPi].ParamCount - 1) and
          (nArgs + 1 < MAX_PROC_PARAMS) and
          (Procs[ctorPi].Params[nArgs + 1].TypeKind in [tyString, tyAnsiString]) do
    begin
      valNode := AllocNode(AN_STR_LIT);
      ASTSOffset[valNode] := 0;
      ASTSLen[valNode] := 0;
      ASTTk[valNode] := Ord(tyString);
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := valNode;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(nArgs);
    end;
  Result := node;
  { ...and the multi-argument exception fold's tuple is stashed into argsv by
    WRAPPING the construction, because there is no statement position between
    building the exception object and raising it. pyexc_setargs returns the
    exception, so the whole thing stays one expression.
    bug-nilpy-multi-arg-exception-args-is-a-1-tuple-of-rendered-text }
  if excArgsTup >= 0 then
  begin
    excFoldPi := FindProc('pyexc_setargs');
    if excFoldPi < 0 then Error('Nil Python: pylib (pyexc_setargs) not loaded');
    excFoldA := AllocNode(AN_ARG);
    ASTLeft[excFoldA] := excArgsTup;
    ASTRight[excFoldA] := -1;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := Result;
    ASTRight[argNode] := excFoldA;
    excFoldC := AllocNode(AN_CALL);
    ASTIVal[excFoldC] := excFoldPi;
    ASTTk[excFoldC] := Ord(tyClass);
    ASTRight[excFoldC] := ASTRight[Result];    { keep the record identity }
    ASTLeft[excFoldC] := argNode;
    Result := excFoldC;
  end;
  { PXXDBG=n.ctorargs — every construction's slot kinds and types. This is the
    probe that disproved the recorded root cause of
    bug-nilpy-slice-of-variant-local-returned-is-unusable (the argument was
    tyVariant in BOTH passes, not mis-tagged tyClass); it cost a source patch
    and a self-compile to ask that question then. }
  if PxxDbgEnabled('n.ctorargs') then
  begin
    Write('PXXDBG n.ctorargs ', name, ' trial=', Ord(PyTypingPass));
    argNode := ASTRight[ASTLeft[node]];
    k := 0;
    while argNode >= 0 do
    begin
      Write(' [', k, ']kind=', ASTKind[ASTLeft[argNode]],
            ',tk=', ASTTk[ASTLeft[argNode]]);
      argNode := ASTRight[argNode];
      Inc(k);
    end;
    WriteLn;
  end;
  { CLASS ATTRIBUTES (`name = "note_counting"` at class level): give the new
    instance its own copy. Python attaches them to the CLASS and reads them
    through the instance, which is indistinguishable from this for every read —
    the difference is only visible if the CLASS attribute is rebound at run time
    to change existing instances, which nothing here does.

    Emitted as hoisted stores on a temp, so they land AFTER the constructor. A
    class with a constructor is therefore REFUSED rather than silently having
    its ctor's own writes overwritten — that is the one case where "after" is
    the wrong order and guessing would be silent corruption. }
  { The whole ANCESTOR CHAIN, not just this class: a subclass declares none of
    the parent's class attributes, so filtering on `ci` alone ran no stores at
    all for `class Sub(Base): pass` and `Sub().kind` read a zeroed field —
    silently, because the field IS inherited and only its value was missing
    (bug-nilpy-inherited-class-attribute-empty-on-a-subclass-instance). }
  attrAny := False;
  for attrD := PyClassDepth(ci) - 1 downto 0 do
  begin
    attrCur := PyClassAncestorAt(ci, attrD);
    for i := 0 to PyClsAttrCount - 1 do
      if PyClsAttrCi[i] = attrCur then attrAny := True;
    { ...and the NON-literal ones, which live in a hidden global apiece rather
      than in the constant table (PyEmitClassAttrExpr). They are found by name,
      from the DECLARING class's own field list — the global is named after the
      class that declared the attribute, not after the one being constructed. }
    for i := 0 to UClsFCount[attrCur] - 1 do
      if FindSym(PyClsAttrGlobalName(attrCur,
           PyRawName(UFldNOff[UClsFBase[attrCur] + i],
                     UFldNLen[UClsFBase[attrCur] + i]))) >= 0 then
        attrAny := True;
  end;
  { A class WITH a constructor applies its class attributes at the head of that
    constructor (PyClassAttrInitSeq), which is Python's order — before
    `__init__` runs, so `__init__` can overwrite them. Only a class without one
    needs the hoisted-temp form below, where "after" is the only order there is
    and nothing can be overwritten. }
  if attrAny and (FindUMeth(ci, 'create') >= 0) then attrAny := False;
  if attrAny then
  begin
    attrSym := AllocVar(PyHiddenName('clsattr'), tyClass);
    Syms[attrSym].RecName := recId;
    SymSyncTypeRef(attrSym);
    attrAsgn := AllocNode(AN_ASSIGN);
    ASTLeft[attrAsgn] := PyMakeIdent(attrSym);
    ASTRight[attrAsgn] := node;
    PyHoistStmt(attrAsgn);
    { ROOT FIRST, so a subclass that redeclares an attribute stores last and its
      value is the one the instance keeps. }
    for attrD := PyClassDepth(ci) - 1 downto 0 do
    begin
      attrCur := PyClassAncestorAt(ci, attrD);
      for i := 0 to PyClsAttrCount - 1 do
        if PyClsAttrCi[i] = attrCur then
        begin
          attrFld := AllocNode(AN_FIELD);
          ASTLeft[attrFld] := PyMakeIdent(attrSym);
          ASTSOffset[attrFld] := PyClsAttrNOff[i];
          ASTSLen[attrFld] := PyClsAttrNLen[i];
          attrFi := FindUField(ci, PyRawName(PyClsAttrNOff[i], PyClsAttrNLen[i]));
          if attrFi >= 0 then ASTTk[attrFld] := UFldTk[attrFi]
          else ASTTk[attrFld] := Ord(tyVariant);
          attrAsgn := AllocNode(AN_ASSIGN);
          ASTLeft[attrAsgn] := attrFld;
          ASTRight[attrAsgn] := PyClsAttrNode(i);
          PyHoistStmt(attrAsgn);
        end;
      { the non-literal ones: copy the shared value out of its hidden global }
      for i := 0 to UClsFCount[attrCur] - 1 do
      begin
        attrFi := UClsFBase[attrCur] + i;
        attrGSym := FindSym(PyClsAttrGlobalName(attrCur,
                      PyRawName(UFldNOff[attrFi], UFldNLen[attrFi])));
        if attrGSym < 0 then Continue;
        attrFld := AllocNode(AN_FIELD);
        ASTLeft[attrFld] := PyMakeIdent(attrSym);
        ASTSOffset[attrFld] := UFldNOff[attrFi];
        ASTSLen[attrFld] := UFldNLen[attrFi];
        ASTTk[attrFld] := UFldTk[attrFi];
        attrAsgn := AllocNode(AN_ASSIGN);
        ASTLeft[attrAsgn] := attrFld;
        ASTRight[attrAsgn] := PyMakeIdent(attrGSym);
        PyHoistStmt(attrAsgn);
      end;
    end;
    Result := PyMakeIdent(attrSym);
  end;
end;

{ The class attributes of `ci`, as assignments onto SELF, for the head of the
  constructor. Python creates class attributes when the CLASS is defined, so an
  instance sees them before `__init__` runs and `__init__` may overwrite them —
  which is the opposite of applying them to a finished object. Emitting them
  here is what lets a class have both (`class TkCanvasBackend: blendmode =
  _BlendModes()` beside an `__init__`), where the construction path had to
  refuse. Returns -1 when the class has none. }
function PyClassAttrInitSeq(ci, selfSym: Integer): Integer;
var i, fi, gsym, fldNode, asgn, seq, d, cur: Integer;
begin
  seq := -1;
  { the ANCESTOR CHAIN, ROOT FIRST — see the identical walk in the construction
    path above, which this must stay in step with: a class with a constructor
    takes this route and one without takes that one, and if only one of them
    inherited, two arrangements of the same class would disagree. }
  for d := PyClassDepth(ci) - 1 downto 0 do
  begin
    cur := PyClassAncestorAt(ci, d);
    for i := 0 to PyClsAttrCount - 1 do
      if PyClsAttrCi[i] = cur then
      begin
        fldNode := AllocNode(AN_FIELD);
        ASTLeft[fldNode] := PyMakeIdent(selfSym);
        ASTSOffset[fldNode] := PyClsAttrNOff[i];
        ASTSLen[fldNode] := PyClsAttrNLen[i];
        fi := FindUField(ci, PyRawName(PyClsAttrNOff[i], PyClsAttrNLen[i]));
        if fi >= 0 then ASTTk[fldNode] := UFldTk[fi]
        else ASTTk[fldNode] := Ord(tyVariant);
        asgn := AllocNode(AN_ASSIGN);
        ASTLeft[asgn] := fldNode;
        ASTRight[asgn] := PyClsAttrNode(i);
        seq := PySeqAppend(seq, asgn);
      end;
    { the non-literal ones live in a hidden global apiece }
    for i := 0 to UClsFCount[cur] - 1 do
    begin
      fi := UClsFBase[cur] + i;
      gsym := FindSym(PyClsAttrGlobalName(cur, PyRawName(UFldNOff[fi], UFldNLen[fi])));
      if gsym < 0 then Continue;
      fldNode := AllocNode(AN_FIELD);
      ASTLeft[fldNode] := PyMakeIdent(selfSym);
      ASTSOffset[fldNode] := UFldNOff[fi];
      ASTSLen[fldNode] := UFldNLen[fi];
      ASTTk[fldNode] := UFldTk[fi];
      asgn := AllocNode(AN_ASSIGN);
      ASTLeft[asgn] := fldNode;
      ASTRight[asgn] := PyMakeIdent(gsym);
      seq := PySeqAppend(seq, asgn);
    end;
  end;
  PyClassAttrInitSeq := seq;
end;

{ Nil Python str methods: `s.upper()` -> pylib pystr_upper(s).

  Reached from the shared parser's postfix `.member` branch (parser.inc) once
  the base expression is known to be string-typed and PyExprMode is on; the
  method name is already consumed, CurTok is the '('. Returns the AN_CALL node
  with ASTTk set to the method's result type, which the caller feeds back into
  its suffix loop so chains keep parsing.

  Adding a method = one row here plus the pylib function. Keep the two in step:
  an unknown name must Error, never fall through to the record-field path,
  which would build a bogus field access on a string (the tarrconstr8 class of
  silent breakage the array guard above this site exists to prevent). }
{ NilPy `s[i]` -> pylib pystr_at(s, i). Python subscripts are 0-based and allow
  negative indices; Pascal's are 1-based with neither. Doing the fixup in the
  RUNTIME helper rather than as index arithmetic here keeps the negative case
  (which needs Length(s)) correct without evaluating the base twice. }
{ Nil Python KEYWORD ARGUMENTS — `f(a, key=expr)`.

  Two halves. This one runs at the point an argument would be parsed: if the
  next two tokens are `ident =` (NOT `==` — the lexer already split those into
  tkEq), consume them and resolve the name against the callee's declared
  parameters, returning paramIndex+1. 0 means "ordinary positional argument",
  so a zero-initialised AN_ARG node reads as positional and every Pascal path
  is unaffected. firstParam is 1 on the method path, where Params[0] is Self
  and `self=` must not be bindable by name.

  The callee-side defaults (ProcParamDefault*) already existed; all that was
  missing was binding by name at the call site. }
function PyKwArgIndex(mpi, firstParam: Integer): Integer;
var nm: AnsiString;
    i, kwSib: Integer;
begin
  PyKwArgIndex := 0;
  if not isNilPy then Exit;
  if CurTok.Kind <> tkIdent then Exit;
  if Tokens[TokPos].Kind <> tkAssign then Exit;
  nm := CurTok.SVal;
  Next;              { the name }
  Next;              { the '=' }
  for i := firstParam to Procs[mpi].ParamCount - 1 do
    if ParamNameEq(mpi, Procs[mpi].Params[i].Name, nm) then
    begin
      PyKwArgIndex := i + 1;
      Exit;
    end;
  { No declared parameter of that name — but a callee with `**kwargs` takes it
    anyway, into the dict. The KEY has to survive until the whole argument list
    is parsed, so the string literal node is allocated here and its index
    returned NEGATIVE (-(node+1)); PyPackStarArgs decodes it. }
  if ProcPyKwIdx[mpi] >= 0 then
  begin
    i := AllocNode(AN_STR_LIT);
    ASTSOffset[i] := PyStoredName(nm);
    ASTSLen[i] := Length(nm);
    ASTTk[i] := Ord(tyString);
    PyKwArgIndex := -(i + 1);
    Exit;
  end;
  { …or a SIBLING OVERLOAD has it, and the call site simply resolved to the wrong
    member: the keyword name is checked against the ONE proc already chosen, not
    against the overload SET (bug-nilpy-keyword-arg-vs-overload-set). Say that,
    instead of the flatly untrue "has no parameter named" — the name exists, it
    is on another arity, and the reader has no way to guess that from the old
    message. }
  for i := 0 to ProcCount - 1 do
    if (i <> mpi) and CaseEqual(Procs[i].Name, Procs[mpi].Name) then
      for kwSib := 0 to Procs[i].ParamCount - 1 do
        if CaseEqual(Procs[i].Params[kwSib].Name, nm) then
          Error('Nil Python: ' + Procs[mpi].Name + ' has no parameter named '''
                + nm + ''' in the overload taking '
                + PyIntLiteralText(Procs[mpi].ParamCount)
                + ' argument(s) — a sibling overload taking '
                + PyIntLiteralText(Procs[i].ParamCount)
                + ' does. Keyword names are resolved against the chosen overload,'
                + ' not the whole set: pass it positionally for now'
                + ' (bug-nilpy-keyword-arg-vs-overload-set)');
  Error('Nil Python: ' + Procs[mpi].Name + ' has no parameter named ''' + nm + '''');
end;

{ The second half: once the whole argument list is parsed, reorder the AN_ARG
  chain into declaration order. Each node carries its binding in ASTIVal
  (paramIndex+1 from PyKwArgIndex, 0 = positional, consumed here so IR lowering
  sees an ordinary chain). Holes BELOW the highest bound parameter are filled
  from the declared defaults; trailing holes are left alone so the existing
  FillDefaultArgs / IR default path keeps handling them.

  No-op — chain untouched, not even walked twice — when no argument was a
  keyword, which is every Pascal call and most NilPy ones. }
procedure PyBindKwArgs(mpi: Integer; var argsHead, lastArg, nArgs: Integer);
var slot: array[0..MAX_PROC_PARAMS-1] of Integer;
    n, k, pos, maxIdx, i: Integer;
    anyKw, sawKw: Boolean;
begin
  anyKw := False;
  n := argsHead;
  while n >= 0 do
  begin
    if ASTIVal[n] <> 0 then anyKw := True;
    n := ASTRight[n];
  end;
  if not anyKw then Exit;

  for i := 0 to MAX_PROC_PARAMS - 1 do slot[i] := -1;
  pos := 0; maxIdx := -1; sawKw := False;
  n := argsHead;
  while n >= 0 do
  begin
    if ASTIVal[n] <> 0 then
    begin
      k := ASTIVal[n] - 1;
      ASTIVal[n] := 0;
      sawKw := True;
    end
    else
    begin
      if sawKw then
        Error('Nil Python: positional argument after keyword argument in call to '
              + Procs[mpi].Name);
      k := pos;
      Inc(pos);
    end;
    if (k < 0) or (k >= MAX_PROC_PARAMS) then
      Error('Nil Python: too many arguments to ' + Procs[mpi].Name);
    if slot[k] >= 0 then
      Error('Nil Python: ' + Procs[mpi].Name + ' got multiple values for parameter '''
            + Procs[mpi].Params[k].Name + '''');
    slot[k] := n;
    if k > maxIdx then maxIdx := k;
    n := ASTRight[n];
  end;

  { Trailing defaulted params too, not only the holes below maxIdx: a keyword
    call decouples arity from position, so the loops that normally stop at `)`
    and hand the tail to FillDefaultArgs have already been broken out of. }
  i := maxIdx + 1;
  while (i <= Procs[mpi].ParamCount - 1) and (i < MAX_PROC_PARAMS) and
        ProcParamHasDefault[mpi * MAX_PROC_PARAMS + i] do
  begin
    slot[i] := -1;
    maxIdx := i;
    Inc(i);
  end;

  for i := 0 to maxIdx do
    if slot[i] < 0 then
    begin
      k := AllocNode(AN_ARG);
      ASTLeft[k] := DefaultArgValueNode(mpi, i);
      slot[i] := k;
    end;

  for i := 0 to maxIdx - 1 do ASTRight[slot[i]] := slot[i + 1];
  ASTRight[slot[maxIdx]] := -1;
  argsHead := slot[0];
  lastArg := slot[maxIdx];
  nArgs := maxIdx + 1;
end;

function PyMakeStrIndex(baseNode, idxNode: Integer): Integer;
var procIdx, callNode, a0, a1: Integer;
begin
  { the other subscript choke point: a NAMED str variable reaches here from the
    shared parser's generic index path, which has no notion of __index__.
    A str is always a sequence, so an object index with no `__index__` raises
    TypeError here unconditionally — no receiver test needed, unlike the
    container paths where a dict KEY may legitimately be an object. }
  procIdx := PyIndexNotIntKind('string', idxNode);
  if procIdx >= 0 then idxNode := procIdx
  else idxNode := PyIndexCoerce(idxNode);
  { pystr_charat, NOT pystr_at: Python's s[i] is a one-CHARACTER str, and a
    tyChar result could only ever carry the lead byte of a multi-byte character
    — which is what put malformed UTF-8 on stdout. feature-nilpy-text-string-kind }
  procIdx := FindProc('pystr_charat');
  if procIdx < 0 then Error('Nil Python: pylib (pystr_charat) not loaded');
  a0 := AllocNode(AN_ARG);
  ASTLeft[a0] := baseNode;
  a1 := AllocNode(AN_ARG);
  ASTLeft[a1] := idxNode;
  ASTRight[a0] := a1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyAnsiString);
  ASTLeft[callNode] := a0;
  Result := callNode;
end;

function PyStrMethodFinish(const mname: AnsiString;
                           argHead, lastArg, argCount: Integer): Integer; forward;

{ `input([prompt])` -> pyinput() / pyinput_p(prompt). ONE builder with TWO
  entry points, because there ARE two: `input` is intercepted both in the NilPy
  builtin chain (guarded on nothing else being called `input`, so a parameter
  may shadow it — songformatter's `int_to_roman(input)`) and in the
  PyExprMode name dispatch (guarded on no user proc of that name). They used to
  carry two lowerings, and the first DISCARDED the prompt — Python writes it to
  stdout without a newline, which is observable output a differential harness
  compares byte for byte. Every syntactic shape probed took the second arm, so
  the divergence was latent; sharing the builder retires it without having to
  prove which arm is dead (bug-nilpy-input-has-two-lowerings-one-discards-the-prompt).
  Call with CurTok on the name; consumes through the ')'. }
function PyParseInputCall: Integer;
var idx, argSeq, node: Integer;
begin
  Next; Expect(tkLParen, '(');
  if CurTok.Kind = tkRParen then
  begin
    idx := FindProc('pyinput');
    if idx < 0 then Error('Nil Python: pylib (pyinput) not loaded');
    Expect(tkRParen, ')');
    node := AllocNode(AN_CALL); ASTIVal[node] := idx;
    ASTTk[node] := Ord(tyAnsiString); ASTLeft[node] := -1;
  end
  else
  begin
    idx := FindProc('pyinput_p');
    if idx < 0 then Error('Nil Python: pylib (pyinput_p) not loaded');
    PyParseBoolExpr;
    Expect(tkRParen, ')');
    argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
    ASTRight[argSeq] := -1;
    node := AllocNode(AN_CALL); ASTIVal[node] := idx;
    ASTTk[node] := Ord(tyAnsiString); ASTLeft[node] := argSeq;
  end;
  Result := node;
end;

procedure PyStrictRefuse(const feature: AnsiString; const cpythonSays: AnsiString);
{ The ONE diagnostic shape for every --strict-python rule. Called only when
  StrictPython is on; a caller that forgets the guard turns a laxity into a
  refusal for everybody, so the guard is here rather than at each site.

  Why a shared helper for a flag with no rules yet: the flag's value is that
  rules can be added uniformly later, and "uniformly" means the message tells
  the reader three things every time — what construct, what CPython does about
  it, and that pxx accepts it by default. A rule that invents its own wording
  is a rule someone has to read twice.

  Extensions use it too, and that is not a stretch of the name: `parallel for`
  is something CPython would reject, so a program that must stay portable wants
  to be told, in exactly this shape, that it has left the language. }
begin
  if not StrictPython then Exit;
  Error('Nil Python: --strict-python refuses ' + feature + ' — CPython '
        + cpythonSays + '. The default dialect accepts it; drop the flag to '
        + 'keep it.');
end;

function PyParseFormatCall: Integer;
{ `format(v)` / `format(v, spec)` -> pyformat_v, the SAME implementation the
  f-string holes use. An intercept rather than a pylib function named `format`,
  because sysutils' `Format` shadows the whole name once a program imports
  anything that reaches it — see the note at pyformat_v's declaration.
  The spec is an ordinary expression, not a literal: `format(x, spec)` with the
  spec in a variable is how a report makes its own columns configurable, and
  that is the shape an f-string cannot express. }
var idx, argSeq, argSeq2, node, specNode: Integer;
begin
  idx := FindProc('pyformat_v');
  if idx < 0 then Error('Nil Python: pylib (pyformat_v) not loaded');
  Next; Expect(tkLParen, '(');
  PyParseBoolExpr;
  argSeq := AllocNode(AN_ARG);
  ASTLeft[argSeq] := PyForceVariant(CurASTNode);
  if CurTok.Kind = tkComma then
  begin
    Next;
    PyParseBoolExpr;
    specNode := CurASTNode;
  end
  else
  begin
    { no spec — an empty one, which pyformat_v defines as str(v) }
    specNode := AllocNode(AN_STR_LIT);
    ASTSOffset[specNode] := 0;
    ASTSLen[specNode] := 0;
    ASTTk[specNode] := Ord(tyString);
  end;
  Expect(tkRParen, ')');
  argSeq2 := AllocNode(AN_ARG);
  ASTLeft[argSeq2] := specNode;
  ASTRight[argSeq2] := -1;
  ASTRight[argSeq] := argSeq2;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := idx;
  ASTTk[node] := Ord(tyAnsiString);
  ASTLeft[node] := argSeq;
  Result := node;
end;

{ `"{k}".format(k=3)` — NAMED format fields. The substitution machinery is
  positional (pystr_format / format2 / formatn over an argument list), and the
  format string is a LITERAL at essentially every real call site, so the names
  are resolved HERE: each `{name...}` field becomes `{index...}` over the same
  argument list, with the keyword values appended after the positional ones in
  the order they were written.

  Every field comes out EXPLICITLY numbered, including the auto-numbered `{}`
  ones. CPython forbids mixing automatic and manual numbering in one string,
  so renumbering only the named fields would have produced exactly the mix the
  runtime path is not asked to handle; normalising all of them keeps one shape.

  The `!r` / `:spec` tail is preserved untouched — only the NAME part in front
  of it is rewritten — and `{{` / `}}` escapes are stepped over. }
function PyFormatRenumber(const fmt: AnsiString; var names: array of AnsiString;
                          nNames, nPos: Integer): AnsiString;
var i, j, k, fieldStart, autoIdx: Integer;
    nm, tail, ob, cb: AnsiString;
    allDigits, found: Boolean;
begin
  { The braces are Chr(123)/Chr(125), never quoted characters: THIS DIALECT
    NESTS BRACE COMMENTS, so a quoted brace opens one and the file stops
    parsing hundreds of lines later ("unexpected character"). PyParseSetComp
    carries the same warning for the same reason. }
  ob := Chr(123); cb := Chr(125);
  Result := '';
  autoIdx := 0;
  i := 1;
  while i <= Length(fmt) do
  begin
    if (fmt[i] = ob) and (i < Length(fmt)) and (fmt[i + 1] = ob) then
    begin
      Result := Result + ob + ob;
      Inc(i, 2);
      Continue;
    end;
    if (fmt[i] = cb) and (i < Length(fmt)) and (fmt[i + 1] = cb) then
    begin
      Result := Result + cb + cb;
      Inc(i, 2);
      Continue;
    end;
    if fmt[i] <> ob then
    begin
      Result := Result + fmt[i];
      Inc(i);
      Continue;
    end;
    { a FIELD: name, then an optional !conv and :spec }
    Inc(i);
    fieldStart := i;
    while (i <= Length(fmt)) and (fmt[i] <> cb) and (fmt[i] <> '!') and
          (fmt[i] <> ':') do
      Inc(i);
    nm := Copy(fmt, fieldStart, i - fieldStart);
    tail := '';
    j := i;
    while (j <= Length(fmt)) and (fmt[j] <> cb) do Inc(j);
    tail := Copy(fmt, i, j - i);
    if j <= Length(fmt) then Inc(j);        { step over the close brace }
    i := j;
    if nm = '' then
    begin
      Result := Result + ob + AIntToStr(autoIdx) + tail + cb;
      Inc(autoIdx);
      Continue;
    end;
    allDigits := True;
    for k := 1 to Length(nm) do
      if (nm[k] < '0') or (nm[k] > '9') then allDigits := False;
    if allDigits then
    begin
      Result := Result + ob + nm + tail + cb;
      Continue;
    end;
    found := False;
    for k := 0 to nNames - 1 do
      if names[k] = nm then
      begin
        Result := Result + ob + AIntToStr(nPos + k) + tail + cb;
        found := True;
        Break;
      end;
    if not found then
      Error('Nil Python: .format() has no keyword argument named ' + nm);
  end;
end;

function PyParseStrMethod(baseNode: Integer; const mname: AnsiString): Integer;
var pname: AnsiString;
    retTk: TTypeKind;
    procIdx, callNode, argNode, lastArg, i, k, wantArgs: Integer;
    kwNames: array[0..15] of AnsiString;   { `.format(k=3)` field names, in order }
    kwCount, nPos: Integer;
    newFmt: AnsiString;
begin
  kwCount := 0;
  nPos := 0;
  if not PyStrMethodInfo(mname, pname, retTk, wantArgs) then
    Error('Nil Python: unsupported str method .' + mname + '() (have: upper, '
      + 'lower, strip, lstrip, rstrip, startswith, endswith, find, isspace, '
      + 'isdigit, isalpha, isalnum, isupper, islower, isascii, translate, format, '
      + 'join, split, rsplit, partition, rpartition, splitlines, replace, '
      + 'count, rfind, title, capitalize, '
      + 'swapcase, casefold, ljust, rjust, center, zfill, removeprefix, '
      + 'removesuffix)');

  procIdx := FindProc(pname);
  if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');

  { A tyChar receiver becomes a real 1-length string first — see pystr_ofchar. }
  if IntToTypeKind(ASTTk[baseNode]) = tyChar then
  begin
    i := FindProc('pystr_ofchar');
    if i < 0 then Error('Nil Python: pylib (pystr_ofchar) not loaded');
    callNode := AllocNode(AN_ARG);
    ASTLeft[callNode] := baseNode;
    baseNode := AllocNode(AN_CALL);
    ASTIVal[baseNode] := i;
    ASTTk[baseNode] := Ord(tyAnsiString);
    ASTLeft[baseNode] := callNode;
  end;

  { the string itself is argument 0 — the receiver }
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := baseNode;
  lastArg := argNode;

  Expect(tkLParen, '(');
  i := 0;
  if wantArgs = -4 then
  begin
    { SKIP the arguments rather than parse them: `errors="replace"` is a
      keyword argument, not an expression, so parsing it would fail on the
      bare name. Balanced skip to the closing paren. }
    k := 1;
    while (k > 0) and (CurTok.Kind <> tkEOF) do
    begin
      if CurTok.Kind = tkLParen then Inc(k)
      else if CurTok.Kind = tkRParen then
      begin
        Dec(k);
        if k = 0 then Break;
      end;
      Next;
    end;
  end;
  while (wantArgs <> -4) and (CurTok.Kind <> tkRParen) do
  begin
    { `s.encode(encoding="latin-1", errors="replace")` — Python's keyword
      spellings for the two arguments. Consumed down to the VALUE, which is
      what the positional slot wants: both names are fixed and in declaration
      order, so nothing has to be re-ordered. This is the whole reason the old
      -4 mode skipped the arguments as tokens rather than parsing them — a bare
      `errors` is not an expression.
      bug-n-str-encode-and-bytes-decode-ignore-the-encoding }
    if (wantArgs = -11) and (CurTok.Kind = tkIdent) and
       (PyIsIdent('encoding') or PyIsIdent('errors')) and
       (TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign) then
    begin
      Next;
      Next;
    end;
    { `"{k}".format(k=3)` — a NAMED field. The name is recorded and the `k=`
      consumed, so the VALUE lands in the positional slot the renumbering below
      points the field at. Without this the bare `k` was parsed as an
      expression and the error blamed the caller's own code
      ("undefined variable (k)") for what is a field name.
      bug-nilpy-str-format-refuses-keyword-fields }
    if (wantArgs = -6) and (CurTok.Kind = tkIdent) and
       (TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign) then
    begin
      if kwCount > High(kwNames) then
        Error('Nil Python: .format() takes at most 16 keyword fields; '
              + 'use an f-string');
      kwNames[kwCount] := CurTok.SVal;
      Inc(kwCount);
      Next;                              { the name }
      Next;                              { the '=' }
    end
    else if wantArgs = -6 then
    begin
      { `.format(**d)` — the keys are a RUN-TIME fact and the renumbering is a
        compile-time rewrite, so it refuses rather than guessing. Same call the
        arity ceiling makes. }
      if CurTok.Kind = tkStar then
        Error('Nil Python: .format(**mapping) is not supported; '
              + 'use an f-string or name the fields');
      if kwCount > 0 then
        Error('Nil Python: a positional argument after a keyword field in '
              + '.format() is not valid Python');
      Inc(nPos);
    end;
    { A bare generator expression as an argument — `"\n".join(x for x in it)`.
      Detected BEFORE the EXPR is parsed, because the EXPR references the loop
      variable, which is not in scope until the `for`. PyParseCompExprValue
      desugars it to a hoisted hidden list and yields that list, so join sees an
      ordinary iterable. }
    if PyBareGenExprAhead then
      CurASTNode := PyParseCompExprValue(False)
    else
      PyParseBoolExpr;
    callNode := AllocNode(AN_ARG);
    ASTLeft[callNode] := CurASTNode;
    ASTRight[lastArg] := callNode;
    lastArg := callNode;
    Inc(i);
    if CurTok.Kind = tkComma then Next
    else Break;
  end;
  Expect(tkRParen, ')');
  { …and rewrite the LITERAL's named fields to the indices those values landed
    at. In place on the receiver node, before the call is built, so every arity
    rung below sees an ordinary positional format string. }
  if kwCount > 0 then
  begin
    if ASTKind[baseNode] <> AN_STR_LIT then
      Error('Nil Python: .format() with named fields needs a literal format '
            + 'string (the field names are resolved at compile time); '
            + 'use an f-string');
    newFmt := PyFormatRenumber(PyRawName(ASTSOffset[baseNode], ASTSLen[baseNode]),
                               kwNames, kwCount, nPos);
    ASTSOffset[baseNode] := PyStoredName(newFmt);
    ASTSLen[baseNode] := Length(newFmt);
  end;
  Result := PyStrMethodFinish(mname, argNode, lastArg, i);
end;

{ Is this AN_ARG's expression the None LITERAL? A None literal is a call to
  pylib's `pynone` with no arguments (PyMakeNone), so this recognises the value
  rather than the spelling — `s.split(None)` and `s.split(sep)` where sep
  happens to hold None are different programs, and only the first is a
  compile-time fact.
  bug-nilpy-split-with-an-explicit-none-separator-does-not-split }
function PyArgIsNoneLiteral(argNode: Integer): Boolean;
var e, pi: Integer;
begin
  PyArgIsNoneLiteral := False;
  if argNode < 0 then Exit;
  e := ASTLeft[argNode];
  if e < 0 then Exit;
  if ASTKind[e] <> AN_CALL then Exit;
  if ASTLeft[e] <> -1 then Exit;
  pi := FindProc('pynone');
  PyArgIsNoneLiteral := (pi >= 0) and (ASTIVal[e] = pi);
end;

{ Resolve a str method's ARITY-SUFFIXED pylib proc and build the call.

  Split out of PyParseStrMethod (2026-08-09,
  bug-nilpy-user-method-named-like-a-str-method-raises-on-a-variant-receiver) so
  that the runtime string/user-class dispatch in PyParseVariantMethod can build
  the SAME call from arguments it has already parsed. The str-method table maps
  one pylib proc name per ARITY ('' / '_from' / '_range' / '_chars' / '2' / 'n')
  because FindProc resolves by bare name and never consults overloads, so this
  resolution is not a detail a second caller could reasonably re-derive — a
  duplicate of it is exactly the kind of second mechanism that drifts.

    argHead  = the head AN_ARG (its Left is the receiver string)
    lastArg  = the tail AN_ARG of that chain
    argCount = the number of EXPLICIT arguments (receiver excluded) }
function PyStrMethodFinish(const mname: AnsiString;
                           argHead, lastArg, argCount: Integer): Integer;
var pname: AnsiString;
    retTk: TTypeKind;
    procIdx, callNode, argNode, i, k, wantArgs: Integer;
    padNode, nFmtArgs: Integer;
begin
  if not PyStrMethodInfo(mname, pname, retTk, wantArgs) then
    Error('Nil Python: unsupported str method .' + mname + '()');
  procIdx := FindProc(pname);
  if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  { `"-".join(map(str, xs))` — pystr_join takes a real TPyList and is reached by
    NAME (FindProc, not overload resolution), so nothing type-checks its
    argument and every iterable shape has to be normalised to a list HERE.
    A cursor is drained (CPython consumes it too); a str is exploded into its
    characters, which it was NOT — the string HANDLE went through where a
    TPyList object pointer was expected and got dereferenced, so
    `"-".join("hello")` was a SIGSEGV with no diagnostic
    (bug-nilpy-join-of-a-str-segfaults). That is the same defect
    PyIterArgAsList was written for when zip/enumerate had it; join was the
    sibling left behind, which is the shape
    devdocs/dev/normalise-dont-special-case.md is about. }
  if CaseEqual(pname, 'pystr_join') and (argCount = 1) and (ASTRight[argHead] >= 0) then
  begin
    ASTLeft[ASTRight[argHead]] := PyDrainIfCursor(ASTLeft[ASTRight[argHead]]);
    ASTLeft[ASTRight[argHead]] := PyIterArgAsList(ASTLeft[ASTRight[argHead]]);
  end;
  argNode := argHead;
  i := argCount;
  { An EXPLICIT None separator — `s.split(None)`, `s.split(None, 1)` — means
    whitespace runs, exactly what the no-argument form does; CPython's own
    signature is `split(sep=None, maxsplit=-1)`, so None is not a degenerate
    separator but the DEFAULT one. It used to reach pystr_split_sep with the
    None coerced to a string and answered the whole string as one field —
    silently, since a wrong split still looks like a list of strings. Drop the
    None from the chain here and let the arity logic below pick the ws form. }
  if ((wantArgs = -1) or (wantArgs = -8)) and (i >= 1) and
     PyArgIsNoneLiteral(ASTRight[argHead]) then
  begin
    ASTRight[argHead] := ASTRight[ASTRight[argHead]];
    Dec(i);
    if i = 0 then lastArg := argHead;
    if i = 1 then
    begin
      { `split(None, maxsplit)` — a whitespace split IS the separator-free form,
        so the maxsplit variant needs its own runtime rather than any suffixing
        of the sep-based one. }
      if wantArgs = -1 then pname := 'pystr_split_ws_max'
      else pname := 'pystr_rsplit_ws_max';
      procIdx := FindProc(pname);
      if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
      wantArgs := 1;
    end;
  end;
  if wantArgs = -1 then
  begin
    { optional-argument form: split(), split(sep) and split(sep, maxsplit) are
      separate functions. }
    if i = 0 then pname := 'pystr_split_ws'
    else if i = 2 then pname := 'pystr_split_sep_max'
    else if i <> 1 then
      Error('Nil Python: str method .' + mname + '() takes at most two arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -8 then
  begin
    { rsplit()/rsplit(sep) give the SAME result as split()/split(sep) — only
      rsplit(sep, maxsplit) needs the right-anchored algorithm. }
    if i = 0 then pname := 'pystr_split_ws'
    else if i = 2 then pname := 'pystr_rsplit_sep_max'
    else if i <> 1 then
      Error('Nil Python: str method .' + mname + '() takes at most two arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -11 then
  begin
    { .encode: one pylib name per arity. }
    if i = 1 then pname := 'pystr_encode_enc'
    else if i = 2 then pname := 'pystr_encode_enc_err'
    else if i <> 0 then
      Error('Nil Python: str method .encode() takes at most two arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -4 then
  begin
    { Arguments accepted and DISCARDED. Only .encode uses this: our strings are
      byte strings, so the encoding argument has nothing to select, and the
      `errors` keyword cannot trigger. Swallowing them keeps the corpus
      spelling working without pretending we implement codecs — the limitation
      is filed as bug-nilpy-encode-ignores-the-codec. }
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -3 then
  begin
    { substring plus an OPTIONAL start offset — find }
    if i = 2 then pname := pname + '_from'
    else if i <> 1 then
      Error('Nil Python: str method .' + mname + '() takes one or two arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -9 then
  begin
    { substring/prefix, plus Python's OPTIONAL start and end window. One pylib
      name per arity — '' / '_from' / '_range' — rather than an overload,
      because FindProc resolves by name and never consults overloads
      (bug-nilpy-stdlib-shim-table-cannot-reach-an-overload). }
    if i = 2 then pname := pname + '_from'
    else if i = 3 then pname := pname + '_range'
    else if i <> 1 then
      Error('Nil Python: str method .' + mname + '() takes one to three arguments');
    { `s.startswith(("a", "b"))` — Python's TUPLE-of-prefixes form, which
      answers True if ANY matches. The single AnsiString parameter turned a
      tuple argument into text that matches nothing, so it silently answered
      FALSE — a guard taking the wrong branch with no diagnostic, and the
      failure direction that hides (`if s.startswith((..)):` just never fires).
      Routed to a Variant-taking entry point ONLY when the argument is not
      statically a string, so the hot `sys.platform.startswith("win")` path
      keeps the plain call, while a tuple literal, a tuple-typed local and a
      variant that only turns out to hold one at run time all reach the same
      one place. bug-nilpy-startswith-endswith-ignore-a-tuple-argument }
    if (i = 1) and ((pname = 'pystr_startswith') or (pname = 'pystr_endswith'))
       and (ASTRight[argNode] >= 0) then
    begin
      k := ASTLeft[ASTRight[argNode]];
      if (k >= 0) and (IntToTypeKind(ASTTk[k]) <> tyAnsiString) and
         (IntToTypeKind(ASTTk[k]) <> tyString) and
         (IntToTypeKind(ASTTk[k]) <> tyChar) then
        pname := pname + '_any';
    end;
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -5 then
  begin
    { strip family: no arg (whitespace) or one CHARS-set arg }
    if i = 1 then pname := pname + '_chars'
    else if i <> 0 then
      Error('Nil Python: str method .' + mname + '() takes at most one argument');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -7 then
  begin
    { old + new, plus an OPTIONAL occurrence count — replace }
    if i = 3 then pname := pname + '_n'
    else if i <> 2 then
      Error('Nil Python: str method .' + mname + '() takes two or three arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -10 then
  begin
    { no argument, or one INT argument — expandtabs. Distinct proc NAMES per
      arity, like every other multi-arity row: FindProc is not arity-aware. }
    if i = 1 then pname := pname + '_n'
    else if i <> 0 then
      Error('Nil Python: str method .' + mname + '() takes at most one argument');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -2 then
  begin
    { width plus an OPTIONAL fill character — rjust }
    if i = 2 then pname := pname + '_c'
    else if i <> 1 then
      Error('Nil Python: str method .' + mname + '() takes one or two arguments');
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if wantArgs = -6 then
  begin
    { .format(a) / .format(a, b) — one or two positional placeholders.
      pystr_format2 is a SEPARATE proc name for the 2-arg case, not a second
      pystr_format overload: FindProc below looks a proc up by bare name and
      is not arity-aware, so a same-named overload pair resolved to whichever
      was registered first regardless of how many arguments were actually
      parsed — the second Variant arrived through a 1-param ABI and the call
      segfaulted. Every other multi-arity str method already sidesteps this
      the same way (split/rjust/replace's own arity-suffixed names above)
      (feature-nilpy-str-format-multiarg).

      THREE OR MORE — and ZERO, `"x".format()`, which is valid CPython and
      was refused by the same gate — end that per-arity scheme rather than
      extending it: the third rung is pystr_formatn, one FIXED-arity proc
      taking eight Variants plus a real count, and the unused slots are
      padded with None right here. Deliberately not a proc per arity — the substitution itself now
      lives in one place (PyFormatApply over the argument list), so the
      index and format-spec behaviour cannot drift between arities. Past
      eight it still refuses loudly and names f-strings, which have no
      limit. }
    if i = 2 then pname := pname + '2'
    else if i <> 1 then
    begin
      if i > 8 then
        Error('Nil Python: str method .format() takes at most eight arguments; '
              + 'use an f-string');
      nFmtArgs := i;
      pname := pname + 'n';
      { pad to eight, then the real count — the ABI is fixed-arity }
      k := FindProc('pynone');
      if k < 0 then Error('Nil Python: pylib (pynone) not loaded');
      while i < 8 do
      begin
        padNode := AllocNode(AN_CALL);
        ASTIVal[padNode] := k;
        ASTTk[padNode] := Ord(tyVariant);
        ASTLeft[padNode] := -1;
        callNode := AllocNode(AN_ARG);
        ASTLeft[callNode] := padNode;
        ASTRight[lastArg] := callNode;
        lastArg := callNode;
        Inc(i);
      end;
      padNode := AllocNode(AN_INT_LIT);
      ASTIVal[padNode] := nFmtArgs;
      ASTTk[padNode] := Ord(tyInteger);
      callNode := AllocNode(AN_ARG);
      ASTLeft[callNode] := padNode;
      ASTRight[lastArg] := callNode;
      lastArg := callNode;
    end;
    procIdx := FindProc(pname);
    if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  end
  else if i <> wantArgs then
  begin
    if wantArgs = 0 then
      Error('Nil Python: str method .' + mname + '() takes no arguments')
    else
      Error('Nil Python: str method .' + mname + '() takes exactly one argument');
  end;

  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(retTk);
  ASTLeft[callNode] := argNode;
  LastExprTk := retTk;
  Result := callNode;
  Result := callNode;
end;


{ A `[` may follow a non-lvalue factor when the value is subscriptable in
  Python: a str (including a literal), a list, or a dict. ParseFactor asks
  before consuming the bracket so nothing else's syntax is stolen. }
function PySubscriptableSuffix(n: Integer): Boolean;
var rec, listCi, dictCi: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[n])) then begin Result := True; Exit; end;
  { a variant may hold a container — subscript dispatches at run time }
  if IntToTypeKind(ASTTk[n]) = tyVariant then begin Result := True; Exit; end;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  rec := ResolveNodeRec(n);
  if rec < REC_UCLASS_BASE then Exit;
  listCi := FindUClass('TPyList');
  dictCi := FindUClass('TPyDict');
  Result := ((listCi >= 0) and (rec = REC_UCLASS_BASE + listCi)) or
            ((dictCi >= 0) and (rec = REC_UCLASS_BASE + dictCi));
end;

{ `base[idx]` for those bases: pystr_at for a string, the container's own getter
  for a list (`get`) or a dict (`fetch`) — the same methods the lvalue path
  reaches, just built here because a non-lvalue never gets there. }
{ `v[key]` on a variant -> pyvar_getitem(v, key); yields a variant.
  (PyMakeNone's forward declaration lives in parser.inc's Py* forward block —
  parser.inc's PyExprMode nil arm and PyParseBoolExpr both need it.) }

{ A `lambda p1, ...: <expr>` — lowered to a PYEVAL CLOSURE built from the
  body's SOURCE text: pyclosure_src_new(params, 'return <expr>') with every
  free name's VALUE captured at build time via chained pyclosure_src_cap
  calls. The result is the same magic-sentinel closure object the reverse
  bridge (`word.native(vm2)` and PyMakeDynCall) already dispatches on, so a
  lambda stored into a Callable field runs exactly like a captured nested
  `def` (uforth: `define_word("STATE", native=lambda vm: vm.push(A))`).
  The body is re-tokenized by pyeval at build time, so the text below is a
  space-joined reconstruction from the token span — exotic tokens error
  honestly rather than desugaring wrong. }

{ Text of one body token for that reconstruction. }
function PyLambdaTokText(i: Integer): AnsiString;
begin
  case Tokens[i].Kind of
    tkIdent:   Result := GetTokenStr(i);
    tkInteger: Result := PyIntLiteralText(Tokens[i].IVal);
    tkString:  Result := '"' + GetTokenStr(i) + '"';
    tkDot:     Result := '.';
    tkComma:   Result := ',';
    tkLParen:  Result := '(';
    tkRParen:  Result := ')';
    tkLBrack:  Result := '[';
    tkRBrack:  Result := ']';
    tkColon:   Result := ':';
    tkPlus:    Result := '+';
    tkMinus:   Result := '-';
    tkStar:    Result := '*';
    tkSlash:   Result := '/';
    tkDiv:     Result := '//';
    tkMod:     Result := '%';
    tkAmp:     Result := '&';
    tkPipe:    Result := '|';
    tkXor:     Result := '^';
    tkShl:     Result := '<<';
    tkShr:     Result := '>>';
    tkLogNot:  Result := '~';
    tkEq:      Result := '==';
    tkNeq:     Result := '!=';
    tkLt:      Result := '<';
    tkLe:      Result := '<=';
    tkGt:      Result := '>';
    tkGe:      Result := '>=';
    tkAnd:     Result := 'and';
    tkOr:      Result := 'or';
    tkNot:     Result := 'not';
    tkIn:      Result := 'in';
    tkIf:      Result := 'if';
    tkElse:    Result := 'else';
    tkNil:     Result := 'None';
    tkTrue:    Result := 'True';
    tkFalse:   Result := 'False';
    { statement-level tokens, for whole nested-def bodies (DOES> closures) }
    tkAssign:  Result := '=';
    tkExit:    Result := 'return';
    tkWhile:   Result := 'while';
    tkBreak:   Result := 'break';
    tkRaise:   Result := 'raise';
    tkwriteln: Result := 'print';
    tkPlusEq:  Result := '+=';
    tkMinusEq: Result := '-=';
    tkStarEq:  Result := '*=';
    tkSlashEq: Result := '//=';
    tkTrueDivEq: Result := '/=';
    tkModEq:   Result := '%=';
    tkAmpEq:   Result := '&=';
    tkPipeEq:  Result := '|=';
    tkXorEq:   Result := '^=';
    tkAtEq:    Result := '@=';
    tkAt:      Result := '@';
  else
    Error('Nil Python: this token is not supported in a lambda/closure body yet');
    Result := '';
  end;
end;

{ Is this lambda body a CALL whose value is discarded — `self.canvas.configure(
  ...)`, `print(x)`, `handler(a, b)`? That is the GUI-callback shape, and it is
  the only shape the lifted path takes today: the bound-fn bridge
  (pyboundfn_call_ptr) DISCARDS the callee's result, so a lambda whose value a
  caller reads (`key=lambda p: p[1]`) must keep the pyeval closure, which
  returns one. Refusing loudly here beats lifting a body whose value silently
  disappears. }
{ Is this lambda body one the LIFTED path can compile?

  It must CONTAIN a call — a body with none already works through the pyeval
  closure and lifting it would be a behaviour change for no gain — and every
  token it is built from must be one PyLambdaTokText can render, because the
  lifted body is reconstructed as SOURCE from the token span and an unrenderable
  token is a hard Error, not a fallback. Anything rejected here keeps the pyeval
  closure, which is what makes this predicate safe to widen incrementally.

  WIDENED 2026-08-03 from "the body IS exactly one call" to "the body is a flat
  expression CONTAINING a call". The old rule demanded the first token be an
  identifier, the last a `)`, and nothing but ident/dot at depth 0 — so
  `lambda: f()` lifted but `lambda: f() + 1` and `lambda: f() or 4` did not, and
  they fell to the pyeval interpreter, which cannot call a compiled def: they
  died at RUN time with `pyeval: unknown call: f()`
  (bug-nilpy-lambda-body-expression-around-a-call-cannot-call-a-def). Nothing in
  the lifted path was specific to a bare call; the predicate was the only thing
  holding it back.

  Still rejected, deliberately, each for its own reason rather than in one
  sweep: a depth-0 token outside the operator set below (a float literal has no
  PyLambdaTokText case; a nested `lambda`, a comprehension and an unparenthesised
  tuple are shapes the capture scan has not been measured against), and a body
  with no call at all. }
function PyLambdaBodyIsLiftable(bStart, bEnd: Integer): Boolean;
var i, depth: Integer; sawCall, nestedLambda: Boolean;
begin
  Result := False;
  { REVERTED 2026-08-10 together with the sawCall relaxation below — see there. }
  if bEnd - bStart < 1 then Exit;
  depth := 0;
  sawCall := False;
  { A CURRIED lambda — `lambda a: lambda b: a + b`. Two separate clauses of this
    predicate rejected it: there is no call anywhere in the outer body, and the
    inner `:` is not in the flat-expression token set below.

    Both were written for a world where "not liftable" means "handled by the
    pyeval closure instead", i.e. a slow path rather than a wrong one. That is
    false for this shape: pyeval has no `lambda` keyword, so the inner lambda's
    source text reaches it and the program DIES with
    "pyeval: name not defined: lambda". The requirement's own justification —
    "a body without a call already works through the pyeval closure, and lifting
    it would be a behaviour change for no gain" — does not hold where the
    interpreter cannot run the body at all.

    Relaxed only for a body that BEGINS with `lambda`, so every other call-less
    body keeps its existing route and this cannot become a broad behaviour
    change. `lambda` lexes as a tkIdent here, which is also why PyLambdaTokText
    can render it back out.
    bug-nilpy-curried-lambda-fails-at-runtime }
  nestedLambda := (Tokens[bStart].Kind = tkIdent) and
                  CaseEqual(GetTokenStr(bStart), 'lambda');
  for i := bStart to bEnd - 1 do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then
    begin
      { `name(` at any depth is a call — the old rule only counted one at
        depth 0, which is the same thing once the body must be a single call }
      if (Tokens[i].Kind = tkLParen) and (i > bStart) and
         (Tokens[i - 1].Kind = tkIdent) then sawCall := True;
      Inc(depth);
    end
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then Dec(depth)
    else if depth = 0 then
    begin
      { a flat expression: the callee chain, literals, and the operators
        PyLambdaTokText knows how to write back out — plus the inner lambda's
        own `:` and `,` when this body IS a lambda }
      if not ((Tokens[i].Kind in [tkIdent, tkDot, tkInteger, tkString,
                                 tkPlus, tkMinus, tkStar, tkSlash, tkDiv, tkMod,
                                 tkAmp, tkPipe, tkXor, tkShl, tkShr, tkLogNot,
                                 tkEq, tkNeq, tkLt, tkLe, tkGt, tkGe,
                                 tkAnd, tkOr, tkNot, tkIn,
                                 tkIf, tkElse, tkNil, tkTrue, tkFalse]) or
              (nestedLambda and (Tokens[i].Kind in [tkColon, tkComma]))) then Exit;
    end;
  end;
  { Every flat expression body is lifted (COMPILED), not just one containing a
    call. A lifted body runs as native code; an unlifted one is re-walked by
    pyeval's tree-walker on every call:

      200k calls through map()   per call
      lifted (native)              1.0 us
      pyeval source closure        6.9 us     6.9x
      CPython, either form         0.1 us     (we lost to an INTERPRETER by 69x)

    A call was never the typical lambda body, so the old `sawCall` requirement
    caught the most ordinary lambdas in the language: `lambda r: r[1]` (a
    subscript — THE Python sort-key idiom), `lambda v: -v`, `lambda x: x * 2`.
    Its stated justification was "a call-less body already works through the
    pyeval closure, and lifting it would be a behaviour change for no gain":
    premise true, conclusion false.

    Widening this ALONE was tried and reverted the same day (88eb07f9d) — the
    lift path did not enforce arity while the closure path did, so it traded
    correct TypeErrors for a wrong answer and, given too few arguments, a
    SEGFAULT. That is fixed first, in PyBoundFnArityBad; this relands on top of
    it. Do not widen further (multi-parameter lambdas, gated on nParams <= 1 in
    PyParseLambdaStub) without checking the same class of question: what does
    the OLD path enforce that the new one must too?

    The depth-0 token scan above remains the real gate, so a body still has to
    be a flat expression built from tokens the lifter handles; anything it
    rejects keeps the pyeval closure, which stays the correctness fallback and
    the last resort for shapes only the interpreter can run.
    bug-nilpy-every-lambda-is-interpreted-instead-of-compiled }
  Result := (depth = 0);
end;

procedure PyParseLambdaStub;
var depth, bStart, bEnd, i, j, pi, capPi, symIdx: Integer;
    params, src, nm: AnsiString;
    pNames: array[0..7] of AnsiString;
    nParams: Integer;
    node, argA, argB, capNode, arityPi: Integer;
    dup: Boolean;
    { `lambda *args, key=key, var=var:` — a DEFAULTED parameter is Python's
      idiom for capturing a loop variable by value, not a parameter the caller
      ever supplies. Held here and bound as a build-time capture, exactly as the
      nested-def path already binds its default-arg expressions. }
    dcNames: array[0..7] of AnsiString;
    dcSyms: array[0..7] of Integer;
    dcCount: Integer;
    { the LIFTED path: this lambda's own proc and the values bound into it }
    lamProc, lamN, bindIdx, argC, vNode, capSym: Integer;
    lamCallee, k: Integer; cn2: AnsiString;
    lamOwn, ownPi: Integer;   { how many leading slots are the lambda's OWN params }
    defPi, varMask, argD: Integer;   { pyboundfn_setdefaults for defaulted params }
    defValN, defAsgn: Integer;       { a non-name default, materialised at definition time }
    defTk: TTypeKind;
    lamNames: array[0..MAX_PROC_PARAMS-1] of AnsiString;
    lamTypes: array[0..MAX_PROC_PARAMS-1] of TTypeKind;
    lamSyms: array[0..MAX_PROC_PARAMS-1] of Integer;
    lamRecs: array[0..MAX_PROC_PARAMS-1] of Integer;
    newPi, bindPi, varBindPi: Integer;
    lamManagedCap: Boolean;   { a capture the lifter cannot take -> do not lift }
    lamStarIdx, starPend, starCi, starPi: Integer;   { `lambda *a:` }
    sigPi: Integer;                  { pyboundfn_setsig — the parameter NAMES }
begin
  Next;                                { consume `lambda` }
  params := '';
  nParams := 0;
  dcCount := 0;
  { `lambda *a:` — the star was simply skipped by the loop below, so `a` became
    an ordinary parameter and the lifted body read one argument where the caller
    passed three ("takes 1 positional argument but 2 were given" on a form
    CPython accepts). Counted rather than flagged so `**kw` (two tkStar) is not
    mistaken for it — that one is still unsupported, and stays as it was. }
  lamStarIdx := -1;
  starPend := 0;
  while (CurTok.Kind <> tkColon) and (CurTok.Kind <> tkEOF) do
  begin
    if CurTok.Kind = tkStar then
    begin
      Inc(starPend);
      Next;
      Continue;
    end;
    if CurTok.Kind = tkIdent then
    begin
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign) then
      begin
        { `name=<value>` — a CAPTURE, not a parameter. Only a bare name is
          supported as the value (which is the whole idiom: `key=key`); anything
          richer says so rather than binding the wrong thing. }
        if dcCount > High(dcNames) then Error('Nil Python: too many lambda default captures');
        dcNames[dcCount] := CurTok.SVal;
        Next; Next;                    { the name and the '=' }
        begin
          { ANY default expression — `lambda a, b=2:`, `n=len(xs)`,
            `s=x+1`. There is no such thing as a "capture" in Python: `key=key`
            is just a default whose value is evaluated at DEFINITION time, and
            reading it as a capture idiom is what made the ordinary literal
            default a parse error ("a lambda default capture must be a plain
            name") on a form CPython accepts everywhere
            (bug-nilpy-lambda-with-a-literal-default-argument-does-not-parse).

            Materialised into a hidden local HERE, which is exactly the
            definition-time evaluation Python specifies — so the rest of this
            routine keeps seeing "a plain name" and the binding, arity and
            override machinery are untouched. `f(3)` uses the default and
            `f(3, 4)` overrides it.

            ONE path, not two: the bare-name `key=key` form goes through here as
            well. Keeping it as its own arm bound the enclosing symbol DIRECTLY,
            which was fine for an Int64 and wrong for anything else — a str
            default died with "expected a number, got str" the moment a caller
            overrode it, because the non-variant bind was chosen off the
            symbol's type. }
          PyParseBoolExpr;
          defValN := CurASTNode;
          { The temp is a VARIANT whatever the value's static type is. The bind
            below reads ONE MACHINE WORD out of this slot, and an arithmetic
            default is a PROMOTABLE int (`b=k+1` typed tk=28, two words), so a
            natively-typed temp handed the bridge half a promo and bound
            -6384382 — while the identical `b=2` was fine, a literal already
            being Int64. A variant is what the lambda's own parameters are, it
            carries every value kind, and it routes the bind through
            pyboundfn_bind_var, which is the path written for exactly this. }
          defTk := tyVariant;
          symIdx := AllocVar(PyHiddenName('lamdef'), defTk);
          defAsgn := AllocNode(AN_ASSIGN);
          ASTLeft[defAsgn] := PyMakeIdent(symIdx);
          ASTRight[defAsgn] := defValN;
          PyHoistStmt(defAsgn);
        end;
        dcSyms[dcCount] := symIdx;
        Inc(dcCount);
        Continue;
      end;
      if nParams > High(pNames) then Error('Nil Python: too many lambda parameters');
      pNames[nParams] := LowerCase(CurTok.SVal);
      if starPend = 1 then lamStarIdx := nParams;
      Inc(nParams);
      if params <> '' then params := params + ',';
      params := params + CurTok.SVal;
    end;
    starPend := 0;
    Next;
  end;
  Expect(tkColon, ':');
  { the body expression's token span, balanced to a depth-0 ',' ')' or line end }
  bStart := TokPos - 1;
  depth := 0;
  while CurTok.Kind <> tkEOF do
  begin
    if CurTok.Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if CurTok.Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      if depth = 0 then Break;
      Dec(depth);
    end
    else if (depth = 0) and (CurTok.Kind in [tkComma, tkNewline, tkDedent]) then Break
    { …and at a COMPREHENSION's `for`, which ends the body exactly the way a
      comma does. `list(lambda: k for k in range(3))` is a genexpr OVER
      lambdas: CPython's grammar puts the lambda body in `expression`, and
      `for` cannot follow one — an unparenthesised `for` inside a lambda body
      is not a thing the language has. Without the stop, the body span ran on
      through `k for k in range ( 3 )`, so the reconstructed source was a
      comprehension, the genexpr had no `for` clause left to iterate, and
      `list(...)` came back EMPTY where CPython gives three closures.
      `for` lexes as a plain tkIdent here (PyParseFor uses PyIsIdent('for')),
      and no Python name can be spelled `for`, so the text test is exact.
      A trailing `if` needs no stop of its own: it can only be the
      comprehension's, and that is already past this `for`.
      bug-nilpy-lambda-body-swallows-a-comprehensions-for }
    else if (depth = 0) and (CurTok.Kind = tkIdent) and
            CaseEqual(CurTok.SVal, 'for') then Break;
    Next;
  end;
  bEnd := TokPos - 1;

  { ---- LIFT: compile the lambda as a real proc when its shape allows ----
    A lambda is a nested def with one expression body, so the machinery that
    already lifts a captures-only nested def (pyboundfn_new / _bind_var, and the
    pending-body queue) serves it unchanged. Lifting means the body is COMPILED:
    keyword arguments bind by name against the real signature, method calls go
    through the ordinary call path, and there is no interpreter in the callback.
    Everything the lifter does not accept keeps the pyeval closure below — that
    fallback is the reason this can be narrow.
    (feature-nilpy-lambda-compiled-closure) }
  newPi := FindProc('pyboundfn_new');
  bindPi := FindProc('pyboundfn_bind');
  varBindPi := FindProc('pyboundfn_bind_var');
  { …up to THREE own parameters, not one. The old gate was `nParams <= 1`
    because the bridge was assumed to pass a single argument — but
    pyboundfn_callvn takes a0/a1/a2 and places `NOwn` of them before the bound
    slots, and pyboundfn_setown sets NOwn, so the runtime was already
    parameterised in count. Only this lowering was not: it reserved exactly one
    own slot and told the object nothing, so a 2- or 3-parameter lambda stayed
    an interpreted pyeval source closure — right answers, ~7x the per-call cost.
    Four or more own parameters keep the fallback: the bridge carries three.
    bug-nilpy-multi-parameter-lambdas-are-still-interpreted }
  if (not PyTypingPass) and (nParams <= 3) and (newPi >= 0) and (bindPi >= 0) and
     (varBindPi >= 0) and PyLambdaBodyIsLiftable(bStart, bEnd) then
  begin
    lamN := 0;
    { A ZERO-parameter lambda is lifted too, under a DUMMY own parameter nothing
      references. The bound-fn bridge always passes one argument, so a proc with
      no parameter at all would be called with an extra register argument and a
      shifted capture list; a name no Python source can spell absorbs it. Without
      the lift, `root.after(300, lambda: draw())` fell to the pyeval closure,
      which cannot call a COMPILED def — "pyeval: unknown call: draw()", and the
      Tk event loop never came back (bug-nilpy-zero-param-lambda-cannot-call-a-def). }
    if nParams = 0 then
    begin
      lamNames[0] := '$lamarg0';
      lamTypes[0] := tyVariant;
      lamSyms[0] := -1;
      lamRecs[0] := REC_NONE;
      lamN := 1;
    end
    else
      for i := 0 to nParams - 1 do
      begin
        lamNames[i] := pNames[i];        { own parameters, unannotated }
        lamTypes[i] := tyVariant;
        lamSyms[i] := -1;
        lamRecs[i] := REC_NONE;
        lamN := i + 1;
      end;
    { the collecting parameter is a TPyList, not a Variant — the same type the
      def-header parse gives `*args`, and what the bridge packs into }
    if (lamStarIdx >= 0) and (lamStarIdx < lamN) then
    begin
      starCi := FindUClass('TPyList');
      if starCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
      lamTypes[lamStarIdx] := tyClass;
      lamRecs[lamStarIdx] := REC_UCLASS_BASE + starCi;
    end;
    lamOwn := lamN;                       { captures are bound AFTER these }
    lamManagedCap := False;
    { the `key=key` defaults first: Python's own idiom for pinning a value }
    for i := 0 to dcCount - 1 do
    begin
      if lamN >= PY_MAX_CAPS then Break;
      lamNames[lamN] := LowerCase(dcNames[i]);
      lamTypes[lamN] := Syms[dcSyms[i]].TypeKind;
      lamSyms[lamN] := dcSyms[i];
      lamRecs[lamN] := Syms[dcSyms[i]].RecName;
      Inc(lamN);
    end;
    { then every free name in the body that is an enclosing LOCAL or PARAM —
      `self` above all. A global needs no capture: the lifted proc is top level
      and sees it directly. }
    for i := bStart to bEnd - 1 do
      if (Tokens[i].Kind = tkIdent) and
         ((i = bStart) or (Tokens[i - 1].Kind <> tkDot)) then
      begin
        nm := LowerCase(GetTokenStr(i));
        dup := False;
        for j := 0 to lamN - 1 do
          if lamNames[j] = nm then dup := True;
        if dup then Continue;
        capSym := PyProgSym(GetTokenStr(i));
        if capSym < 0 then
        begin
          { TRANSITIVE capture, the same rule a nested def already follows: the
            name is a sibling NESTED DEF, and calling it forwards ITS captures —
            which this lambda must therefore hold too. songformatter's redraw is
            exactly this: `cv.after(120, lambda: draw(cv.winfo_width()))`, where
            `draw` captures `self`; the lambda never mentions self, so without
            this the call reported "captures self, which is not in scope". }
          lamCallee := FindProc(PyQualifyNested(GetTokenStr(i)));
          if (lamCallee >= 0) and (PyCapCount[lamCallee] > 0) then
            for k := 0 to PyCapCount[lamCallee] - 1 do
            begin
              cn2 := PyCapName[lamCallee * PY_MAX_CAPS + k];
              dup := False;
              for j := 0 to lamN - 1 do
                if lamNames[j] = LowerCase(cn2) then dup := True;
              if dup then Continue;
              capSym := PyProgSym(cn2);
              if capSym < 0 then Continue;
              if not (Syms[capSym].Kind in [skLocal, skParam]) then Continue;
              if Syms[capSym].IsArray or (Syms[capSym].TypeKind = tyRecord) then Continue;
              { A managed STRING is skipped by the direct scan above (a bound
                slot holds an Int64, and a borrowed handle there would outlive
                its owner). It cannot be skipped HERE: this capture is not for
                the lambda's own use, it is an ARGUMENT the callee's call site
                must supply, and leaving it out makes that call fail with
                "captures <name>, which is not in scope at this call" — which
                is what stopped songformatter's redraw. }
              if lamN >= PY_MAX_CAPS then Break;
              lamNames[lamN] := LowerCase(cn2);
              lamTypes[lamN] := Syms[capSym].TypeKind;
              lamSyms[lamN] := capSym;
              lamRecs[lamN] := Syms[capSym].RecName;
              Inc(lamN);
            end;
          Continue;
        end;
        if not (Syms[capSym].Kind in [skLocal, skParam]) then Continue;
        if Syms[capSym].IsArray or (Syms[capSym].TypeKind = tyRecord) then Continue;
        if (Syms[capSym].TypeKind = tyAnsiString) or (Syms[capSym].TypeKind = tyString) then
        begin
          { A managed STRING cannot ride a bound slot (it holds an Int64, and a
            borrowed handle there would outlive its owner) — so this name simply
            is not captured. Skipping it QUIETLY meant the lifted body then
            referenced a name that is not in its scope: "undefined variable (s)"
            for `lambda x: s + x` over an enclosing string local. Pre-existing
            for a body containing a call (which was already lifted), and widened
            to every flat body when the sawCall gate went.
            Refuse the lift instead: the pyeval closure captures by VALUE and
            handles this shape correctly, so falling back is both correct and
            the behaviour these lambdas had before.
            bug-nilpy-lifted-lambda-cannot-capture-a-managed-string }
          lamManagedCap := True;
          Continue;
        end;
        if lamN >= PY_MAX_CAPS then Break;
        lamNames[lamN] := nm;
        lamTypes[lamN] := Syms[capSym].TypeKind;
        lamSyms[lamN] := capSym;
        lamRecs[lamN] := Syms[capSym].RecName;
        Inc(lamN);
      end;

    { PXXDBG=n.caps — the lambda's lifted parameter list (own arg first, then
      every captured/forwarded name). The capture set is what a forwarded
      sibling call needs, so when a call reports "captures X, which is not in
      scope", this is the list to look at first. }
    if PxxDbgEnabled('n.caps') then
    begin
      Write('PXXDBG n.caps lambda@', bStart, ' nest=', PyNestPrefix, ' params=');
      for j := 0 to lamN - 1 do Write(lamNames[j], ' ');
      WriteLn;
    end;

    if (not lamManagedCap) and (PyPendLamCount < PY_MAX_NESTED) then
    begin
      Inc(PyLamSeq);
      { A FUNCTION returning a variant — the ABI every bridge that invokes a
        lifted lambda declares (see PyCompileLambdaBody). Nobody reads the value;
        what matters is that the callee obeys the result convention its callers
        assume. As a procedure it did not, and the caller dereferenced a stale
        result register. }
      lamProc := RegisterProc('$pylam' + AIntToStr(PyLamSeq), True, tyVariant,
                              lamN, lamNames, lamTypes);
      Procs[lamProc].BodyAddr := -1;
      if lamStarIdx >= 0 then ProcPyStarIdx[lamProc] := lamStarIdx;
      for j := 0 to lamN - 1 do
        if (lamTypes[j] = tyClass) and (lamRecs[j] >= REC_UCLASS_BASE) and
           (j < MAX_PROC_PARAMS) then
          ProcParamRecId[lamProc * MAX_PROC_PARAMS + j] := lamRecs[j];
      PyPendLamTok[PyPendLamCount] := bStart;
      PyPendLamProc[PyPendLamCount] := lamProc;
      PyPendLamWrapReal[PyPendLamCount] := -1;   { not a callable-value wrapper }
      PyPendLamPfx[PyPendLamCount] := PyNestPrefix;
      PyPendLamSelf[PyPendLamCount] := CurSelfClass;
      Inc(PyPendLamCount);

      { pyboundfn_new(addr, nBound, a0var=1) — the own param is a variant and
        travels by ADDRESS, exactly as the nested-def path passes its own }
      argA := AllocNode(AN_ARG);
      node := AllocNode(AN_PROCADDR);
      ASTIVal[node] := lamProc; ASTTk[node] := Ord(tyPointer);
      ASTLeft[argA] := node;
      argB := AllocNode(AN_ARG);
      node := AllocNode(AN_INT_LIT);
      ASTIVal[node] := lamN - lamOwn; ASTTk[node] := Ord(tyInt64);
      ASTLeft[argB] := node;
      ASTRight[argA] := argB;
      argC := AllocNode(AN_ARG);
      node := AllocNode(AN_INT_LIT);
      ASTIVal[node] := 1; ASTTk[node] := Ord(tyInt64);
      ASTLeft[argC] := node;
      ASTRight[argB] := argC;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := newPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);

      { A DEFAULTED parameter is bound below like a capture — that is how a
        build-time default is spelled here — but it is still a PARAMETER, and a
        caller supplying it must win. Tell the bridge which bound slots those
        are, and where the caller counts them from: `nParams`, not the proc's
        own-parameter count, because a zero-parameter lambda carries a dummy own
        parameter the caller never sees. Without this the extra argument was
        clipped against NOwn and dropped, so `f = lambda x, y=k: x*y; f(3, 4)`
        returned f(3)'s answer silently
        (bug-nilpy-a-lambda-call-is-not-arity-checked). }
      { …and tell the object how many of the leading slots are OWN parameters.
        pyboundfn_new defaults NOwn to 1 — the historic assumption — so a
        2- or 3-parameter lambda would have read its second argument as a bound
        capture. Chained like the binds are, which is what pyboundfn_setown was
        written for. bug-nilpy-multi-parameter-lambdas-are-still-interpreted }
      ownPi := FindProc('pyboundfn_setown');
      if (lamOwn <> 1) and (ownPi >= 0) then
      begin
        argA := AllocNode(AN_ARG);
        ASTLeft[argA] := node;
        argB := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := lamOwn; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argB] := vNode;
        ASTRight[argA] := argB;
        node := AllocNode(AN_CALL);
        ASTIVal[node] := ownPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
      end;
      { …and which own slot COLLECTS, so the bridge packs into it instead of
        handing the body a loose argument where its signature says TPyList. }
      starPi := FindProc('pyboundfn_setstar');
      if (lamStarIdx >= 0) and (starPi >= 0) then
      begin
        argA := AllocNode(AN_ARG);
        ASTLeft[argA] := node;
        argB := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := lamStarIdx; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argB] := vNode;
        ASTRight[argA] := argB;
        node := AllocNode(AN_CALL);
        ASTIVal[node] := starPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
      end;
      defPi := FindProc('pyboundfn_setdefaults');
      { A collecting lambda has no fixed arity to declare, and a default written
        after the star is KEYWORD-only in Python — never supplied positionally,
        so there is no positional override to arrange either. setstar above
        carries the whole rule (at least StarIdx arguments, no ceiling). }
      if lamStarIdx >= 0 then defPi := -1;
      { Emitted even when dcCount = 0. `base` is the caller-side index where the
        defaulted params begin, which is exactly the count of REQUIRED caller
        arguments — so this call is also how a lifted lambda declares its legal
        arity, and NDefBase = -1 (pyboundfn_new's default) means "unchecked".
        Without it a defaults-free lambda stayed unchecked and a wrong-argument
        call was not a TypeError but a wrong answer, or a crash.
        NOwn cannot serve: a zero-parameter lambda is lifted under a DUMMY own
        parameter, so `lambda: 42` and `lambda x: x` both have NOwn = 1.
        bug-nilpy-lifted-lambda-does-not-enforce-arity }
      if defPi >= 0 then
      begin
        varMask := 0;
        for j := 0 to dcCount - 1 do
          if (lamOwn + j < lamN) and (lamTypes[lamOwn + j] = tyVariant) then
            varMask := varMask or (1 shl j);
        argA := AllocNode(AN_ARG);
        ASTLeft[argA] := node;
        argB := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := nParams; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argB] := vNode;
        ASTRight[argA] := argB;
        argC := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := dcCount; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argC] := vNode;
        ASTRight[argB] := argC;
        argD := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := varMask; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argD] := vNode;
        ASTRight[argC] := argD;
        node := AllocNode(AN_CALL);
        ASTIVal[node] := defPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
      end;

      { …and hand it the lifted proc's own SIGNATURE RECORD, so a keyword
        argument through this value matches a parameter NAME instead of meeting
        the "carries no parameter names" refusal — `f = lambda x, y=2: x*y;
        f(y=3, x=4)`. The record is the same one a tag-8 pair carries; sharing
        it is the whole point of the refactor
        (refactor-a-one-signature-record-for-every-callable-carrier).
        NAMES only: a lambda's default VALUE is captured per INSTANCE, while the
        record holds one static array per proc, so the bound slots stay the
        source of the values and setdefaults above stays.
        The record's names cover the CAPTURES too (they are real parameters of
        the lifted proc); the dispatcher clamps the visible window to
        NDefBase + NDef, so a keyword naming a capture is an unexpected keyword,
        which is what CPython answers. }
      sigPi := FindProc('pyboundfn_setsig');
      if sigPi >= 0 then
      begin
        argA := AllocNode(AN_ARG);
        ASTLeft[argA] := node;
        argB := AllocNode(AN_ARG);
        vNode := AllocNode(AN_PYSIGREF);
        ASTIVal[vNode] := lamProc; ASTTk[vNode] := Ord(tyPointer);
        ASTLeft[argB] := vNode; ASTRight[argB] := -1;
        ASTRight[argA] := argB;
        node := AllocNode(AN_CALL);
        ASTIVal[node] := sigPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
      end;

      { bind each captured value, in parameter order. Captures start AFTER the
        lambda's own parameters — `lamOwn`, not a hardcoded 1: with two own
        parameters the old bound slot 0 was the lambda's own `b`, whose lamSyms
        entry is -1 (an own parameter binds no enclosing symbol), so the bind
        built an AN_IDENT over symbol -1 and the IR came out with a garbage type
        kind. bug-nilpy-multi-parameter-lambdas-are-still-interpreted }
      for j := lamOwn to lamN - 1 do
      begin
        bindIdx := j - lamOwn;
        argA := AllocNode(AN_ARG);
        ASTLeft[argA] := node;
        argB := AllocNode(AN_ARG);
        vNode := AllocNode(AN_INT_LIT);
        ASTIVal[vNode] := bindIdx; ASTTk[vNode] := Ord(tyInt64);
        ASTLeft[argB] := vNode;
        ASTRight[argA] := argB;
        argC := AllocNode(AN_ARG);
        ASTLeft[argC] := PyMakeIdent(lamSyms[j]);
        ASTRight[argB] := argC;
        node := AllocNode(AN_CALL);
        if lamTypes[j] = tyVariant then ASTIVal[node] := varBindPi
        else ASTIVal[node] := bindPi;
        ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
      end;

      CurASTNode := node;
      LastExprTk := tyPointer;
      Exit;
    end;
  end;

  pi := FindProc('pyclosure_src_new');
  capPi := FindProc('pyclosure_src_cap');
  if (pi < 0) or (capPi < 0) then
  begin
    { pyeval not loaded: keep the old degrade-to-None behaviour }
    CurASTNode := PyMakeNone;
    LastExprTk := tyVariant;
    Exit;
  end;

  src := 'return';
  for i := bStart to bEnd - 1 do
    src := src + ' ' + PyLambdaTokText(i);

  { A defaulted name is a PARAMETER as well as a default. It is bound below as a
    cap under its own name (the default), and listing it here is what lets a
    caller's argument override it — PyClosureInvoke binds params positionally and
    now leaves an unsupplied one at its cap value. Without this the argument had
    no parameter to land in and was silently dropped, so `f = lambda x, y=k: x*y`
    answered f(3) for f(3, 4) (bug-nilpy-a-lambda-call-is-not-arity-checked).
    Appended AFTER the plain params, which is where Python requires them. }
  for i := 0 to dcCount - 1 do
  begin
    if params <> '' then params := params + ',';
    params := params + dcNames[i];
  end;

  { pyclosure_src_new(params, src) }
  argA := AllocNode(AN_ARG);
  argB := AllocNode(AN_STR_LIT);
  ASTSOffset[argB] := PyStoredName(params); ASTSLen[argB] := Length(params);
  ASTTk[argB] := Ord(tyString);
  ASTLeft[argA] := argB;
  argB := AllocNode(AN_ARG);
  node := AllocNode(AN_STR_LIT);
  ASTSOffset[node] := PyStoredName(src); ASTSLen[node] := Length(src);
  ASTTk[node] := Ord(tyString);
  ASTLeft[argB] := node;
  ASTRight[argA] := argB;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := pi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);

  { Declare the legal argument-count RANGE: the plain params are required, the
    defaulted ones optional. Recorded here rather than counted from `params` at
    run time because the two disagree for a nested DEF's closure, whose defaults
    are captures and are absent from Params — see TPyClosure.ReqN. Only this
    lowering declares a range, so every other closure builder stays unchecked
    and the callback bridges keep their leniency
    (bug-nilpy-a-lambda-call-with-the-wrong-argument-count-does-not-raise). }
  arityPi := FindProc('pyclosure_setarity');
  if arityPi >= 0 then
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    ASTLeft[argB] := PyMakeIntLit(nParams);
    ASTRight[argA] := argB;
    argC := AllocNode(AN_ARG);
    ASTLeft[argC] := PyMakeIntLit(nParams + dcCount);
    ASTRight[argB] := argC;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := arityPi; ASTLeft[node] := argA;
    ASTTk[node] := Ord(tyPointer);
  end;

  { capture each free name that resolves to a value symbol: chained
    pyclosure_src_cap(obj, 'name', name). Idents after a '.' are members;
    the lambda's own params bind at invoke time. }
  for i := bStart to bEnd - 1 do
    if (Tokens[i].Kind = tkIdent) and
       ((i = bStart) or (Tokens[i - 1].Kind <> tkDot)) then
    begin
      nm := LowerCase(GetTokenStr(i));
      dup := False;
      for j := 0 to nParams - 1 do
        if pNames[j] = nm then dup := True;
      { a name captured once is enough (values, not references) }
      for j := bStart to i - 1 do
        if (Tokens[j].Kind = tkIdent) and (LowerCase(GetTokenStr(j)) = nm) and
           ((j = bStart) or (Tokens[j - 1].Kind <> tkDot)) then dup := True;
      if dup then Continue;
      symIdx := PyProgSym(GetTokenStr(i));
      if symIdx < 0 then Continue;
      if not (Syms[symIdx].Kind in [skGlobal, skLocal, skParam]) then Continue;
      if Syms[symIdx].IsArray or (Syms[symIdx].TypeKind = tyRecord) then Continue;
      argA := AllocNode(AN_ARG);
      ASTLeft[argA] := node;                       { the closure obj so far }
      argB := AllocNode(AN_ARG);
      capNode := AllocNode(AN_STR_LIT);
      ASTSOffset[capNode] := PyStoredName(GetTokenStr(i));
      ASTSLen[capNode] := Length(GetTokenStr(i));
      ASTTk[capNode] := Ord(tyString);
      ASTLeft[argB] := capNode;
      ASTRight[argA] := argB;
      capNode := AllocNode(AN_ARG);
      ASTLeft[capNode] := PyMakeIdent(symIdx);
      ASTRight[argB] := capNode;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := capPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
    end;

  { the defaulted params, bound under the PARAMETER's name }
  for i := 0 to dcCount - 1 do
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    capNode := AllocNode(AN_STR_LIT);
    ASTSOffset[capNode] := PyStoredName(dcNames[i]);
    ASTSLen[capNode] := Length(dcNames[i]);
    ASTTk[capNode] := Ord(tyString);
    ASTLeft[argB] := capNode;
    ASTRight[argA] := argB;
    capNode := AllocNode(AN_ARG);
    ASTLeft[capNode] := PyMakeIdent(dcSyms[i]);
    ASTRight[argB] := capNode;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := capPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;

  CurASTNode := node;
  LastExprTk := tyPointer;
end;

{ A NESTED def taken AS A VALUE whose meaning depends on values live RIGHT NOW —
  default-arg expressions (`def does_runtime(vm2, _addr=data_addr): ...`, the
  uforth DOES> idiom: defaults bind per-invocation of the enclosing word) or
  scanned captures. A plain proc ADDRESS loses those bindings, so build a pyeval
  closure instead: pyclosure_src_new(<non-default params>, <body source>) with
  each defaulted param and each captured enclosing name bound as a build-time
  value cap. Returns the AST node, or -1 when the plain address is still right
  (no defaults, no captures — the fast path stays untouched). }
{ Bound-compiled-fn VALUE for a captures-only nested def: pyboundfn_new(addr,
  n) then chained pyboundfn_bind(obj, i, <capture value>) — each capture
  resolved HERE, the same actual a direct call site would append. Returns -1
  when a capture cannot travel as a register word (variant/unresolved), so the
  caller falls back to the plain address. }
function PyMakeBoundFnValue(procIdx: Integer): Integer;
var j, symIdx, node, argA, argB, argC, pi, bindPi, varBindPi, vNode: Integer;
    nm: AnsiString;
begin
  Result := -1;
  pi := FindProc('pyboundfn_new');
  bindPi := FindProc('pyboundfn_bind');
  varBindPi := FindProc('pyboundfn_bind_var');
  if (pi < 0) or (bindPi < 0) or (varBindPi < 0) then Exit;
  if PyCapCount[procIdx] > 12 then Exit;
  for j := 0 to PyCapCount[procIdx] - 1 do
  begin
    nm := PyCapName[procIdx * PY_MAX_CAPS + j];
    symIdx := PyProgSym(nm);
    if symIdx < 0 then Exit;
    if not (Syms[symIdx].Kind in [skGlobal, skLocal, skParam]) then Exit;
    { a MANAGED capture stored as a raw word would dangle when the enclosing
      scope releases it — refuse, fall back to the plain address. Variants are
      fine: they bind through a heap COPY (pyboundfn_bind_var). }
    if (Syms[symIdx].TypeKind = tyAnsiString) or (Syms[symIdx].TypeKind = tyString) then Exit;
    if Syms[symIdx].IsArray or (Syms[symIdx].TypeKind = tyRecord) then Exit;
  end;

  argA := AllocNode(AN_ARG);
  node := AllocNode(AN_PROCADDR);
  ASTIVal[node] := procIdx; ASTTk[node] := Ord(tyPointer);
  ASTLeft[argA] := node;
  argB := AllocNode(AN_ARG);
  node := AllocNode(AN_INT_LIT);
  ASTIVal[node] := PyCapCount[procIdx]; ASTTk[node] := Ord(tyInt64);
  ASTLeft[argB] := node;
  ASTRight[argA] := argB;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := pi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);

  for j := 0 to PyCapCount[procIdx] - 1 do
  begin
    nm := PyCapName[procIdx * PY_MAX_CAPS + j];
    symIdx := PyProgSym(nm);
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := j; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argB] := vNode;
    ASTRight[argA] := argB;
    argC := AllocNode(AN_ARG);
    { a CELL capture binds the shared cell's address — see PyNestedDefClosureValue }
    if SymCellPtr[symIdx] >= 0 then
      ASTLeft[argC] := PyMakeCellPtr(symIdx)
    else
      ASTLeft[argC] := PyMakeIdent(symIdx);
    ASTRight[argB] := argC;
    node := AllocNode(AN_CALL);
    if (Syms[symIdx].TypeKind = tyVariant) and (SymCellPtr[symIdx] < 0) then
      ASTIVal[node] := varBindPi
    else
      ASTIVal[node] := bindPi;
    ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;
  Result := node;
end;

procedure PyWarnUnbindableClosure(procIdx: Integer; const why: AnsiString);
{ A nested def taken AS A VALUE whose captures cannot be bound falls back to
  the bare code address — and the compiled body then reads its lifted capture
  parameters out of whatever the registers happen to hold. That fallback is a
  silently wrong program, so it says so. A warning and not an error because the
  shape is legal Python and the value may never actually be called; the
  diagnostic is what turns a plausible number into something greppable. }
begin
  if PyCapCount[procIdx] <= 0 then Exit;   { nothing to bind: the address IS the value }
  WarnAt(CurTok.Line,
         'Nil Python: the nested def ' + Procs[procIdx].Name +
         ' captures enclosing names but cannot carry them as a value because ' +
         why + ' — calling it after the enclosing call returns will read garbage');
end;

function PyNestedDefClosureValue(procIdx: Integer): Integer;
var defTok, i, j, k, depth: Integer;
    pNames: array[0..15] of AnsiString;
    pDefS, pDefE: array[0..15] of Integer;
    nP, nDef, nOwn, bindIdx, savedTok, ownPi: Integer;
    starPi: Integer;
    node, argA, argB, argC, argD, vNode, newPi, bindPi, varBindPi, symIdx: Integer;
    objBindPi, cellBindPi, defPi, varMask: Integer;
    sigPi: Integer;                  { pyboundfn_setsig — the parameter NAMES }
    nm: AnsiString;
    anyBind: Boolean;

  { Which parameter of the lifted body does bound value `bi` land in? The
    captures were appended AFTER the def's own parameters, so it is own-count +
    bi. This used to be spelled `bindIdx + 1` inline at both call sites — the
    same "exactly one own argument" assumption the call bridge made, and it
    misread the type of a NEIGHBOURING parameter once the arity was not 1,
    binding an integer capture as a variant address
    (bug-nilpy-escaping-closure-captures-unbound-unless-arity-is-one). Named so
    the two sites cannot drift apart again. }
  function BoundParamIsVariant(bi: Integer): Boolean;
  var pidx: Integer;
  begin
    pidx := nOwn + bi;
    BoundParamIsVariant := (pidx < Procs[procIdx].ParamCount) and
                           (Procs[procIdx].Params[pidx].TypeKind = tyVariant);
  end;

  { Is the callee's parameter for bound value `bi` declared BY-REF? That is how a
    `nonlocal` capture is marked (PyBodyDeclaresNonlocal sets Params[].IsRef), and
    it changes what must be BOUND: the body stores THROUGH the word, so it needs
    the address of a cell, not a value. Same nOwn + bi indexing as
    BoundParamIsVariant, and for the same reason — the captures sit after the
    def's own parameters. }
  function BoundParamIsRef(bi: Integer): Boolean;
  var pidx: Integer;
  begin
    pidx := nOwn + bi;
    BoundParamIsRef := (pidx < Procs[procIdx].ParamCount) and
                       Procs[procIdx].Params[pidx].IsRef;
  end;

  { chain one pyboundfn_bind / _bind_var / _bind_obj / _bind_cell call:
    node := bind(node, idx, valNode) }
  procedure ChainBind(valNode: Integer; isVar: Boolean; isObj: Boolean;
                      isCell: Boolean);
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := bindIdx; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argB] := vNode;
    ASTRight[argA] := argB;
    argC := AllocNode(AN_ARG);
    ASTLeft[argC] := valNode;
    ASTRight[argB] := argC;
    node := AllocNode(AN_CALL);
    { The cell is the LAST resort. bind_var already passes an ADDRESS — of a
      16-byte heap Variant slot — which is what a by-ref parameter needs, so a
      VARIANT by-ref capture keeps bind_var; giving it an 8-byte cell would hand
      the body half the storage a variant writes.

      Honest about the evidence: NO test distinguishes this ordering from
      cell-first. Both were built and every closure case measured identically,
      and the variant-cell shape that would tell them apart is blocked earlier by
      a different limitation (a str capture is refused as "cannot travel as a
      register word"). This ordering is chosen because the failure it avoids is
      heap corruption rather than a wrong value, not because it fixed something.
      I first changed it believing it explained the constant-8 read; it did not —
      that was PyMakeFuncValueFor never binding captures at all.

      The obj/var precedence is unchanged from before the cell existed. A CLASS
      capture declared nonlocal keeps bind_obj and so still lacks a writable
      cell — recorded on the ticket rather than guessed at here. }
    if isObj and (objBindPi >= 0) then ASTIVal[node] := objBindPi
    else if isVar then ASTIVal[node] := varBindPi
    else if isCell and (cellBindPi >= 0) then ASTIVal[node] := cellBindPi
    else ASTIVal[node] := bindPi;
    ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
    Inc(bindIdx);
  end;

begin
  { A nested def taken AS A VALUE whose meaning depends on values live NOW —
    default-arg expressions (uforth's DOES>/DEFER: the defaults bind
    per-invocation values) or scanned captures (uforth's MARKER restore).
    Lowered to a BOUND COMPILED FUNCTION: pyboundfn_new(addr, n) with each
    defaulted param's expression and each capture VALUE bound in parameter
    order; the call bridge then invokes the COMPILED body natively as
    code(arg, defaults..., caps...). -1 = nothing to bind (plain address) or
    an unbindable shape (fall back to the plain address). }
  Result := -1;
  if (procIdx < 0) or (PyDefTokOf[procIdx] = 0) then Exit;
  defTok := PyDefTokOf[procIdx] - 1;
  newPi := FindProc('pyboundfn_new');
  bindPi := FindProc('pyboundfn_bind');
  varBindPi := FindProc('pyboundfn_bind_var');
  objBindPi := FindProc('pyboundfn_bind_obj');
  cellBindPi := FindProc('pyboundfn_bind_cell');
  if (newPi < 0) or (bindPi < 0) or (varBindPi < 0) then Exit;

  { scan the header straight off the tokens: def NAME ( params ) ... }
  i := defTok;
  if Tokens[i].Kind <> tkFunction then Exit;
  Inc(i);
  Inc(i);
  if Tokens[i].Kind <> tkLParen then Exit;
  Inc(i);
  nP := 0;
  depth := 1;
  while (i < TokCount) and (depth > 0) do
  begin
    if Tokens[i].Kind = tkLParen then Inc(depth)
    else if Tokens[i].Kind = tkRParen then
    begin
      Dec(depth);
      if depth = 0 then Break;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            ((Tokens[i - 1].Kind = tkLParen) or (Tokens[i - 1].Kind = tkComma) or
             ((Tokens[i - 1].Kind = tkStar) and (i >= 2) and
              ((Tokens[i - 2].Kind = tkLParen) or (Tokens[i - 2].Kind = tkComma)))) then
    begin
      { `*args` is a PARAMETER — one TPyList slot the bridge packs into. The
        scan matched only an ident after `(` or `,`, so a collecting nested def
        counted ZERO own parameters and pyboundfn_setown published 0: the
        bridge then placed the captures one slot too far left and the body read
        its own `args` out of a capture word (len(args) = 1275068416, and the
        capture itself came back empty). `**kw` is a tkStar preceded by another
        tkStar and is deliberately still not counted — that shape does not
        compile at all yet. }
      if nP > High(pNames) then Exit;
      pNames[nP] := GetTokenStr(i);
      pDefS[nP] := -1; pDefE[nP] := -1;
      Inc(nP);
    end
    else if (depth = 1) and (Tokens[i].Kind = tkAssign) and (nP > 0) then
    begin
      pDefS[nP - 1] := i + 1;
      j := i + 1; k := 0;
      while j < TokCount do
      begin
        if Tokens[j].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(k)
        else if Tokens[j].Kind in [tkRParen, tkRBrack, tkEnd] then
        begin
          if k = 0 then Break;
          Dec(k);
        end
        else if (k = 0) and (Tokens[j].Kind = tkComma) then Break;
        Inc(j);
      end;
      pDefE[nP - 1] := j;
      i := j - 1;
    end;
    Inc(i);
  end;

  nDef := 0;
  nOwn := 0;
  for j := 0 to nP - 1 do
    if pDefS[j] >= 0 then Inc(nDef) else Inc(nOwn);
  anyBind := (nDef > 0) or (PyCapCount[procIdx] > 0);
  if PxxDbgEnabled('n.bfn') then
    WriteLn('PXXDBG n.bfn ', Procs[procIdx].Name, ' nP=', nP, ' nDef=', nDef,
            ' nOwn=', nOwn, ' caps=', PyCapCount[procIdx],
            ' defTok=', PyDefTokOf[procIdx], ' params=', Procs[procIdx].ParamCount);
  { An UNANNOTATED single param compiled as a VARIANT also forces the bound-fn
    wrapper even with nothing to bind: the raw-address fallback lets the
    call bridge marshal per the FIELD's Callable annotation (vm: VM -> raw
    instance pointer) while the compiled body reads the slot as a variant —
    the pointer was reinterpreted as a variant tag and the first method call
    dispatched through garbage (uforth's `def w(vm):` native words, /STRING).
    The wrapper's A0Var route passes the argument boxed by address instead. }
  if not anyBind then
    if (nOwn <> 1) or (nDef > 0) or (Procs[procIdx].ParamCount < 1) or
       (Procs[procIdx].Params[0].TypeKind <> tyVariant) then Exit;
  { The bridge marshals up to THREE own arguments before the bound values, so
    every ordinary closure arity is representable. It used to assume exactly
    one and this read `if nOwn <> 1 then Exit` — and that Exit did not fall
    back to anything safe: it emitted the bare code address with NO captures
    bound, so `def b():` capturing an enclosing local read its captures out of
    the dead parent frame and printed an address
    (bug-nilpy-escaping-closure-captures-unbound-unless-arity-is-one).
    Past three, there is still no way to pass the arguments — WARN rather than
    silently produce that wrong value. }
  if nOwn > 3 then
  begin
    PyWarnUnbindableClosure(procIdx, 'it takes ' + PyIntLiteralText(nOwn) +
                            ' arguments and the call bridge marshals at most 3');
    Exit;
  end;
  { The ceiling is the bound-fn object's slot array (PY_MAX_CAPS of them), not
    the call bridge: the bridge now has an exact-arity entry for every arity up
    to 32, so 3 own + 20 bound is representable. This used to read `> 12`,
    mirroring the bridge's old highest arity, and everything past it fell out
    here to the bare code address — which reads its captures from the dead
    parent frame. }
  if nDef + PyCapCount[procIdx] > PY_MAX_CAPS then
  begin
    PyWarnUnbindableClosure(procIdx, 'it has more than ' +
                            PyIntLiteralText(PY_MAX_CAPS) + ' values to bind');
    Exit;
  end;

  { every capture must resolve to a value symbol we can bind }
  for j := 0 to PyCapCount[procIdx] - 1 do
  begin
    nm := PyCapName[procIdx * PY_MAX_CAPS + j];
    symIdx := PyProgSym(nm);
    if symIdx < 0 then
    begin
      PyWarnUnbindableClosure(procIdx, 'it captures ' + nm + ', which does not resolve here');
      Exit;
    end;
    if not (Syms[symIdx].Kind in [skGlobal, skLocal, skParam]) then
    begin
      PyWarnUnbindableClosure(procIdx, 'it captures ' + nm + ', which is not a value');
      Exit;
    end;
    if (Syms[symIdx].TypeKind = tyAnsiString) or (Syms[symIdx].TypeKind = tyString) then
    begin
      PyWarnUnbindableClosure(procIdx, 'it captures the string ' + nm +
                              ', which cannot travel as a register word');
      Exit;
    end;
    if Syms[symIdx].IsArray or (Syms[symIdx].TypeKind = tyRecord) then
    begin
      PyWarnUnbindableClosure(procIdx, 'it captures ' + nm +
                              ', an array or record, which cannot travel as a register word');
      Exit;
    end;
  end;

  { pyboundfn_new(addr, n, a0var) — a0var says whether the own params are
    VARIANT (unannotated) and must travel by address }
  argA := AllocNode(AN_ARG);
  node := AllocNode(AN_PROCADDR);
  ASTIVal[node] := procIdx; ASTTk[node] := Ord(tyPointer);
  ASTLeft[argA] := node;
  argB := AllocNode(AN_ARG);
  node := AllocNode(AN_INT_LIT);
  ASTIVal[node] := nDef + PyCapCount[procIdx]; ASTTk[node] := Ord(tyInt64);
  ASTLeft[argB] := node;
  ASTRight[argA] := argB;
  argC := AllocNode(AN_ARG);
  node := AllocNode(AN_INT_LIT);
  { nOwn > 0 guard: with no own parameters, Params[0] is the first LIFTED
    CAPTURE, and testing its type would set the by-address flag off a value the
    caller never passes. }
  if (nOwn > 0) and (Procs[procIdx].ParamCount > 0) and
     (Procs[procIdx].Params[0].TypeKind = tyVariant) then
    ASTIVal[node] := 1
  else
    ASTIVal[node] := 0;
  ASTTk[node] := Ord(tyInt64);
  ASTLeft[argC] := node;
  ASTRight[argB] := argC;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := newPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);

  { ...then say how many OWN parameters the body takes, so the bridge knows how
    many argument slots precede the captures. pyboundfn_new defaults it to 1 for
    the lambda lifter, which injects a dummy own parameter precisely because the
    bridge used to have no way to be told otherwise. }
  ownPi := FindProc('pyboundfn_setown');
  if ownPi >= 0 then
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := nOwn; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argB] := vNode;
    ASTRight[argA] := argB;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := ownPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;

  { ...and which own slot COLLECTS. `def wrapper(*args)` capturing an enclosing
    name — the decorator's own shape — is a nested def with captures, so it
    comes through HERE rather than through PyMakeFuncValueFor's pair, and
    without this the bridge handed the body loose arguments where its signature
    declares one TPyList. Exactly the call the LAMBDA lifter makes; only that
    lifter made it, which is the same "sibling construct left wrong" shape the
    defaults note below records. }
  starPi := FindProc('pyboundfn_setstar');
  if (starPi >= 0) and (procIdx >= 0) and (procIdx < ProcCount) and
     (ProcPyStarIdx[procIdx] >= 0) then
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := ProcPyStarIdx[procIdx]; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argB] := vNode;
    ASTRight[argA] := argB;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := starPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;

  { ...and which of the bound slots are DEFAULTED PARAMETERS, so a caller that
    supplies one WINS. Without this the bridge clipped every argument past
    nOwn and the default was used regardless: `def inc(by=1)` inside a function
    answered inc(2) as if it were inc() — silently, on ordinary Python
    (bug-nilpy-a-nested-defs-default-parameter-ignores-the-callers-value).
    The defaults occupy bound slots 0..nDef-1 (they are bound first, below), and
    the caller counts their positions from nOwn. Exactly the call the LAMBDA
    lifter already makes; only that lifter made it, which is why the sibling
    construct was wrong. }
  defPi := FindProc('pyboundfn_setdefaults');
  if (defPi >= 0) and (nDef > 0) then
  begin
    varMask := 0;
    for j := 0 to nDef - 1 do
      if BoundParamIsVariant(j) then varMask := varMask or (1 shl j);
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := nOwn; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argB] := vNode;
    ASTRight[argA] := argB;
    argC := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := nDef; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argC] := vNode;
    ASTRight[argB] := argC;
    argD := AllocNode(AN_ARG);
    vNode := AllocNode(AN_INT_LIT);
    ASTIVal[vNode] := varMask; ASTTk[vNode] := Ord(tyInt64);
    ASTLeft[argD] := vNode;
    ASTRight[argC] := argD;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := defPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;

  { ...and the def's own SIGNATURE RECORD, so a keyword argument through this
    value binds by NAME — `h = make(); h(v=3)` — instead of meeting the
    "carries no parameter names" refusal. Same record a tag-8 pair carries, read
    through the same lookup; that sharing is the refactor
    (refactor-a-one-signature-record-for-every-callable-carrier).
    NAMES only, exactly as at the lambda site: the default VALUES stay in the
    bound slots because they are captured per INSTANCE of the closure, while the
    record is one static array per proc. The record also names the CAPTURES,
    which are real parameters of the lifted proc; the dispatcher clamps the
    visible window to NDefBase + NDef so naming one is an unexpected keyword. }
  sigPi := FindProc('pyboundfn_setsig');
  if sigPi >= 0 then
  begin
    argA := AllocNode(AN_ARG);
    ASTLeft[argA] := node;
    argB := AllocNode(AN_ARG);
    vNode := AllocNode(AN_PYSIGREF);
    ASTIVal[vNode] := procIdx; ASTTk[vNode] := Ord(tyPointer);
    ASTLeft[argB] := vNode; ASTRight[argB] := -1;
    ASTRight[argA] := argB;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := sigPi; ASTLeft[node] := argA; ASTTk[node] := Ord(tyPointer);
  end;
  bindIdx := 0;

  { bind each DEFAULTED param — from the hidden `$pdef.<def>.<param>` global the
    DEF STATEMENT stored, when there is one.

    This used to re-parse the expression HERE, and the comment claimed that was
    "the scope where the def statement stands — Python's default-at-def-time
    rule". It has the SCOPE right and the TIME wrong: here is where the def is
    taken as a VALUE, which can be many statements later, so

        def make():
            seed = 5
            def h(v=seed): return v
            seed = 99
            return h                     # <- re-parsed `seed` HERE

    bound 99 where CPython binds 5 (bug-nilpy-a-nested-defs-default-is-
    evaluated-at-value-time-not-def-time). The def-time value already exists:
    PyEvalParamDefault evaluates every non-constant default into that global at
    the `def` statement, which is what makes the shared-mutable-default idiom
    accumulate, and the direct-call path has read it all along. Two mechanisms
    for one concept, disagreeing — devdocs/dev/normalise-dont-special-case.md.

    uforth's DOES>/DEFER, which the re-parse was written for, is unaffected: the
    store is IN the enclosing body, so each enclosing invocation still evaluates
    its own defaults before this value is built.

    A CONSTANT default has no global (a literal cannot observe the difference)
    and still re-parses. }
  for j := 0 to nP - 1 do
    if pDefS[j] >= 0 then
    begin
      k := -1;
      if (j < MAX_PROC_PARAMS) and
         (ProcParamDefaultSym[procIdx * MAX_PROC_PARAMS + j] >= 0) then
        k := PyMakeIdent(ProcParamDefaultSym[procIdx * MAX_PROC_PARAMS + j]);
      if k < 0 then
      begin
      savedTok := TokPos - 1;
      TokPos := pDefS[j];
      Next;
      PyParseBoolExpr;
      k := CurASTNode;
      TokPos := savedTok;
      Next;
      end;
      { pass mode follows the CALLEE PARAM's type: a variant param reads an
        ADDRESS (bind_var heap-boxes the value), a concrete one a raw word }
      ChainBind(k, BoundParamIsVariant(bindIdx), False,
                BoundParamIsRef(bindIdx));
    end;

  { then each scanned CAPTURE, by current value }
  for j := 0 to PyCapCount[procIdx] - 1 do
  begin
    nm := PyCapName[procIdx * PY_MAX_CAPS + j];
    symIdx := PyProgSym(nm);
    { a CLASS capture binds through the retaining form: the enclosing scope
      releases its own reference on return, and the closure outlives it.
      A `nonlocal` capture instead binds a heap CELL: its parameter is by-ref, so
      the body stores through the bound word, and binding the VALUE meant storing
      through the value-as-address — `c = 0` then `c = 5` wrote to address 0 and
      the process died (measured: `mov %eax,(%rcx)` with rcx = the captured
      value). The cell also outlives the frame, which is what gives an escaped
      counter its shared state across calls
      (bug-nilpy-nonlocal-capture-in-an-escaping-closure-fails-to-parse). }
    { A CELL capture binds the cell's ADDRESS — the pointer the frame already
      holds — so the closure and the frame share one storage. The plain binder
      is right for it: the cell exists, so there is nothing to allocate, and the
      callee's parameter is by-ref, which is exactly what a cell address wants.
      pyboundfn_bind_cell (a fresh copy per closure) is the OLD answer, kept for
      the shapes PyCellPromotable refuses. }
    if SymCellPtr[symIdx] >= 0 then
      ChainBind(PyMakeCellPtr(symIdx), False, False, False)
    else
      ChainBind(PyMakeIdent(symIdx), BoundParamIsVariant(bindIdx),
                Syms[symIdx].TypeKind = tyClass, BoundParamIsRef(bindIdx));
  end;

  Result := node;
end;

{ The object as a POINTER for the dynamic-attribute store: a variant is unboxed
  through pyvarobj; a class instance already IS the object pointer. }
function PyMakeObjPtr(baseNode: Integer): Integer;
var procIdx, argNode: Integer;
begin
  if IntToTypeKind(ASTTk[baseNode]) <> tyVariant then begin Result := baseNode; Exit; end;
  procIdx := FindProc('pyvarobj');
  if procIdx < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  argNode := AllocNode(AN_ARG); ASTLeft[argNode] := baseNode; ASTRight[argNode] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyPointer);
  ASTLeft[Result] := argNode;
end;

{ `obj.name` (dynamic attribute read) -> pydynattr_get(obj, "name") for a
  receiver STATICALLY known to be a class (obj is a genuine object pointer,
  or nil), else pydynattr_get_v(v, "name") for a VARIANT receiver — its
  runtime tag decides whether the payload is even an object pointer at all,
  and pydynattr_get(pyvarobj(v), ...)'s naive unwrap would ClassName garbage
  for a scalar (str/int/float/bool) variant on a miss. }
function PyMakeDynAttrGet(baseNode: Integer; const fname: AnsiString): Integer;
var procIdx, a0, a1, nameNode: Integer; isVariantRecv: Boolean;
begin
  isVariantRecv := IntToTypeKind(ASTTk[baseNode]) = tyVariant;
  if isVariantRecv then
    procIdx := FindProc('pydynattr_get_v')
  else
    procIdx := FindProc('pydynattr_get');
  if procIdx < 0 then Error('Nil Python: pylib (pydynattr_get/_v) not loaded');
  nameNode := AllocNode(AN_STR_LIT);
  ASTSOffset[nameNode] := PyStoredName(fname);
  ASTSLen[nameNode] := Length(fname);
  ASTTk[nameNode] := Ord(tyString);
  a0 := AllocNode(AN_ARG);
  if isVariantRecv then ASTLeft[a0] := baseNode
  else ASTLeft[a0] := PyMakeObjPtr(baseNode);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode;
  ASTRight[a0] := a1; ASTRight[a1] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyVariant);
  ASTLeft[Result] := a0;
end;

{ `obj.name = val` (dynamic attribute write) -> pydynattr_set(obj, "name", val),
  or pydynattr_set_v(v, "name", val) for a VARIANT receiver — whose runtime tag
  decides whether the payload is an instance at all. A class held as a value has
  an RTTI blob there, and PyMakeObjPtr's unwrap would key the write on the blob
  address: `c.num = 9` then wrote a slot nothing ever reads back, so the class,
  its instances and every other reference all kept the old value.
  bug-nilpy-class-attribute-through-a-class-reference-reads-garbage }
function PyMakeDynAttrSet(baseNode: Integer; const fname: AnsiString; valNode: Integer): Integer;
var procIdx, a0, a1, a2, nameNode: Integer; isVariantRecv: Boolean;
begin
  isVariantRecv := IntToTypeKind(ASTTk[baseNode]) = tyVariant;
  if isVariantRecv then
    procIdx := FindProc('pydynattr_set_v')
  else
    procIdx := FindProc('pydynattr_set');
  if procIdx < 0 then Error('Nil Python: pylib (pydynattr_set/_v) not loaded');
  nameNode := AllocNode(AN_STR_LIT);
  ASTSOffset[nameNode] := PyStoredName(fname);
  ASTSLen[nameNode] := Length(fname);
  ASTTk[nameNode] := Ord(tyString);
  a0 := AllocNode(AN_ARG);
  if isVariantRecv then ASTLeft[a0] := baseNode
  else ASTLeft[a0] := PyMakeObjPtr(baseNode);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := valNode;
  ASTRight[a0] := a1; ASTRight[a1] := a2; ASTRight[a2] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyUnknown);
  ASTLeft[Result] := a0;
end;

{ `setattr(o, <expr>, v)` — the COMPUTED-name write, the mirror of
  PyMakeDynAttrByExpr's read. The name arrives as an expression (a variant, in
  the shape that motivates setattr at all: `setattr(o, "f_" + k, v)`), and the
  runtime entry takes an AnsiString, so it is rendered with pystr_of — the one
  conversion every other by-name site uses. }
function PyMakeDynAttrSetByExpr(recvNode, nameNode, valNode: Integer): Integer;
var procIdx, a0, a1, a2, sNode, sArg: Integer;
begin
  procIdx := FindProc('pydynattr_set_v');
  if procIdx < 0 then Error('Nil Python: pylib (pydynattr_set_v) not loaded');
  if IntToTypeKind(ASTTk[nameNode]) <> tyAnsiString then
  begin
    sArg := AllocNode(AN_ARG);
    ASTLeft[sArg] := PyForceVariant(nameNode);
    ASTRight[sArg] := -1;
    sNode := AllocNode(AN_CALL);
    ASTIVal[sNode] := FindProc('pystr_of');
    if ASTIVal[sNode] < 0 then Error('Nil Python: pylib (pystr_of) not loaded');
    ASTTk[sNode] := Ord(tyAnsiString);
    ASTLeft[sNode] := sArg;
    nameNode := sNode;
  end;
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := PyForceVariant(recvNode);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := PyForceVariant(valNode);
  ASTRight[a0] := a1; ASTRight[a1] := a2; ASTRight[a2] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyUnknown);
  ASTLeft[Result] := a0;
end;

{ Publish this class's class ATTRIBUTES to the run time, one
  `pyclsattr_bind(<RTTI blob>, "name", @slot, kind)` per attribute, hoisted where
  the class statement runs.

  It exists because a class attribute is not stored on the class: PyClsAttrSlot
  gives each one a hidden GLOBAL, and all three compile-time access routes
  (`C.attr`, bare `attr` in a method, `inst.attr`) resolve that global by a name
  only the frontend knows. A class held as a VALUE has no class index at the
  point of the read, so nothing was left for it to consult and the read fell
  through to an instance-field path that indexed INSIDE the RTTI blob — a
  plausible integer where 7 was stored, and the empty string for a str. The bind
  is the missing link: name and slot ADDRESS, so the read and the write reach the
  same memory the three static routes do.
  bug-nilpy-class-attribute-through-a-class-reference-reads-garbage }
procedure PyEmitClsAttrBinds(ci: Integer);
var i, procIdx, clsNode, nameNode, addrNode, kindNode: Integer;
    a0, a1, a2, a3, callNode: Integer;
    nm: AnsiString;
begin
  procIdx := FindProc('pyclsattr_bind');
  if procIdx < 0 then Exit;          { pylib not loaded — nothing to publish to }
  for i := 0 to ClassVarCount - 1 do
  begin
    if ClassVarCi[i] <> ci then Continue;
    if ClassVarSym[i] < 0 then Continue;
    nm := GetTokenStrFromRaw(ClassVarNOff[i], ClassVarNLen[i]);
    { the class's RTTI blob as a raw POINTER — ASTRight 0, i.e. NOT the
      VT_CLASSREF-variant lowering the `cls = A` builder asks for }
    clsNode := AllocNode(AN_CLASSREF);
    ASTIVal[clsNode] := ci;
    ASTRight[clsNode] := 0;
    ASTTk[clsNode] := Ord(tyPointer);
    nameNode := AllocNode(AN_STR_LIT);
    ASTSOffset[nameNode] := PyStoredName(nm);
    ASTSLen[nameNode] := Length(nm);
    ASTTk[nameNode] := Ord(tyString);
    addrNode := AllocNode(AN_ADDR);
    ASTLeft[addrNode] := PyMakeIdent(ClassVarSym[i]);
    ASTTk[addrNode] := Ord(tyPointer);
    kindNode := AllocNode(AN_INT_LIT);
    ASTIVal[kindNode] := Ord(Syms[ClassVarSym[i]].TypeKind);
    ASTTk[kindNode] := Ord(tyInt64);
    a0 := AllocNode(AN_ARG); ASTLeft[a0] := clsNode;
    a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode;
    a2 := AllocNode(AN_ARG); ASTLeft[a2] := addrNode;
    a3 := AllocNode(AN_ARG); ASTLeft[a3] := kindNode;
    ASTRight[a0] := a1; ASTRight[a1] := a2; ASTRight[a2] := a3; ASTRight[a3] := -1;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := procIdx;
    ASTTk[callNode] := Ord(tyUnknown);
    ASTLeft[callNode] := a0;
    PyHoistStmt(callNode);
  end;
end;

function PyMakeVariantGetItem(baseNode, idxNode: Integer): Integer;
var procIdx, a0, a1: Integer;
begin
  procIdx := FindProc('pyvar_getitem');
  if procIdx < 0 then Error('Nil Python: pylib (pyvar_getitem) not loaded');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := idxNode;
  ASTRight[a0] := a1; ASTRight[a1] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyVariant);
  ASTLeft[Result] := a0;
end;

{ The READ half of a subscript augmented assignment: call the default indexed
  property's GETTER with the same self and index arguments the setter is about to
  use. `d[k] += v` needs the current element, and the setter path has already
  consumed the bracket group, so the arguments are re-used rather than re-parsed.
  (feature-nilpy-augmented-subscript-assign) }
{ A fresh AN_ARG chain over the SAME expression nodes. The read and the write
  of `d[k] += v` both need the index arguments, and sharing one chain linked the
  setter's value onto the reader's arguments — a cycle the compiler then walked
  forever. }
function PyCloneArgChain(head: Integer): Integer;
var n, prev, copy: Integer;
begin
  Result := -1;
  prev := -1;
  n := head;
  while n >= 0 do
  begin
    copy := AllocNode(AN_ARG);
    ASTLeft[copy] := ASTLeft[n];
    ASTRight[copy] := -1;
    if prev < 0 then Result := copy else ASTRight[prev] := copy;
    prev := copy;
    n := ASTRight[n];
  end;
end;

{ `zip(a, b)` as a value -> pylib pyzip, which builds the pair list. }
{ A str argument to an iterable builtin, exploded into a list of 1-character
  strs. pyzip / pyenumerate take a TPyList and these calls are built by a FIXED
  FindProc index, so overload resolution never runs: handing them an AnsiString
  passed the string HANDLE where an object pointer was expected, and it was
  dereferenced — SIGSEGV, no diagnostic, from `zip(s, t)` or `enumerate(s)`
  (bug-nilpy-str-iterable-builtins-segfault-on-a-string-handle).
  A non-str node is returned untouched, so nothing else changes. }
function PyIterArgAsList(n: Integer): Integer;
var procIdx, argNode, uci: Integer;
begin
  Result := n;
  if n < 0 then Exit;
  { A USER class implementing the iterator protocol, drained here for the same
    reason a str is exploded here: the callee takes a TPyList through a FIXED
    FindProc index, so overload resolution never runs and the object would be
    read as a list — which answered [] rather than crashing, the quieter half
    of the same failure. bug-nilpy-builtins-over-a-user-iterable-answer-empty }
  if IntToTypeKind(ASTTk[n]) = tyClass then
  begin
    uci := ResolveNodeRec(n) - REC_UCLASS_BASE;
    if (uci >= 0) and (FindUMeth(uci, '__iter__') >= 0) then
    begin
      Result := PyCallProc1('pyiter_drain', PyCallProc1('pyiter_of_userobj', n));
      Exit;
    end;
  end;
  if not PyIsStrBaseTk(IntToTypeKind(ASTTk[n])) then Exit;
  procIdx := FindProc('pystr_charlist');
  if procIdx < 0 then Error('Nil Python: pylib (pystr_charlist) not loaded');
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := n;
  ASTRight[argNode] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTLeft[Result] := argNode;
  ASTTk[Result] := Ord(tyClass);
  ASTRight[Result] := REC_UCLASS_BASE + FindUClass('TPyList');
end;

{ Wrap ANY iterable node in a cursor — the one conversion enumerate() and zip()
  need, so that their pylib entries take TPyIter and there is no combinatorial
  family of per-argument-type spellings (zip would want nine). A node that is
  already a cursor is returned untouched, which is also CPython's iter() rule. }
function PyMakeIterOf(node: Integer): Integer;
var iterCi: Integer; tk: TTypeKind;
begin
  Result := node;
  if node < 0 then Exit;
  tk := IntToTypeKind(ASTTk[node]);
  iterCi := FindUClass('TPyIter');
  if (tk = tyClass) and (iterCi >= 0) and
     (ResolveNodeRec(node) = REC_UCLASS_BASE + iterCi) then Exit;
  if (tk = tyString) or (tk = tyAnsiString) or (tk = tyChar) then
    Result := PyCallProc1('pyiter_of_str', node)
  else if (tk = tyClass) and (FindUClass('TPyRange') >= 0) and
          PyRecIsCls(ResolveNodeRec(node), 'TPyRange') then
    { a RANGE is a sequence, not a list — `zip(range(3), xs)` must not try to
      read its three Int64 fields as a TPyList header }
    Result := PyCallProc1('pyiter_of_range', node)
  else if (tk = tyClass) and (ResolveNodeRec(node) >= REC_UCLASS_BASE) and
          (FindUMeth(ResolveNodeRec(node) - REC_UCLASS_BASE, '__iter__') >= 0) then
    { a USER class implementing the iterator protocol. Before this it fell into
      the pyiter_of_list arm below and its object was read as a TPyList header,
      so `zip(bag, "xyz")` paired EMPTY values with the string's characters —
      the quiet failure, not a crash.
      bug-nilpy-builtins-over-a-user-iterable-answer-empty }
    Result := PyCallProc1('pyiter_of_userobj', node)
  else if tk = tyClass then
    Result := PyCallProc1('pyiter_of_list', node)
  else
    Result := PyCallProc1('pyiter_v', node);
end;

function PyMakeZip(aNode, bNode, cNode, dNode: Integer): Integer;
var a0, a1, a2, a3: Integer; pname: AnsiString;
begin
  { LAZY: `zip(a, b)` is a CURSOR over two cursors. Each side is converted
    once, so there is one pylib entry instead of one per pair of argument
    types — and a str side needs no charlist explosion.
    cNode/dNode are -1 below three/four streams: `zip(rows, labels, values)` is
    ordinary Python and used to die at PARSE time on the second comma. The
    two-way call is unchanged, so a pair stays a PAIR and is not padded. }
  aNode := PyMakeIterOf(aNode);
  bNode := PyMakeIterOf(bNode);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := aNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := bNode; ASTRight[a1] := -1;
  ASTRight[a0] := a1;
  pname := 'pyiter_zip_ii';
  if cNode >= 0 then
  begin
    pname := 'pyiter_zip_iii';
    a2 := AllocNode(AN_ARG);
    ASTLeft[a2] := PyMakeIterOf(cNode);
    ASTRight[a2] := -1;
    ASTRight[a1] := a2;
    if dNode >= 0 then
    begin
      pname := 'pyiter_zip_iiii';
      a3 := AllocNode(AN_ARG);
      ASTLeft[a3] := PyMakeIterOf(dNode);
      ASTRight[a3] := -1;
      ASTRight[a2] := a3;
    end;
  end;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := FindProc(pname);
  if ASTIVal[Result] < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  ASTTk[Result] := Ord(tyClass);
  ASTRight[Result] := ProcRetRecId[ASTIVal[Result]];
  ASTLeft[Result] := a0;
end;

{ `zip(*rows)`, and any zip of more than four streams -> pyiter_zip_n over a
  LIST of iterables. The fixed two/three/four-way lowering above counts the
  streams while PARSING, which is why the transpose idiom -- the commonest zip
  in real Python -- did not parse at all, and why five streams met a "not
  supported yet". One run-time entry replaces the ceiling rather than adding a
  fifth field to it (bug-nilpy-star-unpack-into-a-fixed-arity-builtin). }
function PyMakeZipN(listNode: Integer): Integer;
var argNode: Integer;
begin
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := listNode;
  ASTRight[argNode] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := FindProc('pyiter_zip_n');
  if ASTIVal[Result] < 0 then Error('Nil Python: pylib (pyiter_zip_n) not loaded');
  ASTTk[Result] := Ord(tyClass);
  ASTRight[Result] := ProcRetRecId[ASTIVal[Result]];
  ASTLeft[Result] := argNode;
end;

{ Is `f(*xs)` the same call as `f(xs)` for this builtin? True for exactly two
  names: CPython's max/min take EITHER an iterable or the values spread out, and
  both spellings answer the same thing. Nothing else on the builtin surface has
  that property — `sum(*xs)` and `sorted(*xs)` do not — so this is a two-entry
  list rather than a rule, and it stays that way deliberately. }
function PyStarIsIterableForm(const nm: AnsiString): Boolean;
begin
  Result := CaseEqual(nm, 'max') or CaseEqual(nm, 'min');
end;

{ The star operand of `zip(*rows)` as a TPyList node — the same normalisation
  every other star operand passes through, so a variant is unboxed and a str
  spreads its characters. }
function PyZipStarOperand(node: Integer): Integer;
var listCi: Integer;
begin
  listCi := FindUClass('TPyList');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  Result := PyStarOperandAsList(node, listCi);
end;

function PyStarIterableNode(listNode: Integer): Integer;
{ Wrap a star operand (already a TPyList) in pystar_iterable, which picks the
  element's contents when exactly ONE was starred and hands the list back
  otherwise. See the call site in parser.inc for why the count decides.
  bug-nilpy-max-and-min-of-a-starred-list-pick-the-wrong-overload }
var argNode, listCi: Integer;
begin
  listCi := FindUClass('TPyList');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := listNode;
  ASTRight[argNode] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := FindProc('pystar_iterable');
  if ASTIVal[Result] < 0 then Error('Nil Python: pylib (pystar_iterable) not loaded');
  ASTTk[Result] := Ord(tyClass);
  ASTRight[Result] := REC_UCLASS_BASE + listCi;
  ASTLeft[Result] := argNode;
end;

{ Four already-parsed zip operands plus every remaining one, collected into a
  TPyList temp. CurTok is the comma before the fifth. }
function PyZipTailList(a, b, c, d: Integer): Integer;
var tmpSym: Integer;
begin
  tmpSym := PyNewContainerTemp('TPyList', 'zipn');
  PyContainerCall1(tmpSym, 'TPyList', 'append', a, -1);
  PyContainerCall1(tmpSym, 'TPyList', 'append', b, -1);
  PyContainerCall1(tmpSym, 'TPyList', 'append', c, -1);
  PyContainerCall1(tmpSym, 'TPyList', 'append', d, -1);
  while CurTok.Kind = tkComma do
  begin
    Next;
    ParseArgExpr;
    PyContainerCall1(tmpSym, 'TPyList', 'append', CurASTNode, -1);
  end;
  Result := PyMakeIdent(tmpSym);
end;

function PyMakeSubscriptRead(selfNode, idxArgs, ci, pri: Integer): Integer;
var methName: AnsiString; i, mmi, mpi, selfArg, callNode: Integer;
begin
  methName := '';
  for i := 0 to UPropReadMLen[pri] - 1 do
    AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
  mmi := FindUMeth(ci, methName);
  if mmi < 0 then Error('Nil Python: default property getter not found: ' + methName);
  mpi := UMthProc_[mmi];
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := selfNode;
  ASTRight[selfArg] := idxArgs;
  if UMthVirSlot[mmi] >= 0 then
  begin
    callNode := AllocNode(AN_VIRTUAL_CALL);
    ASTRight[callNode] := UMthVirSlot[mmi];
  end
  else
    callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := mpi;
  ASTTk[callNode] := Ord(Procs[mpi].RetType);
  ASTLeft[callNode] := selfArg;
  Result := callNode;
end;

{ `v[key] = val` on a variant -> pyvar_setitem(v, key, val), a statement. }
function PyMakeVariantSetItem(baseNode, idxNode, valNode: Integer): Integer;
var procIdx, a0, a1, a2, callNode, tmpSym, tmpAssign, innerComma: Integer;
begin
  procIdx := FindProc('pyvar_setitem');
  if procIdx < 0 then Error('Nil Python: pylib (pyvar_setitem) not loaded');
  { pyvar_setitem is a void PROCEDURE, so its own call carries no result --
    but `v[key] = val` is used as a VALUE-BEARING expression wherever a
    chained assignment nests one subscript store inside another
    (`xs[0] = xs[1] = 3`, right-associative). Store the value into a hidden
    temp FIRST, call pyvar_setitem with it, then yield the temp: gives
    Python's actual semantics (every target gets the ORIGINAL value) instead
    of silently dropping the outer store, which is what returning the void
    call node itself did
    (bug-nilpy-chained-subscript-assignment-writes-only-the-last-target). }
  tmpSym := AllocVar(PyHiddenName('setval'), tyVariant);
  tmpAssign := AllocNode(AN_ASSIGN);
  ASTLeft[tmpAssign] := PyMakeIdent(tmpSym);
  ASTRight[tmpAssign] := valNode;

  a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := idxNode;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := PyMakeIdent(tmpSym);
  ASTRight[a0] := a1; ASTRight[a1] := a2; ASTRight[a2] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyUnknown);
  ASTLeft[callNode] := a0;

  innerComma := AllocNode(AN_COMMA);
  ASTLeft[innerComma] := callNode;
  ASTRight[innerComma] := PyMakeIdent(tmpSym);
  ASTTk[innerComma] := Ord(tyVariant);

  Result := AllocNode(AN_COMMA);
  ASTLeft[Result] := tmpAssign;
  ASTRight[Result] := innerComma;
  ASTTk[Result] := Ord(tyVariant);
end;

function PyClassWantsIntIndex(ci: Integer): Boolean;
{ True when a subscript of `ci` is an INDEX (a sequence position) rather than a
  KEY. Only pylib's list and bytes qualify: a dict subscript is an object key,
  and so is a user class's `__getitem__` argument — Python hands both the object
  itself, and coercing either through `__index__` would silently change which
  entry a program means. str is handled on its own path (PyMakeStrIndex). }
var listCi, bytesCi, rangeCi: Integer;
begin
  Result := False;
  if ci < 0 then Exit;
  listCi := FindUClass('TPyList');
  bytesCi := FindUClass('TPyBytes');
  { ...and a RANGE, which is a sequence in exactly this sense: r[i] is a
    POSITION, so an index object is asked for its __index__ like a list's is. }
  rangeCi := FindUClass('TPyRange');
  Result := PyCiIsA(ci, listCi) or PyCiIsA(ci, bytesCi) or PyCiIsA(ci, rangeCi);
end;

function PyIndexCoerce(n: Integer): Integer;
{ Python's `__index__`: an object used where an INTEGER is required is asked for
  one. Returns the dunder call when `n` is a user class declaring it, otherwise
  `n` unchanged.

  Without this a class instance used as a subscript passed its HANDLE as the
  index — measured: `[10,20,30][C()]` raised IndexError (the handle exceeded the
  length) where CPython returned 30. It raised only by luck; a smaller handle
  would have silently indexed the wrong element.
  bug-nilpy-unary-numeric-dunders-return-raw-handle.

  Applied at the SUBSCRIPT site only so far. The other integer-coercion sites —
  slice bounds, range(), sequence repeat counts — still pass the handle; see
  that ticket. }
var ci, idx, a0, cv: Integer;
begin
  PyIndexCoerce := n;
  if n < 0 then Exit;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  if ResolveNodeRec(n) < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(ResolveNodeRec(n)) then Exit;
  ci := ResolveNodeRec(n) - REC_UCLASS_BASE;
  if FindUMeth(ci, '__index__') < 0 then Exit;
  ci := PyCallMeth1(ci, '__index__', n, -1);
  if ci < 0 then Exit;
  { Python REQUIRES __index__ to return an int, so make the node say so. The
    method's own inferred result is usually a variant (`return self.v` over an
    unannotated field), and a variant is not an ORDINAL — which the sequence
    repeat pair tests ask for, so `[0] * C(3)` fell past them into the
    arithmetic path and raised TypeError. Every consumer of an index wants an
    integer anyway. }
  if IntToTypeKind(ASTTk[ci]) = tyVariant then
  begin
    idx := FindProc('pyvar_to_int');
    if idx < 0 then Error('Nil Python: pylib (pyvar_to_int) not loaded');
    a0 := AllocNode(AN_ARG);
    ASTLeft[a0] := ci;
    ASTRight[a0] := -1;
    cv := AllocNode(AN_CALL);
    ASTIVal[cv] := idx;
    ASTTk[cv] := Ord(tyInt64);
    ASTLeft[cv] := a0;
    ci := cv;
  end;
  PyIndexCoerce := ci;
end;

{ `xs[obj]` where obj's class declares no `__index__` and the receiver is a
  SEQUENCE — a TypeError, as in CPython, not an accidental IndexError from using
  the instance handle as a position.

  Both halves of the condition matter. It has to know the receiver is a
  sequence, which is why this lives here and not in PyIndexCoerce: that routine
  sees only the index expression and is called from a DICT subscript too, where
  an object is a perfectly legal key. Getting that wrong collapses object dict
  keys onto their `__index__` value — measured, and recorded on the parent
  ticket (bug-nilpy-unary-numeric-dunders-return-raw-handle).

  Returns the raising call, or -1 when this is not the case. }
function PyIndexNotIntKind(kind: AnsiString; idxNode: Integer): Integer;
var ci, procIdx, a0, a1, lit: Integer;
begin
  PyIndexNotIntKind := -1;
  if (idxNode < 0) or (kind = '') then Exit;
  if IntToTypeKind(ASTTk[idxNode]) <> tyClass then Exit;
  if ResolveNodeRec(idxNode) < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(ResolveNodeRec(idxNode)) then Exit;
  ci := ResolveNodeRec(idxNode) - REC_UCLASS_BASE;
  if FindUMeth(ci, '__index__') >= 0 then Exit;    { it has one — coerce, do not raise }
  procIdx := FindProc('PyIndexTypeError');
  if procIdx < 0 then Exit;
  a0 := AllocNode(AN_ARG);
  lit := AllocNode(AN_STR_LIT);
  ASTSOffset[lit] := PyStoredName(kind); ASTSLen[lit] := Length(kind);
  ASTTk[lit] := Ord(tyString);
  ASTLeft[a0] := lit;
  a1 := AllocNode(AN_ARG);
  lit := AllocNode(AN_STR_LIT);
  ASTSOffset[lit] := PyStoredName(PyRawName(UClsNOff[ci], UClsNLen[ci]));
  ASTSLen[lit] := UClsNLen[ci];
  ASTTk[lit] := Ord(tyString);
  ASTLeft[a1] := lit; ASTRight[a1] := -1;
  ASTRight[a0] := a1;
  PyIndexNotIntKind := AllocNode(AN_CALL);
  ASTIVal[PyIndexNotIntKind] := procIdx;
  ASTTk[PyIndexNotIntKind] := Ord(tyInt64);
  ASTLeft[PyIndexNotIntKind] := a0;
end;

{ The whole subscript EXPRESSION replaced by a run-time TypeError, for a user
  class that declares no `__getitem__`. Before this the subscript fell through
  to the generic AN_INDEX — pointer arithmetic on the instance handle — and
  yielded a plausible NUMBER or ended the program. Declaring a SIBLING member
  (`__setitem__`, `__delitem__`) did not rescue it, because the arm above tests
  `__getitem__` specifically.

  Run time, not compile time: CPython raises TypeError when the subscript
  EXECUTES, and `try: obj[k] / except TypeError:` is valid Python that must
  still compile. Returns -1 when the base is not a user class, so callers leave
  every other receiver alone.
  bug-nilpy-subscript-read-without-getitem-yields-garbage }
function PyNotSubscriptableNode(ci: Integer): Integer;
var procIdx, a0, lit: Integer;
begin
  PyNotSubscriptableNode := -1;
  if ci < 0 then Exit;
  procIdx := FindProc('PyNotSubscriptable');
  if procIdx < 0 then Exit;
  a0 := AllocNode(AN_ARG);
  lit := AllocNode(AN_STR_LIT);
  ASTSOffset[lit] := PyStoredName(PyRawName(UClsNOff[ci], UClsNLen[ci]));
  ASTSLen[lit] := UClsNLen[ci];
  ASTTk[lit] := Ord(tyString);
  ASTLeft[a0] := lit; ASTRight[a0] := -1;
  PyNotSubscriptableNode := AllocNode(AN_CALL);
  ASTIVal[PyNotSubscriptableNode] := procIdx;
  ASTTk[PyNotSubscriptableNode] := Ord(tyInt64);
  ASTLeft[PyNotSubscriptableNode] := a0;
end;

{ A run-time error call that NAMES THE CLASS — PyNoSetitemError /
  PyNoDelitemError, whose messages are CPython's
  `'C' object does not support item assignment` / `... item deletion`.

  Split out rather than inlined at the four call sites for the reason the
  messages needed fixing in the first place: the READ refusal
  (PyNotSubscriptableNode, just above) already passed the class name and the
  write and delete refusals did not, so one feature's halves disagreed about how
  they read. One builder is how they stay agreed.
  bug-nilpy-nosetitem-error-does-not-name-the-class }
function PyClassErrCallNode(const procName: AnsiString; ci: Integer): Integer;
var procIdx, a0, lit: Integer;
begin
  PyClassErrCallNode := -1;
  procIdx := FindProc(procName);
  if procIdx < 0 then Exit;
  a0 := AllocNode(AN_ARG);
  lit := AllocNode(AN_STR_LIT);
  if ci >= 0 then
  begin
    ASTSOffset[lit] := PyStoredName(PyRawName(UClsNOff[ci], UClsNLen[ci]));
    ASTSLen[lit] := UClsNLen[ci];
  end
  else
  begin
    { no class in hand (a variant receiver): the runtime prints the message
      without a name rather than inventing one }
    ASTSOffset[lit] := PyStoredName('');
    ASTSLen[lit] := 0;
  end;
  ASTTk[lit] := Ord(tyString);
  ASTLeft[a0] := lit; ASTRight[a0] := -1;
  PyClassErrCallNode := AllocNode(AN_CALL);
  ASTIVal[PyClassErrCallNode] := procIdx;
  ASTTk[PyClassErrCallNode] := Ord(tyInteger);
  ASTLeft[PyClassErrCallNode] := a0;
end;

{ The sequence KIND a receiver NODE is, or '' when it is not a sequence (a dict,
  or a variant that may hold one at run time). }
function PyIndexSeqKind(baseNode: Integer): AnsiString;
var rec, listCi: Integer;
begin
  PyIndexSeqKind := '';
  if baseNode < 0 then Exit;
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[baseNode])) then
  begin PyIndexSeqKind := 'string'; Exit; end;
  if IntToTypeKind(ASTTk[baseNode]) <> tyClass then Exit;
  rec := ResolveNodeRec(baseNode);
  listCi := FindUClass('TPyList');
  if (listCi >= 0) and (rec = REC_UCLASS_BASE + listCi) then PyIndexSeqKind := 'list'
  else if PyRecIsCls(rec, 'TPyBytes') then
    PyIndexSeqKind := 'bytearray';
end;

{ ...and the same for a receiver named only by its CLASS index, which is what
  the NAMED-receiver subscript path in parser.inc has. }
function PyIndexSeqKindCi(mci: Integer): AnsiString;
var listCi: Integer;
begin
  PyIndexSeqKindCi := '';
  if mci < 0 then Exit;
  listCi := FindUClass('TPyList');
  if mci = listCi then PyIndexSeqKindCi := 'list'
  else if (FindUClass('TPyRange') >= 0) and (mci = FindUClass('TPyRange')) then
    PyIndexSeqKindCi := 'range'
  else if mci = PyBytesCi then PyIndexSeqKindCi := 'bytearray';
end;

{ The raise for a receiver NODE — the literal-receiver path. }
function PyIndexNotIntRaise(baseNode, idxNode: Integer): Integer;
begin
  PyIndexNotIntRaise := PyIndexNotIntKind(PyIndexSeqKind(baseNode), idxNode);
end;

function PyMakeSuffixIndex(baseNode, idxNode: Integer): Integer;
var rec, listCi, dictCi, procIdx, a0, a1, notIntN: Integer;
begin
  { An object index with no `__index__` on a SEQUENCE raises TypeError. The
    raiser stands in for the index EXPRESSION rather than replacing the whole
    subscript, so both this path and the named-receiver one in parser.inc use
    the identical shape and the getter is never reached. }
  notIntN := PyIndexNotIntRaise(baseNode, idxNode);
  if notIntN >= 0 then idxNode := notIntN
  else idxNode := PyIndexCoerce(idxNode);   { obj-as-subscript asks its __index__ }
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[baseNode])) then
  begin
    Result := PyMakeStrIndex(baseNode, idxNode);
    Exit;
  end;
  if IntToTypeKind(ASTTk[baseNode]) = tyVariant then
  begin
    { `v[key]` on a variant — dispatch to pyvar_getitem, which unboxes the
      container at run time (dict by key, list by int index). }
    procIdx := FindProc('pyvar_getitem');
    if procIdx < 0 then Error('Nil Python: pylib (pyvar_getitem) not loaded');
    a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode;
    a1 := AllocNode(AN_ARG); ASTLeft[a1] := idxNode;
    ASTRight[a0] := a1; ASTRight[a1] := -1;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := procIdx;
    ASTTk[Result] := Ord(tyVariant);
    ASTLeft[Result] := a0;
    Exit;
  end;
  rec := ResolveNodeRec(baseNode);
  listCi := FindUClass('TPyList');
  dictCi := FindUClass('TPyDict');
  if (listCi >= 0) and (rec = REC_UCLASS_BASE + listCi) then
    Result := PyCallMeth1(listCi, 'at', baseNode, idxNode)
  else if (dictCi >= 0) and (rec = REC_UCLASS_BASE + dictCi) then
    Result := PyCallMeth1(dictCi, 'fetch', baseNode, idxNode)
  else
    Result := -1;
  if Result < 0 then Error('Nil Python: this value cannot be subscripted');
end;

{ ---- SLICES  `b[lo:hi]` ----------------------------------------------------
  Python slices reach the parser as a subscript whose index expression is
  followed by ':'. Nothing in the Pascal dialect puts a ':' inside brackets
  (set ranges use '..'), so the form is unambiguous and the shared parser can
  hand the whole tail here the moment it sees the colon.

  A slice on a str/list PRODUCES a value; a slice on bytes is also an
  assignment TARGET. Rather than invent an lvalue node for the second case,
  the read call is built first and rewritten into pybytes_setslice by
  PyRewriteSliceAssign when an '=' turns out to follow — the read call
  already carries base, lo and hi in its argument chain. }

function PyBytesCi: Integer;
begin
  PyBytesCi := FindUClass('TPyBytes');
end;

{ Is this node sliceable? str, bytes and list are; a dict is NOT (Python has
  no dict slice), which is why this is not PySubscriptableSuffix. }
function PyIsSliceBase(n: Integer): Boolean;
var rec, listCi, bytesCi: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[n])) then begin Result := True; Exit; end;
  { a variant may hold a sliceable container — dispatched at run time }
  if IntToTypeKind(ASTTk[n]) = tyVariant then begin Result := True; Exit; end;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  rec := ResolveNodeRec(n);
  if rec < REC_UCLASS_BASE then Exit;
  listCi  := FindUClass('TPyList');
  bytesCi := PyBytesCi;
  Result := PyRecIsCls(rec, 'TPyList') or PyRecIsCls(rec, 'TPyBytes') or
            { a RANGE slices too, and answers a range. Without this the bracket
              was claimed by the default-property path, which demands a ']' and
              reported "Expected: ]" at the slice colon. }
            PyRecIsCls(rec, 'TPyRange');
end;

{ The sentinel an omitted bound is compiled to; pylib's PySliceBounds turns it
  back into 0 or len. Kept in sync with PY_SLICE_OMIT in pylib.pas. }
function PySliceOmitNode: Integer;
begin
  Result := AllocNode(AN_INT_LIT);
  ASTIVal[Result] := 2147483647;
  ASTTk[Result] := Ord(tyInteger);
end;

{ base[lo:hi] or base[lo:hi:step] as a VALUE. Picks the pylib function by
  element type so each container keeps its own result type: str -> str, bytes
  -> bytes, list -> list.

  `stepNode` < 0 means no step was written, and selects the plain 3-argument
  helper — so the ordinary `b[lo:hi]` path is byte-for-byte what it was and an
  extended slice is the only thing routed to the `_step` overloads. }
function PyMakeSlice(baseNode, loNode, hiNode, stepNode: Integer): Integer;
var procIdx, callNode, a0, a1, a2, a3, rec, listCi, bytesCi: Integer;
    pname, suffix: AnsiString;
    retTk: TTypeKind;
begin
  { A slice BOUND is an integer position, so an object standing in one is asked
    for its `__index__` exactly as a subscript is. Without this the instance
    HANDLE became the bound: `xs[C(1):C(3)]` returned `[]` and
    `"abcdef"[C(1):C(4)]` returned the empty string — silently, because a
    handle is far past the end and the clamp turns that into an empty slice
    rather than an error. The subscript form at least raised
    (bug-nilpy-unary-numeric-dunders-return-raw-handle).

    One site covers str, bytes, list and variant receivers, and the step too. }
  loNode := PyIndexCoerce(loNode);
  hiNode := PyIndexCoerce(hiNode);
  if stepNode >= 0 then stepNode := PyIndexCoerce(stepNode);
  pname := '';
  retTk := tyInteger;
  if stepNode >= 0 then suffix := '_step' else suffix := '';
  if IntToTypeKind(ASTTk[baseNode]) = tyVariant then
  begin
    pname := 'pyvar_slice';       { unbox and slice at run time; yields a variant }
    retTk := tyVariant;
  end
  else if PyIsStrBaseTk(IntToTypeKind(ASTTk[baseNode])) then
  begin
    pname := 'pystr_slice';
    retTk := tyAnsiString;
  end
  else
  begin
    rec := ResolveNodeRec(baseNode);
    listCi  := FindUClass('TPyList');
    bytesCi := PyBytesCi;
    if PyRecIsCls(rec, 'TPyBytes') then
    begin
      pname := 'pybytes_slice';
      retTk := tyClass;
    end
    else if PyRecIsCls(rec, 'TPyList') then
    begin
      pname := 'pylist_slice';
      retTk := tyClass;
    end
    else if PyRecIsCls(rec, 'TPyRange') then
    begin
      { Slicing a range answers a RANGE, not a list — `range(10)[2:5]` is
        `range(2, 5)` in CPython, so slices compose without materialising.
        pyrange_slice always takes an explicit step, so the `_step` suffix
        convention does not apply and an omitted step becomes a literal 1. }
      pname := 'pyrange_slice';
      retTk := tyClass;
      suffix := '';
      if stepNode < 0 then
      begin
        stepNode := AllocNode(AN_INT_LIT);
        ASTIVal[stepNode] := 1;
        ASTTk[stepNode] := Ord(tyInt64);
      end;
    end;
  end;
  if pname = '' then Error('Nil Python: this value cannot be sliced');
  pname := pname + suffix;
  procIdx := FindProc(pname);
  if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');

  a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := loNode;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := hiNode;
  { the ARG chain must be LINKED, not just allocated in order }
  ASTRight[a0] := a1;
  ASTRight[a1] := a2;
  ASTRight[a2] := -1;
  if stepNode >= 0 then
  begin
    a3 := AllocNode(AN_ARG); ASTLeft[a3] := stepNode;
    ASTRight[a2] := a3;
    ASTRight[a3] := -1;
  end;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(retTk);
  ASTLeft[callNode] := a0;
  { a class-typed result must carry its record id or `.` and `[` on the slice
    would not resolve; a str slice must carry NO record id, set explicitly
    rather than trusting the allocator }
  if retTk = tyClass then
    ASTRight[callNode] := ResolveNodeRec(baseNode)
  else
    ASTRight[callNode] := -1;
  LastExprTk := retTk;
  Result := callNode;
end;

{ Parse the tail of a slice: CurTok is the ':' , `loNode` is the low bound
  already parsed (-1 when omitted, as in `b[:n]`). Consumes through ']'. }
function PyParseSliceTail(baseNode, loNode: Integer): Integer;
var hiNode, stepNode: Integer;
begin
  Next;                              { consume ':' }
  if loNode < 0 then loNode := PySliceOmitNode;
  if (CurTok.Kind = tkRBrack) or (CurTok.Kind = tkColon) then
    hiNode := PySliceOmitNode        { `b[lo:]`, and `b[lo::step]` }
  else
  begin
    PyParseBoolExpr;
    hiNode := CurASTNode;
  end;
  { An optional STEP: `xs[lo:hi:step]`, any non-zero step, negative included.
    The step is a full EXPRESSION, not a literal — `xs[::n]` and `xs[::-k]`
    are ordinary Python — so it is parsed and passed through to pylib, which
    normalises the bounds per CPython's slice.indices() at run time. A step of
    0 raises there rather than here, because it need not be a literal.

    This used to accept ONLY the whole-range reverse `[::-1]`, rewritten into a
    `reversed` / `pystr_reverse` call. That rewrite is gone: the generic path
    covers it, and routing `[::-1]` through the slice helpers also fixes tuple
    reversal, since `reversed` yields a list while pylist_slice_step carries
    FIsTuple across (bug-nilpy-derived-tuple-loses-tupleness). }
  stepNode := -1;
  if CurTok.Kind = tkColon then
  begin
    Next;                            { consume the second ':' }
    { `xs[::]` is legal Python and means a plain copy — an omitted step is 1,
      so leave stepNode = -1 and take the 3-argument path. }
    if CurTok.Kind <> tkRBrack then
    begin
      PyParseBoolExpr;
      stepNode := CurASTNode;
    end;
  end;
  Expect(tkRBrack, ']');
  Result := PyMakeSlice(baseNode, loNode, hiNode, stepNode);
  CurASTNode := Result;
end;

{ True when `n` is the pybytes_slice call built above, i.e. a slice that is
  being used as an assignment TARGET rather than a value. }
function PyIsBytesSliceCall(n: Integer): Boolean;
var procIdx: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if ASTKind[n] <> AN_CALL then Exit;
  procIdx := FindProc('pybytes_slice');
  if (procIdx >= 0) and (ASTIVal[n] = procIdx) then begin Result := True; Exit; end;
  { a LIST slice read (`l[lo:hi]`) is also a valid slice-assign target }
  procIdx := FindProc('pylist_slice');
  if (procIdx >= 0) and (ASTIVal[n] = procIdx) then begin Result := True; Exit; end;
  { ...and a VARIANT slice, which is what a base with no static class produces
    (PyMakeSlice's tyVariant arm). bug-nilpy-slice-assign-through-a-dynamically-typed-receiver }
  procIdx := FindProc('pyvar_slice');
  if (procIdx >= 0) and (ASTIVal[n] = procIdx) then begin Result := True; Exit; end;
  { An EXTENDED slice (`l[::2] = ...`) is a valid target in Python but is not
    implemented here. Recognise it anyway, so PyRewriteSliceAssign can refuse it
    BY NAME — otherwise the statement falls through to a bare "expected
    expression" pointing at the '=', which reads like a parser bug rather than a
    missing feature (bug-nilpy-stepped-slices-other-than-reverse). }
  procIdx := FindProc('pylist_slice_step');
  if (procIdx >= 0) and (ASTIVal[n] = procIdx) then begin Result := True; Exit; end;
  procIdx := FindProc('pybytes_slice_step');
  Result := (procIdx >= 0) and (ASTIVal[n] = procIdx);
end;

{ `b[lo:hi] = src` / `l[lo:hi] = src` — turn the already-built read into the
  setter call by swapping the target proc and appending the source as a fourth
  argument. The whole statement IS this call. }
function PyRewriteSliceAssign(sliceNode, rhsNode: Integer): Integer;
var procIdx, a3, a: Integer;
begin
  { extended-slice assignment — parsed, recognised, and refused by name rather
    than approximated: dropping the step would write the WRONG elements }
  if (ASTIVal[sliceNode] = FindProc('pylist_slice_step')) or
     (ASTIVal[sliceNode] = FindProc('pybytes_slice_step')) then
    Error('Nil Python: assigning to an extended slice (with a step) is not '
          + 'implemented; only x[lo:hi] = src is');
  if ASTIVal[sliceNode] = FindProc('pyvar_slice') then
    { target has no static class: unbox and dispatch on its runtime type }
    procIdx := FindProc('pyvar_setslice')
  else if ASTIVal[sliceNode] = FindProc('pylist_slice') then
    procIdx := FindProc('pylist_setslice')
  else if IntToTypeKind(ASTTk[rhsNode]) = tyVariant then
    { `bytes[a:b] = <variant>` (e.g. a dict-fetched bytes value) — unbox at run
      time; a raw variant handed to pybytes_setslice is misread as a TPyBytes. }
    procIdx := FindProc('pybytes_setslice_v')
  else
    procIdx := FindProc('pybytes_setslice');
  if procIdx < 0 then Error('Nil Python: pylib (setslice) not loaded');
  a3 := AllocNode(AN_ARG);
  ASTLeft[a3] := rhsNode;
  ASTRight[a3] := -1;
  a := ASTLeft[sliceNode];
  while ASTRight[a] >= 0 do a := ASTRight[a];
  ASTRight[a] := a3;
  ASTIVal[sliceNode] := procIdx;
  { pybytes_setslice is a PROCEDURE: no result type, and the record id the read
    call carried has to go or the statement looks class-typed }
  ASTTk[sliceNode] := Ord(tyUnknown);
  ASTRight[sliceNode] := -1;
  Result := sliceNode;
end;

{ ---- to_bytes / from_bytes -------------------------------------------------
  Both are recognised as intrinsics with a FIXED argument shape, not as real
  methods: their Python spelling ends in a keyword argument (`signed=True`)
  and NilPy has no keyword arguments. See pylib for why that trade is right.

  The shape accepted is exactly the one the corpus uses:
      <int>.to_bytes(n, "little", signed=<expr>)
      int.from_bytes(<bytes>, "little", signed=<expr>)
  Anything else — a big-endian order, a missing `signed=` — is an ERROR rather
  than a silently ignored argument, because both would produce plausible wrong
  bytes rather than a failure. }

{ Does ANY user class declare `nm` as a method or a procedural field? The
  closed-world dispatcher below answers a variant receiver's `.m()` from this
  set, so an intrinsic that wants to claim a name on a VARIANT must first check
  that no user class owns it — otherwise the intrinsic silently shadows a real
  method the program declared. }
function PyAnyClassDeclares(const nm: AnsiString): Boolean;
var ci: Integer;
begin
  PyAnyClassDeclares := True;
  for ci := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[ci] then Continue;
    if FindUMeth(ci, nm) >= 0 then Exit;
    if FindUField(ci, nm) >= 0 then Exit;
  end;
  PyAnyClassDeclares := False;
end;

{ A receiver the `.to_bytes(` intrinsic may claim: a static int, or a VARIANT
  that no user class could own. A variant int is the ordinary shape — an
  untyped parameter, a container element, `int(x)` where x is dynamic — and it
  used to fall through to closed-world class dispatch and die with "no class
  declares a method or callable field .to_bytes()". uforth hit it at
  `int(value).to_bytes(8, "little", signed=True)` and could not compile at all.
  The intrinsic unboxes such a receiver with pyvar_to_int (see PyParseToBytes).
  bug-nilpy-to-bytes-on-a-variant-receiver-does-not-compile }
{ The int methods the frontend intercepts. Kept as ONE name test consulted by
  every intercept site, rather than a fresh `= 'to_bytes'` literal per site:
  there are three sites (the lvalue member path, ParseFactor's suffix loop, and
  the postfix-chain loop), so a per-method literal is three edits that must
  agree, and the one that gets missed is the one that stays broken. Adding an
  int method is now a line here plus an arm in PyParseIntMethod.
  bug-n-int-bit-length-is-not-implemented }
function PyIsIntMethodName(const nm: AnsiString): Boolean;
begin
  PyIsIntMethodName := (nm = 'to_bytes') or (nm = 'bit_length') or
                       (nm = 'bit_count');
end;

function PyIsIntMethodBaseTk(tk: TTypeKind; const nm: AnsiString): Boolean;
begin
  PyIsIntMethodBaseTk := PyIsIntBaseTk(tk) or
                         ((tk = tyVariant) and not PyAnyClassDeclares(nm));
end;

function PyIsIntBaseTk(tk: TTypeKind): Boolean;
begin
  { tyPromoInt64: a wide-literal-infected int (`0xFF... if flag else 0`) is
    still Python int; the receiver narrows mod 2^64 at the intrinsic's Int64
    parameter, which reproduces the unsigned byte image. }
  Result := (tk = tyInteger) or (tk = tyInt64) or (tk = tyInt8) or
            (tk = tyInt16) or (tk = tyUInt8) or (tk = tyUInt16) or
            (tk = tyUInt32) or (tk = tyUInt64) or TypeIsPromoInt(tk);
end;

{ Parses the shared tail `[, "little"|"big"] [, signed=<expr>] )` and returns
  the node for the signed flag, setting bigEnd. CurTok is the ')' or the comma
  before the byte order.

  Both tail parts are OPTIONAL because they are optional in CPython, and
  demanding them refused working programs: `signed` defaults to False and
  almost nobody writes it, and since 3.11 `byteorder` defaults to 'big'. The
  original shape ("exactly the one the corpus uses") was a fair trade while
  keywords did not exist here — but a missing `signed=` was an ERROR, so
  `(258).to_bytes(2, "big")` — ordinary network code — did not compile.

  'big' is now the reversal of the little-endian image (see pybytes_reversed),
  not a second conversion.
  bug-nilpy-to-bytes-refuses-big-endian-and-demands-the-signed-keyword }
function PyParseByteOrderAndSigned(var bigEnd: Boolean): Integer;
var ordText: AnsiString;
begin
  bigEnd := True;            { CPython 3.11+ default }
  Result := -1;
  if CurTok.Kind = tkComma then
  begin
    Next;
    if CurTok.Kind <> tkString then
      Error('Nil Python: to_bytes/from_bytes needs a literal byte order, "little" or "big"');
    ordText := CurTok.SVal;
    if ordText = 'little' then bigEnd := False
    else if ordText = 'big' then bigEnd := True
    else
      Error('Nil Python: byte order must be "little" or "big", got "'
            + ordText + '"');
    Next;
  end;
  if CurTok.Kind = tkComma then
  begin
    Next;
    if (CurTok.Kind <> tkIdent) or (LowerCase(CurTok.SVal) <> 'signed') then
      Error('Nil Python: to_bytes/from_bytes takes only the signed= keyword after the byte order');
    Next;
    Expect(tkAssign, '=');
    PyParseBoolExpr;
    Result := CurASTNode;
  end;
  if Result < 0 then
  begin
    { signed=False, the CPython default }
    Result := AllocNode(AN_BOOL_LIT);
    ASTIVal[Result] := 0;
    ASTTk[Result] := Ord(tyBoolean);
  end;
end;

{ Wrap a TPyBytes-valued node in pybytes_reversed — the big-endian half. }
function PyMakeBytesReversed(node: Integer): Integer;
var procIdx, callNode, a0: Integer;
begin
  procIdx := FindProc('pybytes_reversed');
  if procIdx < 0 then Error('Nil Python: pylib (pybytes_reversed) not loaded');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := node; ASTRight[a0] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyClass);
  ASTRight[callNode] := ProcRetRecId[procIdx];
  ASTLeft[callNode] := a0;
  PyMakeBytesReversed := callNode;
end;

{ `<int>.to_bytes(...)`; CurTok is the '(' . }
function PyParseToBytes(baseNode: Integer): Integer;
var procIdx, callNode, a0, a1, a2, nNode, sNode, unboxPi: Integer;
    bigEnd: Boolean;
begin
  procIdx := FindProc('pyint_to_bytes');
  if procIdx < 0 then Error('Nil Python: pylib (pyint_to_bytes) not loaded');
  { pyint_to_bytes takes an Int64, so a VARIANT receiver is unboxed first —
    the shape uforth uses (`int(value).to_bytes(...)` where value is dynamic). }
  if IntToTypeKind(ASTTk[baseNode]) = tyVariant then
  begin
    unboxPi := FindProc('pyvar_to_int');
    if unboxPi < 0 then Error('Nil Python: pylib (pyvar_to_int) not loaded');
    a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode; ASTRight[a0] := -1;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := unboxPi;
    ASTTk[callNode] := Ord(tyInt64);
    ASTLeft[callNode] := a0;
    baseNode := callNode;
  end;
  Expect(tkLParen, '(');
  if CurTok.Kind = tkRParen then
  begin
    { `to_bytes()` — CPython 3.11+ defaults length to 1 }
    nNode := AllocNode(AN_INT_LIT); ASTIVal[nNode] := 1; ASTTk[nNode] := Ord(tyInt64);
  end
  else
  begin
    PyParseBoolExpr;
    nNode := CurASTNode;
  end;
  sNode := PyParseByteOrderAndSigned(bigEnd);
  Expect(tkRParen, ')');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nNode;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := sNode;
  ASTRight[a0] := a1; ASTRight[a1] := a2; ASTRight[a2] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyClass);
  ASTRight[callNode] := ProcRetRecId[procIdx];   { TPyBytes identity }
  ASTLeft[callNode] := a0;
  if bigEnd then callNode := PyMakeBytesReversed(callNode);
  LastExprTk := tyClass;
  Result := callNode;
end;

{ `int.from_bytes(...)`; CurTok is the '(' . }
function PyParseFromBytes: Integer;
var procIdx, callNode, a0, a1, bNode, sNode: Integer;
    bigEnd: Boolean;
begin
  procIdx := FindProc('pyint_from_bytes');
  if procIdx < 0 then Error('Nil Python: pylib (pyint_from_bytes) not loaded');
  Expect(tkLParen, '(');
  PyParseBoolExpr;
  bNode := CurASTNode;
  sNode := PyParseByteOrderAndSigned(bigEnd);
  Expect(tkRParen, ')');
  if bigEnd then bNode := PyMakeBytesReversed(bNode);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := bNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := sNode;
  ASTRight[a0] := a1; ASTRight[a1] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyInt64);
  ASTRight[callNode] := -1;
  ASTLeft[callNode] := a0;
  LastExprTk := tyInt64;
  Result := callNode;
end;

{ `<int>.bit_length()` / `.bit_count()`; CurTok is the '(' . Both are
  argument-less and answer an int, so one builder serves them; the receiver is
  passed AS IS and boxed to the Variant parameter by the ordinary argument
  conversion, which is what keeps an arbitrary-precision receiver exact —
  pyint_bit_length reads the promo's limbs rather than narrowing to Int64. }
function PyParseBitLenCount(baseNode: Integer; const nm: AnsiString): Integer;
var procIdx, callNode, a0: Integer; fn: AnsiString;
begin
  if nm = 'bit_count' then fn := 'pyint_bit_count' else fn := 'pyint_bit_length';
  procIdx := FindProc(fn);
  if procIdx < 0 then Error('Nil Python: pylib (' + fn + ') not loaded');
  Expect(tkLParen, '(');
  Expect(tkRParen, ')');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := baseNode; ASTRight[a0] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyInt64);
  ASTRight[callNode] := -1;
  ASTLeft[callNode] := a0;
  LastExprTk := tyInt64;
  Result := callNode;
end;

{ The one dispatcher every intercept site calls once it has decided the suffix
  is an int method. CurTok is the '(' . }
function PyParseIntMethod(baseNode: Integer; const nm: AnsiString): Integer;
begin
  if nm = 'to_bytes' then PyParseIntMethod := PyParseToBytes(baseNode)
  else PyParseIntMethod := PyParseBitLenCount(baseNode, nm);
end;

{ ---- float's own methods ------------------------------------------------

  A `float` carried none of them, and the failure mode was the bad one: the
  call COMPILED and raised "object is not callable" at run time, because the
  member read produced None. `x.is_integer()` is ordinary modern Python and is
  what a library reaches for instead of `x == int(x)`.
  bug-a-bytes-has-almost-none-of-its-python-methods

  Deliberately NOT folded into PyIsIntMethodName, and this is the interesting
  part: that test is consulted by PyIsIntMethodSuffixAhead, which sees only the
  NAME and no receiver, and `hex` is already a method of `bytes`. Adding `hex`
  to a name-only test would make every generic postfix chain step aside for
  `b.hex()` and hand it to an int intrinsic that cannot serve it. So the float
  names are claimed only at the two sites that KNOW the receiver's type, and a
  grouped `(3.5).hex()` is left to the ordinary path rather than bought at the
  price of breaking bytes.hex(). }
function PyIsFloatMethodName(const nm: AnsiString): Boolean;
begin
  PyIsFloatMethodName := (nm = 'is_integer') or (nm = 'hex') or
                         (nm = 'as_integer_ratio') or (nm = 'conjugate');
end;

function PyIsFloatBaseTk(tk: TTypeKind): Boolean;
begin
  { STATICALLY float only. A Variant receiver is left to the runtime method
    dispatch: the value in it may be a bytes, and `bytes.hex()` is a real
    method that must keep reaching TPyBytes. }
  PyIsFloatBaseTk := (tk = tyDouble) or (tk = tySingle) or (tk = tyExtended);
end;

{ The three of the four that INT carries too — `(3).is_integer()` is True and
  `(3).as_integer_ratio()` is (3, 1) in CPython 3.12. `hex` is not among them:
  int has no .hex(), that name is float's and bytes'. Their int spellings
  answer INT-flavoured values (3, not 3.0), which is why they are separate
  pylib entry points rather than a cast into the float ones. }
function PyIsIntFloatSharedMethodName(const nm: AnsiString): Boolean;
begin
  PyIsIntFloatSharedMethodName := (nm = 'is_integer') or
                                  (nm = 'as_integer_ratio') or
                                  (nm = 'conjugate');
end;

{ Does this receiver type claim this float-family name? Float takes all four;
  int takes the shared three. Static types only — see PyIsFloatBaseTk. }
function PyIsFloatMethodBaseTk(tk: TTypeKind; const nm: AnsiString): Boolean;
begin
  PyIsFloatMethodBaseTk := PyIsFloatBaseTk(tk) or
    (PyIsIntBaseTk(tk) and PyIsIntFloatSharedMethodName(nm));
end;

{ The float-method CALL over an ALREADY-LOWERED, already-float receiver. Split
  out of PyParseFloatMethod so the runtime dispatcher's float arm builds the
  same node from a receiver it unboxed itself rather than growing a second
  spelling of the table — one place decides which pylib proc and which result
  type each of the four names has. }
function PyMakeFloatMethodOn(recvNode: Integer; const nm: AnsiString;
                            asInt: Boolean): Integer;
var procIdx, callNode, a0: Integer; fn: AnsiString; retTk: TTypeKind;
begin
  if asInt then
  begin
    { the int flavour of the shared three — int-valued results, not float }
    retTk := tyInt64;
    if nm = 'is_integer' then begin fn := 'pyint_is_integer'; retTk := tyBoolean; end
    else if nm = 'as_integer_ratio' then begin fn := 'pyint_as_integer_ratio'; retTk := tyClass; end
    else fn := 'pyint_conjugate';
    procIdx := FindProc(fn);
    if procIdx < 0 then Error('Nil Python: pylib (' + fn + ') not loaded');
    a0 := AllocNode(AN_ARG); ASTLeft[a0] := recvNode; ASTRight[a0] := -1;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := procIdx;
    ASTTk[callNode] := Ord(retTk);
    ASTRight[callNode] := ProcRetRecId[procIdx];
    ASTLeft[callNode] := a0;
    LastExprTk := retTk;
    Result := callNode;
    Exit;
  end;
  retTk := tyDouble;
  if nm = 'is_integer' then begin fn := 'pyfloat_is_integer'; retTk := tyBoolean; end
  else if nm = 'hex' then begin fn := 'pyfloat_hex'; retTk := tyAnsiString; end
  else if nm = 'as_integer_ratio' then begin fn := 'pyfloat_as_integer_ratio'; retTk := tyClass; end
  else fn := 'pyfloat_conjugate';
  procIdx := FindProc(fn);
  if procIdx < 0 then Error('Nil Python: pylib (' + fn + ') not loaded');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := recvNode; ASTRight[a0] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(retTk);
  ASTRight[callNode] := ProcRetRecId[procIdx];
  ASTLeft[callNode] := a0;
  LastExprTk := retTk;
  Result := callNode;
end;

{ The one dispatcher for a float method, mirroring PyParseIntMethod. CurTok is
  the '(' ; all four take no arguments. }
function PyParseFloatMethod(baseNode: Integer; const nm: AnsiString;
                            asInt: Boolean): Integer;
begin
  Expect(tkLParen, '(');
  Expect(tkRParen, ')');
  Result := PyMakeFloatMethodOn(baseNode, nm, asInt);
end;

{ Is CurTok the '.' of an intercepted int-method suffix? Used by the generic
  postfix chains to LEAVE the suffix alone so the intrinsic can claim it — a
  grouped `(10).to_bytes(...)` would otherwise be eaten as a member access on an
  integer and die as "unexpected token". }
function PyIsIntMethodSuffixAhead: Boolean;
begin
  Result := (CurTok.Kind = tkDot) and (TokPos + 1 < TokCount) and
            (Tokens[TokPos].Kind = tkIdent) and
            PyIsIntMethodName(LowerCase(GetTokenStr(TokPos))) and
            (Tokens[TokPos + 1].Kind = tkLParen);
end;

{ `sys.stdout` / `sys.stderr` as an ORDINARY EXPRESSION yielding the stream's
  fd. Done at the factor level, not inside print's file= handling, because
  `sys` is a deferred stdlib import and therefore not a symbol: every pass that
  parses the expression — including the typing pre-pass, which runs BEFORE
  statement parsing and was the one actually rejecting it — has to agree that
  `sys.stderr` resolves. Modelling it as an fd integer is what lets
  AN_WRITE/AN_WRITELN pick it up through their existing ival slot. }
{ The dotted root a bare name was `from`-imported from, or '' when it was not
  one — the read side of PyStdAlias*. A name this module DECLARES wins: an
  import binds a name and a later def or assignment rebinds it, exactly as
  CPython scopes it. bug-n-a-from-import-of-a-compiler-provided-module-binds-no-names }
function PyStdAliasLookup(const nm: AnsiString; var member: AnsiString): AnsiString;
var i, ni, pi, si: Integer;
begin
  Result := '';
  member := '';
  if (nm = '') or (PyStdAliasCount = 0) then Exit;
  ni := InternStr(LowerCase(nm));
  for i := 0 to PyStdAliasCount - 1 do
    if (PyStdAliasName[i] = ni) and (PyStdAliasUnit[i] = CurrentUnitIdx) then
    begin
      pi := FindProcInUnit(nm, CurrentUnitIdx);
      if (pi >= 0) and PyDefBoundHere(pi) then Exit;
      si := FindSym(nm);
      if (si >= 0) and (SymUnitIdx[si] = CurrentUnitIdx) then Exit;
      { The MEMBER, not the local name: `from sys import argv as av` puts `av`
        in scope and still means sys.ARGV. Keeping only the local spelling made
        the rename resolve nothing at all. }
      member := Strs[PyStdAliasMember[i]].Text;
      Result := Strs[PyStdAliasBase[i]].Text;
      Exit;
    end;
end;

function PyStdAliasRootOf(const nm: AnsiString): AnsiString;
var member: AnsiString;
begin
  Result := PyStdAliasLookup(nm, member);
end;

{ Does `<base>.<nm>` name a compiler-provided VALUE? Split out of the token
  predicate below so the bare-name form a from-import binds asks the SAME
  question — one membership test, two spellings. }
function PyIsStdlibMemberValue(const base, nm: AnsiString; anyAttr: Boolean): Boolean;
begin
  Result := False;
  if base = 'sys' then
  begin
    { The MODELLED members — the ones PyParseSysStream builds a real value for. }
    Result := (nm = 'argv') or (nm = 'platform') or (nm = 'executable') or
              (nm = 'stdout') or (nm = 'stderr') or (nm = 'stdin');
    { ...and, for the QUALIFIED spelling only, any other sys attribute as a
      runtime "not available here". `sys._MEIPASS` is the shape — PyInstaller
      sets it and CPython raises AttributeError when it is absent, which is
      exactly what the application's `try/except` around it expects. Reported
      at run time, not silently zero.
      The BARE spelling deliberately does NOT take this arm: `from sys import
      nosuch` must keep walling at COMPILE time as an undefined variable, which
      is what the consumed-only policy is after — turning it into a runtime
      raise would be a strictly weaker diagnostic for a name nothing provides. }
    if (not Result) and anyAttr then Result := True;
  end
  else if base = 'os' then
    { os.SEEK_SET/CUR/END — the whence CONSTANTS, bare values not calls. }
    Result := (nm = 'seek_set') or (nm = 'seek_cur') or (nm = 'seek_end');
end;

function PyIsSysStreamAhead: Boolean;
var base, nm, aliasMem: AnsiString;
begin
  Result := False;
  if TokPos < 1 then Exit;
  { The BARE spelling first — `from sys import argv` then `argv`. It occupies
    ONE token, so it is tested before the dotted form's TokPos+1 read. }
  base := PyStdAliasLookup(GetTokenStr(TokPos - 1), aliasMem);
  if (base <> '') and PyIsStdlibMemberValue(base, aliasMem, False) then
  begin
    Result := True;
    Exit;
  end;
  if TokPos + 1 >= TokCount then Exit;
  if Tokens[TokPos].Kind <> tkDot then Exit;
  base := LowerCase(GetTokenStr(TokPos - 1));
  nm := LowerCase(GetTokenStr(TokPos + 1));
  Result := PyIsStdlibMemberValue(base, nm, True);
end;

function PyParseSysStream: Integer;
var nm: AnsiString; procIdx: Integer;
begin
  { Either spelling arrives here: the dotted one spends three tokens, the bare
    one (a from-imported name) spends one and takes its base from the alias. }
  if (TokPos >= 1) and (PyStdAliasLookup(GetTokenStr(TokPos - 1), nm) <> '') and
     ((TokPos >= TokCount) or (Tokens[TokPos].Kind <> tkDot)) then
    Next                         { the bare name; nm is its MEMBER }
  else
  begin
    nm := LowerCase(GetTokenStr(TokPos + 1));
    Next; Next; Next;            { base, '.', the member name }
  end;
  if (nm = 'seek_set') or (nm = 'seek_cur') or (nm = 'seek_end') then
  begin
    Result := AllocNode(AN_INT_LIT);
    if nm = 'seek_cur' then ASTIVal[Result] := 1
    else if nm = 'seek_end' then ASTIVal[Result] := 2
    else ASTIVal[Result] := 0;
    ASTTk[Result] := Ord(tyInteger);
    ASTRight[Result] := -1;
    LastExprTk := tyInteger;
    Exit;
  end;
  if nm = 'platform' then
  begin
    { sys.platform — the value CPython reports on the platform pxx hosts on.
      songformatter branches on it to pick a file-opener command, and every
      such test in real code is `== "darwin"` / `.startswith("win")`, so a
      constant string is the whole of what is needed. When pxx targets Windows
      this has to follow the TARGET, not the host. }
    Result := AllocNode(AN_STR_LIT);
    ASTSOffset[Result] := PyStoredName('linux');
    ASTSLen[Result] := 5;
    ASTTk[Result] := Ord(tyString);
    LastExprTk := tyString;
    Exit;
  end;
  if nm = 'executable' then
  begin
    { sys.executable — the resolved path of the running binary. Same helper
      __file__ uses, so the two can never disagree, and it takes "where am I
      installed" off __file__ for good.
      feature-nilpy-file-dunder-from-the-executable }
    procIdx := FindProc('pysys_executable');
    if procIdx < 0 then Error('Nil Python: pylib (pysys_executable) not loaded');
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := procIdx;
    ASTTk[Result] := Ord(tyAnsiString);
    ASTLeft[Result] := -1;
    LastExprTk := tyAnsiString;
    Exit;
  end;
  if nm = 'argv' then
  begin
    { sys.argv as a VALUE — the command line as a TPyList of strings. }
    procIdx := FindProc('pysys_argv');
    if procIdx < 0 then Error('Nil Python: pylib (pysys_argv) not loaded');
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := procIdx;
    ASTTk[Result] := Ord(tyClass);
    ASTRight[Result] := ProcRetRecId[procIdx];
    ASTLeft[Result] := -1;
    LastExprTk := tyClass;
    Exit;
  end;
  if (nm <> 'stdout') and (nm <> 'stderr') and (nm <> 'stdin') then
  begin
    { an attribute this sys does not have — raise, as CPython does }
    Result := PyMakeOptionalMissingCall('sys.' + nm);
    LastExprTk := IntToTypeKind(ASTTk[Result]);
    Exit;
  end;
  Result := AllocNode(AN_INT_LIT);
  { stdin=0, stdout=1, stderr=2 — the fd each stream stands for. }
  if nm = 'stderr' then ASTIVal[Result] := 2
  else if nm = 'stdin' then ASTIVal[Result] := 0
  else ASTIVal[Result] := 1;
  ASTTk[Result] := Ord(tyInteger);
  ASTRight[Result] := -1;
  LastExprTk := tyInteger;
end;

{ ---- stdlib dotted calls: os.path.join(...), sys.exit(...) ----------------
  `os` and `sys` are deferred imports and never become symbols, so a dotted
  call on them cannot go through ordinary member resolution — it is mapped by
  NAME onto a pylib function instead. Same reasoning as sys.stdout/sys.stderr
  above, and handled at the same factor level so every pass agrees.

  Deliberately a fixed table rather than a general module system: each entry is
  a shim with real semantics behind it, and an unmapped name must stay an
  error rather than resolve to something plausible. }
function PyStdlibCallProc(const dotted: AnsiString): AnsiString;
begin
  if dotted = 'os.path.isabs' then Result := 'pyos_path_isabs'
  else if dotted = 'os.path.join' then Result := 'pyos_path_join'
  else if dotted = 'os.path.exists' then Result := 'pyos_path_exists'
  else if dotted = 'os.path.abspath' then Result := 'pyos_path_abspath'
  else if dotted = 'os.path.dirname' then Result := 'pyos_path_dirname'
  else if dotted = 'os.path.basename' then Result := 'pyos_path_basename'
  else if dotted = 'os.path.isdir' then Result := 'pyos_path_isdir'
  else if dotted = 'os.path.isfile' then Result := 'pyos_path_isfile'
  else if dotted = 'os.path.splitext' then Result := 'pyos_path_splitext'
  else if dotted = 'os.path.split' then Result := 'pyos_path_split'
  else if dotted = 'os.path.normpath' then Result := 'pyos_path_normpath'
  else if dotted = 'os.path.getsize' then Result := 'pyos_path_getsize'
  else if dotted = 'os.path.expanduser' then Result := 'pyos_path_expanduser'
  else if dotted = 'os.getcwd' then Result := 'pyos_getcwd'
  else if dotted = 'os.environ.get' then Result := 'pyos_environ_get'
  else if dotted = 'os.getenv' then Result := 'pyos_getenv'
  else if dotted = 'os.remove' then Result := 'pyos_remove'
  else if dotted = 'os.startfile' then Result := 'pyos_startfile'
  else if dotted = 'os.rename' then Result := 'pyos_rename'
  else if dotted = 'os.stat' then Result := 'pyos_stat'
  else if dotted = 'sys.exit' then Result := 'pysys_exit'
  else if dotted = 'sys.stdin.read' then Result := 'pystdin_read'
  else if dotted = 'sys.stdin.readline' then Result := 'pystdin_readline'
  else if dotted = 'sys.stdin.isatty' then Result := 'pystdin_isatty'
  else if dotted = 'select.select' then Result := 'pyselect_select'
  else if dotted = 'textwrap.dedent' then Result := 'pytextwrap_dedent'
  { dict.fromkeys(iterable) — a CLASSMETHOD, so it reaches the same table: the
    base name is a type rather than a module, which changes nothing here.
    songformatter uses `list(dict.fromkeys(xs))`, the standard order-preserving
    dedupe. }
  else if dotted = 'dict.fromkeys' then Result := 'pydict_fromkeys'
  { str.maketrans — a STATIC method, reaching the same table for the same
    reason dict.fromkeys does: the base name is a type rather than a module. }
  else if dotted = 'str.maketrans' then Result := 'pystr_maketrans'
  { math.floor/math.ceil must NOT reach the RTL Math unit's own Floor/Ceil
    (Double->Double, correct for the Pascal frontend, wrong for Python's int
    contract) -- intercepted here by name, ahead of the ordinary qualified-
    call resolution that `import math` would otherwise hit.
    bug-nilpy-implicit-return-is-0-and-math-floor-returns-a-float }
  else if dotted = 'math.floor' then Result := 'pymath_floor'
  else if dotted = 'math.ceil' then Result := 'pymath_ceil'
  { math.fabs has no Pascal RTL counterpart under that name at all --
    `import math` had nothing to resolve `fabs` to (feature-nilpy-stdlib-
    coverage-gaps-measured), unlike floor/ceil which reached the WRONG thing. }
  else if dotted = 'math.fabs' then Result := 'pymath_fabs'
  { math.trunc: the same int-vs-float CONTRACT mismatch as floor/ceil above.
    math.copysign: no contract mismatch at all, but the name cannot exist in the
    Pascal RTL, where it hijacks libc's in every C program.
    math.log / math.pow / math.atan2 are NOT here — they need a transcendental
    (Ln, a correctly-rounded pow) and a BUILTIN unit cannot reach one: Ln lives
    in lib/rtl/math.pas, and `uses math` from pylib would put the RTL's Min/Max/
    Power beside pylib's own min/max overloads. See the ticket for the measured
    detail.
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  else if dotted = 'math.trunc' then Result := 'pymath_trunc'
  else if dotted = 'math.copysign' then Result := 'pymath_copysign'
  { asin/acos/atan are a pure NAME difference — the RTL spells them ArcSin,
    ArcCos, ArcTan, so `import math` had nothing to resolve them to and each
    died as `undefined variable`, exactly as `log` did above. Same contract,
    same values; nothing to compute here.
    bug-nilpy-math-surface-remaining-gaps-and-degrees-association }
  else if dotted = 'math.asin' then Result := 'ArcSin'
  else if dotted = 'math.acos' then Result := 'ArcCos'
  else if dotted = 'math.atan' then Result := 'ArcTan'
  { ...and the five that need a container or an exact algorithm rather than a
    rename. All of them are pure arithmetic, which is what lets them live in a
    builtin unit at all — see math.log's note. }
  { sqrt/log10/log2 resolved by ORDINARY qualified lookup (the RTL spells them
    the same), which is why they were never in this table. They are here now so
    they reach PyParseStdlibCall, where the domain guard is wrapped around
    argument 0 — `math.sqrt(-1)` must raise ValueError, not answer nan.
    bug-n-math-pow-domain-error-raises-the-wrong-exception }
  else if dotted = 'math.sqrt' then Result := 'Sqrt'
  else if dotted = 'math.log10' then Result := 'Log10'
  else if dotted = 'math.log2' then Result := 'Log2'
  else if dotted = 'math.modf' then Result := 'pymath_modf'
  else if dotted = 'math.prod' then Result := 'pymath_prod'
  else if dotted = 'math.fsum' then Result := 'pymath_fsum'
  else if dotted = 'math.perm' then Result := 'pymath_perm'
  { `import random` resolved to nothing at all — every name under it was
    `undefined variable`, and it is one of the first imports a script reaches
    for. The generator is pylib's own (SplitMix64); the SEQUENCE is not
    CPython's and is not meant to be, but the contract is. }
  else if dotted = 'random.random' then Result := 'pyrandom_random'
  else if dotted = 'random.seed' then Result := 'pyrandom_seed'
  else if dotted = 'random.randint' then Result := 'pyrandom_randint'
  else if dotted = 'random.randrange' then Result := 'pyrandom_randrange'
  else if dotted = 'random.uniform' then Result := 'pyrandom_uniform'
  else if dotted = 'random.choice' then Result := 'pyrandom_choice'
  else if dotted = 'random.shuffle' then Result := 'pyrandom_shuffle'
  { math.dist is NOT here: it needs Sqrt, which lives in lib/rtl/math.pas and a
    BUILTIN unit cannot reach (the same wall math.log/math.pow hit — see their
    note above), while its arguments are pylib CONTAINERS the RTL cannot name.
    It is the one entry of this sweep that needs a composed lowering rather than
    a table row. bug-nilpy-math-surface-remaining-gaps-and-degrees-association }
  { math.log -- the RTL spells the natural log `Ln`, so `import math` had
    nothing to resolve `log` to and it died as `undefined variable (log)` while
    log10 and log2 (same names in both languages) worked. This is a pure NAME
    difference, not a contract one: both are Double->Double and agree.
    The TWO-argument form `math.log(x, base)` is NOT answered by this -- it
    reaches Ln with two arguments and is refused by arity, which is honest.
    CPython computes it as an unsnapped log(x)/log(base) and the RTL's LogN
    snaps, so mapping it there would be a silently WRONG value; it needs a
    helper that cannot live in a builtin unit (see the ticket).
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  else if dotted = 'math.log' then Result := 'Ln'
  { math.pow -- the RTL spells it `Power`, and the name `pow` cannot be added to
    the RTL at all: it hijacks libc's in every C program
    (bug-c-pascal-math-names-hijack-libc-through-pxxcio, measured: pow(2,10)
    answered 1). A pure NAME difference again, and MEASURED to agree with
    CPython to the last bit -- unlike NilPy's own float `**`, which is a
    separate 1-ulp path (bug-nilpy-float-pow-loses-a-ulp-vs-libm) and is NOT
    what this resolves to.

    math.atan2 is still absent, and stays absent: ArcTan2 is 1 ulp off CPython
    for atan2(0.5, 1) (0.46364760900080615 vs ...09), so mapping it would be a
    silently wrong value in the last place. Blocked on a correctly-rounded libm,
    not on this table.
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  else if dotted = 'math.pow' then Result := 'Power'
  { exp/sinh/cosh are pure NAME matches — `import math` already reached the
    RTL's own Exp/Sinh/Cosh. They are listed anyway so the call is BUILT here,
    which is where the overflow guard can wrap the result: CPython raises
    OverflowError for `math.exp(1000)` where IEEE (and so the RTL) answers inf.
    bug-nilpy-float-overflow-answers-inf-where-cpython-raises }
  else if dotted = 'math.exp' then Result := 'Exp'
  else if dotted = 'math.sinh' then Result := 'Sinh'
  else if dotted = 'math.cosh' then Result := 'Cosh'
  else Result := '';
end;

{ nTok = how many tokens the dotted name occupies, so the caller can skip to
  the '(' . CurTok is the leading `os`/`sys`. }
function PyStdlibCallAhead(var pname: AnsiString; var nTok: Integer): Boolean;
var base, d2, d3, aliasMem: AnsiString;
begin
  Result := False; pname := ''; nTok := 0;
  if TokPos < 1 then Exit;
  { `from os import getenv` then `getenv(...)` — the bare spelling, ONE token
    ahead of the '('. Same table, same shim: what the from-import binds is
    exactly what the dotted form would have resolved to, so an entry can never
    exist for one spelling and not the other. }
  base := PyStdAliasLookup(GetTokenStr(TokPos - 1), aliasMem);
  if (base <> '') and (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
  begin
    pname := PyStdlibCallProc(base + '.' + aliasMem);
    if pname <> '' then begin nTok := 1; Result := True; Exit; end;
  end;
  base := LowerCase(GetTokenStr(TokPos - 1));
  if (base <> 'os') and (base <> 'sys') and (base <> 'textwrap') and
     (base <> 'select') and (base <> 'dict') and (base <> 'math') and
     (base <> 'random') and (base <> 'str') then Exit;
  if (TokPos >= TokCount) or (Tokens[TokPos].Kind <> tkDot) then Exit;
  if TokPos + 1 >= TokCount then Exit;
  d2 := base + '.' + LowerCase(GetTokenStr(TokPos + 1));
  { three segments first — `os.path.join` must not be read as `os.path` }
  if (TokPos + 4 < TokCount) and (Tokens[TokPos + 2].Kind = tkDot) and
     (Tokens[TokPos + 4].Kind = tkLParen) then
  begin
    d3 := d2 + '.' + LowerCase(GetTokenStr(TokPos + 3));
    pname := PyStdlibCallProc(d3);
    if pname <> '' then begin nTok := 5; Result := True; Exit; end;
  end;
  if (TokPos + 2 < TokCount) and (Tokens[TokPos + 2].Kind = tkLParen) then
  begin
    pname := PyStdlibCallProc(d2);
    if pname <> '' then begin nTok := 3; Result := True; Exit; end;
  end;
end;

function PyParseStdlibCall(const pname: AnsiString; nTok: Integer): Integer;
var procIdx, callNode, argNode, lastArg, i, nArgs: Integer;
    lnA, lnB, lnArg, divNode: Integer;   { math.log(x, base) — see below }
    domPi, domArg, domArg2, domCall: Integer;   { math domain guard — see below }
    domName: AnsiString;
    rngA, rngB, rngPi, rngArg, rngArg2, rngArg3, rngCall: Integer;  { overflow guard }
    rngName: AnsiString;
begin
  nArgs := 0;
  { Python's math module is FLOAT-ONLY, so when the shim name has an all-Double
    overload that is the one it means. Arity cannot tell them apart —
    `Power(Integer, Integer): Integer` and `Power(Double, Double): Double` both
    take two, and the integer one is declared first — so a plain name lookup
    gave `math.pow(2.0, 0.5)` the truncating integer power and answered 1.
    Only this one name asks, so no other stdlib shim changes its answer.
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  procIdx := -1;
  { THIS lookup is the qualified one. `math.sqrt` names the module explicitly,
    so the unit's names are reachable here even though a NilPy `import` makes
    them invisible to bare-name resolution — that is the whole distinction
    QualNameLookup carries.
    bug-nilpy-import-leaks-the-units-names-into-the-python-namespace }
  QualNameLookup := True;
  if pname = 'Power' then procIdx := FindProcArityDouble(pname, 2);
  { same reason as Power: each of these has a Single overload too, and Python's
    math module is float-only. }
  if (pname = 'Exp') or (pname = 'Sinh') or (pname = 'Cosh') then
    procIdx := FindProcArityDouble(pname, 1);
  if procIdx < 0 then procIdx := FindProc(pname);
  QualNameLookup := False;
  if procIdx < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  for i := 1 to nTok do Next;          { the dotted name; CurTok = '(' }
  Expect(tkLParen, '(');
  lastArg := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(Procs[procIdx].RetType);
  ASTRight[callNode] := ProcRetRecId[procIdx];
  ASTLeft[callNode] := -1;
  if CurTok.Kind <> tkRParen then
    repeat
      if CurTok.Kind = tkRParen then Break;   { a trailing comma before ) }
      PyParseBoolExpr;
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := CurASTNode;
      ASTRight[argNode] := -1;
      if lastArg < 0 then ASTLeft[callNode] := argNode
      else ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(nArgs);
    until not Eat(tkComma);
  Expect(tkRParen, ')');
  { RE-TARGET BY ARITY. FindProc above answers by NAME and never consults
    overloads, so the shim it returned may simply be the wrong arity — and an
    ordinary Pascal `overload` added to fix that used to have no effect at all,
    silently (bug-nilpy-stdlib-shim-table-cannot-reach-an-overload; it cost
    three rediscoveries in one night). FindProcArity closes that for the arity
    case: a same-named overload taking exactly this many arguments is now
    reachable from a hand-built call site, so `os.path.join(a, b, c)` works by
    declaring a 3-argument overload like any Pascal routine.

    The `<name>_d` fallback stays for the shims that already use it — the
    optional-DEFAULT form, e.g. `os.environ.get(name, default)` beside
    `os.environ.get(name)`, where the two arities were given DIFFERENT names
    precisely because this lookup did not exist. Tried second, so nothing that
    works today changes its answer.

    Type-based selection is still not reachable this way; see FindProc's own
    note for what to do then. }
  { math.log(x, base): the shim is the RTL's one-argument Ln, so the generic
    arity error below would name `Ln` — an internal spelling the program never
    wrote. Say what is actually unsupported, and why, since the workaround is
    one line of user code.
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  { CPython's math module REFUSES its domain errors; IEEE — and so the Pascal
    RTL these lower to — answers a quiet NaN or -Inf. Wrap argument 0 in the
    matching pylib guard, which returns it unchanged or raises
    `ValueError: math domain error`.

    On the ARGUMENT rather than the result, because that is where the domain
    is: `math.sqrt(float('nan'))` is nan in CPython, and a result check could
    not tell that from `sqrt(-1)`. And here rather than in a pylib shim for the
    reason math.log is lowered here — a BUILTIN unit cannot reach the RTL's
    transcendentals at all.
    bug-n-math-pow-domain-error-raises-the-wrong-exception }
  { OVERFLOW guard, prepared HERE and applied at the end: CPython's math module
    raises OverflowError where IEEE answers inf (`math.exp(1000)`,
    `math.pow(10, 400)`), while the ARITHMETIC operators do not — `1e300 *
    1e300` is inf on both sides. So it is a per-CALL rule, and it wants the
    ARGUMENTS as well as the result, because an infinite input is not an
    overflow: `math.exp(float('inf'))` is inf in CPython too.
    Naming an argument twice means parking it in a temp first — the domain
    guard below also rewrites argument 0 in place, and a node referenced twice
    is EMITTED twice.
    bug-nilpy-float-overflow-answers-inf-where-cpython-raises }
  rngA := -1; rngB := -1;
  if ((pname = 'Power') and (nArgs = 2)) or
     (((pname = 'Exp') or (pname = 'Sinh') or (pname = 'Cosh')) and (nArgs = 1)) then
  begin
    ASTLeft[ASTLeft[callNode]] := PyEvalOnce(ASTLeft[ASTLeft[callNode]]);
    rngA := ASTLeft[ASTLeft[callNode]];
    if nArgs = 2 then
    begin
      ASTLeft[ASTRight[ASTLeft[callNode]]] :=
        PyEvalOnce(ASTLeft[ASTRight[ASTLeft[callNode]]]);
      rngB := ASTLeft[ASTRight[ASTLeft[callNode]]];
    end;
  end;
  if (nArgs >= 1) and (ASTLeft[callNode] >= 0) then
  begin
    domName := '';
    if pname = 'Sqrt' then domName := 'pymath_dom_nonneg'
    else if (pname = 'Ln') and (nArgs = 1) then domName := 'pymath_dom_pos'
    else if (pname = 'Log10') or (pname = 'Log2') then domName := 'pymath_dom_pos'
    else if (pname = 'ArcSin') or (pname = 'ArcCos') then domName := 'pymath_dom_unit'
    else if (pname = 'Power') and (nArgs = 2) then domName := 'pymath_dom_pow';
    if domName <> '' then
    begin
      domPi := FindProc(domName);
      if domPi < 0 then Error('Nil Python: pylib (' + domName + ') not loaded');
      domArg := AllocNode(AN_ARG);
      ASTLeft[domArg] := ASTLeft[ASTLeft[callNode]];
      ASTRight[domArg] := -1;
      if domName = 'pymath_dom_pow' then
      begin
        { the EXPONENT reaches both the guard and Power itself, so it is parked
          in a temp first — an AST node used twice is EMITTED twice, and
          `math.pow(b, f())` would call f() a second time. }
        ASTLeft[ASTRight[ASTLeft[callNode]]] :=
          PyEvalOnce(ASTLeft[ASTRight[ASTLeft[callNode]]]);
        domArg2 := AllocNode(AN_ARG);
        ASTLeft[domArg2] := CloneAST(ASTLeft[ASTRight[ASTLeft[callNode]]]);
        ASTRight[domArg2] := -1;
        ASTRight[domArg] := domArg2;
      end;
      domCall := AllocNode(AN_CALL);
      ASTIVal[domCall] := domPi;
      ASTTk[domCall] := Ord(tyDouble);
      ASTLeft[domCall] := domArg;
      ASTLeft[ASTLeft[callNode]] := domCall;
    end;
  end;
  { math.log(x, base) — lowered HERE, in the frontend, as the division of two
    Ln calls, and deliberately not mapped to the RTL's LogN.

    The two oracles genuinely disagree and each is right for its own language:
    CPython computes a plain unsnapped quotient (`log(1000, 10)` is
    2.9999999999999996) while FPC's LogN lands exactly on 3.0, and pxx's LogN
    matches FPC. Ordinary code branches on the difference — `int(math.log(n,
    10))` differs by one — so this is upward compatibility, not a rounding
    nicety.

    A frontend lowering rather than a `pymath_log` shim because pylib is a
    BUILTIN unit and there is no `Ln` to call from one: Ln lives in
    lib/rtl/math.pas, and `uses math` from pylib would put the RTL's Min/Max
    beside pylib's own min/max overloads — the recorded "builtin overload
    competes with a used-unit routine" hazard, for a silent re-resolution in
    every NilPy program. Route 2 of the ticket, and it keeps the builtin unit
    out of it entirely. The shim table maps a dotted name to ONE proc, which is
    why this cannot be a table entry.

    It writes exactly the workaround the refusal used to suggest, so the value
    is the one that was measured to match CPython.
    bug-n-math-trunc-and-log-need-frontend-intercepts }
  if (pname = 'Ln') and (nArgs = 2) then
  begin
    lnArg := ASTLeft[callNode];                  { arg 0 = x }
    lnA := AllocNode(AN_CALL);
    ASTIVal[lnA] := procIdx;
    ASTTk[lnA] := Ord(Procs[procIdx].RetType);
    ASTRight[lnA] := ProcRetRecId[procIdx];
    ASTLeft[lnA] := lnArg;
    lnB := AllocNode(AN_CALL);
    ASTIVal[lnB] := procIdx;
    ASTTk[lnB] := Ord(Procs[procIdx].RetType);
    ASTRight[lnB] := ProcRetRecId[procIdx];
    ASTLeft[lnB] := ASTRight[lnArg];             { arg 1 = base }
    ASTRight[lnArg] := -1;                       { each Ln takes ONE argument }
    divNode := AllocNode(AN_BINOP);
    ASTIVal[divNode] := Ord(tkSlash);
    ASTTk[divNode] := Ord(tyDouble);
    ASTLeft[divNode] := lnA;
    ASTRight[divNode] := lnB;
    LastExprTk := tyDouble;
    Result := divNode;
    Exit;
  end;
  if nArgs <> Procs[procIdx].ParamCount then
  begin
    i := FindProcArity(pname, nArgs);
    if i < 0 then
    begin
      i := FindProc(pname + '_d');
      if (i >= 0) and (Procs[i].ParamCount <> nArgs) then i := -1;
    end;
    if i >= 0 then
    begin
      procIdx := i;
      ASTIVal[callNode] := procIdx;
      ASTTk[callNode] := Ord(Procs[procIdx].RetType);
      ASTRight[callNode] := ProcRetRecId[procIdx];
    end
    else if nArgs > Procs[procIdx].ParamCount then
      Error('Nil Python: ' + pname + ' takes ' +
            'fewer arguments than were given');
  end;
  { the overflow guard prepared above — wraps the finished call }
  if rngA >= 0 then
  begin
    if rngB >= 0 then rngName := 'pymath_range' else rngName := 'pymath_range1';
    rngPi := FindProc(rngName);
    if rngPi < 0 then Error('Nil Python: pylib (' + rngName + ') not loaded');
    rngArg3 := -1;
    if rngB >= 0 then
    begin
      rngArg3 := AllocNode(AN_ARG);
      ASTLeft[rngArg3] := CloneAST(rngB); ASTRight[rngArg3] := -1;
    end;
    rngArg2 := AllocNode(AN_ARG);
    ASTLeft[rngArg2] := CloneAST(rngA); ASTRight[rngArg2] := rngArg3;
    rngArg := AllocNode(AN_ARG);
    ASTLeft[rngArg] := callNode; ASTRight[rngArg] := rngArg2;
    rngCall := AllocNode(AN_CALL);
    ASTIVal[rngCall] := rngPi;
    ASTTk[rngCall] := Ord(tyDouble);
    ASTLeft[rngCall] := rngArg;
    LastExprTk := tyDouble;
    Result := rngCall;
    Exit;
  end;
  LastExprTk := IntToTypeKind(ASTTk[callNode]);
  Result := callNode;
end;

{ hasattr(obj, "name") / getattr(obj, "name" [, default]).

  Every censused use passes a STRING LITERAL attribute name, and NilPy classes
  have statically-declared fields, so both resolve at COMPILE time against the
  receiver's class. A receiver with no static class (a variant, e.g. a caught
  exception) counts as "does not declare it" — which is right for the corpus,
  where getattr(e, "errno", 1) probes for attributes our exception shims do not
  have and wants the default.

  Deviation worth knowing: Python's hasattr answers "has this attribute been
  ASSIGNED on this instance", per object. NilPy fields always exist and are
  zero-initialised, so a declared field reports True even before first
  assignment. Filed as decide-nilpy-hasattr-per-instance-semantics. }
function PyAttrFieldIdx(recvNode: Integer; const attr: AnsiString): Integer;
var rec, ci: Integer;
begin
  Result := -1;
  if recvNode < 0 then Exit;
  rec := ResolveNodeRec(recvNode);
  if rec < REC_UCLASS_BASE then Exit;
  ci := rec - REC_UCLASS_BASE;
  Result := FindUField(ci, attr);
end;

{ Does this receiver have this attribute, as far as the FRONTEND can tell?

  `PyAttrFieldIdx` above answers only "is it a declared FIELD of a user class",
  which is the right question for building a field read and the wrong one for
  `hasattr`. A method is an attribute; so is a str method, an int method, and a
  pylib container method reached under its Python ALIAS. Asking the field
  question alone made `hasattr([1], "append")` and `hasattr("s", "upper")`
  answer False about methods the very next line calls successfully — and
  `hasattr` is Python's duck-typing primitive, so a False sends `if
  hasattr(x, "read")` down the wrong branch silently.

  Deliberately reuses the SAME tables the CALL uses (FindUMeth,
  PyPylibMethodAlias, PyStrMethodInfo, PyIsIntMethodBaseTk) rather than listing
  names again — a second list is a second thing to keep in step, and the drift
  is exactly what this bug was.
  bug-nilpy-hasattr-on-a-builtin-container-or-str-answers-false }
{ FPC seed: single-pass, and this one is defined further down (PyStrMethodInfo
  and PyIsIntMethodName are both above, so they need no forward).
  bug-a-fpc-seed-drift-emitasmx64-forward }
function PyPylibMethodAlias(ci: Integer; const mname: AnsiString): AnsiString; forward;

function PyMakePropRead(recvNode: Integer; const attr: AnsiString): Integer;
{ `getattr(o, "p")` where `p` is a PROPERTY — the read the ordinary `o.p`
  builds, reached from the one place that has only a NAME. Field-backed
  properties become the backing-field read; method-backed ones the getter call.
  -1 when the receiver has no user class or declares no such property, so the
  caller keeps its dynamic-store path.

  Without it, `getattr` and `hasattr` disagreed about the same name: reading
  `e.args` worked, `hasattr(e, "args")` said False, and once hasattr learned
  about properties `getattr(e, "args")` still raised AttributeError — trading a
  wrongly-taken branch for a crash (bug-nilpy-hasattr-does-not-see-a-property). }
var rec, ci, pri, i, fld: Integer; accName: AnsiString;
begin
  Result := -1;
  if recvNode < 0 then Exit;
  rec := ResolveNodeRec(recvNode);
  if rec < REC_UCLASS_BASE then Exit;
  ci := rec - REC_UCLASS_BASE;
  pri := FindUProp(ci, attr);
  if pri < 0 then Exit;
  if UPropIsIndexed[pri] then Exit;        { needs an index nobody passed }
  if UPropReadFLen[pri] > 0 then
  begin
    accName := '';
    for i := 0 to UPropReadFLen[pri] - 1 do
      AppendChar(accName, TokChars[UPropReadFOff[pri] + i]);
    fld := AllocNode(AN_FIELD);
    ASTLeft[fld] := recvNode;
    ASTSOffset[fld] := UPropReadFOff[pri];
    ASTSLen[fld] := UPropReadFLen[pri];
    ASTTk[fld] := UPropTk[pri];
    ASTRight[fld] := UPropRec[pri];
    Result := fld;
    Exit;
  end;
  if UPropReadMLen[pri] > 0 then
  begin
    accName := '';
    for i := 0 to UPropReadMLen[pri] - 1 do
      AppendChar(accName, TokChars[UPropReadMOff[pri] + i]);
    Result := PyCallMeth1(ci, accName, recvNode, -1);
  end;
end;

function PyAttrExists(recvNode: Integer; const attr: AnsiString): Boolean;
var rec, ci: Integer; tk, rt: TTypeKind; pn, al: AnsiString; wa: Integer;
begin
  PyAttrExists := False;
  if recvNode < 0 then Exit;
  if PyAttrFieldIdx(recvNode, attr) >= 0 then begin PyAttrExists := True; Exit; end;
  rec := ResolveNodeRec(recvNode);
  if rec >= REC_UCLASS_BASE then
  begin
    ci := rec - REC_UCLASS_BASE;
    if FindUMeth(ci, attr) >= 0 then begin PyAttrExists := True; Exit; end;
    { a PROPERTY is a member too — `e.args` on an exception is one, and reading
      it works, so answering False here made hasattr DISAGREE with the access
      right next to it: `hasattr(e, "args")` was False while `e.args` printed
      ('k',). A program that branches on hasattr took the wrong arm
      (bug-nilpy-hasattr-does-not-see-a-property). FindUProp walks ancestors,
      like FindUMeth. }
    if FindUProp(ci, attr) >= 0 then begin PyAttrExists := True; Exit; end;
    { the Python spelling, which is what the user wrote: `d.keys()` reaches a
      pylib method under a different Pascal name, and the RTTI lookup the
      runtime predicate does knows only the Pascal one }
    al := PyPylibMethodAlias(ci, attr);
    if (al <> '') and (FindUMeth(ci, al) >= 0) then begin PyAttrExists := True; Exit; end;
  end;
  tk := IntToTypeKind(ASTTk[recvNode]);
  if (tk = tyAnsiString) or (tk = tyString) or (tk = tyChar) then
    if PyStrMethodInfo(attr, pn, rt, wa) then begin PyAttrExists := True; Exit; end;
  { BOTH halves: PyIsIntMethodBaseTk answers "may an int method claim this
    RECEIVER", which is true of any name on an int — it is a dispatch question,
    not an existence one. `hasattr(1, "nope")` must still be False. }
  if PyIsIntMethodBaseTk(tk, attr) and PyIsIntMethodName(attr) then
    PyAttrExists := True;
end;

{ `hasattr(<variant>, "name")` cannot be answered at compile time — the receiver's
  class is a RUN-TIME fact — but the frontend still knows something decisive: the
  set of user classes that DECLARE the name. So the answer is a run-time test of
  the object's class against that set, which is bounded by what `hasattr` can
  reach and needs no per-class metadata (`decide-nilpy-hasattr-per-instance-
  semantics` step 2: an ambiguous target "falls back to tracking every class in
  that ambiguity set").

  Returns `(pyvartag(recv) = VT_OBJECT) and ((obj is C1) or (obj is C2) ...)`, or
  -1 when no class declares the name (caller keeps the dynamic-store answer).

  Only the class that INTRODUCES the field gets a test: `is` matches descendants
  too, so testing a base covers every subclass, and FindUField already walks
  ancestors — emitting one per declaring class would be correct but quadratic in
  a deep hierarchy.

  The tag guard is not optional: pyvarobj hands back the raw payload, so an `is`
  test on an int-holding variant would dereference the integer. Same shape, same
  reason, as PyParseIsinstance's variant arm.

  `recvNode` must already be an evaluate-ONCE value (a hidden temp): it is read
  once per candidate class plus once for the tag. }
function PyHasAttrClassChain(recvNode: Integer; const attr: AnsiString): Integer;
var ci, argN, callN, isN, chain, tagArg, tagCall, lit, guard: Integer;
begin
  Result := -1;
  chain := -1;
  for ci := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[ci] then Continue;
    if FindUField(ci, attr) < 0 then Continue;
    { the INTRODUCER only — a parent that declares it already covers this class }
    if (UClsParent[ci] >= 0) and (FindUField(UClsParent[ci], attr) >= 0) then Continue;
    argN := AllocNode(AN_ARG);
    ASTLeft[argN] := recvNode;
    callN := AllocNode(AN_CALL);
    ASTIVal[callN] := FindProc('pyvarobj');
    if ASTIVal[callN] < 0 then Exit;      { pylib absent: leave the old path alone }
    ASTTk[callN] := Ord(tyPointer);
    ASTLeft[callN] := argN;
    isN := AllocNode(AN_IS_TEST);
    ASTLeft[isN] := callN;
    ASTIVal[isN] := ci;
    ASTTk[isN] := Ord(tyBoolean);
    if chain < 0 then chain := isN
    else
    begin
      lit := AllocNode(AN_BINOP);
      ASTIVal[lit] := Ord(tkOr);
      ASTLeft[lit] := chain; ASTRight[lit] := isN;
      ASTTk[lit] := Ord(tyBoolean);
      chain := lit;
    end;
  end;
  if chain < 0 then Exit;
  tagArg := AllocNode(AN_ARG);
  ASTLeft[tagArg] := recvNode;
  tagCall := AllocNode(AN_CALL);
  ASTIVal[tagCall] := FindProc('pyvartag');
  if ASTIVal[tagCall] < 0 then Exit;
  ASTTk[tagCall] := Ord(tyInt64);
  ASTLeft[tagCall] := tagArg;
  lit := AllocNode(AN_INT_LIT);
  ASTIVal[lit] := VT_OBJECT;
  ASTTk[lit] := Ord(tyInt64);
  guard := AllocNode(AN_BINOP);
  ASTIVal[guard] := Ord(tkEq);
  ASTLeft[guard] := tagCall; ASTRight[guard] := lit;
  ASTTk[guard] := Ord(tyBoolean);
  Result := AllocNode(AN_BINOP);
  ASTIVal[Result] := Ord(tkAnd);
  ASTLeft[Result] := guard; ASTRight[Result] := chain;
  ASTTk[Result] := Ord(tyBoolean);
end;

{ `getattr(o, name)` / `hasattr(o, name)` where the NAME IS COMPUTED — the only
  reason to call getattr at all rather than writing `o.field`: a command
  dispatcher (`getattr(self, "do_" + verb)`), a plugin table, a serializer
  walking field names. It used to be refused outright ("needs a literal
  attribute name") because the literal path answers from the receiver's
  DECLARED fields at compile time, which a runtime string cannot do.

  Nothing new was needed underneath: `pydynattr_get_v` already resolves a name
  at run time against the dynamic-attribute store, the class's DECLARED fields
  (via RTTI) and its METHODS — returning a bound pair for the last — and raises
  CPython's AttributeError otherwise, with `pydynattr_has_v` as its predicate.
  Those exist for a VARIANT receiver whose class is only known at run time,
  which is exactly the position a computed name puts every receiver in.

  The three-argument `getattr(o, n, d)` is has ? get : d, so a miss yields the
  default rather than raising — CPython's rule, and the same shape the literal
  path already builds for its own default case.
  feature-nilpy-getattr-with-a-computed-attribute-name }
function PyMakeDynAttrByExpr(recvNode, nameNode, dfltNode: Integer;
                             wantHas: Boolean): Integer;
var vRecv, a0, a1, getCall, hasCall, pairNode: Integer;

  function CallWith(const pname: AnsiString; tk: TTypeKind): Integer;
  var pi: Integer;
  begin
    pi := FindProc(pname);
    if pi < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
    a0 := AllocNode(AN_ARG);
    ASTLeft[a0] := vRecv;
    a1 := AllocNode(AN_ARG);
    ASTLeft[a1] := nameNode;
    ASTRight[a1] := -1;
    ASTRight[a0] := a1;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := pi;
    ASTTk[Result] := Ord(tk);
    ASTLeft[Result] := a0;
  end;

begin
  vRecv := PyForceVariant(recvNode);
  { read once: the has/get pair below reads both operands twice }
  if (dfltNode >= 0) or wantHas then vRecv := PyEvalOnce(vRecv);
  if wantHas then
  begin
    Result := CallWith('pydynattr_has_any_v', tyBoolean);
    Exit;
  end;
  if dfltNode < 0 then
  begin
    Result := CallWith('pydynattr_get_v', tyVariant);
    Exit;
  end;
  hasCall := CallWith('pydynattr_has_any_v', tyBoolean);
  nameNode := PyEvalOnce(nameNode);
  getCall := CallWith('pydynattr_get_v', tyVariant);
  pairNode := AllocNode(AN_PAIR);
  ASTLeft[pairNode] := getCall;
  ASTRight[pairNode] := dfltNode;
  Result := AllocNode(AN_TERNARY);
  ASTLeft[Result] := hasCall;
  ASTRight[Result] := pairNode;
  ASTTk[Result] := Ord(tyVariant);
end;

{ Reads the string-literal attribute name; CurTok is the ',' before it. }
function PyParseAttrName: AnsiString;
begin
  Expect(tkComma, ',');
  if CurTok.Kind <> tkString then
    Error('Nil Python: hasattr/getattr needs a literal attribute name');
  Result := CurTok.SVal;
  Next;
end;

{ Is the token stream at `int.from_bytes(` ? CurTok is the `int` ident. }
function PyIsFromBytesAhead: Boolean;
begin
  Result := (CurTok.Kind = tkIdent) and (LowerCase(CurTok.SVal) = 'int') and
            (TokPos + 1 < TokCount) and (Tokens[TokPos].Kind = tkDot) and
            (Tokens[TokPos + 1].Kind = tkIdent) and
            (LowerCase(GetTokenStr(TokPos + 1)) = 'from_bytes');
end;

{ `v.field` (READ) where `v` is a VARIANT: unbox to the class that declares the
  field and read it. Returns -1 when no class declares the name. }
{ Read `<class>.field` off a variant: unbox to that class and read. }
function PyVariantFieldArm(baseNode, ci, fi: Integer;
                           const fname: AnsiString): Integer;
var unboxArg, unboxCall, castNode: Integer;
begin
  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := baseNode;
  unboxCall := AllocNode(AN_CALL);
  ASTIVal[unboxCall] := FindProc('pyvarobj');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;
  castNode := AllocNode(AN_CLASS_CAST);
  ASTLeft[castNode] := unboxCall;
  ASTIVal[castNode] := ci;
  ASTTk[castNode]   := Ord(tyClass);
  Result := AllocNode(AN_FIELD);
  ASTLeft[Result] := castNode;
  ASTSOffset[Result] := PyStoredName(fname);
  ASTSLen[Result] := Length(fname);
  ASTTk[Result] := UFldTk[fi];
end;

{ `v.prop` where `v` is a VARIANT and `prop` is a PROPERTY (a Python @property
  with its @prop.setter) rather than a field: unbox the slot and hard-cast it to
  the class that declares the property, so the CLASS-TYPED member path — which
  is the only one that knows how to route a read to the getter and a write to
  the setter — takes it from there. Returns the cast receiver node, or -1 when
  no class declares such a property. `ci` reports the class chosen.

  Without this the name reached no property machinery at all: no class declares
  a FIELD of that name (a property has no field), so the access fell through to
  the DYNAMIC-ATTRIBUTE store, and `v.compiling = True` wrote into pydynattr's
  side table while the getter went on reading `self._compiling`. The write was
  silently DROPPED — no setter call, no diagnostic, and the getter still worked,
  which is what made it read as a stale-read bug rather than a lost write.
  uforth's Forth STATE flag is exactly this shape, so every colon definition
  stayed in interpret mode and its body EXECUTED instead of compiling.
  bug-nilpy-property-setter-is-skipped-on-a-dynamically-typed-receiver

  Candidate choice mirrors the METHOD scan: a base and its subclasses are not
  ambiguous — they share the property, and a virtual accessor still dispatches
  to the override at run time — so the ROOT-most candidate is cast to. Two
  UNRELATED classes declaring the same property name cannot be told apart from
  the slot here, and guessing one is how a wrong layout gets read silently, so
  that is a diagnostic. }
function PyMakeVariantPropRecv(baseNode: Integer; const pname: AnsiString;
                               var ci: Integer): Integer;
var c, root, unboxArg, unboxCall: Integer;
begin
  Result := -1;
  ci := -1;
  root := -1;
  { A real FIELD of that name anywhere wins: the caller's field branch resolves
    it (with runtime dispatch across differing layouts), and that is the
    field-before-dynattr precedence every other member path follows. Checked
    here rather than at the call site so ONE place decides which of the two
    claims the name. }
  for c := 0 to UClsCount - 1 do
    if (not UClsIsRecord[c]) and (FindUField(c, pname) >= 0) then Exit;
  for c := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[c] then Continue;
    if FindUProp(c, pname) < 0 then Continue;
    if root < 0 then root := c
    else if IsSubclassOf(root, c) then root := c        { c is the more basic }
    else if not IsSubclassOf(c, root) then
      Error('Nil Python: .' + pname + ' on a dynamically-typed value is '
            + 'ambiguous (several unrelated classes declare that property) — '
            + 'assign to an annotated local first');
  end;
  if root < 0 then Exit;

  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := baseNode;
  unboxCall := AllocNode(AN_CALL);
  ASTIVal[unboxCall] := FindProc('pyvarobj');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;
  Result := AllocNode(AN_CLASS_CAST);
  ASTLeft[Result] := unboxCall;
  ASTIVal[Result] := root;
  ASTTk[Result]   := Ord(tyClass);
  ci := root;
end;

{ Force a node to Variant. A scalar goes through pyvar_id, whose parameter is a
  const Variant, so the ordinary call-argument boxing does the work. }
function PyForceVariant(node: Integer): Integer;
var argNode: Integer;
begin
  if IntToTypeKind(ASTTk[node]) = tyVariant then
  begin
    PyForceVariant := node;
    Exit;
  end;
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := node;
  ASTRight[argNode] := -1;
  PyForceVariant := AllocNode(AN_CALL);
  ASTIVal[PyForceVariant] := FindProc('pyvar_id');
  if ASTIVal[PyForceVariant] < 0 then Error('Nil Python: pylib (pyvar_id) not loaded');
  ASTTk[PyForceVariant] := Ord(tyVariant);
  ASTLeft[PyForceVariant] := argNode;
end;

{ `v.field` (READ) where `v` is a VARIANT: unbox to the class that declares the
  field and read it. Returns -1 when no class declares the name.

  When SEVERAL classes declare it and they disagree on offset or type, the class
  is decided at RUN TIME — one `pyvarobj(v) is C ? <read as C> : ...` arm per
  candidate, which is exactly how a METHOD on a variant is dispatched
  (PyParseVariantMethod). This used to be refused outright, telling the
  application to annotate a local; `event.x` in a Tk callback is the shape, and
  tkinter's Event (Integer at 8) collides with any other class that has an `x`
  (songformatter's text object holds a Variant at 24). Refusing was safe but it
  asked the program to change, and the program is the thing being compiled.

  Arms are boxed to Variant when the candidates' field types differ, so the
  expression has ONE type whichever class turns up. }
function PyMakeVariantField(baseNode: Integer; const fname: AnsiString;
                            var tk: TTypeKind; var recName: Integer): Integer;
const MAX_FIELD_CANDIDATES = 16;
var ci, fi, i, n, armN, condN, pairN, tern, unboxArg, unboxCall: Integer;
    cands: array[0..MAX_FIELD_CANDIDATES - 1] of Integer;
    candFi: array[0..MAX_FIELD_CANDIDATES - 1] of Integer;
    sameShape: Boolean;
begin
  Result := -1;
  n := 0;
  for ci := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[ci] then Continue;
    fi := FindUField(ci, fname);
    if fi < 0 then Continue;
    if n < MAX_FIELD_CANDIDATES then
    begin
      cands[n] := ci;
      candFi[n] := fi;
      Inc(n);
    end;
  end;
  if n = 0 then Exit;

  sameShape := True;
  for i := 1 to n - 1 do
    if (UFldTk[candFi[i]] <> UFldTk[candFi[0]]) or
       (UFldOff_[candFi[i]] <> UFldOff_[candFi[0]]) then sameShape := False;

  if sameShape then
  begin
    { one layout: read it directly, exactly as before — no dispatch, and the
      emitted code for every program that already compiled is unchanged }
    Result := PyVariantFieldArm(baseNode, cands[0], candFi[0], fname);
    tk := IntToTypeKind(UFldTk[candFi[0]]);
    recName := UFldRec_[candFi[0]];
    Exit;
  end;

  { Several layouts: decide at run time. The LAST candidate is the fallback arm,
    so a receiver of none of these classes reads as that one did before —
    wrong, but no worse than the single-class guess this replaces, and the
    common case (a receiver that IS one of them) is now right. }
  Result := PyForceVariant(PyVariantFieldArm(baseNode, cands[n - 1],
                                             candFi[n - 1], fname));
  for i := n - 2 downto 0 do
  begin
    armN := PyForceVariant(PyVariantFieldArm(baseNode, cands[i], candFi[i], fname));
    { cond: pyvarobj(v) is <candidate> — the test isinstance lowers to }
    unboxArg := AllocNode(AN_ARG);
    ASTLeft[unboxArg] := baseNode;
    unboxCall := AllocNode(AN_CALL);
    ASTIVal[unboxCall] := FindProc('pyvarobj');
    if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
    ASTTk[unboxCall] := Ord(tyPointer);
    ASTLeft[unboxCall] := unboxArg;
    condN := AllocNode(AN_IS_TEST);
    ASTLeft[condN] := unboxCall;
    ASTIVal[condN] := cands[i];
    ASTTk[condN] := Ord(tyBoolean);

    pairN := AllocNode(AN_PAIR);
    ASTLeft[pairN] := armN;
    ASTRight[pairN] := Result;
    tern := AllocNode(AN_TERNARY);
    ASTLeft[tern] := condN;
    ASTRight[tern] := pairN;
    ASTTk[tern] := Ord(tyVariant);
    Result := tern;
  end;
  tk := tyVariant;
  recName := REC_NONE;
end;

{ A synthetic call signature: nArgs Variant params, Variant result, no body.
  Used for a DYNAMIC call through a value whose callable type is not known
  statically — `ns["__body__"]()`, where the dict holds a callable. Registered
  once per arity and reused. }
function PyDynCallSig(nArgs: Integer): Integer;
var pNames: array[0..15] of AnsiString; pTypes: array[0..15] of TTypeKind;
    i: Integer;
begin
  if nArgs > 15 then Error('Nil Python: too many arguments in a dynamic call');
  for i := 0 to nArgs - 1 do
  begin
    pNames[i] := '$dynarg';   { param names are irrelevant to a call signature }
    pTypes[i] := tyVariant;
  end;
  Result := RegisterProc('$pydyn', True, tyVariant, nArgs, pNames, pTypes);
  Procs[Result].BodyAddr := -1;
end;

{ Wrap a 1-arg dynamic call so a VT_PYCLOSURE callee routes to pyeval's reverse
  bridge instead of being unboxed as a code pointer. Builds
  `pyvartag(callee)=9 ? PyClosureCall1(callee, arg) : <defCall>`. calleeNode is
  the callee variant; argExpr is the single argument expression; defCall is the
  already-built AN_CALL_IND fast path. }
function PyWrapClosureDynCall(calleeNode, argExpr, defCall: Integer): Integer;
var tagCall, tagArg, nineLit, guard, clArgC, clArgA, thenCall, pair, tern: Integer;
    tagPi, callPi: Integer;
begin
  tagPi := FindProc('pyvartag');
  callPi := FindProc('PyClosureCall1');
  if (tagPi < 0) or (callPi < 0) then
  begin PyWrapClosureDynCall := defCall; Exit; end;

  { pyvartag(callee) }
  tagArg := AllocNode(AN_ARG); ASTLeft[tagArg] := calleeNode; ASTRight[tagArg] := -1;
  tagCall := AllocNode(AN_CALL);
  ASTIVal[tagCall] := tagPi; ASTLeft[tagCall] := tagArg; ASTTk[tagCall] := Ord(tyInt64);

  nineLit := AllocNode(AN_INT_LIT);
  ASTIVal[nineLit] := 9; ASTTk[nineLit] := Ord(tyInt64);

  guard := AllocNode(AN_BINOP); ASTIVal[guard] := Ord(tkEq);
  ASTLeft[guard] := tagCall; ASTRight[guard] := nineLit; ASTTk[guard] := Ord(tyBoolean);

  { PyClosureCall1(callee, arg) }
  clArgA := AllocNode(AN_ARG); ASTLeft[clArgA] := argExpr; ASTRight[clArgA] := -1;
  clArgC := AllocNode(AN_ARG); ASTLeft[clArgC] := calleeNode; ASTRight[clArgC] := clArgA;
  thenCall := AllocNode(AN_CALL);
  ASTIVal[thenCall] := callPi; ASTLeft[thenCall] := clArgC; ASTTk[thenCall] := Ord(tyVariant);

  pair := AllocNode(AN_PAIR);
  ASTLeft[pair] := thenCall; ASTRight[pair] := defCall;
  tern := AllocNode(AN_TERNARY);
  ASTLeft[tern] := guard; ASTRight[tern] := pair; ASTTk[tern] := Ord(tyVariant);
  PyWrapClosureDynCall := tern;
end;

{ Wrap a 1-arg call through a Callable/Pointer FIELD (`word.native(vm2)`) so a
  field holding a pyeval closure object routes to the pointer-form reverse bridge.
  The field pointer holds either a real compiled function address (uforth's own
  `w_plus`) or a closure object (uforth's VARIABLE/CONSTANT words, whose native is
  a captured PYTHON `def`); pyclosure_is tells them apart at runtime. Builds
  `pyclosure_is(field) ? pyclosure_call_ptr(field, arg) : <defCall>`. fieldNode is
  the field read (side-effect-free, so re-used across guard and arms); argExpr the
  single argument; defCall the already-built AN_CALL_IND. }
function PyWrapClosureFieldCall(fieldNode, argExpr, defCall: Integer): Integer;
var isArg, isCall, clArgP, clArgA, thenCall, pair, tern: Integer;
    isPi, callPi: Integer;
    bfIsPi, bfCallPi, bfIsArg, bfIsCall, bfArgA, bfArgP, bfCall: Integer;
begin
  isPi := FindProc('pyclosure_is');
  callPi := FindProc('pyclosure_call_ptr');
  if (isPi < 0) or (callPi < 0) then
  begin PyWrapClosureFieldCall := defCall; Exit; end;

  isArg := AllocNode(AN_ARG); ASTLeft[isArg] := fieldNode; ASTRight[isArg] := -1;
  isCall := AllocNode(AN_CALL);
  ASTIVal[isCall] := isPi; ASTLeft[isCall] := isArg; ASTTk[isCall] := Ord(tyBoolean);

  clArgA := AllocNode(AN_ARG); ASTLeft[clArgA] := argExpr; ASTRight[clArgA] := -1;
  clArgP := AllocNode(AN_ARG); ASTLeft[clArgP] := fieldNode; ASTRight[clArgP] := clArgA;
  thenCall := AllocNode(AN_CALL);
  ASTIVal[thenCall] := callPi; ASTLeft[thenCall] := clArgP; ASTTk[thenCall] := Ord(tyInteger);

  { middle branch: a BOUND COMPILED FN (captures-only nested def as a value —
    uforth's MARKER restore) — pyboundfn_is ? pyboundfn_call_ptr : defCall }
  bfIsPi := FindProc('pyboundfn_is');
  bfCallPi := FindProc('pyboundfn_call_ptr');
  if (bfIsPi >= 0) and (bfCallPi >= 0) then
  begin
    bfIsArg := AllocNode(AN_ARG); ASTLeft[bfIsArg] := fieldNode; ASTRight[bfIsArg] := -1;
    bfIsCall := AllocNode(AN_CALL);
    ASTIVal[bfIsCall] := bfIsPi; ASTLeft[bfIsCall] := bfIsArg; ASTTk[bfIsCall] := Ord(tyBoolean);
    bfArgA := AllocNode(AN_ARG); ASTLeft[bfArgA] := argExpr; ASTRight[bfArgA] := -1;
    bfArgP := AllocNode(AN_ARG); ASTLeft[bfArgP] := fieldNode; ASTRight[bfArgP] := bfArgA;
    bfCall := AllocNode(AN_CALL);
    ASTIVal[bfCall] := bfCallPi; ASTLeft[bfCall] := bfArgP; ASTTk[bfCall] := Ord(tyInteger);
    pair := AllocNode(AN_PAIR);
    ASTLeft[pair] := bfCall; ASTRight[pair] := defCall;
    tern := AllocNode(AN_TERNARY);
    ASTLeft[tern] := bfIsCall; ASTRight[tern] := pair; ASTTk[tern] := Ord(tyInteger);
    defCall := tern;
  end;

  pair := AllocNode(AN_PAIR);
  ASTLeft[pair] := thenCall; ASTRight[pair] := defCall;
  tern := AllocNode(AN_TERNARY);
  ASTLeft[tern] := isCall; ASTRight[tern] := pair; ASTTk[tern] := Ord(tyInteger);
  PyWrapClosureFieldCall := tern;
end;

{ `g = lambda ...` — box the lambda's value so the NAME is typed tyVariant.
  Both lambda lowerings hand back a heap OBJECT pointer (a pyeval closure, or a
  lifted bound-fn), and a pointer-typed local never reaches ParsePostfix's
  dynamic-call path, which keys on tyVariant — so `g(5)` compiled to nothing at
  all. Returns the node unchanged for anything that is not one of those calls;
  argument positions are deliberately untouched, since a callee's `const x:
  Variant` parameter already boxes the pointer for them. }
function PyBoxCallableValue(node: Integer): Integer;
var pi, boxPi: Integer; nm: AnsiString;
begin
  PyBoxCallableValue := node;
  if node < 0 then Exit;
  if ASTKind[node] <> AN_CALL then Exit;
  if IntToTypeKind(ASTTk[node]) <> tyPointer then Exit;
  pi := ASTIVal[node];
  if pi < 0 then Exit;
  nm := LowerCase(Procs[pi].Name);
  if (nm <> 'pyclosure_src_new') and (nm <> 'pyclosure_src_cap') and
     (nm <> 'pyclosure_setarity') and
     (nm <> 'pyboundfn_new') and (nm <> 'pyboundfn_bind') and
     (nm <> 'pyboundfn_setown') and (nm <> 'pyboundfn_setdefaults') and
     (nm <> 'pyboundfn_setstar') and (nm <> 'pyboundfn_setsig') and
     (nm <> 'pyboundfn_bind_var') and (nm <> 'pyboundfn_bind_obj') and
     (nm <> 'pyboundfn_bind_cell') then Exit;
  if PxxDbgEnabled('n.bfn') then
    WriteLn('PXXDBG n.bfn box via ', nm);
  boxPi := FindProc('pyvar_of_callable');
  if boxPi < 0 then Exit;
  pi := AllocNode(AN_ARG);
  ASTLeft[pi] := node; ASTRight[pi] := -1;
  PyBoxCallableValue := AllocNode(AN_CALL);
  ASTIVal[PyBoxCallableValue] := boxPi;
  ASTLeft[PyBoxCallableValue] := pi;
  ASTTk[PyBoxCallableValue] := Ord(tyVariant);
end;

{ Wrap a dynamic call so a FUNCTION VALUE callee (VT_BOUNDMETHOD, tag 8 — what
  `f = some_def` / `f = obj.method` stores) routes to pybound_callv<n> instead of
  being unboxed as a code address. The payload of a tag-8 variant is the
  {code, recv} PAIR, so the plain indirect path jumped into the pair's own bytes,
  and a bound method needs its receiver prepended besides. Builds
  `pycallback_is(callee) ? pybound_callv<n>(callee, args...) : <defCall>`.

  calleeNode is re-used across the guard and the call, so this is only applied
  when re-reading it is free of side effects (a name or a field — the same rule
  PyWrapClosureDynCall/PyMakeTruthy follow). argsHead is the AN_ARG chain of the
  already-parsed arguments; those nodes are shared between the arms, which is
  safe because a ternary evaluates exactly one arm. }
function PyWrapBoundDynCall(calleeNode, argsHead, n, defCall: Integer): Integer;
var isArg, isCall, cArgs, cArg, thenCall, pair, tern, i, a: Integer;
    isPi, callPi: Integer;
    argNodes: array[0..2] of Integer;
begin
  PyWrapBoundDynCall := defCall;
  if n > 3 then Exit;
  if (ASTKind[calleeNode] <> AN_IDENT) and (ASTKind[calleeNode] <> AN_FIELD) then Exit;
  isPi := FindProc('pycallback_is');
  case n of
    0: callPi := FindProc('pybound_callv0');
    1: callPi := FindProc('pybound_callv1');
    2: callPi := FindProc('pybound_callv2');
  else callPi := FindProc('pybound_callv3');
  end;
  if (isPi < 0) or (callPi < 0) then Exit;

  { pycallback_is(callee) }
  isArg := AllocNode(AN_ARG); ASTLeft[isArg] := calleeNode; ASTRight[isArg] := -1;
  isCall := AllocNode(AN_CALL);
  ASTIVal[isCall] := isPi; ASTLeft[isCall] := isArg; ASTTk[isCall] := Ord(tyBoolean);

  { pybound_callv<n>(callee, a0..) — a FRESH AN_ARG chain over the same argument
    expressions; the defCall arm owns the original chain and the two must not
    share link fields. }
  a := argsHead; i := 0;
  while (a >= 0) and (i < n) do
  begin
    argNodes[i] := ASTLeft[a];
    a := ASTRight[a];
    Inc(i);
  end;
  cArgs := -1;
  for i := n - 1 downto 0 do
  begin
    cArg := AllocNode(AN_ARG);
    ASTLeft[cArg] := argNodes[i]; ASTRight[cArg] := cArgs;
    cArgs := cArg;
  end;
  cArg := AllocNode(AN_ARG);
  ASTLeft[cArg] := calleeNode; ASTRight[cArg] := cArgs;
  thenCall := AllocNode(AN_CALL);
  ASTIVal[thenCall] := callPi; ASTLeft[thenCall] := cArg; ASTTk[thenCall] := Ord(tyVariant);

  pair := AllocNode(AN_PAIR);
  ASTLeft[pair] := thenCall; ASTRight[pair] := defCall;
  tern := AllocNode(AN_TERNARY);
  ASTLeft[tern] := isCall; ASTRight[tern] := pair; ASTTk[tern] := Ord(tyVariant);
  PyWrapBoundDynCall := tern;
end;

{ `<value>(args)` where the value is a CLASS INSTANCE defining `__call__` --
  Python's callable-object protocol. Without this, a class instance followed
  by '(' produced either a hard parse error or (depending on the shape) a
  garbage value read off the instance pointer, never the method
  (bug-nilpy-dunder-protocols-ignored-fall-back-to-handle-arithmetic).
  Returns baseNode unchanged when the class has no `__call__`, so the caller
  falls through to whatever ordinarily happens to a class value followed by
  '(' (a parse error today — there is no other legitimate reading). CurTok is
  the '('; arbitrary arity, unlike PyCallMeth1/2's fixed 0/1/2 args. }
function PyMakeCallDunder(baseNode: Integer): Integer;
var ci, mmi, mpi, selfArg, lastArg, argNode, notCallablePi: Integer;
begin
  Result := baseNode;
  ci := ResolveNodeRec(baseNode);
  if ci < REC_UCLASS_BASE then Exit;
  mmi := FindUMeth(ci - REC_UCLASS_BASE, '__call__');
  Expect(tkLParen, '(');
  if mmi < 0 then
  begin
    { No `__call__`: consume the argument list (still evaluated, matching
      Python's own left-to-right argument evaluation before the TypeError)
      and raise a genuine runtime error -- a `try/except` around this must
      still compile and run its handler, the same reasoning as
      PyNotContainerError just above. }
    while CurTok.Kind <> tkRParen do
    begin
      PyParseBoolExpr;
      if not Eat(tkComma) then Break;
    end;
    Expect(tkRParen, ')');
    notCallablePi := FindProc('PyNotCallableError');
    if notCallablePi < 0 then Error('Nil Python: pylib (PyNotCallableError) not loaded');
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := notCallablePi;
    ASTTk[Result] := Ord(tyInteger);
    ASTLeft[Result] := -1;
    Exit;
  end;
  mpi := UMthProc_[mmi];
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := baseNode; ASTRight[selfArg] := -1;
  lastArg := selfArg;
  while CurTok.Kind <> tkRParen do
  begin
    PyParseBoolExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode; ASTRight[argNode] := -1;
    ASTRight[lastArg] := argNode;
    lastArg := argNode;
    if not Eat(tkComma) then Break;
  end;
  Expect(tkRParen, ')');
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := mpi;
  ASTTk[Result] := Ord(Procs[mpi].RetType);
  ASTRight[Result] := ProcRetRecId[mpi];
  ASTLeft[Result] := selfArg;
end;

{ `<value>(args)` where the value is a VARIANT holding a callable — the function
  `exec()` stored in a namespace dict, called as `ns["__body__"]()`. Unbox the
  variant to its payload (the code pointer) and emit an indirect call with a
  synthetic all-variant signature. CurTok is the '('. }
{ `fn(*args)` where `fn` is a callable VALUE — a parameter, a dict entry, a
  name bound to a def. Every other star arm keys on the CALLEE'S signature
  (expand into its slots, splice into its packing, dispatch by its arity), and
  a value has none at the call site, so the argument loop reached the `*` and
  reported "expected expression". This is the last piece of the plain decorator
  idiom: `def wrapper(*args): return fn(*args)`.

  The count is a RUN-TIME fact, so the lowering is the same shape
  PyStarForwardCall builds for a named callee — every slot read once into a
  hidden variant local, then one `pyvar_callv<n>` arm per arity folded into a
  ternary chain. listSym holds EVERY positional argument, written and spliced
  alike, which is what makes `fn(1, *xs)` and `fn(*xs, 9)` fall out for free.

  Four is the ceiling because that is where the dynamic bridge itself stops
  (pyvar_callv0..4); past it pystar_check_arity raises rather than picking an
  arm that would call the body with the wrong shape. }
function PyStarDynCall(baseNode, listSym: Integer): Integer;
var listCi, k, n, chkArg, a2, a3, callNode, argNode, elemNode, lastArg: Integer;
    slotSyms: array[0..3] of Integer;
    baseSym, asgn, lenNode, cntNode, condNode, pairNode, ternNode, dispPi: Integer;
begin
  Result := -1;
  listCi := FindUClass('TPyList');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  { the callee is read ONCE: it appears in all five arms, and unlike the plain
    dynamic call its base here may be an arbitrary expression }
  baseSym := AllocVar(PyHiddenName('dynfn'), tyVariant);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(baseSym);
  ASTRight[asgn] := baseNode;
  PyHoistStmt(asgn);

  chkArg := AllocNode(AN_ARG);
  ASTLeft[chkArg] := PyMakeIdent(listSym);
  a2 := AllocNode(AN_ARG);
  ASTLeft[a2] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a2]] := 0; ASTTk[ASTLeft[a2]] := Ord(tyInteger);
  a3 := AllocNode(AN_ARG);
  ASTLeft[a3] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a3]] := 4; ASTTk[ASTLeft[a3]] := Ord(tyInteger);
  ASTRight[a3] := -1;
  ASTRight[chkArg] := a2; ASTRight[a2] := a3;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := FindProc('pystar_check_arity');
  if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_check_arity) not loaded');
  ASTTk[callNode] := Ord(tyInteger);
  ASTLeft[callNode] := chkArg;
  PyHoistStmt(callNode);

  { pystar_arg yields None past the end, so every slot is safe to read whatever
    the actual count is — a ternary arm cannot carry hoisted setup, which is
    why the reads happen here and not inside the arms }
  for k := 0 to 3 do
  begin
    slotSyms[k] := AllocVar(PyHiddenName('dyna'), tyVariant);
    elemNode := AllocNode(AN_ARG);
    ASTLeft[elemNode] := PyMakeIdent(listSym);
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := AllocNode(AN_INT_LIT);
    ASTIVal[ASTLeft[argNode]] := k; ASTTk[ASTLeft[argNode]] := Ord(tyInteger);
    ASTRight[argNode] := -1;
    ASTRight[elemNode] := argNode;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := FindProc('pystar_arg');
    if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_arg) not loaded');
    ASTTk[callNode] := Ord(tyVariant);
    ASTLeft[callNode] := elemNode;
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(slotSyms[k]);
    ASTRight[asgn] := callNode;
    PyHoistStmt(asgn);
  end;

  for n := 0 to 4 do
  begin
    dispPi := FindProc('pyvar_callv' + AIntToStr(n));
    if dispPi < 0 then Break;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := dispPi;
    ASTTk[callNode] := Ord(tyVariant);
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := PyMakeIdent(baseSym);
    ASTRight[argNode] := -1;
    ASTLeft[callNode] := argNode;
    lastArg := argNode;
    for k := 0 to n - 1 do
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := PyMakeIdent(slotSyms[k]);
      ASTRight[argNode] := -1;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
    { the LOWEST arity is the final else, which the guard above has made safe }
    if n = 0 then
    begin
      Result := callNode;
      Continue;
    end;
    lenNode := PyCallMeth1(listCi, 'count', PyMakeIdent(listSym), -1);
    if lenNode < 0 then Error('Nil Python: pylib (TPyList.count) not loaded');
    cntNode := AllocNode(AN_INT_LIT);
    ASTIVal[cntNode] := n; ASTTk[cntNode] := Ord(tyInteger);
    condNode := AllocNode(AN_BINOP);
    ASTIVal[condNode] := Ord(tkEq);
    ASTLeft[condNode] := lenNode;
    ASTRight[condNode] := cntNode;
    ASTTk[condNode] := Ord(tyBoolean);
    pairNode := AllocNode(AN_PAIR);
    ASTLeft[pairNode] := callNode;
    ASTRight[pairNode] := Result;
    ternNode := AllocNode(AN_TERNARY);
    ASTLeft[ternNode] := condNode;
    ASTRight[ternNode] := pairNode;
    ASTTk[ternNode] := Ord(tyVariant);
    Result := ternNode;
  end;
end;

function PyMakeDynCall(baseNode: Integer): Integer;
var unboxArg, unboxCall, argsHead, lastArg, argNode, n, sigPi: Integer;
    starSym, starN: Integer;
    nmArg, nmLit, dispPi, dispArg: Integer; calleeNm: AnsiString;
    kwNamesSym, kwValsSym, kwLit, kwCnt, kwTail, kwN, kwPad, kwNone: Integer;
    kwName: AnsiString;
begin
  { the callee code address = the variant's payload as a pointer }
  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := baseNode;
  ASTRight[unboxArg] := -1;
  unboxCall := AllocNode(AN_CALL);
  { the CHECKED unbox: a nil payload (the name is None) raises TypeError instead
    of calling address 0 }
  ASTIVal[unboxCall] := FindProc('pyvar_callee_addr');
  if ASTIVal[unboxCall] >= 0 then
  begin
    { name the callee when it is a plain variable, so the message points at the
      culprit rather than at "object" }
    nmArg := AllocNode(AN_ARG);
    nmLit := AllocNode(AN_STR_LIT);
    if ASTKind[baseNode] = AN_IDENT then
      calleeNm := Syms[ASTIVal[baseNode]].Name
    else if ASTKind[baseNode] = AN_FIELD then
      calleeNm := PyRawName(ASTSOffset[baseNode], ASTSLen[baseNode])
    else if (TokPos >= 2) and (Tokens[TokPos - 2].Kind = tkIdent) then
      { last resort: the token right before the '(' — a subscript or call-result
        receiver has no name of its own, but the source text does }
      calleeNm := GetTokenStr(TokPos - 2)
    else
      calleeNm := '';
    ASTSOffset[nmLit] := PyStoredName(calleeNm);
    ASTSLen[nmLit] := Length(calleeNm);
    ASTTk[nmLit] := Ord(tyString);
    ASTLeft[nmArg] := nmLit;
    ASTRight[nmArg] := -1;
    ASTRight[unboxArg] := nmArg;
  end
  else ASTIVal[unboxCall] := FindProc('pyvarobj');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;

  Expect(tkLParen, '(');
  argsHead := -1; lastArg := -1; n := 0;
  starSym := -1;
  kwNamesSym := -1; kwValsSym := -1;
  while CurTok.Kind <> tkRParen do
  begin
    { `fn(*xs)` through a callable VALUE. There is no signature here to expand
      into or pack for, so EVERY positional argument goes into one list and the
      arity is decided when the call runs (PyStarDynCall). The first star is
      what switches the loop over; arguments already parsed move into the list
      in order, so `fn(1, *xs, 9)` needs no separate handling. }
    if isNilPy and (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) then
    begin
      Next;                              { the '*' }
      PyParseBoolExpr;
      if starSym < 0 then
      begin
        starSym := PyNewContainerTemp('TPyList', 'dynargs');
        starN := argsHead;
        while starN >= 0 do
        begin
          PyContainerCall1(starSym, 'TPyList', 'append', ASTLeft[starN], -1);
          starN := ASTRight[starN];
        end;
        argsHead := -1; lastArg := -1;
      end;
      PyContainerCall1(starSym, 'TPyList', 'extend',
                       PyStarOperandAsList(CurASTNode, FindUClass('TPyList')), -1);
      Inc(n);
      if CurTok.Kind = tkComma then Next else Break;
      Continue;
    end;
    { `f(x, final=True)` through a callable VALUE. There is no callee here to
      resolve the name against at COMPILE time -- that is the whole difficulty,
      and it is why this used to fail as `undefined variable (final)`: the name
      was parsed as an ordinary expression because nothing had told the parser
      it was a parameter. So the name TRAVELS to run time, as a string, beside
      its value, and the dispatcher matches it against the callee's own
      parameter names out of the signature record.
      bug-n-a-keyword-argument-through-a-callable-value-is-undefined }
    if isNilPy and (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind = tkAssign) and (starSym < 0) then
    begin
      kwName := CurTok.SVal;
      Next;                              { the name }
      Next;                              { the '=' }
      PyParseBoolExpr;
      if kwNamesSym < 0 then
      begin
        kwNamesSym := PyNewContainerTemp('TPyList', 'dynkwn');
        kwValsSym := PyNewContainerTemp('TPyList', 'dynkwv');
      end;
      kwLit := AllocNode(AN_STR_LIT);
      ASTSOffset[kwLit] := PyStoredName(kwName);
      ASTSLen[kwLit] := Length(kwName);
      ASTTk[kwLit] := Ord(tyString);
      PyContainerCall1(kwNamesSym, 'TPyList', 'append', kwLit, -1);
      PyContainerCall1(kwValsSym, 'TPyList', 'append', CurASTNode, -1);
      if CurTok.Kind = tkComma then Next else Break;
      Continue;
    end;
    PyParseBoolExpr;
    if starSym >= 0 then
    begin
      PyContainerCall1(starSym, 'TPyList', 'append', CurASTNode, -1);
      Inc(n);
      if CurTok.Kind = tkComma then Next else Break;
      Continue;
    end;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTRight[argNode] := -1;
    if argsHead = -1 then argsHead := argNode else ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(n);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  Expect(tkRParen, ')');
  if starSym >= 0 then
  begin
    Result := PyStarDynCall(baseNode, starSym);
    Exit;
  end;

  { ONE runtime dispatcher when pyeval offers it — and for a .npy program it
    always does. pyvar_callv<n>(callee, args...) tells the four callable shapes
    apart ITSELF (see its comment in pyeval.pas), replacing unbox-then-indirect
    plus a stack of compile-time tag guesses. It is also what makes a LAMBDA
    bound to a name callable: a lambda's value is a closure or bound-fn OBJECT,
    which no tag guard recognised. Arities past 3 keep the old lowering. }
  { KEYWORDS: one dispatcher, fixed arity, positional slots padded with None so
    the callee's own arity decides how many are read. }
  if kwNamesSym >= 0 then
  begin
    dispPi := FindProc('pyvar_callv_kw');
    if (dispPi < 0) or (n > 4) then
      Error('Nil Python: a keyword argument through a callable value needs '
            + 'pyvar_callv_kw (pyeval) and at most 4 positional arguments');
    dispArg := AllocNode(AN_ARG);
    ASTLeft[dispArg] := baseNode;
    kwLit := AllocNode(AN_ARG);
    kwCnt := AllocNode(AN_INT_LIT);
    ASTIVal[kwCnt] := n; ASTTk[kwCnt] := Ord(tyInt64);
    ASTLeft[kwLit] := kwCnt;
    ASTRight[dispArg] := kwLit;
    kwTail := kwLit;
    kwN := argsHead;
    while kwN >= 0 do
    begin
      ASTRight[kwTail] := kwN;
      kwTail := kwN;
      kwN := ASTRight[kwN];
    end;
    for kwPad := n to 3 do
    begin
      kwNone := AllocNode(AN_CALL);
      ASTIVal[kwNone] := FindProc('pynone');
      ASTLeft[kwNone] := -1;
      ASTTk[kwNone] := Ord(tyVariant);
      kwN := AllocNode(AN_ARG);
      ASTLeft[kwN] := kwNone;
      ASTRight[kwTail] := kwN;
      kwTail := kwN;
    end;
    kwN := AllocNode(AN_ARG);
    ASTLeft[kwN] := PyMakeIdent(kwNamesSym);
    ASTRight[kwTail] := kwN; kwTail := kwN;
    kwN := AllocNode(AN_ARG);
    ASTLeft[kwN] := PyMakeIdent(kwValsSym);
    ASTRight[kwN] := -1;
    ASTRight[kwTail] := kwN;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := dispPi;
    ASTLeft[Result] := dispArg;
    ASTTk[Result] := Ord(tyVariant);
    Exit;
  end;

  dispPi := -1;
  if n = 0 then dispPi := FindProc('pyvar_callv0')
  else if n = 1 then dispPi := FindProc('pyvar_callv1')
  else if n = 2 then dispPi := FindProc('pyvar_callv2')
  else if n = 3 then dispPi := FindProc('pyvar_callv3')
  { …and FOUR. Past this the old lowering still applies, and it calls through
    the callee's payload as a code address — correct for a plain def, a SEGFAULT
    for a lambda (whose value is a closure OBJECT).
    bug-nilpy-a-four-parameter-lambda-segfaults-when-called }
  else if n = 4 then dispPi := FindProc('pyvar_callv4');
  if dispPi >= 0 then
  begin
    dispArg := AllocNode(AN_ARG);
    ASTLeft[dispArg] := baseNode;
    ASTRight[dispArg] := argsHead;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := dispPi;
    ASTLeft[Result] := dispArg;
    ASTTk[Result] := Ord(tyVariant);
    Exit;
  end;

  sigPi := PyDynCallSig(n);
  Result := AllocNode(AN_CALL_IND);
  ASTLeft[Result]  := argsHead;
  ASTRight[Result] := unboxCall;         { code address }
  ASTIVal[Result]  := sigPi;
  ASTTk[Result]    := Ord(tyVariant);
  ASTSLen[Result]  := 0;                 { plain proc pointer, no Self }

  { Reverse bridge for pyeval closures. `word.native(vm2)` may hold either a
    compiled NilPy function value (a raw proc address — the default AN_CALL_IND
    above) OR a pyeval closure captured from a PYTHON block's nested `def`
    (uforth's VARIABLE/CONSTANT words). The latter is boxed as a VT_PYCLOSURE
    (tag 9) whose payload is a closure index, not a code pointer, so unboxing it
    as an address would crash. Branch at runtime: tag 9 -> PyClosureCall1;
    everything else -> the fast indirect call. Only the 1-arg shape is emitted
    (every uforth native word is `native(vm)`); other arities keep the plain
    path. baseNode is re-used across the guard and both arms — it is a field/var
    read here, so evaluating it more than once is safe (same idiom as
    PyMakeTruthy / PyMakeBoolOpValue). }
  { A function VALUE (tag 8) reaches the same place with a {code, recv} pair
    payload — see PyWrapBoundDynCall. Applied first so the closure guard, when
    it fires, wraps the whole thing. }
  Result := PyWrapBoundDynCall(baseNode, argsHead, n, Result);

  if n = 1 then
    Result := PyWrapClosureDynCall(baseNode, ASTLeft[argsHead], Result);
end;

{ Wrap a call through a `Callable[...]`-annotated PARAMETER so a heap callable
  works. The annotation registers a $proctype signature and the call lowers to a
  typed INDIRECT call — correct for a compiled def, fatal for a lambda or a
  closure, whose value is an OBJECT pointer: the call jumped into the object's
  own bytes. Builds `pycallable_obj_is(f) ? pyvar_callv<n>(f, args...) :
  <the indirect call>`, so the fast path is untouched and the object path goes
  to the same universal dispatcher a variant callee already uses
  (bug-nilpy-callable-annotated-param-segfaults-on-a-heap-callable).

  calleeNode is re-read across the guard and both arms — it is a plain variable
  here, so evaluating it twice is free of side effects (the same rule
  PyWrapClosureFieldCall / PyMakeTruthy follow). Returns defCall unchanged for
  arities past 3 or when pylib is not loaded. }
function PyWrapHeapCallableCall(calleeNode, argsHead, n, defCall: Integer): Integer;
var isArg, isCall, dispArg, thenCall, pair, tern, isPi, dispPi: Integer;
begin
  PyWrapHeapCallableCall := defCall;
  if n > 3 then Exit;
  isPi := FindProc('pycallable_obj_is');
  if isPi < 0 then Exit;
  dispPi := -1;
  if n = 0 then dispPi := FindProc('pyvar_callv0')
  else if n = 1 then dispPi := FindProc('pyvar_callv1')
  else if n = 2 then dispPi := FindProc('pyvar_callv2')
  else if n = 3 then dispPi := FindProc('pyvar_callv3')
  { …and FOUR. Past this the old lowering still applies, and it calls through
    the callee's payload as a code address — correct for a plain def, a SEGFAULT
    for a lambda (whose value is a closure OBJECT).
    bug-nilpy-a-four-parameter-lambda-segfaults-when-called }
  else if n = 4 then dispPi := FindProc('pyvar_callv4');
  if dispPi < 0 then Exit;

  isArg := AllocNode(AN_ARG); ASTLeft[isArg] := calleeNode; ASTRight[isArg] := -1;
  isCall := AllocNode(AN_CALL);
  ASTIVal[isCall] := isPi; ASTLeft[isCall] := isArg; ASTTk[isCall] := Ord(tyBoolean);

  dispArg := AllocNode(AN_ARG);
  ASTLeft[dispArg] := calleeNode;
  ASTRight[dispArg] := argsHead;
  thenCall := AllocNode(AN_CALL);
  ASTIVal[thenCall] := dispPi; ASTLeft[thenCall] := dispArg;
  ASTTk[thenCall] := Ord(tyVariant);

  pair := AllocNode(AN_PAIR);
  ASTLeft[pair] := thenCall; ASTRight[pair] := defCall;
  tern := AllocNode(AN_TERNARY);
  ASTLeft[tern] := isCall; ASTRight[tern] := pair; ASTTk[tern] := Ord(tyVariant);
  PyWrapHeapCallableCall := tern;
end;

{ `obj.method` used as a VALUE (no following call): capture it as a bound-method
  variant so the receiver is not dropped. pybound_new(@method, self) boxes
  {code, recv}; the receiver is passed by ADDRESS-as-value (an object reference is
  already a pointer). See feature-nilpy-bound-method-value: uforth's exec env
  binds `self.push`/`self.pop` this way. mpi is the method proc (param 0 = Self);
  selfNode supplies the receiver. }
function PyMakeBoundMethod(mpi, selfNode: Integer): Integer;
var procAddr, recvArg, selfArg, callNode, boundPi, isFuncNode, isFuncArg: Integer;
    starIdx, starNode, starArg, sigNode, sigArg: Integer;
begin
  { `*args` on a METHOD is recorded in SIGNATURE space (Self at 0); the runtime
    bridge is handed the receiver separately, so it wants the callee's own
    index. See PyMakeFuncValueFor for the same conversion on a plain def. }
  starIdx := -1;
  if (mpi >= 0) and (mpi < ProcCount) and (ProcPyStarIdx[mpi] > 0) then
    starIdx := ProcPyStarIdx[mpi] - 1;
  boundPi := FindProc('pybound_new_sig');
  if boundPi < 0 then
  begin
    if starIdx >= 0 then boundPi := FindProc('pybound_new_star')
    else boundPi := FindProc('pybound_new');
  end;
  if boundPi < 0 then Error('Nil Python: pylib (pybound_new) not loaded');
  procAddr := AllocNode(AN_PROCADDR);
  ASTIVal[procAddr] := mpi;
  ASTTk[procAddr]   := Ord(tyPointer);
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := boundPi;
  ASTTk[callNode]   := Ord(tyVariant);
  selfArg := AllocNode(AN_ARG);  ASTLeft[selfArg] := procAddr;   { code }
  recvArg := AllocNode(AN_ARG);  ASTLeft[recvArg] := selfNode;   { recv }
  { isFunc: whether mpi is a genuine Variant-returning function or a real
    procedure (explicit `-> None`) — lets pybound_callv*/pycallback_call*
    pick the matching call shape at runtime instead of always assuming a
    function (bug-nilpy-void-def-assigned-and-called-crashes). }
  isFuncNode := AllocNode(AN_INT_LIT);
  ASTIVal[isFuncNode] := Ord(Procs[mpi].IsFunc);
  ASTTk[isFuncNode]   := Ord(tyBoolean);
  isFuncArg := AllocNode(AN_ARG); ASTLeft[isFuncArg] := isFuncNode;
  ASTRight[selfArg] := recvArg;  ASTRight[recvArg] := isFuncArg;
  ASTRight[isFuncArg] := -1;
  if (starIdx >= 0) or (Procs[boundPi].ParamCount = 5) then
  begin
    starNode := AllocNode(AN_INT_LIT);
    ASTIVal[starNode] := starIdx;
    ASTTk[starNode]   := Ord(tyInt64);
    starArg := AllocNode(AN_ARG); ASTLeft[starArg] := starNode;
    ASTRight[starArg] := -1;
    ASTRight[isFuncArg] := starArg;
  end;
  { ...and the callee's SIGNATURE, so `h = k.m; h(10)` can fill `b=5` the way
    `k.m(10)` does. EmitPySignatures already excludes Self from the record, so
    the receiver being passed separately needs no adjustment here.
    feature-n-a-callable-value-carries-its-signature-type }
  if Procs[boundPi].ParamCount = 5 then
  begin
    sigNode := AllocNode(AN_PYSIGREF);
    ASTIVal[sigNode] := mpi;
    ASTTk[sigNode]   := Ord(tyPointer);
    sigArg := AllocNode(AN_ARG); ASTLeft[sigArg] := sigNode;
    ASTRight[sigArg] := -1;
    ASTRight[starArg] := sigArg;
  end;
  ASTLeft[callNode] := selfArg;
  Result := callNode;
end;

{ `v.field(args)` where `v` is a VARIANT and `field` holds a function value:
  unbox to the owning class, read the field, call through it. }
{ ONE arm of a variant field CALL: unbox the receiver, hard-cast it to `ci`,
  read the field and call through it with the ALREADY-PARSED argument list.
  Split out of PyMakeVariantFieldCall so several candidate classes can each get
  an arm over the same arguments — see there. }
function PyVariantFieldCallArm(baseNode, ci: Integer; const fname: AnsiString;
                               sigPi, argsHead, n: Integer): Integer;
var unboxArg, unboxCall, castNode, fieldNode: Integer;
    fldFi, fldTk, dispPi, dispArg: Integer;
begin
  fldFi := FindUField(ci, fname);
  fldTk := Ord(tyPointer);
  if fldFi >= 0 then fldTk := UFldTk[fldFi];
  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := baseNode;
  unboxCall := AllocNode(AN_CALL);
  ASTIVal[unboxCall] := FindProc('pyvarobj');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;
  castNode := AllocNode(AN_CLASS_CAST);
  ASTLeft[castNode] := unboxCall;
  ASTIVal[castNode] := ci;
  ASTTk[castNode]   := Ord(tyClass);
  fieldNode := AllocNode(AN_FIELD);
  ASTLeft[fieldNode] := castNode;
  ASTSOffset[fieldNode] := PyStoredName(fname);
  ASTSLen[fieldNode] := Length(fname);
  ASTTk[fieldNode] := fldTk;

  { A `Callable[...]` FIELD is a VARIANT now (PyAnnTypeAt), so the slot may hold
    any of the four callable shapes and the ONE thing that tells them apart is
    pyvar_callv<n> — the same universal dispatcher a variant callee already
    uses. Reading the slot as a bare code address is what jumped through the
    variant's TAG word (PC = 10 = VT_BOUNDFN_TAG) the moment the field held a
    lifted closure instead of a plain def.
    bug-nilpy-closure-stored-in-a-callable-field-jumps-through-the-variant-tag

    The typed-indirect lowering below stays for a genuinely POINTER-typed
    procedural field (a Pascal/C record's function pointer reached through a
    variant receiver), which really does hold a bare address. }
  if IntToTypeKind(fldTk) = tyVariant then
  begin
    dispPi := -1;
    if n = 0 then dispPi := FindProc('pyvar_callv0')
    else if n = 1 then dispPi := FindProc('pyvar_callv1')
    else if n = 2 then dispPi := FindProc('pyvar_callv2')
    else if n = 3 then dispPi := FindProc('pyvar_callv3')
  { …and FOUR. Past this the old lowering still applies, and it calls through
    the callee's payload as a code address — correct for a plain def, a SEGFAULT
    for a lambda (whose value is a closure OBJECT).
    bug-nilpy-a-four-parameter-lambda-segfaults-when-called }
  else if n = 4 then dispPi := FindProc('pyvar_callv4');
    if dispPi >= 0 then
    begin
      dispArg := AllocNode(AN_ARG);
      ASTLeft[dispArg] := fieldNode;
      ASTRight[dispArg] := argsHead;
      Result := AllocNode(AN_CALL);
      ASTIVal[Result] := dispPi;
      ASTLeft[Result] := dispArg;
      ASTTk[Result] := Ord(tyVariant);
      Exit;
    end;
  end;

  if sigPi < 0 then
    Error('Nil Python: .' + fname + '() — a callable field with no signature '
          + 'must be variant-typed to be called on a dynamically-typed value');
  Result := AllocNode(AN_CALL_IND);
  ASTLeft[Result]  := argsHead;
  ASTRight[Result] := fieldNode;
  ASTIVal[Result]  := sigPi;
  ASTTk[Result]    := Ord(Procs[sigPi].RetType);
  ASTSLen[Result]  := 0;

  { A Callable field may hold a pyeval closure (uforth's VARIABLE/CONSTANT native
    words) rather than a compiled function address; branch at runtime. Only the
    1-arg `-> None` shape (every uforth native word: `native(vm)`) is wrapped. }
  if (n = 1) and (Procs[sigPi].RetType = tyInteger) then
    Result := PyWrapClosureFieldCall(fieldNode, ASTLeft[argsHead], Result);
end;

{ `v.field(args)` where `v` is a VARIANT and `field` holds a function value.

  Several classes may declare a field of that name, and they do NOT have to
  agree on its OFFSET — a signature never was a statement about layout. The old
  code hard-cast the receiver to whichever class the caller's scan settled on,
  so a dispatch table holding instances of two classes read the field at the
  wrong offset for one of them and jumped through whatever was there. The
  ambiguity check could not catch it either: it compared the candidates'
  SIGNATURES, and two classes can share a signature and still lay the field out
  differently.

  So the class is decided at RUN TIME — one `pyvarobj(v) is C ? <call as C> : ...`
  arm per candidate, which is exactly how the sibling METHOD path already
  dispatches (`dualCis` in the member scan) and how PyMakeVariantField reads a
  field whose candidates disagree. The LAST candidate is the fallback arm, so a
  receiver of none of these classes behaves as it did before rather than
  becoming a new error.

  The arguments are parsed ONCE and shared by every arm. Only one arm runs, so
  the duplication is code size and not repeated evaluation — the same shape
  PyWrapClosureFieldCall already builds around this call.
  bug-nilpy-dynamic-receiver-callable-field-casts-to-the-wrong-class }
function PyMakeVariantFieldCall(baseNode, ci: Integer; const fname: AnsiString;
                                sigPi: Integer): Integer;
const MAX_FCALL_CANDS = 16;
var argsHead, lastArg, argNode, n, i, nc: Integer;
    armN, condN, pairN, tern, unboxArg, unboxCall: Integer;
    cands: array[0..MAX_FCALL_CANDS - 1] of Integer;
    sigs: array[0..MAX_FCALL_CANDS - 1] of Integer;
    c, fi: Integer;
begin
  { every class that declares this name as a CALLABLE field — a recorded
    procedural signature, or a variant slot (a plain class's Callable field) }
  nc := 0;
  for c := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[c] then Continue;
    fi := FindUField(c, fname);
    if fi < 0 then Continue;
    if (UFldProcSig[fi] < 0) and (IntToTypeKind(UFldTk[fi]) <> tyVariant) then Continue;
    { the INTRODUCER only: a parent that declares it already covers the subclass,
      and its cast reaches the same slot }
    if (UClsParent[c] >= 0) and (FindUField(UClsParent[c], fname) >= 0) then Continue;
    if nc < MAX_FCALL_CANDS then
    begin
      cands[nc] := c; sigs[nc] := UFldProcSig[fi]; Inc(nc);
    end;
  end;
  { the caller's pick stays the fallback, and is the only candidate when the
    scan finds nothing it recognises }
  if nc = 0 then begin cands[0] := ci; sigs[0] := sigPi; nc := 1; end;

  Expect(tkLParen, '(');
  argsHead := -1; lastArg := -1; n := 0;
  while CurTok.Kind <> tkRParen do
  begin
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    if argsHead = -1 then argsHead := argNode else ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(n);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  Expect(tkRParen, ')');
  { arity is checkable only against a recorded signature; a variant field has
    none and the runtime dispatcher does not want one }
  if (sigPi >= 0) and (n <> Procs[sigPi].ParamCount) then
    Error('Nil Python: .' + fname + '() takes ' +
          PyIntLiteralText(Procs[sigPi].ParamCount) + ' argument(s)');

  { one layout, one class: emit exactly what this used to emit }
  if nc = 1 then
  begin
    Result := PyVariantFieldCallArm(baseNode, cands[0], fname, sigs[0], argsHead, n);
    Exit;
  end;

  Result := PyForceVariant(PyVariantFieldCallArm(baseNode, cands[nc - 1], fname,
                                                 sigs[nc - 1], argsHead, n));
  for i := nc - 2 downto 0 do
  begin
    armN := PyForceVariant(PyVariantFieldCallArm(baseNode, cands[i], fname,
                                                 sigs[i], argsHead, n));
    unboxArg := AllocNode(AN_ARG);
    ASTLeft[unboxArg] := baseNode;
    unboxCall := AllocNode(AN_CALL);
    ASTIVal[unboxCall] := FindProc('pyvarobj');
    if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
    ASTTk[unboxCall] := Ord(tyPointer);
    ASTLeft[unboxCall] := unboxArg;
    condN := AllocNode(AN_IS_TEST);
    ASTLeft[condN] := unboxCall;
    ASTIVal[condN] := cands[i];
    ASTTk[condN] := Ord(tyBoolean);
    pairN := AllocNode(AN_PAIR);
    ASTLeft[pairN] := armN;
    ASTRight[pairN] := Result;
    tern := AllocNode(AN_TERNARY);
    ASTLeft[tern] := condN;
    ASTRight[tern] := pairN;
    ASTTk[tern] := Ord(tyVariant);
    Result := tern;
  end;
end;

{ `w.meth(args)` where `w` is a VARIANT — a for-in loop variable, a list/dict
  element, anything living in a 16-byte variant slot. Python dispatches on the
  RUNTIME type; pxx resolves methods against the receiver's STATIC class, and a
  variant slot records no class identity, so the form used to be a parse error
  (bug-a-nilpy-method-call-on-variant-receiver) and "iterate a list of objects,
  call a method" — an utterly ordinary Python shape — was unavailable.

  Resolution is by METHOD NAME across the declared classes: the slot's VT_OBJECT
  payload is the instance pointer (unboxed with pylib's pyvarobj) and is hard-cast
  to the one class that declares `mname`. When several unrelated classes declare
  the same name the call is genuinely ambiguous without a runtime class tag in the
  slot, and that is an error telling the user to annotate a typed local. A method
  declared once and INHERITED is not ambiguous — the candidates then agree on one
  proc index, and a virtual method still dispatches through the VMT at runtime,
  so a subclass instance in the slot runs its own override. }
{ Is `ci` one of pylib's built-in container classes (list/dict/bytes)? Used to
  break a variant-method tie toward a USER class. }
function PyIsPylibContainerCi(ci: Integer): Boolean;
begin
  Result := (ci = FindUClass('TPyList')) or (ci = FindUClass('TPyDict')) or
            (ci = FindUClass('TPyBytes'));
end;

{ Does proc mpi declare a parameter named nm, starting the scan at firstParam?
  firstParam is 1 on a method (slot 0 is Self, not bindable by name) and 0 on a
  plain/unit-qualified proc (no hidden receiver). }
function PyProcParamNamedFrom(mpi: Integer; const nm: AnsiString; firstParam: Integer): Boolean;
var i: Integer;
begin
  Result := False;
  if mpi < 0 then Exit;
  for i := firstParam to Procs[mpi].ParamCount - 1 do
    if ParamNameEq(mpi, Procs[mpi].Params[i].Name, nm) then
    begin
      Result := True;
      Exit;
    end;
end;

{ Does proc mpi declare a parameter with this name? Slot 0 is Self on a method,
  so the scan starts at 1 — `self=` is not bindable by name. }
function PyProcParamNamed(mpi: Integer; const nm: AnsiString): Boolean;
begin
  Result := PyProcParamNamedFrom(mpi, nm, 1);
end;

{ `<class expr>.name(args)` where the receiver's class is KNOWN — the suffix a
  fresh construction needs (`NoteCountingDetector().analyze(chords, fn)`).
  ParseFactorCore handles this for an IDENT receiver, but a construction leaves
  the core through the ctor intercept, so the postfix never ran and
  `Cls().m()` was a parse error (bug-nilpy-method-call-on-fresh-construction).
  CurTok is the '(' and the method name has been consumed. }
{ Does this class have a parent, or any subclass? Only then does a virtual call
  mean anything for a receiver of exactly this class. }
function PyClassInHierarchy(ci: Integer): Boolean;
var i: Integer;
begin
  Result := UClsParent[ci] >= 0;
  if Result then Exit;
  for i := 0 to UClsCount - 1 do
    if UClsParent[i] = ci then
    begin
      Result := True;
      Exit;
    end;
end;

{ Find an overload of `nm` whose every parameter is ALREADY tyVariant --
  i.e. one that dispatches correctly regardless of what shape the argument
  actually is at runtime, the way `len`'s `(const v: Variant): Integer`
  overload does. FindProc alone is first-match, arity-blind: `len`'s FIRST
  declared overload is `(b: TPyBytes): Integer`, so a naive
  `FindProc('len')` used as `f = len; f("hi")` would silently misread a
  string as a TPyBytes handle. Only the return type may still be non-Variant
  (that half is what PyGetOrMakeCallableWrapper adapts).
  feature-nilpy-callable-value-unified-dispatch }
function PyFindVariantParamOverload(const nm: AnsiString; wantArity: Integer): Integer;
var i, j: Integer; ok: Boolean;
begin
  Result := -1;
  for i := 0 to ProcCount - 1 do
  begin
    if not CaseEqual(Procs[i].Name, nm) then Continue;
    if Procs[i].ParamCount <> wantArity then Continue;
    ok := True;
    for j := 0 to wantArity - 1 do
      if Procs[i].Params[j].TypeKind <> tyVariant then begin ok := False; Break; end;
    if ok then begin Result := i; Exit; end;
  end;
end;

{ TRUE for a return type that is meaningful to box into a Variant result --
  a genuine scalar/string value a real FUNCTION computed. A `-> None` def
  (or any procedure with nothing to return) types tyUnknown here, and
  wrapping THAT crashed: `def hit(vm) -> None: print(...)` used as a
  dataclass field value (`native=hit`) got wrapped, the wrapper's
  `return hit(a0)` tried to store hit's (nonexistent) result into
  $pyresult, and calling it through the field (`w.native(x)`) segfaulted
  right after hit's own body ran. A void proc already has a working
  calling convention through the EXISTING mechanisms (PyWrapClosureFieldCall
  and friends); only a genuine value-returning non-Variant result needs
  this wrapper at all.
  feature-nilpy-callable-value-unified-dispatch }
function PyScalarWrappableRetType(tk: TTypeKind): Boolean;
begin
  Result := tk in [tyInteger, tyInt64, tyDouble, tySingle, tyExtended,
                   tyBoolean, tyAnsiString, tyString, tyChar];
end;

{ realPi already has an all-Variant PARAMETER list (the caller found it via
  PyFindVariantParamOverload, or it is a NilPy-source def PyDefUsedAsValue
  already normalised) but its RETURN type is not tyVariant -- a plain Pascal
  scalar/string/class result, returned in a register or via its OWN type's
  convention, not the Variant hidden-destination-pointer one every callable-
  value dispatcher (pyvar_callv1, PyCallKey1, pycallback_call1, ...) assumes.
  Synthesizes (and caches, by NAME, so repeated captures of the same proc
  share one wrapper) a `function $pycallwrap_N(const a0: Variant): Variant`
  whose body is `return realPi(a0)` -- built as AST, not parsed source, by
  PyCompileLambdaBody's bStart=-1 branch, queued on the SAME lambda-body
  queue (same timing requirement: compiled once CurProc is safely
  restorable). The ordinary call-argument coercion (Variant -> whatever
  realPi's own param type is) and return coercion (whatever it returns ->
  Variant) apply completely unchanged; nothing here does any unboxing
  itself. Only arity 1 today -- covers `key=`/`cmp=`-shaped single-argument
  callables, which is everything this ticket's own repro and the sorted()
  fix need; a multi-arg builtin captured as a bare value still gets the
  unsafe direct address (unchanged pre-existing behaviour) rather than a
  half-finished wrapper.
  feature-nilpy-callable-value-unified-dispatch }
function PyGetOrMakeCallableWrapper(realPi: Integer): Integer;
{ The wrapper takes the REAL proc's arity, not a hardcoded one. It was
  `array[0..0]` / `nParams = 1`, which is why the gate below could only ever
  admit a one-parameter callee: a wrapper for any other arity would have called
  the real proc with the wrong number of arguments. The body builder was already
  arity-generic (it loops `for i := 0 to nparams - 1` over the wrapper's own
  parameters), so nothing else had to change — with 0 it hand-builds
  `return REALPROC()`.
  bug-n-from-import-with-an-as-rename-loses-what-it-renames }
var wrapName: AnsiString; wrapPi, wpi: Integer;
    pnames: array[0..MAX_PROC_PARAMS - 1] of AnsiString;
    ptypes: array[0..MAX_PROC_PARAMS - 1] of TTypeKind;
begin
  wrapName := '$pycallwrap_' + AIntToStr(realPi);
  wrapPi := FindProc(wrapName);
  if wrapPi >= 0 then begin Result := wrapPi; Exit; end;
  for wpi := 0 to Procs[realPi].ParamCount - 1 do
  begin
    pnames[wpi] := 'a' + AIntToStr(wpi);
    ptypes[wpi] := tyVariant;
  end;
  wrapPi := RegisterProc(wrapName, True, tyVariant,
                         Procs[realPi].ParamCount, pnames, ptypes);
  Procs[wrapPi].BodyAddr := -1;
  if PyPendLamCount >= PY_MAX_NESTED then
    Error('Nil Python: too many pending callable-value wrappers/lambdas');
  PyPendLamTok[PyPendLamCount] := -1;    { sentinel: hand-built body, not parsed }
  PyPendLamProc[PyPendLamCount] := wrapPi;
  PyPendLamWrapReal[PyPendLamCount] := realPi;
  PyPendLamPfx[PyPendLamCount] := PyNestPrefix;
  PyPendLamSelf[PyPendLamCount] := CurSelfClass;
  Inc(PyPendLamCount);
  Result := wrapPi;
end;

{ The function-object VALUE for an ALREADY-RESOLVED proc. Split out of
  PyMakeFuncValue so a caller holding a proc index but no token to consume —
  the `from mod import f as g` alias desugar — builds the identical value
  instead of growing a second copy that can drift from this one. }
function PyMakeFuncValueFor(pi: Integer; const nm: AnsiString): Integer;
var procAddr, argA, argB, argC, argD, argE, callNode, nilNode, isFuncNode, boundPi,
    altPi, wpj, starIdx, starNode, sigNode, origPi: Integer;
    paramsAllVariant: Boolean;
begin
  Result := -1;
  if (pi < 0) or (pi >= ProcCount) then Exit;
  { A NESTED def whose meaning depends on values live NOW — captured enclosing
    locals, default-arg expressions — cannot travel as a bare code address. The
    `return inner` path has always known this (ParseFactor calls
    PyNestedDefClosureValue); the ASSIGNMENT path did not, and this is the
    function it uses. So `f = inner; return f` built pybound_new(addr, nil,
    isFunc) with NO captures bound and the callee read them out of the dead
    parent frame: measured, `def peek(): return c` over `c = 41` printed
    5580016 — a raw address — and the `nonlocal` form printed a constant 8 for
    every value of c. `return peek` on the identical body printed 41.

    Tried FIRST, before the overload/wrapper resolution below: that logic can
    replace `pi` with a synthesized wrapper, which has no PyDefTokOf and is not
    the def whose captures need binding. PyNestedDefClosureValue answers -1 for
    anything with nothing to bind, so an ordinary def still takes the plain
    pybound_new path underneath.

    PyBoxCallableValue is what makes the result a tyVariant like the rest of this
    function returns — the bind chain hands back a pointer, and a pointer-typed
    local never reaches the dynamic-call path
    (bug-nilpy-an-escaped-nonlocal-cell-is-not-shared-with-the-enclosing-frame). }
  if PxxDbgEnabled('n.bfn') then
    WriteLn('PXXDBG n.bfn funcvalue for ', nm, ' pi=', pi);
  Result := PyNestedDefClosureValue(pi);
  if Result >= 0 then
  begin
    Result := PyBoxCallableValue(Result);
    Exit;
  end;
  Result := -1;
  { The first FindProc match may not be the SAFE overload: `len`'s first
    declared one takes a TPyBytes, not a Variant, and a wrapper built around
    the wrong overload would silently misread a string argument as a bytes
    handle. Prefer a same-arity, all-Variant-parameter overload of the same
    name if one exists (a NilPy-source def has only one registration, so
    this is a no-op for it). If its return isn't ALSO already tyVariant --
    the shape a plain Pascal builtin like `len` always has, since the
    Variant-hidden-destination-pointer convention every callable-value
    dispatcher assumes is a NilPy-def-only convention -- synthesize a
    wrapper that adapts just the return side. A proc with no all-Variant-
    parameter overload at all (or the wrong arity) is left exactly as
    before: still the pre-existing, unwrapped, possibly-unsafe value.
    feature-nilpy-callable-value-unified-dispatch }
  altPi := PyFindVariantParamOverload(nm, Procs[pi].ParamCount);
  if altPi >= 0 then pi := altPi;
  { The overload pick above IS the real callee, so it keeps the signature; the
    RETURN-side wrapper below does not -- see the note at the pybound_new_sig
    call. }
  origPi := pi;
  if Procs[pi].RetType <> tyVariant then
  begin
    paramsAllVariant := True;
    for wpj := 0 to Procs[pi].ParamCount - 1 do
      if Procs[pi].Params[wpj].TypeKind <> tyVariant then
      begin
        paramsAllVariant := False;
        Break;
      end;
    { ANY arity, not just one. A callable value whose callee returns a scalar
      needs the return side adapted regardless of how many arguments it takes —
      the dispatcher always calls through the Variant-hidden-destination
      convention. `ParamCount = 1` was not a deliberate restriction but the
      arity the wrapper builder happened to hardcode, and it left a
      ZERO-parameter scalar-returning def with no wrapper at all: the box
      pointed straight at a proc using the integer-return ABI, and calling it
      SEGFAULTED. That is the whole of the "zero-argument call crashes, one
      argument works" boundary in the ticket — it was never about argument
      count reaching the callee, only about which arity got a wrapper built.
      bug-n-from-import-with-an-as-rename-loses-what-it-renames }
    if paramsAllVariant and (Procs[pi].ParamCount <= MAX_PROC_PARAMS) and
       Procs[pi].IsFunc and PyScalarWrappableRetType(Procs[pi].RetType) then
      pi := PyGetOrMakeCallableWrapper(pi);
  end;
  { A callee that COLLECTS needs the star-aware pair: its compiled signature
    has ONE TPyList where the call wrote loose arguments, and only the RUNTIME
    knows how many arrive through a function value. See pybound_new_star. }
  starIdx := -1;
  if (pi >= 0) and (pi < ProcCount) then starIdx := ProcPyStarIdx[pi];
  { The SIGNATURE goes on the ORIGINAL proc, never on the wrapper above: the
    wrapper exists only to adapt the RETURN side and declares the same
    parameters, but it is a synthesized Proc and EmitPySignatures records
    defaults against the def the user wrote. Carrying the wrapper's index here
    would hand the dispatcher an empty defaults array and quietly undo the whole
    point. feature-n-a-callable-value-carries-its-signature-type }
  boundPi := FindProc('pybound_new_sig');
  if boundPi < 0 then
  begin
    if starIdx >= 0 then boundPi := FindProc('pybound_new_star')
    else boundPi := FindProc('pybound_new');
  end;
  if boundPi < 0 then Exit;
  procAddr := AllocNode(AN_PROCADDR);
  ASTIVal[procAddr] := pi;
  ASTTk[procAddr] := Ord(tyPointer);
  nilNode := AllocNode(AN_INT_LIT);
  ASTIVal[nilNode] := 0;
  ASTTk[nilNode] := Ord(tyPointer);
  argA := AllocNode(AN_ARG); ASTLeft[argA] := procAddr;
  argB := AllocNode(AN_ARG); ASTLeft[argB] := nilNode;
  { isFunc: whether pi (the resolved callee, possibly PyGetOrMakeCallableWrapper's
    synthesized wrapper) is a genuine Variant-returning function or a real
    procedure (explicit `-> None`) — see PyMakeBoundMethod for why this matters
    (bug-nilpy-void-def-assigned-and-called-crashes). }
  isFuncNode := AllocNode(AN_INT_LIT);
  ASTIVal[isFuncNode] := Ord(Procs[pi].IsFunc);
  ASTTk[isFuncNode]   := Ord(tyBoolean);
  argC := AllocNode(AN_ARG); ASTLeft[argC] := isFuncNode; ASTRight[argC] := -1;
  ASTRight[argB] := argC;
  ASTRight[argA] := argB;
  if (starIdx >= 0) or (Procs[boundPi].ParamCount = 5) then
  begin
    starNode := AllocNode(AN_INT_LIT);
    ASTIVal[starNode] := starIdx;
    ASTTk[starNode]   := Ord(tyInt64);
    argD := AllocNode(AN_ARG); ASTLeft[argD] := starNode; ASTRight[argD] := -1;
    ASTRight[argC] := argD;
  end;
  if Procs[boundPi].ParamCount = 5 then
  begin
    sigNode := AllocNode(AN_PYSIGREF);
    ASTIVal[sigNode] := origPi;
    ASTTk[sigNode]   := Ord(tyPointer);
    argE := AllocNode(AN_ARG); ASTLeft[argE] := sigNode; ASTRight[argE] := -1;
    ASTRight[argD] := argE;
  end;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := boundPi;
  ASTTk[callNode] := Ord(tyVariant);
  ASTLeft[callNode] := argA;
  Result := callNode;
end;

function PyMakeFuncValue: Integer;
{ A bare def NAME in a value position — `w.bind(seq, on_plain)`, `sorted(l,
  key=cmp)`. Python's function object; NilPy already builds one for a bound
  METHOD (pybound_new with the receiver), so a plain def is the same pair with
  a nil receiver and every consumer (pycallback_call*, the tkinter dispatcher)
  handles both. Returns -1 when the token is not a def name, so callers fall
  through to their existing handling. CurTok is the identifier. }
var pi: Integer;
begin
  Result := -1;
  if not isNilPy then Exit;
  if CurTok.Kind <> tkIdent then Exit;
  { `str.lower` — an UNBOUND method is a callable value exactly like a def name,
    and this is the other entry point that builds one (the factor path in
    parser.inc is the first). Both, or `key=str.lower` would work and
    `map(str.lower, xs)` would not — the two-paths-for-one-construct shape
    devdocs/dev/normalise-dont-special-case.md is about. Answers -1 and consumes
    nothing unless the tokens really are that shape. }
  Result := PyUnboundStrMethodValue;
  if Result >= 0 then Exit;
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then Exit;  { a CALL }
  if (FindSym(CurTok.SVal) >= 0) and
     (not PyNestedDefOutranksSym(CurTok.SVal)) then Exit;                 { a variable }
  { A BUILTIN TYPE NAME — `L = list`, and this is the second entry point for it
    exactly as it is for the unbound str method above. Five of the eleven type
    names (`list`, `dict`, `tuple`, `bytes`, `bool`) are ALSO pylib procs, so
    without this arm the FindProc below claimed them and `L = list` bound the
    pylib routine instead of the type: `L("abc")` then called it through the
    callable ABI and answered an int. `t = str` worked the whole time, because
    `str` is not a proc — one construct, two answers, decided by an accident of
    which builtins happen to exist. bug-n-a-type-name-is-not-a-first-class-value }
  if (PyBuiltinTypeCode(CurTok.SVal) > 0) and
     ((TokPos >= TokCount) or (Tokens[TokPos].Kind <> tkDot)) and
     (not PyUserShadowsProc(CurTok.SVal)) then
  begin
    Result := PyMakeBuiltinTypeValue(PyBuiltinTypeCode(CurTok.SVal));
    Next;
    Exit;
  end;
  { A NESTED def is registered under its enclosing qualifier (`A.build.on_resize`),
    so an unqualified FindProc lands on the bodyless shell the pre-pass made —
    and its address is a plausible-looking pointer one byte below the entry
    point, which crashes the first time the callback fires. Look up the
    qualified name first.

    Through PyQualifyNested, not a hand-built `prefix + '.' + name`: that is
    also where a REDEFINED nested def resolves to the binding in scope at this
    point, and deriving the name here instead meant `native=w_include` after a
    second `def w_include` still handed over the FIRST body — uforth's whole
    ANS FILE word set. }
  pi := -1;
  { EXACT case: a Python name is case-SENSITIVE, and Pascal's proc lookup is
    not. `print(Counter)` (no import — CPython's NameError) printed a code
    address, and worse, a module global named `counter` was claimed by pylib's
    `Counter` at every value-position read.
    bug-nilpy-a-global-collides-case-insensitively-with-a-builtin-proc }
  if PyNestPrefix <> '' then pi := FindProcExactCase(PyQualifyNested(CurTok.SVal));
  if pi < 0 then pi := FindProcExactCase(CurTok.SVal);
  if pi < 0 then Exit;
  Result := PyMakeFuncValueFor(pi, CurTok.SVal);
  if Result >= 0 then Next;  { consume the name }
end;

function PyUnboundStrMethodValue: Integer;
{ `str.lower` / `str.upper` / `str.isdigit` ... as a VALUE — the UNBOUND method
  form of a callable, which is what `sorted(xs, key=str.lower)` and
  `map(str.strip, xs)` are made of. CurTok is `str`.

  CPython hands back the function object of the method; NilPy has the function
  already — the str-method table (PyStrMethodInfo) names the pylib routine the
  ordinary `s.lower()` desugars to, so this is that same routine taken as a
  value. One table, both forms, no second list to drift.

  Through PyGetOrMakeCallableWrapper explicitly: pylib's `pystr_lower` takes an
  AnsiString, and every callable-value dispatcher calls through the Variant ABI.
  The wrapper's hand-built `return realproc(a0)` body already applies the
  ordinary argument coercion (that is exactly what it is for), so this needs no
  new runtime and no per-method pylib entry point — but the wrapper must be
  asked for HERE rather than by widening PyMakeFuncValueFor's all-Variant-params
  gate, which decides the same question for every other callable value.

  Only the methods whose pylib entry takes the receiver and NOTHING else. A
  one-argument str method (`str.split`, `str.replace`) is a callable of arity 2
  in Python, which this shape cannot express, so it is left to the existing
  error rather than silently made into something else.

  Returns -1 (consuming nothing) when the tokens are not this shape. }
var mname, pname: AnsiString;
    retTk: TTypeKind;
    want, realPi, wrapPi: Integer;
begin
  Result := -1;
  if not isNilPy then Exit;
  if CurTok.Kind <> tkIdent then Exit;
  if CurTok.SVal <> 'str' then Exit;            { Python is case-sensitive here }
  if FindSym('str') >= 0 then Exit;             { a variable named str wins }
  if (TokPos >= TokCount) or (Tokens[TokPos].Kind <> tkDot) then Exit;
  if (TokPos + 1 >= TokCount) or (Tokens[TokPos + 1].Kind <> tkIdent) then Exit;
  { A following '(' is a CALL (`str.maketrans(...)`), handled elsewhere. }
  if (TokPos + 2 < TokCount) and (Tokens[TokPos + 2].Kind = tkLParen) then Exit;
  mname := GetTokenStr(TokPos + 1);
  retTk := tyUnknown; want := 0; pname := '';
  if not PyStrMethodInfo(mname, pname, retTk, want) then Exit;
  if want <> 0 then Exit;                       { takes arguments — see above }
  realPi := FindProc(pname);
  if realPi < 0 then Exit;
  if Procs[realPi].ParamCount <> 1 then Exit;
  if not Procs[realPi].IsFunc then Exit;
  wrapPi := PyGetOrMakeCallableWrapper(realPi);
  if wrapPi < 0 then Exit;
  Result := PyMakeFuncValueFor(wrapPi, Procs[wrapPi].Name);
  if Result >= 0 then
  begin
    Next; Next; Next;                           { `str` `.` name }
  end;
end;

function PyEvalOnce(node: Integer): Integer;
{ Bind an expression to a hidden temp through a hoisted assignment and yield the
  temp. For a value used in more than one place: the AST is a TREE, so a node
  referenced twice is EMITTED twice — a call receiver in a chain ran its call
  once per link (`b.add(2).add(3)` performed add(2) twice). The temp also pins
  Python's evaluation order: the receiver is computed before the member. }
var sym, asgn: Integer;
begin
  PyEvalOnce := node;
  if node < 0 then Exit;
  sym := AllocVar(PyHiddenName('recv'), IntToTypeKind(ASTTk[node]));
  Syms[sym].RecName := ResolveNodeRec(node);
  SymSyncTypeRef(sym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(sym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  PyEvalOnce := PyMakeIdent(sym);
end;

function PyDynAttrEverAssigned(const nm: AnsiString): Boolean;
{ Does the module write `<expr>.nm = ...` anywhere, or call setattr at all? Then
  `nm` may legitimately be a DYNAMIC attribute on an instance — Python adds them
  at run time — and a call through it cannot be refused at compile time. Used the
  other way round from PyMethodUsedAsValue: this one licenses a name the class
  does not declare, that one detects a value use of one it does. }
var j: Integer;
begin
  Result := False;
  j := 1;
  while j < MainProgramTokCount do
  begin
    if (Tokens[j].Kind = tkIdent) and CaseEqual(GetTokenStr(j), 'setattr') then
    begin
      Result := True;
      Exit;
    end;
    if (Tokens[j].Kind = tkIdent) and (Tokens[j - 1].Kind = tkDot) and
       (j + 1 < MainProgramTokCount) and (Tokens[j + 1].Kind = tkAssign) and
       CaseEqual(GetTokenStr(j), nm) then
    begin
      Result := True;
      Exit;
    end;
    Inc(j);
  end;
end;

var
  PyComputedGetattrScanned: Boolean = False;
  PyComputedGetattrSeen: Boolean = False;

function PyModuleHasComputedGetattr: Boolean;
{ Does this module call `getattr`/`hasattr` with a name it computes at RUN time?
  Scanned once over the token stream, by the same rule the parse uses: the
  argument after the comma is the literal form only when it is a string token
  and the very next token closes or separates it — `"zz" + "z"` starts with a
  string and is still computed.
  feature-nilpy-getattr-with-a-computed-attribute-name }
var j, depth: Integer;
begin
  if PyComputedGetattrScanned then
  begin
    Result := PyComputedGetattrSeen;
    Exit;
  end;
  PyComputedGetattrScanned := True;
  PyComputedGetattrSeen := False;
  j := 0;
  while j < MainProgramTokCount - 2 do
  begin
    if (Tokens[j].Kind = tkIdent) and
       (CaseEqual(GetTokenStr(j), 'getattr') or CaseEqual(GetTokenStr(j), 'hasattr')) and
       (Tokens[j + 1].Kind = tkLParen) then
    begin
      { walk to the receiver's closing comma at depth 1 }
      depth := 1;
      Inc(j, 2);
      while (j < MainProgramTokCount) and (depth > 0) do
      begin
        if Tokens[j].Kind = tkLParen then Inc(depth)
        else if Tokens[j].Kind = tkRParen then Dec(depth)
        else if (depth = 1) and (Tokens[j].Kind = tkComma) then
        begin
          if (j + 2 >= MainProgramTokCount) or
             (Tokens[j + 1].Kind <> tkString) or
             (not (Tokens[j + 2].Kind in [tkComma, tkRParen])) then
          begin
            PyComputedGetattrSeen := True;
            Result := True;
            Exit;
          end;
          Break;
        end;
        Inc(j);
      end;
      Continue;
    end;
    Inc(j);
  end;
  Result := PyComputedGetattrSeen;
end;

function PyMethodUsedAsValue(const nm: AnsiString): Boolean;
{ True iff the module reads `<something>.nm` WITHOUT calling it — `cb = self.on_key`,
  `root.after(50, self.tick)`. That is a bound-method value, and calling one back
  goes through the function-object ABI (variant parameters, variant result), the
  same normalisation PyDefUsedAsValue applies to a plain def. Without it the pair
  carried a method whose result came back in a register while the caller expected
  the hidden-destination convention: a bound method returning a value crashed,
  and one returning None happened to work.

  Keyed on the NAME alone, not on the class, which is what keeps an override and
  its base in step — both are normalised or neither is. A same-named ATTRIBUTE
  read elsewhere in the module normalises a method that did not need it; the cost
  is boxing, and the two passes still agree, so it stays correct. }
var j: Integer;
begin
  Result := False;
  if nm = '' then Exit;
  { A COMPUTED getattr reads a method by a name no token spells, so the scan
    below cannot see it — and the pair it hands back must still be callable
    through the function-object ABI. Normalise every method in a module that
    does this. Coarse on purpose and in the same spirit as the note above: the
    cost is boxing, both passes still agree, and it is paid only by a module
    that actually dispatches by a runtime name.
    feature-nilpy-getattr-with-a-computed-attribute-name }
  if PyModuleHasComputedGetattr then
  begin
    Result := True;
    Exit;
  end;
  j := 1;
  while j < MainProgramTokCount do
  begin
    if (Tokens[j].Kind = tkIdent) and (Tokens[j - 1].Kind = tkDot) and
       CaseEqual(GetTokenStr(j), nm) then
    begin
      { a CALL (`o.m(...)`) or an attribute STORE (`o.m = x`) is not a value read }
      if (j + 1 >= MainProgramTokCount) or
         (not (Tokens[j + 1].Kind in [tkLParen, tkAssign])) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(j);
  end;
end;

function PyInTypeTestCall(j: Integer): Boolean;
{ Is token j an argument of an `isinstance(...)` / `issubclass(...)` call? Both
  name a class WITHOUT it being a value, and both have their own intercept, so a
  class-as-value scan must not trip on them. Walks back to the `(` that opens the
  innermost enclosing call and reads the name in front of it. }
var d, k: Integer;
begin
  PyInTypeTestCall := False;
  d := 0;
  k := j - 1;
  while k >= 0 do
  begin
    if Tokens[k].Kind = tkRParen then Inc(d)
    else if Tokens[k].Kind = tkLParen then
    begin
      if d = 0 then
      begin
        PyInTypeTestCall := (k > 0) and (Tokens[k - 1].Kind = tkIdent) and
          (CaseEqual(GetTokenStr(k - 1), 'isinstance') or
           CaseEqual(GetTokenStr(k - 1), 'issubclass'));
        Exit;
      end;
      Dec(d);
    end
    else if Tokens[k].Kind in [tkNewline, tkIndent, tkDedent] then Exit;
    Dec(k);
  end;
end;

function PyClassUsedAsValueEx(const nm: AnsiString; precise: Boolean): Boolean;
{ True iff the module mentions the CLASS `nm` as a VALUE — a bare name that is
  not construction, not the `class` header, not a type test and not an
  attribute. `cls = A`, `{"a": A}[k]`, `register(A)`.

  The fourth member of the family this file already runs (PyDynAttrEverAssigned,
  PyDefUsedAsValue, PyMethodUsedAsValue), and deliberately as coarse as they
  are: a false positive costs BOXING, never correctness, because the widened
  constructor is still the only one anybody calls. What it buys is the TRIGGER
  that was missing — NilPy's day-1 rule ("infer a static type where you can,
  fall back to a variant where you cannot") already had both halves, and no scan
  looked for a class name in value position, so `cls = A` was refused rather
  than widened (feature-nilpy-class-as-a-value).

  The excluded shapes each have their own intercept and must not trip it:
  `A(...)` construction, the `class A:` / `class B(A):` header line,
  `isinstance(x, A)` and `issubclass(t, A)`, `except A:`, an import line, a
  `: A` / `-> A` annotation, and `o.A` as an attribute.

  `precise` narrows it to the uses that genuinely have no class index at
  compile time, in the two ways this scan is deliberately loose:

    - it ALSO skips `A.attr` — a class NAME, resolved statically by the
      ClassName.member branch, needing nothing at run time;
    - it matches the name case-SENSITIVELY, as NilPy does. CaseEqual made
      `k = K()` a value use OF K (the receiver `k` matched the class `K`), which
      is the third appearance of the case-insensitive-lookup family already
      recorded in bug-nilpy-a-lowercase-name-is-hijacked-by-a-case-matching-class.

  The default scan keeps both, because for CONSTRUCTOR widening a false positive
  costs only boxing; the class-attribute LOWERING has no such luxury (it trades a
  per-instance copy for one shared slot), so neither `print(Plain.n)` nor a local
  spelled like its class may demote a class nobody ever holds.
  bug-nilpy-class-attribute-through-a-class-reference-reads-garbage }
var j: Integer;
    atStmtStart, inSkipStmt: Boolean;
begin
  PyClassUsedAsValueEx := False;
  if nm = '' then Exit;
  j := 0;
  atStmtStart := True;
  inSkipStmt := False;
  while j < MainProgramTokCount do
  begin
    if Tokens[j].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon] then
    begin
      atStmtStart := True;
      inSkipStmt := False;
    end
    else if atStmtStart then
    begin
      { whole-statement exclusions: the class header carries its own name AND
        its base list, `except A:` names a class to match, an import names it
        to bind }
      inSkipStmt := (Tokens[j].Kind = tkClass) or (Tokens[j].Kind = tkExcept) or
                    (Tokens[j].Kind = tkUses) or
                    ((Tokens[j].Kind = tkIdent) and CaseEqual(GetTokenStr(j), 'from'));
      atStmtStart := False;
    end;
    if (not inSkipStmt) and (Tokens[j].Kind = tkIdent) and
       (((not precise) and CaseEqual(GetTokenStr(j), nm)) or
        (precise and (GetTokenStr(j) = nm))) then
    begin
      { An ANNOTATION (`x: A`, `-> A`) is deliberately NOT excluded. The obvious
        exclusion is "preceded by a colon", and it is wrong: a dict literal
        `{"a": A, "b": B}` — the registry this feature exists for — puts a colon
        in front of the class too, so the exclusion would silently drop exactly
        the case that needs the widening, and it would fail at RUN time in
        PyClassRefNew rather than here. Widening a class that is only annotated
        costs boxing and nothing else, which is the trade the whole family
        already makes. }
      if not (((j + 1 < MainProgramTokCount) and (Tokens[j + 1].Kind = tkLParen)) or
              ((j > 0) and (Tokens[j - 1].Kind = tkDot)) or
              (precise and (j + 1 < MainProgramTokCount) and
               (Tokens[j + 1].Kind = tkDot)) or
              PyInTypeTestCall(j)) then
      begin
        PyClassUsedAsValueEx := True;
        Exit;
      end;
    end;
    Inc(j);
  end;
end;

function PyClassUsedAsValue(const nm: AnsiString): Boolean;
begin
  PyClassUsedAsValue := PyClassUsedAsValueEx(nm, False);
end;

function PyClassKinUsedAsValueEx(ci: Integer; precise: Boolean): Boolean;
{ …and the same question over the whole line of descent through ci — the class
  itself, its ancestors, and its DESCENDANTS.

  The descendant direction is the load-bearing one, and it is the direction a
  first cut gets backwards. PyClassRefNew reflects `create` by NAME and walks
  the PARENT chain to find it, so a subclass with no `__init__` of its own is
  constructed through its BASE's constructor: `class D(A)` with `k = D; k(3)`
  calls A's. If only D were widened, A's would still be specialised on a raw
  Int64 and would read a boxed variant as an integer. Ancestors are included for
  the property the method arm gets free by keying on the method name alone —
  a base and its override stay in step — and cost only boxing when unneeded. }
var d, c: Integer;
    kin: Boolean;
begin
  PyClassKinUsedAsValueEx := True;
  for d := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[d] then continue;
    { KINSHIP FIRST, then the token scan. PyClassUsedAsValue walks the whole
      module, so testing it for every class would make this quadratic in classes
      times tokens; the parent-chain walk is a handful of comparisons and is
      false for nearly every pair. }
    kin := False;
    c := d;
    while (c >= 0) and (not kin) do
    begin
      if c = ci then kin := True;
      c := UClsParent[c];
    end;
    c := ci;
    while (c >= 0) and (not kin) do
    begin
      if c = d then kin := True;
      c := UClsParent[c];
    end;
    if kin and PyClassUsedAsValueEx(PyRawName(UClsNOff[d], UClsNLen[d]),
                                    precise) then Exit;
  end;
  PyClassKinUsedAsValueEx := False;
end;

function PyClassKinUsedAsValue(ci: Integer): Boolean;
begin
  PyClassKinUsedAsValue := PyClassKinUsedAsValueEx(ci, False);
end;

function PyNoClassDeclares(const mname: AnsiString): Boolean;
{ True when no declared class has a method of this name. }
var ci: Integer;
begin
  Result := True;
  for ci := 0 to UClsCount - 1 do
    if (not UClsIsRecord[ci]) and (FindUMeth(ci, mname) >= 0) then
    begin
      Result := False;
      Exit;
    end;
end;

{ Locate the '(' that opens the call the parser is currently sitting at, from
  whichever of the two conventions this file uses to reach that point: CurTok
  already ON the '(', or CurTok the call/method NAME with the '(' one token
  ahead (mirrors the same dual check CountCallArgsAhead already relies on).
  Returns the '(' token's own index, or -1 when there is no call here (a bare
  name read, a property, `obj.field` with no following parens…) — every
  PromoteByKw* helper below no-ops on -1, so callers can pass this through
  unconditionally instead of re-deriving parser state by hand at each site. }
function PyKwNamesTokPos: Integer;
begin
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
    Result := TokPos
  else if CurTok.Kind = tkLParen then
    Result := TokPos - 1
  else
    Result := -1;
end;

{ How many arguments a call written at parenTok passes — top-level commas plus
  one, and 0 for an empty `()`. parenTok is the '(' token index. Used to tell a
  candidate method that CAN accept the call from one that provably cannot; a
  keyword argument identifies a signature only when the call writes one, and
  `f()` writes nothing. }
function PyCallArgCountAt(parenTok: Integer): Integer;
var k, depth: Integer;
begin
  Result := 0;
  if (parenTok < 0) or (parenTok >= TokCount) or
     (Tokens[parenTok].Kind <> tkLParen) then Exit;
  if (parenTok + 1 < TokCount) and (Tokens[parenTok + 1].Kind = tkRParen) then Exit;
  Result := 1;
  k := parenTok + 1; depth := 1;
  while (k < TokCount) and (depth > 0) do
  begin
    if Tokens[k].Kind in [tkLParen, tkLBrack] then Inc(depth)
    else if Tokens[k].Kind in [tkRParen, tkRBrack] then Dec(depth)
    else if (depth = 1) and (Tokens[k].Kind = tkComma) then Inc(Result);
    Inc(k);
  end;
end;

function PyPromoteOverloadByKwAt(ci, mmi, parenTok: Integer; const mname: AnsiString): Integer;
{ Pick the same-class OVERLOAD a keyword argument names. `Widget.bind(seq,
  script)` and `Widget.bind(seq, callback, add)` are two methods of one name, and
  FindUMeth hands back whichever was declared first; a call written
  `bind(seq, cb, add="+")` then failed with "no parameter named add". The
  keyword identifies the intended signature, exactly as it does for the
  across-classes promotion in PyParseVariantMethod.

  parenTok is the call's '(' token index (PyKwNamesTokPos, or -1 for "no call
  here" — a no-op). Returns the better mmi, or the one given. }
var k, depth, di, cand, curr: Integer; pname: AnsiString;
begin
  Result := mmi;
  if (ci < 0) or (mmi < 0) or (parenTok < 0) or (parenTok >= TokCount) or
     (Tokens[parenTok].Kind <> tkLParen) then Exit;
  k := parenTok + 1; depth := 1;
  while (k < TokCount) and (depth > 0) do
  begin
    if Tokens[k].Kind = tkLParen then Inc(depth)
    else if Tokens[k].Kind = tkRParen then Dec(depth)
    else if (depth = 1) and (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount) and
            (Tokens[k + 1].Kind = tkAssign) and
            (not PyProcParamNamed(UMthProc_[Result], GetTokenStr(k))) then
    begin
      pname := GetTokenStr(k);
      { up the PARENT CHAIN too: a NilPy class that subclasses a façade widget
        inherits both overloads, and only the base declares them. }
      curr := ci;
      while curr >= 0 do
      begin
        for di := 0 to UClsMCount[curr] - 1 do
        begin
          cand := UClsMBase[curr] + di;
          if UMemberNameMatch(UMthNOff[cand], UMthNLen[cand], curr, mname, ULower(mname)) and
             PyProcParamNamed(UMthProc_[cand], pname) then
          begin
            Result := cand;
            curr := -1;
            Break;
          end;
        end;
        if curr >= 0 then curr := UClsParent[curr];
      end;
    end;
    Inc(k);
  end;
end;

function PyPromoteOverloadByKw(ci, mmi: Integer; const mname: AnsiString): Integer;
{ CurTok is the '(' of the call — the original entry point, kept for the two
  call sites that already have CurTok positioned there. New call sites should
  prefer PyPromoteOverloadByKwAt with PyKwNamesTokPos, which does not require
  a particular CurTok position. }
begin
  if CurTok.Kind <> tkLParen then begin Result := mmi; Exit; end;
  Result := PyPromoteOverloadByKwAt(ci, mmi, TokPos - 1, mname);
end;

{ Among a class's SAME-NAME, SAME-ARITY method overloads, the one whose
  parameter types actually fit the arguments written. Returns -1 to leave the
  caller's choice alone — which is what happens whenever there is a single
  candidate, or no candidate scores strictly better than the current pick.

  FindUMethArity resolves by name and arity only, so overloads distinguished
  PURELY by argument type always collapsed to whichever was DECLARED FIRST.
  That is the type half of the known landmine whose arity half FindUMethArity
  fixed: `h.write(t)` for an unannotated `t` took TPyFile.write(TPyBytes) and
  raised "expected an object argument, got str" for the ordinary Python
  spelling, with str(...) around it as the only workaround
  (bug-nilpy-file-write-picks-the-bytes-overload-for-a-non-str-argument).

  Scoring is deliberately conservative — an EXACT type-kind equality only, one
  point per argument. It is not an assignability lattice: the goal is to
  separate overloads that differ by argument type, not to re-litigate calls
  that already resolve. A tie keeps the incumbent, so a single-overload call
  and every previously-working call are bit-for-bit unchanged.

  argsHead is the AN_ARG chain INCLUDING Self at position 0, matching how the
  caller built it; explicit argument i therefore lines up with parameter i+1. }
{ How many of the call's arguments EXACTLY match proc pIdx's parameter types.
  argsHead is the AN_ARG chain INCLUDING Self at 0, so explicit argument i
  lines up with parameter i+1. Exact type-kind equality only — see the caller. }
function PyOverloadArgTypeScore(pIdx, argsHead, nExplicit: Integer): Integer;
var j, an, tk, argRec, parRec: Integer;
begin
  Result := 0;
  an := ASTRight[argsHead];          { skip Self }
  j := 1;
  while (an <> -1) and (j <= nExplicit) do
  begin
    if j >= MAX_PROC_PARAMS then Break;
    if j > Procs[pIdx].ParamCount - 1 then Break;
    tk := ASTTk[ASTLeft[an]];
    if tk = Ord(Procs[pIdx].Params[j].TypeKind) then
    begin
      Inc(Result);
      { CLASS IDENTITY, not just the type KIND. TPyDict.update declares
        update(TPyList) and update(TPyDict) at the same arity and both
        parameters are tyClass, so the kind test alone TIES every time and the
        first DECLARATION won — a TPyDict argument was walked as a TPyList.
        Through a statically-typed receiver that only mattered until the
        Variant overload was added; through a VARIANT receiver, where nothing
        else disambiguates, it SEGFAULTED.
        An exact rec-id match scores strictly higher, and a mismatch still
        keeps the kind point, so a call only moves when a better-typed sibling
        actually exists.
        bug-nilpy-dict-update-through-a-variant-receiver-picks-the-list-overload }
      if (tk = Ord(tyClass)) or (tk = Ord(tyRecord)) then
      begin
        argRec := ResolveNodeRec(ASTLeft[an]);
        parRec := ProcParamRecId[pIdx * MAX_PROC_PARAMS + j];
        if (argRec >= REC_UCLASS_BASE) and (argRec = parRec) then Inc(Result, 2);
      end;
    end;
    an := ASTRight[an];
    Inc(j);
  end;
end;

{ Among a class's SAME-NAME, SAME-ARITY method overloads, the one whose
  parameter types actually fit the arguments written. Returns -1 to leave the
  caller's choice alone — which is what happens whenever there is a single
  candidate, or none scores strictly better than the current pick.

  FindUMethArity resolves by name and arity only, so overloads distinguished
  PURELY by argument type always collapsed to whichever was DECLARED FIRST.
  That is the type half of the known landmine whose arity half FindUMethArity
  fixed: `h.write(t)` for an unannotated `t` took TPyFile.write(TPyBytes) and
  raised "expected an object argument, got str" for the ordinary Python
  spelling, with str(...) around it as the only workaround
  (bug-nilpy-file-write-picks-the-bytes-overload-for-a-non-str-argument).

  Scoring is deliberately conservative — exact type-kind equality, one point
  per argument, NOT an assignability lattice. The goal is to separate overloads
  that differ by argument type, not to re-litigate calls that already resolve.
  A tie keeps the incumbent, so single-overload calls and every
  previously-working call are unchanged. }
function PyPickOverloadByArgTypes(ci: Integer; const mname: AnsiString;
  nExplicit, argsHead, curMmi: Integer): Integer;
var base, cnt, curr, i, mpi, sc, bestSc, bestMmi, want: Integer;
    lo, nm2: AnsiString;
begin
  Result := -1;
  if (argsHead < 0) or (nExplicit <= 0) or (curMmi < 0) then Exit;
  nm2 := mname;
  lo := ULower(nm2);
  want := nExplicit + 1;             { Self at 0 }
  bestSc := PyOverloadArgTypeScore(UMthProc_[curMmi], argsHead, nExplicit);
  bestMmi := -1;
  curr := ci;
  while curr >= 0 do
  begin
    base := UClsMBase[curr];
    cnt := UClsMCount[curr];
    i := 0;
    while i < cnt do
    begin
      if UMemberNameMatch(UMthNOff[base + i], UMthNLen[base + i], curr, mname, lo) then
      begin
        mpi := UMthProc_[base + i];
        if ProcArityMatches(mpi, want) then
        begin
          sc := PyOverloadArgTypeScore(mpi, argsHead, nExplicit);
          if sc > bestSc then begin bestSc := sc; bestMmi := base + i; end;
        end;
      end;
      Inc(i);
    end;
    curr := UClsParent[curr];
  end;
  Result := bestMmi;
end;

function PyPromoteProcOverloadByKwAt(procIdx, firstParam, parenTok: Integer): Integer;
{ Generalization of PyPromoteOverloadByKwAt to the free / unit-qualified PROC
  table (Procs[]/ProcCount) rather than one class's UMeth set —
  `html.escape(s, quote=False)` resolved to the 1-argument `escape`
  (FindProc/FindProcInUnit hands back whichever overload was declared first),
  and the 1-argument form has no `quote`, even though the 2-argument sibling
  does (bug-nilpy-keyword-arg-vs-overload-set).

  Sibling search prefers the SAME UNIT as procIdx — that is what makes two
  Procs[] entries one Pascal overload SET in the first place. It used to be
  restricted to it, which was too strict: one Python builtin is routinely split
  across pylib and pyeval, so a cross-unit fallback runs when the same unit has
  no match. See the two loops below for why widening is safe here.
  parenTok is the call's '(' token index (PyKwNamesTokPos); -1 is a no-op.
  Returns the same procIdx unless a sibling declares a keyword the call
  actually uses and procIdx does not. }
var k, depth, cand, unitIdx, found: Integer; pname: AnsiString;
begin
  Result := procIdx;
  if (procIdx < 0) or (parenTok < 0) or (parenTok >= TokCount) or
     (Tokens[parenTok].Kind <> tkLParen) then Exit;
  unitIdx := ProcUnitIdx[procIdx];
  k := parenTok + 1; depth := 1;
  while (k < TokCount) and (depth > 0) do
  begin
    if Tokens[k].Kind = tkLParen then Inc(depth)
    else if Tokens[k].Kind = tkRParen then Dec(depth)
    else if (depth = 1) and (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount) and
            (Tokens[k + 1].Kind = tkAssign) and
            (not PyProcParamNamedFrom(Result, GetTokenStr(k), firstParam)) then
    begin
      pname := GetTokenStr(k);
      { SAME UNIT first — see the note above: two Procs[] entries in one unit
        really are one Pascal overload set, so a sibling there is the intended
        answer and must not be beaten by a coincidence elsewhere. }
      found := -1;
      for cand := 0 to ProcCount - 1 do
        if (cand <> Result) and (ProcUnitIdx[cand] = unitIdx) and
           CaseEqual(Procs[cand].Name, Procs[Result].Name) and
           PyProcParamNamedFrom(cand, pname, firstParam) then
        begin
          found := cand;
          Break;
        end;
      { ...then ANY unit. One Python builtin is routinely split across pylib and
        pyeval — anything needing PyCallKey1's callable dispatch has to live in
        pyeval, because `pyeval uses pylib` and not the reverse — so `min` is
        picked from pylib (the two-Variant scalar form) while the list form
        that takes `key` is in pyeval, and same-unit-only refused to cross:
        `min(xs, key=len)` failed while `min(xs, len)` worked, and `key=` is the
        only valid Python spelling (bug-nilpy-keyword-arg-vs-overload-set,
        2026-08-04). Safe to widen HERE specifically because the promotion
        already demands an exact PARAMETER-NAME match that the chosen overload
        lacks — a far narrower key than the name alone — and because NilPy's
        unit scope is flat by design, so a visible same-named routine is a
        candidate for that call anyway. Same-unit still wins when it exists, so
        no Pascal overload set changes its answer. }
      if found < 0 then
        for cand := 0 to ProcCount - 1 do
          if (cand <> Result) and
             CaseEqual(Procs[cand].Name, Procs[Result].Name) and
             PyProcParamNamedFrom(cand, pname, firstParam) then
          begin
            found := cand;
            Break;
          end;
      if found >= 0 then Result := found;
    end;
    Inc(k);
  end;
end;

{ `obj.m(*xs)` — a STARRED argument in a method call, expanded into the callee's
  remaining declared parameters. Unlike the free-function forwarding path
  (PyStarForwardCall in parser.inc, which dispatches on len(args) at run time to
  keep defaults working), the arity here is settled at compile time: each
  remaining parameter becomes one pystar_arg(list, k) read into a hidden variant
  local, guarded by a single pystar_check_arity. A callee with DEFAULTS in the
  starred range is refused rather than filled with None — silently dropping a
  default would be wrong output, not a missing feature.
  `selfSlots` is 1 for a method (Self is parameter 0), 0 for a plain proc;
  `given` is the number of arguments already parsed, and is advanced.
  The caller has NOT yet consumed the '*'. }
{ The star operand as a TPyList. A VARIANT holding a list must be UNBOXED
  first: stored straight into a class slot it lands there as the variant's raw
  tag+payload, and the arity guard then read a nonsense count
  (`forwarded call got -2102166800 arguments`). `*ast.literal_eval(...)` is the
  shape — anything dynamic is a variant, and only a statically-typed list
  worked. }
function PyStarOperandAsList(node, listCi: Integer): Integer;
var unboxArg, unboxCall: Integer;
begin
  { A str is an iterable, so `f(*s)` / `print(*s)` / `[*s]` spread its
    CHARACTERS. This is the one normalisation point every star operand passes
    through, so the str arm belongs here rather than at each caller — the
    by-name-FindProc sites downstream take a real TPyList and would otherwise
    receive a string handle (bug-nilpy-join-of-a-str-segfaults, the same defect
    zip/enumerate had and join inherited). PyIterArgAsList returns a non-str
    node untouched. }
  node := PyIterArgAsList(node);
  if IntToTypeKind(ASTTk[node]) <> tyVariant then
  begin
    PyStarOperandAsList := node;
    Exit;
  end;
  { A VARIANT operand cannot be decided here — an unannotated parameter, a dict
    entry and a container element are all variants, and what they HOLD is a
    run-time fact. This used to be an unconditional pyvarobj + hard CAST to
    TPyList, so a variant holding a str handed the packing a string handle:
    `def fwd(args): return two(*args)` called with "xy" SEGFAULTED, while every
    statically-typed spelling was fine — which is exactly why no test saw it.
    pystar_as_list converts instead (pyiter_v's rules: a str spreads its
    characters, a dict its keys, a user __iter__ its elements, a non-iterable
    raises). bug-nilpy-a-star-operand-in-a-variant-is-cast-not-converted }
  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := node;
  ASTRight[unboxArg] := -1;
  unboxCall := AllocNode(AN_CALL);
  ASTIVal[unboxCall] := FindProc('pystar_as_list');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pystar_as_list) not loaded');
  ASTTk[unboxCall] := Ord(tyClass);
  ASTRight[unboxCall] := REC_UCLASS_BASE + listCi;
  ASTLeft[unboxCall] := unboxArg;
  PyStarOperandAsList := unboxCall;
  ASTTk[PyStarOperandAsList] := Ord(tyClass);
end;

procedure PyStarExpandCallArgs(procIdx, firstSlot: Integer;
                               var headArg, lastArg: Integer);
var listCi, listSym, asgn, total, required, wanted, k: Integer;
    slotSym, elemNode, idxArg, callNode, argNode, a2, a3, chkArg: Integer;
begin
  listCi := FindUClass('TPyList');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  Next;                          { the '*' }
  PyParseBoolExpr;
  listSym := AllocVar(PyHiddenName('starl'), tyClass);
  Syms[listSym].RecName := REC_UCLASS_BASE + listCi;
  SymSyncTypeRef(listSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(listSym);
  ASTRight[asgn] := PyStarOperandAsList(CurASTNode, listCi);
  PyHoistStmt(asgn);

  total := Procs[procIdx].ParamCount;
  required := total;
  while (required > 0) and (required - 1 < MAX_PROC_PARAMS) and
        ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + (required - 1)] do
    Dec(required);
  wanted := total - firstSlot;
  if wanted <= 0 then
    Error('Nil Python: *unpacking has no parameter left to fill in .'
          + Procs[procIdx].Name + '()');
  if required < total then
    Error('Nil Python: *unpacking into ' + Procs[procIdx].Name
          + ' is not supported — it has parameters with defaults, whose values '
          + 'a compile-time expansion cannot preserve');

  { one guard: the list must hold exactly the slots being filled }
  chkArg := AllocNode(AN_ARG);
  ASTLeft[chkArg] := PyMakeIdent(listSym);
  a2 := AllocNode(AN_ARG);
  ASTLeft[a2] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a2]] := wanted;
  ASTTk[ASTLeft[a2]] := Ord(tyInteger);
  a3 := AllocNode(AN_ARG);
  ASTLeft[a3] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a3]] := wanted;
  ASTTk[ASTLeft[a3]] := Ord(tyInteger);
  ASTRight[chkArg] := a2;
  ASTRight[a2] := a3;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := FindProc('pystar_check_arity');
  if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_check_arity) not loaded');
  ASTTk[callNode] := Ord(tyInteger);
  ASTLeft[callNode] := chkArg;
  PyHoistStmt(callNode);

  for k := 0 to wanted - 1 do
  begin
    slotSym := AllocVar(PyHiddenName('stara'), tyVariant);
    elemNode := AllocNode(AN_ARG);
    ASTLeft[elemNode] := PyMakeIdent(listSym);
    idxArg := AllocNode(AN_ARG);
    ASTLeft[idxArg] := AllocNode(AN_INT_LIT);
    ASTIVal[ASTLeft[idxArg]] := k;
    ASTTk[ASTLeft[idxArg]] := Ord(tyInteger);
    ASTRight[elemNode] := idxArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := FindProc('pystar_arg');
    if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_arg) not loaded');
    ASTTk[callNode] := Ord(tyVariant);
    ASTLeft[callNode] := elemNode;
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(slotSym);
    ASTRight[asgn] := callNode;
    PyHoistStmt(asgn);

    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := PyMakeIdent(slotSym);
    ASTIVal[argNode] := 0;
    ASTRight[argNode] := -1;
    if lastArg < 0 then headArg := argNode else ASTRight[lastArg] := argNode;
    if headArg < 0 then headArg := argNode;
    lastArg := argNode;
  end;
end;

{ Is there a top-level `*expr` (single star, not `**`) left in the argument list
  being parsed? Scanned from the current token to the ')' that closes it, so a
  star anywhere in the list — not only in first position — routes the whole call
  through the unpacking path. }
function PyStarArgAhead: Boolean;
var i, depth: Integer;
begin
  Result := (CurTok.Kind = tkStar) and (TokPos < TokCount) and
            (Tokens[TokPos].Kind <> tkStar);
  if Result then Exit;
  depth := 0;
  i := TokPos;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkEnd] then Dec(depth)
    else if Tokens[i].Kind = tkRParen then
    begin
      if depth = 0 then Exit;
      Dec(depth);
    end
    else if (depth = 0) and (Tokens[i].Kind = tkStar) and
            (i + 1 < TokCount) and (Tokens[i + 1].Kind <> tkStar) and
            (i > 0) and (Tokens[i - 1].Kind in [tkComma, tkLParen]) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ A METHOD call whose argument list contains a `*expr` unpack. The arity-driven
  Pascal loop in parser.inc cannot parse it (a star is not an expression), so it
  hands the whole list here — the mirror of PyParseStarMethodArgs, which does the
  same for a callee that DECLARES *args. }
procedure PyStarUnpackMethodArgs(mpi, mcallNode: Integer; var mlastArg, mai: Integer);
var argNode, kwIdx, head, cnt: Integer;
begin
  head := ASTLeft[mcallNode];
  cnt := 1;                          { Self occupies parameter 0 }
  while CurTok.Kind <> tkRParen do
  begin
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) then
    begin
      PyStarExpandCallArgs(mpi, cnt, head, mlastArg);
      cnt := Procs[mpi].ParamCount;
      if CurTok.Kind = tkComma then
        Error('Nil Python: an argument after *unpacking is not supported yet');
      Break;
    end;
    kwIdx := PyKwArgIndex(mpi, 1);
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTIVal[argNode] := kwIdx;
    ASTRight[argNode] := -1;
    if mlastArg < 0 then ASTLeft[mcallNode] := argNode
    else ASTRight[mlastArg] := argNode;
    if head < 0 then head := argNode;
    mlastArg := argNode;
    Inc(cnt);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  ASTLeft[mcallNode] := head;
  mai := Procs[mpi].ParamCount;
end;

{ `f(1, *xs)` — a PLAIN-proc call whose star is not the first argument. The
  twin of PyStarUnpackMethodArgs above, and it exists for the same reason: a
  star is not an expression, so the ordinary argument loop reports "expected
  expression" pointing at the operand — naming neither the star nor the callee,
  so it reads as a syntax error in the caller's own code.

  A star in FIRST position is handled before this, by the run-time arity
  dispatch (PyStarForwardCall), which is what keeps the callee's DEFAULTS
  working. From any later position the expansion is the compile-time one every
  method call already used: the remaining declared slots, one pystar_arg read
  each, behind a single arity guard. It refuses a callee with defaults in the
  starred range rather than filling None — the same trade that path already
  makes.

  A method could do `obj.m(1, *xs)` and a free function could not, which is the
  one-concept-two-sites shape devdocs/dev/normalise-dont-special-case.md is
  about (bug-nilpy-star-unpack-into-a-builtin-or-a-bound-method-is-refused). }
procedure PyStarUnpackProcArgs(procIdx: Integer; var argsHead, lastArg, nArgs: Integer);
var argNode, kwIdx, n: Integer;
begin
  while CurTok.Kind <> tkRParen do
  begin
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) then
    begin
      PyStarExpandCallArgs(procIdx, nArgs, argsHead, lastArg);
      if CurTok.Kind = tkComma then
        Error('Nil Python: an argument after *unpacking is not supported yet');
      Break;
    end;
    kwIdx := PyKwArgIndex(procIdx, 0);
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTIVal[argNode] := kwIdx;
    ASTRight[argNode] := -1;
    if lastArg < 0 then argsHead := argNode else ASTRight[lastArg] := argNode;
    if argsHead < 0 then argsHead := argNode;
    lastArg := argNode;
    Inc(nArgs);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  { recount from the chain: the expansion appends one node per remaining slot }
  nArgs := 0;
  n := argsHead;
  while n >= 0 do
  begin
    Inc(nArgs);
    n := ASTRight[n];
  end;
end;

{ The Python spelling of a pylib container method that pylib declares under a
  DIFFERENT name — in ONE table, because a class-typed receiver is resolved by
  two paths (parser.inc's member access and PyParseClassMethodCall below) and a
  name added to only one of them is exactly the shape this frontend keeps
  paying for (devdocs/dev/normalise-dont-special-case.md). Answers '' when the
  class already spells the name as written.

  TPyDict: the three view methods dodge Pascal's default `Items[]` property.
  TPyList: a set IS a TPyList here, and the four in-place set operations are
  spelled set*  because `update`/`difference` would collide with the list and
  dict surfaces on a case-insensitive language. The operator forms (`|=`, `&=`,
  `^=`, `-=`) already reach them; the METHOD spellings did not, so
  `s.update(other)` was a compile error while `s |= other` worked
  (bug-nilpy-set-update-method-is-not-mapped). The alias applies to any
  TPyList, set or not: telling a set from a list is a RUN-TIME fact (FKind)
  that this compile-time path does not have, and NilPy accepting a call CPython
  rejects is laxness, not a defect — the opposite direction is the one that
  matters (devdocs/dev/nilpy-semantics-divergences.md). }
{ The pylib class a BUILTIN type name stands for in a base-class position, or
  -1. `list`/`dict`/`bytes`/`set` are real classes here under pylib's own names;
  `str` is not a class at all (an AnsiString), so it is absent by construction
  rather than by omission. bug/feature-nilpy-subclass-a-builtin-type }
function PyBuiltinBaseCi(const nm: AnsiString): Integer;
var lo: AnsiString;
begin
  Result := -1;
  lo := LowerCase(nm);
  if (lo = 'list') or (lo = 'set') then Result := FindUClass('TPyList')
  else if lo = 'dict' then Result := FindUClass('TPyDict')
  else if (lo = 'bytes') or (lo = 'bytearray') then Result := FindUClass('TPyBytes');
end;

function PyPylibMethodAlias(ci: Integer; const mname: AnsiString): AnsiString;
begin
  Result := '';
  if (FindUClass('TPyDict') >= 0) and (ci = FindUClass('TPyDict')) then
  begin
    if mname = 'items' then Result := 'itemlist'
    else if mname = 'keys' then Result := 'keylist'
    else if mname = 'values' then Result := 'vallist'
    { The SUBSCRIPT protocol under its Python names. pylib spells the pair
      fetch/store and reaches them through the default `Items[]` property, so
      the operator form `d[k]` always worked while the METHOD spelling — the
      one a dict subclass writes to delegate to the base it just overrode
      (`dict.__getitem__(self, key)`, html5lib's MethodDispatcher) — found no
      such method. Same shape as the items/keys/values aliases above: one
      capability, two spellings, only one of them wired.
      bug-n-a-builtin-types-method-cannot-be-called-unbound }
    else if mname = '__getitem__' then Result := 'fetch'
    else if mname = '__setitem__' then Result := 'store'
    else if mname = '__delitem__' then Result := 'remove'
    else if mname = '__len__' then Result := 'count';
    Exit;
  end;
  if (FindUClass('TPyList') >= 0) and (ci = FindUClass('TPyList')) then
  begin
    { the list half of the same subscript pair — pylib spells it at/put }
    if mname = '__getitem__' then Result := 'at'
    else if mname = '__setitem__' then Result := 'put'
    { by INDEX, which is what __delitem__ means — TPyList.remove takes a VALUE
      and is `list.remove`'s own spelling, so aliasing to it would delete the
      wrong element without a word }
    else if mname = '__delitem__' then Result := 'pop_at'
    else if mname = '__len__' then Result := 'count'
    else if mname = 'update' then Result := 'setupdate'
    else if mname = 'intersection_update' then Result := 'setintersect'
    else if mname = 'difference_update' then Result := 'setdiff'
    else if mname = 'symmetric_difference_update' then Result := 'setsymdiff';
  end;
end;

{ The name to LOOK UP on this class for a Python method spelling: the alias
  when the class does not declare the name as written and does declare the
  alias, the name itself otherwise. Every resolution path calls this instead of
  applying the table by hand, so a class that spells the Python name directly
  is untouched. }
{ `x.__class__.__name__` — Python's other spelling of `type(x).__name__`, and
  the one a class writes about ITSELF (`self.__class__.__name__`). It used to
  reach the dynamic-attribute fallback and raise `'B' object has no attribute
  '__class__'` at RUN time, while `type(self).__name__` worked: two spellings
  of one question, one of them answered.
  Only the full CHAIN is accepted. A bare `x.__class__` is a class OBJECT in
  Python and this frontend has no such value (the same reason bare `type(x)` is
  refused a few lines from here), so leaving it to the existing AttributeError
  is the honest answer rather than inventing one.
  feature-nilpy-small-syntax-gaps-found-by-the-2026-08-06-sweep }
function PyIsClassNameChainAhead: Boolean;
begin
  Result := isNilPy and (CurTok.Kind = tkIdent) and
            CaseEqual(CurTok.SVal, '__class__') and
            (TokPos + 1 < TokCount) and
            (Tokens[TokPos].Kind = tkDot) and
            (Tokens[TokPos + 1].Kind = tkIdent) and
            CaseEqual(GetTokenStr(TokPos + 1), '__name__');
end;

{ Consumes `__class__ . __name__` and answers pytype_name_v(node) — the SAME
  runtime call `type(x).__name__` lowers to, deliberately: a second lowering
  would be a second thing to get wrong for tuples, sets and scalars, which is
  exactly what that one call exists to get right. }
function PyMakeClassNameOf(node: Integer): Integer;
var pi, argNode: Integer;
begin
  Next; Next; Next;                { __class__ . __name__ }
  pi := FindProc('pytype_name_v');
  if pi < 0 then Error('Nil Python: pylib (pytype_name_v) not loaded');
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := node;
  ASTRight[argNode] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := pi;
  ASTLeft[Result] := argNode;
  ASTTk[Result] := Ord(tyAnsiString);
  ASTRight[Result] := -1;
end;

function PyMethNameFor(ci: Integer; const mname: AnsiString): AnsiString;
var al: AnsiString;
begin
  Result := mname;
  if ci < 0 then Exit;
  if FindUMeth(ci, mname) >= 0 then Exit;
  al := PyPylibMethodAlias(ci, mname);
  if (al <> '') and (FindUMeth(ci, al) >= 0) then Result := al;
end;

function PyParseClassMethodCall(baseNode, ci: Integer; const mname: AnsiString): Integer;
var mmi, mpi, selfArg, lastArg, argNode, callNode, n, k, kwIdx, minArgs: Integer;
    anyKw: Boolean;
    mn: AnsiString;
begin
  { A dict whose static type is known — most visibly a LITERAL — failed with
    "TPyDict has no method .items()" while the identical call through a
    variable worked (bug-nilpy-dict-method-on-a-literal-receiver-not-found).
    The table is shared with parser.inc's typed member access. }
  mn := PyMethNameFor(ci, mname);
  mmi := FindUMeth(ci, mn);
  if mmi < 0 then
  begin
    { …unless the class declares __getattr__, in which case `obj.name(args)` is
      Python's two steps written as one: fetch the attribute, then CALL what
      came back. Spelled exactly that way — the existing dynamic-attribute
      getter feeding the existing variant-callable call — so a proxy class gets
      the same dispatch as `g = obj.name; g()`, which already worked.
      bug-nilpy-getattr-dunder-not-supported }
    if isNilPy and (FindUMeth(ci, '__getattr__') >= 0) then
    begin
      Result := PyMakeDynCall(PyMakeDynAttrGet(baseNode, mname));
      Exit;
    end;
    Error('Nil Python: ' + PyRawName(UClsNOff[ci], UClsNLen[ci]) + ' has no method .' + mname + '()');
  end;
  mmi := PyPromoteOverloadByKw(ci, mmi, mn);
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := baseNode;
  ASTRight[selfArg] := -1;
  lastArg := selfArg;
  mpi := UMthProc_[mmi];
  Expect(tkLParen, '(');
  n := 0;
  anyKw := False;
  while CurTok.Kind <> tkRParen do
  begin
    { keyword arguments here too — `WeightedDetector().analyze(rs, weights=w)`.
      Slot 0 is Self, so the name scan starts at 1, exactly as the ordinary
      method path does. }
    { `c.setStrokeColorRGB(*rgb)` — a starred argument is not an expression, so
      it is diverted before ParseArgExpr ever sees the '*'. }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) and (ProcPyStarIdx[mpi] < 0) then
    begin
      k := selfArg;
      PyStarExpandCallArgs(mpi, n + 1, k, lastArg);
      n := Procs[mpi].ParamCount - 1;
      Break;
    end;
    { …and into a method that COLLECTS, where the operand is SPLICED into the
      packing instead of expanded into slots. Same arm the plain-call path has;
      PyPackStarArgs below reads the marker. }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) and (ProcPyStarIdx[mpi] >= 0) then
    begin
      Next;                              { the '*' }
      ParseArgExpr;
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := CurASTNode;
      ASTIVal[argNode] := PY_ARG_SPLICE;
      ASTRight[argNode] := -1;
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(n);
      if CurTok.Kind = tkComma then Next else Break;
      Continue;
    end;
    kwIdx := PyKwArgIndex(mpi, 1);
    if kwIdx <> 0 then anyKw := True;
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTIVal[argNode] := kwIdx;
    ASTRight[argNode] := -1;
    ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(n);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  Expect(tkRParen, ')');
  { `*args` / `**kwargs` on a METHOD: pack the surplus arguments before the
    keyword bind, exactly as the top-level call path does. Self occupies slot 0
    of the parameter list, so the counter is passed INCLUDING it and the
    argument count is re-derived afterwards. }
  if (ProcPyStarIdx[mpi] >= 0) or (ProcPyKwIdx[mpi] >= 0) then
  begin
    n := n + 1;
    PyPackStarArgs(mpi, selfArg, lastArg, n, 0);
    if n > 0 then Dec(n);
    anyKw := False;   { the packing consumed every keyword argument }
  end;
  if anyKw then
  begin
    n := 0;
    PyBindKwArgs(mpi, selfArg, lastArg, n);
    if n > 0 then Dec(n);                { drop Self from the argument count }
  end;
  { pick the overload by the argument count written, then fill the callee's
    remaining DEFAULTED parameters, exactly as the ordinary call path does }
  k := FindUMethArity(ci, mname, n);
  if k >= 0 then mmi := k;
  { ...then, among the SAME-ARITY overloads, prefer the one whose parameter
    TYPES fit the arguments actually written. FindUMethArity resolves by name
    and arity only, so a set of overloads distinguished purely by argument type
    always resolved to whichever was DECLARED FIRST — `f.write(t)` on an
    unannotated parameter took TPyFile.write(TPyBytes) and raised "expected an
    object argument, got str" for the ordinary Python spelling
    (bug-nilpy-file-write-picks-the-bytes-overload-for-a-non-str-argument).
    A single-candidate call cannot change here, and a tie keeps the first
    match, so this only ever moves the case that was already ambiguous. }
  k := PyPickOverloadByArgTypes(ci, mname, n, selfArg, mmi);
  if k >= 0 then mmi := k;
  mpi := UMthProc_[mmi];
  { ARITY. FindUMethArity FALLS BACK to the plain first-name-match when no
    overload accepts this argument count, so the `k >= 0` test above can never
    reject a wrong-arity call — and the default-filling loop below only fills
    parameters that HAVE a default, so a missing REQUIRED argument simply stayed
    uninitialised and the callee read a garbage slot. `[1,2,3].index()` and
    `d.get()` core-dumped; `[1,2,3].count()` quietly returned a WRONG VALUE,
    which is the worse shape of the two. Too MANY arguments fell in the same
    hole. Checked here rather than by tightening FindUMethArity, whose fallback
    is deliberate and relied on by its other callers
    (bug-nilpy-too-few-args-to-container-method-compiles-and-segfaults).
    `*args`/`**kwargs` methods are variadic by construction and were already
    packed above, so they are exempt. }
  if (ProcPyStarIdx[mpi] < 0) and (ProcPyKwIdx[mpi] < 0) and
     (not ProcArityMatches(mpi, n + 1)) then
  begin
    { how many EXPLICIT arguments are required — parameters past Self, minus the
      trailing run that carries defaults }
    minArgs := Procs[mpi].ParamCount - 1;
    while (minArgs > 0) and (minArgs < MAX_PROC_PARAMS) and
          ProcParamHasDefault[mpi * MAX_PROC_PARAMS + minArgs] do Dec(minArgs);
    if minArgs = Procs[mpi].ParamCount - 1 then
      Error('Nil Python: ' + mname + '() takes exactly ' + AIntToStr(minArgs) +
            ' argument(s), got ' + AIntToStr(n))
    else
      Error('Nil Python: ' + mname + '() takes ' + AIntToStr(minArgs) + ' to ' +
            AIntToStr(Procs[mpi].ParamCount - 1) + ' arguments, got ' + AIntToStr(n));
  end;
  k := n + 1;
  while (k < Procs[mpi].ParamCount) and (k < MAX_PROC_PARAMS) and
        ProcParamHasDefault[mpi * MAX_PROC_PARAMS + k] do
  begin
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := DefaultArgValueNode(mpi, k);
    ASTRight[argNode] := -1;
    ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(k);
  end;
  { VIRTUAL dispatch only when the class actually participates in a hierarchy.
    NilPy classes that merely SHARE a method name (songformatter has eight
    unrelated detector classes each declaring analyze) still get virtual slots,
    which costs a VMT indirection for nothing. For a receiver whose exact class is
    known and that has neither parent nor children, a DIRECT call is what Python
    means anyway: the method is resolved on that very type. }
  if (UMthVirSlot[mmi] >= 0) and PyClassInHierarchy(ci) then
  begin
    callNode := AllocNode(AN_VIRTUAL_CALL);
    ASTRight[callNode] := UMthVirSlot[mmi];
  end
  else
    callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := mpi;
  ASTTk[callNode] := Ord(Procs[mpi].RetType);
  { ASTRight is NOT the place for the return's rec id here: on an
    AN_VIRTUAL_CALL it holds the VMT SLOT, and writing the rec id over it sent
    the call through a garbage slot — `A().make()` returning a class segfaulted
    while the bound-variable form was fine. ResolveNodeRec already reads a
    call's class from ProcRetRecId, so nothing needs to be stored. }
  ASTLeft[callNode] := selfArg;
  Result := callNode;
end;

function PyParseVariantMethod(baseNode: Integer; const mname: AnsiString): Integer;
var ci, mmi, mpi, i, k, unboxArg, unboxCall, castNode: Integer;
    selfArg, lastArg, argNode, callNode, hitCi, hitMmi, hitPi: Integer;
    kwDictNode: Integer;
    smPName: AnsiString; smTk: TTypeKind; smArgs: Integer; smArgN: Integer;
    dualPi, dcall, dself, dcast, tern, pairN, condN: Integer;
    { room for a real class hierarchy: songformatter has EIGHT detector classes
      all declaring analyze(), and the cap of three turned that into "too many
      candidate classes to dispatch at runtime" }
    dualCis, dualMmis: array[0..15] of Integer;
    nDual, di, kwIdx, kwDepth, swapCi, swapMmi, dualArgs: Integer;
    ovlMmi: Integer;   { same-arity overload re-picked by argument TYPE }
    anyKw: Boolean; dualRetMixed: Boolean;
    argExprs: array[0..15] of Integer;
    smTmpSym, smAsgn, smGuardArg, smGuardCall, smNotNode, smNameArg,
    smArg1, smArg2, smRaiseCall, smIfNode, smPairNode: Integer;
    vtTmpSym, vtAsgn, vtGuardArg, vtGuardCall, vtNotNode, vtNameArg,
    vtArg1, vtArg2, vtRaiseCall, vtIfNode, vtPairNode: Integer;
    smArmPossible, smArmBuilt: Boolean;
    flArmPossible, flArmBuilt: Boolean;
    flGuardCall, flOrNode, flUnboxArg, flUnboxCall, flCall,
    flPairNode, flTern, flArg1, flArg2, flNotNode, flRaiseCall,
    flIfNode, flPair2: Integer;
begin
  smArmPossible := False;
  smArmBuilt := False;
  flArmPossible := False;
  flArmBuilt := False;
  { A receiver that came from an optional module which did not resolve — the
    name itself, or anything assigned from it. Checked BEFORE class dispatch:
    otherwise a same-named method on an unrelated class captures the call
    (`img.save(buf, format="PNG")` bound to the reportlab shim's Canvas.save),
    which is a wrong binding, not a missing one. }
  if PyIsOptionalMissingNode(baseNode) then
  begin
    Result := PyMakeOptionalMissingCall(PyOptionalMissingName(baseNode) + '.' + mname);
    Exit;
  end;
  { A STR method on a variant receiver — `for s in ["ab"]: s.upper()`, where the
    loop variable is a variant holding a string. Render the receiver with
    pystr_of (which spells every tag Python's way) and hand it to the ordinary
    str-method desugar, rather than looking for a class that declares `upper`.

    But ONLY when the receiver's runtime tag actually IS a string: pystr_of
    also spells None/int/float/bool as plausible TEXT ('None', '5', ...), so
    unconditionally stringifying first turned `None.upper()` into `'NONE'`
    instead of raising AttributeError
    (bug-nilpy-missing-attribute-yields-none-instead-of-attributeerror).
    baseNode is hoisted into a hidden temp first since it is now read TWICE
    (once for the tag guard, once for the str conversion) and may not be
    side-effect-free (`d.get(k).upper()`). }
  if PyStrMethodInfo(mname, smPName, smTk, smArgs) and
     not PyStrMethodLosesToClass(mname) then
  begin
    smTmpSym := AllocVar(PyHiddenName('sm'), tyVariant);
    smAsgn := AllocNode(AN_ASSIGN);
    ASTLeft[smAsgn] := PyMakeIdent(smTmpSym);
    ASTRight[smAsgn] := baseNode;
    PyHoistStmt(smAsgn);
    baseNode := PyMakeIdent(smTmpSym);

    i := FindProc('pyvar_is_strtag');
    if i < 0 then Error('Nil Python: pylib (pyvar_is_strtag) not loaded');
    smGuardArg := AllocNode(AN_ARG); ASTLeft[smGuardArg] := PyMakeIdent(smTmpSym);
    smGuardCall := AllocNode(AN_CALL);
    ASTIVal[smGuardCall] := i; ASTTk[smGuardCall] := Ord(tyBoolean);
    ASTLeft[smGuardCall] := smGuardArg;
    smNotNode := AllocNode(AN_NOT);
    ASTLeft[smNotNode] := smGuardCall; ASTTk[smNotNode] := Ord(tyBoolean);

    i := FindProc('pydynattr_no_method');
    if i < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
    smNameArg := AllocNode(AN_STR_LIT);
    ASTSOffset[smNameArg] := PyStoredName(mname);
    ASTSLen[smNameArg] := Length(mname);
    ASTTk[smNameArg] := Ord(tyString);
    smArg2 := AllocNode(AN_ARG); ASTLeft[smArg2] := smNameArg; ASTRight[smArg2] := -1;
    smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(smTmpSym); ASTRight[smArg1] := smArg2;
    smRaiseCall := AllocNode(AN_CALL);
    ASTIVal[smRaiseCall] := i; ASTTk[smRaiseCall] := Ord(tyUnknown);
    ASTLeft[smRaiseCall] := smArg1;

    smIfNode := AllocNode(AN_IF);
    ASTLeft[smIfNode] := smNotNode;
    smPairNode := AllocNode(AN_PAIR);
    ASTLeft[smPairNode] := smRaiseCall; ASTRight[smPairNode] := -1;
    ASTRight[smIfNode] := smPairNode;
    PyHoistStmt(smIfNode);

    i := FindProc('pystr_of');
    if i < 0 then Error('Nil Python: pylib (pystr_of) not loaded');
    unboxArg := AllocNode(AN_ARG);
    ASTLeft[unboxArg] := baseNode;
    unboxCall := AllocNode(AN_CALL);
    ASTIVal[unboxCall] := i;
    ASTTk[unboxCall] := Ord(tyAnsiString);
    ASTLeft[unboxCall] := unboxArg;
    Result := PyParseStrMethod(unboxCall, mname);
    Exit;
  end;
  { A FLOAT method on a variant receiver, when no class declares the name —
    is_integer / conjugate / as_integer_ratio today. The str-first block above,
    with pyvar_is_floattag for the guard and pyvar_to_float for the unbox: a
    genuine float reaches the intrinsic, anything else raises AttributeError
    naming the method, which is what CPython does.

    The class-declared case (`hex`, which TPyBytes carries) is NOT handled here
    — it falls through to the closed-world dispatcher and is answered by the
    float ARM near the end of this function, exactly as a class-declared str
    name is. Two entry points for one concept, but they are the two the str
    path already has and for the same reason: this one exists because the
    dispatcher's "no class declares" arm is a hard compile ERROR, and a float
    receiver has no class to declare anything.
    bug-nilpy-float-methods-are-invisible-to-the-runtime-dispatcher }
  if PyIsFloatMethodName(LowerCase(mname)) and
     not PyAnyClassDeclaresMeth(mname) then
  begin
    smTmpSym := AllocVar(PyHiddenName('fl'), tyVariant);
    smAsgn := AllocNode(AN_ASSIGN);
    ASTLeft[smAsgn] := PyMakeIdent(smTmpSym);
    ASTRight[smAsgn] := baseNode;
    PyHoistStmt(smAsgn);
    baseNode := PyMakeIdent(smTmpSym);

    i := FindProc('pyvar_is_floattag');
    if i < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
    smGuardArg := AllocNode(AN_ARG); ASTLeft[smGuardArg] := PyMakeIdent(smTmpSym);
    smGuardCall := AllocNode(AN_CALL);
    ASTIVal[smGuardCall] := i; ASTTk[smGuardCall] := Ord(tyBoolean);
    ASTLeft[smGuardCall] := smGuardArg;
    { An INT receiver is legitimate for the three names int shares, and only
      the runtime tag says which the variant holds — so the guard admits both
      tags and the VALUE below picks the flavour with the same test. Without
      this, `for v in [1, 2.5]: v.is_integer()` raised on the int and answered
      on the float, which is precisely the asymmetry this ticket is about, one
      type over. }
    flArmPossible := PyIsIntFloatSharedMethodName(LowerCase(mname));
    if flArmPossible then
    begin
      i := FindProc('pyvar_is_inttag');
      if i < 0 then Error('Nil Python: pylib (pyvar_is_inttag) not loaded');
      flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(smTmpSym);
      flGuardCall := AllocNode(AN_CALL);
      ASTIVal[flGuardCall] := i; ASTTk[flGuardCall] := Ord(tyBoolean);
      ASTLeft[flGuardCall] := flArg1;
      flOrNode := AllocNode(AN_BINOP);
      ASTIVal[flOrNode] := Ord(tkOr);
      ASTLeft[flOrNode] := smGuardCall;
      ASTRight[flOrNode] := flGuardCall;
      ASTTk[flOrNode] := Ord(tyBoolean);
      smNotNode := AllocNode(AN_NOT);
      ASTLeft[smNotNode] := flOrNode; ASTTk[smNotNode] := Ord(tyBoolean);
    end
    else
    begin
      smNotNode := AllocNode(AN_NOT);
      ASTLeft[smNotNode] := smGuardCall; ASTTk[smNotNode] := Ord(tyBoolean);
    end;

    i := FindProc('pydynattr_no_method');
    if i < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
    smNameArg := AllocNode(AN_STR_LIT);
    ASTSOffset[smNameArg] := PyStoredName(mname);
    ASTSLen[smNameArg] := Length(mname);
    ASTTk[smNameArg] := Ord(tyString);
    smArg2 := AllocNode(AN_ARG); ASTLeft[smArg2] := smNameArg; ASTRight[smArg2] := -1;
    smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(smTmpSym); ASTRight[smArg1] := smArg2;
    smRaiseCall := AllocNode(AN_CALL);
    ASTIVal[smRaiseCall] := i; ASTTk[smRaiseCall] := Ord(tyUnknown);
    ASTLeft[smRaiseCall] := smArg1;

    smIfNode := AllocNode(AN_IF);
    ASTLeft[smIfNode] := smNotNode;
    smPairNode := AllocNode(AN_PAIR);
    ASTLeft[smPairNode] := smRaiseCall; ASTRight[smPairNode] := -1;
    ASTRight[smIfNode] := smPairNode;
    PyHoistStmt(smIfNode);

    i := FindProc('pyvar_to_float');
    if i < 0 then Error('Nil Python: pylib (pyvar_to_float) not loaded');
    unboxArg := AllocNode(AN_ARG);
    ASTLeft[unboxArg] := baseNode;
    unboxCall := AllocNode(AN_CALL);
    ASTIVal[unboxCall] := i;
    ASTTk[unboxCall] := Ord(tyDouble);
    ASTLeft[unboxCall] := unboxArg;
    Result := PyParseFloatMethod(unboxCall, LowerCase(mname), False);
    if flArmPossible then
    begin
      { the int flavour of the same call, chosen at run time by the tag —
        `pyvar_is_floattag(v) ? <float form> : <int form>`. The arguments were
        already consumed by PyParseFloatMethod above (all three take none), so
        the two forms cannot disagree about what was parsed. }
      i := FindProc('pyvar_to_int');
      if i < 0 then Error('Nil Python: pylib (pyvar_to_int) not loaded');
      flUnboxArg := AllocNode(AN_ARG);
      ASTLeft[flUnboxArg] := PyMakeIdent(smTmpSym);
      flUnboxCall := AllocNode(AN_CALL);
      ASTIVal[flUnboxCall] := i;
      ASTTk[flUnboxCall] := Ord(tyInt64);
      ASTLeft[flUnboxCall] := flUnboxArg;
      flCall := PyMakeFloatMethodOn(flUnboxCall, LowerCase(mname), True);

      i := FindProc('pyvar_is_floattag');
      if i < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
      flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(smTmpSym);
      flGuardCall := AllocNode(AN_CALL);
      ASTIVal[flGuardCall] := i; ASTTk[flGuardCall] := Ord(tyBoolean);
      ASTLeft[flGuardCall] := flArg1;

      flPairNode := AllocNode(AN_PAIR);
      ASTLeft[flPairNode] := Result;
      ASTRight[flPairNode] := flCall;
      flTern := AllocNode(AN_TERNARY);
      ASTLeft[flTern] := flGuardCall;
      ASTRight[flTern] := flPairNode;
      { `is_integer` agrees (Boolean both ways) and `conjugate` does not
        (Double vs Int64) — a disagreeing pair is genuinely dynamic, exactly as
        every other arm in this function decides it. }
      if IntToTypeKind(ASTTk[Result]) <> IntToTypeKind(ASTTk[flCall]) then
        ASTTk[flTern] := Ord(tyVariant)
      else
        ASTTk[flTern] := ASTTk[Result];
      LastExprTk := IntToTypeKind(ASTTk[flTern]);
      Result := flTern;
    end;
    Exit;
  end;
  { Python's dict views on a VARIANT receiver. The typed path (parser.inc's
    member access) already maps items/keys/values onto pylib's itemlist /
    keylist / vallist — names chosen to dodge the default `Items[]` property —
    but a variant receiver never reaches it: the candidate scan below found no
    class declaring `values`, and the call fell through to the pyeval dynamic
    dispatch, which has no TPyDict branch and jumped through a nil host-call
    slot. See bug-nilpy-dict-values-on-variant-receiver. }
  { NO early return for items/keys/values any more. These three used to jump
    straight to pylib's itemlist/keylist/vallist whenever TPyDict existed --
    which is ALWAYS, since pylib is always loaded -- so a USER class's own
    `keys()` was hijacked and the call ran TPyDict.keylist over an instance that
    was not a dict. It segfaulted before printing anything
    (bug-n-a-user-classs-keys-items-values-is-dispatched-as-a-dict-view).

    The guard the sibling arms below have (`PyNoClassDeclares`) would have
    stopped the crash, but a fourth special case is the wrong fix: the candidate
    scan already handles EXACTLY this pair shape -- "the other candidate is a
    pylib container, this one a USER class: hold the user class statically and
    remember the container for a RUNTIME is-test branch" -- and it already
    reaches TPyDict under these names, because PyMethNameFor maps them through
    PyPylibMethodAlias to keylist/vallist/itemlist just as it maps TPyList's
    `update` to setupdate.

    So the three cases are DELETED rather than guarded, and one general
    mechanism decides: a dict receiver still reaches keylist, a user instance
    reaches its own method, and a receiver that could be either is settled at
    run time instead of at compile time by a coin flip.
    normalise-dont-special-case. }
  { `w.destroy()` on a dynamically-typed widget — see the typed path in
    parser.inc: Pascal reserves `destroy` for the destructor. }
  if mname = 'destroy' then
  begin
    for ci := 0 to UClsCount - 1 do
      if (not UClsIsRecord[ci]) and (FindUMeth(ci, 'destroy_') >= 0) then
      begin
        Result := PyParseVariantMethod(baseNode, 'destroy_');
        Exit;
      end;
  end;
  { A Python method name Pascal RESERVES — the library convention is a trailing
    underscore (`set_`, `destroy_`). If nothing declares the name as written but
    something declares the underscored one, that is the method meant:
    configparser's `cfg.set(section, key, value)` on a dynamically-typed
    receiver. The typed path in parser.inc does the same. }
  if PyNoClassDeclares(mname) and (not PyNoClassDeclares(mname + '_')) then
  begin
    Result := PyParseVariantMethod(baseNode, mname + '_');
    Exit;
  end;
  { candidate scan — one entry per class whose method set answers to mname }
  hitCi := -1; hitMmi := -1; hitPi := -1;
  nDual := 0;
  for ci := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[ci] then Continue;
    { PyMethNameFor, not FindUMeth(ci, mname): a class that spells this Python
      name differently is still a CANDIDATE. Without it, `xs[0].update(...)` on
      a variant element found only TPyDict — the one class declaring `update`
      as written — and called TPyDict.update on whatever the receiver actually
      was, which SEGFAULTED for a set. Now TPyList joins the candidate list via
      setupdate and the ordinary two-container runtime dispatch below decides.
      bug-nilpy-set-update-method-is-not-mapped }
    mmi := FindUMeth(ci, PyMethNameFor(ci, mname));
    if mmi < 0 then Continue;
    mpi := UMthProc_[mmi];
    if hitCi < 0 then begin hitCi := ci; hitMmi := mmi; hitPi := mpi; end
    else if mpi <> hitPi then
    begin
      { An OVERRIDE is not an ambiguity: keep the ancestor's declaration so the
        call goes through that VMT slot and the runtime instance picks its own
        override. Only two UNRELATED classes are genuinely undecidable. }
      if IsSubclassOf(hitCi, ci) then
        { ci is the ANCESTOR — its slot is the one to dispatch through }
        begin hitCi := ci; hitMmi := mmi; hitPi := mpi; end
      else if (ci = FindUClass('TPyBytes')) or (hitCi = FindUClass('TPyBytes')) then
      begin
        { TPyList and TPyBytes both legitimately declare append/extend (Python
          has both list.append and bytearray.append), so neither can be renamed
          the way TPyList.get was.

          This used to be a NARROW PREFERENCE for the list — chosen because its
          parameter is a Variant and accepts anything, and "a bytearray receiver
          is almost always a statically-typed local which never reaches this
          path". That assumption fails for exactly the shape this ticket is
          about: `bytearray() if flag else [1, 2]` gives a receiver with no
          static class, and `.append(99)` on the bytearray arm then ran
          TPyList.append over a TPyBytes.

          Now the same RUNTIME dispatch every other ambiguous pair here gets:
          the LIST stays the static pick and the FALLBACK arm — so a receiver
          that is neither behaves exactly as before — and TPyBytes becomes a
          runtime-tested candidate, costing one class compare on these calls
          only. feature-nilpy-runtime-method-dispatch-on-variant }
        if ci = FindUClass('TPyBytes') then
        begin
          if nDual <= High(dualCis) then
          begin
            dualCis[nDual] := ci; dualMmis[nDual] := mmi; Inc(nDual);
          end;
        end
        else
        begin
          if nDual <= High(dualCis) then
          begin
            dualCis[nDual] := hitCi; dualMmis[nDual] := hitMmi; Inc(nDual);
          end;
          hitCi := ci; hitMmi := mmi; hitPi := mpi;
        end;
      end
      else if PyIsPylibContainerCi(hitCi) and not PyIsPylibContainerCi(ci) then
      begin
        { the other candidate is a pylib container (list/dict/bytes), this one a
          USER class: hold the USER class statically but remember the container
          for a RUNTIME is-test branch — `vm.pop()` on a variant param means
          VM.pop, while `pending.pop()` on a variant LIST must reach
          TPyList.pop (the static pick alone called VM.pop on a list and
          jumped through garbage — uforth END-STRUCTURE). }
        if nDual <= High(dualCis) then
        begin
          dualCis[nDual] := hitCi; dualMmis[nDual] := hitMmi; Inc(nDual);
        end;
        hitCi := ci; hitMmi := mmi; hitPi := mpi;
      end
      else if PyIsPylibContainerCi(ci) and not PyIsPylibContainerCi(hitCi) then
      begin
        { keep the user-class candidate; remember the container for the branch }
        if nDual <= High(dualCis) then
        begin
          dualCis[nDual] := ci; dualMmis[nDual] := mmi; Inc(nDual);
        end;
      end
      else if PyIsPylibContainerCi(ci) and PyIsPylibContainerCi(hitCi) then
      begin
        { TWO containers declare it (list.pop and dict.pop): keep the current
          hit, branch on the other at runtime too }
        if nDual <= High(dualCis) then
        begin
          dualCis[nDual] := ci; dualMmis[nDual] := mmi; Inc(nDual);
        end;
      end
      else if not IsSubclassOf(ci, hitCi) then
      begin
        { Two UNRELATED USER classes declare the name. This used to be a hard
          error; it is now the same RUNTIME dispatch the container/user split
          above gets, only with an is-test on the receiver's actual class rather
          than a variant tag test — the receiver carries VT_OBJECT plus a real
          class pointer, so the test costs one compare per extra candidate and
          only on calls that are genuinely ambiguous.
          (feature-nilpy-runtime-method-dispatch-on-variant. songformatter's
          key_analysis.py has three unrelated dataclasses declaring to_text().) }
        if nDual <= High(dualCis) then
        begin
          dualCis[nDual] := ci; dualMmis[nDual] := mmi; Inc(nDual);
        end
        else
          Error('Nil Python: .' + mname + '() on a dynamically-typed value has '
            + 'too many candidate classes to dispatch at runtime — assign to an '
            + 'annotated local first');
      end;
    end;
  end;
  if hitCi < 0 then
  begin
    { Not a method — but it may be a procedural FIELD holding a function value,
      which is how a dispatch table is written (`w.native(vm)`). Resolve the
      field the same way, by name across the declared classes, and call through
      it (feature-nilpy-function-values). }
    for ci := 0 to UClsCount - 1 do
    begin
      if UClsIsRecord[ci] then Continue;
      mmi := FindUField(ci, mname);
      if mmi < 0 then Continue;
      if UFldProcSig[mmi] < 0 then Continue;
      { A second class declaring the name is NOT ambiguous any more:
        PyMakeVariantFieldCall re-scans every candidate and emits one
        `pyvarobj(v) is C ? <call as C> : ...` arm each, carrying that
        candidate's own signature. This guard predates that dispatch and was
        rejecting programs the callee can now compile — it is what turned the
        segfault in
        bug-nilpy-local-reassigned-across-classes-keeps-one-static-class into a
        hard error once the receiver was correctly widened to a variant.
        The first hit stays as the FALLBACK class for a receiver that is none of
        the candidates. }
      if hitCi < 0 then begin hitCi := ci; hitMmi := mmi; end;
    end;
    { A signature is recorded only for a @dataclass field. A PLAIN class's
      `Callable` field gets its type from the `__init__` parameter it is
      assigned from, which records none — so `for x in words: x.native(vm)`
      over a plain-class dispatch table found nothing here and failed to
      COMPILE ("no class declares a method or callable field"), while the
      identical program with @dataclass compiled.

      Second pass rather than a relaxed first one: a field WITH a signature
      still wins, so every program that resolves today resolves the same way.
      A VARIANT field is the right fallback because that is what a `Callable`
      field now is, and the call goes out through pyvar_callv<n>, which tells
      all four callable shapes apart at run time and needs no signature. The
      unique-class requirement is what keeps this from claiming a name that
      merely happens to be a variant field somewhere.
      bug-nilpy-plain-class-callable-field-unreachable-through-a-dynamic-receiver }
    if hitCi < 0 then
      for ci := 0 to UClsCount - 1 do
      begin
        if UClsIsRecord[ci] then Continue;
        mmi := FindUField(ci, mname);
        if mmi < 0 then Continue;
        if IntToTypeKind(UFldTk[mmi]) <> tyVariant then Continue;
        { same as the signature pass above: several classes declaring a
          variant Callable field of this name is exactly the shape
          PyMakeVariantFieldCall dispatches at run time. Keep the first as the
          fallback arm. }
        if hitCi < 0 then begin hitCi := ci; hitMmi := mmi; end;
      end;
    if hitCi >= 0 then
    begin
      Result := PyMakeVariantFieldCall(baseNode, hitCi, mname, UFldProcSig[hitMmi]);
      Exit;
    end;
    { The receiver is a name bound to None because its optional import did not
      resolve — `Image.open(...)` after `try: from PIL import Image` failed.
      CPython compiles that file and raises only if the call runs, which is
      what the application's own HAVE_PIL guard relies on. Emit the same shape:
      a call that raises, naming the module. }
    if PyIsOptionalMissingNode(baseNode) then
    begin
      Result := PyMakeOptionalMissingCall(PyOptionalMissingName(baseNode) + '.' + mname);
      Exit;
    end;
    { …and anything else dynamically typed, ONCE this program is known to have
      an optional import that did not resolve. A value taken from such a module
      spreads through locals (`img = Image.open(f)` then `img.resize(...)`),
      and NilPy parses a body more than once, so tracking the taint statement
      by statement does not hold. Closed-world dispatch stays a compile error
      for every program WITHOUT such an import — which is all of them until one
      says `try: import X / except ImportError:` — so typo detection is
      unchanged there. feature-nilpy-fallback-import. }
    if (PyOptMissingCount > 0) and
       (IntToTypeKind(ASTTk[baseNode]) = tyVariant) then
    begin
      Result := PyMakeOptionalMissingCall('.' + mname + ' (an optional module)');
      Exit;
    end;
    Error('Nil Python: no class declares a method or callable field .'
          + mname + '()');
  end;

  { Which candidate does the CALL name? With several classes declaring the
    method, the static pick so far is just the first one found — but a KEYWORD
    argument names a parameter, and that identifies the intended signature.
    Scan the argument list's `ident =` pairs before parsing them and promote the
    candidate that has those parameters; the demoted one stays as a runtime arm.
    key_analysis.py's `detector.to_text(verbose=True)` needs exactly this: the
    first class found declares `to_text()` with no parameters at all. }
  if (nDual > 0) and (CurTok.Kind = tkLParen) then
  begin
    k := TokPos; kwDepth := 1;
    while (k < TokCount) and (kwDepth > 0) do
    begin
      if Tokens[k].Kind = tkLParen then Inc(kwDepth)
      else if Tokens[k].Kind = tkRParen then Dec(kwDepth)
      else if (kwDepth = 1) and (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount)
              and (Tokens[k + 1].Kind = tkAssign)
              and (not PyProcParamNamed(hitPi, GetTokenStr(k))) then
      begin
        smPName := GetTokenStr(k);
        for di := 0 to nDual - 1 do
          if (dualMmis[di] >= 0) and PyProcParamNamed(UMthProc_[dualMmis[di]], smPName) then
          begin
            swapCi := hitCi; swapMmi := hitMmi;
            hitCi := dualCis[di]; hitMmi := dualMmis[di]; hitPi := UMthProc_[hitMmi];
            dualCis[di] := swapCi; dualMmis[di] := swapMmi;
            Break;
          end;
      end;
      Inc(k);
    end;
  end;

  { Same question again, answered by ARITY rather than by a keyword. A keyword
    only identifies a signature when the call writes one; `var.get()` writes
    nothing at all, and the first class found declaring `get` is TPyDict, whose
    get(key[, default]) REQUIRES an argument — so the zero-argument call every
    tkinter StringVar/BooleanVar accepts was refused outright with
    "get() takes 1 to 2 arguments, got 0", naming a class the program never
    mentions. The receiver here is dynamically typed, so the static pick is a
    GUESS; a candidate that cannot accept the arity written is a guess already
    known to be wrong, and one that can is strictly better. The demoted
    candidate stays as a runtime arm exactly as in the keyword case.
    bug-nilpy-songformatter-no-longer-compiles-set-callback-and-get-arity }
  if (nDual > 0) and (hitPi >= 0) and (CurTok.Kind = tkLParen) and
     (not ProcArityMatches(hitPi, PyCallArgCountAt(TokPos - 1) + 1)) then
  begin
    smArgN := PyCallArgCountAt(TokPos - 1);
    for di := 0 to nDual - 1 do
      if (dualMmis[di] >= 0) and
         ProcArityMatches(UMthProc_[dualMmis[di]], smArgN + 1) then
      begin
        swapCi := hitCi; swapMmi := hitMmi;
        hitCi := dualCis[di]; hitMmi := dualMmis[di]; hitPi := UMthProc_[hitMmi];
        dualCis[di] := swapCi; dualMmis[di] := swapMmi;
        Break;
      end;
  end;

  { Same question, but for OVERLOADS OF ONE CLASS. The candidate scan keeps one
    entry per class, so `Widget.bind(seq, script)` and `Widget.bind(seq,
    callback, add)` collapse to whichever was declared first — and a keyword
    argument the chosen one does not have was then a hard error
    (`bind(..., add="+")`, which is what songformatter writes). The keyword
    names the signature here just as it does across classes above. }
  if hitCi >= 0 then
  begin
    hitMmi := PyPromoteOverloadByKw(hitCi, hitMmi, mname);
    if hitMmi >= 0 then hitPi := UMthProc_[hitMmi];
  end;

  { keywords-are-KEYS on a DYNAMICALLY dispatched receiver — `def f(m):
    m.update(a=1)` and `xs[0].update(r=1)`, both of which arrive here rather
    than through FindUMethOverloadAhead. `update` is a name TPyList and TPySet
    carry too, so the dynamic scan above answered with whichever class it met
    first and the call was reported against `TPyList.setupdate`. A KEYWORD run
    only ever means dict.update — CPython's list and set take no keywords —
    so the dict arm is the one answer, exactly as the static path picks it. }
  if isNilPy then
  begin
    i := PyDictKwOverloadAhead(FindUClass('TPyDict'), mname);
    if i >= 0 then
    begin
      hitCi := FindUClass('TPyDict');
      hitMmi := i;
      hitPi := UMthProc_[i];
    end;
  end;

  { Runtime tag guard, same shape as the str-method guard above: this hard
    cast assumes VT_OBJECT and dereferences the raw payload as an instance
    pointer. A receiver whose declared default never evaluates (`def f(a,
    b=[])`, where the container literal falls through as a genuine None —
    PyParamDefaultAt's own "non-constant default" comment) reaches here
    holding VT_EMPTY, and an unchecked cast dereferences a null/garbage
    pointer the moment the callee's method body touches Self
    (bug-nilpy-container-literal-default-arg-segfaults). Hoist the receiver
    once (read twice below: the tag check, then the cast) and raise a clean
    AttributeError via the existing pydynattr_no_method instead of crashing —
    mirrors pydynattr_get_v/pyvar_getitem, which already guard the tag before
    their own casts; this dispatch path did not. }
  vtTmpSym := AllocVar(PyHiddenName('vt'), tyVariant);
  vtAsgn := AllocNode(AN_ASSIGN);
  ASTLeft[vtAsgn] := PyMakeIdent(vtTmpSym);
  ASTRight[vtAsgn] := baseNode;
  PyHoistStmt(vtAsgn);
  baseNode := PyMakeIdent(vtTmpSym);

  i := FindProc('pyvar_is_objtag');
  if i < 0 then Error('Nil Python: pylib (pyvar_is_objtag) not loaded');
  vtGuardArg := AllocNode(AN_ARG); ASTLeft[vtGuardArg] := PyMakeIdent(vtTmpSym);
  vtGuardCall := AllocNode(AN_CALL);
  ASTIVal[vtGuardCall] := i; ASTTk[vtGuardCall] := Ord(tyBoolean);
  ASTLeft[vtGuardCall] := vtGuardArg;
  { A STRING receiver is legitimate here when the method name is also a str
    method — the dispatcher grows a `pyvar_is_strtag` arm for exactly that at
    the end of this function. This guard runs as a HOISTED statement, i.e.
    BEFORE any arm is evaluated, so leaving it objtag-only made the str arm
    unreachable: `it.upper()` over `["hello"]` in a program that also has a
    class declaring `upper` raised AttributeError before the ternary ran. That
    is the whole reason the str/class collision could not simply be dispatched.

    Widened by NAME only, because the arity that decides whether the str arm is
    actually built is not known until the argument list is parsed, further
    below. When the arm turns out not to fit, the raise is restored there — see
    the `smArmBuilt` fixup after the arms. }
  smArmPossible := PyStrMethodInfo(mname, smPName, smTk, smArgs) and (smArgs <> -4);
  if smArmPossible then
  begin
    i := FindProc('pyvar_is_strtag');
    if i < 0 then Error('Nil Python: pylib (pyvar_is_strtag) not loaded');
    smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(vtTmpSym);
    smGuardCall := AllocNode(AN_CALL);
    ASTIVal[smGuardCall] := i; ASTTk[smGuardCall] := Ord(tyBoolean);
    ASTLeft[smGuardCall] := smArg1;
    smNotNode := AllocNode(AN_BINOP);
    ASTIVal[smNotNode] := Ord(tkOr);
    ASTLeft[smNotNode] := vtGuardCall;
    ASTRight[smNotNode] := smGuardCall;
    ASTTk[smNotNode] := Ord(tyBoolean);
    vtGuardCall := smNotNode;
  end;
  { …and the same widening for a FLOAT receiver, for the four float methods.
    Same reasoning as the str arm above and the same fixup below when the arm
    turns out not to fit: the guard is hoisted BEFORE the argument list is
    parsed, so it can only be widened by NAME here, and all four names take no
    arguments. `hex` is why this is a tag arm and not a name-only intercept —
    bytes.hex() is a real method that must keep reaching TPyBytes, and it does:
    that receiver carries tag 7 and lands on the class arms.
    bug-nilpy-float-methods-are-invisible-to-the-runtime-dispatcher }
  flArmPossible := PyIsFloatMethodName(LowerCase(mname));
  if flArmPossible then
  begin
    i := FindProc('pyvar_is_floattag');
    if i < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
    flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(vtTmpSym);
    flGuardCall := AllocNode(AN_CALL);
    ASTIVal[flGuardCall] := i; ASTTk[flGuardCall] := Ord(tyBoolean);
    ASTLeft[flGuardCall] := flArg1;
    { …and the INT tag for the three names int shares, same as the float-first
      block above: a user class declaring `is_integer` is what routes the call
      here, and an int in the same container must still answer. }
    if PyIsIntFloatSharedMethodName(LowerCase(mname)) then
    begin
      i := FindProc('pyvar_is_inttag');
      if i < 0 then Error('Nil Python: pylib (pyvar_is_inttag) not loaded');
      flArg2 := AllocNode(AN_ARG); ASTLeft[flArg2] := PyMakeIdent(vtTmpSym);
      flUnboxCall := AllocNode(AN_CALL);
      ASTIVal[flUnboxCall] := i; ASTTk[flUnboxCall] := Ord(tyBoolean);
      ASTLeft[flUnboxCall] := flArg2;
      flOrNode := AllocNode(AN_BINOP);
      ASTIVal[flOrNode] := Ord(tkOr);
      ASTLeft[flOrNode] := flGuardCall;
      ASTRight[flOrNode] := flUnboxCall;
      ASTTk[flOrNode] := Ord(tyBoolean);
      flGuardCall := flOrNode;
    end;
    flOrNode := AllocNode(AN_BINOP);
    ASTIVal[flOrNode] := Ord(tkOr);
    ASTLeft[flOrNode] := vtGuardCall;
    ASTRight[flOrNode] := flGuardCall;
    ASTTk[flOrNode] := Ord(tyBoolean);
    vtGuardCall := flOrNode;
  end;
  vtNotNode := AllocNode(AN_NOT);
  ASTLeft[vtNotNode] := vtGuardCall; ASTTk[vtNotNode] := Ord(tyBoolean);

  i := FindProc('pydynattr_no_method');
  if i < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
  vtNameArg := AllocNode(AN_STR_LIT);
  ASTSOffset[vtNameArg] := PyStoredName(mname);
  ASTSLen[vtNameArg] := Length(mname);
  ASTTk[vtNameArg] := Ord(tyString);
  vtArg2 := AllocNode(AN_ARG); ASTLeft[vtArg2] := vtNameArg; ASTRight[vtArg2] := -1;
  vtArg1 := AllocNode(AN_ARG); ASTLeft[vtArg1] := PyMakeIdent(vtTmpSym); ASTRight[vtArg1] := vtArg2;
  vtRaiseCall := AllocNode(AN_CALL);
  ASTIVal[vtRaiseCall] := i; ASTTk[vtRaiseCall] := Ord(tyUnknown);
  ASTLeft[vtRaiseCall] := vtArg1;

  vtIfNode := AllocNode(AN_IF);
  ASTLeft[vtIfNode] := vtNotNode;
  vtPairNode := AllocNode(AN_PAIR);
  ASTLeft[vtPairNode] := vtRaiseCall; ASTRight[vtPairNode] := -1;
  ASTRight[vtIfNode] := vtPairNode;
  PyHoistStmt(vtIfNode);

  { VT_OBJECT payload -> instance pointer -> hard cast to the owning class }
  unboxArg := AllocNode(AN_ARG);
  ASTLeft[unboxArg] := baseNode;
  unboxCall := AllocNode(AN_CALL);
  ASTIVal[unboxCall] := FindProc('pyvarobj');
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;
  castNode := AllocNode(AN_CLASS_CAST);
  ASTLeft[castNode] := unboxCall;
  ASTIVal[castNode] := hitCi;
  ASTTk[castNode]   := Ord(tyClass);

  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := castNode;
  lastArg := selfArg;

  Expect(tkLParen, '(');
  i := 0;
  anyKw := False;
  while CurTok.Kind <> tkRParen do
  begin
    { Keyword arguments here too — `detector.to_text(verbose=True)` on a
      dynamically-typed receiver. They bind against the STATICALLY chosen
      method; a runtime candidate re-uses the reordered argument list, which is
      right as long as the candidates agree on parameter order, and they do
      when they agree on the name and arity that got them here. }
    { `m.update(a=1)` / `m.update(**e)` on this dynamic path: the keyword run is
      the ONE dict argument, built by the same PyBuildKeywordDict every other
      argument loop asks for, so the dynamic and static receivers cannot drift. }
    kwDictNode := PyKwDictArgNode(hitPi);
    if kwDictNode >= 0 then
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := kwDictNode;
      ASTIVal[argNode] := 0;                  { positional, not a keyword }
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
      Inc(i);
      Break;
    end;
    { a starred argument on a dynamically-dispatched receiver — same expansion
      as the statically-bound method path above }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) and (ProcPyStarIdx[hitPi] < 0) then
    begin
      kwIdx := selfArg;
      PyStarExpandCallArgs(hitPi, i + 1, kwIdx, lastArg);
      i := Procs[hitPi].ParamCount - 1;
      Break;
    end;
    kwIdx := PyKwArgIndex(hitPi, 1);
    if kwIdx <> 0 then anyKw := True;
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTIVal[argNode] := kwIdx;
    ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(i);
    if CurTok.Kind = tkComma then Next
    else Break;
  end;
  Expect(tkRParen, ')');
  { `*args` / `**kwargs` on a METHOD: pack the surplus arguments before the
    keyword bind, exactly as the top-level call path does. Self occupies slot 0
    of the parameter list, so the counter is passed INCLUDING it and the
    argument count is re-derived afterwards. }
  if (ProcPyStarIdx[hitPi] >= 0) or (ProcPyKwIdx[hitPi] >= 0) then
  begin
    i := i + 1;
    PyPackStarArgs(hitPi, selfArg, lastArg, i, 0);
    if i > 0 then Dec(i);
    anyKw := False;   { the packing consumed every keyword argument }
  end;
  if anyKw then
  begin
    { PyBindKwArgs orders the chain (self is slot 0, exactly as the ordinary
      method path uses it) and fills omitted defaults, so `i` is re-derived from
      the bound chain rather than from how many arguments were written. }
    i := 0;
    PyBindKwArgs(hitPi, selfArg, lastArg, i);
    if i > 0 then Dec(i);          { drop self from the argument count }
  end;
  { the per-argument nodes the runtime-dispatch arms re-use, in bound order }
  argNode := ASTRight[selfArg];
  k := 0;
  while (argNode >= 0) and (k <= High(argExprs)) do
  begin
    argExprs[k] := ASTLeft[argNode];
    Inc(k);
    argNode := ASTRight[argNode];
  end;

  { Overload selection by the ACTUAL argument count. The candidate scan above
    picked the first method named `mname`; a class like TPyDict declares `get(k)`
    AND `get(k, d)` as overloads, so a 2-arg `.get(key, default)` on a variant
    receiver would otherwise bind to the 1-arg body and pass a stray argument
    (crash). Re-resolve within the chosen class by arity now that `i` is known. }
  if hitCi >= 0 then
  begin
    mmi := FindUMethArity(hitCi, PyMethNameFor(hitCi, mname), i);
    if mmi >= 0 then begin hitMmi := mmi; hitPi := UMthProc_[mmi]; end;
    { ...and among the same-ARITY overloads, by argument TYPE, exactly as the
      class-typed path does. Arity alone is not enough: TPyDict.update declares
      update(TPyList), update(TPyDict) and update(const Variant) all at arity 1
      and the first always won, so `xs[0].update(d)` on a dict element walked a
      TPyDict as a TPyList and SEGFAULTED — while the identical call on a bare
      name was fine, because that path already scores the arguments.
      bug-nilpy-dict-update-through-a-variant-receiver-picks-the-list-overload }
    ovlMmi := PyPickOverloadByArgTypes(hitCi, PyMethNameFor(hitCi, mname),
                                       i, selfArg, hitMmi);
    if ovlMmi >= 0 then begin hitMmi := ovlMmi; hitPi := UMthProc_[ovlMmi]; end;
  end;

  mpi := hitPi;
  { ARITY, for the STATICALLY-RESOLVED arm only — same hole as the one guarded
    in PyParseClassMethodCall, reached whenever the receiver is a NAME rather
    than a literal (`xs = [1,2,3]` then `xs.index()`), which is the ordinary way
    to write it. FindUMethArity falls back to the first name match, so the test
    above cannot reject, and the default-fill below only fills parameters that
    HAVE defaults — leaving a required argument uninitialised
    (bug-nilpy-too-few-args-to-container-method-compiles-and-segfaults).
    Guarded on hitCi >= 0: only there is the class known at compile time. When
    dispatch is genuinely dynamic (hitCi < 0, or the dual/runtime arms below,
    where distinct candidate classes may legitimately take different counts) a
    compile error would reject valid programs, so those keep today's behaviour
    and want a RUNTIME arity check instead — filed separately. }
  if (hitCi >= 0) and (ProcPyStarIdx[mpi] < 0) and (ProcPyKwIdx[mpi] < 0) and
     (not ProcArityMatches(mpi, i + 1)) then
  begin
    { …unless the argument count fits the STR row of the same name. `s.find("b",
      1)` is Python's optional-start form and perfectly valid, but the class
      whose `find` took one argument is what got this call here, so the check
      above rejected the program at COMPILE time. Only the str spelling can be
      meant at this arity, so build it alone, behind the same tag guard the
      str-first path uses: a receiver that is not a string raises AttributeError
      at run time rather than the whole file failing to compile. }
    if smArmPossible and PyStrMethodArityOk(mname, i) and
       (i <= High(argExprs) + 1) then
    begin
      k := FindProc('pyvar_is_strtag');
      if k < 0 then Error('Nil Python: pylib (pyvar_is_strtag) not loaded');
      smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(vtTmpSym);
      smGuardCall := AllocNode(AN_CALL);
      ASTIVal[smGuardCall] := k; ASTTk[smGuardCall] := Ord(tyBoolean);
      ASTLeft[smGuardCall] := smArg1;
      smNotNode := AllocNode(AN_NOT);
      ASTLeft[smNotNode] := smGuardCall; ASTTk[smNotNode] := Ord(tyBoolean);

      k := FindProc('pydynattr_no_method');
      if k < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
      smNameArg := AllocNode(AN_STR_LIT);
      ASTSOffset[smNameArg] := PyStoredName(mname);
      ASTSLen[smNameArg] := Length(mname);
      ASTTk[smNameArg] := Ord(tyString);
      smArg2 := AllocNode(AN_ARG); ASTLeft[smArg2] := smNameArg; ASTRight[smArg2] := -1;
      smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(vtTmpSym);
      ASTRight[smArg1] := smArg2;
      smRaiseCall := AllocNode(AN_CALL);
      ASTIVal[smRaiseCall] := k; ASTTk[smRaiseCall] := Ord(tyUnknown);
      ASTLeft[smRaiseCall] := smArg1;
      smIfNode := AllocNode(AN_IF);
      ASTLeft[smIfNode] := smNotNode;
      smPairNode := AllocNode(AN_PAIR);
      ASTLeft[smPairNode] := smRaiseCall; ASTRight[smPairNode] := -1;
      ASTRight[smIfNode] := smPairNode;
      PyHoistStmt(smIfNode);

      k := FindProc('pystr_of');
      if k < 0 then Error('Nil Python: pylib (pystr_of) not loaded');
      unboxArg := AllocNode(AN_ARG);
      ASTLeft[unboxArg] := PyMakeIdent(vtTmpSym);
      unboxCall := AllocNode(AN_CALL);
      ASTIVal[unboxCall] := k;
      ASTTk[unboxCall] := Ord(tyAnsiString);
      ASTLeft[unboxCall] := unboxArg;
      dself := AllocNode(AN_ARG);
      ASTLeft[dself] := unboxCall;
      lastArg := dself;
      for k := 0 to i - 1 do
      begin
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := argExprs[k];
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
      end;
      Result := PyStrMethodFinish(mname, dself, lastArg, i);
      LastExprTk := IntToTypeKind(ASTTk[Result]);
      Exit;
    end;
    k := Procs[mpi].ParamCount - 1;      { explicit params, Self dropped }
    while (k > 0) and (k < MAX_PROC_PARAMS) and
          ProcParamHasDefault[mpi * MAX_PROC_PARAMS + k] do Dec(k);
    if k = Procs[mpi].ParamCount - 1 then
      Error('Nil Python: ' + mname + '() takes exactly ' + AIntToStr(k) +
            ' argument(s), got ' + AIntToStr(i))
    else
      Error('Nil Python: ' + mname + '() takes ' + AIntToStr(k) + ' to ' +
            AIntToStr(Procs[mpi].ParamCount - 1) + ' arguments, got ' + AIntToStr(i));
  end;
  { Fill the callee's remaining DEFAULTED parameters. The runtime arms below do
    this; the STATIC arm did not, so a dispatched `det.analyze(chords, fn)`
    against `analyze(self, chords, fn, sections=None)` called a 4-parameter
    method with 3 and the callee read an uninitialised slot — it crashed only
    when the receiver was dynamically typed, which is what made it look like a
    dispatch bug rather than a missing fill. }
  k := i + 1;
  while (k < Procs[mpi].ParamCount) and (k < MAX_PROC_PARAMS) and
        ProcParamHasDefault[mpi * MAX_PROC_PARAMS + k] do
  begin
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := DefaultArgValueNode(mpi, k);
    ASTRight[argNode] := -1;
    ASTRight[lastArg] := argNode;
    lastArg := argNode;
    Inc(k);
  end;
  if UMthVirSlot[hitMmi] >= 0 then
  begin
    callNode := AllocNode(AN_VIRTUAL_CALL);
    ASTRight[callNode] := UMthVirSlot[hitMmi];
  end
  else
    callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := mpi;
  ASTTk[callNode] := Ord(Procs[mpi].RetType);
  ASTLeft[callNode] := selfArg;
  LastExprTk := Procs[mpi].RetType;
  Result := callNode;

  { Do the candidates agree on a return type? Computed ONCE, before any arm is
    built — see the note where it is used. }
  dualRetMixed := False;
  for di := 0 to nDual - 1 do
  begin
    mmi := FindUMethArity(dualCis[di], PyMethNameFor(dualCis[di], mname), i);
    if mmi < 0 then mmi := dualMmis[di];
    if mmi < 0 then Continue;
    { The KIND is not enough: two candidates can both return tyClass and return
      DIFFERENT classes (`beginText` gives the reportlab shim's PDFTextObject or
      render_backend's _TkTextObject). Typed from the static pick, the next
      method call on the result compiled as a STATIC call into the wrong class
      and jumped through its layout — songformatter's preview died on
      `tx.setFont(...)` that way. Compare the returned RECORD too. }
    if (Procs[UMthProc_[mmi]].RetType <> Procs[mpi].RetType) or
       (ProcRetRecId[UMthProc_[mmi]] <> ProcRetRecId[mpi]) then dualRetMixed := True;
  end;

  { RUNTIME dual dispatch: the receiver may be one of the remembered pylib
    CONTAINERS rather than the statically-preferred class. For each container
    candidate, wrap: `pyvar_holds(recv, k) ? <container call> : <fallback>` —
    recv/arg expression nodes are shared across arms (side-effect-free in the
    corpus; the b346 re-emission caveat applies). }
  if (nDual > 0) and (i <= High(argExprs) + 1) then
    for di := 0 to nDual - 1 do
    begin
      mmi := FindUMethArity(dualCis[di], PyMethNameFor(dualCis[di], mname), i);
      if mmi < 0 then mmi := dualMmis[di];
      if mmi < 0 then Continue;
      { ...and by argument TYPE among the same-arity overloads, as the static
        arm above now does. This is the arm a DICT reached: `xs[0].update(d)`
        dispatched correctly to the TPyDict candidate and then called its
        update(TPyList) overload — first by declaration, and arity cannot tell
        the three apart — so a TPyDict was walked as a TPyList and SEGFAULTED.
        bug-nilpy-dict-update-through-a-variant-receiver-picks-the-list-overload }
      ovlMmi := PyPickOverloadByArgTypes(dualCis[di],
                  PyMethNameFor(dualCis[di], mname), i, selfArg, mmi);
      if ovlMmi >= 0 then mmi := ovlMmi;
      dualPi := UMthProc_[mmi];
      { The runtime candidate may declare MORE parameters than the call wrote,
        with defaults — `to_text(self, verbose=False)` reached by a bare
        `it.to_text()`. The arm builds its own argument chain, so it never passes
        through the shared fill; without this the callee read an uninitialised
        slot and crashed. A candidate that cannot be completed is dropped rather
        than called short. }
      dualArgs := i;
      k := dualArgs + 1;
      while (k < Procs[dualPi].ParamCount) and (k < MAX_PROC_PARAMS) and
            ProcParamHasDefault[dualPi * MAX_PROC_PARAMS + k] do
      begin
        Inc(dualArgs);
        Inc(k);
      end;
      if dualArgs + 1 <> Procs[dualPi].ParamCount then Continue;
      unboxArg := AllocNode(AN_ARG);
      ASTLeft[unboxArg] := baseNode;
      unboxCall := AllocNode(AN_CALL);
      ASTIVal[unboxCall] := FindProc('pyvarobj');
      ASTTk[unboxCall] := Ord(tyPointer);
      ASTLeft[unboxCall] := unboxArg;
      dcast := AllocNode(AN_CLASS_CAST);
      ASTLeft[dcast] := unboxCall;
      ASTIVal[dcast] := dualCis[di];
      ASTTk[dcast] := Ord(tyClass);
      dself := AllocNode(AN_ARG);
      ASTLeft[dself] := dcast;
      lastArg := dself;
      for k := 0 to i - 1 do
      begin
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := argExprs[k];
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
      end;
      for k := i to dualArgs - 1 do
      begin
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := DefaultArgValueNode(dualPi, k + 1);
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
      end;
      if UMthVirSlot[mmi] >= 0 then
      begin
        dcall := AllocNode(AN_VIRTUAL_CALL);
        ASTRight[dcall] := UMthVirSlot[mmi];
      end
      else
        dcall := AllocNode(AN_CALL);
      ASTIVal[dcall] := dualPi;
      ASTTk[dcall] := Ord(Procs[dualPi].RetType);
      ASTLeft[dcall] := dself;

      if PyIsPylibContainerCi(dualCis[di]) then
      begin
        { cond: pyvar_holds(recv, kind) }
        unboxArg := AllocNode(AN_ARG);
        ASTLeft[unboxArg] := baseNode;
        condN := AllocNode(AN_INT_LIT);
        if dualCis[di] = FindUClass('TPyList') then ASTIVal[condN] := 1
        else if dualCis[di] = FindUClass('TPyDict') then ASTIVal[condN] := 2
        else ASTIVal[condN] := 3;
        ASTTk[condN] := Ord(tyInt64);
        unboxCall := AllocNode(AN_ARG);
        ASTLeft[unboxCall] := condN;
        ASTRight[unboxArg] := unboxCall;
        condN := AllocNode(AN_CALL);
        ASTIVal[condN] := FindProc('pyvar_holds');
        if ASTIVal[condN] < 0 then Error('Nil Python: pylib (pyvar_holds) not loaded');
        ASTTk[condN] := Ord(tyBoolean);
        ASTLeft[condN] := unboxArg;
      end
      else
      begin
        { cond: pyvarobj(recv) is <that user class> — the same test isinstance
          lowers to, which is what makes an unrelated-user-class candidate
          dispatchable at all. }
        unboxArg := AllocNode(AN_ARG);
        ASTLeft[unboxArg] := baseNode;
        unboxCall := AllocNode(AN_CALL);
        ASTIVal[unboxCall] := FindProc('pyvarobj');
        if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
        ASTTk[unboxCall] := Ord(tyPointer);
        ASTLeft[unboxCall] := unboxArg;
        condN := AllocNode(AN_IS_TEST);
        ASTLeft[condN] := unboxCall;
        ASTIVal[condN] := dualCis[di];
        ASTTk[condN] := Ord(tyBoolean);
      end;

      pairN := AllocNode(AN_PAIR);
      ASTLeft[pairN] := dcall;
      ASTRight[pairN] := Result;
      tern := AllocNode(AN_TERNARY);
      ASTLeft[tern] := condN;
      ASTRight[tern] := pairN;
      { The type of the WHOLE chain, not of this arm: if ANY candidate returns
        something else, the expression is dynamic. Set per-arm, one arm that
        happened to agree with the static pick re-typed the chain — a variant
        LIST coming back from TPyDict.get was then assigned into an AnsiString
        and stringified to nothing, while an int survived (it stringifies to
        its digits). `d.get(k)` on a json value silently returned '' in any
        program that also imported a module exporting `get`. }
      if dualRetMixed then
        ASTTk[tern] := Ord(tyVariant)
      else
        ASTTk[tern] := Ord(Procs[mpi].RetType);
      LastExprTk := IntToTypeKind(ASTTk[tern]);
      Result := tern;
    end;

  { THE STRING ARM — `pyvar_is_strtag(recv) ? <str method> : <everything above>`.

    A str-method name that a user class also declares (`find`, `index`, `count`,
    `title`, `split`, ...) is undecidable in the frontend: the receiver is a
    variant, and only its RUNTIME tag says whether `c.find(t)` means str.find or
    the class's own find. Both previous answers were a compile-time guess, and
    each was wrong for one of the two receivers — a tree walker's `c.find(t)`
    raised AttributeError naming a method its class plainly declares, while the
    two names hardcoded the other way (`title`, `count`) silently lost the str
    spelling for a receiver that really was a string.

    So the choice moves to run time, as one more arm of the dispatcher already
    built above — the same machine that tells TPyList.pop from a user class's
    pop. Added LAST, which makes it the OUTERMOST test: a genuine string still
    gets str-first priority, which is the property the dynamically-typed corpus
    relies on and the one that makes this change safe.

    The arguments are the ones already parsed into argExprs, shared with the
    other arms — so they are parsed once and evaluated once, which is what made
    the frontend two-branch version (parse the argument list twice, or teach
    PyParseStrMethod to not parse) not worth building.
    bug-nilpy-user-method-named-like-a-str-method-raises-on-a-variant-receiver }
  if smArmPossible and (i <= High(argExprs) + 1) then
  begin
    { receiver: pystr_of(recv) — the same rendering the str-first path uses, and
      it is only ever reached when the tag says the value IS a string. }
    k := FindProc('pystr_of');
    if k < 0 then Error('Nil Python: pylib (pystr_of) not loaded');
    unboxArg := AllocNode(AN_ARG);
    ASTLeft[unboxArg] := baseNode;
    unboxCall := AllocNode(AN_CALL);
    ASTIVal[unboxCall] := k;
    ASTTk[unboxCall] := Ord(tyAnsiString);
    ASTLeft[unboxCall] := unboxArg;

    dself := AllocNode(AN_ARG);
    ASTLeft[dself] := unboxCall;
    lastArg := dself;
    for k := 0 to i - 1 do
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := argExprs[k];
      ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
    { PyStrMethodFinish resolves the arity-suffixed pylib proc ('' / '_from' /
      '_range' / '_chars' / ...) — the same resolution PyParseStrMethod uses,
      shared rather than re-derived. It ERRORS on an arity the row does not
      accept, which would be a hard failure on a program the class arm can
      compile, so the arity is checked first and the arm is simply dropped when
      it does not fit: `n.find(a, b, c, d)` on a class whose find takes four is
      a class call, not a str call. }
    if PyStrMethodArityOk(mname, i) then
    begin
      dcall := PyStrMethodFinish(mname, dself, lastArg, i);

      k := FindProc('pyvar_is_strtag');
      if k < 0 then Error('Nil Python: pylib (pyvar_is_strtag) not loaded');
      unboxArg := AllocNode(AN_ARG);
      ASTLeft[unboxArg] := baseNode;
      condN := AllocNode(AN_CALL);
      ASTIVal[condN] := k;
      ASTTk[condN] := Ord(tyBoolean);
      ASTLeft[condN] := unboxArg;

      pairN := AllocNode(AN_PAIR);
      ASTLeft[pairN] := dcall;
      ASTRight[pairN] := Result;
      tern := AllocNode(AN_TERNARY);
      ASTLeft[tern] := condN;
      ASTRight[tern] := pairN;
      { Same rule as the class arms: the type of the WHOLE chain. A str method
        returning Integer (`find`) beside a class method returning a string is a
        genuinely dynamic expression, and typing it from either arm alone is how
        a value gets silently stringified to nothing. }
      if IntToTypeKind(ASTTk[dcall]) <> IntToTypeKind(ASTTk[Result]) then
        ASTTk[tern] := Ord(tyVariant)
      else
        ASTTk[tern] := ASTTk[dcall];
      LastExprTk := IntToTypeKind(ASTTk[tern]);
      Result := tern;
      smArmBuilt := True;
    end;
  end;
  { THE FLOAT ARM — `pyvar_is_floattag(recv) ? <float method> : <everything
    above>`. The str arm's construction with one substitution: the receiver is
    unboxed with pyvar_to_float rather than rendered with pystr_of, and the four
    names take no arguments, so the arity test is `i = 0` rather than a row
    lookup. Added after the str arm, which makes IT the outermost test; the two
    name sets are disjoint (str has no hex/is_integer/conjugate/
    as_integer_ratio), so the order is not load-bearing today and the nesting is
    kept in one direction on purpose.

    The value this fixes is the ordinary one: `for v in vals: print(v.hex())`.
    A loop variable, a list element and an unannotated parameter are all
    variants, and the static intercepts that claim these four names need a
    receiver they can type. }
  if flArmPossible and (i = 0) then
  begin
    flUnboxArg := AllocNode(AN_ARG);
    ASTLeft[flUnboxArg] := PyMakeIdent(vtTmpSym);
    flUnboxCall := AllocNode(AN_CALL);
    ASTIVal[flUnboxCall] := FindProc('pyvar_to_float');
    if ASTIVal[flUnboxCall] < 0 then
      Error('Nil Python: pylib (pyvar_to_float) not loaded');
    ASTTk[flUnboxCall] := Ord(tyDouble);
    ASTLeft[flUnboxCall] := flUnboxArg;

    flCall := PyMakeFloatMethodOn(flUnboxCall, LowerCase(mname), False);

    { the int flavour, chosen at run time by the tag — the same two-form shape
      the float-first block builds, here nested INSIDE the arm so the class
      candidates stay the outer alternative. }
    if PyIsIntFloatSharedMethodName(LowerCase(mname)) then
    begin
      k := FindProc('pyvar_to_int');
      if k < 0 then Error('Nil Python: pylib (pyvar_to_int) not loaded');
      flArg2 := AllocNode(AN_ARG); ASTLeft[flArg2] := PyMakeIdent(vtTmpSym);
      flUnboxCall := AllocNode(AN_CALL);
      ASTIVal[flUnboxCall] := k; ASTTk[flUnboxCall] := Ord(tyInt64);
      ASTLeft[flUnboxCall] := flArg2;
      flRaiseCall := PyMakeFloatMethodOn(flUnboxCall, LowerCase(mname), True);

      k := FindProc('pyvar_is_floattag');
      if k < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
      flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(vtTmpSym);
      flNotNode := AllocNode(AN_CALL);
      ASTIVal[flNotNode] := k; ASTTk[flNotNode] := Ord(tyBoolean);
      ASTLeft[flNotNode] := flArg1;

      flPair2 := AllocNode(AN_PAIR);
      ASTLeft[flPair2] := flCall;
      ASTRight[flPair2] := flRaiseCall;
      flOrNode := AllocNode(AN_TERNARY);
      ASTLeft[flOrNode] := flNotNode;
      ASTRight[flOrNode] := flPair2;
      if IntToTypeKind(ASTTk[flCall]) <> IntToTypeKind(ASTTk[flRaiseCall]) then
        ASTTk[flOrNode] := Ord(tyVariant)
      else
        ASTTk[flOrNode] := ASTTk[flCall];
      flCall := flOrNode;
    end;

    k := FindProc('pyvar_is_floattag');
    if k < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
    flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(vtTmpSym);
    flGuardCall := AllocNode(AN_CALL);
    ASTIVal[flGuardCall] := k; ASTTk[flGuardCall] := Ord(tyBoolean);
    ASTLeft[flGuardCall] := flArg1;
    if PyIsIntFloatSharedMethodName(LowerCase(mname)) then
    begin
      k := FindProc('pyvar_is_inttag');
      if k < 0 then Error('Nil Python: pylib (pyvar_is_inttag) not loaded');
      flArg2 := AllocNode(AN_ARG); ASTLeft[flArg2] := PyMakeIdent(vtTmpSym);
      flNotNode := AllocNode(AN_CALL);
      ASTIVal[flNotNode] := k; ASTTk[flNotNode] := Ord(tyBoolean);
      ASTLeft[flNotNode] := flArg2;
      flOrNode := AllocNode(AN_BINOP);
      ASTIVal[flOrNode] := Ord(tkOr);
      ASTLeft[flOrNode] := flGuardCall;
      ASTRight[flOrNode] := flNotNode;
      ASTTk[flOrNode] := Ord(tyBoolean);
      flGuardCall := flOrNode;
    end;

    flPairNode := AllocNode(AN_PAIR);
    ASTLeft[flPairNode] := flCall;
    ASTRight[flPairNode] := Result;
    flTern := AllocNode(AN_TERNARY);
    ASTLeft[flTern] := flGuardCall;
    ASTRight[flTern] := flPairNode;
    { Same rule as every other arm: the type of the WHOLE chain. `hex` returns
      a string and `is_integer` a boolean, so an arm that disagrees with the
      class arm makes the expression genuinely dynamic — typing it from either
      side alone is how a value gets silently stringified to nothing. }
    if IntToTypeKind(ASTTk[flCall]) <> IntToTypeKind(ASTTk[Result]) then
      ASTTk[flTern] := Ord(tyVariant)
    else
      ASTTk[flTern] := ASTTk[flCall];
    LastExprTk := IntToTypeKind(ASTTk[flTern]);
    Result := flTern;
    flArmBuilt := True;
  end;
  { The float half of the unkept-promise fixup below: the guard was widened to
    let a float receiver through, and if no arm was built (the call wrote
    arguments, which none of the four take) a float receiver would reach the
    hard object cast. Put the raise back for exactly that case. }
  if flArmPossible and (not flArmBuilt) then
  begin
    k := FindProc('pyvar_is_floattag');
    if k < 0 then Error('Nil Python: pylib (pyvar_is_floattag) not loaded');
    flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(vtTmpSym);
    flGuardCall := AllocNode(AN_CALL);
    ASTIVal[flGuardCall] := k; ASTTk[flGuardCall] := Ord(tyBoolean);
    ASTLeft[flGuardCall] := flArg1;

    k := FindProc('pydynattr_no_method');
    if k < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
    flNotNode := AllocNode(AN_STR_LIT);
    ASTSOffset[flNotNode] := PyStoredName(mname);
    ASTSLen[flNotNode] := Length(mname);
    ASTTk[flNotNode] := Ord(tyString);
    flArg2 := AllocNode(AN_ARG); ASTLeft[flArg2] := flNotNode; ASTRight[flArg2] := -1;
    flArg1 := AllocNode(AN_ARG); ASTLeft[flArg1] := PyMakeIdent(vtTmpSym);
    ASTRight[flArg1] := flArg2;
    flRaiseCall := AllocNode(AN_CALL);
    ASTIVal[flRaiseCall] := k; ASTTk[flRaiseCall] := Ord(tyUnknown);
    ASTLeft[flRaiseCall] := flArg1;

    flIfNode := AllocNode(AN_IF);
    ASTLeft[flIfNode] := flGuardCall;
    flPair2 := AllocNode(AN_PAIR);
    ASTLeft[flPair2] := flRaiseCall; ASTRight[flPair2] := -1;
    ASTRight[flIfNode] := flPair2;
    PyHoistStmt(flIfNode);
  end;
  { The objtag guard above was widened to let a STRING receiver through on the
    promise of a str arm. If no arm was built after all — the argument count
    does not fit the str row, so the call can only have meant the class method —
    that promise is unkept and a string receiver would reach the hard cast. Put
    the raise back for exactly that case, so the widening can never turn a clean
    AttributeError into a wild dereference. }
  if smArmPossible and (not smArmBuilt) then
  begin
    k := FindProc('pyvar_is_strtag');
    if k < 0 then Error('Nil Python: pylib (pyvar_is_strtag) not loaded');
    smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(vtTmpSym);
    smGuardCall := AllocNode(AN_CALL);
    ASTIVal[smGuardCall] := k; ASTTk[smGuardCall] := Ord(tyBoolean);
    ASTLeft[smGuardCall] := smArg1;

    k := FindProc('pydynattr_no_method');
    if k < 0 then Error('Nil Python: pylib (pydynattr_no_method) not loaded');
    smNameArg := AllocNode(AN_STR_LIT);
    ASTSOffset[smNameArg] := PyStoredName(mname);
    ASTSLen[smNameArg] := Length(mname);
    ASTTk[smNameArg] := Ord(tyString);
    smArg2 := AllocNode(AN_ARG); ASTLeft[smArg2] := smNameArg; ASTRight[smArg2] := -1;
    smArg1 := AllocNode(AN_ARG); ASTLeft[smArg1] := PyMakeIdent(vtTmpSym);
    ASTRight[smArg1] := smArg2;
    smRaiseCall := AllocNode(AN_CALL);
    ASTIVal[smRaiseCall] := k; ASTTk[smRaiseCall] := Ord(tyUnknown);
    ASTLeft[smRaiseCall] := smArg1;

    smIfNode := AllocNode(AN_IF);
    ASTLeft[smIfNode] := smGuardCall;
    smPairNode := AllocNode(AN_PAIR);
    ASTLeft[smPairNode] := smRaiseCall; ASTRight[smPairNode] := -1;
    ASTRight[smIfNode] := smPairNode;
    PyHoistStmt(smIfNode);
  end;
end;

{ A bare tuple display — `return a, b` or `x = 1, 2` — built from an ALREADY
  parsed first element, then the comma-separated rest. A tuple is a TPyList here
  (the representation isinstance and the annotation path already use), so this is
  the list-literal lowering with the brackets implied: bind a hidden temp, append
  onto it through hoisted statements, yield the temp as the expression. Keeping
  the temp is what lets the value be borrowed and reclaimed like any literal.

  Mutability and hashability are the documented differences from CPython; see the
  tuple annotation note in PyAnnTypeTermAt. }
function PyMakeTupleFromArgs(firstArg: Integer): Integer;
{ A PYSEQ_TUPLE TPyList built from an already-parsed AN_ARG chain, returning the
  hidden temp's ident. The twin of PyMakeTupleFrom, which builds one from the
  CURSOR — this one cannot, because its elements have already been parsed into
  nodes by the caller.

  Each element node is used ONCE, in the append that goes into the tuple, which
  is the whole point: the multi-argument exception fold needs both a rendered
  message and the real argument tuple, and evaluating the arguments twice to get
  them would run any side effect twice. The message is derived from the tuple at
  run time instead.
  bug-nilpy-multi-arg-exception-args-is-a-1-tuple-of-rendered-text }
var ci, recId, node, argNode, sizeNode, callNode, selfArg, valArg, mmi, mpi,
    tmpSym, asgn, elemArg, kindSym: Integer;
begin
  ci := FindUClass('TPyList');
  if ci < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  tmpSym := AllocVar(PyHiddenName('exctup'), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  { mark it a TUPLE, not a list — `args` is a tuple in CPython, and isinstance
    and repr both read FKind. pylist_mark_tuple is a free function, not a
    method, so this is an ordinary call with the list as its one argument. }
  kindSym := FindProc('pylist_mark_tuple');
  if kindSym < 0 then Error('Nil Python: pylib (pylist_mark_tuple) not loaded');
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := PyMakeIdent(tmpSym);
  ASTRight[selfArg] := -1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := kindSym;
  ASTTk[callNode] := Ord(tyClass);
  ASTLeft[callNode] := selfArg;
  PyHoistStmt(callNode);
  mmi := FindUMeth(ci, 'append_self');
  if mmi < 0 then Error('Nil Python: TPyList.append_self not found');
  mpi := UMthProc_[mmi];
  elemArg := firstArg;
  while elemArg >= 0 do
  begin
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := PyForceVariant(ASTLeft[elemArg]);
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := valArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    elemArg := ASTRight[elemArg];
  end;
  Result := PyMakeIdent(tmpSym);
end;

function PyMakeTupleFrom(firstNode: Integer): Integer;
var ci, recId, node, argNode, sizeNode, callNode, selfArg, valArg, mmi, mpi,
    tmpSym, asgn, elemNode: Integer;
begin
  ci := FindUClass('TPyList');
  if ci < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  tmpSym := AllocVar(PyHiddenName('tup'), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  { append_self, not append: a list LITERAL desugars into a chain
    (Create.append_self(a).append_self(b)...), so this one needs the Self
    result. Python's append returns None
    (bug-nilpy-list-mutators-return-self-instead-of-none). }
  mmi := FindUMeth(ci, 'append_self');
  if mmi < 0 then Error('Nil Python: TPyList.append_self not found');
  mpi := UMthProc_[mmi];
  elemNode := firstNode;
  while True do
  begin
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := elemNode;
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := valArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    if CurTok.Kind <> tkComma then Break;
    Next;
    { a trailing comma closes the tuple: `return x,` is a 1-tuple }
    if CurTok.Kind in [tkNewline, tkDedent, tkEOF, tkRParen, tkRBrack] then Break;
    if CurTok.Kind = tkNil then
    begin
      Next;
      elemNode := PyMakeNone;
    end
    else
    begin
      PyParseBoolExpr;
      elemNode := CurASTNode;
    end;
  end;
  { Mark it a TUPLE, for rendering. A tuple and a list are the same TPyList here,
    so `print((1, 2))` printed `[1, 2]` — the one visible place the shared
    representation leaks (bug-nilpy-str-of-tuple-is-empty). The flag is set on
    the temp, so every later read of it renders with parentheses. }
  mpi := FindProc('pylist_mark_tuple');
  if mpi >= 0 then
  begin
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := -1;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
  end;
  Result := PyMakeIdent(tmpSym);
end;

{ A None VALUE: pylib's pynone() yields a variant tagged VT_EMPTY. }
{ Is the CURRENT token a `None` that stands alone — nothing after it that could
  continue an expression? A dozen sites substitute PyMakeNone the moment they
  see tkNil and consume it unconditionally, which is why `None == 0`,
  `None or "n"` and friends died with "unexpected token" while the identical
  expression one paren deeper parsed fine: the token was eaten before the
  operator could be seen. ParseFactor now yields the None VALUE itself under
  PyExprMode, so those sites only need to keep their shortcut for the bare case
  and hand anything else to the ordinary expression parser
  (bug-nilpy-none-equals-zero-is-true). }
{ Is this node a CALLABLE value — a bound method, a lifted lambda, a pyeval
  closure, a boxed function value or a bare code address? Used to refuse one
  where a STRING parameter is declared: the variant a bound method produces
  coerces into an AnsiString without complaint, and the {code, receiver} pair
  then travelled on as text. Tk was handed that as a script and evaluated
  garbage on every scroll update — a HANG inside root.update(), four layers from
  the cause, with no diagnostic anywhere
  (bug-nilpy-bound-method-coerced-to-string). }
function PyNodeIsCallableValue(n: Integer): Boolean;
var nm: AnsiString;
begin
  PyNodeIsCallableValue := False;
  if n < 0 then Exit;
  if ASTKind[n] = AN_PROCADDR then
  begin
    PyNodeIsCallableValue := True;
    Exit;
  end;
  if ASTKind[n] <> AN_CALL then Exit;
  if ASTIVal[n] < 0 then Exit;
  nm := LowerCase(Procs[ASTIVal[n]].Name);
  PyNodeIsCallableValue :=
    (nm = 'pybound_new') or (nm = 'pybound_new_star') or
    (nm = 'pyvar_of_callable') or
    (nm = 'pyclosure_src_new') or (nm = 'pyclosure_src_cap') or
    (nm = 'pyclosure_setarity') or
    (nm = 'pyboundfn_new') or (nm = 'pyboundfn_bind') or
    (nm = 'pyboundfn_setown') or (nm = 'pyboundfn_setdefaults') or
    (nm = 'pyboundfn_setstar') or (nm = 'pyboundfn_setsig') or
    (nm = 'pyboundfn_bind_var') or (nm = 'pyboundfn_bind_obj') or
    (nm = 'pyboundfn_bind_cell');
end;

function PyBareNoneHere: Boolean;
begin
  PyBareNoneHere := False;
  if CurTok.Kind <> tkNil then Exit;
  if TokPos >= TokCount then begin PyBareNoneHere := True; Exit; end;
  PyBareNoneHere := Tokens[TokPos].Kind in
    [tkNewline, tkDedent, tkIndent, tkEOF, tkComma, tkRParen, tkRBrack,
     tkEnd, tkColon, tkSemicolon];
end;

function PyNoneOperandHere: Boolean;
{ A DIFFERENT question from PyBareNoneHere, and the distinction is the whole of
  bug-nilpy-is-none-followed-by-and-or-else-takes-a-generic-compare.

  PyBareNoneHere's follow-set is load-bearing at its eight VALUE sites: each
  consumes the token and builds PyMakeNone without parsing further, so it must
  know the `None` is the WHOLE expression or `res = None or 5` would swallow the
  `None` and leave `or 5` dangling. There the list is the test those sites need.

  After `is` / `is not` the question is not "does anything follow" but "is this
  operand a None" — the `None` is the compare's right operand no matter what
  comes next, because PyParseBoolAnd / the ternary handle the rest. Asking the
  value sites' question there meant `b is None and True` fell out of the
  type-aware lowering entirely: `None` was parsed as an ordinary primary (a
  boxed VT_EMPTY variant) and compared to a managed string handle with a generic
  binop that tests nothing relevant, so the commonest compound None guard there
  is silently took the other branch.

  Widening the SHARED predicate is the fix that looks obvious and breaks the
  eight value sites. Hence a second predicate rather than three more tokens. }
begin
  PyNoneOperandHere := CurTok.Kind = tkNil;
end;

function PyMakeNone: Integer;
var procIdx: Integer;
begin
  procIdx := FindProc('pynone');
  if procIdx < 0 then Error('Nil Python: pylib (pynone) not loaded');
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyVariant);
  ASTLeft[Result] := -1;
end;

{ An empty TPyList / TPyDict bound to a hidden temp, built by HOISTED statements
  the way the literal parsers do (see PyParseListLiteralT for why the temp owns
  the construction ref). Returns the temp SYMBOL — the callers below append or
  store onto it and then yield PyMakeIdent(sym). }
function PyNewContainerTemp(const clsName, tag: AnsiString): Integer;
var ci, recId, node, argNode, sizeNode, tmpSym, asgn: Integer;
begin
  ci := FindUClass(clsName);
  if ci < 0 then Error('Nil Python: pylib (' + clsName + ') not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  tmpSym := AllocVar(PyHiddenName(tag), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  Result := tmpSym;
end;

{ One hoisted `tmp.<meth>(a [, b])` on a container temp. }
procedure PyContainerCall1(tmpSym: Integer; const clsName, meth: AnsiString;
                           argA, argB: Integer);
var ci, mmi, mpi, selfArg, aArg, bArg, callNode: Integer;
begin
  ci := FindUClass(clsName);
  if ci < 0 then Error('Nil Python: pylib (' + clsName + ') not loaded');
  mmi := FindUMeth(ci, meth);
  if mmi < 0 then Error('Nil Python: ' + clsName + '.' + meth + ' not found');
  mpi := UMthProc_[mmi];
  aArg := AllocNode(AN_ARG);
  ASTLeft[aArg] := argA;
  if argB >= 0 then
  begin
    bArg := AllocNode(AN_ARG);
    ASTLeft[bArg] := argB;
    ASTRight[aArg] := bArg;
  end;
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := PyMakeIdent(tmpSym);
  ASTRight[selfArg] := aArg;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := mpi;
  ASTTk[callNode] := Ord(tyClass);
  ASTLeft[callNode] := selfArg;
  PyHoistStmt(callNode);
end;

{ `get(*args, **kwargs)` FORWARDED into a callee with ORDINARY parameters — the
  third rung of feature-nilpy-star-args-kwargs, and what songformatter's
  settings.py getF/getI need. There is no static answer: the argument count is
  only known at run time. So this is a DESUGARING, not a runtime feature — a
  dispatch on len(args) over the arities the callee actually accepts:

      pystar_check_arity(args, required, total)      (hoisted, fails loudly)
      pystar_no_kwargs(kwargs)                       (hoisted, ditto)
      len(args) = 3 ? f(args[0], args[1], args[2])
                    : f(args[0], args[1])            ... down to the required count

  Each argument is `args.at(k)`, a variant, coerced to the parameter's declared
  type. A parameter type with no coercion is refused rather than passed raw.
  Keyword forwarding is checked at run time and refused: binding a runtime dict
  onto named parameters needs a call protocol NilPy does not have. }
function PyStarParamTakesVariant(procIdx, k: Integer): Boolean;
{ Can parameter k of procIdx receive a forwarded *args slot, which is always a
  VARIANT? True whenever something downstream knows how to land it: the
  parameter is itself a variant, it is a string (the forwarder converts with
  pystr_of), or IRLowerCallArg unboxes it at lowering time — as a scalar
  (IRVariantUnboxKind) or, tag-checked via pyvarobj_arg, as a class.

  The one predicate both the arity cap and the argument builder ask, so the
  "which arities can I build" answer cannot drift from the "what do I emit for
  this parameter" answer. }
var ptk: TTypeKind;
begin
  ptk := Procs[procIdx].Params[k].TypeKind;
  PyStarParamTakesVariant :=
    (ptk = tyVariant) or PyIsStrBaseTk(ptk) or (ptk = tyAnsiString) or
    IRVariantUnboxKind(ptk) or
    ((ptk = tyClass) and (not Procs[procIdx].Params[k].IsRef));
end;

function PyStarForwardCall(procIdx, listNode, dictNode: Integer): Integer;
var required, total, fwdTotal, n, k, i, argNode, lastArg, callNode, elemNode: Integer;
    nameNode, headNode, hasArg, hasCall: Integer;   { the parameter's name literal and the was-it-supplied test, for a kwargs fetch; the arg chain's head }
    lenNode, cntNode, condNode, pairNode, ternNode, chkArg, a2, a3: Integer;
    listSym, dictSym, asgn, listCi, dictCi, kwIdx: Integer;
    slotSyms: array[0..15] of Integer;
    ptk: TTypeKind;
begin
  listCi := FindUClass('TPyList');
  dictCi := FindUClass('TPyDict');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  { `f(*s)` spreads a str's characters. Normalised HERE rather than at the call
    site, because this is the second entry into star expansion —
    PyStarOperandAsList covers the other — and a str reaching the arity
    dispatch below is read as a list by pystar_argc, which answered 56 for a
    3-character string (bug-nilpy-join-of-a-str-segfaults). }
  { through the shared normalisation, not PyIterArgAsList alone: a VARIANT
    operand needs the RUN-TIME conversion too, and this path assigns straight
    into a TPyList-typed temp below — the same hard-cast hazard by another
    spelling. }
  listNode := PyStarOperandAsList(listNode, listCi);
  { bind both containers to temps: each arm reads the list again, and the
    expression must not be rebuilt per arm }
  listSym := AllocVar(PyHiddenName('fwd'), tyClass);
  Syms[listSym].RecName := REC_UCLASS_BASE + listCi;
  SymSyncTypeRef(listSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(listSym);
  ASTRight[asgn] := listNode;
  PyHoistStmt(asgn);
  dictSym := -1;
  if (dictNode >= 0) and (dictCi >= 0) then
  begin
    dictSym := AllocVar(PyHiddenName('fwdkw'), tyClass);
    Syms[dictSym].RecName := REC_UCLASS_BASE + dictCi;
    SymSyncTypeRef(dictSym);
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(dictSym);
    ASTRight[asgn] := dictNode;
    PyHoistStmt(asgn);
  end;

  total := Procs[procIdx].ParamCount;
  { A `**kwargs` COLLECTOR is not an ordinary named slot: it ABSORBS the
    forwarded dict whole, it fills no positional position, and it is never
    bound by looking up its own name as a key. ProcPyKwIdx records it (-1 =
    none) and four constructor paths already consult it; this one never did.
    So `def g(**kw)` was read as one named parameter called `kw`: the arity
    guard asserted "1 to 1" against a two-key dict, and the spread loop
    searched the dict for a key literally named "kw".
    bug-n-star-forwarder-spreads-a-dict-onto-a-kwargs-callee

    Scoped to kwIdx = 0 — a callee whose ONLY parameter is the collector, so
    the whole dict goes in and no key is consumed first. With named parameters
    beside it (`def f(a=1, **kw)`, kwIdx > 0) the collector must receive the
    UNCONSUMED keys, and there is no runtime helper for that remainder; adding
    one means pylib.pas, which is `compiler/builtin/**` and needs a PIN. Left
    exactly as it was rather than silently handing over the whole dict, which
    would answer len(kw) = 3 where CPython says 1. }
  kwIdx := -1;
  if dictSym >= 0 then kwIdx := ProcPyKwIdx[procIdx];
  if kwIdx > 0 then kwIdx := -1;   { the remainder case: unchanged }
  if kwIdx = 0 then total := 0;    { the collector fills no positional slot }
  required := total;
  while (required > 0) and (required - 1 < MAX_PROC_PARAMS) and
        ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + (required - 1)] do
    Dec(required);

  { The widest arity whose parameters can ALL take a forwarded variant. One
    unforwardable parameter used to refuse the whole call, but it only rules
    out the arities that REACH it: `sorted(*[xs])` supplies one argument and
    never touches `key` (a callable, which no variant can become), and CPython
    runs it. So cap the accepted count here instead of erroring, and let the
    arity guard below report a too-large count at run time like any other
    wrong-arity forward. Only when even the REQUIRED arity cannot be built is
    the call genuinely unforwardable, and then the old message still fires.
    bug-nilpy-star-forwarder-refuses-a-container-typed-parameter }
  fwdTotal := total;
  for k := 0 to total - 1 do
    if not PyStarParamTakesVariant(procIdx, k) then
    begin
      fwdTotal := k;
      Break;
    end;
  if fwdTotal < required then
    Error('Nil Python: cannot forward *args into ' + Procs[procIdx].Name
      + ' — parameter ' + Procs[procIdx].Params[fwdTotal].Name
      + ' has a type no runtime argument can be coerced to');
  total := fwdTotal;

  { the two runtime guards }
  chkArg := AllocNode(AN_ARG);
  ASTLeft[chkArg] := PyMakeIdent(listSym);
  a2 := AllocNode(AN_ARG);
  ASTLeft[a2] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a2]] := required;
  ASTTk[ASTLeft[a2]] := Ord(tyInteger);
  a3 := AllocNode(AN_ARG);
  ASTLeft[a3] := AllocNode(AN_INT_LIT);
  ASTIVal[ASTLeft[a3]] := total;
  ASTTk[ASTLeft[a3]] := Ord(tyInteger);
  ASTRight[chkArg] := a2;
  ASTRight[a2] := a3;
  { With a **kwargs dict in play the guard counts BOTH — a forwarded
    `f(1, 2, c=9)` supplies three arguments, two of them positional — and the
    dict is spliced in ahead of the two counts. The keyword half used to be
    REFUSED here (pystar_no_kwargs), which is why `fwd(1, 2, c=9)` died with
    "got 2 arguments, expected 3 to 3": the keyword was collected at the callee
    and then dropped at the forwarded call site.
    feature-nilpy-star-args-kwargs }
  { ...and the dict is spliced into the guard's arguments only when the guard
    is the _kw one. With a collector absorbing it there is no dict operand to
    pass, and leaving it spliced bound it as the `lo` argument. }
  if (dictSym >= 0) and (kwIdx < 0) then
  begin
    a3 := AllocNode(AN_ARG);
    ASTLeft[a3] := PyMakeIdent(dictSym);
    ASTRight[a3] := ASTRight[chkArg];
    ASTRight[chkArg] := a3;
  end;
  callNode := AllocNode(AN_CALL);
  { pystar_check_arity_kw counts the dict's keys as arguments, which is right
    when they land on named slots and wrong when the collector swallows them:
    `g(**{"a":1,"b":2})` supplies ZERO positional arguments to `def g(**kw)`.
    Count the list only in that case — the list-only guard still rejects
    `g(1)`, which CPython refuses too. }
  if (dictSym >= 0) and (kwIdx < 0) then
    ASTIVal[callNode] := FindProc('pystar_check_arity_kw')
  else
    ASTIVal[callNode] := FindProc('pystar_check_arity');
  if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_check_arity) not loaded');
  ASTTk[callNode] := Ord(tyInteger);
  ASTLeft[callNode] := chkArg;
  PyHoistStmt(callNode);

  { Every slot the widest arity could use, read ONCE into a hidden variant local.
    The arms are alternatives but the reads are not — a ternary arm cannot carry
    hoisted setup — so pystar_arg yields None past the end instead of an index
    error, and a variant PARAMETER (which is by-reference) gets a real lvalue to
    bind rather than a call result. }
  if total > 16 then
    Error('Nil Python: cannot forward *args into a callee with more than 16 parameters');
  for k := 0 to total - 1 do
  begin
    slotSyms[k] := AllocVar(PyHiddenName('fwda'), tyVariant);
    elemNode := AllocNode(AN_ARG);
    ASTLeft[elemNode] := PyMakeIdent(listSym);
    { with kwargs, a slot past the positional run is fetched by the parameter's
      NAME — which the frontend knows and the runtime does not, so the name
      travels as a literal argument }
    headNode := elemNode;          { the call's argument HEAD stays the list }
    if dictSym >= 0 then
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := PyMakeIdent(dictSym);
      ASTRight[elemNode] := argNode;
      elemNode := argNode;
    end;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := AllocNode(AN_INT_LIT);
    ASTIVal[ASTLeft[argNode]] := k;
    ASTTk[ASTLeft[argNode]] := Ord(tyInteger);
    ASTRight[elemNode] := argNode;
    if dictSym >= 0 then
    begin
      nameNode := AllocNode(AN_STR_LIT);
      ASTSOffset[nameNode] := PyStoredName(Procs[procIdx].Params[k].Name);
      ASTSLen[nameNode] := Length(Procs[procIdx].Params[k].Name);
      ASTTk[nameNode] := Ord(tyString);
      a2 := AllocNode(AN_ARG);
      ASTLeft[a2] := nameNode;
      ASTRight[a2] := -1;
      ASTRight[argNode] := a2;
    end;
    callNode := AllocNode(AN_CALL);
    if dictSym >= 0 then
      ASTIVal[callNode] := FindProc('pystar_arg_kw')
    else
      ASTIVal[callNode] := FindProc('pystar_arg');
    if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pystar_arg) not loaded');
    ASTTk[callNode] := Ord(tyVariant);
    ASTLeft[callNode] := headNode;
    { Which parameters a keyword call fills is NOT what its argument count says
      — `f(1, c=9)` fills a and c and skips b — so with a kwargs dict every
      slot falls back to the callee's own DEFAULT when it was not supplied,
      and the single full-arity call below replaces the count-dispatch chain. }
    if (dictSym >= 0) and (k < MAX_PROC_PARAMS) and
       ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + k] then
    begin
      hasArg := AllocNode(AN_ARG);
      ASTLeft[hasArg] := PyMakeIdent(listSym);
      a2 := AllocNode(AN_ARG);
      ASTLeft[a2] := PyMakeIdent(dictSym);
      ASTRight[hasArg] := a2;
      a3 := AllocNode(AN_ARG);
      ASTLeft[a3] := AllocNode(AN_INT_LIT);
      ASTIVal[ASTLeft[a3]] := k;
      ASTTk[ASTLeft[a3]] := Ord(tyInteger);
      ASTRight[a2] := a3;
      nameNode := AllocNode(AN_STR_LIT);
      ASTSOffset[nameNode] := PyStoredName(Procs[procIdx].Params[k].Name);
      ASTSLen[nameNode] := Length(Procs[procIdx].Params[k].Name);
      ASTTk[nameNode] := Ord(tyString);
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := nameNode;
      ASTRight[argNode] := -1;
      ASTRight[a3] := argNode;
      hasCall := AllocNode(AN_CALL);
      ASTIVal[hasCall] := FindProc('pystar_has');
      if ASTIVal[hasCall] < 0 then Error('Nil Python: pylib (pystar_has) not loaded');
      ASTTk[hasCall] := Ord(tyBoolean);
      ASTLeft[hasCall] := hasArg;
      pairNode := AllocNode(AN_PAIR);
      ASTLeft[pairNode] := callNode;
      ASTRight[pairNode] := DefaultArgValueNode(procIdx, k);
      ternNode := AllocNode(AN_TERNARY);
      ASTLeft[ternNode] := hasCall;
      ASTRight[ternNode] := pairNode;
      ASTTk[ternNode] := Ord(tyVariant);
      callNode := ternNode;
    end;
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(slotSyms[k]);
    ASTRight[asgn] := callNode;
    PyHoistStmt(asgn);
  end;

  { the collector's own slot: the forwarded dict, whole and unspread. Allocated
    here rather than in the loop above because that loop walks the POSITIONAL
    slots, which this is not. }
  if kwIdx >= 0 then
  begin
    slotSyms[kwIdx] := AllocVar(PyHiddenName('fwda'), tyVariant);
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(slotSyms[kwIdx]);
    ASTRight[asgn] := PyMakeIdent(dictSym);
    PyHoistStmt(asgn);
  end;

  { one call per accepted arity, folded into a ternary chain from the top down;
    the LOWEST arity is the final else, which the arity guard has made safe }
  Result := -1;
  for n := required to total do
  begin
    { with kwargs every slot is filled (supplied or defaulted), so only the
      widest arity is built and there is no count dispatch }
    if (dictSym >= 0) and (n < total) then Continue;
    lastArg := -1;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := procIdx;
    ASTTk[callNode] := Ord(Procs[procIdx].RetType);
    for k := 0 to n - 1 do
    begin
      elemNode := PyMakeIdent(slotSyms[k]);
      ptk := Procs[procIdx].Params[k].TypeKind;
      if ptk = tyVariant then
        { pass the variant straight through }
      else if PyIsStrBaseTk(ptk) or (ptk = tyAnsiString) then
      begin
        i := FindProc('pystr_of');
        if i < 0 then Error('Nil Python: pylib (pystr_of) not loaded');
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := elemNode;
        elemNode := AllocNode(AN_CALL);
        ASTIVal[elemNode] := i;
        ASTTk[elemNode] := Ord(tyAnsiString);
        ASTLeft[elemNode] := argNode;
      end
      else if IRVariantUnboxKind(ptk) or
              ((ptk = tyClass) and (not Procs[procIdx].Params[k].IsRef)) then
        { Pass the variant STRAIGHT THROUGH — IRLowerCallArg already unboxes it
          at lowering time, for a scalar parameter (IRVariantUnboxKind, the same
          predicate) and for a class parameter (tag-checked via pyvarobj_arg, so
          a variant holding the wrong thing raises TypeError instead of being
          dereferenced). This table was refusing work the layer below it does,
          which is why `sum(*[[1, 2]])` — a valid CPython program — did not
          compile: pylib's `sum(l: TPyList)` is a class parameter, and the
          ordinary non-star call `sum(d["k"])` binds that same variant fine.
          Refusing a working CPython program is the one direction NilPy's
          upward-compatibility rule does not allow.
          bug-nilpy-star-forwarder-refuses-a-container-typed-parameter }
      else
        Error('Nil Python: cannot forward *args into ' + Procs[procIdx].Name
          + ' — parameter ' + Procs[procIdx].Params[k].Name
          + ' has a type no runtime argument can be coerced to');
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := elemNode;
      if lastArg < 0 then ASTLeft[callNode] := argNode
      else ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
    { and the collector last, which is where Python puts it }
    if kwIdx >= 0 then
    begin
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := PyMakeIdent(slotSyms[kwIdx]);
      if lastArg < 0 then ASTLeft[callNode] := argNode
      else ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
    if (n = required) or (dictSym >= 0) then
    begin
      Result := callNode;
      Continue;
    end;
    { cond: the EFFECTIVE argument count = n — positional plus keyword when a
      dict is forwarded, since `f(1, 2, c=9)` must select the 3-argument arm }
    if dictSym >= 0 then
    begin
      lenNode := AllocNode(AN_ARG);
      ASTLeft[lenNode] := PyMakeIdent(listSym);
      a2 := AllocNode(AN_ARG);
      ASTLeft[a2] := PyMakeIdent(dictSym);
      ASTRight[a2] := -1;
      ASTRight[lenNode] := a2;
      argNode := AllocNode(AN_CALL);
      ASTIVal[argNode] := FindProc('pystar_argc');
      if ASTIVal[argNode] < 0 then Error('Nil Python: pylib (pystar_argc) not loaded');
      ASTTk[argNode] := Ord(tyInteger);
      ASTLeft[argNode] := lenNode;
      lenNode := argNode;
    end
    else
    begin
      lenNode := PyCallMeth1(listCi, 'count', PyMakeIdent(listSym), -1);
      if lenNode < 0 then Error('Nil Python: pylib (TPyList.count) not loaded');
    end;
    cntNode := AllocNode(AN_INT_LIT);
    ASTIVal[cntNode] := n;
    ASTTk[cntNode] := Ord(tyInteger);
    condNode := AllocNode(AN_BINOP);
    ASTIVal[condNode] := Ord(tkEq);
    ASTLeft[condNode] := lenNode;
    ASTRight[condNode] := cntNode;
    ASTTk[condNode] := Ord(tyBoolean);
    pairNode := AllocNode(AN_PAIR);
    ASTLeft[pairNode] := callNode;
    ASTRight[pairNode] := Result;
    ternNode := AllocNode(AN_TERNARY);
    ASTLeft[ternNode] := condNode;
    ASTRight[ternNode] := pairNode;
    ASTTk[ternNode] := Ord(Procs[procIdx].RetType);
    Result := ternNode;
  end;
end;

{ Pack a call's surplus arguments into the callee's `*args` list and `**kwargs`
  dict, so the rest of the call machinery sees an ORDINARY argument list of
  exactly the declared arity (feature-nilpy-star-args-kwargs rung 1).

  Runs on the parsed AN_ARG chain, just before PyBindKwArgs:
  - positional arguments at or past the star parameter's index become
    `tmp.append(v)` on a hidden TPyList;
  - keyword arguments PyKwArgIndex could not match a parameter (marked with a
    negative ASTIVal carrying their key literal) become `tmp.setitem(k, v)` on a
    hidden TPyDict;
  - the two temps are then spliced in at their parameter positions, AFTER the
    kept positionals and BEFORE any matched keyword argument, so PyBindKwArgs
    still sees positionals first.
  The containers are always passed, empty when nothing was collected, which is
  what keeps the callee's arity fixed.

  No-op — chain untouched — for any callee without a star parameter, which is
  every Pascal call and almost every NilPy one. }
{ The Pascal-side method-call loops are ARITY-DRIVEN: they parse exactly the
  parameters the callee declares, demanding a comma between them. A method with
  `*args` / `**kwargs` has no fixed arity, so those loops either demanded an
  argument that was never written or left surplus ones for the `)` to choke on
  (`def drawImage(self, img, x, y, width=0, ..., **kw)` — songformatter's
  render backend — failed on every call). Parse the list Python-style instead,
  then hand it to the same packing the top-level def path uses.

  On entry the cursor sits just past `(` and the AN_ARG chain already holds
  Self at slot 0, which is what makes the parameter indices line up. }
procedure PyParseStarMethodArgs(mpi, mcallNode: Integer; var mlastArg, mai: Integer);
var argNode, kwIdx, head, cnt: Integer;
begin
  head := ASTLeft[mcallNode];
  cnt := 1;                          { Self }
  while CurTok.Kind <> tkRParen do
  begin
    { `obj.m(*xs)` into a method that COLLECTS — SPLICED into the packing, not
      expanded into slots (a collecting callee has none to expand into). Same
      arm the plain-call path has; PyPackStarArgs below reads the marker. A
      star is not an expression, so it must be taken before ParseArgExpr. }
    kwIdx := PyKwArgIndex(mpi, 1);
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) and (ProcPyStarIdx[mpi] >= 0) then
    begin
      Next;
      kwIdx := PY_ARG_SPLICE;
    end;
    ParseArgExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    ASTIVal[argNode] := kwIdx;
    ASTRight[argNode] := -1;
    if mlastArg < 0 then ASTLeft[mcallNode] := argNode
    else ASTRight[mlastArg] := argNode;
    if head < 0 then head := argNode;
    mlastArg := argNode;
    Inc(cnt);
    if CurTok.Kind = tkComma then Next else Break;
  end;
  PyPackStarArgs(mpi, head, mlastArg, cnt, 0);
  PyBindKwArgs(mpi, head, mlastArg, cnt);
  ASTLeft[mcallNode] := head;
  { every declared parameter is now present, so the caller's arity loop has
    nothing left to do }
  mai := Procs[mpi].ParamCount;
end;

{ Fill the DEFAULTS of any parameters between the last kept positional and the
  slot a packed `*args` / `**kwargs` container is about to occupy.

  `def f(a, b=2, *rest)` called as `f(1)` leaves slot 1 (`b`) empty. Appending
  the star list next put it in b's slot, so `b` received the list and `rest` was
  never bound: `return b` gave 1, `return a` SEGFAULTED, `len(rest)` returned
  garbage. The trailing-default filler that would normally cover slot 1 runs
  much later and sees a FULL argument list by then, so it fills nothing — the
  gap has to be closed here, before the container is placed
  (bug-nilpy-defaulted-param-before-star-args-rejects-short-call).

  Closing it also makes the call EXACTLY arity-matched, which is why
  ProcArityMatches needs no special case for the star parameter: by the time it
  runs, there is no short call left to accept. }
procedure PyFillDefaultsUpTo(mpi, upTo: Integer; var nextSlot, posHead, posLast: Integer;
                             kwChain: Integer);
var argNode, q: Integer; bound: Boolean;
begin
  while (nextSlot < upTo) and (nextSlot < MAX_PROC_PARAMS) do
  begin
    { A slot that a MATCHED KEYWORD argument in this same call already binds
      must be SKIPPED, not filled. Filling it injected the parameter's DEFAULT
      as a positional and the user's own `b=7` then landed on the same slot, so
      `def f(a, b=2, *rest)` called as `f(1, b=7)` was rejected with "got
      multiple values for parameter 'b'" — valid Python refused, and only when
      the def also had a star parameter (`f(a, b=2)` alone was always fine).
      That is the ordinary `def f(a, b=None, **kw)` shape.
      Advance nextSlot anyway: the slot IS accounted for, just by the keyword
      rather than by a default.
      bug-nilpy-keyword-arg-collides-with-a-star-defs-default-filler }
    bound := False;
    q := kwChain;
    while q >= 0 do
    begin
      if (ASTIVal[q] - 1) = nextSlot then begin bound := True; Break; end;
      q := ASTRight[q];
    end;
    if bound then
    begin
      Inc(nextSlot);
      Continue;
    end;
    if not ProcParamHasDefault[mpi * MAX_PROC_PARAMS + nextSlot] then Break;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := DefaultArgValueNode(mpi, nextSlot);
    ASTRight[argNode] := -1;
    { an EXPLICIT slot, like the containers below, and for the same reason: as
      soon as the loop can SKIP a keyword-bound slot, a positional filler no
      longer sits at the index its position implies. `f(a=1)` on
      `def f(a, b=2, *rest)` skipped slot 0, then filled slot 1's default as a
      positional — which PyBindKwArgs counted as slot 0, colliding with the
      keyword. }
    ASTIVal[argNode] := nextSlot + 1;
    if posHead < 0 then posHead := argNode else ASTRight[posLast] := argNode;
    posLast := argNode;
    Inc(nextSlot);
  end;
end;

procedure PyPackStarArgs(mpi: Integer; var argsHead, lastArg, nArgs: Integer;
                         selfSlots: Integer);
{ selfSlots = how many parameter slots the argument chain does NOT contain but
  the SIGNATURE does — 1 for a construction, where Self is added by the
  lowering rather than parsed, 0 everywhere else (a method call carries Self as
  the chain's first node, so its positions already line up).

  Everything here counts in PARAMETER space: `si`/`ki` are signature indices,
  the container's ASTIVal is an explicit slot, and PyFillDefaultsUpTo walks
  slots. Only `pos` and `nKept` are derived from the chain, so those are the
  two that start at selfSlots. Without it a ctor's `*args` never matched
  (`pos >= si` with si counting Self and pos not), so the surplus arguments
  were passed straight through and the callee read one as its packed TPyList —
  a segfault (bug-nilpy-a-fixed-parameter-before-star-args-segfaults). }
var si, ki, n, nxt, pos, listSym, dictSym, keyNode, argNode: Integer;
    posHead, posLast, kwHead, kwLast: Integer;
    nKept: Integer;   { positional slots actually filled so far }
    mtPi, mtSelf, mtCall: Integer;   { pylist_mark_tuple — *args is a tuple }
    rbSym, rbListCi, rbAsgn, rbK, rbReq, rbScan, rbTail: Integer;  { reach-back splice }
    rbA1, rbA2, rbA3, rbA4, rbCall, rbHas, rbPair, rbTern, rbVal, rbStart: Integer;
    rbNames: AnsiString;
    rbLast: Boolean;
begin
  si := ProcPyStarIdx[mpi];
  ki := ProcPyKwIdx[mpi];
  if (si < 0) and (ki < 0) then Exit;
  listSym := -1; dictSym := -1;
  posHead := -1; posLast := -1; kwHead := -1; kwLast := -1;
  pos := selfSlots; nKept := selfSlots;
  n := argsHead;
  while n >= 0 do
  begin
    nxt := ASTRight[n];
    ASTRight[n] := -1;
    if ASTIVal[n] < 0 then
    begin
      if dictSym < 0 then dictSym := PyNewContainerTemp('TPyDict', 'kwargs');
      keyNode := (-ASTIVal[n]) - 1;
      PyContainerCall1(dictSym, 'TPyDict', 'setitem', keyNode, ASTLeft[n]);
    end
    else if ASTIVal[n] = PY_ARG_SPLICE then
    begin
      { `f(*xs)` into a callee that collects: the operand's ELEMENTS join the
        packing, so it extends where a written argument appends. Order is the
        chain's, so `f(1, *xs, 9)` comes out in source order for free.

        From the star position on this is the whole job. REACHING BACK over a
        fixed parameter — `g(*[9, 8, 7])` on `def g(x, *rest)` — is the case
        below: the split depends on the operand's LENGTH, which the packing
        cannot answer at compile time, so it is distributed at run time
        instead. bug-nilpy-star-unpack-that-would-fill-a-fixed-parameter }
      if pos < si then
      begin
        { Bounded to a splice that is the LAST positional. A written argument
          after it would land at a position nobody can compute, which is the
          same unanswerable question one level up. }
        rbLast := True;
        rbScan := nxt;
        while rbScan >= 0 do
        begin
          if (ASTIVal[rbScan] = 0) or (ASTIVal[rbScan] = PY_ARG_SPLICE) then
            rbLast := False;
          rbScan := ASTRight[rbScan];
        end;
        if not rbLast then
          Error('Nil Python: *unpacking before a fixed parameter must be the '
              + 'last positional argument (a written argument after it lands '
              + 'at a position that depends on the operand''s length)');

        rbListCi := FindUClass('TPyList');
        if rbListCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
        { ONCE into a temp: the operand is an expression, and `g(*f())` must
          call f once however many slots it feeds. }
        rbSym := AllocVar(PyHiddenName('starp'), tyClass);
        Syms[rbSym].RecName := REC_UCLASS_BASE + rbListCi;
        SymSyncTypeRef(rbSym);
        rbAsgn := AllocNode(AN_ASSIGN);
        ASTLeft[rbAsgn] := PyMakeIdent(rbSym);
        ASTRight[rbAsgn] := PyStarOperandAsList(ASTLeft[n], rbListCi);
        PyHoistStmt(rbAsgn);

        { How many of the slots this operand must cover are REQUIRED. A
          defaulted parameter cannot precede a non-defaulted one, so the
          required run is the leading one. }
        rbReq := 0;
        rbNames := '';
        rbK := pos;
        while (rbK < si) and (rbK < MAX_PROC_PARAMS) and
              not ProcParamHasDefault[mpi * MAX_PROC_PARAMS + rbK] do
        begin
          if rbNames <> '' then rbNames := rbNames + '|';
          rbNames := rbNames + Procs[mpi].Params[rbK].Name;
          Inc(rbReq);
          Inc(rbK);
        end;
        if rbReq > 0 then
        begin
          rbA1 := AllocNode(AN_ARG);
          ASTLeft[rbA1] := PyMakeIdent(rbSym);
          rbA2 := AllocNode(AN_ARG);
          ASTLeft[rbA2] := AllocNode(AN_INT_LIT);
          ASTIVal[ASTLeft[rbA2]] := rbReq;
          ASTTk[ASTLeft[rbA2]] := Ord(tyInteger);
          rbA3 := AllocNode(AN_ARG);
          ASTLeft[rbA3] := AllocNode(AN_STR_LIT);
          ASTSOffset[ASTLeft[rbA3]] := PyStoredName(Procs[mpi].Name);
          ASTSLen[ASTLeft[rbA3]] := Length(Procs[mpi].Name);
          ASTTk[ASTLeft[rbA3]] := Ord(tyString);
          rbA4 := AllocNode(AN_ARG);
          ASTLeft[rbA4] := AllocNode(AN_STR_LIT);
          ASTSOffset[ASTLeft[rbA4]] := PyStoredName(rbNames);
          ASTSLen[ASTLeft[rbA4]] := Length(rbNames);
          ASTTk[ASTLeft[rbA4]] := Ord(tyString);
          ASTRight[rbA4] := -1;
          ASTRight[rbA3] := rbA4;
          ASTRight[rbA1] := rbA2;
          ASTRight[rbA2] := rbA3;
          rbCall := AllocNode(AN_CALL);
          ASTIVal[rbCall] := FindProc('pystar_check_min');
          if ASTIVal[rbCall] < 0 then Error('Nil Python: pylib (pystar_check_min) not loaded');
          ASTTk[rbCall] := Ord(tyInteger);
          ASTLeft[rbCall] := rbA1;
          PyHoistStmt(rbCall);
        end;

        { One positional per fixed slot the operand reaches: element k-pos of
          it. A slot WITH a default takes the default when the operand ran out
          — `g(*[9])` on `def g(x, y=2, *rest)` is x=9, y=2 — which is a
          run-time test, the same pystar_has/ternary pair the forwarded-call
          desugaring uses. The guard above already covers the required run, so
          those slots read the element directly. }
        rbStart := pos;   { the loop below advances pos; the offsets are from HERE }
        for rbK := rbStart to si - 1 do
        begin
          rbA1 := AllocNode(AN_ARG);
          ASTLeft[rbA1] := PyMakeIdent(rbSym);
          rbA2 := AllocNode(AN_ARG);
          ASTLeft[rbA2] := AllocNode(AN_INT_LIT);
          ASTIVal[ASTLeft[rbA2]] := rbK - rbStart;
          ASTTk[ASTLeft[rbA2]] := Ord(tyInteger);
          ASTRight[rbA2] := -1;
          ASTRight[rbA1] := rbA2;
          rbVal := AllocNode(AN_CALL);
          ASTIVal[rbVal] := FindProc('pystar_arg');
          if ASTIVal[rbVal] < 0 then Error('Nil Python: pylib (pystar_arg) not loaded');
          ASTTk[rbVal] := Ord(tyVariant);
          ASTLeft[rbVal] := rbA1;
          if (rbK < MAX_PROC_PARAMS) and
             ProcParamHasDefault[mpi * MAX_PROC_PARAMS + rbK] then
          begin
            rbA3 := AllocNode(AN_ARG);
            ASTLeft[rbA3] := PyMakeIdent(rbSym);
            rbHas := AllocNode(AN_ARG);
            ASTLeft[rbHas] := AllocNode(AN_INT_LIT);
            ASTIVal[ASTLeft[rbHas]] := rbK - rbStart;
            ASTTk[ASTLeft[rbHas]] := Ord(tyInteger);
            ASTRight[rbHas] := -1;
            ASTRight[rbA3] := rbHas;
            rbCall := AllocNode(AN_CALL);
            ASTIVal[rbCall] := FindProc('pystar_has1');
            if ASTIVal[rbCall] < 0 then Error('Nil Python: pylib (pystar_has1) not loaded');
            ASTTk[rbCall] := Ord(tyBoolean);
            ASTLeft[rbCall] := rbA3;
            rbPair := AllocNode(AN_PAIR);
            ASTLeft[rbPair] := rbVal;
            ASTRight[rbPair] := DefaultArgValueNode(mpi, rbK);
            rbTern := AllocNode(AN_TERNARY);
            ASTLeft[rbTern] := rbCall;
            ASTRight[rbTern] := rbPair;
            ASTTk[rbTern] := Ord(tyVariant);
            rbVal := rbTern;
          end;
          argNode := AllocNode(AN_ARG);
          ASTLeft[argNode] := rbVal;
          ASTIVal[argNode] := 0;
          ASTRight[argNode] := -1;
          if posHead < 0 then posHead := argNode else ASTRight[posLast] := argNode;
          posLast := argNode;
          Inc(nKept);
          Inc(pos);
        end;

        { and everything past the fixed slots joins the packing }
        if listSym < 0 then listSym := PyNewContainerTemp('TPyList', 'starargs');
        rbA1 := AllocNode(AN_ARG);
        ASTLeft[rbA1] := PyMakeIdent(rbSym);
        rbA2 := AllocNode(AN_ARG);
        ASTLeft[rbA2] := AllocNode(AN_INT_LIT);
        ASTIVal[ASTLeft[rbA2]] := si - rbStart;    { elements the fixed slots took }
        ASTTk[ASTLeft[rbA2]] := Ord(tyInteger);
        rbA3 := AllocNode(AN_ARG);
        ASTLeft[rbA3] := AllocNode(AN_INT_LIT);
        ASTIVal[ASTLeft[rbA3]] := MaxInt;    { pylist_slice clamps hi to count }
        ASTTk[ASTLeft[rbA3]] := Ord(tyInteger);
        ASTRight[rbA3] := -1;
        ASTRight[rbA1] := rbA2;
        ASTRight[rbA2] := rbA3;
        rbTail := AllocNode(AN_CALL);
        ASTIVal[rbTail] := FindProc('pylist_slice');
        if ASTIVal[rbTail] < 0 then Error('Nil Python: pylib (pylist_slice) not loaded');
        ASTTk[rbTail] := Ord(tyClass);
        ASTRight[rbTail] := REC_UCLASS_BASE + rbListCi;
        ASTLeft[rbTail] := rbA1;
        PyContainerCall1(listSym, 'TPyList', 'extend', rbTail, -1);
        n := nxt;
        Continue;
      end;
      if listSym < 0 then listSym := PyNewContainerTemp('TPyList', 'starargs');
      PyContainerCall1(listSym, 'TPyList', 'extend',
                       PyStarOperandAsList(ASTLeft[n], FindUClass('TPyList')), -1);
    end
    else if ASTIVal[n] > 0 then
    begin
      { a keyword argument that DID match a declared parameter — kept, and it
        must stay after the positionals PyBindKwArgs counts }
      if kwHead < 0 then kwHead := n else ASTRight[kwLast] := n;
      kwLast := n;
    end
    else
    begin
      if (si >= 0) and (pos >= si) then
      begin
        if listSym < 0 then listSym := PyNewContainerTemp('TPyList', 'starargs');
        PyContainerCall1(listSym, 'TPyList', 'append', ASTLeft[n], -1);
      end
      else
      begin
        if posHead < 0 then posHead := n else ASTRight[posLast] := n;
        posLast := n;
        Inc(nKept);
      end;
      Inc(pos);
    end;
    n := nxt;
  end;
  if si >= 0 then
  begin
    if listSym < 0 then listSym := PyNewContainerTemp('TPyList', 'starargs');
    { `*args` is a TUPLE in Python, and a tuple is the same TPyList as a list
      here — so it has to be MARKED, exactly as a parenthesised display is
      (see PyParseListLiteralT). Unmarked, `print(args)` showed `[2, 3]` where
      CPython shows `(2, 3)`, and `type(args).__name__` answered 'list'
      (bug-nilpy-star-args-is-a-list-not-a-tuple). The rendering mechanism
      already existed; this packing path simply never called it. }
    mtPi := FindProc('pylist_mark_tuple');
    if mtPi >= 0 then
    begin
      mtSelf := AllocNode(AN_ARG);
      ASTLeft[mtSelf] := PyMakeIdent(listSym);
      ASTRight[mtSelf] := -1;
      mtCall := AllocNode(AN_CALL);
      ASTIVal[mtCall] := mtPi;
      ASTTk[mtCall] := Ord(tyClass);
      ASTLeft[mtCall] := mtSelf;
      PyHoistStmt(mtCall);
    end;
    PyFillDefaultsUpTo(mpi, si, nKept, posHead, posLast, kwHead);
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := PyMakeIdent(listSym);
    { an EXPLICIT slot, so the container lands at the star parameter's index
      however many positionals precede it. Counting on the positional order
      alone breaks the moment a keyword binds one of the slots in between —
      the filler above no longer emits a node for those. }
    ASTIVal[argNode] := si + 1;
    if posHead < 0 then posHead := argNode else ASTRight[posLast] := argNode;
    posLast := argNode;
    nKept := si + 1;
  end;
  if ki >= 0 then
  begin
    if dictSym < 0 then dictSym := PyNewContainerTemp('TPyDict', 'kwargs');
    PyFillDefaultsUpTo(mpi, ki, nKept, posHead, posLast, kwHead);
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := PyMakeIdent(dictSym);
    ASTIVal[argNode] := ki + 1;        { explicit slot, as for *args above }
    if posHead < 0 then posHead := argNode else ASTRight[posLast] := argNode;
    posLast := argNode;
    nKept := ki + 1;
  end;
  if kwHead >= 0 then
  begin
    if posHead < 0 then posHead := kwHead else ASTRight[posLast] := kwHead;
    posLast := kwLast;
  end;
  argsHead := posHead;
  lastArg := posLast;
  nArgs := 0;
  n := posHead;
  while n >= 0 do
  begin
    Inc(nArgs);
    n := ASTRight[n];
  end;
end;

{ List literal [a, b, c] -> TPyList create + chained .append() calls, one
  expression tree (append returns Self). Reached from ParseFactor's PyExprMode
  tkLBrack branch, so nested literals in argument positions work too. }
procedure PyParseListLiteralT(opener, closer: TTokenKind; dedup: Boolean);
{ dedup = this is a SET literal. A set is a TPyList here, and TPyList.add is the
  method that carries the set contract (append only when absent) — but the
  literal built the list directly with append, so `{1, 2, 2, 3}` kept its
  duplicate while `set().add(2)` twice did not. The design was intact and one
  construction path skipped it (bug-nilpy-set-literal-does-not-deduplicate). }
var ci, recId, node, argNode, sizeNode, callNode, selfArg, valArg, mmi, mpi,
    tmpSym, asgn, starExt: Integer;
begin
  Expect(opener, '[');
  ci := FindUClass('TPyList');
  if ci < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  { BIND the construction to a hidden temp and append onto the temp IDENT via
    hoisted statements, yielding the ident as the expression — instead of the
    old Self-returning call chain whose result doubled as the receiver. The
    temp OWNS the construction ref (rebind ARC), the scope-exit release drops
    it, and every consumer of the literal sees a borrowable lvalue — which is
    what lets arg-position literals reclaim (exec(src, {...}) leaked one
    container per call) (feature-nilpy-object-reclamation). The comprehension
    hoist already runs this same statement-queue in every statement context. }
  tmpSym := AllocVar(PyHiddenName('lit'), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  if dedup then
  begin
    mmi := FindUMeth(ci, 'add');
    if mmi < 0 then Error('Nil Python: TPyList.add not found');
  end
  else
  begin
    { append_self — see the sibling literal desugar. }
    mmi := FindUMeth(ci, 'append_self');
    if mmi < 0 then Error('Nil Python: TPyList.append_self not found');
  end;
  mpi := UMthProc_[mmi];
  while CurTok.Kind <> closer do
  begin
    { `None` as an ELEMENT is a real value in Python, and the slot can hold it —
      VT_EMPTY. Parsed as a nil literal everywhere else, it would box as integer
      0 (feature-nilpy-none-variant). }
    { `*xs` INSIDE a literal — `(family, -px, *styles)` splices the sequence in
      rather than adding it as one element. Python's iterable unpacking; unlike
      the call-argument form this works on ANY sequence, because the target is
      built at run time and can simply be EXTENDED. }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind <> tkStar) then
    begin
      Next;
      PyParseBoolExpr;
      { ...ANY sequence except a str, which reached TPyList.extend as a raw
        string HANDLE and was dereferenced as an object pointer — `[*s]` and
        `{*s}` were a SIGSEGV with no diagnostic on every pin before this one.
        Third and last of the star sites this normalisation was missing
        (bug-nilpy-join-of-a-str-segfaults). }
      { `extend` APPENDS, so a set display's star arm skipped the very
        deduplication its ordinary elements go through (`add`, chosen above) —
        `{*[1,1,2]}` had three elements. setupdate is the dedup-aware bulk add
        and already existed, so `dedup` picks the bulk operation exactly the way
        it already picks the per-element one, and there is still one mechanism
        deciding whether a display deduplicates
        (bug-nilpy-set-star-spread-does-not-dedup). }
      if dedup then starExt := PyCallMeth1(ci, 'setupdate', PyMakeIdent(tmpSym),
                                           PyIterArgAsList(CurASTNode))
      else starExt := PyCallMeth1(ci, 'extend', PyMakeIdent(tmpSym),
                                  PyIterArgAsList(CurASTNode));
      if starExt < 0 then Error('Nil Python: pylib TPyList.extend/setupdate not loaded');
      PyHoistStmt(starExt);
      if not Eat(tkComma) then break;
      Continue;
    end;
    if PyBareNoneHere then
    begin
      Next;
      CurASTNode := PyMakeNone;
    end
    else
      PyParseBoolExpr;
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := CurASTNode;
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := valArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    if not Eat(tkComma) then break;
  end;
  Expect(closer, ']/}');
  { A parenthesised display is a TUPLE and a braced one is a SET; both are the
    same TPyList as a list here, so the only thing that can tell the three apart
    later is a KIND stamped now, at the one place the syntax is still visible.
    Without it `print((1, 2))` printed `[1, 2]`
    (bug-nilpy-str-of-tuple-is-empty).

    The SET arm is new (2026-08-06). This comment used to end "Set-literal
    braces stay lists", and that was the whole reason `type({1,2}).__name__`
    answered 'list' and a set was indistinguishable from a list to isinstance
    (bug-nilpy-list-tuple-and-set-are-indistinguishable-to-isinstance). A dict
    display never reaches here — PyParseSetLiteral sends it to
    PyParseDictLiteral — so tkBegin at this point is always a set. }
  if (opener = tkLParen) or (opener = tkBegin) then
  begin
    if opener = tkBegin then mpi := FindProc('pylist_mark_set')
    else mpi := FindProc('pylist_mark_tuple');
    if mpi >= 0 then
    begin
      selfArg := AllocNode(AN_ARG);
      ASTLeft[selfArg] := PyMakeIdent(tmpSym);
      ASTRight[selfArg] := -1;
      callNode := AllocNode(AN_CALL);
      ASTIVal[callNode] := mpi;
      ASTTk[callNode] := Ord(tyClass);
      ASTLeft[callNode] := selfArg;
      PyHoistStmt(callNode);
    end;
  end;
  CurASTNode := PyMakeIdent(tmpSym);
end;

procedure PyParseListLiteral;
begin
  PyParseListLiteralT(tkLBrack, tkRBrack, False);
end;

{ `{a, b}` set literal — desugared to a TPyList (the corpus uses sets only
  for string membership via `in`; TPySet with real set semantics is a later
  rung). Dict literals will be distinguished by a ':' after the first key. }
(* A brace-delimited key/value literal lowers to
   TPyDict.Create.setitem(k, v).setitem(...) — the chained shape TPyList
   literals already use, so the whole literal is ONE expression node and needs
   no statement context. *)
procedure PyParseDictLiteral;
var ci, recId, node, argNode, sizeNode, callNode, selfArg, keyArg, valArg,
    mmi, mpi, keyNode, tmpSym, asgn: Integer;
begin
  Expect(tkBegin, 'open brace');
  ci := FindUClass('TPyDict');
  if ci < 0 then Error('Nil Python: pylib (TPyDict) not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  { bind-then-setitem via hoisted statements — see PyParseListLiteralT }
  tmpSym := AllocVar(PyHiddenName('lit'), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  mmi := FindUMeth(ci, 'setitem');
  if mmi < 0 then Error('Nil Python: TPyDict.setitem not found');
  mpi := UMthProc_[mmi];
  while CurTok.Kind <> tkEnd do
  begin
    { `{**a, **b}` — dict SPREAD. Each `**expr` copies that dict's pairs into
      the literal being built, later keys winning, which is Python's merge rule.
      songformatter writes `{**major_scales, **minor_scales}.items()`.
      `**` arrives as two tkStar (the NilPy lexer has no `**` token). }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind = tkStar) then
    begin
      Next; Next;
      PyParseBoolExpr;
      valArg := AllocNode(AN_ARG);
      ASTLeft[valArg] := CurASTNode;
      selfArg := AllocNode(AN_ARG);
      ASTLeft[selfArg] := PyMakeIdent(tmpSym);
      ASTRight[selfArg] := valArg;
      callNode := AllocNode(AN_CALL);
      ASTIVal[callNode] := FindProc('pydict_merge');
      if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pydict_merge) not loaded');
      ASTTk[callNode] := Ord(tyInteger);
      ASTLeft[callNode] := selfArg;
      PyHoistStmt(callNode);
      if not Eat(tkComma) then break;
      Continue;
    end;
    PyParseBoolExpr;
    keyNode := CurASTNode;
    Expect(tkColon, ':');
    { `None` as a VALUE is a real value in Python (VT_EMPTY) — parsed as a nil
      literal it boxes as integer 0, `is None` tag-tests false, and the usual
      `if d[k] is None:` miss-branch is skipped (same fix the list-literal
      element path carries, feature-nilpy-none-variant). }
    if PyBareNoneHere then
    begin
      Next;
      CurASTNode := PyMakeNone;
    end
    else
      PyParseBoolExpr;
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := CurASTNode;
    keyArg := AllocNode(AN_ARG);
    ASTLeft[keyArg] := keyNode;
    ASTRight[keyArg] := valArg;
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := keyArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    if not Eat(tkComma) then break;
  end;
  Expect(tkEnd, 'close brace');
  CurASTNode := PyMakeIdent(tmpSym);
end;

function PyDictKwArgsAhead: Boolean;
{ Positioned at `name=` or at `**expr` inside an argument list. }
begin
  Result := False;
  if not isNilPy then Exit;
  if (CurTok.Kind = tkIdent) and (TokPos <= TokCount) and
     (Tokens[TokPos].Kind = tkAssign) then
  begin
    Result := True;
    Exit;
  end;
  if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkStar) then
    Result := True;
end;

{ A keyword run (`name=` or `**e`) appears LATER in this argument list, at
  depth 0, after a positional argument we are standing on. `d.update(m, c=2)`
  is ordinary Python — the mapping first, keywords winning — and
  PyDictKwArgsAhead alone says False for it, so the ordinary argument path
  parsed `m` and then met `c=2` with nothing to do about it ("unexpected
  token c"). Scans to the closing ')' of THIS call, so a keyword belonging to a
  nested call cannot be mistaken for one of ours.
  bug-nilpy-dict-update-mixed-positional-and-keyword-args }
function PyDictKwRunFrom(start: Integer): Boolean;
var i, depth: Integer;
begin
  Result := False;
  if not isNilPy then Exit;
  depth := 0;
  i := start;
  while i < TokCount do
  begin
    if (Tokens[i].Kind = tkLParen) or (Tokens[i].Kind = tkLBrack) or
       (Tokens[i].Kind = tkBegin) then
      Inc(depth)
    else if (Tokens[i].Kind = tkRBrack) or (Tokens[i].Kind = tkEnd) then
      Dec(depth)
    else if Tokens[i].Kind = tkRParen then
    begin
      if depth = 0 then Exit;      { this call's closer — no keyword run }
      Dec(depth);
    end
    else if depth = 0 then
    begin
      if (Tokens[i].Kind = tkIdent) and (i + 1 < TokCount) and
         (Tokens[i + 1].Kind = tkAssign) then
      begin
        Result := True;
        Exit;
      end;
      if (Tokens[i].Kind = tkStar) and (i + 1 < TokCount) and
         (Tokens[i + 1].Kind = tkStar) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(i);
  end;
end;

{ ...asked from where the parser is STANDING, which is how an argument loop
  needs it. }
function PyDictKwArgsLaterInCall: Boolean;
begin
  Result := PyDictKwRunFrom(TokPos - 1);
end;

function PyKeywordsAreKeys(mpi: Integer): Boolean;
{ The callees for which Python's keyword arguments are dict KEYS rather than
  parameter names. This is a special case in the LANGUAGE, not a gap in keyword
  binding — `update` really has no parameter called `a`, and PyKwArgIndex is
  right to say so.

  Two callees: `dict(a=1)` and `d.update(a=1)`, both taking the one dict
  PyBuildKeywordDict makes, so the two forms cannot drift apart.

  `update` is asked for by PROC INDEX against EVERY overload of TPyDict.update,
  not against the first one FindUMeth answers with. There are three
  (TPyList / TPyDict / Variant), the call site's lookahead picks between them,
  and a predicate that compared against `FindUMeth`'s single hit therefore said
  True for a two-keyword call and False for a one-keyword one — the same
  construct answered differently by argument count. }
var ci, mmi, base, cnt, i: Integer;
begin
  Result := isNilPy and (mpi >= 0) and (mpi < ProcCount) and
            CaseEqual(Procs[mpi].Name, 'dict');
  if Result then Exit;
  if not isNilPy then Exit;
  if (mpi < 0) or (mpi >= ProcCount) then Exit;
  ci := FindUClass('TPyDict');
  if ci < 0 then Exit;
  mmi := FindUMeth(ci, 'update');
  if mmi < 0 then Exit;
  base := UClsMBase[ci];
  cnt := UClsMCount[ci];
  for i := 0 to cnt - 1 do
    if (UMthProc_[base + i] = mpi) and
       CaseEqual(Procs[mpi].Name, 'TPyDict.update') then
    begin
      Result := True;
      Exit;
    end;
end;

function PyDictKwOverloadAhead(ci: Integer; const name: AnsiString): Integer;
{ The UMeth index `d.update(a=1, b=2)` / `d.update(**e)` must resolve to, or -1
  when this is not that call.

  Keywords-are-KEYS means the whole keyword run is ONE TPyDict argument, however
  many keywords it holds — and neither half of ordinary overload selection can
  see that. The arity filter COUNTS the keywords, so `update(z=7, y=8)` looked
  like a two-argument call, matched none of the three arms, and fell through to
  FindUMethArity's first name hit: the `update(l: TPyList)` arm, which then
  received a TPyDict and SEGFAULTED — while `update(z=6)` happened to land on the
  Variant arm and worked. The speculative probe cannot see it either: a `**` is
  not an expression, so it died as a bare "expected expression" raised from a
  place no argument loop could explain (four loops were instrumented across two
  earlier sessions before a gdb backtrace named this function).

  So both symptoms are ONE cause — the argument list was described to the
  overload machinery in the wrong units — and this answers it in the one place
  where the units are still known, ahead of the filter and the probe alike.

  bug-nilpy-small-builtin-surface-gaps-found-by-the-2026-08-13-sweep }
var base, cnt, i, pi, lp, dictCi: Integer;
begin
  Result := -1;
  if not isNilPy then Exit;
  dictCi := FindUClass('TPyDict');
  if (dictCi < 0) or (ci <> dictCi) then Exit;
  { standing just before, or on, the '(' — the run starts at the token after it }
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
    lp := TokPos
  else if CurTok.Kind = tkLParen then
    lp := TokPos - 1
  else
    Exit;
  if lp + 1 >= TokCount then Exit;
  { ...anywhere at depth 0 in this argument list, not only at its FIRST token.
    `d.update(m, c=2)` is a keywords-are-KEYS call too — the mapping is merged
    into the same one dict — and asking only about the first token left the
    arity filter counting it as a TWO-argument call. No update arm has arity 2,
    so the candidate set came back empty and the caller fell through to the
    first-declared arm, update(TPyList), which read a TPyDict as a list and
    SEGFAULTED. That is the identical failure this function was written to
    remove, reached by the one shape its lookahead did not cover.
    bug-nilpy-dict-update-mixed-positional-and-keyword-args }
  if not PyDictKwRunFrom(lp + 1) then Exit;
  base := UClsMBase[dictCi];
  cnt := UClsMCount[dictCi];
  for i := 0 to cnt - 1 do
  begin
    pi := UMthProc_[base + i];
    if (pi < 0) or (pi >= ProcCount) then Continue;
    if not PyKeywordsAreKeys(pi) then Continue;
    if not UMemberNameMatch(UMthNOff[base + i], UMthNLen[base + i], dictCi,
                            name, ULower(name)) then Continue;
    if Procs[pi].ParamCount <> 2 then Continue;
    if Procs[pi].Params[1].TypeKind <> tyClass then Continue;
    if ProcParamRecId[pi * MAX_PROC_PARAMS + 1] <> REC_UCLASS_BASE + dictCi then Continue;
    Result := base + i;
    Exit;
  end;
end;

function PyBuildKeywordDict(seeded: Boolean): Integer;
{ Build the TPyDict that `a=1, b=2, **e` describes and yield an AN_IDENT of it.
  Stops AT the closing ')' without consuming it.

  Both callees above already take exactly one dict argument, so turning the
  keywords into that dict is the whole lowering — no second update path, no new
  pylib entry point, and `dict(a=1)` and `d.update(a=1)` cannot drift apart
  because they are the same code. Construction mirrors PyParseDictLiteral (a
  hoisted temp plus one setitem per pair, pydict_merge for a `**` spread), which
  is what a dict literal already is.

  bug-nilpy-small-builtin-surface-gaps-found-by-the-2026-08-13-sweep }
var ci, recId, node, argNode, sizeNode, callNode, selfArg, keyArg, valArg,
    mmi, mpi, keyNode, tmpSym, asgn: Integer;
    nm: AnsiString;
begin
  ci := FindUClass('TPyDict');
  if ci < 0 then Error('Nil Python: pylib (TPyDict) not loaded');
  recId := REC_UCLASS_BASE + ci;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  tmpSym := AllocVar(PyHiddenName('kwd'), tyClass);
  Syms[tmpSym].RecName := recId;
  SymSyncTypeRef(tmpSym);
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(tmpSym);
  ASTRight[asgn] := node;
  PyHoistStmt(asgn);
  mmi := FindUMeth(ci, 'setitem');
  if mmi < 0 then Error('Nil Python: TPyDict.setitem not found');
  mpi := UMthProc_[mmi];
  if seeded then
  begin
    { `d.update(m, c=2)` — the POSITIONAL mapping comes first and the keywords
      win over it, which is precisely `{**m, 'c': 2}`. So it is merged in with
      the very same pydict_merge the `**e` arm below uses, before any pair is
      stored, and the result is still the ONE dict argument the callee takes.

      pydict_merge is typed `src: TPyDict`, so a NON-mapping seed
      (`d.update([("a", 1)], b=2)`) is a type error at compile time rather than
      a silent wrong answer — the deliberate restriction this ticket scoped.
      bug-nilpy-dict-update-mixed-positional-and-keyword-args }
    PyParseBoolExpr;
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := CurASTNode;
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := valArg;
    callNode := AllocNode(AN_CALL);
    { pydict_merge_ANY, not pydict_merge: `update` accepts a mapping OR an
      iterable of pairs, and which one the seed is is a run-time fact. The
      typed merge compiled a list seed and segfaulted on it. }
    ASTIVal[callNode] := FindProc('pydict_merge_any');
    if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pydict_merge_any) not loaded');
    ASTTk[callNode] := Ord(tyInteger);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    if not Eat(tkComma) then
      Error('Nil Python: expected , after the mapping in dict()/update()');
  end;
  while CurTok.Kind <> tkRParen do
  begin
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind = tkStar) then
    begin
      { `**e` — merge that dict's pairs in, later keys winning, exactly as the
        `{**a, **b}` literal spread does. }
      Next; Next;
      PyParseBoolExpr;
      valArg := AllocNode(AN_ARG);
      ASTLeft[valArg] := CurASTNode;
      selfArg := AllocNode(AN_ARG);
      ASTLeft[selfArg] := PyMakeIdent(tmpSym);
      ASTRight[selfArg] := valArg;
      callNode := AllocNode(AN_CALL);
      ASTIVal[callNode] := FindProc('pydict_merge');
      if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pydict_merge) not loaded');
      ASTTk[callNode] := Ord(tyInteger);
      ASTLeft[callNode] := selfArg;
      PyHoistStmt(callNode);
      if not Eat(tkComma) then Break;
      Continue;
    end;
    if (CurTok.Kind <> tkIdent) or (TokPos > TokCount) or
       (Tokens[TokPos].Kind <> tkAssign) then
      Error('Nil Python: dict()/update() takes keyword arguments (a=1) or a '
            + 'single dict — a positional argument cannot be mixed with them here');
    nm := CurTok.SVal;
    Next;                    { the name }
    Next;                    { the '=' }
    keyNode := AllocNode(AN_STR_LIT);
    ASTSOffset[keyNode] := PyStoredName(nm);
    ASTSLen[keyNode] := Length(nm);
    ASTTk[keyNode] := Ord(tyString);
    if PyBareNoneHere then
    begin
      Next;
      CurASTNode := PyMakeNone;
    end
    else
      PyParseBoolExpr;
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := CurASTNode;
    keyArg := AllocNode(AN_ARG);
    ASTLeft[keyArg] := keyNode;
    ASTRight[keyArg] := valArg;
    selfArg := AllocNode(AN_ARG);
    ASTLeft[selfArg] := PyMakeIdent(tmpSym);
    ASTRight[selfArg] := keyArg;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := mpi;
    ASTTk[callNode] := Ord(tyClass);
    ASTLeft[callNode] := selfArg;
    PyHoistStmt(callNode);
    if not Eat(tkComma) then Break;
  end;
  Result := PyMakeIdent(tmpSym);
end;

{ The two questions every argument loop must ask together: is this a callee
  whose keywords are dict KEYS, and does a keyword run appear in this argument
  list — standing on it, or past a leading positional mapping? Five loops
  spelled the pair out by hand as `PyKeywordsAreKeys(mpi) and
  PyDictKwArgsAhead`, which is why adding the seeded form had to be done in one
  place or in five: the comment at the first of them already said "asking ONE
  function is how it is kept honest", and they were not.
  bug-nilpy-dict-update-mixed-positional-and-keyword-args }
function PyKwDictArgsHere(mpi: Integer): Boolean;
begin
  Result := isNilPy and PyKeywordsAreKeys(mpi) and
            (PyDictKwArgsAhead or
             ((CurTok.Kind <> tkRParen) and PyDictKwArgsLaterInCall));
end;

{ ...and its builder half: seeded exactly when we are NOT already standing on
  the keyword run, i.e. a positional mapping comes first. }
function PyBuildKeywordDictHere: Integer;
begin
  { Seeded exactly when a positional mapping comes first. NOT at a closing
    ')': the empty `dict()` rides this builder too (it is the keyword form with
    no keywords), and seeding it would try to parse an expression off the
    closer. }
  Result := PyBuildKeywordDict((CurTok.Kind <> tkRParen) and
                               (not PyDictKwArgsAhead));
end;

function PyKwDictArgNode(mpi: Integer): Integer;
{ The ONE entry point the argument loops call: -1 unless this callee's keywords
  are dict keys AND we are standing at one, in which case the whole keyword run
  is consumed and the dict it describes is returned as the single argument.
  Every loop that can reach `dict(` or `.update(` asks this the same way, so
  they cannot answer differently. }
begin
  Result := -1;
  if not PyKwDictArgsHere(mpi) then Exit;
  Result := PyBuildKeywordDictHere;
end;

procedure PyParseSetLiteral;
begin
  if PyDictLiteralAhead then PyParseDictLiteral
  else PyParseListLiteralT(tkBegin, tkEnd, True);
end;

procedure PyCoerceAssignmentRHS(lhsTk: TTypeKind; rhsNode: Integer);
begin
  { Numeric casts are not represented by a shared AST node yet. For widened
    Double slots, rewrite integer literals at parse time so the ordinary
    floating store receives IEEE bits instead of an integer payload. }
  if (lhsTk = tyDouble) and (ASTKind[rhsNode] = AN_INT_LIT) and
     TypeIsOrdinal(IntToTypeKind(ASTTk[rhsNode])) then
  begin
    ASTKind[rhsNode] := AN_FLOAT_LIT;
    ASTIVal[rhsNode] := StrToDoubleBits(PyIntLiteralText(ASTIVal[rhsNode]));
    ASTTk[rhsNode] := Ord(tyDouble);
  end;
end;

function PyParseBlock: Integer; forward;
{ Consume `super`'s ARGUMENT LIST, in either spelling, positioned on the '('.

  Python has two: `super()` and `super(Cls, self)`. The second is Python 2's,
  still valid Python 3, and still what every library written to run on both
  contains — html5lib writes `super(Filter, self).__init__(source)` in EVERY
  filter. Only the zero-argument form was accepted, and the two-argument one
  died on the class name with a bare "unexpected token" that never mentioned
  super, so it read as a mystery rather than as a missing spelling.

  ONE consumer for both spellings, called from the statement site and the
  expression site alike: the lowering below is untouched and there is no second
  path to keep in step (devdocs/dev/normalise-dont-special-case.md).

  `super(Cls, self)` means "start the MRO after Cls", and for the enclosing
  class that is exactly what `super()` means — which is what every real use
  writes. Naming a DIFFERENT class (skipping a level) is a different lowering
  than the inherited call this builds, so it is REFUSED, by name and loudly,
  rather than silently treated as the enclosing one. Same for `super(Cls, cls)`
  in a classmethod: the receiver would not be an instance.
  bug-n-two-argument-super-does-not-parse }
procedure PySuperConsumeArgs;
var argCls, argRcv, ownCls: AnsiString;
begin
  Expect(tkLParen, '(');
  if CurTok.Kind = tkRParen then
  begin
    Next;                     { `super()` — the zero-argument spelling }
    Exit;
  end;
  if CurTok.Kind <> tkIdent then
    Error('Nil Python: super(...) takes either no arguments or `super(<class>, self)`');
  argCls := CurTok.SVal;
  Next;
  if CurTok.Kind <> tkComma then
  begin
    { Distinguish the two ways a non-comma gets here, or `super(type(self), self)`
      is reported as a one-argument form and reads as nonsense. }
    if CurTok.Kind = tkRParen then
      Error('Nil Python: super(' + argCls + ') — the one-argument form is an unbound ' +
            'super and is not supported; write super() or super(' + argCls + ', self)')
    else
      Error('Nil Python: super(' + argCls + ' ...) — the first argument must be a plain ' +
            'class name, not a computed expression; write super() or super(<class>, self)');
  end;
  Next;
  if CurTok.Kind <> tkIdent then
    Error('Nil Python: super(' + argCls + ', ...) — the second argument must be `self`');
  argRcv := CurTok.SVal;
  Next;
  Expect(tkRParen, ')');
  ownCls := '';
  if CurSelfClass >= REC_UCLASS_BASE then
    ownCls := PyRawName(UClsNOff[CurSelfClass - REC_UCLASS_BASE],
                        UClsNLen[CurSelfClass - REC_UCLASS_BASE]);
  if not CaseEqual(argRcv, 'self') then
    Error('Nil Python: super(' + argCls + ', ' + argRcv + ') — only `self` is supported ' +
          'as the second argument (a classmethod super is not)');
  if (ownCls <> '') and (not CaseEqual(argCls, ownCls)) then
    Error('Nil Python: super(' + argCls + ', self) inside class ' + ownCls +
          ' — starting the lookup above the enclosing class is not supported; ' +
          'super(' + ownCls + ', self) and super() are');
end;

function PyMakeSuperCall(const name: AnsiString): Integer;
{ `super().<name>(args)` — Pascal's `inherited <name>(args)`. CurTok is the '('
  that opens the argument list; the caller has consumed `super ( ) . name`.
  Extracted from PyParseStatement so the EXPRESSION position can build the same
  node: `super()` was recognised in statement position only, so
  `return "B" + super().who()` died with "undefined variable (super)" — the two
  spellings Python offers for reaching an overridden method, and one of them
  parsed (bug-nilpy-super-and-unbound-parent-method-calls). }
var symIdx, ci, mmi, mpi, selfArg, lastArg, argNode, node, kwIdx, j, k: Integer;
begin
  { A REAL inherited call — Pascal's `inherited M(args)`. `super().__init__(p)`
    is how a class that extends a library widget gets built (songformatter's
    SettingsEditor extends tk.Frame), and discarding it left the base's own
    fields unset: the Tk path was empty, so every later command addressed a
    widget that had never been created. Direct call (not virtual): `super()`
    names the PARENT's body, which is what inherited means. }
  symIdx := PyProgSym('self');
  ci := -1;
  if CurSelfClass >= REC_UCLASS_BASE then ci := UClsParent[CurSelfClass - REC_UCLASS_BASE];
  if (ci >= 0) and (symIdx >= 0) then
  begin
    mmi := FindUMeth(ci, PyMethodName(name));
    if mmi >= 0 then
    begin
      { keyword-name-aware overload re-target — `super().__init__(x, flag=1)`
        (bug-nilpy-keyword-arg-vs-overload-set); CurTok is the '(' here. }
      mmi := PyPromoteOverloadByKw(ci, mmi, PyMethodName(name));
      mpi := UMthProc_[mmi];
      selfArg := AllocNode(AN_ARG);
      ASTLeft[selfArg] := PyMakeIdent(symIdx);
      ASTRight[selfArg] := -1;
      lastArg := selfArg;
      k := 1;
      while CurTok.Kind <> tkRParen do
      begin
        kwIdx := PyKwArgIndex(mpi, 1);
        PyParseBoolExpr;
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := CurASTNode;
        ASTIVal[argNode] := kwIdx;
        ASTRight[argNode] := -1;
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
        Inc(k);
        if CurTok.Kind = tkComma then Next else Break;
      end;
      Expect(tkRParen, ')');
      j := 0;
      PyBindKwArgs(mpi, selfArg, lastArg, j);
      if j > 0 then k := j;
      { the base's remaining defaulted parameters }
      while (k < Procs[mpi].ParamCount) and (k < MAX_PROC_PARAMS) and
            ProcParamHasDefault[mpi * MAX_PROC_PARAMS + k] do
      begin
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := DefaultArgValueNode(mpi, k);
        ASTRight[argNode] := -1;
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
        Inc(k);
      end;
      node := AllocNode(AN_CALL);
      ASTIVal[node] := mpi;
      ASTTk[node] := Ord(Procs[mpi].RetType);
      ASTLeft[node] := selfArg;
      Result := node;
      Exit;
    end;
  end;
  { fallback: no such method on the parent — consume and discard, as before }
  ci := 1;
  while (ci > 0) and (CurTok.Kind <> tkEOF) do
  begin
    if CurTok.Kind = tkLParen then Inc(ci)
    else if CurTok.Kind = tkRParen then Dec(ci);
    Next;
  end;
  Result := -1;
end;

function PyParseStatement: Integer; forward;
procedure PyParseImportRun; forward;   { `import` / `from ... import`, wherever it appears (pyparser.inc) }
procedure PyParseOneImport; forward;   { ONE import statement, inside a block (pyparser.inc) }

{ Spill incoming integer args into their frame slots, following the internal
  x86-64 call convention: up to 6 params arrive in rdi rsi rdx rcx r8 r9;
  a proc with MORE than 6 params receives ALL of them on the caller's stack,
  pushed left-to-right, so param i sits at [rbp+16+(nparams-1-i)*8]. }
{ Store rax into [rbp+off] with the width of the given size (1/2/4/8 bytes).
  A too-wide store would clobber the neighbouring 1-byte/2-byte slots (a bool
  param spilled as a dword smashed the adjacent param — silent wrong values,
  then SIGSEGV once the clobber reached self). }
procedure PyEmitStoreRaxWidth(off, size: Integer);
begin
  case size of
    1: begin EmitB($88); EmitB($85); end;               { mov [rbp+off], al }
    2: begin EmitB($66); EmitB($89); EmitB($85); end;   { mov [rbp+off], ax }
    4: begin EmitB($89); EmitB($85); end;               { mov [rbp+off], eax }
    else begin EmitB($48); EmitB($89); EmitB($85); end; { mov [rbp+off], rax }
  end;
  EmitI32(off);
end;

procedure PyEmitParamSpills(procIdx, nparams: Integer);
var i, idx, sz: Integer;
begin
  for i := 0 to nparams - 1 do
  begin
    idx := Procs[procIdx].Params[i].SymIdx;
    { a BY-REF param holds an ADDRESS, whatever it points at: spilling it at the
      pointee's width truncated a 64-bit stack address to 32 bits and the first
      write through it faulted (a `nonlocal` capture of an int local). }
    if Syms[idx].IsRef then sz := 8 else sz := TypeSize(Syms[idx].TypeKind);
    if nparams > 6 then
    begin
      { all-stack convention: load via rax }
      EmitB($48); EmitB($8B); EmitB($85); EmitI32(16 + 8 * (nparams - 1 - i));
    end
    else
    begin
      { mov rax, <arg reg i> }
      case i of
        0: begin EmitB($48); EmitB($89); EmitB($F8); end; { mov rax, rdi }
        1: begin EmitB($48); EmitB($89); EmitB($F0); end; { mov rax, rsi }
        2: begin EmitB($48); EmitB($89); EmitB($D0); end; { mov rax, rdx }
        3: begin EmitB($48); EmitB($89); EmitB($C8); end; { mov rax, rcx }
        4: begin EmitB($4C); EmitB($89); EmitB($C0); end; { mov rax, r8 }
        else begin EmitB($4C); EmitB($89); EmitB($C8); end; { mov rax, r9 }
      end;
    end;
    PyEmitStoreRaxWidth(Syms[idx].Offset, sz);
  end;
end;

{ Is this a `list * int` pair (either operand order)? }
function PyNodeIsPyList(n: Integer): Boolean;
var listCi: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  listCi := FindUClass('TPyList');
  Result := (listCi >= 0) and (ResolveNodeRec(n) = REC_UCLASS_BASE + listCi);
end;

function PyNodeIsPyDict(n: Integer): Boolean;
var dictCi: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  dictCi := FindUClass('TPyDict');
  Result := (dictCi >= 0) and (ResolveNodeRec(n) = REC_UCLASS_BASE + dictCi);
end;

{ A valid SEQUENCE REPEAT COUNT. Ordinal, or an ARBITRARY-PRECISION int — promo
  is deliberately not reported by TypeIsOrdinal, so without this arm `[0] * n`
  with a computed n was not recognised as a repeat at all and fell through to
  the arithmetic path, which raised `TypeError: unsupported operand type(s)`.
  That shape is how Python allocates a fixed-size list, so this is the case that
  blocked the promotable-int default.

  The count NARROWS for free: the repeat builders emit an ordinary AN_CALL to a
  pylib routine whose parameter is an Int64, and IRLowerCallArg's promo arm
  narrows it there. Do NOT instead teach IRPyOperandKind that promo is numeric —
  that was tried and turned the TypeError into a garbage number, because it also
  made `promo * list` look like a provable arithmetic pair.

  A VARIANT counts too — an untyped parameter, a container element, anything
  without a static type. `bytes([ch]) * u` inside a plain `def f(u)` is uforth's
  FILL, and it raised "expected a number, got object" from the RTL: unrecognised
  as a repeat, the pair fell through to arithmetic and the BYTES object was the
  thing being coerced to a number. `[7] * u` happened to survive by another
  route while `u * [7]` did not, which is the tell that this predicate — not the
  operand order — was the gap.

  This is safe in the way the promo note above is not: the pair tests require
  one side to be a KNOWN list/bytes node (tyClass with that record), so a
  variant*variant pair of numbers is untouched and never looks like a repeat. }
function PyIsRepeatCountTk(tk: TTypeKind): Boolean;
begin
  PyIsRepeatCountTk := TypeIsOrdinal(tk) or TypeIsPromoInt(tk) or (tk = tyVariant);
end;

function PyListRepeatPair(a, b: Integer): Boolean;
begin
  Result := (PyNodeIsPyList(a) and PyIsRepeatCountTk(IntToTypeKind(ASTTk[b]))) or
            (PyNodeIsPyList(b) and PyIsRepeatCountTk(IntToTypeKind(ASTTk[a])));
end;

function PyNodeIsPyBytes(n: Integer): Boolean;
var byCi: Integer;
begin
  Result := False;
  if n < 0 then Exit;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  byCi := FindUClass('TPyBytes');
  Result := (byCi >= 0) and (ResolveNodeRec(n) = REC_UCLASS_BASE + byCi);
end;

{ `bytes([...]) * n` / `n * b` — Python bytes repetition (uforth's FILL:
  `bytes([ch]) * u`). Same shape as the list-repeat pair. }
function PyBytesRepeatPair(a, b: Integer): Boolean;
begin
  Result := (PyNodeIsPyBytes(a) and PyIsRepeatCountTk(IntToTypeKind(ASTTk[b]))) or
            (PyNodeIsPyBytes(b) and PyIsRepeatCountTk(IntToTypeKind(ASTTk[a])));
end;

{ helper-call builder for bytes binary ops (concat, eq) }
function PyMakeBytesBinCall(const fname: AnsiString; a, b: Integer; retTk: TTypeKind): Integer;
var procIdx, arg0, arg1: Integer;
begin
  procIdx := FindProc(fname);
  if procIdx < 0 then Error('Nil Python: pylib (' + fname + ') not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := a;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := b;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(retTk);
  ASTLeft[Result] := arg0;
end;

{ list binop helper call, tagging the result with TPyList class identity so
  len()/subscript/iteration resolve on it. }
function PyMakeListBinCall(const fname: AnsiString; a, b: Integer): Integer;
var procIdx, arg0, arg1, ci: Integer;
begin
  procIdx := FindProc(fname);
  if procIdx < 0 then Error('Nil Python: pylib (' + fname + ') not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := a;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := b;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyClass);
  ASTLeft[Result] := arg0;
  ci := FindUClass('TPyList');
  if ci >= 0 then ASTRight[Result] := REC_UCLASS_BASE + ci;
end;

{ dict binop helper call, tagging the result with TPyDict class identity —
  mirrors PyMakeListBinCall for `d1 | d2` (PEP 584 dict union). }
function PyMakeDictBinCall(const fname: AnsiString; a, b: Integer): Integer;
var procIdx, arg0, arg1, ci: Integer;
begin
  procIdx := FindProc(fname);
  if procIdx < 0 then Error('Nil Python: pylib (' + fname + ') not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := a;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := b;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyClass);
  ASTLeft[Result] := arg0;
  ci := FindUClass('TPyDict');
  if ci >= 0 then ASTRight[Result] := REC_UCLASS_BASE + ci;
end;

function PyMakeBytesRepeat(a, b: Integer): Integer;
var byNode, cntNode, procIdx, arg0, arg1: Integer;
begin
  if PyNodeIsPyBytes(a) then begin byNode := a; cntNode := b; end
  else begin byNode := b; cntNode := a; end;
  procIdx := FindProc('pybytes_repeat');
  if procIdx < 0 then Error('Nil Python: pylib (pybytes_repeat) not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := byNode;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := cntNode;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyClass);
  ASTLeft[Result] := arg0;
end;

{ Build pylist_repeat(list, count) for `xs * n` / `n * xs`. }
function PyMakeListRepeat(a, b: Integer): Integer;
var listNode, cntNode, procIdx, arg0, arg1: Integer;
begin
  if PyNodeIsPyList(a) then begin listNode := a; cntNode := b; end
  else begin listNode := b; cntNode := a; end;
  procIdx := FindProc('pylist_repeat');
  if procIdx < 0 then Error('Nil Python: pylib (pylist_repeat) not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := listNode;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := cntNode;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyClass);
  ASTLeft[Result] := arg0;
end;

{ Is this node a COMPLEX value? }
function PyNodeIsComplex(n: Integer): Boolean;
begin
  Result := (n >= 0) and (IntToTypeKind(ASTTk[n]) = tyClass) and
            PyRecIsComplex(ResolveNodeRec(n));
end;

{ Coerce one operand of a mixed complex expression. A real becomes re+0j, which
  is what Python's numeric tower does before it applies the operator; a complex
  is returned untouched. }
function PyComplexCoerce(n: Integer): Integer;
begin
  if PyNodeIsComplex(n) then Result := n
  else Result := PyCallProc1('pycomplex_of_real', n);
end;

{ `z + w`, `z * 2`, `1 - z`, `z == w` — complex arithmetic, built as DIRECT
  calls rather than left to operator overloading or dunder dispatch.

  Not dunder dispatch, because complex is a pylib class and every dunder arm
  excludes those by design. Not Pascal `operator` overloads either, and that is
  the interesting half: they are keyed on the LEFT operand and matched on the
  right one only as a preference, so `z + 1` with an Int64 right operand would
  MISS the (TPyComplex, Double) entry, fall back to the first `+` registered for
  TPyComplex, and pass the integer where a TPyComplex pointer was expected --
  silently, since both are one machine word. Coercing both sides here and naming
  the routine outright has no such failure mode.
  bug-nilpy-no-complex-number-type }
function PyMakeComplexBinop(op: TTokenKind; a, b: Integer): Integer;
var pname: AnsiString; procIdx, arg0, arg1: Integer;
begin
  Result := -1;
  if op = tkPlus then pname := 'pycomplex_add'
  else if op = tkMinus then pname := 'pycomplex_sub'
  else if op = tkStar then pname := 'pycomplex_mul'
  else if op = tkSlash then pname := 'pycomplex_div'
  else if op = tkEq then pname := 'pycomplex_eq'
  else if op = tkNeq then pname := 'pycomplex_eq'
  else Exit;
  procIdx := FindProc(pname);
  if procIdx < 0 then Exit;
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := PyComplexCoerce(a);
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := PyComplexCoerce(b);
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTLeft[Result] := arg0;
  if (op = tkEq) or (op = tkNeq) then
  begin
    ASTTk[Result] := Ord(tyBoolean);
    { `!=` is `not (a == b)` — one comparison routine, negated here, so the two
      spellings cannot drift apart. }
    if op = tkNeq then
    begin
      arg0 := Result;
      Result := AllocNode(AN_NOT);
      ASTLeft[Result] := arg0;
      ASTTk[Result] := Ord(tyBoolean);
    end;
  end
  else
  begin
    ASTTk[Result] := Ord(tyClass);
    ASTRight[Result] := ProcRetRecId[procIdx];
  end;
end;

{ `<str> % <args>` — Python's printf-style interpolation, lowered to the pylib
  formatter. The argument travels as a VARIANT, which is what lets one helper
  take both shapes Python allows: a single value, or the TPyList a written tuple
  builds (bug-nilpy-percent-string-format-garbage). }
function PyMakePercentFormat(fmtNode, argsNode: Integer): Integer;
var procIdx, arg0, arg1: Integer;
begin
  procIdx := FindProc('pypercent_format');
  if procIdx < 0 then Error('Nil Python: pylib (pypercent_format) not loaded');
  arg0 := AllocNode(AN_ARG); ASTLeft[arg0] := fmtNode;
  arg1 := AllocNode(AN_ARG); ASTLeft[arg1] := argsNode; ASTRight[arg1] := -1;
  ASTRight[arg0] := arg1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyAnsiString);
  ASTLeft[Result] := arg0;
end;

{ Render a CLASS-typed value as text the way Python does: a user-declared
  `__str__` (or `__repr__`) wins, and only a class descended from Exception that
  declares NEITHER falls back to reading its `.msg` field. Returns -1 when
  neither applies, so the caller keeps its own behaviour.

  ONE routine because this decision had THREE copies — `PyReprContainer` for
  `print`, and two sites in `parser.inc` for `str()` and for the f-string's
  `pystr_of` — and all three had the SAME bug: the Exception/msg arm sat first,
  so a user `__str__` on an exception subclass was never consulted and the
  CONSTRUCTOR ARGUMENT was printed instead. Fixing one site moved `print(e)` and
  left `str(e)` and f-strings wrong, which is what three mechanisms for one
  concept always costs (devdocs/dev/normalise-dont-special-case.md).
  bug-nilpy-user-str-dunder-on-an-exception-subclass-is-ignored }
function PyClassStrNode(node, argCi: Integer): Integer;
var mmi, excCi, fieldNode: Integer;
begin
  PyClassStrNode := -1;
  if (node < 0) or (argCi < 0) then Exit;
  mmi := FindUMeth(argCi, '__str__');
  if mmi < 0 then mmi := FindUMeth(argCi, '__repr__');
  if mmi >= 0 then
  begin
    PyClassStrNode := PyCallMeth1(argCi, PyRawName(UMthNOff[mmi], UMthNLen[mmi]),
                                  node, -1);
    Exit;
  end;
  excCi := PyLibExceptionCi;
  if (excCi >= 0) and ((argCi = excCi) or IsSubclassOf(argCi, excCi)) then
  begin
    fieldNode := AllocNode(AN_FIELD);
    ASTLeft[fieldNode] := node;
    ASTSOffset[fieldNode] := PyStoredName('msg');
    ASTSLen[fieldNode] := 3;
    ASTTk[fieldNode] := Ord(tyAnsiString);
    PyClassStrNode := fieldNode;
  end;
end;

{ Wrap a TPyList / TPyDict expression in the pylib repr call, so it prints as
  Python spells a container. Anything else is returned unchanged. }
function PyReprContainer(n: Integer): Integer;
var rec, listCi, dictCi, procIdx, argNode, callNode: Integer; pname: AnsiString;
    excCi, argCi, fieldNode, mmi: Integer;
begin
  Result := n;
  if n < 0 then Exit;
  { a variant/Any arg may hold a container at runtime; route it through a runtime
    dispatcher (container -> repr, scalar -> str) so it never reaches the backend
    `<object>` placeholder (bug-nilpy-print-variant-holding-list). }
  if IntToTypeKind(ASTTk[n]) = tyVariant then
  begin
    procIdx := FindProc('pyvar_print_of');
    if procIdx < 0 then Exit;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := n;
    callNode := AllocNode(AN_CALL);
    ASTIVal[callNode] := procIdx;
    ASTTk[callNode] := Ord(tyAnsiString);
    ASTLeft[callNode] := argNode;
    Result := callNode;
    Exit;
  end;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  rec := ResolveNodeRec(n);
  if rec < REC_UCLASS_BASE then Exit;
  { print(e) of an Exception (or subclass) shows its message, like Python's
    str(e) — read the `msg` field instead of the instance pointer
    (feature-nilpy-exception-message). }
  argCi := rec - REC_UCLASS_BASE;
  { __str__/__repr__ if the class declares one, else an Exception's .msg — the
    single PyClassStrNode decision, shared with str() and the f-string path.
    Checked before the pylib containers so a user class can override even those. }
  fieldNode := PyClassStrNode(n, argCi);
  if fieldNode >= 0 then
  begin
    Result := fieldNode;
    Exit;
  end;
  listCi := FindUClass('TPyList');
  dictCi := FindUClass('TPyDict');
  if (listCi >= 0) and (rec = REC_UCLASS_BASE + listCi) then pname := 'pylist_repr'
  else if (dictCi >= 0) and (rec = REC_UCLASS_BASE + dictCi) then pname := 'pydict_repr'
  { bytes prints as b'...' like CPython — it fell through to the integer path
    and printed the instance pointer (bug-nilpy-user-class-bytes-method-loses-
    identity: the visible half; the annotated form hit this too). }
  else if PyRecIsCls(rec, 'TPyBytes') then pname := 'pybytes_repr'
  else
    { ...and any OTHER user class: `pyobj_str_of`, which produces CPython's
      `<__main__.N object at 0x...>` through the same renderer repr() and a
      container element already use — and 'None' for a nil handle.

      This used to Exit unchanged, leaving an integer print of the instance
      HANDLE. Two symptoms, one arm: `str(n)` on a class with no dunders
      printed 134298980057 while `repr(n)` and `print([n])` were right, and a
      CLASS-TYPED None (what a method with `return self` on one path and
      `return None` on another yields) printed as 0 even though `is None` on it
      answered True.

      Landing this REQUIRED the typing fix first: with a tyClass node actually
      treated as an object, a def returning a field crashed here, because its
      return type was the receiver's class while its value was the field's int
      (bug-nilpy-a-def-returning-a-field-is-typed-as-the-receivers-class).
      bug-nilpy-str-of-a-plain-instance-prints-the-handle-and-a-class-typed-none-prints-zero }
    pname := 'pyobj_str_of';
  procIdx := FindProc(pname);
  if procIdx < 0 then Exit;   { pylib not loaded — leave the old behaviour }
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := n;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := procIdx;
  ASTTk[callNode] := Ord(tyAnsiString);
  ASTLeft[callNode] := argNode;
  Result := callNode;
end;

{ Which print KEYWORD ARGUMENT is at CurTok, or '' for a positional one.
  `print` is a builtin, not a def, so it never goes through the parameter-name
  matching that def/method keyword arguments use — it needs its own fixed set.
  (`end` is safe to spell: the NilPy lexer maps only a fixed keyword list and
  `end` is not on it, so it arrives as a plain tkIdent.) }
function PyPrintKwargAt: AnsiString;
var nm: AnsiString;
begin
  Result := '';
  { Keyed on the token TEXT, not its kind: `file` lexes as Pascal's tkFile
    keyword, and `end`/`sep` are only tkIdent by luck of the keyword list.
    Reading the text is robust to all of that. }
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign) and (TokPos >= 1) then
  begin
    nm := LowerCase(GetTokenStr(TokPos - 1));
    if (nm = 'sep') or (nm = 'end') or (nm = 'file') or (nm = 'flush') then
      Result := nm;
  end;
end;

{ `print(a, b, sep="-")` — the separator injected between arguments.

  sep= used to be refused, for a reason recorded in the argument loop: the
  separators are injected DURING that loop, while a keyword argument is only
  reached after the arguments it separates. True, and the fix is to stop
  reading it in the loop — scan this call's own token range for `sep=<string
  literal>` BEFORE parsing any argument, so the value is known when the first
  separator is built.

  Depth-tracked so a nested `f(sep=..)`, a list/dict/f-string display or a
  subscript inside the argument list cannot be mistaken for print's own
  keyword. Returns False when there is no sep=, which keeps the default
  single space on the unchanged path. }
function PyPrintSepAhead(var sepText: AnsiString): Boolean;
var i, depth: Integer;
begin
  Result := False;
  sepText := '';
  depth := 0;
  i := TokPos - 1;             { CurTok is Tokens[TokPos - 1] }
  while i < TokCount do
  begin
    if (Tokens[i].Kind = tkLParen) or (Tokens[i].Kind = tkLBrack) or
       (Tokens[i].Kind = tkBegin) then Inc(depth)
    else if (Tokens[i].Kind = tkRBrack) or (Tokens[i].Kind = tkEnd) then
      Dec(depth)
    else if Tokens[i].Kind = tkRParen then
    begin
      if depth = 0 then Exit;  { print's own closing paren — no sep= here }
      Dec(depth);
    end
    else if (depth = 0) and (Tokens[i].Kind = tkAssign) and (i >= 1) and
            (LowerCase(GetTokenStr(i - 1)) = 'sep') then
    begin
      { A literal, like end= — the separator is materialised at PARSE time as
        the constant sitting between two arguments, so a run-time value would
        need a different lowering (one call rendering the whole run, the way
        pyprint_star does). Refused rather than approximated. }
      if (i + 1 >= TokCount) or (Tokens[i + 1].Kind <> tkString) then
        Error('Nil Python: print sep= needs a literal string');
      sepText := GetTokenStr(i + 1);
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ `file=sys.stderr` -> the fd threaded into AN_WRITE/AN_WRITELN's ival slot,
  which is the same mechanism Pascal's `writeln(StdErr, ..)` already uses.
  Only the two standard streams are accepted; a real file object would need a
  file model NilPy does not have yet, and silently writing it to stdout would
  be worse than refusing. }
function PyParsePrintFile: Integer;
begin
  { sys.stdout / sys.stderr resolve to their fd as an ordinary expression (see
    PyParseSysStream), so this just parses one and reads the constant back.
    Only the two standard streams are accepted: a real file object needs a file
    model NilPy does not have, and quietly writing it to stdout would be worse
    than refusing. }
  PyParseBoolExpr;
  if (CurASTNode < 0) or (ASTKind[CurASTNode] <> AN_INT_LIT) or
     ((ASTIVal[CurASTNode] <> 1) and (ASTIVal[CurASTNode] <> 2)) then
    Error('Nil Python: print file= expects sys.stdout or sys.stderr');
  Result := ASTIVal[CurASTNode];
end;

function PyParsePrint: Integer;
var node, argNode, lastArg, sepLit, noneLit, endLit, writeFd: Integer;
    starProc, starArg, leadLit: Integer;
    kw, endText, sepText: AnsiString;
    haveEnd, isStar, sawStar, haveSep: Boolean;
    pargTmp, pargAsgn: Integer;
    pargTk: TTypeKind;
begin
  Next;
  Expect(tkLParen, '(');
  node := AllocNode(AN_WRITELN);
  lastArg := -1;
  writeFd := 0;                { 0 = the default, which lowering reads as stdout }
  haveEnd := False;
  sawStar := False;
  endText := '';
  haveSep := PyPrintSepAhead(sepText);
  if CurTok.Kind <> tkRParen then
    repeat
      kw := PyPrintKwargAt;
      if kw <> '' then
      begin
        Next;                  { the keyword name }
        Expect(tkAssign, '=');
        if kw = 'flush' then
          { Accepted and IGNORED, deliberately: output is already emitted per
            statement, so there is nothing to flush. Consumed as an expression
            so the argument parses; the value is unused. }
          PyParseBoolExpr
        else if kw = 'file' then
          writeFd := PyParsePrintFile
        else if kw = 'sep' then
          { Already read by PyPrintSepAhead before the loop started — the
            separators are injected as arguments are parsed, so it has to be
            known ahead of them. Consumed here so it parses like any other
            keyword; the value is taken from the prescan. }
          PyParseBoolExpr
        else
        begin
          if CurTok.Kind <> tkString then
            Error('Nil Python: print end= needs a literal string');
          endText := CurTok.SVal;
          haveEnd := True;
          Next;
        end;
        Continue;              { a keyword argument prints nothing itself }
      end;
      { `print(*xs)` — the argument list is UNPACKED from a list at run time, so
        its length (and therefore how many separators it contributes) is not a
        compile-time fact. pyprint_star renders the whole run into one string,
        separators included, which is why the synthetic space below is skipped
        for it. An argument AFTER a starred one is refused rather than
        approximated: the space between them exists only if the list was
        non-empty, and printing a stray one would be silently wrong output.
        (feature-nilpy-star-args-kwargs rung 2.) }
      isStar := CurTok.Kind = tkStar;
      if sawStar then
        Error('Nil Python: print() takes no further argument after *unpacking');
      { Python print separates successive arguments with a single space.
        Inject a synthetic space char arg before every argument after the
        first (a tyChar AN_INT_LIT writes the byte, not a number). This is the
        .npy print path only; Pascal writeln keeps its no-separator semantics. }
      { pyprint_star renders a whole unpacked run into one string, separators
        included, and it hard-codes the single space. A custom sep would have
        to be threaded into it — refused rather than silently ignored on the
        starred run only. }
      if haveSep and (isStar or sawStar) then
        Error('Nil Python: print(*x) with sep= is not supported yet');
      if (lastArg >= 0) and (not isStar) and
         ((not haveSep) or (Length(sepText) > 0)) then
      begin
        { sep="" injects nothing at all — the guard above skips this block, so
          the arguments abut, which is what CPython does. }
        if haveSep and (Length(sepText) > 1) then
        begin
          sepLit := AllocNode(AN_STR_LIT);
          ASTSOffset[sepLit] := PyStoredName(sepText);
          ASTSLen[sepLit] := Length(sepText);
          ASTTk[sepLit] := Ord(tyString);
        end
        else
        begin
          sepLit := AllocNode(AN_INT_LIT);
          if haveSep then ASTIVal[sepLit] := Ord(sepText[1])
          else ASTIVal[sepLit] := 32;
          ASTTk[sepLit] := Ord(tyChar);
        end;
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := sepLit;
        ASTRight[argNode] := -1;
        ASTIVal[argNode] := 0;
        ASTSOffset[argNode] := -2;
        ASTRight[lastArg] := argNode;
        lastArg := argNode;
      end;
      { A bare `None` prints as None, like CPython — the literal is a nil/zero
        value everywhere else, which printed as 0 (feature-nilpy-none-variant).
        A None-VALUED VARIANT is handled in the writer instead, since its tag is
        only known at run time. }
      if isStar then
      begin
        sawStar := True;
        Next;                  { the '*' }
        PyParseBoolExpr;
        { a str spreads as its characters, like every other iterable }
        CurASTNode := PyIterArgAsList(CurASTNode);
        if IntToTypeKind(ASTTk[CurASTNode]) <> tyClass then
          Error('Nil Python: print(*x) needs a list; got a value of another type');
        starProc := FindProc('pyprint_star');
        if starProc < 0 then Error('Nil Python: pylib (pyprint_star) not loaded');
        starArg := AllocNode(AN_ARG);
        ASTLeft[starArg] := CurASTNode;
        leadLit := AllocNode(AN_INT_LIT);
        if lastArg >= 0 then ASTIVal[leadLit] := 1 else ASTIVal[leadLit] := 0;
        ASTTk[leadLit] := Ord(tyBoolean);
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := leadLit;
        ASTRight[starArg] := argNode;
        CurASTNode := AllocNode(AN_CALL);
        ASTIVal[CurASTNode] := starProc;
        ASTTk[CurASTNode] := Ord(tyAnsiString);
        ASTLeft[CurASTNode] := starArg;
      end
      else if PyBareNoneHere then
      begin
        Next;
        noneLit := AllocNode(AN_STR_LIT);
        ASTSOffset[noneLit] := PyStoredName('None');
        ASTSLen[noneLit] := 4;
        ASTTk[noneLit] := Ord(tyString);
        CurASTNode := noneLit;
      end
      else
        PyParseBoolExpr;
      { Evaluate this argument into a hidden temp NOW, rather than letting
        AN_WRITELN's own lowering evaluate-and-emit each argument in turn.
        Python evaluates every argument before print writes anything; pxx
        wrote each one as it was computed, so `print("label =", str(3 % 0))`
        raising on its SECOND argument left the first already on stdout, and
        the handler's own fallback print appended to it instead of replacing
        it (bug-nilpy-print-emits-arguments-before-evaluating-later-ones).
        Hoisted (run before this whole print statement, in the same
        left-to-right order the arguments are parsed in), so by the time
        AN_WRITELN's lowering runs, every value is already sitting in a slot
        and nothing it does can raise. }
      pargTk := IntToTypeKind(ASTTk[CurASTNode]);
      { A string LITERAL argument carries tyString, which allocates a FROZEN
        fixed-size slot — and with no explicit string[N] that slot came out
        STRING_CAP (8 MB) wide. So every `print("literal")` reserved 8 MiB of
        BSS, linearly: `print("x", "y")` reserved 16 MiB, and a test with a
        dozen literals reserved 218 MB. Binding the literal to a variable first
        never did this, because an assignment widens tyString to tyAnsiString —
        the same widening rule recorded in
        project_nilpy_ast_typing_and_string_kind_widen. Apply it here too: the
        temp only has to HOLD the value, and managed is a pointer.
        (bug-nilpy-print-string-literal-reserves-8mb-of-bss) }
      if pargTk = tyString then pargTk := tyAnsiString;
      pargTmp := AllocVar(PyHiddenName('parg'), pargTk);
      if pargTk = tyClass then
      begin
        Syms[pargTmp].RecName := ResolveNodeRec(CurASTNode);
        SymSyncTypeRef(pargTmp);
      end;
      pargAsgn := AllocNode(AN_ASSIGN);
      ASTLeft[pargAsgn] := PyMakeIdent(pargTmp);
      ASTRight[pargAsgn] := CurASTNode;
      PyHoistStmt(pargAsgn);
      CurASTNode := PyMakeIdent(pargTmp);

      { CONVERT THE TEMP, not the raw argument. The conversions below turn a
        container into its repr text and a float into str()'s spelling, and they
        used to run BEFORE the hoist above — so what got hoisted was the TEXT,
        computed while later arguments had not been evaluated yet. Python
        evaluates every argument first and only then converts, so both
        references in `print(zs, zs.pop(), zs)` show the list in its FINAL
        state; pxx froze the first one's text before the pop and printed
        `[1, 2, 3] 3 [1, 2]` where CPython prints `[1, 2] 3 [1, 2]`
        (bug-nilpy-print-stringifies-container-args-eagerly).

        Moving the conversion after the hoist is the whole fix: the temp holds
        the container POINTER, every argument's evaluation has already happened
        by the time AN_WRITELN's lowering runs, and the repr then reads the list
        as it finally is. The user-function control the ticket noted —
        `show(xs, xs.pop(), xs)` doing its own str() — was always correct for
        exactly this reason: the conversion happened in the callee, after every
        argument was bound. }
      { A container argument prints its ELEMENTS (`['a', 'b']`), like Python.
        Without this it fell through to the integer path and printed the
        TPyList/TPyDict instance pointer — silently, in the single most natural
        debugging line there is (bug-a-nilpy-print-of-a-list-prints-a-pointer). }
      CurASTNode := PyReprContainer(CurASTNode);
      { A FLOAT argument goes through pystr_of too, for the same reason the
        container line above exists: otherwise print reaches the BACKEND float
        writer (EmitWriteFloatNat, hand-written per target) while `str()` uses
        FloatToStr, and the two disagree. They did — `print(1e19)` wrote
        `9223372036854775809.o72036854775808`, a byte that is not a digit,
        while `print(str(1e19))` was already correct
        (bug-nilpy-print-of-a-float-bypasses-str-formatting). Routing here fixes
        every target at once and makes print(x) and print(str(x)) agree by
        construction, which is Python's actual rule. }
      if (IntToTypeKind(ASTTk[CurASTNode]) = tyDouble) or
         (IntToTypeKind(ASTTk[CurASTNode]) = tySingle) then
      begin
        starProc := IRFindProc1ByArgTk('pystr_of', tyDouble);
        if starProc >= 0 then
        begin
          starArg := AllocNode(AN_ARG);
          ASTLeft[starArg] := CurASTNode;
          CurASTNode := AllocNode(AN_CALL);
          ASTIVal[CurASTNode] := starProc;
          ASTTk[CurASTNode] := Ord(tyAnsiString);
          ASTLeft[CurASTNode] := starArg;
        end;
      end;

      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := CurASTNode;
      ASTRight[argNode] := -1;
      ASTIVal[argNode] := 0;     { field width: 0 = none }
      ASTSOffset[argNode] := -2; { decimals: -2 = Python-natural float format (EmitWriteFloatNat) }
      if lastArg < 0 then ASTLeft[node] := argNode
      else ASTRight[lastArg] := argNode;
      lastArg := argNode;
    until not Eat(tkComma);
  Expect(tkRParen, ')');
  { `end=` decides the STATEMENT KIND, not an argument: AN_WRITELN already
    appends the newline, so any other terminator means AN_WRITE (no newline)
    plus, when the terminator is non-empty, one more argument carrying it.
    end="\n" is exactly the default and stays a writeln. This matters for
    output correctness in uforth, not just tidiness: a Forth EMIT that appends
    a newline produces the wrong transcript against the CPython oracle. }
  if haveEnd and (endText <> #10) then
  begin
    ASTKind[node] := AN_WRITE;
    if endText <> '' then
    begin
      endLit := AllocNode(AN_STR_LIT);
      ASTSOffset[endLit] := PyStoredName(endText);
      ASTSLen[endLit] := Length(endText);
      ASTTk[endLit] := Ord(tyString);
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := endLit;
      ASTRight[argNode] := -1;
      ASTIVal[argNode] := 0;
      ASTSOffset[argNode] := -2;
      if lastArg < 0 then ASTLeft[node] := argNode
      else ASTRight[lastArg] := argNode;
      lastArg := argNode;
    end;
  end;
  ASTIVal[node] := writeFd;
  Result := node;
end;

{ A suite is either an INDENTED BLOCK or a one-line body on the same line as
  the header (`if not token: return None`). Python allows both everywhere a
  suite is legal, and uforth uses the one-line form heavily for guard clauses.
  Semicolon-separated statements are accepted in the one-line form, as Python
  does. }
{ ---- for/while `else` ----------------------------------------------------
  Python's loop `else` runs when the loop finished WITHOUT executing a break —
  not "if the body never ran", which is the reading that would silently invert
  an empty loop (`for i in []: ... else:` still runs the else).

  Desugared with a hidden flag bound to the loop the break belongs to:

      __loopelseN := False
      <loop>                  { every `break` in THIS loop's body first
                                assigns __loopelseN := True }
      if not __loopelseN then <else suite>

  PyLoopElseFlag is the innermost enclosing loop's flag, or -1. Every loop
  saves and restores it around its own body, so a `break` in a NESTED loop
  cannot touch the outer loop's flag — the outer else still runs, which is
  what CPython does. A loop with no `else` sets it to -1, so no dead
  assignment is emitted for the overwhelmingly common case.

  A `return` out of the loop skips the else for free: it never reaches the
  test. bug-nilpy-for-else-and-while-else-not-supported }
function PySkipToMatchingDedent(var k: Integer): Boolean; forward;
function PyLoopHasElseAhead: Boolean;
{ CurTok is on `for`/`while`. True when the loop's suite is followed by an
  `else` at the loop's own level. Decided by lookahead rather than after the
  fact because the flag must exist BEFORE the body is parsed — that is where
  the break assignments are built. }
var k, d: Integer;
begin
  PyLoopHasElseAhead := False;
  k := TokPos;                        { first token after the for/while }
  d := 0;
  while k < TokCount do               { find the header's own ':' }
  begin
    if Tokens[k].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(d)
    else if Tokens[k].Kind in [tkRParen, tkRBrack, tkEnd] then Dec(d)
    else if (Tokens[k].Kind = tkColon) and (d = 0) then Break
    else if Tokens[k].Kind in [tkNewline, tkEOF] then Exit;
    Inc(k);
  end;
  if (k >= TokCount) or (Tokens[k].Kind <> tkColon) then Exit;
  Inc(k);
  if (k < TokCount) and (Tokens[k].Kind = tkNewline) then
  begin
    { block form: skip the indented suite whole }
    Inc(k);
    while (k < TokCount) and (Tokens[k].Kind = tkNewline) do Inc(k);
    if not PySkipToMatchingDedent(k) then Exit;
  end
  else
  begin
    { one-liner body: `while c: x = 1` then `else:` on the next line }
    while (k < TokCount) and not (Tokens[k].Kind in [tkNewline, tkEOF]) do Inc(k);
    while (k < TokCount) and (Tokens[k].Kind = tkNewline) do Inc(k);
  end;
  PyLoopHasElseAhead := (k < TokCount) and (Tokens[k].Kind = tkElse);
end;

function PyMakeBoolLit(v: Boolean): Integer;
begin
  PyMakeBoolLit := AllocNode(AN_BOOL_LIT);
  ASTIVal[PyMakeBoolLit] := Ord(v);
  ASTTk[PyMakeBoolLit] := Ord(tyBoolean);
end;

function PyMakeFlagSet(sym: Integer; v: Boolean): Integer;
begin
  PyMakeFlagSet := AllocNode(AN_ASSIGN);
  ASTLeft[PyMakeFlagSet] := PyMakeIdent(sym);
  ASTRight[PyMakeFlagSet] := PyMakeBoolLit(v);
end;

function PyParseSuite: Integer;
var stmt, seq: Integer;
begin
  if CurTok.Kind = tkNewline then
  begin
    Expect(tkNewline, 'newline');
    Expect(tkIndent, 'indent');
    Result := PyParseBlock;
    Expect(tkDedent, 'dedent');
    Exit;
  end;
  seq := -1;
  repeat
    stmt := PyParseStatement;
    seq := PyFlushHoist(seq);
    seq := PySeqAppend(seq, stmt);
  until not Eat(tkSemicolon);
  if CurTok.Kind = tkNewline then Next;
  Result := seq;
end;

function PyParseIf: Integer;
var node, pairNode, condNode, thenNode, elseNode, condHoist: Integer;
begin
  Next;
  PyParseBoolExpr;
  condNode := PyMakeTruthy(CurASTNode);
  { protect the condition's hoisted setup from the nested suites' flush }
  condHoist := PyHoistHead; PyHoistHead := -1;
  Expect(tkColon, ':');
  thenNode := PyParseSuite;
  elseNode := -1;
  if PyIsIdent('elif') then
    elseNode := PyParseIf()
  else if CurTok.Kind = tkElse then
  begin
    Next;
    Expect(tkColon, ':');
    elseNode := PyParseSuite;
  end;
  PyHoistPrepend(condHoist);
  pairNode := AllocNode(AN_PAIR);
  ASTLeft[pairNode] := thenNode;
  ASTRight[pairNode] := elseNode;
  node := AllocNode(AN_IF);
  ASTLeft[node] := condNode;
  ASTRight[node] := pairNode;
  Result := node;
end;

{ pylib's own `Exception` — resolved BY UNIT, never by flat first match.

  This precision is REQUIRED, not defensive. Both pylib and sysutils now
  declare a class named `Exception` (siblings under ExceptionBase — see
  compiler/builtin/exceptions.pas), so `FindUClass('Exception')` answers
  whichever was registered first, which depends on import order. In a .npy that
  also pulls sysutils that would silently bind NilPy's `Exception` to the Pascal
  class — silently, because both are real classes and both have `msg`. The
  Pascal side of the same ambiguity is at least a compile error; this side
  would not be.

  -1 when pylib is not in this compilation at all. }
function PyLibExceptionCi: Integer;
var u: Integer;
begin
  PyLibExceptionCi := -1;
  u := FindUnitOrAlias('pylib');
  if u < 0 then Exit;
  PyLibExceptionCi := FindUClassInUnit('Exception', u);
end;

{ Nil Python's `Exception` root. It is registered lazily — as an empty shell —
  because nothing declares it: a user writes `class ForthThrow(Exception)` or
  `except Exception:` and expects the base to already be there. Both sites call
  this so the class index is the same one either way. }
function PyEnsureExceptionClass: Integer;
var k: Integer;
begin
  { `Result`, not the bare own name: for a PARAMETERLESS function the bare form
    is the one construct whose meaning differs between dialects — objfpc reads
    the result, delphi makes a recursive call — so --warn-self-result (on by
    default) flags it. This was the compiler's only occurrence. }
  Result := PyLibExceptionCi;
  if Result >= 0 then Exit;
  { pylib is not in this compilation. Fall back to the lazy shell, and look it
    up FLAT — there is no pylib unit to scope to, so first match is all there
    is and is unambiguous by construction. }
  Result := FindUClass('Exception');
  if Result < 0 then
  begin
    k := PyStoredName('Exception');
    AddUClass(k, 9);
    Result := FindUClass('Exception');
  end;
end;

{ `try:` / `except [Class [as name]]:` / `finally:` -> the shared AN_TRY_EXCEPT
  and AN_TRY_FINALLY nodes Pascal already lowers, so this is frontend shape
  only, no new runtime.

  Python allows except AND finally on one try; Pascal's nodes carry one or the
  other, so a try with both nests as TRY_FINALLY(TRY_EXCEPT(body, handlers),
  finalizer) — which is exactly Python's ordering (the handler runs first, the
  finalizer runs on every path out).

  A bare `except:` is the untyped catch-all (handler class -1); `except Class:`
  matches Class and its descendants, the same chain `on E: TFoo do` uses. The
  binder in `except Class as e:` becomes an ordinary local typed as the class,
  which is what makes `except ForthThrow as e: ... e.code` work. }
{ Is this `try:` the FALLBACK-IMPORT idiom — a block of nothing but imports,
  guarded by `except ImportError:` whose body is also nothing but imports? That
  shape is the most common portability construct in real Python, and under
  NilPy it is answered at COMPILE time: a module that does not resolve is not a
  runtime error we could catch, it is an import that cannot be compiled, so the
  frontend takes the other branch instead. CurTok is on `try`.
  feature-nilpy-fallback-import. }
function PyImportOnlyBlockAt(var k: Integer): Boolean;
{ k enters on the INDENT of a block; on True it leaves just past the matching
  DEDENT and every statement in between was an import. }
var stmtStart: Boolean;
begin
  PyImportOnlyBlockAt := False;
  if (k >= TokCount) or (Tokens[k].Kind <> tkIndent) then Exit;
  Inc(k);
  stmtStart := True;
  while k < TokCount do
  begin
    if Tokens[k].Kind = tkDedent then
    begin
      Inc(k);
      PyImportOnlyBlockAt := True;
      Exit;
    end;
    { a nested block cannot be a plain import run }
    if Tokens[k].Kind = tkIndent then Exit;
    if Tokens[k].Kind = tkNewline then stmtStart := True
    else if stmtStart then
    begin
      if not ((Tokens[k].Kind = tkUses) or
              ((Tokens[k].Kind = tkIdent) and CaseEqual(GetTokenStr(k), 'from'))) then Exit;
      stmtStart := False;
    end;
    Inc(k);
  end;
end;

{ Advance k from the INDENT of a block to just past its matching DEDENT. }
function PySkipToMatchingDedent(var k: Integer): Boolean;
var depth: Integer;
begin
  PySkipToMatchingDedent := False;
  if (k >= TokCount) or (Tokens[k].Kind <> tkIndent) then Exit;
  depth := 0;
  while k < TokCount do
  begin
    if Tokens[k].Kind = tkIndent then Inc(depth)
    else if Tokens[k].Kind = tkDedent then
    begin
      Dec(depth);
      if depth = 0 then begin Inc(k); PySkipToMatchingDedent := True; Exit; end;
    end;
    Inc(k);
  end;
end;

function PyIsFallbackImportTry: Boolean;
var i, blockAt: Integer;
begin
  PyIsFallbackImportTry := False;
  i := TokPos;                    { the ':' after `try` }
  if (i + 1 >= TokCount) or (Tokens[i].Kind <> tkColon) or
     (Tokens[i + 1].Kind <> tkNewline) then Exit;
  Inc(i, 2);
  while (i < TokCount) and (Tokens[i].Kind = tkNewline) do Inc(i);
  { the block must OPEN with an import — that is what makes the branch a
    resolution question rather than a runtime one }
  if (i >= TokCount) or (Tokens[i].Kind <> tkIndent) then Exit;
  blockAt := i;                   { the INDENT, for the block skip below }
  Inc(i);
  while (i < TokCount) and (Tokens[i].Kind = tkNewline) do Inc(i);
  if (i >= TokCount) then Exit;
  if not ((Tokens[i].Kind = tkUses) or
          ((Tokens[i].Kind = tkIdent) and CaseEqual(GetTokenStr(i), 'from'))) then Exit;
  { and the handler must be `except ImportError`, not a general one }
  i := blockAt;
  if not PySkipToMatchingDedent(i) then Exit;
  while (i < TokCount) and (Tokens[i].Kind = tkNewline) do Inc(i);
  if (i + 1 >= TokCount) or (Tokens[i].Kind <> tkExcept) then Exit;
  if (Tokens[i + 1].Kind <> tkIdent) or
     not CaseEqual(GetTokenStr(i + 1), 'ImportError') then Exit;
  PyIsFallbackImportTry := True;
end;

{ Consume the remainder of the block the parser is inside, stopping ON its
  DEDENT (which the caller consumes). }
procedure PySkipRestOfBlock;
var depth: Integer;
begin
  depth := 0;
  while CurTok.Kind <> tkEOF do
  begin
    if CurTok.Kind = tkIndent then Inc(depth)
    else if CurTok.Kind = tkDedent then
    begin
      if depth = 0 then Exit;
      Dec(depth);
    end;
    Next;
  end;
end;

{ Skip an indented block whole, without parsing it — the branch not taken. }
procedure PySkipIndentedBlock;
var depth: Integer;
begin
  Expect(tkIndent, 'indent');
  depth := 1;
  while (depth > 0) and (CurTok.Kind <> tkEOF) do
  begin
    if CurTok.Kind = tkIndent then Inc(depth)
    else if CurTok.Kind = tkDedent then Dec(depth);
    Next;
  end;
end;

{ Step over a `@overload`-decorated def, header and body, without registering
  anything. CPython's `overload` records the decorated function in an overload
  registry and the IMPLEMENTATION def that follows REPLACES it, so the stub's
  body — `...` by convention — never runs and its signature never binds. Its
  siblings among typing's run-time names (TypeVar, NewType, cast) are
  EXPRESSIONS and were answered by saying what value they have; this one is a
  statement, and the honest lowering is to drop it.

  The body may be one-line (`def f(x: int) -> int: ...`, which is what stubs
  almost always are) or indented, so both shapes are handled.
  bug-n-overload-decorator-is-refused }
procedure PySkipBalancedGroup; forward;
{ CurTok is the first token AFTER `@`. If the decorator's (possibly dotted)
  name is `overload`, consume the whole name and answer True; otherwise consume
  nothing and answer False, so the caller's other decorator arms still see an
  untouched cursor. Accepts `@overload` and `@typing.overload` alike — the
  latter is why plain `import typing` had to become a consumed root.
  bug-n-overload-decorator-is-refused }
function PyEatOverloadDecorator: Boolean;
var k: Integer;
begin
  Result := False;
  if CurTok.Kind <> tkIdent then Exit;
  k := TokPos - 1;                    { CurTok's own index }
  while (k + 2 < TokCount) and (Tokens[k + 1].Kind = tkDot) and
        (Tokens[k + 2].Kind = tkIdent) do
    k := k + 2;
  if GetTokenStr(k) <> 'overload' then Exit;
  while (TokPos - 1) <= k do Next;
  Result := True;
end;

procedure PySkipOverloadStubDef;
begin
  Expect(tkFunction, 'def');
  { header: everything up to the colon that ends it, brackets balanced so a
    default or an annotation containing one cannot end it early }
  while (CurTok.Kind <> tkColon) and (CurTok.Kind <> tkEOF) do
  begin
    if CurTok.Kind in [tkLParen, tkLBrack] then
    begin
      PySkipBalancedGroup;
      Continue;
    end;
    Next;
  end;
  Expect(tkColon, ':');
  if CurTok.Kind = tkNewline then
  begin
    PySkipNewlines;
    if CurTok.Kind = tkIndent then PySkipIndentedBlock;
  end
  else
    while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
  PySkipNewlines;
end;

{ Step over a balanced (...) / [...] group at the cursor. }
procedure PySkipBalancedGroup;
var depth: Integer;
begin
  depth := 0;
  repeat
    if CurTok.Kind in [tkLParen, tkLBrack] then Inc(depth)
    else if CurTok.Kind in [tkRParen, tkRBrack] then Dec(depth);
    Next;
  until (depth = 0) or (CurTok.Kind = tkEOF);
end;

{ `try: <imports> except ImportError: <imports>` resolved at compile time. The
  try-branch imports are attempted with the resolver in soft mode; if every
  module resolves, the except branch is skipped, and if any one misses, the
  except branch is compiled instead. Under CPython the same source prefers the
  try branch, so the file stays ordinary Python.

  A module that DID resolve before the missing one stays loaded. Python would
  have discarded that binding; here it costs an unused unit in the binary and
  nothing else, because unit scope is flat and the fallback branch rebinds the
  names it needs. }
function PyParseFallbackImportTry: Integer;
{ `try: <imports> ... except ImportError: ...` resolved at COMPILE time. An
  unresolvable module is not a runtime condition that could be caught — there is
  no code to run — so the frontend decides the branch instead: the try block's
  leading imports are attempted with the resolver in soft mode, and if any module
  is missing the whole try block is skipped and the handler compiled in its
  place. Under CPython the same source is ordinary Python and prefers the try
  branch, which is the point of the idiom.

  Two honest differences from CPython, both a consequence of deciding early:
  statements in the try block BEFORE the failing import do not run (here nothing
  in the block runs at all), and a module that resolved before the failing one
  stays loaded — an unused unit in the binary, since the handler rebinds whatever
  it needs. feature-nilpy-fallback-import. }
var body, savedHoist: Integer;
begin
  savedHoist := PyHoistHead;
  Next;                                { `try` }
  Expect(tkColon, ':');
  Expect(tkNewline, 'newline');
  PySkipNewlines;
  Expect(tkIndent, 'indent');
  SoftUnitResolve := True;
  SoftUnitMissed := False;
  PyParseImportRun;
  SoftUnitResolve := False;
  if SoftUnitMissed then
  begin
    { drop the rest of the try block: it depends on what did not resolve.
      Anything the IMPORT RUN itself queued as a hoisted setup statement goes
      with it — the block is not being compiled, so a setup for it would be
      emitted into the enclosing body naming symbols that block never
      allocated (render_backend's PIL guard did exactly this: a stray IR_LEA of
      a rolled-back temp, reported at the module's last line). }
    PyHoistHead := savedHoist;
    PySkipRestOfBlock;
    Expect(tkDedent, 'dedent');
    PySkipNewlines;
    Expect(tkExcept, 'except');
    Next;                              { ImportError }
    if PyIsIdent('as') then begin Next; Next; end;
    Expect(tkColon, ':');
    Expect(tkNewline, 'newline');
    PySkipNewlines;
    Expect(tkIndent, 'indent');
    body := PyParseBlock;
    Expect(tkDedent, 'dedent');
  end
  else
  begin
    body := PyParseBlock;              { the rest of the try block }
    Expect(tkDedent, 'dedent');
    PySkipNewlines;
    Expect(tkExcept, 'except');
    Next;                              { ImportError }
    if PyIsIdent('as') then begin Next; Next; end;
    Expect(tkColon, ':');
    Expect(tkNewline, 'newline');
    PySkipNewlines;
    PySkipIndentedBlock;               { the handler cannot be reached }
  end;
  { This statement consumed its own indented block(s) — and the DEDENT that
    closed the last one — exactly as a nested def does, so tell the block
    parser rather than leaving it to demand a newline that is gone.
    Without this a fallback-import inside a FUNCTION body made the next
    statement read as a continuation. }
  PyStmtAteBlock := True;
  PyParseFallbackImportTry := body;
end;

function PyBridgeRootCi: Integer;
{ sysutils' Pascal `Exception` — the class a bare NilPy `except Exception:`
  BRIDGES to alongside pylib's PyException — or -1 when sysutils is not in this
  compilation at all.

  WHY THIS CHECKS ANYTHING. A tuple handler shares ONE binder symbol across its
  arms, typed as the FIRST listed class (PyParseTry: `the first listed class`).
  Inside the Python tree that is harmless — every arm descends from PyException,
  so a common member sits at a common offset by construction. The bridge is the
  one handler in the language whose arms come from two UNRELATED hierarchies, so
  on the sysutils arm `e` is typed PyException and points at a sysutils object,
  and `e.args` / `e.Message` read pylib's offsets against the other class's
  storage.

  The two classes agreed member-for-member when they were one row deliberately
  shared (ClassNameIsDeliberatelyShared). They are independent now, which is the
  whole point of the rename — so nothing keeps them agreeing except this check,
  and the failure it prevents is the expensive kind: not a crash, a plausible
  wrong string read from the wrong offset, in an exception handler, where nobody
  is looking.

  Narrow on purpose: `msg` is the ONLY member the bridge actually depends on
  (Message/FMessage are properties over it, and `print(e)` reads the field
  directly through a frontend-synthesised access). Checking the whole surface
  would refuse divergence that costs nothing.
  decide-pylib-exception-vs-sysutils-exception, bug-pascal-uses-is-transitive }
var bridgeCi, pyCi, pf, bf, suIdx: Integer;
begin
  PyBridgeRootCi := -1;
  { BY UNIT. pylib declares a class named `Exception` too now, so a flat
    FindUClass would answer with pylib's own row and "bridge" it to itself. }
  suIdx := FindUnitOrAlias('sysutils');
  if suIdx < 0 then Exit;
  bridgeCi := FindUClassInUnit('Exception', suIdx);
  if bridgeCi < 0 then Exit;
  pyCi := PyLibExceptionCi;
  if pyCi < 0 then Exit;
  pf := FindUField(pyCi, 'msg');
  bf := FindUField(bridgeCi, 'msg');
  if (pf < 0) or (bf < 0) or (UFldOff_[pf] <> UFldOff_[bf]) or
     (UFldTk[pf] <> UFldTk[bf]) then
    Error('Nil Python: a bare `except Exception:` bridges pylib''s PyException '
      + 'and sysutils'' Exception, and the two no longer share their message '
      + 'field. The handler binds ONE variable across both arms, so a caught '
      + 'sysutils exception would be read at pylib''s offsets and hand back a '
      + 'wrong message instead of failing. Keep `msg` as the first field of '
      + 'both classes, same type — that is the only member the bridge depends '
      + 'on (decide-pylib-exception-vs-sysutils-exception)');
  PyBridgeRootCi := bridgeCi;
end;

function PyParseTry: Integer;
var node, innerNode, trySeq, finSeq, handlerHead, lastHandler, handlerNode: Integer;
    actionSeq, handlerVar, ci, recId: Integer;
    elseSeq, elseFlag, elsePair, elseIf: Integer;
    handlerName, className, hidName: AnsiString;
    excRecs: array[0..15] of Integer; nExc, ei: Integer;   { except (A, B, ...) tuple }
    bridgeCi: Integer;                 { sysutils' Pascal `Exception`, when the arm is the bare root }
    hidLo, hidHi, hidDepth: Integer;   { the handler suite, for the binder rename }
begin
  Inc(GenTryDepth);
  Next;                                { `try` }
  Expect(tkColon, ':');
  Expect(tkNewline, 'newline');
  Expect(tkIndent, 'indent');
  trySeq := PyParseBlock;
  Expect(tkDedent, 'dedent');
  PySkipNewlines;

  handlerHead := -1;
  lastHandler := -1;
  while CurTok.Kind = tkExcept do
  begin
    Next;
    recId := -1;
    handlerVar := -1;
    nExc := 0;
    if CurTok.Kind <> tkColon then
    begin
      { `except Class:` OR `except (A, B, C):` — a tuple catches any of them.
        A tuple becomes one handler node per class, sharing the action and the
        binder (Python binds `e` to whichever was caught). }
      if CurTok.Kind = tkLParen then
      begin
        Next;
        while CurTok.Kind <> tkRParen do
        begin
          if CurTok.Kind <> tkIdent then Error('Nil Python: except: expected an exception class');
          className := CurTok.SVal;
          Next;
          { a QUALIFIED class inside the tuple too — `except (OSError,
            json.JSONDecodeError):` is how a file read is guarded. The single
            form below has taken this since tk.TclError; the tuple form did not,
            and reported the MODULE name as an unknown exception class. }
          if (CurTok.Kind = tkDot) and (TokPos < TokCount) and
             (Tokens[TokPos].Kind = tkIdent) then
          begin
            Next;
            className := CurTok.SVal;
            Next;
          end;
          if CaseEqual(className, 'Exception') then ci := PyEnsureExceptionClass
          else ci := FindUClass(className);
          if ci < 0 then Error('Nil Python: unknown exception class ' + className);
          if nExc > 15 then Error('Nil Python: too many exception classes in one except');
          excRecs[nExc] := REC_UCLASS_BASE + ci; Inc(nExc);
          { `except Exception:` in Python catches EVERYTHING the program can
            raise, and in a NilPy program that includes a raise from a Pascal
            RTL unit — whose hierarchy roots at sysutils' own `Exception`, a
            genuinely different class now that pylib's is PyException
            (decide-pylib-exception-vs-sysutils-exception option 5). This is
            the explicit BRIDGE that replaces the old namespace merge: the bare
            root arm catches both roots, using the tuple machinery already
            here. A QUALIFIED `su.Exception` is not this arm — className is
            'Exception' there, unmapped by the lexer — and stays one class,
            which is what makes the two distinguishable at all. }
          if CaseEqual(className, 'Exception') then
          begin
            bridgeCi := PyBridgeRootCi;
            if (bridgeCi >= 0) and (nExc <= 15) then
            begin excRecs[nExc] := REC_UCLASS_BASE + bridgeCi; Inc(nExc); end;
          end;
          if not Eat(tkComma) then Break;
        end;
        Expect(tkRParen, ')');
        recId := excRecs[0];
      end
      else
      begin
        if CurTok.Kind <> tkIdent then Error('Nil Python: except: expected an exception class');
        className := CurTok.SVal;
        Next;
        { `except tk.TclError:` — a QUALIFIED class. Unit scope is flat, so the
          member name alone resolves; the qualifier just has to be consumed. }
        if (CurTok.Kind = tkDot) and (TokPos < TokCount) and
           (Tokens[TokPos].Kind = tkIdent) then
        begin
          Next;
          className := CurTok.SVal;
          Next;
        end;
        if CaseEqual(className, 'Exception') then ci := PyEnsureExceptionClass
        else ci := FindUClass(className);
        if ci < 0 then Error('Nil Python: unknown exception class ' + className);
        recId := REC_UCLASS_BASE + ci;
        excRecs[0] := recId; nExc := 1;
          { `except Exception:` in Python catches EVERYTHING the program can
            raise, and in a NilPy program that includes a raise from a Pascal
            RTL unit — whose hierarchy roots at sysutils' own `Exception`, a
            genuinely different class now that pylib's is PyException
            (decide-pylib-exception-vs-sysutils-exception option 5). This is
            the explicit BRIDGE that replaces the old namespace merge: the bare
            root arm catches both roots, using the tuple machinery already
            here. A QUALIFIED `su.Exception` is not this arm — className is
            'Exception' there, unmapped by the lexer — and stays one class,
            which is what makes the two distinguishable at all. }
        if CaseEqual(className, 'Exception') then
        begin
          bridgeCi := PyBridgeRootCi;
          if bridgeCi >= 0 then
          begin excRecs[nExc] := REC_UCLASS_BASE + bridgeCi; Inc(nExc); end;
        end;
      end;
      if PyIsIdent('as') then
      begin
        Next;
        if CurTok.Kind <> tkIdent then Error('Nil Python: except ... as: expected a name');
        handlerName := CurTok.SVal;
        Next;
        { Python SCOPES the binder to the handler — it is deleted when the
          handler ends — so `except ValueError as e:` must not leave a
          class-typed `e` behind for the rest of the module to collide with.
          It did: AllocVar created a second symbol under the user's spelling
          that then WON for every later reference, so an ordinary later
          `e = STOCK[k]` stored a dict into an exception-typed slot and reading
          it back SIGSEGV'd — with `e` an utterly ordinary name to reuse.

          Same treatment a comprehension's loop variable already gets: bind a
          HIDDEN name and re-spell the references inside the handler's own
          suite (PyRenameIdentRange). Derived from the suite's INDENT token
          INDEX and nothing else, so a trial parse that renames and a real
          parse that renames again compute the SAME name and the second pass is
          a no-op — the comprehension names have to be idempotent for exactly
          this reason.
          bug-nilpy-except-as-binder-leaks-and-collides-with-a-later-name }
        hidLo := TokPos - 1;
        while (hidLo < TokCount) and (Tokens[hidLo].Kind in [tkColon, tkNewline]) do
          Inc(hidLo);
        if (hidLo < TokCount) and (Tokens[hidLo].Kind = tkIndent) then
        begin
          hidHi := hidLo + 1;
          hidDepth := 1;
          while (hidHi < TokCount) and (hidDepth > 0) do
          begin
            if Tokens[hidHi].Kind = tkIndent then Inc(hidDepth)
            else if Tokens[hidHi].Kind = tkDedent then Dec(hidDepth);
            Inc(hidHi);
          end;
          hidName := '__py_exc' + PyIntLiteralText(hidLo);
          PyRenameIdentRange(hidLo, hidHi, handlerName, hidName);
          handlerName := hidName;
        end;
        handlerVar := AllocVar(handlerName, tyClass);
        Syms[handlerVar].RecName := recId;   { the first listed class }
        SymSyncTypeRef(handlerVar);
      end;
    end;
    Expect(tkColon, ':');
    Expect(tkNewline, 'newline');
    Expect(tkIndent, 'indent');
    Inc(ExceptionHandlerParseDepth);
    actionSeq := PyParseBlock;
    Dec(ExceptionHandlerParseDepth);
    Expect(tkDedent, 'dedent');
    PySkipNewlines;
    { one handler node per listed class (>=1); a bare `except:` has nExc=0 and
      still emits a single catch-all (recId -1). }
    ei := 0;
    repeat
      handlerNode := AllocNode(AN_EXC_HANDLER);
      if nExc = 0 then ASTIVal[handlerNode] := -1
      else ASTIVal[handlerNode] := excRecs[ei];
      ASTSOffset[handlerNode] := handlerVar;
      ASTLeft[handlerNode] := actionSeq;
      if handlerHead = -1 then handlerHead := handlerNode
      else ASTRight[lastHandler] := handlerNode;
      lastHandler := handlerNode;
      Inc(ei);
    until ei >= nExc;
  end;

  { `try ... else:` — the third of Python's statement-level else clauses (see
    the loop-else note above PyLoopHasElseAhead). Its rule is "run when the try
    body completed without raising", and an exception raised INSIDE the else
    must not be caught by this statement's own handlers.

    Same hidden-flag shape as the loops, set as the last statement of the
    protected body so it runs only on completion — a `return`, `break` or a
    raise out of the try body all skip the else for free:

        __tryelseN := False
        try: <body>; __tryelseN := True
        except ...: <handlers>
        if __tryelseN: <else suite>          { OUTSIDE the try/except }

    Python orders the else BEFORE finally, so the test is placed inside the
    try-FINALLY's protected region and outside the try-EXCEPT's — which also
    gives the else body the finally's protection without the except's, exactly
    as CPython does. bug-nilpy-for-else-and-while-else-not-supported }
  elseSeq := -1;
  elseFlag := -1;
  if CurTok.Kind = tkElse then
  begin
    if handlerHead = -1 then
      Error('Nil Python: try ... else: needs an except: clause');
    Next;
    Expect(tkColon, ':');
    Expect(tkNewline, 'newline');
    Expect(tkIndent, 'indent');
    elseFlag := AllocVar(PyHiddenName('tryelse'), tyBoolean);
    elseSeq := PyParseBlock;
    Expect(tkDedent, 'dedent');
    PySkipNewlines;
    if ASTKind[trySeq] <> AN_SEQ then trySeq := PySeqAppend(-1, trySeq);
    trySeq := PySeqAppend(trySeq, PyMakeFlagSet(elseFlag, True));
  end;

  finSeq := -1;
  if CurTok.Kind = tkFinally then
  begin
    Next;
    Expect(tkColon, ':');
    Expect(tkNewline, 'newline');
    Expect(tkIndent, 'indent');
    finSeq := PyParseBlock;
    Expect(tkDedent, 'dedent');
  end;

  if (handlerHead = -1) and (finSeq = -1) then
    Error('Nil Python: try: needs an except: or a finally:');

  innerNode := trySeq;
  if handlerHead >= 0 then
  begin
    node := AllocNode(AN_TRY_EXCEPT);
    ASTLeft[node] := trySeq;
    ASTRight[node] := handlerHead;
    innerNode := node;
  end;
  if elseSeq >= 0 then
  begin
    elsePair := AllocNode(AN_PAIR);
    ASTLeft[elsePair] := elseSeq;
    ASTRight[elsePair] := -1;
    elseIf := AllocNode(AN_IF);
    ASTLeft[elseIf] := PyMakeIdent(elseFlag);
    ASTRight[elseIf] := elsePair;
    innerNode := PySeqAppend(PySeqAppend(-1, innerNode), elseIf);
  end;
  if finSeq >= 0 then
  begin
    node := AllocNode(AN_TRY_FINALLY);
    ASTLeft[node] := innerNode;
    ASTRight[node] := finSeq;
    innerNode := node;
  end;
  Dec(GenTryDepth);
  if elseSeq >= 0 then
  begin
    { the flag has to be cleared before the statement runs, and the result is
      now an AN_SEQ rather than a try node — PyParseBlock keys its
      block-consumed check on the node kind, so say so explicitly }
    innerNode := PySeqAppend(PySeqAppend(-1, PyMakeFlagSet(elseFlag, False)), innerNode);
    PyStmtAteBlock := True;
  end;
  PyParseTry := innerNode;
end;

function PyParseWhile: Integer;
var node, condHoist, condNode, scan, n, k, cm: Integer;
    hStmts: array[0..63] of Integer;
begin
  Next;
  PyParseBoolExpr;
  node := AllocNode(AN_WHILE);
  condNode := PyMakeTruthy(CurASTNode);
  condHoist := PyHoistHead; PyHoistHead := -1;
  { The condition's hoisted setup must be re-evaluated on EVERY test, so it is
    folded INTO the condition as a right-nested comma chain (`h1, h2, cond` —
    ir.inc's AN_COMMA arm evaluates each Left for its effect and yields the
    Right) rather than stashed for the enclosing flush.

    It used to be flushed OUTSIDE the loop, on the reasoning that the hoist is a
    constant literal build: *"a literal in a while CONDITION is built once,
    before the loop — CPython rebuilds it per test; acceptable divergence, the
    pattern is `while x in ("a","b")` membership against constants."* True for a
    literal, false for everything else that hoists — a string METHOD call hoists
    too, and it is not loop-invariant:

        while s.startswith("a"): s = s[1:]      { ran 10x on "aaab", CPython 3 }
        while j < len(s) and s[j].isdigit():    { never stopped at the space }
            j := j + 1

    The condition was computed once, before the loop, and every later test read
    the stale result. Silent, and it broke the ordinary scanner idiom — found by
    a hand-written tokenizer that returned its whole input as one token
    (bug-nilpy-a-method-call-in-a-while-condition-is-evaluated-once).

    The literal case now rebuilds per test: an allocation per iteration, which
    is what CPython does anyway, in exchange for the condition being true. }
  n := 0;
  scan := condHoist;
  while (scan >= 0) and (n <= High(hStmts)) do
  begin
    if ASTLeft[scan] >= 0 then
    begin
      hStmts[n] := ASTLeft[scan];
      Inc(n);
    end;
    scan := ASTRight[scan];
  end;
  { More hoisted setup than the fold can hold — leave the REMAINDER to the
    enclosing flush, as the whole chain used to be. Never silently dropped. }
  if scan >= 0 then PyHoistPrepend(scan);
  for k := n - 1 downto 0 do
  begin
    cm := AllocNode(AN_COMMA);
    ASTLeft[cm] := hStmts[k];
    ASTRight[cm] := condNode;
    ASTTk[cm] := ASTTk[condNode];
    condNode := cm;
  end;
  ASTLeft[node] := condNode;
  Expect(tkColon, ':');
  ASTRight[node] := PyParseSuite;
  Result := node;
end;

function PyParseLoopMaybeElse(isFor: Boolean): Integer;
{ Parses a `for`/`while` and, when one follows, its `else` clause. See the
  note above PyLoopHasElseAhead for the desugar and why the flag is allocated
  BEFORE the body. }
var save, flagSym, loopNode, elseBody, ifNode, pairNode, notNode, seq: Integer;
begin
  save := PyLoopElseFlag;
  flagSym := -1;
  if PyLoopHasElseAhead then
    flagSym := AllocVar(PyHiddenName('loopelse'), tyBoolean);
  PyLoopElseFlag := flagSym;
  if isFor then loopNode := PyParseFor else loopNode := PyParseWhile;
  PyLoopElseFlag := save;
  if flagSym < 0 then
  begin
    PyParseLoopMaybeElse := loopNode;
    Exit;
  end;
  { the lookahead promised an else; a mismatch here is a parser bug, not a
    user error, so Expect's own diagnostic is the right one }
  Expect(tkElse, 'else');
  Expect(tkColon, ':');
  elseBody := PyParseSuite;
  notNode := AllocNode(AN_NOT);
  ASTLeft[notNode] := PyMakeIdent(flagSym);
  ASTTk[notNode] := Ord(tyBoolean);
  pairNode := AllocNode(AN_PAIR);
  ASTLeft[pairNode] := elseBody;
  ASTRight[pairNode] := -1;
  ifNode := AllocNode(AN_IF);
  ASTLeft[ifNode] := notNode;
  ASTRight[ifNode] := pairNode;
  seq := PySeqAppend(-1, PyMakeFlagSet(flagSym, False));
  seq := PySeqAppend(seq, loopNode);
  seq := PySeqAppend(seq, ifNode);
  { an AN_SEQ is not one of the block-consuming node kinds PyParseBlock knows,
    so tell it explicitly that both suites are already eaten }
  PyStmtAteBlock := True;
  PyParseLoopMaybeElse := seq;
end;

{ `with EXPR as VAR:` — desugared to `VAR = EXPR` followed by the body. The
  context-manager protocol (__enter__/__exit__) is not modelled: the only
  censused use is `with open(...) as f`, and pyopen reads the whole file
  eagerly, so there is nothing to close. A `with` without `as` runs the body
  after evaluating EXPR for its effect. }
function PyCallMeth3(ci: Integer; const mname: AnsiString;
                     selfNode, arg1, arg2, arg3: Integer): Integer;
{ Three explicit args -- `__exit__(self, exc_type, exc_value, traceback)` is the
  only caller today. Mirrors PyCallMeth2; kept as a fixed-arity helper because
  that is what every dunder dispatch in this frontend already uses. }
var mmi, mpi, selfArg, a1, a2, a3: Integer;
begin
  Result := -1;
  if ci < 0 then Exit;
  mmi := FindUMeth(ci, mname);
  if mmi < 0 then Exit;
  mpi := UMthProc_[mmi];
  selfArg := AllocNode(AN_ARG); ASTLeft[selfArg] := selfNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := arg1;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := arg2;
  a3 := AllocNode(AN_ARG); ASTLeft[a3] := arg3;
  ASTRight[selfArg] := a1;
  ASTRight[a1] := a2;
  ASTRight[a2] := a3;
  ASTRight[a3] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := mpi;
  ASTTk[Result] := Ord(Procs[mpi].RetType);
  ASTLeft[Result] := selfArg;
end;

{ One manager of a `with`, and everything to its right. Split from PyParseWith
  so the COMMA form can recurse into itself: Python DEFINES
  `with A() as a, B() as b:` as `with A() as a:` containing `with B() as b:`,
  so nesting is not an approximation of it — it is the specification. That also
  gets __exit__ ORDER right for free (innermost first, on the exception path
  too), which is the part a flattened lowering would get wrong.
  Entered with `with` (or the preceding comma) already consumed.
  feature-nilpy-with-multiple-context-managers }
function PyParseWithTail: Integer;
var exprNode, node, seq, symIdx, cmCi, cmSym, entNode, exitNode, bodyNode: Integer;
    varName: AnsiString; usesProtocol: Boolean;
begin
  PyParseBoolExpr;
  exprNode := CurASTNode;
  seq := -1;

  { CONTEXT-MANAGER protocol. Historically `with E as v:` was desugared to
    `v = E` plus the body, on the grounds that the only censused use was
    `with open(...) as f` and pyopen reads eagerly, so there was nothing to
    close. That silently does NOTHING for a user-defined context manager:
    __enter__ never runs, `as v` binds the EXPRESSION rather than what
    __enter__ chose to return, and __exit__ never runs — so a lock is never
    released and a rollback never happens, with no diagnostic.
    bug-nilpy-with-statement-skips-enter-and-exit.

    Only taken when the expression's class actually declares __enter__, so the
    open()/file path and every other existing use keep their exact behaviour. }
  cmCi := -1;
  usesProtocol := False;
  if (IntToTypeKind(ASTTk[exprNode]) = tyClass) and
     (ResolveNodeRec(exprNode) >= REC_UCLASS_BASE) and
     not PyRecIsPylibOwnClass(ResolveNodeRec(exprNode)) then
  begin
    cmCi := ResolveNodeRec(exprNode) - REC_UCLASS_BASE;
    usesProtocol := (FindUMeth(cmCi, '__enter__') >= 0) or
                    (FindUMeth(cmCi, '__exit__') >= 0);
  end;

  if usesProtocol then
  begin
    { hold the manager in a hidden temp: __exit__ must run on the SAME object
      __enter__ ran on, and the `as` target may be rebound in the body. }
    cmSym := AllocVar(PyHiddenName('cm'), tyClass);
    Syms[cmSym].RecName := REC_UCLASS_BASE + cmCi;
    SymSyncTypeRef(cmSym);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(cmSym);
    ASTRight[node] := exprNode;
    seq := PySeqAppend(seq, node);

    entNode := -1;
    if FindUMeth(cmCi, '__enter__') >= 0 then
      entNode := PyCallMeth1(cmCi, '__enter__', PyMakeIdent(cmSym), -1);

    if PyIsIdent('as') then
    begin
      Next;
      if CurTok.Kind <> tkIdent then Error('Nil Python: with ... as: expected a name');
      varName := CurTok.SVal;
      Next;
      { `as v` binds __enter__'s RESULT, not the expression — a context manager
        returning something other than self is exactly why the protocol has a
        return value. }
      if entNode >= 0 then
      begin
        symIdx := PyProgSym(varName);
        if symIdx < 0 then symIdx := AllocVar(varName, IntToTypeKind(ASTTk[entNode]));
        if IntToTypeKind(ASTTk[entNode]) = tyClass then
        begin
          Syms[symIdx].RecName := ResolveNodeRec(entNode);
          SymSyncTypeRef(symIdx);
        end;
        node := AllocNode(AN_ASSIGN);
        ASTLeft[node] := PyMakeIdent(symIdx);
        ASTRight[node] := entNode;
        seq := PySeqAppend(seq, node);
      end;
    end
    else if entNode >= 0 then
      seq := PySeqAppend(seq, entNode);   { run __enter__ for its effect }

    { a COMMA means more managers: the rest of the list becomes THIS one's body,
      which is exactly the nesting Python defines. }
    if CurTok.Kind = tkComma then
    begin
      Next;
      { PARENS: a bare own-function name READS Result in this dialect rather
        than calling — so `bodyNode := PyParseWithTail;` recursed not at all,
        silently handed back an uninitialised node, and left the remaining
        managers in the token stream for the statement loop to choke on.
        project_bare_funcname_result_partial. }
      bodyNode := PyParseWithTail();
    end
    else
    begin
      Expect(tkColon, ':');
      bodyNode := PyParseSuite;
    end;
    PyStmtAteBlock := True;

    { try/finally so __exit__ runs on the exception path and on break/return
      too. NOT try/except: CPython lets a truthy __exit__ SUPPRESS the
      exception, and that needs the exception triple plus a conditional
      re-raise — filed as its own follow-up rather than faked here, because a
      wrong suppression would swallow errors silently. Every non-suppressing
      manager (the overwhelming majority — __exit__ returning None/False) is
      exactly right with try/finally. }
    if FindUMeth(cmCi, '__exit__') >= 0 then
    begin
      { exc_type / exc_value / traceback are None: try/FINALLY does not hand
        the exception over, and CPython uses them only for suppression, which
        is the follow-up. Documented on the ticket rather than faked. }
      exitNode := PyCallMeth3(cmCi, '__exit__', PyMakeIdent(cmSym),
                              PyMakeNone, PyMakeNone, PyMakeNone);
      if exitNode >= 0 then
      begin
        node := AllocNode(AN_TRY_FINALLY);
        ASTLeft[node] := bodyNode;
        { The finally body must be a STATEMENT, not a bare call EXPRESSION.
          PyCallMeth3 yields a value node, and the IR lowering emits an unused
          value on the fall-through/return path without marking it a statement
          root — so it was pruned, and `__exit__` never ran there. The EXCEPTION
          path survived because the landing pad lowers its copy as a root
          regardless, which is exactly why the exception case measured correct
          and made the node kind look innocent: the same AN_TRY_FINALLY was
          right in one arm and dead in the other.

          A statement-level `finally:` suite is an AN_SEQ, which is why the
          identical program written with try/finally always worked. Wrapping in
          the same seq is the whole fix.
          bug-nilpy-return-inside-a-with-skips-exit }
        ASTRight[node] := PySeqAppend(-1, exitNode);
        bodyNode := node;
      end;
    end;
    seq := PySeqAppend(seq, bodyNode);
    Result := seq;
    Exit;
  end;

  if PyIsIdent('as') then
  begin
    Next;
    if CurTok.Kind <> tkIdent then Error('Nil Python: with ... as: expected a name');
    varName := CurTok.SVal;
    Next;
    symIdx := PyProgSym(varName);
    if symIdx < 0 then symIdx := AllocVar(varName, IntToTypeKind(ASTTk[exprNode]));
    if IntToTypeKind(ASTTk[exprNode]) = tyClass then
    begin
      Syms[symIdx].RecName := ResolveNodeRec(exprNode);
      SymSyncTypeRef(symIdx);
    end;
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := exprNode;
    seq := PySeqAppend(seq, node);
  end
  else
    seq := PySeqAppend(seq, exprNode);   { evaluate for effect }
  if CurTok.Kind = tkComma then
  begin
    Next;
    seq := PySeqAppend(seq, PyParseWithTail());   { parens — see the note above }
  end
  else
  begin
    Expect(tkColon, ':');
    seq := PySeqAppend(seq, PyParseSuite);
  end;
  PyStmtAteBlock := True;                 { consumed our own body block }
  Result := seq;
end;

function PyParseWith: Integer;
begin
  Next;                                  { consume `with` }
  Result := PyParseWithTail;
end;

{ A distinct name per hidden loop temp, so nested for-in loops do not share
  an index or a container slot. }
function PyHiddenName(const stem: AnsiString): AnsiString;
begin
  Inc(PyHiddenSeq);
  Result := '__py_' + stem + '_' + PyIntLiteralText(PyHiddenSeq);
end;

{ Rewrite every identifier token spelled `oldName` within [lo, hi) to
  `newName`. Used to give a comprehension's loop variable its OWN hidden
  binding: a comprehension's target is scoped to itself in Python (unlike a
  plain `for`, which deliberately leaks into the enclosing scope), and this
  compiler has no real block-scoping to fall back on, so the loop variable's
  references are re-spelled to a fresh hidden name instead
  (bug-nilpy-comprehension-variable-leaks-and-clobbers-the-enclosing-scope). }
procedure PyRenameIdentRange(lo, hi: Integer; const oldName, newName: AnsiString);
{ A raw token (TRawToken) has no string field of its own — its text is
  SOffset/SLen into the shared TokChars buffer, which existing tokens' bytes
  may overlap or alias. Point a matching token at a FRESH copy of `newName`
  interned via PyStoredName (memoised: every renamed token in this range
  shares the one copy) rather than writing through a field that does not
  exist on the raw token record. }
var k, newOff: Integer;
begin
  if (lo < 0) or (hi < 0) then Exit;
  newOff := -1;
  for k := lo to hi - 1 do
    if (Tokens[k].Kind = tkIdent) and (Tokens[k].SLen = Length(oldName)) and
       (GetTokenStrFromRaw(Tokens[k].SOffset, Tokens[k].SLen) = oldName) then
    begin
      if newOff < 0 then newOff := PyStoredName(newName);
      Tokens[k].SOffset := newOff;
      Tokens[k].SLen := Length(newName);
    end;
end;

{ A comprehension's loop-variable hidden name must be STABLE across repeated
  parses of the same source tokens: the typing pre-pass
  (PyCollectModuleLocalsAST) and the real pass both call PyParseForIn over
  the SAME token stream, and PyRenameIdentRange's rewrite of the identifier
  tokens is a PERMANENT mutation (raw tokens have no independent text of
  their own, see PyRenameIdentRange) — so a counter-based name (PyHiddenName)
  would rename 'x' to, say, '__py_x_2' on the pre-pass, then find no more
  literal 'x' tokens to rename on the real pass (they already read
  '__py_x_2') while allocating a DIFFERENT symbol name for that pass,
  leaving the token pointing at a symbol from the discarded pre-pass table
  ("undefined variable"). Deriving the name from the `for` token's own
  position instead of a counter makes the rename idempotent: pass two sees
  the token already renamed, matches nothing, and simply allocates its own
  fresh symbol under the same deterministic name the token already reads. }
{ `<userVar> = <counter>` prepended to a counted loop's body, so the user's loop
  variable only ever holds a value the loop actually YIELDED. See the note in the
  range lowering: making the user's variable be the counter left it one step past
  the end on normal exit and clobbered it with `start` on zero iterations.

  Prepend, not append: the body READS the variable, so the copy has to be the
  first statement. PySeqAppend only appends, hence the explicit re-link here. }
function PyPrependLoopVarCopy(bodyNode, userSym, cntSym: Integer): Integer;
var cp, seq: Integer;
begin
  cp := AllocNode(AN_ASSIGN);
  ASTLeft[cp] := PyMakeIdent(userSym);
  ASTRight[cp] := PyMakeIdent(cntSym);
  seq := AllocNode(AN_SEQ);
  ASTLeft[seq] := cp;
  ASTRight[seq] := bodyNode;
  PyPrependLoopVarCopy := seq;
end;

function PyCompHiddenLoopName(tokIdx, slot: Integer): AnsiString;
begin
  Result := '__py_cv' + PyIntLiteralText(tokIdx) + '_' + PyIntLiteralText(slot);
end;

{ Find the depth-0 closing bracket of a comprehension/filter header starting
  at `fromTok`, tracking nested brackets so an inner `[...]`/`{...}` isn't
  mistaken for the outer one's closer. Also records the first depth-0 `if`
  (a filter clause) into `filtIdx`, without stopping there — the real closer
  sits AFTER the filter condition. }
function PyCompForAfter(fromTok, closerPos: Integer): Boolean;
{ Does another `for` CLAUSE follow, at depth 0, before the comprehension closes?
  Asked at a filter: `[x + y for x in xs if x > 0 for y in ys]` filters the OUTER
  loop and then opens an inner one, so the filter has to WRAP the rest of the
  header rather than gate the append. A trailing filter (no `for` after it) keeps
  the plain append-gating form.
  bug-nilpy-a-filter-between-two-for-clauses-is-not-supported }
var i, depth: Integer;
begin
  Result := False;
  i := fromTok;
  depth := 0;
  while (i < TokCount) and ((closerPos < 0) or (i < closerPos)) do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      if depth = 0 then Exit;
      Dec(depth);
    end
    else if Tokens[i].Kind in [tkNewline, tkEOF] then Exit
    else if (depth = 0) and
            (((Tokens[i].Kind = tkIdent) and StrEqual(GetTokenStr(i), 'for')) or
             (Tokens[i].Kind = tkFor)) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyCompFindClose(fromTok: Integer; var filtIdx: Integer): Integer;
var fj, fdepth: Integer;
begin
  fj := fromTok;
  fdepth := 0;
  filtIdx := -1;
  Result := -1;
  while fj < TokCount do
  begin
    case Tokens[fj].Kind of
      tkLParen, tkLBrack, tkBegin: Inc(fdepth);
      tkRParen, tkRBrack, tkEnd:
        begin
          if fdepth = 0 then begin Result := fj; Exit; end;
          Dec(fdepth);
        end;
      tkNewline, tkEOF: Exit;
      tkIf: if (fdepth = 0) and (filtIdx < 0) then filtIdx := fj;
    end;
    Inc(fj);
  end;
end;

{ Build `container.<meth>(args...)` as an AN_CALL, given the container's class
  index. Returns -1 when the method is absent. }
function PyNodeListCi(n: Integer): Integer;
{ The TPyList class index when n is a list, else -1. `xs += ys` on lists is
  Python's IN-PLACE extend; lowering it as `xs := xs + ys` added the two class
  HANDLES and crashed (bug-a-nilpy-list-augmented-add-segfaults). }
var ci, rec: Integer;
begin
  PyNodeListCi := -1;
  if n < 0 then Exit;
  if IntToTypeKind(ASTTk[n]) <> tyClass then Exit;
  ci := FindUClass('TPyList');
  if ci < 0 then Exit;
  rec := ResolveNodeRec(n);
  if rec = REC_UCLASS_BASE + ci then PyNodeListCi := ci;
end;

function PyCallMeth1(ci: Integer; const mname: AnsiString;
                     selfNode, argNode: Integer): Integer;
var mmi, mpi, selfArg, valArg: Integer;
begin
  Result := -1;
  mmi := FindUMeth(ci, mname);
  if mmi < 0 then Exit;
  mpi := UMthProc_[mmi];
  selfArg := AllocNode(AN_ARG);
  ASTLeft[selfArg] := selfNode;
  if argNode >= 0 then
  begin
    valArg := AllocNode(AN_ARG);
    ASTLeft[valArg] := argNode;
    ASTRight[selfArg] := valArg;
  end;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := mpi;
  ASTTk[Result] := Ord(Procs[mpi].RetType);
  ASTLeft[Result] := selfArg;
end;

{ A one-argument call to a plain pylib FUNCTION (not a method) — the shape the
  cursor protocol needs, since pyiter_has/pyiter_take are deliberately
  functions rather than TPyIter methods: a method on a second class collides at
  the name level with every dynamically-typed receiver that already has one
  (the .append/.count history), and the cursor is reached from the desugarer
  where the receiver's class is already known. Errors out naming the routine,
  because a missing pylib entry here means the unit did not load. }
{ PyIterCtorName is GONE. map()/filter() used to pick a pylib entry per
  argument SHAPE (`_l` / `_s` / `_i` / the variant one) because these calls are
  built through FindProc, which is not overload-aware. Then `range` became a
  value and the picker had to learn a fourth class that is a sequence but not a
  list — at which point one conversion (PyMakeIterOf) and ONE entry taking a
  cursor is plainly the right shape, and is what enumerate()/zip() already did.
  Four spellings and a type-dispatch deleted; see
  devdocs/dev/normalise-dont-special-case.md. }

function PyCallProc1(const pname: AnsiString; argNode: Integer): Integer;
var pi, a: Integer;
begin
  pi := FindProc(pname);
  if pi < 0 then Error('Nil Python: pylib (' + pname + ') not loaded');
  a := AllocNode(AN_ARG);
  ASTLeft[a] := argNode;
  ASTRight[a] := -1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := pi;
  ASTTk[Result] := Ord(Procs[pi].RetType);
  ASTLeft[Result] := a;
  { carry the CLASS IDENTITY of the result too — without it ResolveNodeRec
    answers "no identity" for the node and every consumer that dispatches on
    the receiver's class (the unpack site, PyNodeListCi, the for-header) falls
    into its untyped arm }
  if Procs[pi].RetType = tyClass then ASTRight[Result] := ProcRetRecId[pi];
end;

{ Materialise a CURSOR where a real sequence is required — the tuple-unpack
  target list, `"".join(...)`, anything reached through a FindProc-built call
  that takes a TPyList. Any other node is returned untouched, so this is safe
  to apply unconditionally at such a site. CPython does the same thing: a
  cursor unpacked into names is consumed, and left exhausted. }
function PyDrainIfCursor(node: Integer): Integer;
var iterCi: Integer;
begin
  Result := node;
  if node < 0 then Exit;
  if IntToTypeKind(ASTTk[node]) <> tyClass then Exit;
  { A USER object implementing `__iter__` is materialised here too — the sites
    that call this want A SEQUENCE, and CPython gets one from any iterable, not
    only from a cursor. Without it `a, b, c = bag` refused ("not a list, tuple
    or variant") and `x in bag` raised, on an object a `for` walks correctly
    (bug-nilpy-builtins-over-a-user-iterable-answer-empty).

    NOT when the class also declares `__contains__`: CPython asks that first,
    and the `x in obj` caller dispatches to it AFTER this call — draining here
    would take the membership test away from the method written for it. }
  if PyNodeIsUserIterable(node) and
     (FindUMeth(ResolveNodeRec(node) - REC_UCLASS_BASE, '__contains__') < 0) then
  begin
    Result := PyCallProc1('pyiter_drain', PyCallProc1('pyiter_of_userobj', node));
    Exit;
  end;
  iterCi := FindUClass('TPyIter');
  if iterCi < 0 then Exit;
  if ResolveNodeRec(node) <> REC_UCLASS_BASE + iterCi then Exit;
  Result := PyCallProc1('pyiter_drain', node);
end;

function PyNodeIsUserIterable(node: Integer): Boolean;
{ node's STATIC type is a genuine user class declaring `__iter__` — the shape
  every "make this argument iterable" site has to recognise. pylib's own
  containers are tyClass too and are ruled out, exactly as the dunder-dispatch
  branches do (see PyRecIsPylibOwnClass). }
var rec: Integer;
begin
  Result := False;
  if node < 0 then Exit;
  if IntToTypeKind(ASTTk[node]) <> tyClass then Exit;
  rec := ResolveNodeRec(node);
  if rec < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(rec) then Exit;
  Result := FindUMeth(rec - REC_UCLASS_BASE, '__iter__') >= 0;
end;

function PyBuiltinTypeCallbackProc(code: Integer): Integer;
{ The one-argument pylib routine a builtin TYPE performs when it is CALLED —
  `str` -> pyconv_str. Only the codes pybtype_call1 actually implements; the
  rest answer -1 and keep today's behaviour, which is that routine's own named
  refusal rather than a wrong answer. }
begin
  Result := -1;
  case code of
    1: Result := FindProc('pyconv_str');
    2: Result := FindProc('pyconv_int');
    3: Result := FindProc('pyconv_float');
    4: Result := FindProc('pyconv_bool');
    6: Result := FindProc('pyconv_list');
    7: Result := FindProc('pyconv_dict');
    8: Result := FindProc('pyconv_set');
  end;
end;

function PyNameWantsCallbackAt(const nm: AnsiString; slot: Integer): Boolean;
{ Does ANY routine of this name take a raw callback Pointer in that slot? The
  question has to be asked of the whole overload family, before matching, for
  the reason PyFixCallableTypeArgs documents. }
var c: Integer;
begin
  Result := False;
  if slot >= MAX_PROC_PARAMS then Exit;
  for c := 0 to ProcCount - 1 do
    if CaseEqual(Procs[c].Name, nm) and (slot < Procs[c].ParamCount) and
       (Procs[c].Params[slot].TypeKind = tyPointer) then
    begin
      Result := True;
      Exit;
    end;
end;

function PyFixCallableTypeArgs(const nm: AnsiString; argsHead, nArgs: Integer): Boolean;
{ `sorted(xs, key=str)` / `min(xs, key=int)` — a builtin TYPE handed to a
  CALLBACK parameter. Those parameters are a raw code `Pointer` (PyCallKey1
  calls through it), while a type held as a value is the VT_BTYPE VARIANT that
  `pybtype(code)` builds. Coerced into the pointer slot, the variant passed its
  TAG WORD as the code address and the program jumped to address 13: a SIGSEGV
  with no diagnostic, on an everyday Python idiom
  (bug-nilpy-a-builtin-type-as-a-key-callback-segfaults). The faulting PC being
  a small tag number is the tell — see
  project_nilpy_callable_has_three_representations, which is this same crossing.

  Rewrites the argument to the ADDRESS of the one-argument routine that type
  performs, which is what the slot has always wanted.

  BEFORE overload matching, not after: the argument's TYPE is what picks the
  overload, and a variant-typed one made `min(xs, key=str)` bind the scalar
  `min(Variant, Variant)` — a wrong overload, which no post-match fixup can
  undo. That is also why the question is asked of the NAME's whole family
  rather than of a chosen proc. Nothing else can match: the argument node has
  to be the `pybtype(<literal>)` call the frontend itself builds. }
var i, currArg, argN, code, wrapPi, btPi, node: Integer;
begin
  Result := False;
  if not PyExprMode then Exit;
  if nArgs <= 0 then Exit;
  btPi := FindProc('pybtype');
  if btPi < 0 then Exit;
  currArg := argsHead;
  i := 0;
  while (currArg >= 0) and (i < nArgs) and (i < MAX_PROC_PARAMS) do
  begin
    node := ASTLeft[currArg];
    if (node >= 0) and (ASTKind[node] = AN_CALL) and (ASTIVal[node] = btPi) and
       PyNameWantsCallbackAt(nm, i) then
    begin
      argN := ASTLeft[node];
      if (argN >= 0) and (ASTLeft[argN] >= 0) and
         (ASTKind[ASTLeft[argN]] = AN_INT_LIT) then
      begin
        code := Integer(ASTIVal[ASTLeft[argN]]);
        wrapPi := PyBuiltinTypeCallbackProc(code);
        if wrapPi >= 0 then
        begin
          node := AllocNode(AN_PROCADDR);
          ASTIVal[node] := wrapPi;
          ASTTk[node] := Ord(tyPointer);
          ASTLeft[currArg] := node;
          Result := True;
        end;
      end;
    end;
    currArg := ASTRight[currArg];
    Inc(i);
  end;
end;

function PyFixIterableArgs(procIdx, argsHead, nArgs: Integer): Boolean;
{ A user object implementing the iterator protocol, handed to a pylib routine
  that wants a CONTAINER. `list(bag)` / `sorted(bag)` / `tuple(bag)` resolved
  against the `TPyList` overload and the callee then read a user object through
  a TPyList layout — answering [] rather than crashing, which is the quiet half
  of bug-nilpy-builtins-over-a-user-iterable-answer-empty. `sum(bag)` /
  `min` / `max` / `any` / `all` have no such overload and refused outright.

  Both halves are one rule, applied where the PARAMETER type is known rather
  than per builtin name — a name list is the second path that stays broken
  (devdocs/dev/normalise-dont-special-case.md):

  - `procIdx >= 0` (a match was found): drain the argument wherever the chosen
    parameter is a TPyList, wrap it in a cursor where the parameter is a
    TPyIter. This is the arm that FIXES A WRONG MATCH — the overload was
    selected on class assignability, not on meaning.
  - `procIdx < 0` (no overload matched): drain every user-iterable argument so
    the caller can retry the match once. That is what gives `sum(bag)` the
    `sum(TPyList)` row.

  Returns True when it changed anything. The two runtime halves already exist
  and are gate-tested: `pyiter_of_userobj` walks `__iter__`/`__next__` through
  the RTTI and catches StopIteration; `pyiter_drain` materialises the cursor. }
var i, currArg, listCi, iterCi, pRec: Integer;
begin
  Result := False;
  if not PyExprMode then Exit;
  if nArgs <= 0 then Exit;
  listCi := FindUClass('TPyList');
  iterCi := FindUClass('TPyIter');
  if (listCi < 0) or (iterCi < 0) then Exit;
  currArg := argsHead;
  i := 0;
  while (currArg >= 0) and (i < nArgs) do
  begin
    if PyNodeIsUserIterable(ASTLeft[currArg]) then
    begin
      if procIdx < 0 then
      begin
        ASTLeft[currArg] :=
          PyCallProc1('pyiter_drain', PyCallProc1('pyiter_of_userobj', ASTLeft[currArg]));
        Result := True;
      end
      else if i < MAX_PROC_PARAMS then
      begin
        pRec := ProcParamRecId[procIdx * MAX_PROC_PARAMS + i];
        if pRec = REC_UCLASS_BASE + listCi then
        begin
          ASTLeft[currArg] :=
            PyCallProc1('pyiter_drain', PyCallProc1('pyiter_of_userobj', ASTLeft[currArg]));
          Result := True;
        end
        else if pRec = REC_UCLASS_BASE + iterCi then
        begin
          ASTLeft[currArg] := PyCallProc1('pyiter_of_userobj', ASTLeft[currArg]);
          Result := True;
        end;
      end;
    end;
    currArg := ASTRight[currArg];
    Inc(i);
  end;
end;

function PyCallMeth2(ci: Integer; const mname: AnsiString;
                     selfNode, arg1, arg2: Integer): Integer;
var mmi, mpi, selfArg, a1, a2: Integer;
begin
  Result := -1;
  if ci < 0 then Exit;
  mmi := FindUMeth(ci, mname);
  if mmi < 0 then Exit;
  mpi := UMthProc_[mmi];
  selfArg := AllocNode(AN_ARG); ASTLeft[selfArg] := selfNode;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := arg1;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := arg2;
  ASTRight[selfArg] := a1;
  ASTRight[a1] := a2;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := mpi;
  ASTTk[Result] := Ord(Procs[mpi].RetType);
  ASTLeft[Result] := selfArg;
end;

{ `for x in <list|set|dict|str>:` — desugared to a counted while loop:

      __py_c = <container>          (evaluated ONCE)
      __py_n = len(__py_c)
      __py_i = 0
      while __py_i < __py_n:
          x = __py_c[__py_i]
          <body>
          __py_i = __py_i + 1

  The container goes into a hidden local rather than being referenced three
  times: an IR value node is a SUBTREE, so reusing one RE-EMITS the expression
  (project_case_selector_reeval_and_fuzzer_narrowness) — here that would
  re-evaluate the container once per iteration.

  A dict iterates its KEYS, like Python, via keylist. A str yields 1-character
  strings. Everything else is a list-shaped TPyList.

  The loop variable is a Variant for a container and a str for a string; a
  body that only passes it along or prints it is correct today. Consuming one
  AS A SCALAR is bug-a-nilpy-variant-element-not-usable-as-scalar, which is
  Track A and predates this. }
{ Index of the '.' in a trailing `.items()` before the loop's ':', or -1. The
  suffix has to be recognised at TOKEN level: parsing it as an expression would
  look for a TPyDict method that does not exist, and inventing one would need a
  tuple type the two-name loop does not require. }
function PyItemsSuffixAhead: Integer;
var i, depth: Integer;
begin
  Result := -1;
  i := TokPos - 1;
  depth := 0;
  while i < TokCount do
  begin
    { The header ends at the loop's colon — OR, in a comprehension, at the
      closing brace or bracket (a comp has no colon). At depth 0 a tkEnd or
      tkRBrack IS that terminator; check for the .items() suffix before it. }
    if (depth = 0) and (Tokens[i].Kind in [tkColon, tkEnd, tkRBrack]) then
    begin
      if (i >= 4) and (Tokens[i - 4].Kind = tkDot) and
         (Tokens[i - 3].Kind = tkIdent) and (GetTokenStr(i - 3) = 'items') and
         (Tokens[i - 2].Kind = tkLParen) and (Tokens[i - 1].Kind = tkRParen) then
        Result := i - 4;
      Exit;
    end
    else if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then Dec(depth)
    else if Tokens[i].Kind in [tkNewline, tkEOF] then Exit;
    Inc(i);
  end;
end;

{ Is the token stream at `[ EXPR for VAR in ...` — a list comprehension?
  CurTok is the '['. Scans at bracket depth 1 for a `for` keyword, the same
  disambiguation PyDictLiteralAt uses for ':'. }
{ Is the argument starting at CurTok a BARE generator expression — an EXPR
  followed by `for` before the argument ends (a depth-0 ',' or ')')? Used to
  divert to the comprehension desugar BEFORE the EXPR is parsed, because the
  EXPR references the loop variable, which is not in scope until the `for`. }
function PyBareGenExprAhead: Boolean;
var i, depth, lamPend: Integer;
begin
  Result := False;
  i := TokPos - 1;                 { CurTok's index — first arg token }
  depth := 0;
  lamPend := 0;                    { depth-0 `lambda`s whose ':' is still ahead }
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      if depth = 0 then Exit;      { end of the call arg list }
      Dec(depth);
    end
    else if (depth = 0) and (Tokens[i].Kind = tkComma) then Exit
    { …and a STATEMENT BOUNDARY. A genexpr argument always sits inside the
      call's parentheses, and NilPy suppresses newlines inside brackets, so a
      newline at depth 0 means the scan has left the argument list entirely and
      is reading the code that FOLLOWS. Without this it did: `p.extra = 7`
      parses its value through ParseArgExpr, the scan ran on past the end of
      the statement and found the `for` of an unrelated loop several lines
      below, and the value 7 was parsed as a generator expression over it —
      surfacing as "undefined variable" on the loop's own iterable, in a
      function whose parameter plainly exists.
      bug-nilpy-a-bare-genexpr-scan-runs-past-the-statement }
    { A LAMBDA's colon is not a statement boundary. `list(lambda: k for k in
      range(3))` is a genexpr over lambdas, and the depth-0 ':' stop above made
      this scan Exit on the lambda's own colon and answer False — so the call
      never diverted to the comprehension desugar, the lambda body swallowed
      `k for k in range(3)` whole, and list() came back EMPTY.
      Counted, not a flag: `lambda a: lambda b: ...` has two pending colons,
      and consuming one per `lambda` keeps the LAST colon a real boundary
      again. Only depth-0 lambdas count; a parenthesised one takes its colon
      with it inside the brackets.
      bug-nilpy-lambda-body-swallows-a-comprehensions-for }
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            CaseEqual(GetTokenStr(i), 'lambda') then Inc(lamPend)
    else if (depth = 0) and (Tokens[i].Kind = tkColon) and (lamPend > 0) then
      Dec(lamPend)
    else if (depth = 0) and (Tokens[i].Kind in [tkNewline, tkIndent, tkDedent,
                                                tkSemicolon, tkColon]) then Exit
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyIsListCompAhead: Boolean;
var i, depth: Integer;
begin
  Result := False;
  if CurTok.Kind <> tkLBrack then Exit;
  { CurTok is the '[' (= Tokens[TokPos-1]); the first token inside it is
    Tokens[TokPos]. Scan Tokens[i] from there. }
  i := TokPos;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkFor) then
    begin
      Result := True;
      Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      { NilPy lexes `for` as a plain ident, not tkFor (see PyParseFor's
        PyIsIdent('for')), so a comprehension's `for` is an ident here. }
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ Is the token stream at a brace-comprehension with a colon — a DICT
  comprehension (KEY colon VALUE for ...)? CurTok is the opening brace
  (tkBegin). A depth-1 `for` makes it a comprehension; a depth-1 ':' BEFORE
  that for makes it a dict one (a set comprehension has no colon). }
{ `( EXPR for VAR in ITER )` — a generator expression in its own parentheses,
  which is how it is written when it is not the only argument:
  `next((c for c in cs if p(c)), default)`. The bare form (no parens) is
  PyBareGenExprAhead; the bracketed form is PyIsListCompAhead. }
{ A SET comprehension — a brace group holding EXPR then `for`, with no depth-1
  ':' before that `for` (a ':' would make it a dict comprehension instead). }
function PyIsSetCompAhead: Boolean;
var i, depth: Integer;
begin
  Result := False;
  if CurTok.Kind <> tkBegin then Exit;
  i := TokPos;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkColon) then Exit   { a dict comp }
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyIsParenCompAhead: Boolean;
var i, depth: Integer;
begin
  Result := False;
  if CurTok.Kind <> tkLParen then Exit;
  i := TokPos;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ Is the argument of the `next(` at CurTok a SEQUENCE rather than an iterator
  object? A generator expression (bare or parenthesised) and a list literal are
  sequences; a plain name is only assumed to be one when it is a list-typed
  local. Anything else keeps the ordinary overload path, which is where
  itertools' counter lives. }
function PyNextOverListAhead: Boolean;
var i, depth, si: Integer;
begin
  Result := False;
  i := TokPos;                       { the '(' after `next` }
  if (i < TokCount) and (Tokens[i].Kind in [tkLParen, tkLBrack]) then
  begin
    { `next((x for x in xs), d)` / `next([...])` — the argument opens its own
      bracket; a `for` inside it at depth 1 makes it a generator. }
    depth := 0;
    while i < TokCount do
    begin
      if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
      else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then
      begin
        Dec(depth);
        if depth = 0 then Break;
      end
      else if (depth = 2) and (Tokens[i].Kind = tkIdent) and
              (LowerCase(GetTokenStr(i)) = 'for') then
      begin
        Result := True;
        Exit;
      end;
      Inc(i);
    end;
  end;
  { a bare generator: `next(x for x in xs)` }
  i := TokPos + 1;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Break;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
  { a NAME that is a list-typed local }
  if (TokPos + 1 < TokCount) and (Tokens[TokPos + 1].Kind = tkIdent) then
  begin
    si := PyProgSym(GetTokenStr(TokPos + 1));
    if (si >= 0) and (Syms[si].TypeKind = tyClass) and
       PyRecIsCls(Syms[si].RecName, 'TPyList') then
      Result := True;
  end;
end;

function PyIsDictCompAhead: Boolean;
var i, depth: Integer; sawColon: Boolean;
begin
  Result := False;
  if CurTok.Kind <> tkBegin then Exit;
  i := TokPos; depth := 1; sawColon := False;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkColon) then sawColon := True
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (LowerCase(GetTokenStr(i)) = 'for') then
    begin
      Result := sawColon;
      Exit;
    end;
    Inc(i);
  end;
end;

{ The length / element-fetch methods a for-in INDEX LOOP should call on class
  ci. pylib's containers spell them `count` and `at`; a USER container spells
  them `__len__` and `__getitem__`.

  Without this, `for x in b` over a class defining `__getitem__`/`__len__` asked
  for `count`, found nothing, and died with "pylib (count) not loaded" -- an
  error naming a pylib routine for a program that never mentioned pylib, on a
  class whose `b[0]`, `b[0] = v` and `len(b)` all already worked. Only the
  ITERATION spelling was missing (feature-nilpy-for-loop-getitem-protocol-fallback).

  Kept as two tiny functions rather than folded into PyMethNameFor because that
  one maps the other direction -- a PYTHON name onto a class's spelling -- and
  here we hold the pylib name and want the Python one. }
function PySeqLenMethod(ci: Integer): AnsiString;
begin
  if (ci >= 0) and (FindUMeth(ci, '__len__') >= 0) then
    Result := '__len__'
  else
    Result := 'count';
end;

function PySeqAtMethod(ci: Integer): AnsiString;
begin
  if (ci >= 0) and (FindUMeth(ci, '__getitem__') >= 0) then
    Result := '__getitem__'
  else
    Result := 'at';
end;

function PyParseForIn(const name: AnsiString; const name2: AnsiString; enumMode: Boolean;
                       forTokIdx: Integer): Integer;
var contNode, ci, dictCi, listCi, fileCi, iterCi, rangeCi, symIdx, cSym, iSym, nSym: Integer;
    enumStartNode, enumStartSym: Integer;   { `enumerate(xs, START)` }
    sym2, vSym, vListNode, itemsDot: Integer;   { two-name target: `for k, v in d.items()` }
    elemNode, lenNode, node, cmpNode, incNode, bodyNode, seq, whileNode: Integer;
    compSaved, keyN, savedHoist, innerHoist: Integer;
    filtIdx, fj, fdepth, filtPair, filtN, closerPos: Integer;  { comprehension `if` filter }
    isStr, pairMode, isIter: Boolean; contTk, tk: TTypeKind;
    elemNode2, pairSym, plistSym, xi, nExtra, cci: Integer;
    extraSyms: array[0..5] of Integer;
    hName, hName2: AnsiString;
    hExtraNames: array[0..5] of AnsiString;
    nsSlot, nsI, nsSym, nsNode, nsHostSym: Integer;   { nested target unpack }
begin
  pairMode := False;
  { A comprehension filter — `[EXPR for V in ITER if COND]` — must not let the
    ITER expression parser see the `if`: it parses as a ternary head and dies
    on the missing else. Hide the depth-0 `if` behind a fake ':' while ITER
    parses (the .items() trick below); the body build restores and consumes
    it (feature-nilpy-comprehension-if-filter). Also locates the header's real
    closing bracket (AFTER the filter, not at it) so the loop-variable rename
    below can cover the filter condition too. }
  filtIdx := -1;
  closerPos := -1;
  if PyCompTarget >= 0 then
  begin
    fj := TokPos - 1;                  { CurTok's index = first ITER token }
    fdepth := 0;
    while fj < TokCount do
    begin
      case Tokens[fj].Kind of
        tkLParen, tkLBrack, tkBegin: Inc(fdepth);
        tkRParen, tkRBrack, tkEnd:
          begin
            if fdepth = 0 then begin closerPos := fj; break; end;  { the comprehension's own closer }
            Dec(fdepth);
          end;
        tkNewline, tkEOF: break;
        tkIf: if (fdepth = 0) and (filtIdx < 0) then filtIdx := fj;
      end;
      Inc(fj);
    end;
    if filtIdx >= 0 then Tokens[filtIdx].Kind := tkColon;
  end;
  { Give the comprehension's loop variable(s) their OWN hidden binding rather
    than reusing/creating a program symbol under the user's spelled name:
    Python scopes a comprehension's target to itself, so an outer `x` must
    survive `[x for x in ...]` untouched. Re-spell every reference to the
    name within the ELEMENT expression (before the `for`) and the filter
    condition (if any) to a fresh hidden name, then bind THAT name below —
    see PyRenameIdentRange
    (bug-nilpy-comprehension-variable-leaks-and-clobbers-the-enclosing-scope). }
  if PyCompTarget >= 0 then
  begin
    { The rename covers the element expression BEFORE the `for`, and everything
      from this clause's `for` up to the closer. That tail used to be just the
      filter (`filtIdx + 1 .. closerPos`); it has to be the whole remainder
      because a SECOND for-clause's ITERABLE names this clause's variable —
      `[c for r in rows for c in r]`, where the trailing `r` is the binding this
      loop makes. With only the element range renamed, that `r` kept the user's
      spelling, resolved against nothing, and reported "undefined variable (r)"
      (bug-nilpy-nested-for-comprehension-not-supported). Starting AT forTokIdx
      also re-spells this clause's own target token, which is harmless: the
      header has already been read into `name`, and the hidden name is derived
      from the token INDEX, not the spelling. }
    hName := PyCompHiddenLoopName(forTokIdx, 0);
    PyRenameIdentRange(PyCompExprStart, forTokIdx, name, hName);
    if closerPos > forTokIdx then PyRenameIdentRange(forTokIdx, closerPos, name, hName);
    if name2 <> '' then
    begin
      hName2 := PyCompHiddenLoopName(forTokIdx, 1);
      PyRenameIdentRange(PyCompExprStart, forTokIdx, name2, hName2);
      if closerPos > forTokIdx then PyRenameIdentRange(forTokIdx, closerPos, name2, hName2);
    end;
    for xi := 0 to PyForExtraCount - 1 do
    begin
      hExtraNames[xi] := PyCompHiddenLoopName(forTokIdx, 2 + xi);
      PyRenameIdentRange(PyCompExprStart, forTokIdx, PyForExtraName[xi], hExtraNames[xi]);
      if closerPos > forTokIdx then
        PyRenameIdentRange(forTokIdx, closerPos, PyForExtraName[xi], hExtraNames[xi]);
    end;
  end;
  { `d.items()`: hide the suffix behind a fake ':' so the expression parser stops
    at the dict, then step over the four suffix tokens and restore. }
  itemsDot := -1;
  if (name2 <> '') and not enumMode then itemsDot := PyItemsSuffixAhead;
  if itemsDot >= 0 then Tokens[itemsDot].Kind := tkColon;
  { `for pfx in ("a", "b"):` — a TUPLE to iterate, built as the same TPyList a
    `[...]` literal produces, exactly as the `in` OPERATOR does. }
  if PyTupleParenAhead then
    PyParseListLiteralT(tkLParen, tkRParen, False)
  else
    PyParseBoolExpr;
  if itemsDot >= 0 then
  begin
    Tokens[itemsDot].Kind := tkDot;
    TokPos := itemsDot + 4;
    Next;
  end;
  { `enumerate(xs, START)` — the second argument. It was implemented for the
    EXPRESSION form (`list(enumerate(ys, 1))` has always been right) and this
    for-header path, which parses its iterable separately, never learned it: the
    `)` was demanded immediately and the comma was a syntax error.
    bug-nilpy-enumerate-with-start-fails-in-a-for-header }
  enumStartNode := -1;
  if enumMode and (CurTok.Kind = tkComma) then
  begin
    contNode := CurASTNode;      { PyParseBoolExpr below overwrites it }
    Next;
    PyParseBoolExpr;
    enumStartNode := CurASTNode;
    CurASTNode := contNode;
  end;
  if enumMode then Expect(tkRParen, ')');
  if filtIdx >= 0 then Tokens[filtIdx].Kind := tkIf;   { un-hide the filter }
  contNode := CurASTNode;
  { enumerate() over a STRING trips an inline-placeholder leak in the element
    tree (AN_INLINE_PARAM reaching IRLowerAST) — filed separately rather than
    worked around here, since a wrong lowering is worse than a clear refusal
    (bug-a-nilpy-enumerate-over-str-inline-param-leak). }
  if enumMode and ((IntToTypeKind(ASTTk[contNode]) = tyString) or
                   (IntToTypeKind(ASTTk[contNode]) = tyAnsiString)) then
    Error('Nil Python: enumerate() over a str is not supported yet — ' +
          'enumerate(list(s)) works');
  contTk := IntToTypeKind(ASTTk[contNode]);
  isStr := (contTk = tyString) or (contTk = tyAnsiString);
  listCi := FindUClass('TPyList');
  dictCi := FindUClass('TPyDict');
  fileCi := FindUClass('TPyFile');
  iterCi := FindUClass('TPyIter');
  rangeCi := FindUClass('TPyRange');
  isIter := False;
  { A VARIANT container — `for n in num` where num is Any — is unboxed to
    TPyList via pylib pylist_v. The corpus reaches this only under an
    `isinstance(num, list)` guard, so the value really is a list at run time;
    pylist_v raises if it is not. Without this the loop refused an untyped
    container (bug-nilpy-for-in-over-variant). }
  { A two-name target over a VARIANT is a DICT **only when the user wrote
    `.items()`** — `for option, value in options.items()` where options came out
    of another dict, which is exactly songformatter's DEFAULT_SETTINGS (a dict
    of dicts). The suffix is stripped at token level a few lines up, so by here
    `itemsDot` is the only surviving evidence that it was there, and it is
    exactly the evidence needed: without it, the arm fired for EVERY two-name
    loop over a variant and unboxed with pydict_v, which raises on anything
    else — so `for k, v in box[0]` over a list of pairs answered
    "TypeError: expected a dict, got object" while the identical list with a
    static type unpacked fine (bug-nilpy-two-name-for-over-a-variant-assumes-
    a-dict).

    The bare form is not a dict special case at all: Python iterates the
    container and UNPACKS each element into the names, which is pairMode below
    for a list of pairs — and, for a dict, its keys unpacked one by one, which
    is what pylist_v now yields. So the two readings differ, and `.items()` is
    what tells them apart. }
  if (not isStr) and (contTk = tyVariant) and (name2 <> '') and (not enumMode) and
     (itemsDot >= 0) then
  begin
    vSym := FindProc('pydict_v');
    if vSym < 0 then Error('Nil Python: pylib (pydict_v) not loaded');
    vListNode := AllocNode(AN_ARG);
    ASTLeft[vListNode] := contNode;
    ASTRight[vListNode] := -1;
    contNode := AllocNode(AN_CALL);
    ASTIVal[contNode] := vSym;
    ASTTk[contNode] := Ord(tyClass);
    ASTLeft[contNode] := vListNode;
    ASTRight[contNode] := REC_UCLASS_BASE + dictCi;
    contTk := tyClass;
  end
  else if (not isStr) and ((contTk = tyVariant) or (contTk = tyUnknown)) then
  begin
    { tyUNKNOWN too: a field read on a dynamically-typed receiver
      (`for c in result.candidates` where result came out of a list) has no
      static type at all, and refusing it read as "for-in needs a list, set,
      dict or str (got something untyped)". pylist_v decides at run time and
      raises if the value is not a sequence, which is the honest answer when
      the type genuinely is not known until then. }
    vSym := FindProc('pylist_v');
    if vSym < 0 then Error('Nil Python: pylib (pylist_v) not loaded');
    vListNode := AllocNode(AN_ARG);
    ASTLeft[vListNode] := contNode;
    ASTRight[vListNode] := -1;
    contNode := AllocNode(AN_CALL);
    ASTIVal[contNode] := vSym;
    ASTTk[contNode] := Ord(tyClass);
    ASTLeft[contNode] := vListNode;
    ASTRight[contNode] := REC_UCLASS_BASE + listCi;
    contTk := tyClass;
  end;
  ci := -1;
  if not isStr then
  begin
    ci := ResolveNodeRec(contNode);
    if ci >= REC_UCLASS_BASE then ci := ci - REC_UCLASS_BASE else ci := -1;
    if ci < 0 then
    begin
      { A class-typed expression with no CLASS IDENTITY — a field read on a
        dynamically-typed receiver, `for c in result.candidates` where `result`
        came out of a list. Refusing it read as "got something untyped"; unbox
        through pylist_v instead and let the run time decide, which is what the
        variant container path does and is the honest answer when the type is
        genuinely unknown until then. }
      vSym := FindProc('pylist_v');
      if vSym < 0 then Error('Nil Python: pylib (pylist_v) not loaded');
      vListNode := AllocNode(AN_ARG);
      ASTLeft[vListNode] := contNode;
      ASTRight[vListNode] := -1;
      contNode := AllocNode(AN_CALL);
      ASTIVal[contNode] := vSym;
      ASTTk[contNode] := Ord(tyClass);
      ASTLeft[contNode] := vListNode;
      ASTRight[contNode] := REC_UCLASS_BASE + listCi;
      ci := listCi;
    end;
    { A CURSOR — `for v in map(f, xs)`, or over a name bound to one. It has no
      count/at protocol at all (deliberately: a cursor does not know its
      length, which is exactly why len(map(...)) is a TypeError in CPython), so
      the desugar below swaps the index walk for the two-call has/take protocol.
      Everything else about the loop — the two-name pair unpack, enumerate's
      counter, `continue`, `break` — is unchanged.
      feature-nilpy-lazy-iterator-objects }
    isIter := (iterCi >= 0) and (ci = iterCi);
    { `for i in r` where r is a RANGE VALUE. Not the `for i in range(...)`
      header — that is recognised in PyParseFor and stays a counted loop; this
      is the bound form, which had no path at all while range was not a value.
      A fresh cursor per loop, which is what makes the range re-iterable. }
    if (rangeCi >= 0) and (ci = rangeCi) then
    begin
      contNode := PyCallProc1('pyiter_of_range', contNode);
      ci := iterCi;
      isIter := True;
    end;
    { `for line in f:` over a FILE. CPython iterates a file object by LINE, so
      read the lines and iterate that list — the same shape the dict arm just
      below uses to iterate its keys. Without it the loop reached the generic
      count/at protocol, which a TPyFile does not have, and the error named
      `count`, a word the user never wrote. This is what lets open() answer ONE
      class in every mode (bug-nilpy-open-returns-two-different-classes-by-mode). }
    if (fileCi >= 0) and (ci = fileCi) then
    begin
      contNode := PyCallMeth1(fileCi, 'readlines', contNode, -1);
      if contNode < 0 then Error('Nil Python: pylib (TPyFile.readlines) not loaded');
      ci := listCi;
    end;
    { A USER class implementing the ITERATOR PROTOCOL — `__iter__` once, then
      `__next__` per step, terminating on StopIteration. Wrapped into a cursor,
      so the desugar below reuses the has/take walk a map() cursor already gets
      and nothing about `continue`, `break`, enumerate or the pair unpack has to
      learn a third shape. Everything that makes the protocol work (calling the
      dunders through the RTTI, catching StopIteration) is in pylib's
      PYITER_USEROBJ arm, reached from pyiter_v as well — so iter(), list(),
      sorted() and `in` over the same object work by the same route.
      bug-nilpy-iterator-protocol-on-a-user-class }
    if (not isIter) and (ci >= 0) and (iterCi >= 0) and
       (FindUMeth(ci, '__iter__') >= 0) then
    begin
      contNode := PyCallProc1('pyiter_of_userobj', contNode);
      if contNode < 0 then
        Error('Nil Python: pylib (pyiter_of_userobj) not loaded');
      ci := iterCi;
      isIter := True;
    end;
    if (PyForExtraCount > 0) and PyCiIsA(ci, dictCi) then
      Error('Nil Python: a dict for-target takes two names');
    if PyCiIsA(ci, dictCi) then
    begin
      { A two-name target reads the dict's parallel VALUE list by the same
        index; a single name iterates its KEYS, as Python does. }
      if name2 <> '' then
      begin
        vSym := AllocVar(PyHiddenName('v'), tyClass);
        Syms[vSym].RecName := REC_UCLASS_BASE + listCi;
        SymSyncTypeRef(vSym);
        vListNode := PyCallMeth1(dictCi, 'vallist', contNode, -1);
        if vListNode < 0 then Error('Nil Python: pylib (TPyDict.vallist) not loaded');
      end;
      contNode := PyCallMeth1(dictCi, 'keylist', contNode, -1);
      if contNode < 0 then Error('Nil Python: pylib (TPyDict.keylist) not loaded');
      ci := listCi;
    end
    else if (name2 <> '') and not enumMode then
      { `for key, score in pairs:` over a LIST — each element is itself a
        2-sequence and is UNPACKED into the two names, which is ordinary Python
        and what `sorted(d.items(), ...)` hands back. Only a dict and enumerate()
        were handled before. }
      pairMode := True;
  end
  else if (name2 <> '') and not enumMode then
    Error('Nil Python: a two-name for target needs a dict (.items()) or enumerate()');

  { Feed the loop target's element type into the SAME whole-program widening
    table a bare assignment feeds via PyNoteLocalType — only during a typing
    pre-pass round, never the real pass. Without this, a name already bound
    to a SCALAR (`c = 5`) that is later used as a `for c in <string>:` target
    kept its scalar slot forever: the pre-pass token scanner only recognises
    bare `name = expr` assignments as note-worthy, so it never learned that
    `c` also needs to hold a str, and the real pass created `c` as tyInteger
    at its first (and only, as far as the scanner knew) assignment. Widening
    the SLOT after code already targets it corrupts what is in the slot (two
    naive attempts at exactly that were tried and reverted — see the ticket) ;
    feeding the WHOLE-PROGRAM inference before either statement is really
    compiled is what already makes an ordinary `c = "x"; c = 5` rebind widen
    to a variant correctly, and the for-loop target was simply invisible to
    that mechanism
    (bug-nilpy-for-variable-reused-after-a-non-string-binding-iterates-garbage). }
  { A comprehension's loop variable is a fresh hidden binding (see above), not
    the spelled `name` at all, so it must not feed the whole-program widening
    table under the outer name — that would widen an outer binding of the
    same spelling based on the comprehension's own internal usage. }
  if PyTypingPass and (PyCompTarget < 0) then
  begin
    if enumMode then
    begin
      PyNoteLocalType(name, tyInteger, REC_NONE);
      if name2 <> '' then
      begin
        if isStr then PyNoteLocalType(name2, tyAnsiString, REC_NONE)
        else PyNoteLocalType(name2, tyVariant, REC_NONE);
      end;
    end
    else if pairMode then
    begin
      PyNoteLocalType(name, tyVariant, REC_NONE);
      if name2 <> '' then PyNoteLocalType(name2, tyVariant, REC_NONE);
    end
    else if isStr then
      PyNoteLocalType(name, tyAnsiString, REC_NONE)
    else
    begin
      PyNoteLocalType(name, tyVariant, REC_NONE);
      if name2 <> '' then PyNoteLocalType(name2, tyVariant, REC_NONE);  { dict values }
    end;
  end;

  { a comprehension ends its header at ']', not ':' — the body is synthetic }
  if PyCompTarget < 0 then Expect(tkColon, ':');
  { body suite (indented block or one-liner) is parsed below, after the
    hidden loop locals are allocated. }

  { hidden locals first, so the loop variable keeps the name the user wrote }
  if isStr then cSym := AllocVar(PyHiddenName('c'), tyAnsiString)
  else cSym := AllocVar(PyHiddenName('c'), tyClass);
  if not isStr then
  begin
    Syms[cSym].RecName := REC_UCLASS_BASE + ci;
    SymSyncTypeRef(cSym);
  end;
  nSym := AllocVar(PyHiddenName('n'), tyInteger);
  iSym := AllocVar(PyHiddenName('i'), tyInteger);
  if PyCompTarget >= 0 then
  begin
    { A fresh hidden symbol every time — never reused across comprehensions,
      never resolved via PyProgSym — so the loop variable cannot clobber (or
      be clobbered by) any outer binding of the same spelled name. }
    if enumMode then tk := tyInteger
    else if isStr then tk := tyAnsiString
    else tk := tyVariant;
    symIdx := AllocVar(hName, tk);
  end
  else
  begin
    symIdx := PyAssignTargetSym(name);
    if symIdx < 0 then
    begin
      if enumMode then tk := tyInteger
      else if isStr then tk := tyAnsiString
      else tk := tyVariant;
      { A MODULE-level for-target created here for the first time must consult
        the whole-program widening table too, exactly like a bare assignment
        does a few lines up in PyParseStatement — otherwise the ORDER the two
        binding forms happen to appear in decides the outcome: `for c in "ab":
        pass` before `c = 5` created `c` as tyAnsiString right here (ignoring
        that PyModuleLocals already knows `c` is also assigned an int later),
        and the later `c = 5` stored a scalar int into a managed-string slot —
        SIGSEGV on release. Function-local targets do not need this: every
        local is pre-seeded from the converged PyLocals table before the body's
        real parse begins (see the `for i := 0 to PyLocalCount - 1` loop next to
        each PyCollectLocalsAST call), so `symIdx` is essentially never < 0
        there for a name the pre-pass already saw.
        (bug-nilpy-for-variable-reused-after-a-non-string-binding-iterates-garbage) }
      if CurProc < 0 then
      begin
        cci := PyFindModuleConstraint(name);
        if cci >= 0 then tk := PyWiden(tk, PyModuleLocals[cci].TypeKind);
      end;
      symIdx := AllocVar(name, tk);
    end;
  end;
  nExtra := PyForExtraCount;
  for xi := 0 to nExtra - 1 do
  begin
    if PyCompTarget >= 0 then
      extraSyms[xi] := AllocVar(hExtraNames[xi], tyVariant)
    else
    begin
      extraSyms[xi] := PyAssignTargetSym(PyForExtraName[xi]);
      if extraSyms[xi] < 0 then extraSyms[xi] := AllocVar(PyForExtraName[xi], tyVariant);
    end;
  end;
  sym2 := -1;
  if name2 <> '' then
  begin
    if PyCompTarget >= 0 then
    begin
      if isStr then sym2 := AllocVar(hName2, tyAnsiString)
      else sym2 := AllocVar(hName2, tyVariant);
    end
    else
    begin
      sym2 := PyAssignTargetSym(name2);
      if sym2 < 0 then
      begin
        { enumerate over a STRING yields 1-character strs, like the single-name
          str loop; a container yields variant slots }
        if isStr then sym2 := AllocVar(name2, tyAnsiString)
        else sym2 := AllocVar(name2, tyVariant);
      end;
    end;
  end;

  { An expression-position comprehension used AS the iterable hoists its build
    loop onto PyHoistHead. Drain it NOW, into this desugar's own init
    sequence: the body's PyParseSuite below also flushes the hoist, so leaving
    it pending moved the one-shot build INSIDE the loop body — the container
    temp was nil on the first iteration (len on nil = SIGSEGV)
    (bug-nilpy-comprehension-as-for-iterable-segfaults). }
  { __py_c := container }
  seq := PyFlushHoist(-1);
  node := AllocNode(AN_ASSIGN);
  ASTLeft[node] := PyMakeIdent(cSym);
  ASTRight[node] := contNode;
  seq := PySeqAppend(seq, node);
  { The start is bound to a hidden local BEFORE the loop, not spliced into the
    per-iteration index expression. Python evaluates it once, and an AST node
    used in two places is EMITTED twice here — so reusing the expression node
    would both re-evaluate a call and duplicate its code. }
  enumStartSym := -1;
  if enumStartNode >= 0 then
  begin
    enumStartSym := AllocVar(PyHiddenName('es'), tyInt64);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(enumStartSym);
    ASTRight[node] := enumStartNode;
    seq := PySeqAppend(seq, node);
  end;
  { the dict form's parallel VALUE list — enumerate has no second container, and
    reading vSym/vListNode there took an UNINITIALISED node index, which landed
    in the retained-inline AST region and surfaced as "could not lower AST node
    (kind 78)" at the end of the program }
  if (sym2 >= 0) and (not enumMode) and (not pairMode) then
  begin
    { ...and pairMode is the third form with no second container: the pairs come
      from ONE list whose elements are unpacked, so reading vSym/vListNode here
      hit the same uninitialised-node trap this comment was written for. }
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(vSym);
    ASTRight[node] := vListNode;
    seq := PySeqAppend(seq, node);
  end;

  { __py_n := len(__py_c) }
  if isStr then
  begin
    lenNode := AllocNode(AN_CALL);
    ASTIVal[lenNode] := FindProc('pystr_len');
    if ASTIVal[lenNode] < 0 then Error('Nil Python: pylib (pystr_len) not loaded');
    ASTTk[lenNode] := Ord(tyInteger);
    node := AllocNode(AN_ARG);
    ASTLeft[node] := PyMakeIdent(cSym);
    ASTLeft[lenNode] := node;
  end
  else if not isIter then
  begin
    lenNode := PyCallMeth1(ci, PySeqLenMethod(ci), PyMakeIdent(cSym), -1);
    if lenNode < 0 then
    begin
      { Name the method the READER would add. A class with __getitem__ and no
        __len__ is CPython-iterable (it walks 0.. and stops on IndexError), so
        the honest message is which of the two we still require -- not the
        pylib spelling, which a NilPy program never mentions. }
      if (ci >= 0) and (FindUMeth(ci, '__getitem__') >= 0) then
        Error('Nil Python: `for` over this object needs `__len__` as well as '
              + '`__getitem__` — iterating by __getitem__ alone (stopping on '
              + 'IndexError) is not supported yet')
      else
        Error('Nil Python: `for` over this object needs `__iter__`, or '
              + '`__getitem__` with `__len__`');
    end;
  end;
  { a cursor has no length to snapshot — and asking for one is the whole point
    of it being a cursor }
  if not isIter then
  begin
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(nSym);
    ASTRight[node] := lenNode;
    seq := PySeqAppend(seq, node);
  end;

  { __py_i := -1. The index starts BEFORE the first element and is advanced at
    the TOP of the body, so `continue` still advances it — with the increment
    at the bottom, `continue` skipped it and the loop hung. The condition
    tests the NEXT index for the same reason. }
  node := AllocNode(AN_ASSIGN);
  ASTLeft[node] := PyMakeIdent(iSym);
  elemNode := AllocNode(AN_INT_LIT);
  ASTIVal[elemNode] := -1;
  ASTTk[elemNode] := Ord(tyInteger);
  ASTRight[node] := elemNode;
  seq := PySeqAppend(seq, node);

  { body: __py_i := __py_i + 1 ; x := __py_c[__py_i] ; <user body> }
  incNode := AllocNode(AN_BINOP);
  ASTIVal[incNode] := Ord(tkPlus);
  ASTLeft[incNode] := PyMakeIdent(iSym);
  elemNode := AllocNode(AN_INT_LIT);
  ASTIVal[elemNode] := 1;
  ASTTk[elemNode] := Ord(tyInteger);
  ASTRight[incNode] := elemNode;
  ASTTk[incNode] := Ord(tyInteger);
  node := AllocNode(AN_ASSIGN);
  ASTLeft[node] := PyMakeIdent(iSym);
  ASTRight[node] := incNode;
  bodyNode := PySeqAppend(-1, node);

  if isStr then
  begin
    { PyMakeStrIndex already yields a 1-character str (pystr_charat), so the
      pystr_ofchar promotion that used to sit here is gone with the tyChar it
      existed to repair. }
    elemNode := PyMakeStrIndex(PyMakeIdent(cSym), PyMakeIdent(iSym));
  end
  else if isIter then
    { the value the CONDITION already prefetched — take() hands it over and
      clears the prefetch, so exactly one element is produced per body run }
    elemNode := PyCallProc1('pyiter_take', PyMakeIdent(cSym))
  else
  begin
    elemNode := PyCallMeth1(ci, PySeqAtMethod(ci), PyMakeIdent(cSym), PyMakeIdent(iSym));
    if elemNode < 0 then Error('Nil Python: pylib (get) not loaded');
  end;
  if enumMode then
  begin
    { i := __py_i (+ START) ; v := __py_c[__py_i] }
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(symIdx);
    if enumStartSym >= 0 then
    begin
      ASTRight[node] := AllocNode(AN_BINOP);
      ASTIVal[ASTRight[node]] := Ord(tkPlus);
      ASTLeft[ASTRight[node]] := PyMakeIdent(iSym);
      ASTRight[ASTRight[node]] := PyMakeIdent(enumStartSym);
      ASTTk[ASTRight[node]] := Ord(tyInt64);
    end
    else
      ASTRight[node] := PyMakeIdent(iSym);
    bodyNode := PySeqAppend(bodyNode, node);
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(sym2);
    ASTRight[node] := elemNode;
    bodyNode := PySeqAppend(bodyNode, node);
  end
  else if pairMode then
  begin
    { name1 := elem[0]; name2 := elem[1]. The element is bound to a hidden local
      FIRST: reusing the element expression twice duplicated the inlined body of
      TPyList.at and leaked an AN_INLINE_PARAM placeholder into lowering
      (IR_UNSUPPORTED). One read, two indexes. }
    pairSym := AllocVar(PyHiddenName('pair'), tyVariant);
    elemNode2 := AllocNode(AN_ASSIGN);
    ASTLeft[elemNode2] := PyMakeIdent(pairSym);
    ASTRight[elemNode2] := elemNode;
    bodyNode := PySeqAppend(bodyNode, elemNode2);
    { Indexed through pylib's pyvar_getitem, NOT through TPyList.at: `at` is an
      INLINED method, and an inlined body reached from here leaked its
      AN_INLINE_PARAM placeholder into lowering (IR_UNSUPPORTED). pyvar_getitem
      is an ordinary function and takes the variant as it stands, so no unbox is
      needed either. }
    node := PyPairItem(PyMakeIdent(pairSym), 0);
    elemNode2 := AllocNode(AN_ASSIGN);
    ASTLeft[elemNode2] := PyMakeIdent(symIdx);
    ASTRight[elemNode2] := node;
    bodyNode := PySeqAppend(bodyNode, elemNode2);
    node := PyPairItem(PyMakeIdent(pairSym), 1);
    elemNode2 := AllocNode(AN_ASSIGN);
    ASTLeft[elemNode2] := PyMakeIdent(sym2);
    ASTRight[elemNode2] := node;
    bodyNode := PySeqAppend(bodyNode, elemNode2);
    { and any names past the second — `for anchor, weight, label in triples:` }
    for xi := 0 to nExtra - 1 do
    begin
      node := PyPairItem(PyMakeIdent(pairSym), xi + 2);
      elemNode2 := AllocNode(AN_ASSIGN);
      ASTLeft[elemNode2] := PyMakeIdent(extraSyms[xi]);
      ASTRight[elemNode2] := node;
      bodyNode := PySeqAppend(bodyNode, elemNode2);
    end;
  end
  else
  begin
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(symIdx);
    ASTRight[node] := elemNode;
    bodyNode := PySeqAppend(bodyNode, node);
  end;

  { the value name reads the parallel list at the same index }
  if (sym2 >= 0) and (not enumMode) and (not pairMode) then
  begin
    elemNode := PyCallMeth1(listCi, 'at', PyMakeIdent(vSym), PyMakeIdent(iSym));
    if elemNode < 0 then Error('Nil Python: pylib (get) not loaded');
    node := AllocNode(AN_ASSIGN);
    ASTLeft[node] := PyMakeIdent(sym2);
    ASTRight[node] := elemNode;
    bodyNode := PySeqAppend(bodyNode, node);
  end;

  { NESTED target slots — `for n, (p, q) in enumerate(pairs):`. The slot was
    bound to a hidden name above like any other target name; unpack it into the
    user's inner names HERE, ahead of everything the body does. Ahead of BOTH
    branches below, not inside the statement one: a comprehension parses its
    element expression in the branch below, and that expression reads the inner
    names — put the unpack only on the statement side and
    `[f(p, q) for n, (p, q) in xs]` reports "undefined variable (p)" while the
    identical `for` statement works. Same construct, two paths, which is the
    shape devdocs/dev/normalise-dont-special-case.md is about.

    `continue` and `break` behave exactly as they do for the flat forms because
    this sits at the top of the body with the other target bindings. Emitted
    through PyPairItem, the same accessor the two-name pair path one level up
    uses. feature-nilpy-starred-and-nested-unpacking }
  for nsSlot := 0 to PY_FOR_NEST_SLOTS do
  begin
    if PyForNestCount[nsSlot] = 0 then Continue;
    if nsSlot = 0 then nsHostSym := symIdx
    else if nsSlot = 1 then nsHostSym := sym2
    else if nsSlot - 2 < nExtra then nsHostSym := extraSyms[nsSlot - 2]
    else Continue;
    if nsHostSym < 0 then Continue;
    for nsI := 0 to PyForNestCount[nsSlot] - 1 do
    begin
      nsSym := PyAssignTargetSym(PyForNestName[nsSlot][nsI]);
      if nsSym < 0 then
        nsSym := AllocVar(PyForNestName[nsSlot][nsI], tyVariant);
      nsNode := AllocNode(AN_ASSIGN);
      ASTLeft[nsNode] := PyMakeIdent(nsSym);
      ASTRight[nsNode] := PyPairItem(PyMakeIdent(nsHostSym), nsI);
      bodyNode := PySeqAppend(bodyNode, nsNode);
    end;
  end;

  if PyCompTarget >= 0 then
  begin
    { comprehension body: `target.append(EXPR)`. EXPR sits BEFORE the `for`, so
      jump back to it, parse it with the loop variable now in scope, then
      restore the cursor (the `]` the header stopped at). The `TokPos := k;
      Next` idiom re-reads a token to restore CurTok, as the factory-default
      re-parse does. }
    { NESTED comprehension: the element expression may itself be one, and it
      HOISTS its own build loop. Those statements must land INSIDE this loop,
      not in front of it — in front, the inner loop runs before this loop's
      variable is bound, which is why
      `{k: [f(x) for x in g(k)] for k in ks}` reported `undefined variable (k)`.
      So the hoist queue is swapped out around the element parse and whatever it
      collected is spliced into the body ahead of the append
      (feature-nilpy-nested-comprehension). }
    savedHoist := PyHoistHead;
    PyHoistHead := -1;
    { A SECOND `for` CLAUSE — `[c for r in rows for c in r]`, the flatten idiom.
      Python's rule is that the clauses nest left to right, so this loop's BODY
      is simply another loop and the append happens in the INNERMOST one. That
      is what recursing into PyParseFor here builds: PyCompTarget and
      PyCompExprStart are still set, so the inner clause re-parses the element
      expression with BOTH loop variables in scope and appends there. Any `if`
      filter after the last clause is consumed by that innermost call.

      Before this, only the first clause was bound and the element expression
      was then resolved against it alone — reported as "undefined variable (c)",
      which read as a scoping bug rather than a missing feature
      (bug-nilpy-nested-for-comprehension-not-supported). }
    if PyIsIdent('for') then
    begin
      node := PyParseFor;
      compSaved := -1;
    end
    { ...and a filter that sits BETWEEN two clauses gates the inner LOOP, not
      the append: `[x + y for x in xs if x > 0 for y in ys]`. Parsed here, with
      the rest of the header recursed into inside the AN_IF — the element
      expression is re-parsed by that innermost clause, where both variables are
      bound, which is why the filter cannot be left to the trailing-filter arm
      below (it runs after the element expression has been parsed with the inner
      name still unbound: "undefined variable (y)").
      bug-nilpy-a-filter-between-two-for-clauses-is-not-supported }
    else if (Tokens[TokPos - 1].Kind = tkIf) and
            PyCompForAfter(TokPos, closerPos) then
    begin
      { the TOKEN ARRAY, not CurTok: this `if` was hidden behind a fake ':' while
        the ITER expression parsed, and CurTok still holds that stale copy — the
        array entry was restored, the register was not }
      TokPos := TokPos - 1; Next;    { re-read it as the tkIf it is again }
      Next;                          { past the `if` }
      PyParseBoolExpr;               { the condition — names already renamed }
      filtN := AllocNode(AN_IF);
      ASTLeft[filtN] := PyMakeTruthy(CurASTNode);
      filtPair := AllocNode(AN_PAIR);
      ASTLeft[filtPair] := PyParseFor;    { the REST of the header }
      ASTRight[filtPair] := -1;
      ASTRight[filtN] := filtPair;
      node := filtN;
      compSaved := -1;
    end
    else
    begin
    compSaved := TokPos - 1;              { index of CurTok (the closing bracket) }
    TokPos := PyCompExprStart; Next;      { CurTok := first EXPR token }
    if PyCompIsDict then
    begin
      { element region is KEY colon VALUE -> target.store(KEY, VALUE) }
      PyParseBoolExpr;
      keyN := CurASTNode;
      Expect(tkColon, ':');
      PyParseBoolExpr;
      node := PyCallMeth2(FindUClass('TPyDict'), 'store',
                          PyMakeIdent(PyCompTarget), keyN, CurASTNode);
      if node < 0 then Error('Nil Python: pylib TPyDict.store not loaded');
    end
    else
    begin
      PyParseBoolExpr;
      if PyCompIsSet then
        node := PyCallMeth1(PyNodeListCi(PyMakeIdent(PyCompTarget)), 'add',
                            PyMakeIdent(PyCompTarget), CurASTNode)
      else
        node := PyCallMeth1(PyNodeListCi(PyMakeIdent(PyCompTarget)), 'append',
                            PyMakeIdent(PyCompTarget), CurASTNode);
      if node < 0 then Error('Nil Python: pylib TPyList.append/add not loaded');
    end;
    TokPos := compSaved; Next;            { restore to the closing bracket }
    { `... if COND]`: parse the filter (loop variable now in scope) and gate
      the append on it. The cursor lands on the real closer for the caller. }
    if CurTok.Kind = tkIf then
    begin
      Next;
      PyParseBoolExpr;
      filtN := AllocNode(AN_IF);
      ASTLeft[filtN] := PyMakeTruthy(CurASTNode);
      filtPair := AllocNode(AN_PAIR);
      ASTLeft[filtPair] := node;
      ASTRight[filtPair] := -1;
      ASTRight[filtN] := filtPair;
      node := filtN;
    end;
    end;
    { splice the element's own hoisted setup in FIRST, then restore the
      enclosing statement's queue }
    innerHoist := PyHoistHead;
    PyHoistHead := savedHoist;
    while innerHoist >= 0 do
    begin
      bodyNode := PySeqAppend(bodyNode, ASTLeft[innerHoist]);
      innerHoist := ASTRight[innerHoist];
    end;
  end
  else
    node := PyParseSuite;

  bodyNode := PySeqAppend(bodyNode, node);

  { while __py_i + 1 < len(__py_c) }
  incNode := AllocNode(AN_BINOP);
  ASTIVal[incNode] := Ord(tkPlus);
  ASTLeft[incNode] := PyMakeIdent(iSym);
  elemNode := AllocNode(AN_INT_LIT);
  ASTIVal[elemNode] := 1;
  ASTTk[elemNode] := Ord(tyInteger);
  ASTRight[incNode] := elemNode;
  ASTTk[incNode] := Ord(tyInteger);
  cmpNode := AllocNode(AN_BINOP);
  ASTIVal[cmpNode] := Ord(tkLt);
  ASTLeft[cmpNode] := incNode;
  { The bound is re-read EVERY iteration for a container, not taken from the
    __py_n snapshot. Python iterates a list LIVE: appending during the loop is
    seen by it, and shrinking it just ends the loop early. With the snapshot,
    growth was silently missed (`out` came back [1,2,3] where CPython gives
    [1,2,3,9]) and shrinking ran off the end into an IndexError, because the
    element fetch `__py_c.at(i)` always read the live list while only the bound
    was frozen — the two disagreed
    (bug-nilpy-for-in-snapshots-the-length-so-mutation-during-iteration-diverges).

    A STRING keeps the snapshot: str is immutable, so a fresh pystr_len every
    iteration could not observe anything different.

    A DICT is unaffected either way — the dict path iterates a keylist COPY
    built before the loop (see `ci := listCi` after the keylist call), so the
    live count reads that copy, not the dict. Mutating a dict mid-loop remains
    unobserved rather than raising as CPython does; that is a separate gap. }
  if isStr then
    ASTRight[cmpNode] := PyMakeIdent(nSym)
  else if not isIter then
  begin
    lenNode := PyCallMeth1(ci, PySeqLenMethod(ci), PyMakeIdent(cSym), -1);
    if lenNode < 0 then
    begin
      { Name the method the READER would add. A class with __getitem__ and no
        __len__ is CPython-iterable (it walks 0.. and stops on IndexError), so
        the honest message is which of the two we still require -- not the
        pylib spelling, which a NilPy program never mentions. }
      if (ci >= 0) and (FindUMeth(ci, '__getitem__') >= 0) then
        Error('Nil Python: `for` over this object needs `__len__` as well as '
              + '`__getitem__` — iterating by __getitem__ alone (stopping on '
              + 'IndexError) is not supported yet')
      else
        Error('Nil Python: `for` over this object needs `__iter__`, or '
              + '`__getitem__` with `__len__`');
    end;
    ASTRight[cmpNode] := lenNode;
  end;
  ASTTk[cmpNode] := Ord(tyBoolean);
  { A CURSOR replaces the whole `i + 1 < len(c)` comparison with a PREFETCH:
    pyiter_has produces one value into the cursor and answers whether there was
    one, and the body's take() consumes exactly that value. Idempotent, so the
    condition may be evaluated without advancing; and because the fetch happens
    in the condition, `f` is called once per body run and NOT AT ALL after a
    break — which is the entire point of the umbrella. The `__py_i` counter is
    still maintained at the top of the body, so enumerate() over a cursor and
    `continue` both keep working unchanged. }
  if isIter then
    cmpNode := PyCallProc1('pyiter_has', PyMakeIdent(cSym));
  whileNode := AllocNode(AN_WHILE);
  ASTLeft[whileNode] := cmpNode;
  ASTRight[whileNode] := bodyNode;
  { A desugared `for` returns an AN_SEQ (init statements + the while), not an
    AN_WHILE, so PyParseBlock's "this statement consumed its own indented
    block" check — which matches on node KIND — did not recognise it, and any
    statement following a for inside a def died with "expected newline after
    statement". Reuse the flag nested defs already use to say the same thing.
    (bug-nilpy-statement-after-for-in-a-def) }
  PyStmtAteBlock := True;
  Result := PySeqAppend(seq, whileNode);
end;

{ `target = [ EXPR for VAR in ITER ]`. Desugars to: create a fresh TPyList in
  `target`, then a for-loop over ITER whose body is `target.append(EXPR)`.
  Reuses PyParseForIn for the iteration itself (range / list / variant unbox all
  come free) via PyCompTarget/PyCompExprStart; see those globals. CurTok is the
  '[' and `targetSym` is the already-declared destination local. Returns the
  statement sequence; PyStmtAteBlock is left set by PyParseForIn. }

{ Shared comprehension core: emit `targetSym := TPyList.Create` then the
  appending loop. CurTok must be AT the `for` (an ident); `exprStart` is the
  token index of the element EXPR (which sits before the `for`). Returns the
  statement sequence. Does NOT consume a trailing `]` — the caller does that
  for a bracketed comprehension; a bare genexpr has none. }
{ Advance to THIS comprehension's `for`, skipping any nested one. The scan used
  to stop at the first `for` it saw, so `[[c for c in k] for k in ks]` split at
  the INNER for: the outer comprehension took `[c` as its element and
  `for c in k` as its header, and `k` was undefined because the outer loop
  variable had not been introduced yet. Bracket depth is what tells them apart —
  a nested comprehension is always inside its own brackets or parens.
  (feature-nilpy-nested-comprehension) }
procedure PyScanToCompFor;
var depth: Integer;
begin
  depth := 0;
  while CurTok.Kind <> tkEOF do
  begin
    case CurTok.Kind of
      tkLBrack, tkLParen, tkBegin: Inc(depth);
      tkRBrack, tkRParen, tkEnd:
        begin
          if depth = 0 then Break;      { our own closer — malformed, caller reports }
          Dec(depth);
        end;
    end;
    if (depth = 0) and PyIsIdent('for') then Exit;
    Next;
  end;
end;

function PyBuildComp(targetSym, exprStart: Integer): Integer;
var seq, node, sizeNode, createNode, aSeq, savedTarget, savedStart, listCiN: Integer;
    buildSym: Integer;
begin
  if PyCompIsDict then listCiN := FindUClass('TPyDict')
  else listCiN := FindUClass('TPyList');
  if listCiN < 0 then Error('Nil Python: pylib (TPyList/TPyDict) not loaded');
  createNode := AllocNode(AN_CALL);
  ASTIVal[createNode] := -Ord(tkGetMem);
  ASTTk[createNode] := Ord(tyClass);
  ASTRight[createNode] := REC_UCLASS_BASE + listCiN;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(REC_UCLASS_BASE + listCiN);
  ASTTk[sizeNode] := Ord(tyInteger);
  aSeq := AllocNode(AN_ARG);
  ASTLeft[aSeq] := sizeNode;
  ASTLeft[createNode] := aSeq;
  Syms[targetSym].RecName := REC_UCLASS_BASE + listCiN;
  SymSyncTypeRef(targetSym);
  { Build into a HIDDEN list and assign it at the end. Emptying the target
    first is fatal when the target is also the SOURCE — `lines = [l.strip()
    for l in lines]` re-binds a name Python evaluates on the right first, and
    building in place cleared the list the loop was about to read, so the
    comprehension always produced []. }
  buildSym := AllocVar(PyHiddenName('comp'), tyClass);
  Syms[buildSym].RecName := REC_UCLASS_BASE + listCiN;
  SymSyncTypeRef(buildSym);
  node := AllocNode(AN_ASSIGN);
  ASTLeft[node] := PyMakeIdent(buildSym);
  ASTRight[node] := createNode;
  seq := PySeqAppend(-1, node);

  savedTarget := PyCompTarget;
  savedStart := PyCompExprStart;
  PyCompTarget := buildSym;
  PyCompExprStart := exprStart;
  node := PyParseFor;               { range/container both honour PyCompTarget }
  PyCompTarget := savedTarget;
  PyCompExprStart := savedStart;    { a NESTED build clobbers it otherwise }
  seq := PySeqAppend(seq, node);
  node := AllocNode(AN_ASSIGN);
  ASTLeft[node] := PyMakeIdent(targetSym);
  ASTRight[node] := PyMakeIdent(buildSym);
  seq := PySeqAppend(seq, node);
  { PyParseFor sets PyStmtAteBlock (it normally eats an indented block); a
    comprehension is a one-line expression, so clear it. }
  PyStmtAteBlock := False;
  Result := seq;
end;

{ Statement-level `target = [EXPR for VAR in ITER]`. CurTok is the '['. }
function PyParseListComp(targetSym: Integer): Integer;
var exprStart: Integer;
begin
  Next;                                { consume '[' — CurTok = first EXPR token }
  exprStart := TokPos - 1;
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed list comprehension');
  Result := PyBuildComp(targetSym, exprStart);
  Expect(tkRBrack, ']');
end;

{ Statement-level dict comprehension (target = brace KEY colon VALUE for VAR in
  ITER brace). CurTok is the opening brace. The element region KEY colon VALUE
  is re-parsed in the loop body as target.store(KEY, VALUE) (PyCompIsDict). }
function PyParseDictComp(targetSym: Integer): Integer;
var exprStart: Integer;
begin
  Next;                                { consume the opening brace; CurTok = KEY }
  exprStart := TokPos - 1;
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed dict comprehension');
  PyCompIsDict := True;
  Result := PyBuildComp(targetSym, exprStart);
  PyCompIsDict := False;
  Expect(tkEnd, 'close brace');
end;

{ Expression-position comprehension/genexpr — `[EXPR for x in it]` as a call
  argument, or a bare `EXPR for x in it` genexpr. Allocates a hidden temp,
  HOISTS the build loop to run before the enclosing statement, and yields the
  temp. `bracketed` says whether a '[' (and closing ']') delimits it; a bare
  genexpr has neither. CurTok is the '[' (bracketed) or the first EXPR token
  (bare). Returns the temp's ident node. }
function PyParseCompExprValue(bracketed: Boolean): Integer;
var tmpSym, exprStart, seq: Integer; savedDict: Boolean;
begin
  { A LIST comprehension nested inside a DICT one must not inherit dict mode:
    PyCompIsDict is global, so `{k: [c for c in k] for k in ks}` built the inner
    comprehension as a dict and died on the missing `:`
    (feature-nilpy-nested-comprehension). }
  savedDict := PyCompIsDict;
  PyCompIsDict := False;
  tmpSym := AllocVar(PyHiddenName('gx'), tyClass);
  if bracketed then Next;              { consume '[' }
  exprStart := TokPos - 1;             { first EXPR token }
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed comprehension');
  seq := PyBuildComp(tmpSym, exprStart);
  PyCompIsDict := savedDict;
  if bracketed then Expect(tkRBrack, ']');
  { each build statement runs before the current one }
  while seq >= 0 do
  begin
    PyHoistStmt(ASTLeft[seq]);
    seq := ASTRight[seq];
  end;
  Result := PyMakeIdent(tmpSym);
end;

{ The SET comprehension: the same build, with braces as delimiters and `add`
  as the insert. }
function PyParseSetComp: Integer;
var tmpSym, exprStart, seq: Integer; savedDict, savedSet: Boolean;
begin
  savedDict := PyCompIsDict; savedSet := PyCompIsSet;
  PyCompIsDict := False; PyCompIsSet := True;
  tmpSym := AllocVar(PyHiddenName('gs'), tyClass);
  Next;                                { consume the opening brace — NOT written
                                         as a quoted character: this dialect
                                         nests brace comments, so even a quoted
                                         brace inside one opens a nested comment }
  exprStart := TokPos - 1;
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed set comprehension');
  seq := PyBuildComp(tmpSym, exprStart);
  PyCompIsDict := savedDict; PyCompIsSet := savedSet;
  Expect(tkEnd, 'close brace');
  while seq >= 0 do
  begin
    PyHoistStmt(ASTLeft[seq]);
    seq := ASTRight[seq];
  end;
  { ...and stamp the result a SET, exactly as `set()` and a `{a, b}` literal do.
    A comprehension builds a bare TPyList, which is a LIST by default, so
    `{x for x in xs}` reprs as `[...]`, answers isinstance(x, list) True, and —
    once the set operators started REQUIRING set operands — could not be used
    with `-` / `&` / `|` / `^` at all. The three set-producing forms have to
    agree on this or the tag means nothing.
    bug-nilpy-same-kind-undefined-operators-still-compute }
  Result := PyMarkAsSet(PyMakeIdent(tmpSym));
end;

{ The parenthesised generator expression: same build as the bracketed one, with
  '(' and ')' as its delimiters. }
function PyParseParenComp: Integer;
var tmpSym, exprStart, seq: Integer; savedDict: Boolean;
begin
  savedDict := PyCompIsDict;
  PyCompIsDict := False;
  tmpSym := AllocVar(PyHiddenName('gp'), tyClass);
  Next;                                { consume '(' }
  exprStart := TokPos - 1;
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed generator expression');
  seq := PyBuildComp(tmpSym, exprStart);
  PyCompIsDict := savedDict;
  Expect(tkRParen, ')');
  while seq >= 0 do
  begin
    PyHoistStmt(ASTLeft[seq]);
    seq := ASTRight[seq];
  end;
  { …and the value is a CURSOR over those elements, not the list itself. Single
    consumption is the observable half of laziness — `g = (x for x in [1, 2]);
    next(g); list(g)` must answer [2], and with the list as the value both
    consumers walked it from the start, silently. The elements are still built
    eagerly, so an INFINITE genexpr is still not expressible; that half is
    recorded on the ticket rather than half-solved here.

    Only the PARENTHESISED form takes this road. A bare genexpr consumed in
    place (`sum(x for x in xs)`) comes through PyParseCompExprValue, where
    nothing observes the container twice and the builtins want a list. }
  Result := PyCallProc1('pyiter_gen', PyMakeIdent(tmpSym));
  if Result < 0 then Result := PyMakeIdent(tmpSym);
end;

{ Expression-position DICT comprehension — the brace twin of
  PyParseCompExprValue, used when a dict comp appears where a value is expected
  (a field/subscript target's RHS, a call argument). Builds into a hidden
  TPyDict temp, hoists the build loop, and yields the temp. CurTok is the
  opening brace. }
function PyParseDictCompExprValue: Integer;
var tmpSym, exprStart, seq: Integer; savedDict: Boolean;
begin
  savedDict := PyCompIsDict;
  tmpSym := AllocVar(PyHiddenName('gd'), tyClass);
  Syms[tmpSym].RecName := REC_UCLASS_BASE + FindUClass('TPyDict');
  SymSyncTypeRef(tmpSym);
  Next;                                { consume the opening brace; CurTok = KEY }
  exprStart := TokPos - 1;
  PyScanToCompFor;
  if not PyIsIdent('for') then Error('Nil Python: malformed dict comprehension');
  PyCompIsDict := True;
  seq := PyBuildComp(tmpSym, exprStart);
  PyCompIsDict := savedDict;
  Expect(tkEnd, 'close brace');
  while seq >= 0 do
  begin
    PyHoistStmt(ASTLeft[seq]);
    seq := ASTRight[seq];
  end;
  Result := PyMakeIdent(tmpSym);
end;

{ `for x, y in zip(A, B):` — iterate two containers in parallel. Desugared to a
  counted while loop over min(len(A), len(B)), binding x=A[i], y=B[i]. CurTok is
  at `zip`; the two names are already parsed. }
function PyZipAsList(n: Integer): Integer;
{ zip's desugar walks its operands as TPyList — hidden tyClass locals, then
  TPyList.count and TPyList.at. A STRING operand is not one: its handle landed
  in a tyClass slot and `count` read it as a list, so `zip(xs, "abc")` produced
  NO iterations at all, and with any earlier loop in the program it SEGFAULTED
  (bug-nilpy-zip-over-a-string-yields-nothing-or-segfaults).

  Python's zip takes any iterable, so convert instead of rejecting: a string
  goes through pylib's `list(AnsiString)` — the same conversion `list("abc")`
  already uses, one character per element — and a VARIANT through pylist_v,
  which dispatches on the run-time tag. Anything already a list is returned
  untouched, so the common path is unchanged. }
var pi, argN, callN: Integer;
begin
  Result := n;
  if n < 0 then Exit;
  pi := -1;
  if IntToTypeKind(ASTTk[n]) in [tyString, tyAnsiString, tyShortString, tyFixedString] then
  begin
    pi := IRFindProc1ByArgTk('list', tyAnsiString);
    if pi < 0 then pi := IRFindProc1ByArgTk('list', tyString);
  end
  else if IntToTypeKind(ASTTk[n]) = tyVariant then
    pi := IRFindProc1ByArgTk('pylist_v', tyVariant);
  if pi < 0 then Exit;
  argN := AllocNode(AN_ARG);
  ASTLeft[argN] := n;
  callN := AllocNode(AN_CALL);
  ASTIVal[callN] := pi;
  ASTLeft[callN] := argN;
  ASTTk[callN] := Ord(tyClass);
  Result := callN;
end;

function PyParseForZip(const name, name2: AnsiString): Integer;
var listCi, caSym, cbSym, caN, cbN, nSym, iSym, xSym, ySym: Integer;
    aNode, bNode, node, cnd, thenElse, seq, bodyNode, whileNode, incN, oneN: Integer;
begin
  listCi := FindUClass('TPyList');
  if listCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  Next; Expect(tkLParen, '(');           { consume `zip` and `(` }
  PyParseBoolExpr; aNode := PyZipAsList(CurASTNode);
  Expect(tkComma, ',');
  PyParseBoolExpr; bNode := PyZipAsList(CurASTNode);
  Expect(tkRParen, ')');
  Expect(tkColon, ':');

  { hidden container / length / index locals }
  caSym := AllocVar(PyHiddenName('za'), tyClass); Syms[caSym].RecName := REC_UCLASS_BASE + listCi; SymSyncTypeRef(caSym);
  cbSym := AllocVar(PyHiddenName('zb'), tyClass); Syms[cbSym].RecName := REC_UCLASS_BASE + listCi; SymSyncTypeRef(cbSym);
  caN := AllocVar(PyHiddenName('zna'), tyInteger);
  cbN := AllocVar(PyHiddenName('znb'), tyInteger);
  nSym := AllocVar(PyHiddenName('zn'), tyInteger);
  iSym := AllocVar(PyHiddenName('zi'), tyInteger);
  { PyAssignTargetSym, not PyProgSym: a loop target is a BINDING, so inside a
    def it must make a LOCAL rather than write through to a module global of
    the same name (Python's rule; `global x` is still honoured, that lookup
    checks). `for a, b in zip(self.xs, other.xs)` in a method, with module-level
    objects also called `a`/`b`, bound the SECOND name to the global — a variant
    element into a class-typed module slot, SIGSEGV. The first name escaped only
    because the locals pre-pass happened to have harvested it.
    bug-nilpy-zip-loop-target-in-a-def-binds-a-module-global }
  xSym := PyAssignTargetSym(name);  if xSym < 0 then xSym := AllocVar(name, tyVariant);
  ySym := PyAssignTargetSym(name2); if ySym < 0 then ySym := AllocVar(name2, tyVariant);

  { drain a comp-iterable's hoisted build before the loop — see PyParseForIn }
  seq := PyFlushHoist(-1);
  { za = A; zb = B }
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(caSym); ASTRight[node] := aNode;
  seq := PySeqAppend(seq, node);
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(cbSym); ASTRight[node] := bNode;
  seq := PySeqAppend(seq, node);
  { zna = len(za); znb = len(zb) }
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(caN);
  ASTRight[node] := PyCallMeth1(listCi, 'count', PyMakeIdent(caSym), -1);
  seq := PySeqAppend(seq, node);
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(cbN);
  ASTRight[node] := PyCallMeth1(listCi, 'count', PyMakeIdent(cbSym), -1);
  seq := PySeqAppend(seq, node);
  { zn = zna if zna < znb else znb  (ternary over idents, no subtree reuse) }
  cnd := AllocNode(AN_BINOP); ASTIVal[cnd] := Ord(tkLt);
  ASTLeft[cnd] := PyMakeIdent(caN); ASTRight[cnd] := PyMakeIdent(cbN); ASTTk[cnd] := Ord(tyBoolean);
  thenElse := AllocNode(AN_PAIR); ASTLeft[thenElse] := PyMakeIdent(caN); ASTRight[thenElse] := PyMakeIdent(cbN);
  node := AllocNode(AN_TERNARY); ASTLeft[node] := cnd; ASTRight[node] := thenElse; ASTTk[node] := Ord(tyInteger);
  incN := AllocNode(AN_ASSIGN); ASTLeft[incN] := PyMakeIdent(nSym); ASTRight[incN] := node;
  seq := PySeqAppend(seq, incN);
  { zi = 0 }
  oneN := AllocNode(AN_INT_LIT); ASTIVal[oneN] := 0; ASTTk[oneN] := Ord(tyInteger);
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(iSym); ASTRight[node] := oneN;
  seq := PySeqAppend(seq, node);

  { loop body: x = za[zi]; y = zb[zi]; <body>; zi += 1 }
  bodyNode := -1;
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(xSym);
  ASTRight[node] := PyCallMeth1(listCi, 'at', PyMakeIdent(caSym), PyMakeIdent(iSym));
  bodyNode := PySeqAppend(bodyNode, node);
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(ySym);
  ASTRight[node] := PyCallMeth1(listCi, 'at', PyMakeIdent(cbSym), PyMakeIdent(iSym));
  bodyNode := PySeqAppend(bodyNode, node);
  { one-line suite accepted too — see the range path's note }
  bodyNode := PySeqAppend(bodyNode, PyParseSuite);
  { zi = zi + 1 }
  oneN := AllocNode(AN_INT_LIT); ASTIVal[oneN] := 1; ASTTk[oneN] := Ord(tyInteger);
  incN := AllocNode(AN_BINOP); ASTIVal[incN] := Ord(tkPlus);
  ASTLeft[incN] := PyMakeIdent(iSym); ASTRight[incN] := oneN; ASTTk[incN] := Ord(tyInteger);
  node := AllocNode(AN_ASSIGN); ASTLeft[node] := PyMakeIdent(iSym); ASTRight[node] := incN;
  bodyNode := PySeqAppend(bodyNode, node);

  { while zi < zn }
  cnd := AllocNode(AN_BINOP); ASTIVal[cnd] := Ord(tkLt);
  ASTLeft[cnd] := PyMakeIdent(iSym); ASTRight[cnd] := PyMakeIdent(nSym); ASTTk[cnd] := Ord(tyBoolean);
  whileNode := AllocNode(AN_WHILE); ASTLeft[whileNode] := cnd; ASTRight[whileNode] := bodyNode;
  seq := PySeqAppend(seq, whileNode);
  PyStmtAteBlock := True;
  Result := seq;
end;

{ A range() bound that is a VARIANT must be unboxed to an integer: the loop
  compares a tyInteger counter against it, and comparing against the BOX is
  always true. Returns the node unchanged for any non-variant, so the literal
  and int-typed paths are untouched. }
function PyUnboxRangeBound(n: Integer): Integer;
var idx, argSeq, node: Integer;
begin
  PyUnboxRangeBound := n;
  if n < 0 then Exit;
  { An ARBITRARY-PRECISION bound NARROWS to Int64. The loop counter is a machine
    int, so a promo bound left alone compared the counter against the SLOT
    ADDRESS and `for k in range(i + 1)` ran an arbitrary number of times.
    Narrowing is not a precision loss that can matter: a range whose bound does
    not fit in Int64 has more iterations than any program can execute, and
    CPython would not finish it either. }
  if TypeIsPromoInt(IntToTypeKind(ASTTk[n])) then
  begin
    idx := FindProc('PXXPromoToInt64Wrap');
    if idx < 0 then Exit;          { promocore not loaded — leave as-is }
    argSeq := AllocNode(AN_ARG);
    ASTLeft[argSeq] := n;
    ASTRight[argSeq] := -1;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := idx;
    ASTTk[node] := Ord(tyInt64);
    ASTLeft[node] := argSeq;
    PyUnboxRangeBound := node;
    Exit;
  end;
  if IntToTypeKind(ASTTk[n]) <> tyVariant then Exit;
  idx := FindProc('pyvar_to_int');
  if idx < 0 then Exit;            { pylib not loaded — leave the old behaviour }
  argSeq := AllocNode(AN_ARG);
  ASTLeft[argSeq] := n;
  ASTRight[argSeq] := -1;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := idx;
  ASTTk[node] := Ord(tyInt64);
  ASTLeft[node] := argSeq;
  PyUnboxRangeBound := node;
end;

{ Is this `range(` sitting directly inside a `list(`?

  CurTok is the `range` identifier, so `Tokens[TokPos]` is its own '(' — which
  makes `Tokens[TokPos - 2]` the enclosing call's '(' and `Tokens[TokPos - 3]`
  the callee name. Purely a token peek; nothing is consumed either way.

  This gate is the whole reason `list(range(3))` can be materialised without
  changing what `print(range(3))` does — see PyParseRangeList. }
{ The enclosing callee names that CONSUME an iterable, i.e. the ones for which
  materialising `range(...)` into a list is indistinguishable from Python's lazy
  object. `list` was the only one, so `list(range(3))` worked while
  `sum(range(3))` failed with "undefined variable (range)" — range is not a
  value in NilPy, it exists only as the counted-loop lowering in a `for` header.

  GONE, and deliberately: this used to be a WHITELIST of callees that promise
  to do nothing but iterate their argument (`list`, `sum`, `len`, `sorted`, …),
  because `range(...)` had no value form and could only be MATERIALISED where
  materialising was invisible. `print(range(3))` was outside the list and so
  was a compile error rather than a wrong answer — the honest failure, but a
  failure.

  TPyRange removed the reason for the list to exist. A range is now an ordinary
  value in every position, so there is nothing to gate: one mechanism where
  there were two, which is the direction devdocs/dev/normalise-dont-special-case
  asks for. }

{ `range(stop)` / `range(start, stop)` / `range(start, stop, step)` as a LIST.

  Builds a TPyRange — CPython's lazy, re-iterable, indexable SEQUENCE — and is
  reached from EVERY expression position. The name is historical: it built a
  LIST until feature-nilpy-range-as-a-value, and only inside a whitelist of
  callees that promised to merely iterate it, because there was no range value
  to hand back.

  The `for i in range(...)` HEADER never comes here: PyParseFor recognises it
  first and keeps the counted-loop lowering, where the bounds are induction
  variables rather than an object.

  Bounds go through pyvar_to_int (PyUnboxRangeBound) for the same reason the for
  header does: an unannotated parameter is a VARIANT, and comparing the counter
  against the box rather than the value is what made
  `def f(n): for i in range(n)` loop forever. A zero step raises ValueError
  inside pyrange_list, as CPython does. }
function PyParseRangeList: Integer;
var lo, hi, step, a0, a1, a2, node, pi: Integer;
begin
  Next; Expect(tkLParen, '(');
  PyParseBoolExpr;
  hi := CurASTNode;
  lo := -1;
  step := -1;
  if Eat(tkComma) then
  begin
    lo := hi;
    PyParseBoolExpr;
    hi := CurASTNode;
    if Eat(tkComma) then
    begin
      PyParseBoolExpr;
      step := CurASTNode;
    end;
  end;
  Expect(tkRParen, ')');
  if lo < 0 then
  begin
    lo := AllocNode(AN_INT_LIT);
    ASTIVal[lo] := 0;
    ASTTk[lo] := Ord(tyInt64);
  end;
  if step < 0 then
  begin
    step := AllocNode(AN_INT_LIT);
    ASTIVal[step] := 1;
    ASTTk[step] := Ord(tyInt64);
  end;
  lo   := PyUnboxRangeBound(lo);
  hi   := PyUnboxRangeBound(hi);
  step := PyUnboxRangeBound(step);
  { A RANGE VALUE, not a list. It used to materialise, and only in the call
    positions a whitelist promised were iterate-only (PyRangeIterConsumer,
    deleted with this change) — because there was no range value to hand back.
    TPyRange is that value: lazy, re-iterable, indexable and len-able, so every
    position works and `print(range(3))` says `range(0, 3)` instead of being a
    compile error. feature-nilpy-range-as-a-value }
  pi := FindProc('pyrange3');
  if pi < 0 then Error('Nil Python: pyrange3 (pylib) not loaded');
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := lo;
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := hi;
  a2 := AllocNode(AN_ARG); ASTLeft[a2] := step; ASTRight[a2] := -1;
  ASTRight[a1] := a2;
  ASTRight[a0] := a1;
  node := AllocNode(AN_CALL);
  ASTIVal[node] := pi;
  ASTLeft[node] := a0;
  ASTTk[node] := Ord(Procs[pi].RetType);
  ASTRight[node] := ProcRetRecId[pi];
  LastExprTk := IntToTypeKind(ASTTk[node]);
  PyParseRangeList := node;
end;

function PyParseForTargetSlot(slot: Integer): AnsiString;
{ One entry of a for target list: either a plain NAME, consumed and returned as
  itself, or a PARENTHESISED GROUP — `(p, q)` in `for n, (p, q) in ...` — which
  is consumed here and returned as a HIDDEN name, with the inner names recorded
  in PyForNestName[slot] for the body prologue to unpack.

  Desugared rather than generalised into the for lowering: that lowering is
  keyed end to end on a flat list of names, and a nested group is exactly the
  index-unpack it already performs for `for a, b in pairs`, one level down.
  feature-nilpy-starred-and-nested-unpacking }
var n: Integer; trailComma: Boolean;
begin
  if (slot >= 0) and (slot <= PY_FOR_NEST_SLOTS) then PyForNestCount[slot] := 0;
  if CurTok.Kind = tkStar then
    Error('Nil Python: a STARRED loop target (`for a, *rest in ...`) is not '
          + 'supported yet');
  if CurTok.Kind <> tkLParen then
  begin
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: expected a loop variable');
    Result := CurTok.SVal;
    Next;
    Exit;
  end;
  if (slot < 0) or (slot > PY_FOR_NEST_SLOTS) then
    Error('Nil Python: too many names in a for target');
  Next;                                  { '(' }
  n := 0;
  trailComma := False;
  repeat
    if CurTok.Kind = tkStar then
      Error('Nil Python: a STARRED name inside a nested loop target is not '
            + 'supported yet');
    if CurTok.Kind = tkLParen then
      Error('Nil Python: a loop target nested more than one level deep '
            + '(`for a, ((b, c), d) in ...`) is not supported yet');
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: expected a name inside the nested loop target');
    if n > PY_FOR_NEST_NAMES then
      Error('Nil Python: too many names in a nested loop target');
    PyForNestName[slot][n] := CurTok.SVal;
    Inc(n);
    Next;
    if not Eat(tkComma) then Break;
    { a TRAILING comma — `(only,)`, and also the legal `(a, b,)`. For ONE name
      it is what makes the target a 1-tuple UNPACK rather than a plain name:
      `for (only,) in [(1,)]` binds 1, not (1,). That is why it is remembered
      rather than merely tolerated.
      bug-nilpy-a-one-name-tuple-loop-target-is-refused }
    if CurTok.Kind = tkRParen then begin trailComma := True; Break; end;
  until False;
  Expect(tkRParen, ')');
  if (n < 2) and (not trailComma) then
    Error('Nil Python: a nested loop target needs at least two names');
  PyForNestCount[slot] := n;
  Result := PyHiddenName('nst');
end;

{ The class of this EXACT name, or -1.

  FindUClass is case-INSENSITIVE — Pascal heritage, and correct there. Python is
  not, and using it raw here was a real bug with a silent, layout-dependent
  symptom: `w = W(...)` then `for a in w.slider():` matched the RECEIVER `w`
  against the CLASS `W`, took the unbound `Cls.method(self)` route, and passed
  no receiver at all, so the generator ran against a garbage `self` and crashed
  inside the list it tried to walk. It only reproduced when a variable and a
  class differed by case alone, which is why renaming either one made it
  disappear. }
function PyFindUClassExact(const nm: AnsiString): Integer;
begin
  Result := FindUClass(nm);
  if (Result >= 0) and (PyRawName(UClsNOff[Result], UClsNLen[Result]) <> nm) then
    Result := -1;
end;

{ `lhs := rhs` as a statement node. }
function PyMakeAssignNode(lhs, rhs: Integer): Integer;
begin
  Result := AllocNode(AN_ASSIGN);
  ASTLeft[Result] := lhs;
  ASTRight[Result] := rhs;
end;

{ The value-position twin of GenMakeVariantArgCell (parser.inc): a variant
  argument to a generator needs a heap cell whose address the instance slot can
  hold, because the callee reads it again at every resume, long after the
  expression that produced the argument is gone. The only difference is where
  the two setup statements go — HOISTED here, appended to the desugar's own
  init sequence there. }
function PyGenValueArgCell(argNode: Integer): Integer;
var ps, newPi, callNode, derefNode: Integer;
begin
  newPi := FindProc('pycell_new');
  if newPi < 0 then
    Error('Nil Python: a generator variant argument needs pylib (pycell_new)');
  ps := AllocVar('', tyPointer);
  Syms[ps].PtrElemTk := tyVariant;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := newPi;
  ASTLeft[callNode] := -1;
  ASTTk[callNode] := Ord(tyPointer);
  PyHoistStmt(PyMakeAssignNode(GenMakeIdent(ps, tyPointer), callNode));
  derefNode := AllocNode(AN_DEREF);
  ASTLeft[derefNode] := GenMakeIdent(ps, tyPointer);
  ASTTk[derefNode] := Ord(tyVariant);
  PyHoistStmt(PyMakeAssignNode(derefNode, argNode));
  Result := GenMakeIdent(ps, tyPointer);
end;

{ A generator CALL in value position — `g = gen(args)`, `list(gen())`,
  `next(gen())`, a generator handed to another function.

  The `for` header consumes a generator without materialising anything
  (ParseForInGeneratorAST): it allocates the instance, drives the step function
  and frees it, all inside the one statement. A VALUE cannot do that — it has to
  outlive the expression that made it — so it becomes a CURSOR
  (PYITER_SLGEN, pylib), which is the same object `map`, `filter`, `zip` and a
  generator EXPRESSION already produce. Every consumer of a generator value is
  therefore already written: `for x in g`, `next(g)`, `list(g)`, unpacking.

  The instance allocation and the argument stores are HOISTED, because they are
  statements and this is an expression. That is exactly what the hoist queue is
  for, and it is why this reads more simply than the `for` desugar, which had to
  park the queue instead of using it.

  Enters with the cursor on the generator's NAME. }
function PyBuildGeneratorValue(gpi: Integer): Integer;
var gIdx, nargs, argNode, slotOff, k: Integer;
    instLit, allocCall, stepNode, a0, a1: Integer;
begin
  if (FindProc('SlNew') < 0) or (FindProc('SlSet') < 0) then
    Error('Nil Python: a generator value needs lib/rtl/slgen in scope');
  if FindProc('pygen_iter_new') < 0 then
    Error('Nil Python: pylib (pygen_iter_new) not loaded');
  Next;                                { past the generator's name }
  Expect(tkLParen, '(');

  gIdx := AllocVar('', tyPointer);
  instLit := AllocNode(AN_INT_LIT);
  ASTIVal[instLit] := ProcGenInstSize[gpi];
  ASTTk[instLit] := Ord(tyInt64);
  allocCall := GenMakeCall6(FindProc('SlNew'), tyPointer, instLit, -1, -1, -1, -1, -1);
  PyHoistStmt(PyMakeAssignNode(GenMakeIdent(gIdx, tyPointer), allocCall));

  { Each declared parameter is seeded into its persistent slot, in declaration
    order — slot k at SL_OFF_SLOTS + 8*k, the numbering the state-machine
    transform assigns and the `for` desugar already relies on. }
  nargs := 0;
  if CurTok.Kind <> tkRParen then
    repeat
      PyParseBoolExpr;
      argNode := CurASTNode;
      if nargs >= ProcGenParamCnt[gpi] then
        Error('Nil Python: too many arguments to generator `'
              + Procs[gpi].Name + '`');
      { a variant parameter is by-ref, so its slot holds a heap cell that
        outlives the call — the same cell the `for` desugar builds }
      if PyGenArgNeedsCell(gpi, nargs + 1) then
        argNode := PyGenValueArgCell(argNode);
      slotOff := SL_OFF_SLOTS + 8 * nargs;
      PyHoistStmt(GenMakeCall6(FindProc('SlSet'), tyInt64,
        GenMakeIdent(gIdx, tyPointer), GenMakeIntLit(slotOff), argNode, -1, -1, -1));
      Inc(nargs);
    until not Eat(tkComma);
  Expect(tkRParen, ')');
  if nargs < ProcGenParamCnt[gpi] then
    Error('Nil Python: generator `' + Procs[gpi].Name + '` needs '
          + AIntToStr(ProcGenParamCnt[gpi]) + ' argument(s), got '
          + AIntToStr(nargs));

  stepNode := AllocNode(AN_PROCADDR);
  ASTIVal[stepNode] := gpi;
  ASTTk[stepNode] := Ord(tyPointer);

  k := FindProc('pygen_iter_new');
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := stepNode; ASTRight[a1] := -1;
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := GenMakeIdent(gIdx, tyPointer); ASTRight[a0] := a1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := k;
  ASTTk[Result] := Ord(Procs[k].RetType);
  ASTLeft[Result] := a0;
  { the cursor's class identity, so every consumer that dispatches on the
    receiver's class sees a TPyIter rather than an untyped node — see
    PyCallProc1, which carries it for the same reason }
  if Procs[k].RetType = tyClass then ASTRight[Result] := ProcRetRecId[k];
end;

{ Bind the loop target of a GENERATOR for-in, and build the statements that
  unpack a TUPLE target from the yielded element.

  A single name binds the element directly, so the prologue is empty. Several
  names — `for previous, token, next in self.slider():`, exactly how html5lib's
  optionaltags filter reads its own generator — bind the element to a HIDDEN
  name and then index it, which is the same PyPairItem walk the ordinary
  container for-in already uses for a list of tuples. The prologue is returned
  rather than emitted because the shared desugar owns where it goes: after the
  element assignment, before the body. }
function PyGenBindTarget(const name, name2: AnsiString; var prologue: Integer): Integer;
var s0, si, xi: Integer;
begin
  prologue := -1;
  if name2 = '' then
  begin
    Result := PyAssignTargetSym(name);
    if Result < 0 then Result := AllocVar(name, tyVariant);
    Exit;
  end;
  Result := AllocVar('', tyVariant);   { the hidden element }
  s0 := PyAssignTargetSym(name);
  if s0 < 0 then s0 := AllocVar(name, tyVariant);
  prologue := PySeqAppend(prologue,
                PyMakeAssignNode(PyMakeIdent(s0), PyPairItem(PyMakeIdent(Result), 0)));
  si := PyAssignTargetSym(name2);
  if si < 0 then si := AllocVar(name2, tyVariant);
  prologue := PySeqAppend(prologue,
                PyMakeAssignNode(PyMakeIdent(si), PyPairItem(PyMakeIdent(Result), 1)));
  for xi := 0 to PyForExtraCount - 1 do
  begin
    si := PyAssignTargetSym(PyForExtraName[xi]);
    if si < 0 then si := AllocVar(PyForExtraName[xi], tyVariant);
    prologue := PySeqAppend(prologue,
                  PyMakeAssignNode(PyMakeIdent(si), PyPairItem(PyMakeIdent(Result), xi + 2)));
  end;
end;

function PyParseFor: Integer;
var genPi, genMi, genRecv, genRecvNode, genProl: Integer;
    name, name2: AnsiString;
    enumMode: Boolean; symIdx, node, lhsNode, startNode, stopNode, stepNode: Integer;
    pair1, pair2, pair3, bodyNode, oneNode, limitNode, compSaved: Integer;
    rngStep, cmpNode, incNode, whileNode, keyN, hoistPre: Integer;
    rngStepSym, rngStopSym, rngChkPi, rngChkArg: Integer;
    rngDown, rngZero, rngGt, rngLt, rngPair: Integer;
    stepKnown: Boolean;
    parenTarget: Boolean; pDepth, pScan: Integer;
    forTokIdx: Integer;   { token index of the `for` keyword itself }
    hName: AnsiString; ifCondStart, closerPos2, filtDummy: Integer;
    userSym: Integer;   { the user's loop variable; -1 for a comprehension, whose
                          hidden name IS the counter (see the range lowering) }
begin
  forTokIdx := TokPos - 1;   { CurTok is `for` at entry }
  Next;
  { A PARENTHESISED target list — `for (x, y, text, font, pf) in self.lines:`.

{ SPDX-License-Identifier: MPL-2.0 }
{ ===== Nil Python Parser =====

  Expression operators accepted by the .npy lexer/parser boundary:
    Python spelling   shared parser token   policy
    + - *             tkPlus/tkMinus/tkStar same arithmetic semantics
    //                tkDiv                 integer division
    %                 tkMod                 integer remainder
    == != < <= > >=   tkEq/tkNeq/...        comparisons
    and or not        tkAnd/tkOr/tkNot      boolean operators

  `/` is intentionally rejected in v1: use `//` for integer division. The
  lexer reports other Python-only operators before this parser is entered.
}

const
  { 128 was too small for a real module: songformatter's key_analysis.py plus a
    driver crosses it and the compile stops at "too many inferred module
    locals". The table is per-scope constraints, four words each — 512 costs
    nothing and covers a file several times that size.

    …and 512 was too small for html5lib's constants.py, which most of html5lib
    imports. Bracketed by building the compiler at both: it fails at 512 and
    compiles at 1024, so the requirement is somewhere in 513..1024. Raised to
    4096 rather than to the measured bound, because the bound is a property of
    one file and the next corpus will have a bigger one; five arrays are
    dimensioned by this and 4096 of them costs a few hundred KB of BSS against a
    compiler that already reserves 166 MB.

    RAISING THIS WAS NOT SAFE UNTIL ce57db4cd. The low cap was masking a stack
    overflow: it stopped the big files before IR lowering ran, and lowering
    recursed once per statement, so the first thing a raised cap bought was
    SIGSEGV with no diagnostic on two html5lib files. The recursion is iterative
    now and those files report ordinary errors. If this constant is ever raised
    again, the question to ask first is what the old value was preventing from
    running — not whether the table itself is big enough.
    bug-n-the-module-locals-cap-hides-a-compiler-stack-overflow }
  PY_MAX_LOCALS = 4096;

type
  TPyLocalConstraint = record
    Name: AnsiString;
    TypeKind: TTypeKind;
    RecCi: Integer;   { class index when TypeKind = tyClass, else -1 }
    { Sticky: this name was assigned instances of two UNRELATED classes, so it
      has no single static layout and must stay on the dynamic path. It has to
      be its own flag rather than `RecCi = -1`, because the harvest loop runs to
      a FIXPOINT: clearing RecCi alone lets the next round see "no class yet",
      re-adopt the newest one, and report `changed` forever — the loop never
      converges. Once True it is never cleared.
      bug-nilpy-local-reassigned-across-classes-keeps-one-static-class }
    Poly: Boolean;
  end;

const
  PY_MAX_DC_FIELDS = 512;
  { default kinds for dataclass fields }
  PYDC_NONE  = 0;
  PYDC_INT   = 1;
  PYDC_FLOAT = 2;
  PYDC_STR   = 3;
  PYDC_BOOL  = 4;
  PYDC_NIL   = 5;  { None default: 0/nil for pointer-like and Optional[int] fields }
  PYDC_FACTORY_LIST = 6;  { field(default_factory=list): fresh empty TPyList per construction }
  PYDC_FACTORY_DICT = 8;  { field(default_factory=dict): fresh empty TPyDict per construction }
  PYDC_FACTORY_EXPR = 7;  { field(default_factory=lambda: <expr>): IVal/SOff carry the
                            body's token span, re-parsed at every construction site }
  PYDC_EXPR = 9;          { an EXPRESSION default (`x: int = 2 + 3`): evaluated ONCE at
                            the class statement into the same hidden global a plain
                            class attribute uses, and READ from there per construction.
                            Once, not per construction, because that is CPython's rule —
                            it is exactly why field(default_factory=...) has to exist.
                            feature-nilpy-dataclass-expression-field-default }

var
  PyLocals: array[0..PY_MAX_LOCALS-1] of TPyLocalConstraint;
  PyLocalCount: Integer;
  PyModuleLocals: array[0..PY_MAX_LOCALS-1] of TPyLocalConstraint;
  PyModuleLocalCount: Integer;
  { PHANTOMS — names registered in PyCollectModuleLocalsAST's SCRATCH symbol
    table purely so a LATER statement's trial parse can RESOLVE them, and
    deliberately withheld from the harvest that builds the widening table.

    A name first bound inside a control-flow block (`with open(p) as f: raw =
    f.read()`) is not registered at all today unless its right-hand side matches
    one of the arm's safe token shapes, so the very next `n = len(raw)` — the
    only form that IS trial-parsed — died with "undefined variable (raw)" while
    `print(len(raw))` one line earlier was fine. That asymmetry is what made the
    error impossible to place.

    Three earlier routes were measured and each failed for its own reason (all
    recorded on bug-nilpy-name-bound-by-a-method-call-in-a-block-is-undefined-
    later): noting tyVariant WIDENS the name and broke `tok is None` for a
    str-typed Optional; per-shape widening is a losing game; and AllocVar(name,
    tyUnknown) does not stay unknown — the harvest turns it into a Variant the
    real assignment then cannot convert to.

    The phantom is the fourth and it is the one the ticket actually asked for:
    REGISTER WITHOUT ASSERTING A TYPE. The symbol exists for the duration of the
    round (so the trial parse resolves), is rolled back with everything else, and
    contributes NOTHING to PyLocals — so the name's real type still comes from
    the real parse, exactly as it does today. Cost is the one the ticket already
    priced in: no widening for that name.

    Only names that are never a MODULE-TOP-LEVEL binding target are phantomed
    (PyTopTarget) — for those, the depth-0 arm's own trial parse is the real
    source of type information and a phantom would swallow it. }
  PyPhantomNames: array[0..PY_MAX_LOCALS-1] of AnsiString;
  PyPhantomCount: Integer;
  { Names with an UNREADABLE block-nested binding — the same `raw = f.read()` /
    `z = c.two(1)` shapes the phantom covers, recorded by NAME rather than as a
    symbol.

    The phantom's cost is "no widening for that name", and that is harmless
    while the unreadable binding is the ONLY one. It is not harmless when the
    same name ALSO has a binding the arm can read: the table then commits to
    that one representation while a value of another shape is stored through
    the same slot. Measured: `z = c.two(1)` (unreadable, int) then `z = 3.5` in
    one block printed 4615063718147915776 — 3.5's IEEE bits read as an integer
    — and `y = "a-b".split("-")` then `y = 5` made len(y) raise on an int.

    So the intersection is what widens: a name in BOTH this list and the
    constraint table cannot be pinned to the shape we happen to have read, and
    goes tyVariant. A name only in this list keeps today's behaviour, which is
    what the PyPhantomNames note above requires — blanket tyVariant was tried
    and broke `tok is None` for a str-typed Optional, and that failure is
    exactly the single-binding case this leaves alone.
    feature-n-nilpy-ast-typing-module-scope }
  PyUnkBindNames: array[0..PY_MAX_LOCALS-1] of AnsiString;
  PyUnkBindCount: Integer;
  { names bound at module TOP level (depth 0) anywhere in the file — the
    over-inclusive token prescan behind the PyTopTarget guard above. Over-
    inclusion only means FEWER phantoms, i.e. today's behaviour, which is the
    safe direction to be wrong in. }
  PyTopTargets: array[0..PY_MAX_LOCALS-1] of AnsiString;
  PyTopTargetCount: Integer;
  { PyCollectLocalsAST's trial parse is on. The assignment paths report every
    RHS type they build so the table can WIDEN: the symbol table alone only
    remembers a local's FIRST assignment, which is exactly the information
    Python's implicit declaration does not give you (`x = 1` then `x = "s"`
    is one variant local, not an Integer one). }
  PyTypingPass: Boolean;
  { List-comprehension mode for PyParseForIn: when PyCompTarget >= 0 the loop
    has NO parsed suite. Instead its body is `PyCompTarget.append(EXPR)`, where
    EXPR is re-parsed from the tokens at PyCompExprStart (a comprehension writes
    the element expression BEFORE the `for`), and the header ends at `]` rather
    than `:`. See PyParseListComp. }
  PyCompTarget: Integer;
  PyCompExprStart: Integer;
  { DICT-comprehension mode: when set, the comprehension target is a TPyDict and
    the element region is `KEY : VALUE` (not one EXPR), so the body becomes
    `target.store(KEY, VALUE)` instead of `.append(EXPR)`. See PyParseDictComp. }
  PyCompIsDict: Boolean;
  { SET-comprehension mode: a brace group with a `for` and no colon. The target
    is a TPyList (which is how NilPy represents a set) and elements go in through
    `add`, the duplicate-skipping insert, so len() matches Python's. }
  PyCompIsSet: Boolean;
  { Statement HOISTING, for expression-position comprehensions/genexprs. A
    comprehension used inside an expression (`"\n".join(x for x in it)`, or a
    bracketed one as a call argument) cannot be an expression on its own — the
    single-pass AST has no statement-in-expression node. So it desugars into a
    hidden temp filled by a loop, PUSHES those setup statements here, and yields
    the temp. Each statement-sequence builder flushes this before the statement
    it just parsed, so the setup runs first. }
  PyHoistHead: Integer;
  { `from mod import NAME as ALIAS` — the alias's binding, queued rather than
    built where the import is parsed. The LEADING import run happens before the
    program's statement list exists and before ASTArenaFloor is set, so an AST
    node made there is both homeless and liable to be recycled by a later unit
    compile. Only the two symbol indices are recorded here; the assignment is
    materialised by PyFlushImportAliases at the head of the module body.
    PyImpAliasSrc >= 0 is the exporting unit's SYMBOL; < 0 encodes a PROC as
    -(pi + 1). }
  PyImpAliasSym: array[0..63] of Integer;
  PyImpAliasSrc: array[0..63] of Integer;
  PyImpAliasCount: Integer;
  PyTypingChanged: Boolean;
  PyHiddenSeq: Integer;   { serial for hidden for-in loop temps }
  { One parsed `def` header, filled by PyParseDefHeader and read by both its
    callers — the shell pre-pass and PyParseDef itself. Globals rather than a
    dozen var parameters because there must be exactly ONE implementation of
    the header grammar: the pre-pass decides the registered SIGNATURE and
    PyParseDef decides the FRAME, and any disagreement between them is a
    silent ABI mismatch rather than a parse error. }
  { A for target with MORE than two names — `for a, b, c in triples:`. The first
    two keep their own variables (the dict/enumerate/zip forms only ever have
    two); anything beyond them lands here and is unpacked from the element by
    index, which is the only form that can serve three. }
  PyForExtraName: array[0..5] of AnsiString;
  PyForExtraCount: Integer;
  { A NESTED target slot — `for n, (p, q) in enumerate(pairs):`. The whole for
    lowering is keyed on a FLAT name list, so a group is desugared here rather
    than generalised into it: the slot takes a HIDDEN name like any other, and
    the inner names are unpacked from it by index at the top of the body, which
    is exactly what the two-name pair path already does one level up.

    Slot numbering matches the target list: 0 = the first name, 1 = the second,
    2+ = PyForExtraName[slot-2]. Count 0 means the slot is a plain name.
    feature-nilpy-starred-and-nested-unpacking }
  PyForNestName: array[0..PY_FOR_NEST_SLOTS, 0..PY_FOR_NEST_NAMES] of AnsiString;
  PyForNestCount: array[0..PY_FOR_NEST_SLOTS] of Integer;
  { The same, for an ASSIGNMENT target list — `a, (b, c) = (1, (2, 3))`.
    PyAsgNestHost is the HIDDEN name the group's slot was bound to, so the
    unpack can be emitted from one helper at both of PyParseUnpackAssign's
    exits instead of being written out twice. }
  PyAsgNestName: array[0..PY_FOR_NEST_SLOTS, 0..PY_FOR_NEST_NAMES] of AnsiString;
  PyAsgNestCount: array[0..PY_FOR_NEST_SLOTS] of Integer;
  PyAsgNestHost: array[0..PY_FOR_NEST_SLOTS] of AnsiString;
  PyHdrName: AnsiString;
  PyHdrNParams: Integer;
  PyHdrIsProc: Boolean;
  PyHdrRetType: TTypeKind;
  PyHdrRetCi: Integer;
  PyHdrPNames: array[0..31] of AnsiString;
  PyHdrPTypes: array[0..31] of TTypeKind;
  PyHdrPCis: array[0..31] of Integer;
  PyHdrPSigs: array[0..31] of Integer;   { Callable signature per parameter, or -1 }
  PyHdrDefHas: array[0..31] of Boolean;
  PyHdrDefIsStr: array[0..31] of Boolean;
  PyHdrDefIsNone: array[0..31] of Boolean;
  PyHdrDefIsFloat: array[0..31] of Boolean;
  PyHdrDefIsBool: array[0..31] of Boolean;
  PyDefaultWasNone: Boolean;   { set by PyParamDefaultAt — see there }
  PyDefaultWasFloat: Boolean;
  PyDefaultWasBool: Boolean;
  { Symbol of the hidden global holding a NON-CONSTANT default's def-time value,
    or -1. Set by PyParamDefaultAt alongside the flags above, for the same
    reason: every caller wants it immediately after the call. }
  PyDefaultSym: Integer;
  { PyParamDefaultAt may EVALUATE a non-constant default only while this is on.
    Off in the pre-passes (PyRegisterDefShells, the nested-def queue scan) which
    re-parse headers purely to learn signatures — evaluating there would build
    the value before the names it reads exist, and queue it at the wrong point
    in the statement stream. }
  PyDefaultEvalMode: Boolean;
  { CLASS component of a hidden default global's name, or '' at module level.
    Without it `$pdef.f.b` is shared by every class declaring `f(self, b=...)`,
    so `class A` and `class B` both writing their own default collide on ONE
    symbol and the second wins — which is a sufficient cause of two-class
    breakage on its own, independent of anything else. }
  PyDefaultClsName: AnsiString;
  { The class statement just parsed, and its body token span, so the statement
    loop can evaluate METHOD defaults AFTER PyParseClass returns. Python
    evaluates a method default when the CLASS BODY executes, so the class
    statement is the semantically correct point; keeping it outside PyParseClass
    also keeps it clear of that routine's trial parses and symbol rollbacks.
    ci = -1 when there is nothing to do. }
  PyClsEvalCi: Integer;
  PyClsEvalLo: Integer;
  PyClsEvalHi: Integer;
  { Def-time parameter-default initialisers awaiting the enclosing statement
    stream. A queue of its OWN, not PyHoistHead: PyParseDef deliberately
    discards the hoist queue on the way out (a body's residue must not escape),
    and these are produced by the HEADER and must survive that. }
  PyDefInitHead: Integer;
  PyHdrDefSym: array[0..31] of Integer;
  { the interned NAME of PyHdrDefSym's global -- the key that survives a
    rolled-back trial parse recycling the symbol index (see
    ProcParamDefaultGName in defs.inc) }
  PyHdrDefGName: array[0..31] of Integer;
  PyHdrDefVal: array[0..31] of Int64;
  PyHdrDefSOff: array[0..31] of Integer;
  PyHdrDefSLen: array[0..31] of Integer;
  { parameter index of `*args` / `**kwargs` in the header just parsed, or -1 }
  PyHdrStarIdx: Integer;
  { Set by PyApplyGeneratorABI, read by PyMarkGeneratorProc: the header arrays
    no longer hold them once the ABI is rewritten (the declared result becomes
    the step function's Boolean has-next, and the declared params shift to 1..n). }
  PyGenElemTk: TTypeKind;      { the yielded ELEMENT type — always tyVariant here }
  PyGenDeclParams: Integer;    { the def's own parameter count, excluding __genself }
  PyHdrKwIdx: Integer;
  { @dataclass field defaults, appended in declaration order per class ci.
    Looked up positionally by PyClassCreate to fill omitted trailing args. }
  PyDcCi:   array[0..PY_MAX_DC_FIELDS-1] of Integer;
  PyDcKind: array[0..PY_MAX_DC_FIELDS-1] of Integer;
  PyDcIVal: array[0..PY_MAX_DC_FIELDS-1] of Int64;
  PyDcSOff: array[0..PY_MAX_DC_FIELDS-1] of Integer;
  PyDcSLen: array[0..PY_MAX_DC_FIELDS-1] of Integer;
  PyDcCount: Integer;
  PyDcClassIsDc: array[0..PY_MAX_DC_FIELDS-1] of Boolean;  { indexed by ci }
  { Proc index of the SYNTHESIZED @dataclass __eq__, or -1 when the class has a
    hand-written one (which wins) or is not a dataclass. Indexed by ci; the
    body is emitted by PyEmitDataclassEq once the fields are known.
    bug-nilpy-dataclass-no-generated-eq }
  PyDcEqProc: array[0..MAX_UCLASS-1] of Integer;

  { Same, for the synthesized @dataclass `__repr__`. Separate from PyDcEqProc
    because a class may hand-write one and not the other, and each generated
    body is skipped independently. bug-nilpy-dataclass-no-generated-repr }
  PyDcReprProc: array[0..MAX_UCLASS-1] of Integer;
  { `@dataclass(order=True)`: CPython then generates __lt__/__le__/__gt__/__ge__
    comparing the field tuple. The flag is filled by the member pre-pass's token
    scan rather than by PyParseDataclassArgs, because the pre-pass is the pass
    that sees every class and knows its `ci` — and both passes reach
    PyRegisterClassMembers, which is where the four methods are registered.
    bug-nilpy-dataclass-keyword-arguments-do-not-parse }
  PyDcOrder: array[0..MAX_UCLASS-1] of Boolean;
  { the four generated comparison methods, ci*4 + (0=lt, 1=le, 2=gt, 3=ge);
    -1 where the class hand-wrote one, which WINS as it does for __eq__ }
  PyDcCmpProc: array[0..MAX_UCLASS*4-1] of Integer;
  { True when the member pre-pass already ran the FULL PyRegisterClassMembers
    for this ci (methods + fields + defaults), so PyParseClass must not run it
    again — a second full run would duplicate the append-only PyDc* defaults
    and re-RegisterProc every method. Hoisting members is what lets the
    module-collect trial parse resolve `x = obj.method()`
    (bug-nilpy-method-result-copied-to-var-undefined). }
  PyMembersHoisted: array[0..MAX_UCLASS-1] of Boolean;

  { The token span of a class's BODY, recorded by whichever pass registered the
    class first (the member pre-pass or PyParseClass). Multiple inheritance is
    implemented by FLATTENING — a second base's members are registered into,
    and its method bodies re-parsed against, the DERIVED class — and re-parsing
    needs the base's tokens, which are still sitting in the stream where they
    were lexed. So nothing is copied: the span is replayed with `ci` = the
    derived class, which is exactly the semantics Python gives a mixin (`self`
    IS the derived object). bug-nilpy-multiple-inheritance-does-not-parse }
  PyClsBodyS: array[0..MAX_UCLASS-1] of Integer;
  PyClsBodyE: array[0..MAX_UCLASS-1] of Integer;
  { The extra (2nd..Nth) bases of the class currently being registered/parsed,
    in C3 left-to-right order. Set by PyResolveBaseList immediately before the
    registration or body parse that consumes it, and cleared by the consumer —
    a handshake rather than a parameter because both consumers are reached
    through call chains that would otherwise thread it through unrelated code. }
  PyMixN: Integer;
  PyMixCi: array[0..5] of Integer;
  { Does this flattened base stand BEFORE the one that became the real parent?
    It usually does not — the parent is normally the first base — but it can:
    an IMPORTED base has no body to flatten, so it is chosen as the parent even
    from second position, which is what makes `class SW(Codec,
    codecs.StreamWriter)` compile at all. C3 is left-to-right, so a base that
    precedes the parent BEATS it and must be allowed to override the parent's
    slot; one that follows it loses to the whole parent chain.
    bug-nilpy-multiple-inheritance-from-an-imported-base-is-refused }
  PyMixBeforeParent: array[0..5] of Boolean;
  { Method/attribute names the DERIVED class defines itself, or an earlier base
    already supplied. A later base's definition of the same name loses (C3
    left-to-right, first base wins) and is skipped in BOTH passes — registration
    and body parse — which must agree exactly or a proc is compiled for a member
    that was never registered. }
  PyMixSkipN: Integer;
  PyMixSkip: array[0..255] of AnsiString;
  { True while a flattened base's body is being REPLAYED against the derived
    class, so the member sites can tell a losing definition from a real one. }
  PyMixReplay: Boolean;
  { Construct with NO parenthesised argument list at the cursor — `raise
    ValueError`, the bare-CLASS raise, which CPython treats as `raise
    ValueError()`. Set immediately before PyClassCreate and cleared by it, so
    the whole ctor path (parameter defaults, dataclass fields, the Exception
    shells) is reused rather than a second zero-argument construction being
    written beside it.
    bug-nilpy-raise-of-a-bare-exception-class-is-refused-at-runtime }
  PyCtorNoParens: Boolean;
  { This class is named as a SECOND (or later) base somewhere in the program,
    so it exists to be flattened. Its body is therefore NOT compiled standalone:
    the canonical mixin reads members it does not declare (`self.name`,
    `self.hello()` — supplied by whatever class flattens it), which is duck
    typing CPython resolves at attribute-lookup time and a static class layout
    cannot. Compiled against the DERIVED class those references resolve exactly.
    The cost is that such a class cannot ALSO be used standalone; that is loud
    (a `has no method` at the call) rather than silent, and it is new ground —
    a program with a second base did not compile at all before. }
  PyClsUsedAsMixin: array[0..MAX_UCLASS-1] of Boolean;

{ A parameter annotation NilPy could not read. CPython does not enforce
  annotations at all, so refusing the program over one breaks the
  upward-compatibility rule for a construct that carries no run-time meaning;
  the parameter degrades to Any (tyVariant) — precisely where an ABSENT
  annotation already lands, and a dynamic path that cannot produce a wrong
  value. Warned rather than silent, because the type information really is
  lost and a misspelled forward reference should stay visible.

  One routine for both parameter sites (the def header and the method
  pre-pass): they must agree about the degraded type or the registered
  signature and the frame disagree, which is the same trap their
  unannotated branches already carry a note about.
  bug-n-an-uninterpretable-annotation-refuses-the-program }
procedure PyWarnUnreadAnnotation(const what: AnsiString; line: Integer);
begin
  WarnAt(line, 'Nil Python: ' + what + ' has a type annotation this '
         + 'frontend cannot read; treating it as Any');
end;

function PyIsIdent(const s: AnsiString): Boolean;
{ Exact, not CaseEqual: every literal passed here is a lowercase Python soft
  keyword (`for`, `elif`, `pass`, `lambda`, `dataclass`, ...), and Python
  identifiers are case-sensitive — `For = 2` binds a variable, it does not open
  a loop (bug-nilpy-identifiers-are-case-insensitive). }
begin
  Result := (CurTok.Kind = tkIdent) and StrEqual(CurTok.SVal, s);
end;

{ `/` is Python true division and maps to the shared tkSlash float-division
  path (int operands produce a float, matching CPython). `//` is tkDiv. }

procedure PyExpectIdent(const s: AnsiString);
begin
  if not PyIsIdent(s) then Error('Nil Python: expected ' + s);
  Next;
end;

procedure PySkipNewlines;
begin
  while CurTok.Kind = tkNewline do Next;
end;

{ `@dataclass(...)`'s argument list. The bare and empty-paren forms were the
  only ones accepted, so `@dataclass(order=True)` died on `unexpected token`
  with the parser pointing at `order` — a message that says nothing about the
  actual gap (bug-nilpy-dataclass-keyword-arguments-do-not-parse).

  Every option here is a keyword with a documented CPython default, and passing
  an option its OWN default changes nothing — `@dataclass(eq=True)` is exactly
  `@dataclass`. So the whole list parses, a default-valued option is accepted
  as the no-op it is, and anything that would actually alter the generated
  class is refused BY NAME.

  Refused rather than ignored deliberately: silently accepting `frozen=True`
  would hand back a class that looks immutable and is not — a silent wrong
  answer in place of today's loud one. The generated `__init__`/`__eq__`/
  `__repr__` are unconditional here, so every non-default value is refused
  until the corresponding generator can honour it.

  Only the decorator's own keywords are known; an unknown name is refused too,
  matching CPython's TypeError for it. }
procedure PyParseDataclassArgs;
var name, given: AnsiString;
    dflt: Boolean;
begin
  if CurTok.Kind <> tkLParen then Exit;
  Next;
  if CurTok.Kind = tkRParen then begin Next; Exit; end;
  repeat
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: @dataclass takes only keyword arguments');
    name := CurTok.SVal;
    { CPython's defaults, dataclasses.dataclass }
    if StrEqual(name, 'init') or StrEqual(name, 'repr') or
       StrEqual(name, 'eq') or StrEqual(name, 'match_args') then dflt := True
    else if StrEqual(name, 'order') then dflt := True   { see below — both values work }
    else if StrEqual(name, 'unsafe_hash') or
            StrEqual(name, 'frozen') or StrEqual(name, 'kw_only') or
            StrEqual(name, 'slots') or StrEqual(name, 'weakref_slot') then dflt := False
    else
      Error('Nil Python: @dataclass has no option named ''' + name + '''');
    Next;
    Expect(tkAssign, '=');
    if (CurTok.Kind <> tkTrue) and (CurTok.Kind <> tkFalse) then
      Error('Nil Python: @dataclass option ''' + name + ''' takes True or False');
    if CurTok.Kind = tkTrue then given := 'True' else given := 'False';
    { `order` is the one option whose NON-default is implemented: order=True
      generates the four comparison dunders over the field tuple, so neither
      value needs refusing. Marked by giving it dflt=True above and skipping the
      check here, rather than by a second special case in the message. }
    if StrEqual(name, 'order') then
    begin
      { accepted either way }
    end
    else if (CurTok.Kind = tkTrue) <> dflt then
      Error('Nil Python: @dataclass ' + name + '=' + given +
            ' is not supported (only the default is generated)');
    Next;
    if CurTok.Kind <> tkComma then Break;
    Next;
    { a trailing comma before `)` is legal Python }
    if CurTok.Kind = tkRParen then Break;
  until False;
  Expect(tkRParen, ')');
end;

function PySeqAppend(head, stmt: Integer): Integer; forward;
function PyLibExceptionCi: Integer; forward; { pylib's `Exception`, BY UNIT }
{ An integer literal node, for the pair-unpack indices below. }
function PyMakeIntLit(v: Int64): Integer;
begin
  Result := AllocNode(AN_INT_LIT);
  ASTIVal[Result] := v;
  ASTTk[Result] := Ord(tyInteger);
end;

{ One element of a `for a, b in pairs` loop target: `pair[idx]` through pylib's
  pyvar_getitem. An ordinary function on purpose — TPyList.at is INLINED, and an
  inline body built from here leaked its AN_INLINE_PARAM placeholder into
  lowering. }
function PyPairItem(pairNode, idx: Integer): Integer;
var argNode, idxArg, callNode: Integer;
begin
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := pairNode;
  idxArg := AllocNode(AN_ARG);
  ASTLeft[idxArg] := PyMakeIntLit(idx);
  ASTRight[idxArg] := -1;          { terminate the chain — an unset ASTRight
                                     ran the argument list into other nodes }
  ASTRight[argNode] := idxArg;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := FindProc('pyvar_getitem');
  if ASTIVal[callNode] < 0 then Error('Nil Python: pylib (pyvar_getitem) not loaded');
  ASTTk[callNode] := Ord(tyVariant);
  ASTLeft[callNode] := argNode;
  Result := callNode;
end;

function PyAnyProcWithArity(const nm: AnsiString; n: Integer): Boolean;
{ Is there ANY routine of this name that takes exactly n parameters? Used to
  keep the min/max fold from stealing a call an ordinary overload can already
  serve — pylib declares all-Variant 3- and 4-argument min/max, and a NilPy
  program is free to `def min(x, y, z)` over the builtin. Folding those would
  silently ignore a routine the programmer wrote, which is worse than the
  missing arity this whole branch exists to supply. }
var i: Integer;
begin
  PyAnyProcWithArity := False;
  for i := 0 to ProcCount - 1 do
    if (Procs[i].ParamCount = n) and CaseEqual(Procs[i].Name, nm) then
    begin
      PyAnyProcWithArity := True;
      Exit;
    end;
end;

function PyParseVariadicMinMax(const nm: AnsiString): Integer;
{ `min(a, b, c, ...)` / `max(...)` — Python takes ANY number of positional
  arguments. min/max are ordinary overloaded Pascal functions here, so an
  arity nobody wrote an overload for simply has no candidate: 3 and 4 have
  hand-written all-Variant overloads in pylib.pas, 5 did not, and adding
  fixed arities one at a time never terminates.

  Folded left-to-right through the EXISTING 2-argument overload instead —
  `min(a,b,c)` is `min(min(a,b),c)`, which is what Python computes. Each pair
  is resolved through MatchProcCall on the two operands' actual types, so the
  Int64/Double/Variant dispatch stays the already-correct 2-arg one rather
  than being re-derived here (and an int fold stays an int instead of boxing
  through the Variant arity overloads).
  feature-nilpy-min-max-variadic-more-than-two-args }
var acc, rhs, a0, a1, node, pi: Integer;
    at: array[0..1] of TTypeKind;
begin
  Next; Expect(tkLParen, '(');
  ParseArgExpr; acc := CurASTNode;
  while Eat(tkComma) do
  begin
    ParseArgExpr; rhs := CurASTNode;
    at[0] := IntToTypeKind(ASTTk[acc]); at[1] := IntToTypeKind(ASTTk[rhs]);
    pi := MatchProcCall(nm, 2, at, False);
    if pi < 0 then
      Error('Nil Python: no 2-argument ' + nm + ' for these operand types');
    a0 := AllocNode(AN_ARG); ASTLeft[a0] := acc;
    a1 := AllocNode(AN_ARG); ASTLeft[a1] := rhs; ASTRight[a1] := -1;
    ASTRight[a0] := a1;
    node := AllocNode(AN_CALL);
    ASTIVal[node] := pi;
    ASTLeft[node] := a0;
    ASTTk[node] := Ord(Procs[pi].RetType);
    acc := node;
  end;
  Expect(tkRParen, ')');
  LastExprTk := IntToTypeKind(ASTTk[acc]);
  PyParseVariadicMinMax := acc;
end;


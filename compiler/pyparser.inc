  Nothing in the day-to-day loop compiles with FPC, which is exactly why this
  rots silently — see the ticket. }
function PyBytesCi: Integer; forward;

{ Queue a setup statement to run before the current one — see PyHoistHead. }
procedure PyHoistStmt(node: Integer);
var scan: Integer;
begin
  { The SAME node queued twice makes the chain self-referential — PySeqAppend
    links the tail to it, and the tail IS it — so the flush walks forever and
    the body lowers a repeated, half-valid statement. It happens for real: the
    typing pre-pass runs several iterations and rolls ASTNodeCount back to the
    same watermark each round, so each round's hoist gets the same node id.
    Queueing a node already on the chain is never meaningful. }
  scan := PyHoistHead;
  while scan >= 0 do
  begin
    if (scan = node) or (ASTLeft[scan] = node) then Exit;
    scan := ASTRight[scan];
  end;
  PyHoistHead := PySeqAppend(PyHoistHead, node);
end;

{ Requeue a stashed hoist chain IN FRONT of whatever is pending. A header
  expression's hoisted setup (a literal build in an if/while condition) must
  flush at the ENCLOSING statement, not be stolen by the first nested suite's
  own flush — that compiled the build INSIDE the then-branch while the
  condition read the still-nil temp. }
procedure PyHoistPrepend(stash: Integer);
var tail: Integer;
begin
  if stash < 0 then Exit;
  tail := stash;
  while ASTRight[tail] >= 0 do tail := ASTRight[tail];
  ASTRight[tail] := PyHoistHead;
  PyHoistHead := stash;
end;

{ The current tail of the pending-hoist chain, or -1 when nothing is pending.
  Snapshot it before parsing a sub-expression; PyFoldHoistSince then takes back
  exactly what that sub-expression added. }
function PyHoistTail: Integer;
begin
  Result := PyHoistHead;
  if Result < 0 then Exit;
  while ASTRight[Result] >= 0 do Result := ASTRight[Result];
end;

{ Fold the hoisted setup added SINCE `savedTail` into `node`, as a right-nested
  comma chain (`h1, h2, node`) — ir.inc's AN_COMMA arm evaluates each Left for
  its effect and yields the Right.

  This is what makes a hoisting sub-expression correct inside a SHORT-CIRCUIT
  operand. A string method call hoists its setup; left where it was, that setup
  ran wherever the enclosing statement flushed — outside the loop for a `while`
  condition, and unconditionally for the right operand of an `and`. The first
  produced a stale condition (`while s.startswith("a")` tested once and then
  spun); "fixing" it by folding at the whole condition instead produced the
  second (`while j < len(s) and s[j].isdigit()` evaluated `s[j]` even when
  `j < len(s)` was False -> IndexError). Attaching each operand's setup to THAT
  operand is what satisfies both: the value is fresh, and it is only computed on
  the path that actually reaches it
  (bug-nilpy-a-method-call-in-a-while-condition-is-evaluated-once). }
function PyFoldHoistSince(savedTail, node: Integer): Integer;
var newHead, scan, n, k, cm: Integer;
    hStmts: array[0..63] of Integer;
begin
  Result := node;
  if savedTail < 0 then
  begin
    newHead := PyHoistHead;
    PyHoistHead := -1;
  end
  else
  begin
    newHead := ASTRight[savedTail];
    ASTRight[savedTail] := -1;
  end;
  if newHead < 0 then Exit;
  n := 0;
  scan := newHead;
  while (scan >= 0) and (n <= High(hStmts)) do
  begin
    if ASTLeft[scan] >= 0 then
    begin
      hStmts[n] := ASTLeft[scan];
      Inc(n);
    end;
    scan := ASTRight[scan];
  end;
  { more than the fold can hold: the remainder goes back on the pending chain
    rather than being dropped }
  if scan >= 0 then PyHoistPrepend(scan);
  for k := n - 1 downto 0 do
  begin
    cm := AllocNode(AN_COMMA);
    ASTLeft[cm] := hStmts[k];
    ASTRight[cm] := Result;
    ASTTk[cm] := ASTTk[Result];
    Result := cm;
  end;
end;

{ Prepend any hoisted setup statements to `seq`, then clear. Called by each
  statement-sequence builder right after it parses one statement, so the
  expression-comprehension setup lands before the statement that uses it. }
procedure PyQueueDefInit(node: Integer);
{ Queue one `$pdef.<proc>.<param> := <expr>` for the enclosing statement stream.
  Same duplicate guard as PyHoistStmt and for the same reason: the typing
  pre-passes re-parse the same tokens with ASTNodeCount rolled back, so a later
  round hands out the identical node id. }
var scan: Integer;
begin
  scan := PyDefInitHead;
  while scan >= 0 do
  begin
    if (scan = node) or (ASTLeft[scan] = node) then Exit;
    scan := ASTRight[scan];
  end;
  PyDefInitHead := PySeqAppend(PyDefInitHead, node);
end;

function PyFlushDefInit(seq: Integer): Integer;
var h, node: Integer;
begin
  Result := seq;
  h := PyDefInitHead;
  PyDefInitHead := -1;
  while h >= 0 do
  begin
    node := ASTLeft[h];
    if node >= 0 then Result := PySeqAppend(Result, node);
    h := ASTRight[h];
  end;
end;

function PyFlushHoist(seq: Integer): Integer;
var h, node: Integer;
begin
  Result := seq;
  h := PyHoistHead;
  PyHoistHead := -1;
  while h >= 0 do
  begin
    node := ASTLeft[h];
    if node >= 0 then Result := PySeqAppend(Result, node);
    h := ASTRight[h];
  end;
end;

function PyStarOperandAsList(node, listCi: Integer): Integer; forward;
{ PyNewContainerTemp is forward-declared in parser.inc, which is included first
  and now calls it (the leading `**d` lowering). Re-forwarding it here is an FPC
  seed error -- "Function is already declared Public/Forward" -- since FPC is
  single-pass and sees both. Same convention as PyMakeIdent / PyStarForwardCall,
  noted at the PyMakeIdent comment above. PXX prescans and tolerates the
  duplicate, so ONLY the seed build catches this. }
procedure PyContainerCall1(tmpSym: Integer; const clsName, meth: AnsiString;
                           argA, argB: Integer); forward;

{ Materialise the `from mod import NAME as ALIAS` bindings queued by
  PyParseImportRun (see PyImpAliasSym). Drains the queue, so whichever flush
  point runs first wins and a second call is a no-op.

  Deliberately NOT done where the import is parsed: the leading import run
  happens before the program's statement list exists and before ASTArenaFloor
  is set, so an AST node built there has nowhere to be appended and can be
  handed out again by the next unit compile. }
function PyFlushImportAliasesFrom(seq, base: Integer): Integer;
{ ...but only the bindings queued from `base` on. A pulled `.py` MODULE has to
  flush its OWN aliases into its OWN body, and the queue is global: the main
  program queues its leading imports first and does not flush until :32821,
  which is AFTER every unit those imports pull has been compiled. A module that
  drained the whole queue would emit the program's `ALIAS = NAME` assignments
  inside itself — the names would be the module's, not the program's, and the
  program would be left with the symbols and none of the assignments, i.e. the
  very "binds 0" this exists to prevent, moved one level up.
  So the caller records the count on entry and passes it back.
  bug-n-from-import-as-alias-binds-zero-inside-a-pulled-module }
var i, rhs, asgn: Integer;
begin
  Result := seq;
  for i := base to PyImpAliasCount - 1 do
  begin
    if PyImpAliasSrc[i] >= 0 then
      rhs := PyMakeIdent(PyImpAliasSrc[i])
    else
      { a def: the same function object `g = f` builds, via the shared helper }
      rhs := PyMakeFuncValueFor(-(PyImpAliasSrc[i]) - 1,
                                Syms[PyImpAliasSym[i]].Name);
    if rhs < 0 then Continue;
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(PyImpAliasSym[i]);
    ASTRight[asgn] := rhs;
    Result := PySeqAppend(Result, asgn);
  end;
  PyImpAliasCount := base;
end;

function PyFlushImportAliases(seq: Integer): Integer;
begin
  PyFlushImportAliases := PyFlushImportAliasesFrom(seq, 0);
end;

function PyHoistPark: Integer;
{ Take the hoist queue away and hand it back to the caller — for a TRIAL parse
  whose statements must not join the enclosing one's. parser.inc cannot touch
  PyHoistHead directly (it is declared here, and this file is included after
  it), so the parking is spelled as these three helpers.
  bug-nilpy-len-of-a-string-method-on-a-file-read-answers-zero }
begin
  Result := PyHoistHead;
  PyHoistHead := -1;
end;

procedure PyHoistRestore(saved: Integer);
{ Put a parked queue back, DROPPING whatever a trial parse queued meanwhile. }
begin
  PyHoistHead := saved;
end;

procedure PyHoistMerge(saved, trial: Integer);
{ Put `saved` back as the hoist queue and re-queue every statement of the parked
  `trial` chain after it — for a caller that parked the queue across a TRIAL
  parse (see the `len` intercept in parser.inc) and then decided to KEEP that
  parse's AST after all. Dropping the chain instead is what a caller does when it
  rewinds and re-parses. bug-nilpy-len-of-a-string-method-on-a-file-read-answers-zero }
var h: Integer;
begin
  PyHoistHead := saved;
  h := trial;
  while h >= 0 do
  begin
    PyHoistStmt(ASTLeft[h]);
    h := ASTRight[h];
  end;
end;

function PySeqAppend(head, stmt: Integer): Integer;
var tail: Integer;
begin
  Result := head;
  if stmt < 0 then Exit;
  if Result < 0 then
  begin
    Result := AllocNode(AN_SEQ);
    ASTLeft[Result] := stmt;
    ASTRight[Result] := -1;
    Exit;
  end;
  tail := Result;
  while ASTRight[tail] >= 0 do tail := ASTRight[tail];
  ASTRight[tail] := AllocNode(AN_SEQ);
  tail := ASTRight[tail];
  ASTLeft[tail] := stmt;
  ASTRight[tail] := -1;
end;

{ IsClassType with PYTHON's case sensitivity.

  FindUClass lowercases and matches case-INSENSITIVELY, which is right for
  Pascal and wrong for NilPy: a lowercase VALUE name then finds a CapWords class,
  which is the single most common naming convention in Python. `node` found
  `Node`, `item` found `Item`, and a parameter `b` found `class B` — and the
  identifier was then typed as that class, silently
  (bug-nilpy-a-local-named-like-a-class-is-typed-as-that-class, and the FIELD
  half that is still open).

  Used only where an identifier stands in VALUE position, so a genuine type
  reference keeps the existing lookup. An EXACT-case collision (a local really
  called `Item` beside `class Item`) is not addressed here — that one is a real
  shadowing question rather than a spelling accident, and it is handled at the
  return path by PyNameBoundInDef.

  bug-nilpy-identifiers-are-case-insensitive is the umbrella; this is the class
  half of it. }
function PyIsClassTypeExact(const nm: AnsiString): Boolean;
{ Is `nm` a class name spelled EXACTLY as Python would spell it? A Python name
  is case-sensitive and Pascal's class lookup is not, so this guards the flat
  namespace: a lowercase `f` must not answer for `class F`.

  Both lookups above are alias-AWARE (FindUClass and IsClassType each scan the
  class-alias registry), but the exactness test compared the CLASS's declared
  name against what the user wrote — and for an alias those are different
  strings by construction. So `from M import Node as N2` resolved N2 to the
  right class row and was then rejected as inexact, and `N2.ELEMENT_NODE` died
  as `undefined variable (N2)`: the RECEIVER, not the attribute. An alias is a
  spelling the user really wrote, so it has to satisfy the test the same way a
  declared name does.

  Compared case-SENSITIVELY, exactly as the declared-name arm is, so the
  guarantee this predicate exists for is unchanged: `f` still matches only an
  alias literally spelled `f`, never one spelled `F`.
  bug-n-a-renamed-class-loses-its-class-level-attributes }
var ci, i: Integer;
begin
  Result := False;
  if not IsClassType(nm) then Exit;
  ci := FindUClass(nm);
  if ci < 0 then Exit;
  Result := PyRawName(UClsNOff[ci], UClsNLen[ci]) = nm;
  if Result then Exit;
  for i := 0 to UClsAliasCount - 1 do
    if (UClsAliasCi[i] >= 0) and
       (PyRawName(UClsAliasNOff[i], UClsAliasNLen[i]) = nm) then
    begin
      Result := True;
      Exit;
    end;
end;

{ `Name(` is a CONSTRUCTOR only when Name matches a class EXACTLY, Python's
  own rule. FindUClassNonRecord matches case-INSENSITIVELY, so an instance
  called `parser` beside `class Parser` was construed as a construction:
  `parser(2)` built a NEW Parser and printed its pointer where CPython invokes
  `__call__` and prints 3. Silent, and `parser = Parser(...)` /
  `widget = Widget()` is how Python code is written, so the collision is the
  common case rather than a corner.

  A case-INSENSITIVE match with a different spelling can only arise between
  names that differ solely in case, which no NilPy source and no shim does — so
  requiring exactness costs nothing and is what the language says.

  Same shape as PyIsClassTypeExact above, which fixed the TYPING half of this
  family; this is the CALL half.
  bug-nilpy-calling-an-instance-named-like-its-class-runs-the-constructor }
function PyIsExactCtorName(const nm: AnsiString): Boolean;
var ci, i: Integer;
begin
  Result := False;
  ci := FindUClassNonRecord(nm);
  if ci < 0 then Exit;
  if PyRawName(UClsNOff[ci], UClsNLen[ci]) = nm then
  begin
    Result := True;
    Exit;
  end;
  { A class ALIAS is also an exact name — `from m import Box as BoxAlias`
    registers `BoxAlias` against Box's row, so the CLASS name never equals the
    spelling used. Checking only UClsName rejected every aliased constructor
    (`BoxAlias(9)` stopped compiling), which the from-import-as-alias test
    caught. Match the alias TEXT exactly, for the same reason: an alias is a
    real Python name and Python is case-sensitive about it too. }
  for i := 0 to UClsAliasCount - 1 do
    if (UClsAliasCi[i] = ci) and
       (PyRawName(UClsAliasNOff[i], UClsAliasNLen[i]) = nm) then
    begin
      Result := True;
      Exit;
    end;
end;

function PyStrDunderName(const n: AnsiString): Boolean;
{ A dunder whose contract is "returns a str": CPython raises TypeError when
  __repr__ or __str__ returns anything else, so inferring a variant for one is
  never right — and the runtime renderer only calls a dunder that reports an
  AnsiString result. See the forcing at both call sites. }
begin
  PyStrDunderName := StrEqual(n, '__repr__') or StrEqual(n, '__str__');
end;

function PyTypeFromTokenIndex(i: Integer): TTypeKind;
var lo: AnsiString;
begin
  Result := tyUnknown;
  if (i < 0) or (i >= TokCount) then Exit;
  case Tokens[i].Kind of
    { A 64-bit cell, the same width the `int` ANNOTATION gets below. It used to
      be tyInteger, and the two disagreeing is what put a 2^31 cliff on a field
      whose initialiser was a small literal: `self.v = 0` made a 4-byte field,
      so `b.v = 2147483648` came back -2147483648 and everything from 2^32 up
      came back 0, while `self.v: int = 0` was fine
      (bug-nilpy-int-promotion-decided-statically, 2026-07-31 addendum). }
    tkInteger: Result := tyInt64;
    tkFloat: Result := tyDouble;
    tkString: Result := tyString;
    tkTrue, tkFalse: Result := tyBoolean;
    tkInteger_T: Result := tyInteger;
    tkBoolean_T: Result := tyBoolean;
    tkString_T: Result := tyString;
    tkReal_T, tkSingle_T, tkDouble_T, tkExtended_T: Result := tyDouble;
    tkIdent:
    begin
      lo := LowerCase(GetTokenStr(i));
      if lo = 'int' then Result := tyInt64   { NilPy int = a 64-bit cell }
      else if lo = 'float' then Result := tyDouble
      else if lo = 'bool' then Result := tyBoolean
      else if lo = 'str' then Result := tyString
      else if PyIsClassTypeExact(GetTokenStr(i)) then Result := tyClass;
    end;
  end;
end;

(* An open brace starts a set OR a dict, and Python decides on the punctuation
   inside: comma-separated is a set, colon-separated is a dict, and an EMPTY
   pair of braces is a DICT (Python has no empty-set literal). Look for a ':'
   at bracket depth 1 relative to the opening brace at index i — depth counts
   parens, brackets and braces alike, so a ':' inside a nested call, slice or
   literal does not vote.
   Braces are spelled out in prose here on purpose: a literal brace inside a
   brace-delimited comment desyncs the self-host lexer
   (project_nested_comment_brace_selfhost_landmine). *)
function PyDictLiteralAt(i: Integer): Boolean;
var depth: Integer;
begin
  Result := False;
  if (i + 1 < TokCount) and (Tokens[i + 1].Kind = tkEnd) then
  begin
    Result := True;             (* empty braces = empty dict, not empty set *)
    Exit;
  end;
  depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkColon) then
    begin
      Result := True;
      Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkStar) and
            (i + 1 < TokCount) and (Tokens[i + 1].Kind = tkStar) then
    begin
      { `{**a, **b}` is a DICT with no colon in it at all — the spread is what
        marks it. Without this it read as a set literal and failed to parse. }
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

(* Is the bracket group opening at token index i a SLICE rather than a plain
   subscript? Same depth-1 colon scan as PyDictLiteralAt: a ':' belonging to a
   nested call, dict literal or inner slice does not vote. The lvalue subscript
   path has to know BEFORE it commits, because the default-indexed-property
   machinery consumes the bracket itself. *)
function PySliceBracketAt(i: Integer): Boolean;
var depth: Integer;
begin
  Result := False;
  depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkColon) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

(* Is CurTok the '(' of a TUPLE — a parenthesised group with a top-level
   comma — rather than a plain parenthesised expression? Only the `in` RHS
   needs to know: `x in ("a", "b")` is membership over a tuple, while `(a)` is
   just grouping. Same depth-1 scan as PyDictLiteralAt. *)
{ Index-based twin of PyTupleParenAhead, for the token scanners that work off
  an index rather than the cursor. }
function PyTupleParenAt(i: Integer): Boolean;
var depth: Integer;
begin
  Result := False;
  if (i >= TokCount) or (Tokens[i].Kind <> tkLParen) then Exit;
  depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkComma) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyTupleParenAhead: Boolean;
var i, depth: Integer; lamSkip: Boolean;
begin
  Result := False;
  if CurTok.Kind <> tkLParen then Exit;
  { `()` — the EMPTY tuple. There is no comma to find, so the depth scan below
    reached the ')' and reported "not a tuple", the '(' was taken as grouping,
    and the empty parens died with "expected expression". `(1,)` worked because
    it has a comma. Only reachable where a '(' starts a VALUE — a call's
    argument parens never come here (bug-nilpy-empty-tuple-literal-does-not-parse). }
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkRParen) then
  begin
    Result := True;
    Exit;
  end;
  { `(lambda a, b: ...)` — the commas BEFORE the lambda's `:` are its PARAMETER
    LIST, not tuple separators, and the depth-1 scan below cannot tell them
    apart: a parenthesised multi-parameter lambda was built as a TPyList and
    then, of course, was not callable
    (bug-nilpy-immediately-invoked-lambda-is-not-callable). A zero- or
    one-parameter lambda has no comma there, which is why the bug presented as a
    callability problem rather than a parsing one.

    Commas AFTER the colon are tuple separators again — `(lambda v: v + 1, 5)`
    IS a 2-tuple in CPython, since a lambda body stops at a comma inside a
    display. So the scan is not skipped, it is STARTED past the colon; a group
    that closes before any colon is not a tuple either way. }
  i := TokPos - 1;
  lamSkip := False;
  if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkIdent) and
     CaseEqual(GetTokenStr(TokPos), 'lambda') then
  begin
    depth := 0;
    while i < TokCount do
    begin
      if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
      else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then
      begin
        Dec(depth);
        if depth = 0 then Exit;
      end
      else if (depth = 1) and (Tokens[i].Kind = tkColon) then
      begin
        lamSkip := True;
        Break;
      end;
      Inc(i);
    end;
    if not lamSkip then Exit;
  end;
  { depth starts at 1 when the scan was fast-forwarded past a lambda's colon:
    the group's own '(' is behind us and must not be counted twice. }
  if lamSkip then depth := 1 else depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[i].Kind = tkComma) then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyDictLiteralAhead: Boolean;
begin
  Result := PyDictLiteralAt(TokPos - 1);   (* TokPos-1 = the opening brace *)
end;

var
  PyLastTypeCi: Integer;  { class index when PyParseType returned tyClass }
  PyAnnLastCi: Integer;   { class index when PyAnnTypeAt returned tyClass }
  { Signature proc index when PyAnnTypeAt saw a `Callable[[...], R]` — the same
    `$proctype` shape a Pascal procedural type registers, so an indirect call
    through the value marshals through the machinery that already exists
    (feature-nilpy-function-values). -1 when the annotation was not Callable. }
  PyAnnLastProcSig: Integer;
  PyCountAlias: AnsiString;  { local name bound to itertools.count ('' = none) }
  { `from sys import argv` — the bare name bound to a COMPILER-PROVIDED member.

    The consumed-only roots (sys, os, textwrap, select, itertools, typing,
    dataclasses, __future__, collections, random) publish no unit, so their
    from-import parsed the names and DROPPED them: `sys.argv` worked and a bare
    `argv` was `undefined variable`, i.e. the spelling CPython programs actually
    write was the one that did not work. What the compiler provides for these
    roots it provides through the QUALIFIED intercepts (PyIsSysStreamAhead for
    values, PyStdlibCallProc for calls), so binding the name is a matter of
    remembering which root it came from and asking those same intercepts —
    not a second table of members, which would drift from the first
    (devdocs/dev/normalise-dont-special-case.md).

    Tagged with the IMPORTING module's unit index for the reason PyImpName is:
    unit scope here is flat, and `from sys import exit` in one module must not
    bind `exit` inside another.
    bug-n-a-from-import-of-a-compiler-provided-module-binds-no-names }
  PyStdAliasName: array[0..127] of Integer;  { interned lowercase bare name IN SCOPE }
  PyStdAliasMember: array[0..127] of Integer;  { interned lowercase MEMBER name under the root }
  PyStdAliasBase: array[0..127] of Integer;  { interned lowercase DOTTED root ('sys', 'os.path') }
  PyStdAliasUnit: array[0..127] of Integer;  { CurrentUnitIdx of the importer }
  PyStdAliasCount: Integer;
  { Names a module pulled in with `from X import name`, tagged with the
    IMPORTING module's unit index. Unit scope in this compiler is flat, so a
    name another module imported is findable from everywhere — which is wrong
    for a builtin spelling: songformatter's convertrawtext.py writes `from
    settings import get, set`, and that must shadow `set` in convertrawtext
    ALONE, not inside key_analysis.py, where `set(MODE_INTERVALS[mode])` is the
    builtin. Python scopes a name to the module that imported it, so record who
    imported what and ask this table rather than the global one.
    bug-nilpy-imported-name-shadows-builtin-everywhere. }
  PyOptMissingSym: array[0..127] of Integer;  { interned names bound to None by an unresolved optional import }
  PyExprHadOptionalMissing: Boolean;  { the expression just parsed reached an unavailable module }
  PyOptMissingCount: Integer;
  PyImpName: array[0..255] of Integer;      { interned lowercase name }
  PyImpNameUnit: array[0..255] of Integer;  { CurrentUnitIdx of the importer }
  PyImpNameCount: Integer;
  { True only while parsing a def's RETURN annotation: there Optional[int] maps
    to tyVariant (None = VT_EMPTY tag) instead of the tyInt64 0-sentinel, so
    `return d.get(k)` hands back a None distinguishable from a legitimate 0
    (decide-nilpy-optional-int-none-vs-zero). FIELDS and params keep the
    0-sentinel mapping, which existing consumers (fpjson) rely on. }
  PyAnnRetScope: Boolean;
  { Set while reading a PARAMETER's annotation, exactly as PyAnnRetScope marks a
    result's. Only the `callable` branch reads it — a Callable PARAMETER becomes
    a variant so a bound method can travel through it; a Callable FIELD stays a
    bare pointer, because the field-call path (PyWrapClosureFieldCall, uforth's
    `native: Callable[[VM], None]`) reads it as a code address. }
  PyAnnParamScope: Boolean;

{ Token-index annotation parser for the richer grammar dataclass fields use:
    NAME | NAME '[' ann {',' ann} ']' | "ForwardRef" | None
  v1 mapping (uforth rung): Optional[X] -> X with nil/0 for None (an
  Optional[int] whose legit value could be 0 would alias the sentinel — noted
  in the ticket; honest variant-tagged fields come later), Callable[...] ->
  tyPointer, Any -> tyVariant, container types (List/Dict/Tuple/Set) remain a
  clean unsupported error. Advances i past the annotation. }
function PyAnnTypeAt(var i: Integer): TTypeKind; forward;

{ Is `rec` this pylib class — BY IDENTITY OR BY INHERITANCE?

  The frontend asked `rec <> REC_UCLASS_BASE + FindUClass('TPyList')` in a dozen
  places, which is an IDENTITY test standing in for a KIND question. It was
  right while nothing could descend from a pylib container; `class
  MethodDispatcher(dict)` makes it wrong, and wrong in the worst direction —
  the subclass IS a dict to the runtime (pylen_v tests `o is TPyDict`, which
  Pascal answers correctly through the chain) but the COMPILER routed it to the
  no-length arm, so `len(d)` raised "not a container" for a real dict.

  One predicate for the question, so a new pylib container or a new consumer
  cannot re-introduce the identity test by copying a neighbour.
  feature-nilpy-subclass-a-builtin-type }
{ The same question as PyRecIsCls, asked about a CLASS INDEX rather than a rec
  id — the for-in lowering and its neighbours carry ci values, not recs. }
function PyCiIsA(ci, target: Integer): Boolean;
begin
  PyCiIsA := (ci >= 0) and (target >= 0) and
             ((ci = target) or IsSubclassOf(ci, target));
end;

function PyRecIsCls(rec: Integer; const clsName: AnsiString): Boolean;
var target, ci: Integer;
begin
  Result := False;
  if rec < REC_UCLASS_BASE then Exit;
  target := FindUClass(clsName);
  if target < 0 then Exit;
  ci := rec - REC_UCLASS_BASE;
  Result := (ci = target) or IsSubclassOf(ci, target);
end;

{ Does this rec's class DECLARE `dunder` itself — i.e. is there a user override
  that a container fast-path is about to step over?

  The sibling of PyRecIsCls above, and the price of it. Widening "is this a
  container?" from identity to kind was what made len/in/slice work on a
  subclass — and it also handed those instances to the CONTAINER lowering,
  which goes straight to pylib's fetch/store/count and never asks the class
  anything. So a subclass that OVERRODE the protocol had its override called
  zero times, silently: `c[k] = v` stored, `"q" in c` answered False, both
  without ever entering the method written for them. Two mechanisms serving one
  concept — a user-class arm that consults the dunders and a container arm that
  does not — and an instance that is BOTH got whichever was tested first.

  PyRecIsPylibOwnClass, not a name list: pylib's own TPyList/TPyDict declare no
  dunders at all, so this is False for them by construction, but keying on the
  declaring UNIT says what is meant and cannot rot as pylib grows a container.
  bug-n-a-builtin-subclass-subscript-operator-skips-the-override }
function PyRecOverridesDunder(rec: Integer; const dunder: AnsiString): Boolean;
begin
  Result := False;
  if rec < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(rec) then Exit;
  Result := FindUMeth(rec - REC_UCLASS_BASE, dunder) >= 0;
end;

{ Does `obj[...]` at this '[' belong to the class's OWN __getitem__/__setitem__
  rather than to the default indexed property it INHERITS from a pylib
  container? The subscript site tests the default property first, and a
  subclass of TPyList/TPyDict inherits one — so the override was stepped over
  on both arms of every subscript.

  Asked per OPERATION, not per class: a subclass may override the read and
  leave the write to the base (html5lib's MethodDispatcher overrides
  __getitem__ only), and CPython dispatches each half independently. An
  AUGMENTED form claims the dunder path when EITHER member is declared — that
  path currently refuses `obj[k] += v` by name, and a named refusal is the
  right answer where the alternative is silently calling the base while the
  plain read calls the override. See
  bug-n-an-augmented-subscript-on-a-dunder-class-is-refused.

  Slices never reach here: PyIsSliceBase diverts them above this site, so a
  slice on a subclass keeps the container lowering. CPython would call
  __getitem__ with a slice OBJECT, which this frontend has no value for —
  recorded in devdocs/dev/nilpy-semantics-divergences.md rather than guessed at.
  bug-n-a-builtin-subclass-subscript-operator-skips-the-override }
function PySubscriptWantsDunder(mci, lbrackIdx: Integer): Boolean;
var i, w: Integer; aug: Boolean;
begin
  Result := False;
  if mci < 0 then Exit;
  if PyRecIsPylibOwnClass(REC_UCLASS_BASE + mci) then Exit;
  { the token just past the matching ']' decides read vs write }
  i := lbrackIdx; w := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkLBrack then Inc(w)
    else if Tokens[i].Kind = tkRBrack then
    begin
      Dec(w);
      if w = 0 then begin Inc(i); Break; end;
    end;
    Inc(i);
  end;
  if i >= TokCount then Exit;
  aug := (Tokens[i].Kind = tkPowEq) or (PyAugBinTok(Tokens[i].Kind) <> tkEOF);
  if aug then
    Result := (FindUMeth(mci, '__getitem__') >= 0) or
              (FindUMeth(mci, '__setitem__') >= 0)
  else if Tokens[i].Kind = tkAssign then
    Result := FindUMeth(mci, '__setitem__') >= 0
  else
    Result := FindUMeth(mci, '__getitem__') >= 0;
end;


{ ONE annotation term. PyAnnTypeAt below layers PEP 604 unions (`int | None`)
  over this, so every caller gets union support for free. }
function PyAnnTypeTermAt(var i: Integer): TTypeKind;
var lo: AnsiString; depth: Integer;
    sigN, sigPi: Integer; sigIsFunc: Boolean; sigRet: TTypeKind;
    sigPNames: array[0..15] of AnsiString;
    sigPTypes: array[0..15] of TTypeKind;
    sigPCis: array[0..15] of Integer;
begin
  Result := tyUnknown;
  PyAnnLastCi := -1;
  PyAnnLastProcSig := -1;
  if i >= MainProgramTokCount then Exit;
  if Tokens[i].Kind = tkString then
  begin
    { forward reference: "VM" }
    PyAnnLastCi := FindUClass(GetTokenStr(i));
    if PyAnnLastCi >= 0 then Result := tyClass;
    Inc(i);
    Exit;
  end;
  if Tokens[i].Kind = tkNil then begin Inc(i); Exit; end;
  if Tokens[i].Kind <> tkIdent then Exit;
  lo := LowerCase(GetTokenStr(i));
  if lo = 'int' then begin Result := tyInt64; Inc(i); Exit; end;   { 64-bit cell }
  if lo = 'float' then begin Result := tyDouble; Inc(i); Exit; end;
  if lo = 'bool' then begin Result := tyBoolean; Inc(i); Exit; end;
  if lo = 'str' then
  begin
    { NilPy strings are MANAGED (unbounded) — the same tyAnsiString locals and
      fields already use. Returning the FROZEN tyString here left `def f(s: str)`
      params frozen (255-char ceiling; and a variant arg unboxed to a managed
      handle then mismarshalled as a frozen slot -> garbage). One place, so the
      param header and the class pre-pass agree. }
    if PyProgramMode then Result := tyAnsiString else Result := tyString;
    Inc(i); Exit;
  end;
  if lo = 'any' then begin Result := tyVariant; Inc(i); Exit; end;
  { `bytes` / `bytearray` annotate the pylib TPyBytes class — the same object
    bytearray(n) returns, so an annotated parameter and an inferred local agree. }
  if (lo = 'bytes') or (lo = 'bytearray') then
  begin
    PyAnnLastCi := FindUClass('TPyBytes');
    if PyAnnLastCi >= 0 then Result := tyClass else Result := tyUnknown;
    Inc(i);
    Exit;
  end;
  if lo = 'optional' then
  begin
    Inc(i);
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      Inc(i);
      Result := PyAnnTypeAt(i);
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkRBrack) then Inc(i);
      { Optional[int]: None maps to 0 (see header note) — widen to 64-bit so
        the sentinel space is the full address range }
      if Result = tyInteger then Result := tyInt64;
      if Result = tyString then Result := tyAnsiString;
      { RETURN annotations only: an Optional[int] result is a real variant so
        None (VT_EMPTY) and a legitimate 0 stay distinct — with the 0-sentinel
        `if x is not None` took the wrong branch on a valid 0 (uforth's
        _lookup_local_slot, slot 0 read as absent). }
      if PyAnnRetScope and (Result = tyInt64) then Result := tyVariant;
      { ...and Optional[str] is a VARIANT everywhere, parameters included. A
        NilPy str that is None is a nil AnsiString handle and an EMPTY string is
        one too (bug-nilpy-empty-str-and-none-are-the-same-value), so collapsing
        Optional[str] to str let the CALL SITE convert the None into a string:
        it arrived inside the callee tagged VT_STRING, indistinguishable from
        "a", and `x is None` correctly answered False about a value that was no
        longer None. Measured with pyvartag, which is what located it — the fault
        was at the argument, not at the test.
        feature-nilpy-optional-string-param-accepts-none }
      if Result = tyAnsiString then Result := tyVariant;
    end;
    Exit;
  end;
  if lo = 'callable' then
  begin
    { `Callable[[P1, P2], R]` — the parameter list and result really are parsed
      now, into a `$proctype` signature Proc (BodyAddr = -1), exactly as a Pascal
      procedural type registers one. The bracket group used to be SKIPPED, which
      left the value an untyped pointer: it could be passed around but never
      called, since the call site had no signature to marshal against
      (feature-nilpy-function-values). }
    Inc(i);
    sigN := 0;
    sigIsFunc := False;
    sigRet := tyInteger;
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      Inc(i);
      { `Callable[..., R]` — Python's "any arguments at all". There is no arity
        to register, and registering 0 would be an ABI lie the first call with
        an argument pays for. So consume the whole subscript and report
        tyUnknown, which lands it on the same Any degrade every other unreadable
        annotation takes: the value stays dynamic and calls go the dynamic way.
        Told apart by a leading DOT — nothing else starts a Callable subscript.
        bug-n-an-uninterpretable-annotation-refuses-the-program }
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkDot) then
      begin
        depth := 1;
        while (i < MainProgramTokCount) and (depth > 0) do
        begin
          if Tokens[i].Kind = tkLBrack then Inc(depth)
          else if Tokens[i].Kind = tkRBrack then Dec(depth);
          Inc(i);
        end;
        Result := tyUnknown;
        Exit;
      end;
      { the PARAMETER list — `[P1, P2]` or `[]` }
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
      begin
        Inc(i);
        while (i < MainProgramTokCount) and (Tokens[i].Kind <> tkRBrack) do
        begin
          if sigN >= 16 then Error('Nil Python: too many Callable parameters');
          { The result is DISCARDED — every Callable parameter is registered as
            tyVariant two lines down, by the note below, because both ends of a
            function value pass variants. So refusing an unreadable parameter
            annotation gatekept a value nothing reads, and did it for the whole
            module: `Callable[[Sequence[int]], None]` walled 11 corpus files.
            PyAnnTypeAt consumes the term either way, so the loop still
            advances. bug-n-an-uninterpretable-annotation-refuses-the-program }
          PyAnnTypeAt(i);
          { Parameters follow the same function-object ABI as the result: the
            annotation is a hint, the def that arrives here decides nothing, so
            both ends pass variants (by reference, nilpy's variant convention).
            A `Callable[[str], ...]` handed a def with an unannotated (variant)
            parameter used to pass an AnsiString by value into a slot the callee
            dereferenced as a variant address. }
          sigPTypes[sigN] := tyVariant;
          sigPCis[sigN] := -1;
          sigPNames[sigN] := 'p' + PyIntLiteralText(sigN);
          Inc(sigN);
          if (i < MainProgramTokCount) and (Tokens[i].Kind = tkComma) then Inc(i);
        end;
        if (i < MainProgramTokCount) and (Tokens[i].Kind = tkRBrack) then Inc(i);
      end;
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkComma) then Inc(i);
      { the RESULT. `-> None` reads as a procedure and used to be registered as
        one — and that is an ABI LIE that crashed on RETURN. Every unannotated
        NilPy def compiles to a VARIANT-returning function, whose result travels
        through a hidden destination POINTER the callee unconditionally copies
        into on the way out. Called through a PROCEDURE-typed signature that
        register holds whatever the last call left there, so the callee's
        epilogue wrote 16 bytes to a garbage address: the call itself succeeded
        and printed, then segfaulted returning
        (bug-nilpy-call-through-a-dataclass-callable-field-segfaults; the same
        failure pyeval's TPyCallFn0..3 already declare around, for the same
        reason and with the same fix).

        So a Callable signature is ALWAYS a variant-returning function. A
        `-> None` callee simply ignores the destination, and the caller's slot
        is a zeroed local either way, so this is safe for both shapes — which is
        exactly what the note below says about the result being a HINT rather
        than an ABI. }
      sigIsFunc := True;
      sigRet := tyVariant;
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkNil) then Inc(i)
      else
      begin
        sigRet := PyAnnTypeAt(i);
        if sigRet = tyUnknown then sigRet := tyVariant
        else
          { The declared result is a HINT, not an ABI: this signature marshals
            calls to whichever def is passed in, and that def's own inference
            may well disagree (`-> list[str]` vs a body returning `d.get(k, [])`,
            which is a variant). Both ends therefore use the variant
            hidden-destination convention — see PyDefUsedAsValue. }
          sigRet := tyVariant;
      end;
      if (i < MainProgramTokCount) and (Tokens[i].Kind = tkRBrack) then Inc(i);
    end;
    sigPi := RegisterProc('$proctype', sigIsFunc, sigRet, sigN, sigPNames, sigPTypes);
    Procs[sigPi].BodyAddr := -1;
    { Record each class-typed Callable-parameter's rec id in ProcParamRecId —
      the per-param class store the call-marshalling path actually reads
      (ir.inc coerceParamSym / LastTypeRecId). RegisterProc leaves every raw
      param's Params[].SymIdx = -1 (no allocated Syms entry), so the old
      `Syms[Procs[sigPi].Params[depth].SymIdx].RecName := ...` was `Syms[-1]` —
      a latent out-of-bounds write 40 bytes before the Syms base (silent when
      it lands on padding, memory-corrupting when a layout shift puts a live
      block there) that ALSO never recorded the class (nothing reads a raw
      param's Syms RecName). }
    for depth := 0 to sigN - 1 do
      if (sigPTypes[depth] = tyClass) and (sigPCis[depth] >= 0) and
         (depth < MAX_PROC_PARAMS) then
        ProcParamRecId[sigPi * MAX_PROC_PARAMS + depth] :=
          REC_UCLASS_BASE + sigPCis[depth];
    PyAnnLastProcSig := sigPi;
    Result := tyPointer;
    { A PARAMETER travels as a VARIANT instead. A bare pointer has room for a
      code address only, so a BOUND METHOD — a {code, receiver} pair — could not
      pass through one, and `apply(C().m, 5)` raised where CPython prints 105.
      As a variant it goes through the same dynamic dispatcher an UNANNOTATED
      parameter already uses, which tells all four callable shapes apart,
      receiver included; the annotation then informs arity and diagnostics
      rather than the ABI, which is what it already does for the RESULT.

      The signature is dropped with it: keeping it would marshal the call
      against a procedural type again, which is the very thing that has no room
      for the receiver.
      bug-nilpy-bound-method-cannot-pass-through-a-callable-parameter

      A FIELD is the SAME: it used to keep the pointer+signature (guarded by
      PyAnnParamScope), which is the third representation of one concept and the
      reason a lifted closure stored into a `Callable` field landed as a 16-byte
      variant in an 8-byte slot — the indirect call then jumped through the
      variant TAG word, PC = 10 = VT_BOUNDFN_TAG.
      bug-nilpy-closure-stored-in-a-callable-field-jumps-through-the-variant-tag

      The FFI boundary is unaffected: crossing to Pascal/C as a raw function
      pointer still goes through pyvar_callable_ptr, which accepts a plain def
      and refuses a closure/bound method loudly. Variant INSIDE, plain-def-only
      at the boundary — decided 2026-08-08. }
    Result := tyVariant;
    { A PARAMETER drops the signature outright (above). A FIELD keeps it — not
      as an ABI (the slot is a variant now, so parser.inc's `tyPointer/tyRecord
      + UFldProcSig >= 0` indirect-call marshalling deliberately no longer
      fires) but as the MARKER that says "this field is callable": it is what
      lets `obj.native(vm)` resolve on a dynamically-typed receiver at
      pyparser.inc's callable-field scan. }
    if PyAnnParamScope then PyAnnLastProcSig := -1;
    Exit;
  end;
  if lo = 'list' then
  begin
    Inc(i);
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      depth := 1; Inc(i);
      while (i < MainProgramTokCount) and (depth > 0) do
      begin
        if Tokens[i].Kind = tkLBrack then Inc(depth)
        else if Tokens[i].Kind = tkRBrack then Dec(depth);
        Inc(i);
      end;
    end;
    Result := tyClass;   { TPyList; element types are dynamic (variant slots) }
    PyAnnLastCi := FindUClass('TPyList');
    Exit;
  end;
  if lo = 'dict' then
  begin
    Inc(i);
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      depth := 1; Inc(i);
      while (i < MainProgramTokCount) and (depth > 0) do
      begin
        if Tokens[i].Kind = tkLBrack then Inc(depth)
        else if Tokens[i].Kind = tkRBrack then Dec(depth);
        Inc(i);
      end;
    end;
    Result := tyClass;   { TPyDict; key and value types are dynamic (variant slots) }
    PyAnnLastCi := FindUClass('TPyDict');
    Exit;
  end;
  if lo = 'set' then
  begin
    { A set is BACKED BY TPyList — the brace literal already lowers that way,
      `in` already scans it, and TPyList.add appends only when absent, which
      is the whole set contract uforth uses (a membership guard). Not a hash
      set: same reasoning as TPyDict's linear scan. Ordering is insertion
      order rather than Python's arbitrary order, which is a DIFFERENCE, not
      a bug to chase — Python's set order is unspecified, so no correct
      program can depend on it. }
    Inc(i);
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      depth := 1; Inc(i);
      while (i < MainProgramTokCount) and (depth > 0) do
      begin
        if Tokens[i].Kind = tkLBrack then Inc(depth)
        else if Tokens[i].Kind = tkRBrack then Dec(depth);
        Inc(i);
      end;
    end;
    Result := tyClass;
    PyAnnLastCi := FindUClass('TPyList');
    Exit;
  end;
  if lo = 'tuple' then
  begin
    { A tuple annotation is TPyList, which is the representation the rest of the
      frontend ALREADY assumes: `isinstance(x, tuple)` tests TPyList (see
      PyIsInstance), and a tuple display lowers to a list. Annotations are
      erased anyway — they pick a type for inference, and TPyList is the right
      one for something indexed, iterated and unpacked.

      The DIFFERENCE from CPython, deliberate and worth stating: a tuple is
      mutable here and is not hashable, so it cannot be a dict key. A program
      that keys a dict by a tuple will fail at that use site rather than
      silently misbehave. Immutability is not modelled anywhere in NilPy yet.

      Previously this was a hard error, which rejected a whole module for an
      annotation the compiler then erases — songformatter's key_analysis.py died
      on `tuple[str, float]` after passing everything else. }
    Inc(i);
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
    begin
      depth := 1; Inc(i);
      while (i < MainProgramTokCount) and (depth > 0) do
      begin
        if Tokens[i].Kind = tkLBrack then Inc(depth)
        else if Tokens[i].Kind = tkRBrack then Dec(depth);
        Inc(i);
      end;
    end;
    Result := tyClass;
    PyAnnLastCi := FindUClass('TPyList');
    Exit;
  end;
  if IsClassType(GetTokenStr(i)) then
  begin
    Result := tyClass;
    { NonRecord, to agree with the IsClassType that just said yes — otherwise
      the predicate answers about the CLASS and the ci names the RECORD.
      bug-nilpy-text-class-name-binds-the-rtl-file-record. }
    PyAnnLastCi := FindUClassNonRecord(GetTokenStr(i));
    Inc(i);
    Exit;
  end;

  { A term this reader does not know — `type[X]`, `Sequence[X]`, `Iterable[X]`,
    and whatever the next corpus brings. CONSUME it anyway, name plus any
    balanced subscript, and still answer tyUnknown: the caller then degrades the
    parameter to Any (PyWarnUnreadAnnotation) with the token stream sitting
    where the annotation ends, which is what makes the degrade possible at all —
    leaving `[X]` behind turned "unsupported annotation" into "unexpected
    token", one line later and pointing at nothing.

    Same call the `tuple` branch above already makes, generalised: an annotation
    is erased after it picks a type, so an unreadable one costs inference, not
    the module. bug-n-an-uninterpretable-annotation-refuses-the-program }
  Inc(i);
  if (i < MainProgramTokCount) and (Tokens[i].Kind = tkLBrack) then
  begin
    depth := 1; Inc(i);
    while (i < MainProgramTokCount) and (depth > 0) do
    begin
      if Tokens[i].Kind = tkLBrack then Inc(depth)
      else if Tokens[i].Kind = tkRBrack then Dec(depth);
      Inc(i);
    end;
  end;
end;

{ PEP 604 unions: `int | None`, `str | None`, `A | B`.

  Python 3.10+ spells Optional[X] as `X | None`, and real code uses it far more
  than the typing spelling — songformatter's key_analysis.py has
  `-> int | None` and it rejected the whole module with "unexpected token".

  Annotations pick a type for inference and are then erased, so a union takes the
  first term that names a type. When one arm is None the union IS Optional, so it
  gets Optional's exact treatment (the widening below), which is what keeps
  `if x is not None` correct for a legitimate 0. A union of two real types
  (`int | str`) keeps the first: NilPy has no union type, and the alternative is
  rejecting code whose annotation it would have thrown away anyway. }
function PyAnnTypeAt(var i: Integer): TTypeKind;
var termT: TTypeKind; before, ci, sig: Integer; sawNone, first: Boolean;
begin
  Result := tyUnknown;
  ci := -1;
  sig := -1;
  sawNone := False;
  first := True;
  while True do
  begin
    before := i;
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkNil) then
      sawNone := True;
    termT := PyAnnTypeTermAt(i);
    if first or ((Result = tyUnknown) and (termT <> tyUnknown)) then
    begin
      if first or (termT <> tyUnknown) then
      begin
        Result := termT;
        ci := PyAnnLastCi;
        sig := PyAnnLastProcSig;
      end;
    end;
    first := False;
    if i = before then Inc(i);   { never spin on a term that consumed nothing }
    if (i < MainProgramTokCount) and (Tokens[i].Kind = tkPipe) then
      Inc(i)
    else
      Break;
  end;
  PyAnnLastCi := ci;
  PyAnnLastProcSig := sig;
  if sawNone then
  begin
    { same widening as Optional[...] — see the note there }
    if Result = tyInteger then Result := tyInt64;
    if Result = tyString then Result := tyAnsiString;
    if PyAnnRetScope and (Result = tyInt64) then Result := tyVariant;
  end;
end;

function PyParseType: TTypeKind;
var i: Integer;
begin
  { full annotation grammar (Optional/Callable/Any/List/forward refs) via the
    token-index parser, then resync the stream }
  i := TokPos - 1;
  Result := PyAnnTypeAt(i);
  if Result = tyUnknown then
    Error('Nil Python: expected type annotation (int, float, bool, str, Any, Optional/Callable/List[...], or a class name)');
  PyLastTypeCi := PyAnnLastCi;
  TokPos := i;
  Next;
end;

{ PyParseType, but an annotation this reader cannot interpret degrades to Any
  instead of refusing the module — the RETURN half of
  bug-n-an-uninterpretable-annotation-refuses-the-program. The METHOD twin
  (PyMethodRetType) already tolerates tyUnknown, through PyJoinRetAnnotation,
  and the note beside each of them says the two must stay in step; before this
  they did not, so `def h(...) -> Sequence[int]:` walled the module from the
  def-header side alone. }
function PyParseRetTypeOrAny: TTypeKind;
var i: Integer;
begin
  i := TokPos - 1;
  Result := PyAnnTypeAt(i);
  PyLastTypeCi := PyAnnLastCi;
  if Result = tyUnknown then
  begin
    PyWarnUnreadAnnotation('return type', Tokens[i].Line);
    Result := tyVariant;
    PyLastTypeCi := -1;
  end;
  TokPos := i;
  Next;
end;

function PyNumeric(tk: TTypeKind): Boolean;
begin
  Result := (tk = tyInteger) or (tk = tyInt64) or (tk = tySingle) or
            (tk = tyDouble) or (tk = tyExtended);
end;

function PyVariantScalar(tk: TTypeKind): Boolean;
begin
  Result := PyNumeric(tk) or (tk = tyBoolean) or (tk = tyChar) or
            (tk = tyString) or (tk = tyAnsiString);
end;

var
  PyInferName: AnsiString;  { name under type inference, for diagnostics }
  PyWidenA, PyWidenB: TTypeKind;
  PyInferLastCi: Integer;   { class index of the last tyClass inference result }
  { Did the last PyInferDefRetType actually SEE a value-bearing return? It
    returns tyInteger when it found none, which is indistinguishable from a def
    that genuinely returns an int — and the annotation join below must not
    treat "nothing to infer" as a disagreement. Reported through a global
    rather than another var parameter because the routine has several callers
    that do not care, the same shape PyInferLastCi already uses. }
  PyInferRetSeenAny: Boolean;

function PyWidenErr: AnsiString;
begin
  Result := 'Nil Python: annotate the type / too dynamic [a=' +
            AIntToStr(Ord(PyWidenA)) + ' b=' + AIntToStr(Ord(PyWidenB)) + ']';
  if PyInferName <> '' then Result := Result + ' (inferring ' + PyInferName + ')';
end;

function PyWiden(a, b: TTypeKind): TTypeKind;
begin
  PyWidenA := a; PyWidenB := b;
  if a = tyUnknown then begin Result := b; Exit; end;
  if b = tyUnknown then begin Result := a; Exit; end;
  if a = b then begin Result := a; Exit; end;
  if TypeIsPromoInt(a) or TypeIsPromoInt(b) then
  begin
    { Promotable int (a wide literal, or an expression it infected). It joins a
      VARIANT as a variant — a promo boxes into one (inline -> VT_INT64, heap ->
      VT_PROMO_INT64) — and stays PROMO among machine ints, which is what
      carries `x & 0xFFFFFFFFFFFFFFFF` through the scalar binop typing.
      Promo + float has no scalar lowering; error honestly (annotate). }
    if (a = tyVariant) or (b = tyVariant) then
      Result := tyVariant
    else if (TypeIsPromoInt(a) or (a = tyInteger) or (a = tyInt64) or (a = tyBoolean)) and
            (TypeIsPromoInt(b) or (b = tyInteger) or (b = tyInt64) or (b = tyBoolean)) then
      Result := tyPromoInt64
    else
    begin
      Error(PyWidenErr);
      Result := tyUnknown;
    end;
    Exit;
  end;
  if (a = tyVariant) or (b = tyVariant) then
  begin
    { A class (list/dict/object) boxes into a variant as VT_OBJECT — the same
      representation container slots and isinstance already use — so a local
      that is a `.get()` result (variant) one moment and a `{...}` literal
      (tyClass) the next widens to variant rather than erroring. }
    if ((a = tyVariant) or PyVariantScalar(a) or (a = tyClass)) and
       ((b = tyVariant) or PyVariantScalar(b) or (b = tyClass)) then
    begin
      Result := tyVariant;
      Exit;
    end;
    Error(PyWidenErr);
  end;
  if PyNumeric(a) and PyNumeric(b) then
  begin
    if (a = tyDouble) or (b = tyDouble) or (a = tyExtended) or (b = tyExtended) then
      Result := tyDouble
    else if (a = tyInt64) or (b = tyInt64) then
      Result := tyInt64
    else
      Result := tyInteger;
    Exit;
  end;
  { string ⊕ char (e.g. `res = res + c`) stays a string — widening to variant
    here would poison the local: a variant scalar-loaded on `return` yields
    its tag word, not the payload. }
  if ((a = tyString) or (a = tyAnsiString)) and (b = tyChar) then
  begin
    Result := a;
    Exit;
  end;
  if (a = tyChar) and ((b = tyString) or (b = tyAnsiString)) then
  begin
    Result := b;
    Exit;
  end;
  { The two string kinds are ONE Python type. A literal is born tyString and a
    concat / pystr_* result is tyAnsiString, so a local built up by `cur = cur
    + c` sees both; without this the pair fell through to the variant rule and
    the local was scalar-loaded as a tagged value.

    tyAnsiString (MANAGED) wins. tyString is the frozen, length-prefixed kind
    with a 255-character ceiling, so an inferred local silently STOPPED GROWING
    at 255 while a str FIELD — mapped to tyAnsiString explicitly — did not:
    the same expression meant two different things depending on where its
    result was stored, and only one of them was Python
    (bug-nilpy-string-local-truncates-at-255). The earlier attempt at this
    corrupted the heap through the scalar->Variant boxing bug
    (bug-a-str-boxed-into-variant-does-not-own-bytes), which is now fixed. }
  if ((a = tyString) or (a = tyAnsiString)) and
     ((b = tyString) or (b = tyAnsiString)) then
  begin
    Result := tyAnsiString;
    Exit;
  end;
  { Two kinds that share no scalar representation but both BOX: a variant holds
    either, a scalar by value and a class as VT_OBJECT — exactly what the
    class-meets-variant rule above already relies on. This is what a plain
    rebinding needs: convertrawtext.py sets `temp_file = 'tmppdf.pdf'` and then
    `temp_file = tempfile.NamedTemporaryFile(...)`, which Python allows and
    which used to be rejected as "too dynamic". }
  if (PyVariantScalar(a) or (a = tyClass)) and
     (PyVariantScalar(b) or (b = tyClass)) then
  begin
    Result := tyVariant;
    Exit;
  end;
  Error(PyWidenErr);
  Result := tyUnknown;
end;

{ The join for a NAME REBOUND across types — which is NOT the join for an
  EXPRESSION, and that distinction is the whole fix. `1 + 2.5` really is a
  float. `x = 5` then `x = 3.14` is two BINDINGS of one name, and Python renders
  each by the value it holds; widening the slot to float made the earlier
  binding print `5.0`, a wrong value in output produced by an assignment that
  had not run yet
  (bug-nilpy-int-prints-as-float-when-the-name-is-widened-later).

  A variant carries its own tag, so each binding renders as itself — the variant
  tier already does exactly this for a value out of a heterogeneous container.

  ONLY the int-meets-float pair is redirected. Everything else keeps PyWiden's
  answer: int-meets-int stays scalar so ordinary integer code boxes nothing, the
  two string kinds keep their own rule (a variant scalar-loaded on `return`
  yields its tag word), and a promotable int keeps its own join, whose
  float case is a deliberate honest error rather than a silent boxing. }
function PyWidenBinding(a, b: TTypeKind): TTypeKind;
begin
  if PyNumeric(a) and PyNumeric(b) and (a <> b) and
     (not TypeIsPromoInt(a)) and (not TypeIsPromoInt(b)) and
     (TypeIsFloat(a) <> TypeIsFloat(b)) then
    Result := tyVariant
  else
    Result := PyWiden(a, b);
end;

procedure PyInitVariantLocals(scopeBase: Integer);
var i: Integer;
begin
  for i := scopeBase to SymCount - 1 do
    if (Syms[i].Kind = skLocal) and (Syms[i].TypeKind = tyVariant) then
    begin
      EmitB($48); EmitB($C7); EmitB($85); EmitI32(Syms[i].Offset); EmitI32(0);
      EmitB($48); EmitB($C7); EmitB($85); EmitI32(Syms[i].Offset + 8); EmitI32(0);
    end;
end;

{ Nil Python boolean-expression layer: Python precedence (or < and < not <
  comparison), unlike Pascal where and/or bind tighter than comparison. The
  comparison/arithmetic atom is parsed by the shared ParseExpr, whose and/or/not
  consumption is suppressed while PyExprMode is set; parenthesised sub-expressions
  re-enter PyParseBoolExpr (see ParseFactor). Result in CurASTNode. }
{ Reject a boolean operand adjacent to a bitwise operator: Python binds
  comparisons LOOSER than & | ^ << >>, the shared ParseExpr atom binds them
  tighter, so the unparenthesized mixed case would silently change meaning.
  Explicit parens express either reading. }
procedure PyBitGuard(n: Integer);
{ Fires ONLY on a bare (unparenthesized) COMPARISON node. Keying it on the
  operand's TYPE instead — any tyBoolean at all — also rejected `a & b` on two
  real booleans, which CPython computes fine because bool is an int subclass,
  and rejected `(x > y) & (y > x)`, i.e. the exact rewrite this message asks
  for. bug-nilpy-bitwise-op-rejects-boolean-variable-operand. }
begin
  if ASTKind[n] <> AN_BINOP then Exit;
  if ASTSLen[n] = PY_BINOP_PARENED then Exit;
  case ASTIVal[n] of
    Ord(tkEq), Ord(tkNeq), Ord(tkLt), Ord(tkLe), Ord(tkGt), Ord(tkGe):
      Error('Nil Python: parenthesize the comparison next to a bitwise operator');
  end;
end;

function PyBitTk(n: Integer): TTypeKind;
{ The type a bitwise operand contributes to PyWiden. A Python bool IS an int
  (bool subclasses int), so it must widen with the integers rather than falling
  through to the box-them-both rule that yields tyVariant — a raw Boolean and a
  raw Integer typed as a variant is the pointer-arithmetic shape that
  SEGFAULTED (`True & 1`, measured). bool ⊕ bool stays Boolean, which is a real
  Pascal bitwise op and already correct.
  bug-nilpy-bitwise-op-rejects-boolean-variable-operand }
begin
  PyBitTk := IntToTypeKind(ASTTk[n]);
  if PyBitTk = tyBoolean then PyBitTk := tyInteger;
end;

function PyBitWiden(left, right: Integer): TTypeKind;
begin
  if (IntToTypeKind(ASTTk[left]) = tyBoolean) and
     (IntToTypeKind(ASTTk[right]) = tyBoolean) then
    PyBitWiden := tyBoolean
  else
    PyBitWiden := PyWiden(PyBitTk(left), PyBitTk(right));
end;

function PyBitDunder(const mname: AnsiString; left, right: Integer): Integer;
{ `obj & 1`, `obj << 2`, ... on a USER class: dispatch to the class's own
  __and__/__or__/__xor__/__lshift__/__rshift__, or -1 when the operand is not a
  user class at all (caller keeps its existing path).

  Without this the operands fell through to the generic bitwise AN_BINOP, whose
  type came out of PyWiden(tyClass, tyInteger) = tyVariant. The class HANDLE was
  then stored through the variant path, which dereferenced it as a variant
  record — so `obj & 1` did not merely compute garbage the way the arithmetic
  operators do, it SEGFAULTED (measured: exit 139, core dumped, with or without
  the dunder declared). bug-nilpy-bitwise-shift-on-class-operand-segfaults.

  When the class declares no such dunder this raises a genuine RUNTIME
  TypeError, matching CPython and keeping a try/except around the expression
  compilable — the same shape the ordering dunders use. pylib's own rows are
  excluded so set `&`/`|`/`^` and dict `|` keep their real semantics; those are
  checked by the callers before this is reached, and the guard here is
  belt-and-braces for any container this frontend grows later. }
var ci, errIdx, node: Integer;
begin
  PyBitDunder := -1;
  if IntToTypeKind(ASTTk[left]) <> tyClass then Exit;
  if ResolveNodeRec(left) < REC_UCLASS_BASE then Exit;
  if PyRecIsPylibOwnClass(ResolveNodeRec(left)) then Exit;
  ci := ResolveNodeRec(left) - REC_UCLASS_BASE;
  if FindUMeth(ci, mname) >= 0 then
  begin
    node := PyCallMeth1(ci, mname, left, right);
    if node >= 0 then begin PyBitDunder := node; Exit; end;
  end;
  errIdx := FindProc('PyNotBitOperandError');
  if errIdx < 0 then Error('Nil Python: pylib (PyNotBitOperandError) not loaded');
  node := AllocNode(AN_CALL);
  ASTIVal[node] := errIdx;
  ASTTk[node] := Ord(tyBoolean);
  ASTLeft[node] := -1;
  PyBitDunder := node;
end;

{ Names bound to None because the optional import they came from did not
  resolve. Kept so a USE of such a name can be turned into a runtime failure
  that names the module, instead of a compile error about a missing method —
  CPython compiles the same file and raises only if the code runs.
  feature-nilpy-fallback-import. }
function PyOptionalMissingNamed(const nm: AnsiString): Boolean;
var i, ni: Integer;
begin
  PyOptionalMissingNamed := False;
  if nm = '' then Exit;
  ni := InternStr(LowerCase(nm));
  for i := 0 to PyOptMissingCount - 1 do
    if PyOptMissingSym[i] = ni then begin PyOptionalMissingNamed := True; Exit; end;
end;

procedure PyNoteOptionalMissingName(const nm: AnsiString);
begin
  if PyOptionalMissingNamed(nm) then Exit;
  if PyOptMissingCount >= 128 then Exit;
  PyOptMissingSym[PyOptMissingCount] := InternStr(LowerCase(nm));
  Inc(PyOptMissingCount);
end;

{ Tracked by NAME, not by symbol index: NilPy parses a body more than once
  (the module-local pre-pass trial-parses; def bodies compile from stored token
  positions), and a fresh pass allocates fresh symbols. A name is stable. }
{ Does the ENCLOSING function assign this name AFTER the nested def being
  parsed? Python binds a closure at CALL time, so a name assigned further down
  is an ordinary capture that simply has no symbol yet at this point. The scan
  starts past the DEDENT(s) that close the nested def itself.
  bug-nilpy-closure-capture-assigned-later. }
function PyEnclosingAssigns(fromTok: Integer; const nm: AnsiString): Boolean;
var i, depth: Integer;
begin
  PyEnclosingAssigns := False;
  i := fromTok;
  while (i < MainProgramTokCount) and (Tokens[i].Kind in [tkDedent, tkNewline]) do Inc(i);
  depth := 0;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth < 0 then Exit;          { left the enclosing body }
    end
    else if (Tokens[i].Kind = tkIdent) and (i + 1 < MainProgramTokCount) and
            (Tokens[i + 1].Kind = tkAssign) and (GetTokenStr(i) = nm) then
    begin
      PyEnclosingAssigns := True;
      Exit;
    end;
    Inc(i);
  end;
end;

function PyIsOptionalMissingNode(n: Integer): Boolean;
begin
  PyIsOptionalMissingNode := False;
  if n < 0 then Exit;
  if ASTKind[n] <> AN_IDENT then Exit;
  PyIsOptionalMissingNode := PyOptionalMissingNamed(Syms[ASTIVal[n]].Name);
end;

function PyOptionalMissingName(n: Integer): AnsiString;
begin
  PyOptionalMissingName := Syms[ASTIVal[n]].Name;
end;

{ A value taken FROM an unavailable optional module is itself unavailable:
  `img = Image.open(f)` then `img.resize(...)`. Marking the target keeps the
  whole chain compiling and failing at the first call that runs. }
{ Keyed off a FLAG rather than the RHS node: the expression layers wrap a call
  (coercions, boxing), so testing the node kind missed the very case this is
  for. The flag is set wherever an unavailable-module call is built and read
  here, at the assignment that stores its result. }
procedure PyNoteOptionalTaint(symIdx, rhsNode: Integer);
begin
  if symIdx < 0 then Exit;
  if not PyExprHadOptionalMissing then Exit;
  PyNoteOptionalMissingName(Syms[symIdx].Name);
end;

{ Swallow a trailing `.name(...)` chain on an unavailable value:
  `ImageDraw.Draw(mask).rectangle(...)`. Every link is equally unavailable, so
  the whole chain collapses onto the single raise the head produced, and the
  parser lands where the statement ends. Without this the call result was
  parsed and the '.' after it had nothing to attach to. }
procedure PySkipOptionalMissingChain;
var depth: Integer;
begin
  { the head call's OWN argument list first — the dispatch site hands control
    here before those arguments have been consumed }
  if CurTok.Kind = tkLParen then
  begin
    depth := 0;
    while CurTok.Kind <> tkEOF do
    begin
      if CurTok.Kind = tkLParen then Inc(depth)
      else if CurTok.Kind = tkRParen then
      begin
        Dec(depth);
        if depth = 0 then begin Next; Break; end;
      end;
      Next;
    end;
  end;
  while (CurTok.Kind = tkDot) and (TokPos < TokCount) and
        (Tokens[TokPos].Kind = tkIdent) do
  begin
    Next;                              { '.' }
    Next;                              { member name }
    if CurTok.Kind <> tkLParen then Exit;
    depth := 0;
    while CurTok.Kind <> tkEOF do
    begin
      if CurTok.Kind = tkLParen then Inc(depth)
      else if CurTok.Kind = tkRParen then
      begin
        Dec(depth);
        if depth = 0 then begin Next; Break; end;
      end;
      Next;
    end;
  end;
end;

function PyMakeOptionalMissingCall(const what: AnsiString): Integer;
var procIdx, argNode, litNode: Integer;
begin
  procIdx := FindProc('pyoptional_missing');
  if procIdx < 0 then Error('Nil Python: pylib (pyoptional_missing) not loaded');
  litNode := AllocNode(AN_STR_LIT);
  ASTSOffset[litNode] := PyStoredName(what);
  ASTSLen[litNode] := Length(what);
  ASTTk[litNode] := Ord(tyString);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := litNode;
  ASTRight[argNode] := -1;
  PyMakeOptionalMissingCall := AllocNode(AN_CALL);
  ASTIVal[PyMakeOptionalMissingCall] := procIdx;
  ASTLeft[PyMakeOptionalMissingCall] := argNode;
  ASTTk[PyMakeOptionalMissingCall] := Ord(tyVariant);
  LastExprTk := tyVariant;
  PyExprHadOptionalMissing := True;
  PySkipOptionalMissingChain;
end;

{ isinstance(x, T) / isinstance(x, (T1, T2, ...)) — desugared to tag checks
  on variants (int also accepts bool, like CPython) and closed-world
  AN_IS_TEST class checks; a variant operand is unboxed via pylib pyvarobj.
  The operand subtree is re-emitted per OR term (pure idents in the corpus;
  a side-effecting operand would double-evaluate — b346 family, noted). }
procedure PyParseIsinstance;
var xNode, node, left, term, callN, argN, tagCall: Integer;
    isVar, hadTuple: Boolean; nm: AnsiString; ci: Integer;
    rtArg, rtArg2: Integer;   { the runtime `isinstance(x, <value>)` call }

  function TagEq(tagConst: Int64): Integer;
  var c, a, e: Integer;
  begin
    a := AllocNode(AN_ARG);
    ASTLeft[a] := xNode;
    c := AllocNode(AN_CALL);
    ASTIVal[c] := FindProc('pyvartag');
    if ASTIVal[c] < 0 then Error('Nil Python: pylib (pyvartag) not loaded');
    ASTTk[c] := Ord(tyInt64);
    ASTLeft[c] := a;
    e := AllocNode(AN_INT_LIT);
    ASTIVal[e] := tagConst;
    ASTTk[e] := Ord(tyInt64);
    Result := AllocNode(AN_BINOP);
    ASTIVal[Result] := Ord(tkEq);
    ASTLeft[Result] := c; ASTRight[Result] := e;
    ASTTk[Result] := Ord(tyBoolean);
  end;

  { `pyseq_kind_v(x) = K` — the test for list / tuple / set.

    These three share one representation (TPyList), so the class test the arm
    below uses cannot separate them: mapping both `list` and `tuple` onto
    FindUClass('TPyList') made isinstance answer True for either name whatever
    the value actually was, and a set matched both. The kind is stamped at the
    display that built the value and is what type().__name__ already reads
    (bug-nilpy-list-tuple-and-set-are-indistinguishable-to-isinstance). }
  function KindEq(k: Int64): Integer;
  var c, a, e: Integer;
  begin
    a := AllocNode(AN_ARG);
    ASTLeft[a] := xNode;
    c := AllocNode(AN_CALL);
    ASTIVal[c] := FindProc('pyseq_kind_v');
    if ASTIVal[c] < 0 then Error('Nil Python: pylib (pyseq_kind_v) not loaded');
    ASTTk[c] := Ord(tyInteger);
    ASTLeft[c] := a;
    e := AllocNode(AN_INT_LIT);
    ASTIVal[e] := k;
    ASTTk[e] := Ord(tyInteger);
    Result := AllocNode(AN_BINOP);
    ASTIVal[Result] := Ord(tkEq);
    ASTLeft[Result] := c; ASTRight[Result] := e;
    ASTTk[Result] := Ord(tyBoolean);
  end;

  { the bytes/bytearray twin of KindEq — see the isinstance arms below }
  function BytesKindEq(k: Int64): Integer;
  var c, a, e: Integer;
  begin
    a := AllocNode(AN_ARG);
    ASTLeft[a] := xNode;
    c := AllocNode(AN_CALL);
    ASTIVal[c] := FindProc('pybytes_kind_v');
    if ASTIVal[c] < 0 then Error('Nil Python: pylib (pybytes_kind_v) not loaded');
    ASTTk[c] := Ord(tyInteger);
    ASTLeft[c] := a;
    e := AllocNode(AN_INT_LIT);
    ASTIVal[e] := k;
    ASTTk[e] := Ord(tyInteger);
    Result := AllocNode(AN_BINOP);
    ASTIVal[Result] := Ord(tkEq);
    ASTLeft[Result] := c; ASTRight[Result] := e;
    ASTTk[Result] := Ord(tyBoolean);
  end;

  function OrJoin(a, b: Integer): Integer;
  begin
    if a < 0 then begin Result := b; Exit; end;
    Result := AllocNode(AN_BINOP);
    ASTIVal[Result] := Ord(tkOr);
    ASTLeft[Result] := a; ASTRight[Result] := b;
    ASTTk[Result] := Ord(tyBoolean);
  end;

begin
  Next;                     { 'isinstance' }
  Expect(tkLParen, '(');
  PyParseBoolExpr;
  xNode := CurASTNode;
  isVar := IntToTypeKind(ASTTk[xNode]) = tyVariant;
  Expect(tkComma, ',');
  left := -1;
  hadTuple := CurTok.Kind = tkLParen;
  if hadTuple then Next;                 { optional tuple of types }
  repeat
    { A second argument that is not an identifier at all — `isinstance(x, type(y))`,
      `isinstance(x, types[0])`. CPython evaluates the expression, so hand it to
      the same runtime test a type held in a NAME already uses rather than
      refusing. Only reachable now that a type is a VALUE; before that there was
      nothing an expression could have evaluated TO.
      bug-n-a-type-name-is-not-a-first-class-value }
    if CurTok.Kind <> tkIdent then
    begin
      if CurTok.Kind = tkRParen then
        Error('Nil Python: expected a type in isinstance');
      PyParseBoolExpr;
      rtArg := AllocNode(AN_ARG);
      ASTLeft[rtArg] := PyForceVariant(xNode);
      rtArg2 := AllocNode(AN_ARG);
      ASTLeft[rtArg2] := PyForceVariant(CurASTNode);
      ASTRight[rtArg] := rtArg2;
      term := AllocNode(AN_CALL);
      ASTIVal[term] := FindProc('pyisinstance_v');
      if ASTIVal[term] < 0 then Error('Nil Python: pylib (pyisinstance_v) not loaded');
      ASTTk[term] := Ord(tyBoolean);
      ASTLeft[term] := rtArg;
      left := OrJoin(left, term);
      if hadTuple and (CurTok.Kind = tkComma) then begin Next; Continue; end;
      Break;
    end;
    nm := LowerCase(CurTok.SVal);
    if nm = 'int' then
      { VT_PROMO_INT64: a heap-tier promotable int (a masked cell past 2^63)
        is still Python `int` — without this, uforth's push() normalization
        skipped exactly the values that most needed it }
      term := OrJoin(OrJoin(OrJoin(TagEq(VT_INT), TagEq(VT_INT64)), TagEq(VT_BOOL)),
                     TagEq(VT_PROMO_INT64))
    else if nm = 'float' then term := TagEq(VT_DOUBLE)
    else if nm = 'str' then term := TagEq(VT_STRING)
    else if nm = 'bool' then term := TagEq(VT_BOOL)
    { the three TPyList-backed kinds answer from the KIND, not the class }
    else if nm = 'list' then term := KindEq(PYSEQ_LIST)
    else if nm = 'tuple' then term := KindEq(PYSEQ_TUPLE)
    else if nm = 'set' then term := KindEq(PYSEQ_SET)
    else if nm = 'frozenset' then term := KindEq(PYSEQ_FROZENSET)
    { ...and the same for the two TPyBytes-backed kinds. Answering from the
      CLASS made `isinstance(bytearray(), bytes)` and `isinstance(b'', bytearray)`
      BOTH True, where CPython says False both ways: they are distinct types
      and neither derives from the other.
      bug-nilpy-bytearray-and-bytes-are-the-same-type }
    else if nm = 'bytes' then term := BytesKindEq(0)
    else if nm = 'bytearray' then term := BytesKindEq(1)
    { `isinstance(X, type)` — "is X a class?". Unlike every arm above it, that
      is not a question about the value's scalar tag or a pylib class's kind,
      so it goes to the same runtime test a type held in a NAME already uses,
      with `type` itself as the second argument. six line 43,
      `class_types = type,`. bug-n-a-type-name-is-not-a-first-class-value }
    { `isinstance(x, type(y))` — `type` FOLLOWED BY '(' is a call whose value is
      a type object, not the bare `type` builtin. Parsed as an expression by the
      non-ident arm's twin below; falling into the bare-`type` arm here consumed
      only the name and left `(y)` to blow up as "unexpected token". }
    else if (nm = 'type') and (TokPos < TokCount) and
            (Tokens[TokPos].Kind = tkLParen) then
    begin
      PyParseBoolExpr;                    { consumes `type(y)` whole }
      rtArg := AllocNode(AN_ARG);
      ASTLeft[rtArg] := PyForceVariant(xNode);
      rtArg2 := AllocNode(AN_ARG);
      ASTLeft[rtArg2] := PyForceVariant(CurASTNode);
      ASTRight[rtArg] := rtArg2;
      term := AllocNode(AN_CALL);
      ASTIVal[term] := FindProc('pyisinstance_v');
      if ASTIVal[term] < 0 then Error('Nil Python: pylib (pyisinstance_v) not loaded');
      ASTTk[term] := Ord(tyBoolean);
      ASTLeft[term] := rtArg;
      left := OrJoin(left, term);
      if hadTuple and (CurTok.Kind = tkComma) then begin Next; Continue; end;
      Break;
    end
    else if nm = 'type' then
    begin
      rtArg := AllocNode(AN_ARG);
      ASTLeft[rtArg] := PyForceVariant(xNode);
      rtArg2 := AllocNode(AN_ARG);
      ASTLeft[rtArg2] := PyMakeBuiltinTypeValue(12);   { PYBT_TYPE }
      ASTRight[rtArg] := rtArg2;
      term := AllocNode(AN_CALL);
      ASTIVal[term] := FindProc('pyisinstance_v');
      if ASTIVal[term] < 0 then Error('Nil Python: pylib (pyisinstance_v) not loaded');
      ASTTk[term] := Ord(tyBoolean);
      ASTLeft[term] := rtArg;
    end
    else
    begin
      { Python's container type NAMES map to the pylib classes that back them;
        `list` etc. are not user classes, so FindUClass alone never found them.
        `tuple` is TPyList because that is how a tuple is represented. }
      if (nm = 'list') or (nm = 'tuple') then ci := FindUClass('TPyList')
      else if nm = 'dict' then ci := FindUClass('TPyDict')
      else if (nm = 'bytes') or (nm = 'bytearray') then ci := FindUClass('TPyBytes')
      else ci := FindUClass(CurTok.SVal);
      { …and when it is not a type NAME at all, it may still be a type VALUE:
        `A = B` binds a class object, `string_types = (str,)` a tuple of them,
        and CPython accepts either. This lowering resolves the argument by name,
        so it could not see through a binding and said "unknown type" for a name
        that had just constructed an instance. Parse it as an expression and let
        the runtime decide — but only for a name that IS bound, so an actual
        typo still gets the compile-time diagnostic naming it.
        bug-n-a-type-name-is-not-a-first-class-value }
      if (ci < 0) and (FindSym(CurTok.SVal) >= 0) then
      begin
        PyParseBoolExpr;                    { consumes the name (and any suffix) }
        rtArg := AllocNode(AN_ARG);
        ASTLeft[rtArg] := PyForceVariant(xNode);
        rtArg2 := AllocNode(AN_ARG);
        ASTLeft[rtArg2] := PyForceVariant(CurASTNode);
        ASTRight[rtArg] := rtArg2;
        term := AllocNode(AN_CALL);
        ASTIVal[term] := FindProc('pyisinstance_v');
        if ASTIVal[term] < 0 then Error('Nil Python: pylib (pyisinstance_v) not loaded');
        ASTTk[term] := Ord(tyBoolean);
        ASTLeft[term] := rtArg;
        left := OrJoin(left, term);
        if hadTuple and (CurTok.Kind = tkComma) then begin Next; Continue; end;
        Break;
      end;
      if ci < 0 then Error('Nil Python: unknown type in isinstance: ' + CurTok.SVal);
      if isVar then
      begin
        { (tag == VT_OBJECT) and (pyvarobj(x) is C) }
        argN := AllocNode(AN_ARG);
        ASTLeft[argN] := xNode;
        callN := AllocNode(AN_CALL);
        ASTIVal[callN] := FindProc('pyvarobj');
        if ASTIVal[callN] < 0 then Error('Nil Python: pylib (pyvarobj) not loaded');
        ASTTk[callN] := Ord(tyPointer);
        ASTLeft[callN] := argN;
        node := AllocNode(AN_IS_TEST);
        ASTLeft[node] := callN;
        ASTIVal[node] := ci;
        ASTTk[node] := Ord(tyBoolean);
        tagCall := TagEq(VT_OBJECT);
        term := AllocNode(AN_BINOP);
        ASTIVal[term] := Ord(tkAnd);
        ASTLeft[term] := tagCall; ASTRight[term] := node;
        ASTTk[term] := Ord(tyBoolean);
      end
      else
      begin
        node := AllocNode(AN_IS_TEST);
        ASTLeft[node] := xNode;
        ASTIVal[node] := ci;
        ASTTk[node] := Ord(tyBoolean);
        term := node;
      end;
    end;
    Next;
    left := OrJoin(left, term);
  until not Eat(tkComma);
  { Close exactly what was opened. The old form treated the FIRST ')' as the
    tuple's and swallowed a following one as the call's — so a bare
    `isinstance(x, int)` whose ')' was immediately followed by another, as in
    `max(v for v in xs if isinstance(v, int))`, ate the genexpr's closer and
    the parse ran off the end of the program. }
  if hadTuple then Expect(tkRParen, ')');   { tuple close }
  Expect(tkRParen, ')');                    { call close }
  CurASTNode := left;
end;

procedure PyParseIssubclass;
{ `issubclass(D, B)` — the CLASS-to-class twin of isinstance, which was simply
  absent ("undefined variable (issubclass)").

  Both arguments are resolved as class NAMES and the answer is folded at COMPILE
  TIME by walking the parent chain, because with names it IS a compile-time
  fact: the class graph is fully known and nothing about it can change at run
  time. Reflexive, like Python — `issubclass(B, B)` is True. A tuple second
  argument is accepted, matching both Python and the isinstance arm above.

  A non-name argument (a class held in a VARIABLE) is REFUSED rather than
  guessed at. isinstance has a runtime fallback for that case
  (`pyisinstance_v`); there is no `pyissubclass_v` to call, and inventing one is
  a compiler/builtin change that would need a re-pin — so this arm stops at the
  boundary of what it can answer exactly, and says so, instead of returning a
  plausible False. Extending it is a separate, larger piece of work.
  bug-nilpy-small-builtin-surface-gaps-found-by-the-2026-08-13-sweep }
var ciA, ciB, cur, node: Integer; res, hadTuple: Boolean;
begin
  Next;                     { 'issubclass' }
  Expect(tkLParen, '(');
  if CurTok.Kind <> tkIdent then
    Error('Nil Python: issubclass() takes class NAMES; a class held in a ' +
          'variable is not supported yet');
  ciA := FindUClass(CurTok.SVal);
  if (ciA < 0) and (FindSym(CurTok.SVal) >= 0) then
    Error('Nil Python: issubclass() takes class NAMES; ' + CurTok.SVal +
          ' is a variable, and there is no runtime subclass test yet');
  if ciA < 0 then Error('Nil Python: unknown class in issubclass: ' + CurTok.SVal);
  Next;
  Expect(tkComma, ',');
  hadTuple := CurTok.Kind = tkLParen;
  if hadTuple then Next;
  res := False;
  repeat
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: issubclass() takes class NAMES; a class held in a ' +
            'variable is not supported yet');
    ciB := FindUClass(CurTok.SVal);
    if (ciB < 0) and (FindSym(CurTok.SVal) >= 0) then
      Error('Nil Python: issubclass() takes class NAMES; ' + CurTok.SVal +
            ' is a variable, and there is no runtime subclass test yet');
    if ciB < 0 then Error('Nil Python: unknown class in issubclass: ' + CurTok.SVal);
    cur := ciA;
    while cur >= 0 do
    begin
      if cur = ciB then begin res := True; Break; end;
      cur := UClsParent[cur];
    end;
    Next;
  until not Eat(tkComma);
  if hadTuple then Expect(tkRParen, ')');   { tuple close }
  Expect(tkRParen, ')');                    { call close }
  node := AllocNode(AN_BOOL_LIT);
  ASTIVal[node] := Ord(res);
  ASTTk[node] := Ord(tyBoolean);
  CurASTNode := node;
end;

{ Bitwise-not / comparison+arithmetic atom. `~` binds like a unary op. }
procedure PyParseBitOperand;
var node, castDepth: Integer;
begin
  if PyIsIdent('isinstance') and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkLParen) then
  begin
    PyParseIsinstance;
    Exit;
  end;
  if PyIsIdent('issubclass') and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkLParen) then
  begin
    PyParseIssubclass;
    Exit;
  end;
  { `NodeId = NewType("NodeId", str)` — typing's run-time alias constructor, and
    the second of the typing names that are CALLED rather than read out of an
    annotation (TypeVar is the other; it is a pylib routine because its result
    is opaque). This one's result is NOT opaque: CPython's NewType returns a
    callable whose __call__ is the identity, so `NodeId("abs")` is `"abs"` and
    an annotation naming NodeId means the supertype.

    Both fall out of evaluating to the SUPERTYPE itself: `x = str; x("ab")`
    already works (a builtin type as a value), so the alias becomes the thing it
    aliases and nothing new is modelled. The name argument is metadata — it is
    consumed and dropped, exactly as the annotation spelling of it would be.
    bug-n-typevar-call-is-an-undefined-variable }
  if PyIsIdent('NewType') and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkLParen) then
  begin
    Next;                        { NewType }
    Expect(tkLParen, '(');
    if CurTok.Kind <> tkString then
      Error('Nil Python: NewType''s first argument is the new type''s NAME, a string literal');
    Next;                        { the name — metadata, dropped }
    Expect(tkComma, ',');
    PyParseBoolExpr;             { the SUPERTYPE, and the value of the call }
    Expect(tkRParen, ')');
    Exit;
  end;
  { `cast(T, x)` — the third typing name that is CALLED rather than read out of
    an annotation, and the only one carrying real semantics: CPython's cast
    returns its SECOND argument unchanged, having done nothing with the first.
    So the value is just the expression, and the type is dropped.

    The type is SKIPPED AS TOKENS, not parsed. It is written in annotation
    language, where `cast(List[int], x)` and `cast("Node", x)` are ordinary —
    and `List` is one of the typing names the consumed-only import drops, so
    handing the first argument to the expression parser reintroduces the very
    `undefined variable` this arm exists to remove. Nothing there can be
    evaluated and nothing needs to be. bug-n-typevar-call-is-an-undefined-variable }
  if PyIsIdent('cast') and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkLParen) and not PyUserNameShadowsHere('cast') then
  begin
    Next;                        { cast }
    Expect(tkLParen, '(');
    castDepth := 0;
    while CurTok.Kind <> tkEOF do
    begin
      if CurTok.Kind in [tkLParen, tkLBrack] then Inc(castDepth)
      else if CurTok.Kind in [tkRParen, tkRBrack] then
      begin
        if castDepth = 0 then
          Error('Nil Python: cast takes two arguments, a type and a value');
        Dec(castDepth);
      end
      else if (CurTok.Kind = tkComma) and (castDepth = 0) then Break;
      Next;
    end;
    Expect(tkComma, ',');
    PyParseBoolExpr;             { the VALUE, and the value of the call }
    Expect(tkRParen, ')');
    Exit;
  end;
  if CurTok.Kind = tkLogNot then
  begin
    Next;
    PyParseBitOperand;
    { `~obj` on a user class dispatches its __invert__. Without this a tyClass
      operand fell into the integer AN_NOT below and complemented the class
      HANDLE, printing a plausible large number (measured: 123900459483161
      where CPython printed the method's result) — silent, no error.
      bug-nilpy-unary-numeric-dunders-return-raw-handle. No dunder declared is
      a genuine runtime TypeError, as with the binary bitwise operators. }
    node := PyBitDunder('__invert__', CurASTNode, -1);
    if node >= 0 then
    begin
      CurASTNode := node;
      Exit;
    end;
    PyBitGuard(CurASTNode);
    node := AllocNode(AN_NOT);
    ASTLeft[node] := CurASTNode;
    ASTTk[node] := ASTTk[CurASTNode];   { integer-typed AN_NOT = bitwise not }
    CurASTNode := node;
  end
  else
    ParseExpr;   { comparison + arithmetic atom }
end;

procedure PyParseShift;
var left, right, node: Integer; op: TTokenKind; w: TTypeKind;
begin
  PyParseBitOperand;
  left := CurASTNode;
  while (CurTok.Kind = tkShl) or (CurTok.Kind = tkShr) do
  begin
    op := CurTok.Kind;
    Next; PyParseBitOperand; right := CurASTNode;
    { a user class dispatches its own __lshift__/__rshift__ before the generic
      bitwise typing, which would otherwise widen tyClass to a variant and
      segfault -- see PyBitDunder. }
    if op = tkShl then node := PyBitDunder('__lshift__', left, right)
    else node := PyBitDunder('__rshift__', left, right);
    if node >= 0 then begin left := node; Continue; end;
    PyBitGuard(left); PyBitGuard(right);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(op);
    ASTLeft[node] := left; ASTRight[node] := right;
    { A shift of machine ints is typed PROMO: `1 << 64` must promote past
      Int64 (CPython), and Python's >> is arithmetic floor division while the
      native shr is logical — both need the promo runtime, unconditionally.
      Variant operands keep the variant typing; the variant binop routes
      shifts through the same runtime (NilPy-only op map). }
    w := PyBitWiden(left, right);
    if (w = tyInteger) or (w = tyInt64) or (w = tyBoolean) then
      w := tyPromoInt64;
    ASTTk[node] := Ord(w);
    left := node;
  end;
  CurASTNode := left;
end;

procedure PyParseBitAnd;
var left, right, node: Integer;
begin
  PyParseShift;
  left := CurASTNode;
  while CurTok.Kind = tkAmp do
  begin
    Next; PyParseShift; right := CurASTNode;
    { `a & b` on two sets is intersection, not a bitwise AND on their heap
      pointers — see pyset_and's own comment
      (bug-nilpy-set-and-dict-operators-do-raw-pointer-arithmetic). Checked
      before PyBitGuard, which has nothing useful to say about a class
      operand either way. }
    if PyNodeIsPyList(left) and PyNodeIsPyList(right) then
    begin
      node := PyMakeListBinCall('pyset_and', left, right);
      left := node;
      Continue;
    end;
    node := PyBitDunder('__and__', left, right);
    if node >= 0 then begin left := node; Continue; end;
    PyBitGuard(left); PyBitGuard(right);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkAnd);
    ASTLeft[node] := left; ASTRight[node] := right;
    ASTTk[node] := Ord(PyBitWiden(left, right));
    left := node;
  end;
  CurASTNode := left;
end;

procedure PyParseBitXor;
var left, right, node: Integer;
begin
  PyParseBitAnd;
  left := CurASTNode;
  while CurTok.Kind = tkXor do
  begin
    Next; PyParseBitAnd; right := CurASTNode;
    { `a ^ b` on two sets is symmetric difference — see pyset_xor. }
    if PyNodeIsPyList(left) and PyNodeIsPyList(right) then
    begin
      node := PyMakeListBinCall('pyset_xor', left, right);
      left := node;
      Continue;
    end;
    node := PyBitDunder('__xor__', left, right);
    if node >= 0 then begin left := node; Continue; end;
    PyBitGuard(left); PyBitGuard(right);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkXor);
    ASTLeft[node] := left; ASTRight[node] := right;
    ASTTk[node] := Ord(PyBitWiden(left, right));
    left := node;
  end;
  CurASTNode := left;
end;

procedure PyParseBitOr;
var left, right, node: Integer;
begin
  PyParseBitXor;
  left := CurASTNode;
  while CurTok.Kind = tkPipe do
  begin
    Next; PyParseBitXor; right := CurASTNode;
    { `d1 | d2` — PEP 584 dict union, checked first since dict is a distinct
      tyClass identity from set's own TPyList use of `|` (union). See
      pydict_or / pyset_or. }
    if PyNodeIsPyDict(left) and PyNodeIsPyDict(right) then
    begin
      node := PyMakeDictBinCall('pydict_or', left, right);
      left := node;
      Continue;
    end;
    if PyNodeIsPyList(left) and PyNodeIsPyList(right) then
    begin
      node := PyMakeListBinCall('pyset_or', left, right);
      left := node;
      Continue;
    end;
    node := PyBitDunder('__or__', left, right);
    if node >= 0 then begin left := node; Continue; end;
    PyBitGuard(left); PyBitGuard(right);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkOr);
    ASTLeft[node] := left; ASTRight[node] := right;
    ASTTk[node] := Ord(PyBitWiden(left, right));
    left := node;
  end;
  CurASTNode := left;
end;

{ `is` / `is not`: identity comparison. v1 lowers to pointer/scalar equality —
  correct for the None checks uforth uses (class refs and pointer fields
  compare against nil; Optional[int] fields compare against the 0 sentinel,
  consistent with that documented mapping). }
{ `pyvartag(v) = tag` (or <>), as a Boolean node. }
function PyMakeTagTest(xNode, tag: Integer; negate: Boolean): Integer;
var procIdx, argN, callN, litN: Integer;
begin
  procIdx := FindProc('pyvartag');
  if procIdx < 0 then Error('Nil Python: pylib (pyvartag) not loaded');
  argN := AllocNode(AN_ARG);
  ASTLeft[argN] := xNode;
  callN := AllocNode(AN_CALL);
  ASTIVal[callN] := procIdx;
  ASTTk[callN] := Ord(tyInt64);
  ASTLeft[callN] := argN;
  litN := AllocNode(AN_INT_LIT);
  ASTIVal[litN] := tag;
  ASTTk[litN] := Ord(tyInt64);
  Result := AllocNode(AN_BINOP);
  if negate then ASTIVal[Result] := Ord(tkNeq) else ASTIVal[Result] := Ord(tkEq);
  ASTLeft[Result] := callN;
  ASTRight[Result] := litN;
  ASTTk[Result] := Ord(tyBoolean);
end;

procedure PyParseIsCmp;
var left, right, node, i, j, ucCi, ucMmi: Integer; neg, dunderBuilt, ovrIn: Boolean; rTk: TTypeKind;
begin
  PyParseBitOr;
  left := CurASTNode;
  while PyIsIdent('is') or (CurTok.Kind = tkIn) or
        ((CurTok.Kind = tkNot) and (TokPos < TokCount) and
         (Tokens[TokPos].Kind = tkIn)) do
  begin
    if PyIsIdent('is') then
    begin
      Next;
      neg := False;
      if CurTok.Kind = tkNot then begin neg := True; Next; end;
      { `x is None` / `x is not None`. The lowering depends on the STATIC type of
        the left side — comparing a managed string or a scalar directly against a
        None variant read the wrong bytes and crashed.

        PyNoneOperandHere, NOT PyBareNoneHere: after `is`, a `None` is this
        compare's right operand whatever follows it, so the value sites' "is it
        the whole expression" test wrongly excluded `and` / `or` / `else` and
        dropped the guard to a generic binop. See PyNoneOperandHere. }
      if PyNoneOperandHere then
      begin
        Next;
        rTk := IntToTypeKind(ASTTk[left]);
        if rTk = tyVariant then
          { VARIANT: a tag test (VT_EMPTY), not a payload compare — a payload
            compare answered True for a slot holding integer 0. }
          node := PyMakeTagTest(left, 0, neg)
        else if (rTk = tyString) or (rTk = tyAnsiString) or (rTk = tyChar) then
        begin
          { STRING: a content compare against None read the wrong bytes and
            crashed. Test the managed HANDLE for nil via pystr_is_none. }
          j := AllocNode(AN_ARG); ASTLeft[j] := left; ASTRight[j] := -1;
          node := AllocNode(AN_CALL);
          ASTIVal[node] := FindProc('pystr_is_none');
          if ASTIVal[node] < 0 then Error('Nil Python: pylib (pystr_is_none) not loaded');
          ASTTk[node] := Ord(tyBoolean); ASTLeft[node] := j;
          if neg then
          begin
            i := AllocNode(AN_NOT); ASTLeft[i] := node; ASTTk[i] := Ord(tyBoolean);
            node := i;
          end;
        end
        else
        begin
          { numeric (Optional[int]'s None sentinel is 0) and object/pointer (nil
            is None) both compare the value to 0. }
          node := AllocNode(AN_BINOP);
          if neg then ASTIVal[node] := Ord(tkNeq) else ASTIVal[node] := Ord(tkEq);
          ASTLeft[node] := left;
          right := AllocNode(AN_INT_LIT); ASTIVal[right] := 0;
          if (rTk = tyClass) or (rTk = tyPointer) then ASTTk[right] := Ord(tyPointer)
          else ASTTk[right] := ASTTk[left];
          ASTRight[node] := right; ASTTk[node] := Ord(tyBoolean);
        end;
        left := node;
        Continue;
      end;
      PyParseBitOr;
      right := CurASTNode;
      node := AllocNode(AN_BINOP);
      if neg then ASTIVal[node] := Ord(tkNeq) else ASTIVal[node] := Ord(tkEq);
      ASTLeft[node] := left; ASTRight[node] := right;
      ASTTk[node] := Ord(tyBoolean);
      { `is` lowers to the same tkEq node `==` does, so the CONTENT comparisons
        ir.inc added for `==` (pylist_eq / pydict_eq) swept it along: two
        distinct lists with equal elements answered `a is c` -> True, inverting
        the one thing `is` exists for. Mark the node as an IDENTITY compare so
        those arms decline it and the pointer compare stands
        (bug-nilpy-is-on-two-lists-compares-contents). }
      ASTSLen[node] := PY_BINOP_IDENTITY;
      left := node;
    end
    else
    begin
      { [not] in — membership via pylib pycontains(list, value) }
      neg := CurTok.Kind = tkNot;
      if neg then Next;
      Expect(tkIn, 'in');
      { `x in ("a", "b")` — a TUPLE on the right. Built as the same TPyList a
        `[...]` literal produces, so membership, evaluation order and the
        container dispatch below are all shared rather than special-cased.
        A plain `(expr)` has no top-level comma and still parses as grouping. }
      if PyTupleParenAhead then
        PyParseListLiteralT(tkLParen, tkRParen, False)
      else
        PyParseBitOr;
      right := CurASTNode;
      { `x in map(f, xs)` — CPython consumes the cursor to answer, so drain it
        here and let the ordinary container dispatch below treat it as the list
        it now is. Done BEFORE that dispatch, whose user-class arm would
        otherwise call a cursor "not a container". }
      right := PyDrainIfCursor(right);
      { The container decides the helper, and getting it wrong is not a type
        error but a CRASH: pycontains would scan a TPyDict's or a string's
        header words as if they were variant slots.
          dict   -> key membership
          str    -> SUBSTRING containment, which is what `in` means in Python
          else   -> list element membership }
      dunderBuilt := False;
      { A subclass that OVERRIDES `__contains__` must reach its own method, not
        pylib's scan: `"q" in c` on a dict subclass answered False without ever
        entering the override. Computed once and applied to every container arm
        below, so the answer cannot differ between them.
        bug-n-a-builtin-subclass-subscript-operator-skips-the-override }
      ovrIn := PyRecOverridesDunder(ResolveNodeRec(right), '__contains__');
      rTk := IntToTypeKind(ASTTk[right]);
      if (rTk = tyString) or (rTk = tyAnsiString) then
        node := FindProc('pystr_contains')
      else if rTk = tyVariant then
        { container type known only at run time (a dict/list slot value) —
          unbox and dispatch inside pyvar_contains. }
        node := FindProc('pyvar_contains')
      else if (not ovrIn) and PyRecIsCls(ResolveNodeRec(right), 'TPyDict') then
        node := FindProc('pydictcontains')
      else if (not ovrIn) and PyRecIsCls(ResolveNodeRec(right), 'TPyRange') then
        { `x in range(...)` is CONSTANT time in CPython — one modulo, not a
          scan — which is the whole reason a range is worth having as a value
          rather than as a materialised list. }
        node := FindProc('pyrange_contains')
      else if (not ovrIn) and PyRecIsCls(ResolveNodeRec(right), 'TPyBytes') then
        { BYTES: a bytes subsequence or an integer byte value. Without its own
          arm this fell to pycontains below, which scans a TPyList — so it read
          a TPyBytes' header words as variant slots and answered False for every
          bytes needle (bug-nilpy-bytes-membership-always-false-for-a-bytes-needle) }
        node := FindProc('pybytes_contains')
      else if ovrIn or
              ((ResolveNodeRec(right) >= REC_UCLASS_BASE) and
               (not PyRecIsCls(ResolveNodeRec(right), 'TPyList')) and
               (not PyRecIsCls(ResolveNodeRec(right), 'TPyBytes'))) then
      begin
        { A USER class (not one of pylib's own containers): `x in obj` must
          call obj.__contains__(x) when it declares one -- the fallback below
          (pycontains, a TPyList-only scan) otherwise read the instance's raw
          bytes as if they were list-element slots, a silent wrong answer, not
          a crash (bug-nilpy-dunder-protocols-ignored-fall-back-to-handle-
          arithmetic — same failure family as that ticket's `len()` fix just
          above). No `__contains__` at all is not a container and should say
          so loudly rather than guess. }
        ucCi := ResolveNodeRec(right) - REC_UCLASS_BASE;
        ucMmi := FindUMeth(ucCi, '__contains__');
        if ucMmi >= 0 then
        begin
          right := PyCallMeth1(ucCi, PyRawName(UMthNOff[ucMmi], UMthNLen[ucMmi]), right, left);
          if right >= 0 then dunderBuilt := True
          else Error('Nil Python: "in" could not call __contains__');
        end
        else
        begin
          { A genuine RUNTIME error (a `try/except` around this must still
            compile and run its handler), not the compile-time Error() a
            first attempt used here -- that aborted the whole compilation
            instead. }
          node := FindProc('PyNotContainerError');
          if node < 0 then Error('Nil Python: pylib (PyNotContainerError) not loaded');
          right := AllocNode(AN_CALL);
          ASTIVal[right] := node;
          ASTTk[right] := Ord(tyBoolean);
          ASTLeft[right] := -1;
          dunderBuilt := True;
        end;
      end
      else
        node := FindProc('pycontains');
      if (not dunderBuilt) and (node < 0) then
        Error('Nil Python: pylib (pycontains) not loaded');
      if not dunderBuilt then
      begin
        { A tyChar value (`s[0] in ("a","b")`, a subscript yields tyChar) is boxed
          VT_CHAR, but the collection holds VT_STRING elements, so the tag never
          matched and membership was always False. In Python a char IS a 1-char
          str; promote it via pystr_ofchar so it compares as one. See the same
          receiver coercion in PyParseStrMethod. }
        if IntToTypeKind(ASTTk[left]) = tyChar then
        begin
          j := FindProc('pystr_ofchar');
          if j < 0 then Error('Nil Python: pylib (pystr_ofchar) not loaded');
          i := AllocNode(AN_ARG);
          ASTLeft[i] := left;
          left := AllocNode(AN_CALL);
          ASTIVal[left] := j;
          ASTTk[left] := Ord(tyAnsiString);
          ASTLeft[left] := i;
        end;
        i := AllocNode(AN_ARG);            { the container, arg 0 }
        ASTLeft[i] := right;
        j := AllocNode(AN_ARG);            { the value, arg 1 }
        ASTLeft[j] := left;
        ASTRight[i] := j;
        right := AllocNode(AN_CALL);
        ASTIVal[right] := node;
        ASTTk[right] := Ord(tyBoolean);
        ASTLeft[right] := i;
      end;
      if neg then
      begin
        node := AllocNode(AN_NOT);
        ASTLeft[node] := right;
        ASTTk[node] := Ord(tyBoolean);
        left := node;
      end
      else
        left := right;
    end;
  end;
  CurASTNode := left;
end;

function PyClassTruthyDunder(ci, operand: Integer): Integer;
{ Truthiness of a user-class instance via Python's own protocol, as a BOOLEAN
  node; -1 when the class declares neither dunder (caller keeps its existing
  `o <> nil` answer).

  CPython's rule, measured against the oracle rather than assumed: `__bool__`
  first, else `__len__() != 0`, else "any instance is true". pxx implemented
  only the last step, so `if c:` on a class whose `__bool__` returns False took
  the TRUTHY branch — silently, no error, just the other branch
  (bug-nilpy-bool-protocol-ignored-object-always-truthy).

  One helper for both truth contexts on purpose. `not x` (PyParseBoolNot) and
  `if x:` / and / or (PyMakeTruthy) are separate implementations of the same
  rule, and that duplication is exactly why the `not <x>` family needed three
  separate fixes (string, container, object — see
  project_nilpy_truthiness_keyed_on_handle_family). Anything added here reaches
  both. }
var lenNode, zeroNode, node: Integer;
begin
  PyClassTruthyDunder := -1;
  if ci < 0 then Exit;
  if FindUMeth(ci, '__bool__') >= 0 then
  begin
    { __bool__ already yields a Boolean; use the call as the condition. }
    PyClassTruthyDunder := PyCallMeth1(ci, '__bool__', operand, -1);
    Exit;
  end;
  if FindUMeth(ci, '__len__') >= 0 then
  begin
    lenNode := PyCallMeth1(ci, '__len__', operand, -1);
    if lenNode < 0 then Exit;
    zeroNode := AllocNode(AN_INT_LIT);
    ASTIVal[zeroNode] := 0; ASTTk[zeroNode] := Ord(tyInteger);
    node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkNeq);
    ASTLeft[node] := lenNode; ASTRight[node] := zeroNode;
    ASTTk[node] := Ord(tyBoolean);
    PyClassTruthyDunder := node;
  end;
end;

procedure PyParseBoolNot;
var node, zeroNode, operand, lenNode, argNode, truthNode: Integer; opTk: TTypeKind;
begin
  if CurTok.Kind = tkNot then
  begin
    Next;
    PyParseBoolNot;
    operand := CurASTNode;
    opTk := IntToTypeKind(ASTTk[operand]);
    { Python's `not` is TRUTHINESS, and every non-zero integer is truthy.
      AN_NOT on a non-boolean operand is Pascal's BITWISE complement — so
      `not 5` produced -6, which is non-zero and therefore printed True, and
      `not 2` in an if-condition took the wrong branch. Silently: only 0 and 1
      came out right, and 0 only by luck (-1 is also truthy).

      For an ordinal operand the answer is `operand = 0` instead. Booleans
      keep AN_NOT, where it is already logical.

      A STRING is truthy when it is non-empty, so `not s` is `Length(s) = 0`.
      Falling through to AN_NOT complemented the string HANDLE instead, which
      is never zero, so `not s` was True for every string including a
      non-empty one — silently, and `if s:` / `bool(s)` were correct all
      along, which is what hid it (bug-nilpy-not-on-string-always-true).
      A class or variant operand is still its own question and still goes
      through AN_NOT unchanged. }
    if PyIsStrBaseTk(opTk) then
    begin
      lenNode := AllocNode(AN_CALL);
      ASTIVal[lenNode] := -Ord(tkLength);
      ASTTk[lenNode] := Ord(tyInteger);
      argNode := AllocNode(AN_ARG);
      ASTLeft[argNode] := operand;
      ASTRight[argNode] := -1;
      ASTLeft[lenNode] := argNode;
      zeroNode := AllocNode(AN_INT_LIT);
      ASTIVal[zeroNode] := 0;
      ASTTk[zeroNode] := Ord(tyInteger);
      node := AllocNode(AN_BINOP);
      ASTIVal[node] := Ord(tkEq);
      ASTLeft[node] := lenNode;
      ASTRight[node] := zeroNode;
      ASTTk[node] := Ord(tyBoolean);
    end
    else if (opTk = tyClass) and (ResolveNodeRec(operand) >= REC_UCLASS_BASE) and
            PyIsPylibContainerCi(ResolveNodeRec(operand) - REC_UCLASS_BASE) then
    begin
      { A LIST / DICT / bytes is truthy when NON-EMPTY (Python), so `not xs` is
        `len(xs) = 0` — via .count. Falling through to AN_NOT complemented the
        object HANDLE (never nil), so `not xs` was True for every container
        including a non-empty one (bug-nilpy-not-on-container-always-true, the
        `if not tokens:` in uforth's interpret loop broke on real tokens). }
      lenNode := PyCallMeth1(ResolveNodeRec(operand) - REC_UCLASS_BASE, 'count', operand, -1);
      if lenNode < 0 then Error('Nil Python: pylib container .count not loaded');
      zeroNode := AllocNode(AN_INT_LIT);
      ASTIVal[zeroNode] := 0;
      ASTTk[zeroNode] := Ord(tyInteger);
      node := AllocNode(AN_BINOP);
      ASTIVal[node] := Ord(tkEq);
      ASTLeft[node] := lenNode;
      ASTRight[node] := zeroNode;
      ASTTk[node] := Ord(tyBoolean);
    end
    else if opTk = tyClass then
    begin
      { Any OTHER object (a user class, an re match object — anything that is
        not a pylib container handled above). Python: an instance is truthy
        unless it is None, so `not o` is `o = nil`. AN_NOT here complemented
        the object HANDLE, which is never nil, so `not o` was True for every
        live object — the same shape as the string and container cases above,
        and just as silent: `if o:` was right all along.

        This is what made songformatter's key analysis return wrong keys.
        `_quality_bucket` opens with `if not match: return None, "unknown"`
        over an `re.match` result, so EVERY chord came back unclassified, every
        key scored identically, and the detector ranked ALL_KEYS in insertion
        order. No crash, no diagnostic — just plausible wrong answers.
        [[bug-nilpy-not-on-object-always-true]]

        `o = nil` is only CPython's answer for a class declaring NEITHER
        `__bool__` nor `__len__`; when one is declared it decides. Try that
        first and fall back to the pointer test
        (bug-nilpy-bool-protocol-ignored-object-always-truthy). }
      truthNode := -1;
      if ResolveNodeRec(operand) >= REC_UCLASS_BASE then
        truthNode := PyClassTruthyDunder(ResolveNodeRec(operand) - REC_UCLASS_BASE, operand);
      if truthNode >= 0 then
      begin
        { the dunder gives TRUTHY; `not` is its logical negation. AN_NOT on a
          tyBoolean operand is logical here, per this routine's own note. }
        node := AllocNode(AN_NOT);
        ASTLeft[node] := truthNode;
        ASTTk[node] := Ord(tyBoolean);
        CurASTNode := node;
        Exit;
      end;
      zeroNode := AllocNode(AN_INT_LIT);
      ASTIVal[zeroNode] := 0;
      ASTTk[zeroNode] := Ord(tyPointer);
      node := AllocNode(AN_BINOP);
      ASTIVal[node] := Ord(tkEq);
      ASTLeft[node] := operand;
      ASTRight[node] := zeroNode;
      ASTTk[node] := Ord(tyBoolean);
    end
    else if (opTk = tyBoolean) or not PyNumeric(opTk) then
    begin
      node := AllocNode(AN_NOT);
      ASTLeft[node] := operand;
      ASTTk[node] := Ord(tyBoolean);
    end
    else
    begin
      zeroNode := AllocNode(AN_INT_LIT);
      ASTIVal[zeroNode] := 0;
      ASTTk[zeroNode] := Ord(opTk);
      node := AllocNode(AN_BINOP);
      ASTIVal[node] := Ord(tkEq);
      ASTLeft[node] := operand;
      ASTRight[node] := zeroNode;
      ASTTk[node] := Ord(tyBoolean);
    end;
    CurASTNode := node;
  end
  else
    PyParseIsCmp;   { is/is-not over the bitwise chain over ParseExpr }
end;

{ An INTEGER-ish kind: the arms of a value-returning or/and unify onto Int64. }
function PyIsIntLikeTk(tk: TTypeKind): Boolean;
begin
  Result := tk in [tyInteger, tyInt8, tyUInt8, tyInt16, tyUInt16, tyInt32,
                   tyUInt32, tyInt64, tyUInt64, tyNativeInt, tyNativeUInt];
end;

function PyBoolOpReturnsOperand(a, b: Integer): Boolean; forward;
function PyMakeBoolOpValue(a, b: Integer; isOr: Boolean): Integer; forward;
procedure PyParseBoolAnd;
var left, right, node, hSave: Integer;
begin
  PyParseBoolNot;
  left := CurASTNode;
  while CurTok.Kind = tkAnd do
  begin
    Next;
    { the RIGHT operand's own hoisted setup belongs to that operand, so it runs
      only when short-circuit actually reaches it — see PyFoldHoistSince }
    hSave := PyHoistTail;
    if PyBareNoneHere then          { `x and None` — see the or-path note }
    begin
      Next;
      right := PyMakeNone;
    end
    else
    begin
      PyParseBoolNot;
      right := CurASTNode;
    end;
    right := PyFoldHoistSince(hSave, right);
    if PyBoolOpReturnsOperand(left, right) then
      node := PyMakeBoolOpValue(left, right, False)
    else
    begin
      node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkAnd);
      ASTLeft[node] := PyMakeTruthy(left); ASTRight[node] := PyMakeTruthy(right);
      ASTTk[node] := Ord(tyBoolean);
    end;
    left := node;
  end;
  CurASTNode := left;
end;

{ A truthiness condition for `n` in an `if`/`while` context. Python truthiness is
  type-directed, but a raw NilPy condition tests the storage cell:
    - a VARIANT tests its tag word, so `if v:` was true for every variant
      including one holding 0 — route it through pylib bool().
    - a LIST / DICT / bytes is a class HANDLE (never nil), so `if xs:` was true
      for every container including an empty one — test `len(xs) <> 0` via .count
      (bug-nilpy-if-on-container-always-true; uforth's `and self.include_stack`
      indexed [-1] on an empty list because the guard never went false).
  Ordinals and strings already test correctly (0 / empty are falsy natively), so
  they pass through unchanged. }
{ Unbox a VARIANT value to a class instance pointer: pyvarobj(v) -> the payload
  pointer, hard-cast to class ci. Used when a variant (e.g. a dict/list element,
  dynamically typed) is stored into a tyClass slot — a field or class-typed local.
  Without it the raw 16-byte variant is written into an 8-byte class slot and the
  reader sees garbage (a class object round-tripped through a dict, then assigned
  back to `self.field`, lost its identity and read empty fields — uforth's INCLUDE
  input-source restore across nested files). }
function PyUnboxVariantToClassEx(varNode, ci: Integer; owned: Boolean): Integer;
var unboxArg, unboxCall, castNode: Integer;
    fn: AnsiString;
begin
  unboxArg := AllocNode(AN_ARG); ASTLeft[unboxArg] := varNode; ASTRight[unboxArg] := -1;
  unboxCall := AllocNode(AN_CALL);
  if owned then fn := 'pyvarobj_owned' else fn := 'pyvarobj';
  ASTIVal[unboxCall] := FindProc(fn);
  if ASTIVal[unboxCall] < 0 then Error('Nil Python: pylib (' + fn + ') not loaded');
  ASTTk[unboxCall] := Ord(tyPointer);
  ASTLeft[unboxCall] := unboxArg;
  castNode := AllocNode(AN_CLASS_CAST);
  ASTLeft[castNode] := unboxCall;
  ASTIVal[castNode] := ci;
  ASTTk[castNode]   := Ord(tyClass);
  Result := castNode;
end;

{ `raise ValueError` — the bare CLASS, which CPython instantiates for you
  (`raise C` IS `raise C()`). Answers the class index when the name at the
  cursor is an exception class and NOT a variable, else -1.

  Both halves matter. A NAME that is a variable wins — `raise e` on a local
  holding an instance is the common shape and must not be re-constructed. And
  the class must derive from Exception: `raise SomeOrdinaryClass` is CPython's
  TypeError, and constructing it to find that out would run its ctor's side
  effects first, so it stays on the old path where pyraise_check answers.
  bug-nilpy-raise-of-a-bare-exception-class-is-refused-at-runtime }
function PyRaiseBareClassCi(const nm: AnsiString): Integer;
var g: Integer;
begin
  Result := -1;
  if FindSym(nm) >= 0 then Exit;
  if CaseEqual(nm, 'Exception') then Result := PyEnsureExceptionClass
  else Result := FindUClassNonRecord(nm);
  if Result < 0 then Exit;
  if PyLibExceptionCi < 0 then begin Result := -1; Exit; end;
  g := Result;
  while g >= 0 do
  begin
    if g = PyLibExceptionCi then Exit;
    g := UClsParent[g];
  end;
  Result := -1;
end;

{ Wrap a variant in pylib's pyraise_check — the value passes through, a
  non-object tag raises TypeError. Kept a separate node so the unbox below sees
  an ordinary variant expression. }
function PyRaiseCheckVariant(varNode: Integer): Integer;
var argN, callN, pi: Integer;
begin
  pi := FindProc('pyraise_check');
  if pi < 0 then begin Result := varNode; Exit; end;
  argN := AllocNode(AN_ARG); ASTLeft[argN] := varNode; ASTRight[argN] := -1;
  callN := AllocNode(AN_CALL);
  ASTIVal[callN] := pi;
  ASTTk[callN] := Ord(tyVariant);
  ASTLeft[callN] := argN;
  Result := callN;
end;

function PyUnboxVariantToClass(varNode, ci: Integer): Integer;
begin
  Result := PyUnboxVariantToClassEx(varNode, ci, False);
end;


function PyMakeTruthy(n: Integer): Integer;
var procIdx, argNode, rec, lenNode, zeroNode, node: Integer;
    nilNode, guardNode, falseNode, pairNode, ternNode: Integer;
begin
  Result := n;
  { An ARBITRARY-PRECISION int tests against ZERO explicitly. Its rvalue IS the
    slot address (decide-promoint-rvalue-representation), which is never nil —
    so used raw as a condition every promo was TRUTHY, including 0: `x = i - 5`
    with i=5 took the true arm. `bool(x)` was worse than wrong, it crashed,
    because the fallback in ParseFactor built its zero literal with the promo's
    own type kind.

    `<> 0` against a plain Int64 literal is the shape the promo COMPARISON path
    already lowers correctly (it is the same node an explicit `x != 0` builds),
    so this needs no new runtime entry point — and unlike narrowing through
    PXXPromoToInt64Wrap it cannot call a value that wraps to exactly 0 falsy. }
  if TypeIsPromoInt(IntToTypeKind(ASTTk[n])) then
  begin
    zeroNode := AllocNode(AN_INT_LIT);
    ASTIVal[zeroNode] := 0;
    ASTTk[zeroNode] := Ord(tyInt64);
    node := AllocNode(AN_BINOP);
    ASTIVal[node] := Ord(tkNeq);
    ASTLeft[node] := n;
    ASTRight[node] := zeroNode;
    ASTTk[node] := Ord(tyBoolean);
    Result := node;
    Exit;
  end;
  { A STRING tests EMPTY, explicitly: a string cell used as a raw condition is a
    pointer, and an empty literal's pointer is not nil, so `"" or x` took the
    empty arm. `Length(s) <> 0` is the same shape `not s` already uses
    (bug-nilpy-not-on-string-always-true — this is that bug on the truthy side). }
  if PyIsStrBaseTk(IntToTypeKind(ASTTk[n])) then
  begin
    lenNode := AllocNode(AN_CALL);
    ASTIVal[lenNode] := -Ord(tkLength);
    ASTTk[lenNode] := Ord(tyInteger);
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := n;
    ASTRight[argNode] := -1;
    ASTLeft[lenNode] := argNode;
    zeroNode := AllocNode(AN_INT_LIT);
    ASTIVal[zeroNode] := 0;
    ASTTk[zeroNode] := Ord(tyInteger);
    node := AllocNode(AN_BINOP);
    ASTIVal[node] := Ord(tkNeq);
    ASTLeft[node] := lenNode;
    ASTRight[node] := zeroNode;
    ASTTk[node] := Ord(tyBoolean);
    Result := node;
    Exit;
  end;
  if IntToTypeKind(ASTTk[n]) = tyVariant then
  begin
    procIdx := FindProc('bool');
    if procIdx < 0 then Exit;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := n; ASTRight[argNode] := -1;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := procIdx;
    ASTTk[Result] := Ord(tyBoolean);
    ASTLeft[Result] := argNode;
    Exit;
  end;
  if IntToTypeKind(ASTTk[n]) = tyClass then
  begin
    rec := ResolveNodeRec(n);
    if (rec >= REC_UCLASS_BASE) and PyIsPylibContainerCi(rec - REC_UCLASS_BASE) then
    begin
      lenNode := PyCallMeth1(rec - REC_UCLASS_BASE, 'count', n, -1);
      if lenNode < 0 then Exit;
      zeroNode := AllocNode(AN_INT_LIT);
      ASTIVal[zeroNode] := 0; ASTTk[zeroNode] := Ord(tyInteger);
      node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkNeq);
      ASTLeft[node] := lenNode; ASTRight[node] := zeroNode;
      ASTTk[node] := Ord(tyBoolean);
      { A container field/var typed Optional[List]/List can be None (a nil class
        pointer). count() would deref nil and SIGSEGV, so guard: nil -> falsy
        without calling count. `(n <> nil) ? (count<>0) : false`. n is a
        field/var read here (no side effect), so evaluating it twice is safe.
        (bug: `if w.forth_body:` in uforth's inner interpreter crashed on native
        words whose forth_body is None.) }
      nilNode := AllocNode(AN_INT_LIT);
      ASTIVal[nilNode] := 0; ASTTk[nilNode] := Ord(tyPointer);
      guardNode := AllocNode(AN_BINOP); ASTIVal[guardNode] := Ord(tkNeq);
      ASTLeft[guardNode] := n; ASTRight[guardNode] := nilNode;
      ASTTk[guardNode] := Ord(tyBoolean);
      falseNode := AllocNode(AN_INT_LIT);
      ASTIVal[falseNode] := 0; ASTTk[falseNode] := Ord(tyBoolean);
      pairNode := AllocNode(AN_PAIR);
      ASTLeft[pairNode] := node; ASTRight[pairNode] := falseNode;
      ternNode := AllocNode(AN_TERNARY);
      ASTLeft[ternNode] := guardNode; ASTRight[ternNode] := pairNode;
      ASTTk[ternNode] := Ord(tyBoolean);
      Result := ternNode;
    end
    else if rec >= REC_UCLASS_BASE then
    begin
      { A USER class: Python asks `__bool__`, then `__len__() != 0`, before
        falling back to "any instance is true". Without this the raw handle was
        the condition, so an object whose `__bool__` returns False took the
        TRUTHY branch of an `if` — silent, and the wrong branch rather than a
        wrong value (bug-nilpy-bool-protocol-ignored-object-always-truthy).
        Shared with `not x` via PyClassTruthyDunder so the two truth contexts
        cannot drift apart again. }
      node := PyClassTruthyDunder(rec - REC_UCLASS_BASE, n);
      if node >= 0 then Result := node;
    end;
  end;
end;

{ True when `a or b` / `a and b` must return an OPERAND (Python semantics) rather
  than a Boolean — i.e. it is a VALUE, not pure control flow. Triggered when an
  operand is a variant or a class (a container/object); pure ordinal/boolean
  operands keep the cheap boolean form, which every condition context uses. }
{ Python's `or`/`and` yield an OPERAND, not a bool — `name = given or "default"`
  is the ubiquitous default-value idiom, and songformatter writes it constantly
  (`match.group(2) or ""`, `document.get("file_path") or None`). So operand
  semantics apply whenever either side is anything but a Boolean; two Booleans
  keep the plain boolean lowering, where the two readings agree anyway and the
  cheaper one is worth having. In a CONDITION the difference is invisible: the
  `if`/`while` path wraps the result in the same truthiness test either way. }
function PyBoolOpReturnsOperand(a, b: Integer): Boolean;
var ta, tb: TTypeKind;
begin
  ta := IntToTypeKind(ASTTk[a]); tb := IntToTypeKind(ASTTk[b]);
  { ...but only when the two arms have a type the RESULT can carry: a variant or
    class arm (which boxes anything), two strings, or two of the same kind.
    MIXED kinds — `self.f and word.upper() != self.f`, a string and a Boolean —
    keep the boolean lowering, because typing that ternary as either arm's type
    reinterprets the other one (a Boolean read as a string pointer SEGFAULTS,
    which is how this rule was found). The operands are truthiness-tested there,
    so an empty string is still falsy; what is lost is only the VALUE identity of
    a mixed-type `or`, and that shape does not occur outside a condition.

    A str-vs-NUMBER pair (int or float, NOT Boolean) is admitted separately
    below: `name = given or "default"` is the ordinary Python default-value
    idiom, and it mixes a str with whatever `given` actually is whenever that
    is not itself a str — `0 or "x"`, `"" or 5` — which is exactly this shape
    OUTSIDE a condition, falsifying the "does not occur" premise above
    (bug-nilpy-mixed-type-and-or-returns-a-bool-not-the-operand).
    PyMakeBoolOpValue's own type decision already has a `tyVariant` fallback
    for a genuinely mixed pair (boxing each arm rather than reinterpreting
    it), which is what makes this safe now in a way the original comment's
    "typing the ternary as either arm's type" concern does not apply to —
    the ternary is typed VARIANT, not str or int, so neither arm is read
    through the other's representation.

    BOOLEAN pairs are admitted too, as of 2026-08-02. They were held back on
    the grounds that a str-vs-Boolean pair is the original segfault repro —
    but that repro is precisely the "type the ternary as one arm and read the
    other through it" hazard, and the tyVariant fallback is what removed it;
    the same argument that admits str-vs-number admits str-vs-Boolean. Without
    them `True and 0` gave False, `True and "s"` and `False or "s"` gave True,
    and a plain `flag and value` — a very ordinary Python line — returned a
    Boolean instead of the value. Measured against CPython, including the
    original repro shape (a str/Boolean pair used AS A CONDITION), which is
    unchanged because a condition only truthiness-tests the result. }
  Result := (ta = tyVariant) or (tb = tyVariant) or (ta = tyClass) or (tb = tyClass)
            or (PyIsStrBaseTk(ta) and PyIsStrBaseTk(tb))
            or (PyIsIntLikeTk(ta) and PyIsIntLikeTk(tb))
            or (PyIsStrBaseTk(ta) and (PyIsIntLikeTk(tb) or TypeIsFloat(tb) or (tb = tyBoolean)))
            or (PyIsStrBaseTk(tb) and (PyIsIntLikeTk(ta) or TypeIsFloat(ta) or (ta = tyBoolean)))
            or ((ta = tyBoolean) and (PyIsIntLikeTk(tb) or TypeIsFloat(tb)))
            or ((tb = tyBoolean) and (PyIsIntLikeTk(ta) or TypeIsFloat(ta)))
            or (ta = tb);
end;

{ Can a local temp of this kind hold the left operand? Excludes the frozen
  `tyString` (inline [N] storage, no handle slot — the ternary lowering has the
  same carve-out) and anything the frontend has not typed yet. }
function PyBoolOpBindableTk(tk: TTypeKind): Boolean;
begin
  Result := (tk = tyVariant) or (tk = tyClass) or (tk = tyAnsiString) or
            (tk = tyBoolean) or PyIsIntLikeTk(tk) or TypeIsFloat(tk);
end;

{ Is re-evaluating this node free? Only for leaves. Anything else — a call, an
  attribute read (a dict lookup or a property), a subscript (`__getitem__`) — is
  bound to a temp first. }
function PyBoolOpNeedsBind(n: Integer): Boolean;
begin
  Result := True;
  if n < 0 then begin Result := False; Exit; end;
  if (ASTKind[n] = AN_IDENT) or (ASTKind[n] = AN_INT_LIT) or
     (ASTKind[n] = AN_STR_LIT) or (ASTKind[n] = AN_BOOL_LIT) or
     (ASTKind[n] = AN_FLOAT_LIT) then
    Result := False;
end;

{ `a or b` as a value -> `a if truthy(a) else b`; `a and b` -> `b if truthy(a)
  else a`. Lowered to AN_TERNARY so ONLY the selected arm evaluates — Python
  short-circuit.

  `a` is referenced TWICE by that shape (once inside the condition, once as an
  arm) and the AST is a TREE, so a node referenced twice is EMITTED twice:
  `bump() and 5` called bump() twice — silent duplicated side effects, nothing
  wrong printed (bug-nilpy-and-or-evaluates-the-left-operand-twice). So a
  non-leaf `a` is bound to a hidden temp first and both references read the temp.

  The binding is carried in the LEFT arm of an AN_COMMA that IS the condition,
  NOT hoisted to statement level the way PyEvalOnce binds: the ternary lowers its
  condition where the ternary sits, so the store lands inside whatever
  conditional region encloses it. A statement-level hoist would leak the side
  effect OUT of that region — in `x = a and (b() or c())` it would run `b()` even
  when `a` is falsy, trading this bug for a worse one.

  A prior version used an eager pylib call (pyand_v/pyor_v) to get clean variant
  boxing, but that evaluated BOTH operands and so lost short-circuit — the common
  `if xs and xs[0]:` / `if tokens and tokens[-1]...:` guard then indexed an empty
  container and crashed (bug-nilpy-and-or-not-short-circuit). The ternary keeps
  short-circuit; class/variant-valued ternary arms are already handled (see the
  conditional-expression lowering below). }
function PyMakeBoolOpValue(a, b: Integer; isOr: Boolean): Integer;
var condNode, thenNode, elseNode, pairNode, node: Integer;
    ta, tb: TTypeKind;
    aSym, aUse, asgn, comma: Integer;
begin
  ta := IntToTypeKind(ASTTk[a]);
  aUse := a;
  if PyBoolOpNeedsBind(a) and PyBoolOpBindableTk(ta) then
  begin
    aSym := AllocVar(PyHiddenName('boolop'), ta);
    Syms[aSym].RecName := ResolveNodeRec(a);
    SymSyncTypeRef(aSym);
    asgn := AllocNode(AN_ASSIGN);
    ASTLeft[asgn] := PyMakeIdent(aSym);
    ASTRight[asgn] := a;
    aUse := PyMakeIdent(aSym);
    comma := AllocNode(AN_COMMA);
    ASTLeft[comma] := asgn;
    ASTRight[comma] := PyMakeTruthy(PyMakeIdent(aSym));
    ASTTk[comma] := ASTTk[ASTRight[comma]];
    condNode := comma;
  end
  else
    condNode := PyMakeTruthy(a);
  if isOr then begin thenNode := aUse; elseNode := b; end
  else begin thenNode := b; elseNode := aUse; end;
  pairNode := AllocNode(AN_PAIR);
  ASTLeft[pairNode] := thenNode;
  ASTRight[pairNode] := elseNode;
  node := AllocNode(AN_TERNARY);
  ASTLeft[node] := condNode;
  ASTRight[node] := pairNode;
  ta := IntToTypeKind(ASTTk[a]); tb := IntToTypeKind(ASTTk[b]);
  { BOTH arms, not either — this used to fire whenever ONE side was a str and
    typed the WHOLE result AnsiString even when the other side was a plain
    scalar (int/float), so `1 or "x"` stored a raw integer into a slot the
    rest of the program treated as a managed string handle and dereferenced
    it as one: SIGSEGV. Only reachable once PyBoolOpReturnsOperand started
    admitting str-vs-number pairs into this value path at all — a LATENT bug
    in this function, not something the admit-the-pair fix introduced, since
    that pairing never reached here before
    (bug-nilpy-mixed-type-and-or-returns-a-bool-not-the-operand). A
    genuinely mixed pair now falls through to the tyVariant arm below, which
    boxes each arm instead of reinterpreting one as the other's
    representation — matching the conditional-expression parser's own
    `PyIsStrBaseTk(ta) and PyIsStrBaseTk(tb)` rule just above it in this
    file. }
  if PyIsStrBaseTk(ta) and PyIsStrBaseTk(tb) then
    ASTTk[node] := Ord(tyAnsiString)
  else if PyIsIntLikeTk(ta) and PyIsIntLikeTk(tb) then
    { two integer widths — the wider one carries both arms }
    ASTTk[node] := Ord(tyInt64)
  else if (ASTTk[a] = ASTTk[b])
          and ((ta <> tyClass) or (ResolveNodeRec(a) = ResolveNodeRec(b))) then
    { same type on both arms -> keep it, preserving a container/class identity so
      `.method()` on the result still resolves.

      ASTTk equality is TYPE-KIND equality, so for tyClass it holds between ANY
      two classes: `[] or {}` typed the ternary as the LIST class while the dict
      arm flowed through it, and the dict printed as `[]` — the same
      reinterpretation the str-vs-scalar comment above describes, reached
      through class identity instead. Class identity lives in ResolveNodeRec,
      not in ASTTk, so it has to be compared separately; two DIFFERENT classes
      fall through to the tyVariant arm, which boxes each arm rather than
      reading one through the other's representation
      (bug-nilpy-and-or-of-two-different-classes-reinterprets-one-as-the-other). }
    ASTTk[node] := ASTTk[thenNode]
  else
    ASTTk[node] := Ord(tyVariant);
  Result := node;
end;

procedure PyParseBoolExpr;
var left, right, node, condNode, elseNode, pairNode, hSave: Integer;
begin
  PyParseBoolAnd;
  left := CurASTNode;
  while CurTok.Kind = tkOr do
  begin
    Next;
    { `x or None` — None as a VALUE is pylib's VT_EMPTY variant, not the nil/zero
      cell a bare literal parses to; without this the fallback arm printed EMPTY
      where CPython prints None (the feature-nilpy-none-variant family, same
      treatment the conditional expression already gives its else arm). }
    hSave := PyHoistTail;
    if PyBareNoneHere then
    begin
      Next;
      right := PyMakeNone;
    end
    else
    begin
      PyParseBoolAnd;
      right := CurASTNode;
    end;
    { same rule as the `and` path: the right operand carries its own setup }
    right := PyFoldHoistSince(hSave, right);
    if PyBoolOpReturnsOperand(left, right) then
      node := PyMakeBoolOpValue(left, right, True)
    else
    begin
      node := AllocNode(AN_BINOP); ASTIVal[node] := Ord(tkOr);
      ASTLeft[node] := PyMakeTruthy(left); ASTRight[node] := PyMakeTruthy(right);
      ASTTk[node] := Ord(tyBoolean);
    end;
    left := node;
  end;
  { Python's CONDITIONAL EXPRESSION, `A if C else B` — the value comes first
    and the condition second, unlike every other language's ternary. Lowest
    precedence in the expression grammar, so it wraps the whole or-expression
    just parsed, and the else-arm recurses so `a if p else b if q else c`
    chains to the right as Python does.

    Reuses AN_TERNARY, which the C frontend already lowers (Left = condition,
    Right = AN_PAIR(then, else)) with only the selected arm evaluated. The
    result type is taken from the THEN arm; the two arms having different
    types is a NilPy question the corpus does not raise. }
  if CurTok.Kind = tkIf then
  begin
    Next;
    PyParseBoolExpr;
    condNode := PyMakeTruthy(CurASTNode);
    if CurTok.Kind <> tkElse then
      Error('Nil Python: a conditional expression needs an else');
    Next;
    { `A if C else None`: None is a real value (VT_EMPTY variant) — the nil
      literal boxed integer 0 and the consumer's `is None` tag-test failed
      (feature-nilpy-none-variant, sibling of the literal/setter routes). }
    if PyBareNoneHere then
    begin
      Next;
      CurASTNode := PyMakeNone;
    end
    else
      PyParseBoolExpr;
    elseNode := CurASTNode;
    pairNode := AllocNode(AN_PAIR);
    ASTLeft[pairNode] := left;
    ASTRight[pairNode] := elseNode;
    node := AllocNode(AN_TERNARY);
    ASTLeft[node] := condNode;
    ASTRight[node] := pairNode;
    { NilPy strings are MANAGED; a string-valued conditional tagged with the
      then-arm's frozen tyString printed garbage when used directly as a write
      argument, because a frozen string is content-addressed and a conditional
      yields a value, not a location. Tagging the result managed matches how
      every other NilPy string expression is typed. }
    if PyIsStrBaseTk(IntToTypeKind(ASTTk[left])) and
       PyIsStrBaseTk(IntToTypeKind(ASTTk[elseNode])) then
      ASTTk[node] := Ord(tyAnsiString)
    else
      { The arms may have DIFFERENT types — `"x" if v == "x" else v - 1` is
        ordinary Python, and songformatter writes exactly that. Widen across
        both, the same rule an assignment uses: a str/int pair boxes into a
        variant and each value survives as itself. Taking the THEN arm's type
        (or forcing a string when EITHER arm was one) stringified the numeric
        arm, so `[0, 'x', 2]` came out as `['0', 'x', '2']` — a plausible wrong
        value. bug-nilpy-ternary-comprehension-element-stringified. }
      ASTTk[node] := Ord(PyWiden(IntToTypeKind(ASTTk[left]),
                                 IntToTypeKind(ASTTk[elseNode])));
    left := node;
  end;
  CurASTNode := left;
end;

{ NilPy variable-binding resolution. A program/local name must never bind to an
  imported unit's global. Python's namespace is locals + module globals +
  builtins — NOT a used unit's internal variables. FindSym, however, walks the
  whole flat symbol table case-insensitively, so a user variable `cur` (a str)
  silently reuses pylib/pyeval's implementation global `Cur` (an Integer). The
  shared BSS slot is then stored/loaded at the wrong width — a truncated pointer
  that segfaults (surfaced when auto-using pyeval regressed str_param). Return the
  match only when it belongs to the main program (SymUnitIdx = -1, set because
  CurrentUnitIdx is -1 outside an imported unit); otherwise -1 so the caller
  AllocVars a fresh program-scoped variable that shadows the unit global.
  Mirrors the unit-scoping FindProcOverload already applies to procedures. }
function PyProgSym(const name: AnsiString): Integer;
{ A name belonging to the COMPILATION UNIT being parsed: the program itself
  (SymUnitIdx = -1), or — while a `.py` MODULE is being compiled — that module's
  own symbols, which carry its unit index. Without the second case a module's
  method could not see its own `self`: every symbol it allocates is tagged with
  the unit, so the test "must be program-level" rejected all of them
  (feature-nilpy-py-module-loader). Symbols of OTHER units stay invisible here,
  which is the point of the check — an RTL unit's internals must not bind to a
  bare Python name. }
var si: Integer;
begin
  si := FindSym(name);
  if (si >= 0) and (SymUnitIdx[si] <> -1) and (SymUnitIdx[si] <> CurrentUnitIdx) then si := -1;
  PyProgSym := si;
end;

procedure PyScanDefGlobals(bodyStart: Integer);
{ Collect the `global` / `nonlocal` names declared anywhere in the def body that
  starts at bodyStart, into PyDefGlobalName. Token-scanned rather than collected
  while parsing, because the answer is needed by the FIRST assignment in the
  body and Python's rule is whole-function: `g = 1` on line 2 is still a module
  write when `global g` appears on line 9. Statement-start only, so a variable
  legitimately named `global` in an expression cannot be mistaken for the
  declaration.

  The scan stops at the body's own DEDENT, so a NESTED def's `global` is not
  harvested into the enclosing one — the nested def scans its own body when it
  is parsed, and PyParseDef saves/restores the list around it. }
var i, depth: Integer;
begin
  PyDefGlobalCount := 0;
  { bodyStart is already INSIDE the block — PyParseDefHeader / PyParseMethod
    consume the tkIndent before recording it — so the scan starts at depth 1
    rather than hunting for an INDENT that has already gone by. Getting this
    wrong is silent: the scan then finds the first NESTED block instead and the
    body's own `global` is never seen. }
  i := bodyStart;
  depth := 1;
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth <= 0 then Exit;
    end
    else if (Tokens[i].Kind = tkIdent) and (i > 0) and
            (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]) and
            ((GetTokenStr(i) = 'global') or (GetTokenStr(i) = 'nonlocal')) then
    begin
      Inc(i);
      while (i < TokCount) and (Tokens[i].Kind = tkIdent) do
      begin
        if PyDefGlobalCount < PY_MAX_DEF_GLOBALS then
        begin
          PyDefGlobalName[PyDefGlobalCount] := GetTokenStr(i);
          Inc(PyDefGlobalCount);
        end;
        Inc(i);
        if (i < TokCount) and (Tokens[i].Kind = tkComma) then Inc(i) else Break;
      end;
      Continue;
    end;
    Inc(i);
  end;
end;

function PyDefDeclaresGlobal(const nm: AnsiString): Boolean;
var i: Integer;
begin
  Result := False;
  for i := 0 to PyDefGlobalCount - 1 do
    if PyDefGlobalName[i] = nm then begin Result := True; Exit; end;
end;

function PyAssignTargetSym(const nm: AnsiString): Integer;
{ PyProgSym for a name being ASSIGNED. Differs in exactly one case: inside a def,
  a name that resolves to a MODULE GLOBAL and is not declared `global`/`nonlocal`
  is reported as absent, so the caller allocates a proc-local instead of writing
  through to module state.

  That is Python's binding rule, and without it

      g = 1
      def shadow():
          g = 99        # a LOCAL in Python
      shadow()
      print(g)          # CPython 1, pxx used to print 99

  silently mutated the module (bug-nilpy-function-local-assignment-clobbers-
  module-global). Note the entanglement this had to preserve: `global g` USED to
  work only BECAUSE of the leak — the declaration was parsed and discarded — so
  the registry (PyScanDefGlobals) and this rule had to land together, or fixing
  the leak would have broken every correct `global` user.

  Only skGlobal is diverted: params, existing locals and `self` keep resolving as
  before. Comparison is exact-case, matching NilPy's case-sensitive names. }
begin
  Result := PyProgSym(nm);
  if (Result >= 0) and (CurProc >= 0) and (Syms[Result].Kind = skGlobal) and
     (not PyDefDeclaresGlobal(nm)) then
    Result := -1;
end;

function PyFindConstraint(const name: AnsiString): Integer;
var i: Integer;
begin
  for i := 0 to PyLocalCount - 1 do
    if PyLocals[i].Name = name then begin Result := i; Exit; end;
  Result := -1;
end;

{ Record one assignment's RHS type against a local, widening. Only the trial
  parse calls this; the real parse's frame is already laid out. }
procedure PyNoteLocalType(const name: AnsiString; tk: TTypeKind; rec: Integer);
var ci: Integer; w: TTypeKind;
begin
  if tk = tyUnknown then Exit;
  { A NilPy `int` is a 64-bit cell EVERYWHERE else — the `x: int` annotation and
    PyTypeFromTokenIndex's tkInteger arm both answer tyInt64, the latter because
    a 4-byte field put a 2^31 cliff on `self.v = 0`
    (bug-nilpy-int-promotion-decided-statically). Inferred LOCALS were the one
    binding kind still taking tyInteger from an int-shaped AST node, and the
    width was observable: `c = 2000000000; c += 2000000000` stored into a 4-byte
    slot and printed -294967296, while the plain `c = c + 2000000000` was right
    because that form re-notes the local from the wider RHS and widens it. Two
    spellings of one operation answering differently is the tell
    (bug-nilpy-augmented-assignment-truncates-to-32-bits).
    Widened here rather than at each of the ~15 PyNoteLocalType call sites, so a
    site added later cannot reintroduce a 32-bit local. }
  if tk = tyInteger then tk := tyInt64;
  ci := PyFindConstraint(name);
  if ci < 0 then
  begin
    if PyLocalCount >= PY_MAX_LOCALS then
      Error('Nil Python: too many inferred locals');
    PyLocals[PyLocalCount].Name := name;
    PyLocals[PyLocalCount].TypeKind := tk;
    if rec >= REC_UCLASS_BASE then PyLocals[PyLocalCount].RecCi := rec - REC_UCLASS_BASE
    else PyLocals[PyLocalCount].RecCi := -1;
    PyLocals[PyLocalCount].Poly := False;
    Inc(PyLocalCount);
    PyTypingChanged := True;
    Exit;
  end;
  w := PyWiden(PyLocals[ci].TypeKind, tk);
  { A name already known to hold UNRELATED classes never narrows back out of the
    dynamic representation, whatever this one assignment says. }
  if PyLocals[ci].Poly then w := tyVariant;
  if w <> PyLocals[ci].TypeKind then
  begin
    PyLocals[ci].TypeKind := w;
    PyTypingChanged := True;
  end;
  { THIS is the third place that decides a local's class identity (the other two
    are the harvest loops in PyCollectLocalsAST / PyCollectModuleLocalsAST), and
    three mechanisms for one concept is why the first fix here did not hold: the
    harvest set Poly and cleared RecCi, and then this site's old `RecCi < 0` test
    read that as "no class known yet" and re-adopted the next one. A third
    assignment back to the FIRST class was enough to undo the widening —
    measured, `PXXDBG=n.locals` went from `o tk=22` (variant) back to
    `o tk=6 rec=0`. So the rule lives in all three, and Poly is what they agree
    on. bug-nilpy-local-reassigned-across-classes-keeps-one-static-class }
  if (rec >= REC_UCLASS_BASE) and (not PyLocals[ci].Poly) then
  begin
    if PyLocals[ci].RecCi < 0 then
    begin
      PyLocals[ci].RecCi := rec - REC_UCLASS_BASE;
      PyTypingChanged := True;
    end
    else if (PyLocals[ci].RecCi <> rec - REC_UCLASS_BASE) and
            (not IsSubclassOf(rec - REC_UCLASS_BASE, PyLocals[ci].RecCi)) and
            (not IsSubclassOf(PyLocals[ci].RecCi, rec - REC_UCLASS_BASE)) then
    begin
      PyLocals[ci].Poly := True;
      PyLocals[ci].RecCi := -1;
      PyLocals[ci].TypeKind := tyVariant;
      PyTypingChanged := True;
    end;
  end;
end;

function PyFindModuleConstraint(const name: AnsiString): Integer;
var i: Integer;
begin
  for i := 0 to PyModuleLocalCount - 1 do
    if PyModuleLocals[i].Name = name then begin Result := i; Exit; end;
  Result := -1;
end;

{ (PyDefReturnType, the token scan that recovered a top-level def's return
  type before any Proc existed, was retired by PyRegisterDefShells — the
  signatures are registered up front now, so FindProc answers it.) }
{ The str-method table — the ONE place a NilPy string method is described.

  Both the desugar (PyParseStrMethod) and the type-inference scanner
  (PyInferExprType) read it, so they cannot drift: a method added here is
  immediately known to both, and inference can never disagree with the call it
  will actually build. Returns False for a name that is not a str method, which
  is what lets inference leave non-method `.foo` alone.

  Adding a method = one row here + the pylib function. }
function PyStrMethodInfo(const mname: AnsiString; var pname: AnsiString;
                         var retTk: TTypeKind; var wantArgs: Integer): Boolean;
begin
  retTk := tyAnsiString;    { the str->str default; rows below override }
  wantArgs := 0;
  Result := True;
  if CaseEqual(mname, 'upper') then pname := 'pystr_upper'
  else if CaseEqual(mname, 'lower') then pname := 'pystr_lower'
  { strip family: 0 args (whitespace) or 1 arg (a CHARS set) — see the -5 case
    in PyParseStrMethod, which appends _chars for the one-argument form. }
  else if CaseEqual(mname, 'strip') then begin pname := 'pystr_strip'; wantArgs := -5; end
  else if CaseEqual(mname, 'lstrip') then begin pname := 'pystr_lstrip'; wantArgs := -5; end
  else if CaseEqual(mname, 'rstrip') then begin pname := 'pystr_rstrip'; wantArgs := -5; end
  else if CaseEqual(mname, 'startswith') then
    { prefix, plus Python's optional start/end WINDOW — the -9 case }
    begin pname := 'pystr_startswith'; retTk := tyBoolean; wantArgs := -9; end
  else if CaseEqual(mname, 'endswith') then
    begin pname := 'pystr_endswith'; retTk := tyBoolean; wantArgs := -9; end
  else if CaseEqual(mname, 'find') then
    { .find(sub), .find(sub, start) and .find(sub, start, end) — the -9 case }
    begin pname := 'pystr_find'; retTk := tyInteger; wantArgs := -9; end
  else if CaseEqual(mname, 'index') then
    { like find, but RAISES ValueError when the substring is absent — same
      one-to-three-argument shape, so the same -9 case handles it. }
    begin pname := 'pystr_index'; retTk := tyInteger; wantArgs := -9; end
  else if CaseEqual(mname, 'rindex') then
    begin pname := 'pystr_rindex'; retTk := tyInteger; wantArgs := 1; end
  else if CaseEqual(mname, 'encode') then
    { .encode([enc [, errors=...]]) — the arguments are PARSED now and reach
      pylib, which honours them. They used to be swallowed, so every encoding
      produced UTF-8 bytes. One pylib name per arity (see the -9 case's note:
      FindProc never consults overloads).
      bug-n-str-encode-and-bytes-decode-ignore-the-encoding }
    begin pname := 'pystr_encode'; retTk := tyClass; wantArgs := -11; end
  else if CaseEqual(mname, 'format') then
    { one or two positional arguments — see the -6 case in PyParseStrMethod }
    begin pname := 'pystr_format'; retTk := tyAnsiString; wantArgs := -6; end
  else if CaseEqual(mname, 'isspace') then
    begin pname := 'pystr_isspace'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'isascii') then
    begin pname := 'pystr_isascii'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'translate') then
    { one argument, the table — a dict rather than a string, which the generic
      argument parse handles without a special case }
    begin pname := 'pystr_translate'; retTk := tyAnsiString; wantArgs := 1; end
  else if CaseEqual(mname, 'isdigit') then
    begin pname := 'pystr_isdigit'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'isnumeric') then
    begin pname := 'pystr_isnumeric'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'istitle') then
    begin pname := 'pystr_istitle'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'isalpha') then
    begin pname := 'pystr_isalpha'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'isupper') then
    begin pname := 'pystr_isupper'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'islower') then
    begin pname := 'pystr_islower'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'join') then
    begin pname := 'pystr_join'; wantArgs := 1; end
  else if CaseEqual(mname, 'split') then
    { 0 or 1 args, and the two forms are DIFFERENT algorithms — see pylib.
      PyParseStrMethod picks the concrete function from the arg count. }
    begin pname := 'pystr_split_sep'; retTk := tyClass; wantArgs := -1; end
  else if CaseEqual(mname, 'rsplit') then
    { same three arg-count shapes as split — see the -8 case in
      PyParseStrMethod: 0/1 args give the SAME result as split() (only a
      maxsplit changes which end the limit anchors to), so only the 2-arg
      form needs its own right-anchored algorithm. }
    begin pname := 'pystr_split_sep'; retTk := tyClass; wantArgs := -8; end
  else if CaseEqual(mname, 'partition') then
    begin pname := 'pystr_partition'; retTk := tyClass; wantArgs := 1; end
  else if CaseEqual(mname, 'rpartition') then
    begin pname := 'pystr_rpartition'; retTk := tyClass; wantArgs := 1; end
  else if CaseEqual(mname, 'rjust') then
    { 1 or 2 args: rjust(width) pads with spaces, rjust(width, fill) with the
      first character of fill. PyParseStrMethod picks the concrete function
      from the arg count, like split. }
    begin pname := 'pystr_rjust'; wantArgs := -2; end
  else if CaseEqual(mname, 'splitlines') then
    begin pname := 'pystr_splitlines'; retTk := tyClass; end
  else if CaseEqual(mname, 'replace') then
    { .replace(old, new) and .replace(old, new, count) — see the -7 case in
      PyParseStrMethod. Its absence is what made songformatter's
      `song_text = song_text.replace(...)` fall through to the unresolved-import
      raise (bug-nilpy-songformatter-first-render-walls). }
    begin pname := 'pystr_replace'; wantArgs := -7; end
  else if CaseEqual(mname, 'count') then
    begin pname := 'pystr_count'; retTk := tyInteger; wantArgs := -9; end
  else if CaseEqual(mname, 'rfind') then
    begin pname := 'pystr_rfind'; retTk := tyInteger; wantArgs := -9; end
  else if CaseEqual(mname, 'title') then pname := 'pystr_title'
  else if CaseEqual(mname, 'capitalize') then pname := 'pystr_capitalize'
  else if CaseEqual(mname, 'swapcase') then pname := 'pystr_swapcase'
  { casefold is lower() for the byte strings we have — no Unicode folding }
  else if CaseEqual(mname, 'casefold') then pname := 'pystr_lower'
  else if CaseEqual(mname, 'isalnum') then
    begin pname := 'pystr_isalnum'; retTk := tyBoolean; end
  else if CaseEqual(mname, 'ljust') then
    { width, plus an OPTIONAL fill character — the -2 form, like rjust }
    begin pname := 'pystr_ljust'; wantArgs := -2; end
  else if CaseEqual(mname, 'center') then
    begin pname := 'pystr_center'; wantArgs := -2; end
  else if CaseEqual(mname, 'zfill') then
    begin pname := 'pystr_zfill'; wantArgs := 1; end
  else if CaseEqual(mname, 'expandtabs') then
    { no arg (tabsize 8) or one INT tabsize — the -10 case }
    begin pname := 'pystr_expandtabs'; wantArgs := -10; end
  else if CaseEqual(mname, 'removeprefix') then
    begin pname := 'pystr_removeprefix'; wantArgs := 1; end
  else if CaseEqual(mname, 'removesuffix') then
    begin pname := 'pystr_removesuffix'; wantArgs := 1; end
  else
  begin
    pname := '';
    Result := False;
  end;
end;

{ Can this str method be called with exactly `argCount` explicit arguments?

  PyStrMethodFinish ERRORS on an arity its row does not accept, which is right
  when the source really did write a str method call — but the runtime
  string/user-class dispatch builds a str arm SPECULATIVELY beside a class arm,
  and there the same arity is legitimately a class call (`n.find(a, b, c, d)` on
  a class whose `find` takes four). It asks here first and drops the arm instead
  of failing the compile.

  The wantArgs encodings are PyStrMethodInfo's; kept in the same file and
  immediately below it so the two cannot drift apart unnoticed. }
function PyStrMethodArityOk(const mname: AnsiString; argCount: Integer): Boolean;
var aPName: AnsiString; aTk: TTypeKind; aWant: Integer;
begin
  Result := False;
  if not PyStrMethodInfo(mname, aPName, aTk, aWant) then Exit;
  if aWant >= 0 then begin Result := (argCount = aWant); Exit; end;
  case aWant of
    -1, -8: Result := (argCount >= 0) and (argCount <= 2);   { split / rsplit }
    -2, -3: Result := (argCount = 1) or (argCount = 2);      { rjust / find-with-start }
    -4:     Result := True;                                  { encode — arguments discarded }
    -5:     Result := (argCount = 0) or (argCount = 1);      { strip family }
    -6:     Result := (argCount >= 0) and (argCount <= 8);   { format }
    -7:     Result := (argCount = 2) or (argCount = 3);      { replace }
    -9:     Result := (argCount >= 1) and (argCount <= 3);   { find/index/count window }
    -10:    Result := (argCount = 0) or (argCount = 1);      { expandtabs }
  end;
end;

{ Does the `(` at token `lp` close on the LAST token of its line — i.e. is the
  right-hand side exactly `Name(...)` and nothing more?

  The block-local pre-pass recognises `name = Cls(...)` by looking at two
  tokens, an identifier naming a known class and a following `(`. That claims
  the FIRST tokens without checking they END the construct, so
  `b = S().read()` was read as a construction and `b` was typed as an S: `len(b)`
  answered 0 and printing it gave the raw instance handle. Silently — and it was
  a REGRESSION IN KIND, because the same line was a loud "undefined variable" on
  `pinned`.

  Same shape as project_nilpy_constant_fastpath_claims_first_token_pattern: a
  fast path beside a real expression path is a second parser, and it disagrees
  quietly. Scanning to the matching `)` costs nothing and cannot Halt, which is
  the constraint this whole branch works under. }
function PyBlkRhsEndsAfterCall(lp: Integer): Boolean;
var d, k: Integer;
begin
  PyBlkRhsEndsAfterCall := False;
  if (lp < 0) or (lp >= MainProgramTokCount) then Exit;
  if Tokens[lp].Kind <> tkLParen then Exit;
  d := 0;
  k := lp;
  while k < MainProgramTokCount do
  begin
    if Tokens[k].Kind = tkLParen then Inc(d)
    else if Tokens[k].Kind = tkRParen then
    begin
      Dec(d);
      if d = 0 then
      begin
        PyBlkRhsEndsAfterCall := (k + 1 >= MainProgramTokCount) or
          (Tokens[k + 1].Kind in [tkNewline, tkDedent, tkEOF, tkSemicolon]);
        Exit;
      end;
    end
    else if Tokens[k].Kind in [tkNewline, tkEOF] then Exit;   { unbalanced }
    Inc(k);
  end;
end;

function PyBlkRhsEndsAt(k: Integer): Boolean;
{ Is token k the LAST token of its statement? The other half of
  PyBlkRhsEndsAfterCall's lesson: the depth>0 arm's safe-shape tests each looked
  at the FIRST token of the right-hand side and nothing else, so
  `wrapped = "a-b".split("-")` matched the STRING-LITERAL shape on its `"a-b"`
  and was typed tyAnsiString. The real assignment then stored a TPyList into a
  string slot and `len(wrapped)` answered 1348027121 — silent, and the shape is
  as ordinary as `.split()` gets. Every literal arm asks this now; a right-hand
  side that continues falls through to the phantom, which asserts nothing. }
begin
  PyBlkRhsEndsAt := (k + 1 >= MainProgramTokCount) or
    (Tokens[k + 1].Kind in [tkNewline, tkDedent, tkEOF, tkSemicolon]);
end;

function PyBlkRhsEndsAfterGroup(op: Integer): Boolean;
{ The same question for a BRACKETED right-hand side — `xs = [1, 2]`, `d = {}`:
  is the group that opens at `op` the whole of it? PyBlkRhsEndsAfterCall asks
  this of a '(' run; a list or dict literal needs its own matching closer
  instead, and (unlike a call) may carry newlines inside the brackets, so only
  EOF ends the scan early. Scanning cannot Error(), which is the constraint the whole
  branch works under. }
var d, k: Integer;
begin
  PyBlkRhsEndsAfterGroup := False;
  if (op < 0) or (op >= MainProgramTokCount) then Exit;
  if not (Tokens[op].Kind in [tkLParen, tkLBrack, tkBegin]) then Exit;
  d := 0;
  k := op;
  while k < MainProgramTokCount do
  begin
    if Tokens[k].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(d)
    else if Tokens[k].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      Dec(d);
      if d <= 0 then
      begin
        PyBlkRhsEndsAfterGroup := PyBlkRhsEndsAt(k);
        Exit;
      end;
    end
    else if Tokens[k].Kind = tkEOF then Exit;
    Inc(k);
  end;
end;

{ Does ANY user class declare this method? (Records excluded — the closed-world
  dispatch below skips them too.) }
function PyAnyClassDeclaresMeth(const mname: AnsiString): Boolean;
var ci: Integer;
begin
  Result := False;
  for ci := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[ci] then Continue;
    if FindUMeth(ci, mname) >= 0 then begin Result := True; Exit; end;
  end;
end;

{ A str method NAME that some user class also declares as a method — so on a
  VARIANT receiver the frontend cannot know which is meant, and must not choose.

  This used to be a hardcoded list of exactly two names, `title` and `count`,
  each added when a real program hit it (tkinter's `root.title("x")`, a
  container's `count`). Returning True sent the call down the class-dispatch
  path and simply GAVE UP the str spelling; returning False sent it down the
  str-first path, whose "not a string tag" arm RAISES AttributeError. So every
  name was wrong for one of the two receivers, and which names were wrong for
  which was decided by whichever bug got reported first. `find` and `index` were
  next (a tree walker's `c.find(t)` raised AttributeError naming a method the
  class plainly declares), with `split`, `strip`, `format`, `encode`, `replace`
  and `join` queued behind them.

  It is now the general predicate, because the CALLER no longer has to choose:
  PyParseVariantMethod's runtime dispatcher grows a `pyvar_is_strtag(recv)` arm
  that reaches the str method, so a genuine string receiver keeps str-first
  priority at RUN time — which is what CPython does and what the frontend cannot
  do at compile time. See the str arm at the end of that function.

  `encode` is the one exclusion: its row SKIPS its arguments rather than parsing
  them (the -4 case), because `errors="replace"` is a keyword, not an
  expression. The class path parses arguments as expressions, so it cannot
  produce a chain for that row; it keeps the old str-first behaviour. }
function PyStrMethodLosesToClass(const mname: AnsiString): Boolean;
var lcPName: AnsiString; lcTk: TTypeKind; lcWant: Integer;
begin
  Result := False;
  if not PyStrMethodInfo(mname, lcPName, lcTk, lcWant) then Exit;
  if lcWant = -4 then Exit;                  { .encode — arguments are skipped, not parsed }
  Result := PyAnyClassDeclaresMeth(mname);
end;

function PyMinMaxDefaultAhead: Boolean;
{ CurTok is `min`/`max` and the next token is '('. True when a `default=`
  keyword sits at depth 1 of that argument list. A lookahead rather than a
  parse: the arm that acts on it has to consume the whole call itself, and
  every other min/max form must be left completely untouched. }
var k, depth: Integer;
begin
  Result := False;
  k := TokPos;                          { the '(' }
  if (k >= TokCount) or (Tokens[k].Kind <> tkLParen) then Exit;
  depth := 0;
  while k < TokCount do
  begin
    if Tokens[k].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[k].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[k].Kind = tkIdent) and
            CaseEqual(GetTokenStr(k), 'default') and
            (k + 1 < TokCount) and (Tokens[k + 1].Kind = tkAssign) then
    begin
      Result := True;
      Exit;
    end;
    Inc(k);
  end;
end;

function PyBuiltinTypeCode(const nm: AnsiString): Integer;
{ The PYBT_* code for a builtin TYPE name, or 0. Mirrors pylib's own table —
  the two are a pair, and pylib's pybtype_name is the one that must answer the
  Python spelling, so add to both or to neither.
  bug-n-a-type-name-is-not-a-first-class-value }
var lo: AnsiString;
begin
  lo := LowerCase(nm);
  if lo = 'str' then Result := 1
  else if lo = 'int' then Result := 2
  else if lo = 'float' then Result := 3
  else if lo = 'bool' then Result := 4
  else if lo = 'bytes' then Result := 5
  else if lo = 'list' then Result := 6
  else if lo = 'dict' then Result := 7
  else if lo = 'set' then Result := 8
  else if lo = 'tuple' then Result := 9
  else if lo = 'bytearray' then Result := 10
  else if lo = 'frozenset' then Result := 11
  { `type` only as a bare VALUE — `type(x)` keeps its own intercept, which the
    caller's `not followed by '('` guard leaves alone. }
  else if lo = 'type' then Result := 12
  else Result := 0;
end;

function PyMakeBuiltinTypeValue(code: Integer): Integer;
{ `str` in VALUE position: the pybtype(<code>) call that boxes it as a VT_BTYPE
  variant. An ordinary pylib call rather than a new AST node, so nothing below
  the frontend has to learn about builtin types — the same choice
  PyBuildKeywordDict makes for a keyword dict. }
var callNode, argNode, litNode, pi: Integer;
begin
  pi := FindProc('pybtype');
  if pi < 0 then Error('Nil Python: pylib (pybtype) not loaded');
  litNode := AllocNode(AN_INT_LIT);
  ASTIVal[litNode] := code;
  ASTTk[litNode] := Ord(tyInt64);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := litNode;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := pi;
  ASTLeft[callNode] := argNode;
  ASTTk[callNode] := Ord(tyVariant);
  Result := callNode;
end;

{ A name that is BOTH a type name and a builtin conversion call. }
function PyIsBuiltinConvName(const nm: AnsiString): Boolean;
var lo: AnsiString;
begin
  lo := LowerCase(nm);
  Result := (lo = 'str') or (lo = 'int') or (lo = 'float') or (lo = 'bool') or
            (lo = 'list') or (lo = 'dict') or (lo = 'set') or (lo = 'bytes') or
            (lo = 'bytearray');
end;

{ Is the bracket group opening at lbIdx a SLICE (`[a:b]`) rather than an index?
  A ':' at depth 1 is the whole test; a nested subscript or call keeps its own
  colons at a deeper level. }
function PySliceBracketAt(lbIdx, endIdx: Integer): Boolean;
var k, depth: Integer;
begin
  Result := False;
  depth := 0;
  k := lbIdx;
  while k < endIdx do
  begin
    if Tokens[k].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[k].Kind in [tkRParen, tkEnd] then Dec(depth)
    else if Tokens[k].Kind = tkRBrack then
    begin
      Dec(depth);
      if depth = 0 then Exit;
    end
    else if (depth = 1) and (Tokens[k].Kind = tkColon) then
    begin
      Result := True;
      Exit;
    end;
    Inc(k);
  end;
end;

{ Where the container LITERAL that starts at `startIdx` CLOSES, or -1 if it
  does not close inside the span. Its only caller is PyLiteralPostfixType. }
function PyLitGroupEnd(startIdx, endIdx: Integer): Integer;
var k, depth: Integer;
begin
  Result := -1;
  depth := 0;
  k := startIdx;
  while k < endIdx do
  begin
    if Tokens[k].Kind in [tkLBrack, tkLParen, tkBegin] then Inc(depth)
    else if Tokens[k].Kind in [tkRBrack, tkRParen, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then begin Result := k; Exit; end;
    end;
    Inc(k);
  end;
end;

{ A container LITERAL is not always the WHOLE expression: `(1, 2)[0]`,
  `[1, 2].count(1)` and `{"a": 1}["a"]` all START with one and are not one.
  The two literal arms below used to answer the literal's own class and Exit
  the moment they saw the opening bracket, so `def f(): return (1, 2)[0]`
  registered a CLASS result, the element variant was read back as an object
  handle, and `print(f())` walked a dangling list inside pylist_repr and
  SEGFAULTED. Every axis crossed the same way — tuple or list, constant or
  variable contents, constant or variable index — because none of them is the
  axis: the literal-vs-bound one is. Binding it first (`t = (1, 2)` then
  `t[0]`) always worked, because a bare ident reaches the `name[...]` arm
  further down, which has answered "a subscript yields a VARIANT" since
  bug-nilpy-subscript-and-slice-of-a-variant-get-the-wrong-static-type.
  That arm is keyed to an IDENT receiver, so the literal receiver never met it
  — the sibling case devdocs/dev/normalise-dont-special-case.md is about.

  Answers the type of whatever POSTFIX follows the literal, and tyUnknown when
  the literal really is the whole expression (or is only an operand, `[1] + x`,
  where the existing literal answer is right).
  bug-n-subscripting-a-container-literal-inside-a-function-segfaults }
function PyLiteralPostfixType(startIdx, endIdx: Integer): TTypeKind;
var ce: Integer;
begin
  Result := tyUnknown;
  ce := PyLitGroupEnd(startIdx, endIdx);
  if (ce < 0) or (ce + 1 >= endIdx) then Exit;
  { `[1, 2, 3][0:2]` — a SLICE yields the container again, so the literal's own
    class stays the right answer. }
  if (Tokens[ce + 1].Kind = tkLBrack) and not PySliceBracketAt(ce + 1, endIdx) then
  begin
    Result := tyVariant;
    Exit;
  end;
  { `[1, 2].count(1)` / `(a, b)[0].upper()` — a method on a literal. The
    element or result could be anything, and tyVariant is the answer this scan
    already gives for a call it cannot type statically. }
  if Tokens[ce + 1].Kind = tkDot then Result := tyVariant;
end;

function PyInferExprType(startIdx, endIdx: Integer): TTypeKind;
var i, ci, si, procIdx, depth, smArgs, fci, fi, k2, rcvCi: Integer; tk: TTypeKind;
    fldCi, fldAt: Integer; fldTk: TTypeKind;
    ternCi, ternElse, ternDepth: Integer; ternTk: TTypeKind;
    name, lo, smPName: AnsiString;
begin
  Result := tyUnknown;
  PyInferLastCi := -1;
  { A CONDITIONAL EXPRESSION types as its THEN arm, so infer from the part
    before the `if` and stop. Without this the scanner walked straight through
    `x if c else y`, widening across the condition and the else-arm, and a
    class-valued conditional lost its identity — the next `.method()` on the
    local then failed to resolve, surfacing as a misleading "expected :" at the
    following line (bug-nilpy-conditional-expression-loses-its-type). }
  k2 := startIdx;
  depth := 0;
  while k2 < endIdx do
  begin
    if Tokens[k2].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[k2].Kind in [tkEnd, tkRBrack, tkRParen] then Dec(depth)
    else if (depth = 0) and (Tokens[k2].Kind = tkIf) and (k2 > startIdx) then
    begin
      { ...but ONLY when both arms agree. Typing purely from the THEN arm
        asserts a static type the value may not have: `bytearray() if flag else
        [1, 2]` registered TPyBytes, so the list-returning call came back
        declared as bytes and `d.append(99); print(d)` printed b'\x01\x00c'
        instead of [1, 2, 99] — silently, and for a reason that has nothing to
        do with the variant method dispatch this was filed under.
        Two different classes have no single static answer, so widen to a
        variant and let the runtime dispatch decide, which is the same
        conclusion the reassigned-local rule reaches
        (bug-nilpy-local-reassigned-across-classes-keeps-one-static-class).
        feature-nilpy-runtime-method-dispatch-on-variant }
      Result := PyInferExprType(startIdx, k2);
      ternCi := PyInferLastCi;
      ternElse := -1;
      ternDepth := 0;
      for i := k2 + 1 to endIdx - 1 do
      begin
        if Tokens[i].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(ternDepth)
        else if Tokens[i].Kind in [tkEnd, tkRBrack, tkRParen] then Dec(ternDepth)
        else if (ternDepth = 0) and (Tokens[i].Kind = tkElse) then
        begin ternElse := i; Break; end;
      end;
      if ternElse >= 0 then
      begin
        ternTk := PyInferExprType(ternElse + 1, endIdx);
        if (ternTk <> tyUnknown) and (Result <> tyUnknown) then
        begin
          if (Result = tyClass) and (ternTk = tyClass) then
          begin
            if PyInferLastCi <> ternCi then
            begin
              Result := tyVariant;
              PyInferLastCi := -1;
              Exit;
            end;
          end
          else if Result <> ternTk then
          begin
            Result := PyWiden(Result, ternTk);
            PyInferLastCi := -1;
            Exit;
          end;
        end;
      end;
      PyInferLastCi := ternCi;
      Exit;
    end;
    Inc(k2);
  end;
  { A COMPARISON or a membership test yields a Boolean whatever its operands
    are, and the scan below types an expression by the operands it recognises:
    `return v in {"0", "1"}` typed itself by the set literal (a TPyList) and
    `return v > "0"` by the string, so the def's registered result type
    disagreed with what the body actually returns — the caller read a Boolean
    as an object pointer and crashed on the next use
    (bug-nilpy-comparison-return-type-inferred-from-operands). `and`/`or` are
    deliberately NOT here: Python hands back an OPERAND, not a Boolean, and
    NilPy implements that. Depth-tracked so an operator inside a call or a
    subscript does not decide the whole expression. }
  k2 := startIdx;
  depth := 0;
  while k2 < endIdx do
  begin
    if Tokens[k2].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[k2].Kind in [tkEnd, tkRBrack, tkRParen] then Dec(depth)
    else if (depth = 0) and (Tokens[k2].Kind in [tkEq, tkNeq, tkLt, tkLe,
                                                 tkGt, tkGe, tkIn]) then
    begin
      Result := tyBoolean;
      Exit;
    end;
    Inc(k2);
  end;
  { `not <expr>` is a Boolean too. }
  if (startIdx < endIdx) and (Tokens[startIdx].Kind = tkNot) then
  begin
    Result := tyBoolean;
    Exit;
  end;
  { A parenthesised TUPLE is built as a TPyList, so it must INFER as one too —
    otherwise an unannotated `return (a, b)` typed itself Integer and handed
    back the list pointer truncated. }
  if (startIdx < endIdx) and (Tokens[startIdx].Kind = tkLParen) and
     PyTupleParenAt(startIdx) then
  begin
    Result := PyLiteralPostfixType(startIdx, endIdx);
    if Result <> tyUnknown then begin PyInferLastCi := -1; Exit; end;
    Result := tyClass;
    PyInferLastCi := FindUClass('TPyList');
    Exit;
  end;
  if (startIdx < endIdx) and
     ((Tokens[startIdx].Kind = tkLBrack) or (Tokens[startIdx].Kind = tkBegin)) then
  begin
    Result := PyLiteralPostfixType(startIdx, endIdx);
    if Result <> tyUnknown then begin PyInferLastCi := -1; Exit; end;
    Result := tyClass;   { list / set-as-list / dict literal }
    if (Tokens[startIdx].Kind = tkBegin) and PyDictLiteralAt(startIdx) then
      PyInferLastCi := FindUClass('TPyDict')
    else
      PyInferLastCi := FindUClass('TPyList');
    Exit;
  end;
  { A sequence REPEAT written COUNT-FIRST: `u * [7]`, `n * bytes(...)`.

    The literal checks above all key on what the expression STARTS with, so
    `[7] * u` was typed a list and the reversed `u * [7]` fell through to
    arithmetic and inferred Integer — and a def returning it handed back the
    list HANDLE as a number, silently (`f(2)` printed 130251386519784 instead of
    `[7, 7]`). Python's `*` on a sequence is commutative, so the inference has
    to be too; the repeat LOWERING already accepts both orders
    (PyIsListRepeatPair tests each side), which is exactly why the value was
    built correctly and only its declared type was wrong.

    Only the FIRST top-level `*` is examined, and `**` is excluded — its two
    tkStar tokens would otherwise make `2 ** 3` recurse on `* 3`.
    bug-nilpy-reversed-list-repeat-returned-from-a-def-infers-int }
  if startIdx < endIdx then
  begin
    depth := 0;
    for k2 := startIdx to endIdx - 1 do
    begin
      if Tokens[k2].Kind in [tkBegin, tkLBrack, tkLParen] then Inc(depth)
      else if Tokens[k2].Kind in [tkEnd, tkRBrack, tkRParen] then Dec(depth)
      else if (depth = 0) and (Tokens[k2].Kind = tkStar) and (k2 > startIdx) then
      begin
        if ((k2 + 1 < endIdx) and (Tokens[k2 + 1].Kind = tkStar)) or
           (Tokens[k2 - 1].Kind = tkStar) then Break;    { `**`, not a repeat }
        tk := PyInferExprType(k2 + 1, endIdx);
        if (tk = tyClass) and (PyInferLastCi >= 0) and
           ((PyInferLastCi = FindUClass('TPyList')) or
            (PyInferLastCi = FindUClass('TPyBytes'))) then
        begin
          { PyInferLastCi is already the right class from the recursive call }
          Result := tyClass;
          Exit;
        end;
        PyInferLastCi := -1;
        Break;
      end;
    end;
  end;
  { A QUALIFIED construction — `tk.Canvas(root)`, the form every tkinter
    application writes. Unqualified `Canvas(root)` was typed below; this one was
    not, so `self.canvas = tk.Canvas(root)` recorded a field with no class
    identity and every later `self.canvas.method(...)` fell through to the
    dynamic-attribute path — which cannot bind keyword arguments, so
    `self.canvas.create_text(0, 0, text="x")` was a parse error while the same
    call through a LOCAL compiled. (The module qualifier is a unit alias here:
    NilPy turns `import tkinter as tk` into a uses-clause alias, so the class is
    found by its bare name.) }
  if (startIdx + 2 < endIdx) and (Tokens[startIdx].Kind = tkIdent) and
     (Tokens[startIdx + 1].Kind = tkDot) and (Tokens[startIdx + 2].Kind = tkIdent) and
     (startIdx + 3 < endIdx) and (Tokens[startIdx + 3].Kind = tkLParen) and
     (FindUClass(GetTokenStr(startIdx + 2)) >= 0) then
  begin
    Result := tyClass;
    PyInferLastCi := FindUClass(GetTokenStr(startIdx + 2));
    Exit;
  end;
  if (startIdx < endIdx) and (Tokens[startIdx].Kind = tkIdent) and
     IsClassType(GetTokenStr(startIdx)) and (startIdx + 1 < endIdx) and
     (Tokens[startIdx + 1].Kind = tkLParen) and
     (FindUClass(GetTokenStr(startIdx)) >= 0) then
  begin
    { ...and only for a class that REALLY exists: `str(x)` / `int(x)` are
      builtin CONVERSIONS whose names IsClassType also answers to, and typing
      them tyClass-with-no-identity made an unannotated `return str(x)` hand
      back a string handle the caller read as an object pointer — a segfault.
      The builtin table further down gives them their real result types. }
    Result := tyClass;
    PyInferLastCi := FindUClass(GetTokenStr(startIdx));
    Exit;
  end;
  i := startIdx;
  while i < endIdx do
  begin
    { A list/dict LITERAL used as an OPERAND — `p + ["x"]`, `d | {"a": 1}`.
      The literal arms far above only fire when the expression STARTS with the
      bracket, so as an operand the group was walked token by token and the
      result took its type from the ELEMENTS: `p + ["x"]` inferred AnsiString
      off the "x", and a def returning it declared a STRING result and handed
      back the empty string for what is a list. Fold the container's own type
      and skip the group, exactly as the subscript arms below skip theirs.

      Literal, not subscript: a subscript's bracket FOLLOWS a value, so the
      preceding token settles it. `f(x)[0]` is the case that makes the test
      necessary rather than assumed — the call arm skips the paren group and
      leaves the walk sitting on the `[`.
      bug-nilpy-rebinding-a-list-parameter-aliases-the-callers-list }
    if ((Tokens[i].Kind = tkLBrack) or (Tokens[i].Kind = tkBegin)) and
       (i > startIdx) and
       not (Tokens[i - 1].Kind in [tkIdent, tkRParen, tkRBrack, tkString]) then
    begin
      tk := tyClass;
      if (Tokens[i].Kind = tkBegin) and PyDictLiteralAt(i) then
        PyInferLastCi := FindUClass('TPyDict')
      else
        PyInferLastCi := FindUClass('TPyList');
      depth := 0;
      while i < endIdx do
      begin
        if Tokens[i].Kind in [tkLBrack, tkBegin] then Inc(depth)
        else if Tokens[i].Kind in [tkRBrack, tkEnd] then
        begin
          Dec(depth);
          if depth = 0 then Break;
        end;
        Inc(i);
      end;
      Result := PyWiden(Result, tk);
      Inc(i);
      Continue;
    end;
    { A str method called on a string LITERAL — `"a,b".split(",")`. The scan
      below only inspects IDENT tokens, so a literal base never reached the
      str-method case and the result fell through untyped: a local assigned
      from "a,b".split(",") carried no class identity, len() picked the
      AnsiString overload over the TPyList one and read a class pointer as a
      string handle. Handled here, before the ident dispatch. }
    if (Tokens[i].Kind = tkString) and (i + 3 < endIdx) and
       (Tokens[i + 1].Kind = tkDot) and (Tokens[i + 2].Kind = tkIdent) and
       (Tokens[i + 3].Kind = tkLParen) and
       PyStrMethodInfo(GetTokenStr(i + 2), smPName, tk, smArgs) then
    begin
      if tk = tyClass then PyInferLastCi := FindUClass('TPyList');
      i := i + 3; depth := 0;
      while i < endIdx do
      begin
        if Tokens[i].Kind = tkLParen then Inc(depth)
        else if Tokens[i].Kind = tkRParen then
        begin
          Dec(depth);
          if depth = 0 then Break;
        end;
        Inc(i);
      end;
      Result := PyWiden(Result, tk);
      Inc(i);
      Continue;
    end;
    tk := PyTypeFromTokenIndex(i);
    { A type NAME followed by '(' is a conversion CALL, not a bare type: it must
      go through the call branch below, which knows the conversion's result type
      AND skips the argument group. Reading it as a type here typed `str(d)` as
      a string and then WIDENED over the argument `d` — and since locals exist
      only in the body pass, the shell pre-pass said `str` and the body pass said
      `variant` for the same def: two different return types for one signature,
      i.e. the silent ABI mismatch, and the def crashed on return. }
    if (tk <> tyUnknown) and (Tokens[i].Kind = tkIdent) and (i + 1 < endIdx) and
       (Tokens[i + 1].Kind = tkLParen) and PyIsBuiltinConvName(GetTokenStr(i)) then
      tk := tyUnknown;
    if tk = tyUnknown then
    begin
      if Tokens[i].Kind = tkIdent then
      begin
        name := GetTokenStr(i);
        { Call form `name(...)`: take the callee's return type and skip the
          whole argument group so arg tokens do not pollute the widening. }
        if (i + 1 < endIdx) and (Tokens[i + 1].Kind = tkLParen) and
           ((not IsClassType(name)) or PyIsBuiltinConvName(name)) then
        begin
          { ...and the builtin CONVERSIONS get in even though IsClassType
            answers to their names: `str`, `int`, `float`, `bool`, `list`,
            `dict`, `set` are type names AND callable intrinsics, and the guard
            above kept `return str(x)` from ever reaching the table below. }
          { Shared-parser builtins are not Procs; without this they would fall
            through to tyVariant and poison the local's type (a variant local
            scalar-loaded on `return` yields its TAG, not the value). }
          lo := LowerCase(name);
          if (lo = 'length') or (lo = 'ord') or (lo = 'pos') then tk := tyInteger
          else if lo = 'chr' then tk := tyAnsiString   { chr() is a 1-character str }
          else if lo = 'copy' then tk := tyString
          { The NilPy BUILTINS the shared parser lowers as intrinsics: they are
            not Procs either, so `return str(x)` in an unannotated def inferred
            an INTEGER, and the caller then read the returned string handle as a
            number — a segfault or a garbage integer, silently
            (bug-nilpy-unannotated-return-infers-number-for-string-concat is the
            operator half of the same blind spot). }
          else if (lo = 'str') or (lo = 'repr') or (lo = 'format') then tk := tyAnsiString
          { `int(...)` the CALL — not `int` the annotation (PyAnnTypeAt) nor the
            bare type name (PyTypeFromTokenIndex), both of which still mean a
            64-bit cell. Python's int has no width, and the call is now typed by
            its ARGUMENT: a string yields a promotable int, a variant yields a
            variant, everything else an Int64. A token scan cannot tell those
            apart, and answering the narrowest of them made an unannotated
            `return int(v)` register an Int64 SIGNATURE over a variant-returning
            body — the silent ABI mismatch — so `anyint(2**64)` came back 0.
            tyVariant is the one answer that holds every case, and it is what
            this scan already answers for any call it cannot type. }
          else if lo = 'int' then tk := tyVariant
          else if lo = 'float' then tk := tyDouble
          else if lo = 'bool' then tk := tyBoolean
          else if (lo = 'len') or (lo = 'index') then tk := tyInteger
          else if (lo = 'any') or (lo = 'all') then tk := tyBoolean
          else if (lo = 'list') or (lo = 'sorted') or (lo = 'set') or
                  (lo = 'zip') or (lo = 'enumerate') then
          begin
            tk := tyClass;
            PyInferLastCi := FindUClass('TPyList');
          end
          else if lo = 'dict' then
          begin
            tk := tyClass;
            PyInferLastCi := FindUClass('TPyDict');
          end
          else if (lo = 'sum') or (lo = 'max') or (lo = 'min') or (lo = 'next') or
                  (lo = 'abs') then tk := tyVariant
          else
          begin
            { Every top-level def has a registered Proc by now
              (PyRegisterDefShells), so FindProc is the whole answer — the old
              PyDefReturnType token scan that stood in for it is gone. }
            procIdx := FindProc(name);
            if procIdx >= 0 then tk := Procs[procIdx].RetType;
            { A call returning a CLASS has to record WHICH class, or the
              inferred local/field carries tyClass with no identity and
              overload resolution mis-picks — `len(bytearray(n))` chose the
              AnsiString overload and read a class pointer as a string handle,
              segfaulting. Same failure the str-method branches above document.
              ProcRetRecId is a REC ID; PyInferLastCi is a CLASS INDEX. }
            if (procIdx >= 0) and (tk = tyClass) and
               (ProcRetRecId[procIdx] >= REC_UCLASS_BASE) then
              PyInferLastCi := ProcRetRecId[procIdx] - REC_UCLASS_BASE;
            if tk = tyUnknown then tk := tyVariant;
          end;
          i := i + 1; depth := 0;
          while i < endIdx do
          begin
            if Tokens[i].Kind = tkLParen then Inc(depth)
            else if Tokens[i].Kind = tkRParen then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end;
            Inc(i);
          end;
          Result := PyWiden(Result, tk);
          Inc(i);
          Continue;
        end;
        if PyIsClassTypeExact(name) then tk := tyClass;
        ci := PyFindConstraint(name);
        if (tk = tyUnknown) and (ci >= 0) then tk := PyLocals[ci].TypeKind
        else
        begin
          si := PyProgSym(name);
          if si >= 0 then tk := Syms[si].TypeKind;
        end;
        { obj.method(...) on a class-typed name: the expression's type is the
          METHOD's return type; skip the whole postfix chain. }
        { The receiver's class: a constrained local, or `self`, which never
          appears in PyLocals — so `w = self.lookup(k)` inferred nothing and the
          local lost the method's return class. The next `w.method()` then had
          no class to resolve against and the parse stopped before the '(' with
          a misleading "expected :" on the FOLLOWING line
          (bug-nilpy-self-method-call-loses-return-class). }
        rcvCi := -1;
        if (ci >= 0) and (PyLocals[ci].RecCi >= 0) then rcvCi := PyLocals[ci].RecCi
        else if (name = 'self') and (CurSelfClass >= REC_UCLASS_BASE) then
          rcvCi := CurSelfClass - REC_UCLASS_BASE;
        { A plain FIELD READ on a class-typed receiver — `self.n`, with NO '('.
          The method branch below requires one, so a field read fell straight
          through and the expression took its type from the RECEIVER instead:
          `def draw(v): return v + self.n` inside a method inferred a CLASS
          result, the caller read the field slot as an object pointer, and
          `print(C().run())` produced an empty line where CPython printed 17 —
          silent, and only for a nested def, because a method body itself never
          asks this scanner. An explicit `-> int` made it correct, which is what
          identifies it as return-type INFERENCE rather than the capture (the
          capture is fine: `print(self.n)` inside the same nested def prints 7).
          bug-nilpy-nested-def-capturing-self-called-from-a-sibling-returns-nothing }
        if rcvCi >= 0 then
        begin
          { Walk the whole `.field.field…` CHAIN, so `self.inner.k` resolves
            through the intermediate class rather than stopping at the first
            segment. A trailing `.method(...)` is resolved too, which is what
            keeps a chain ending in a call from being typed by the last FIELD. }
          fldCi := rcvCi;
          fldAt := i;
          fldTk := tyUnknown;
          while (fldCi >= 0) and (fldAt + 2 < endIdx) and
                (Tokens[fldAt + 1].Kind = tkDot) and
                (Tokens[fldAt + 2].Kind = tkIdent) and
                ((fldAt + 3 >= endIdx) or (Tokens[fldAt + 3].Kind <> tkLParen)) do
          begin
            si := FindUField(fldCi, GetTokenStr(fldAt + 2));
            if si < 0 then Break;
            fldTk := IntToTypeKind(UFldTk[si]);
            if (fldTk = tyClass) and (UFldRec_[si] >= REC_UCLASS_BASE) then
            begin
              fldCi := UFldRec_[si] - REC_UCLASS_BASE;
              PyInferLastCi := fldCi;
            end
            else fldCi := -1;
            fldAt := fldAt + 2;
          end;
          { …and a method call closing the chain: `self.inner.get()`. }
          if (fldCi >= 0) and (fldAt > i) and (fldAt + 3 < endIdx) and
             (Tokens[fldAt + 1].Kind = tkDot) and
             (Tokens[fldAt + 2].Kind = tkIdent) and
             (Tokens[fldAt + 3].Kind = tkLParen) then
          begin
            si := FindUMeth(fldCi, GetTokenStr(fldAt + 2));
            if si >= 0 then
            begin
              fldTk := Procs[UMthProc_[si]].RetType;
              if (fldTk = tyClass) and (ProcRetRecId[UMthProc_[si]] >= REC_UCLASS_BASE) then
                PyInferLastCi := ProcRetRecId[UMthProc_[si]] - REC_UCLASS_BASE;
              fldAt := fldAt + 3; depth := 0;
              while fldAt < endIdx do
              begin
                if Tokens[fldAt].Kind = tkLParen then Inc(depth)
                else if Tokens[fldAt].Kind = tkRParen then
                begin
                  Dec(depth);
                  if depth = 0 then Break;
                end;
                Inc(fldAt);
              end;
            end;
          end;
          if (fldAt > i) and (fldTk <> tyUnknown) then
          begin
            Result := PyWiden(Result, fldTk);
            i := fldAt + 1;
            Continue;
          end;
        end;
        if (rcvCi >= 0) and
           (i + 3 < endIdx) and (Tokens[i + 1].Kind = tkDot) and
           (Tokens[i + 2].Kind = tkIdent) and (Tokens[i + 3].Kind = tkLParen) then
        begin
          si := FindUMeth(rcvCi, GetTokenStr(i + 2));
          if si >= 0 then
          begin
            tk := Procs[UMthProc_[si]].RetType;
            { REC ID -> CLASS INDEX. Assigning the rec id straight across left
              every consumer to add REC_UCLASS_BASE a second time. }
            if (tk = tyClass) and (ProcRetRecId[UMthProc_[si]] >= REC_UCLASS_BASE) then
              PyInferLastCi := ProcRetRecId[UMthProc_[si]] - REC_UCLASS_BASE;
            i := i + 3; depth := 0;
            while i < endIdx do
            begin
              if Tokens[i].Kind = tkLParen then Inc(depth)
              else if Tokens[i].Kind = tkRParen then
              begin
                Dec(depth);
                if depth = 0 then Break;
              end;
              Inc(i);
            end;
            Result := PyWiden(Result, tk);
            Inc(i);
            Continue;
          end;
        end;
        { Plain `.field` chain on a class-typed name (no call parens): follow it
          so the inferred type AND class identity are the FINAL field's.
          Without it `x = o.inner` left x as tyClass with no identity and the
          later `x.name` mis-resolved to Integer, printing a raw pointer.
          Depends on PyRegisterClassFieldsPrepass having run — before that,
          every class had zero fields at this point and there was nothing to
          walk. The method form below handles the `(`-terminated case. }
        if (tk = tyClass) and (ci >= 0) and (PyLocals[ci].RecCi >= 0) and
           (i + 2 < endIdx) and (Tokens[i + 1].Kind = tkDot) and
           (Tokens[i + 2].Kind = tkIdent) and
           not ((i + 3 < endIdx) and (Tokens[i + 3].Kind = tkLParen)) then
        begin
          fci := PyLocals[ci].RecCi;
          Inc(i);
          while (i + 1 < endIdx) and (Tokens[i].Kind = tkDot) and
                (Tokens[i + 1].Kind = tkIdent) and (fci >= 0) do
          begin
            fi := FindUField(fci, GetTokenStr(i + 1));
            if fi < 0 then Break;
            tk := IntToTypeKind(UFldTk[fi]);
            if (tk = tyClass) and (UFldRec_[fi] >= REC_UCLASS_BASE) then
              fci := UFldRec_[fi] - REC_UCLASS_BASE
            else
              fci := -1;
            i := i + 2;
          end;
          if tk = tyClass then PyInferLastCi := fci;
          Result := PyWiden(Result, tk);
          Continue;
        end;
        { Method form `name.upper(...)` on a string: the expression's type is
          the str method's result, and the whole postfix chain is skipped so the
          method name (a bare ident to this scanner) does not widen the result
          to variant — which would make an inferred local a variant and then
          scalar-load its TAG on return. Kept in step with PyParseStrMethod's
          table; anything not listed there Errors at parse time, so an unknown
          name never reaches here. }
        if ((tk = tyString) or (tk = tyAnsiString)) and (i + 3 < endIdx) and
           (Tokens[i + 1].Kind = tkDot) and (Tokens[i + 2].Kind = tkIdent) and
           (Tokens[i + 3].Kind = tkLParen) and
           PyStrMethodInfo(GetTokenStr(i + 2), smPName, tk, smArgs) then
        begin
          { A str method returning a CLASS returns a TPyList (split /
            splitlines). Record which class, or the inferred local carries
            tyClass with no identity and overload resolution mis-picks — len()
            on it chose the AnsiString overload and read a class pointer as a
            string handle, segfaulting. }
          if tk = tyClass then PyInferLastCi := FindUClass('TPyList');
          i := i + 3; depth := 0;
          while i < endIdx do
          begin
            if Tokens[i].Kind = tkLParen then Inc(depth)
            else if Tokens[i].Kind = tkRParen then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end;
            Inc(i);
          end;
          Result := PyWiden(Result, tk);
          Inc(i);
          Continue;
        end;
        { A SLICE `name[a:b]` is not an index: it yields a container of the
          same kind as the receiver — a str slice is a str, and slicing a
          KNOWN list yields a list. A variant/unknown receiver's slice used to
          be assumed to be a list too, but a variant can just as easily hold a
          str at runtime — `pyvar_slice` already dispatches on the tag and
          returns whichever is correct, so forcing tyClass/TPyList on the
          STATIC side made a string-holding variant's slice get unboxed as an
          object on return, coming back `[]` (empty) or, worse, SIGSEGV
          (bug-nilpy-subscript-and-slice-of-a-variant-get-the-wrong-static-type).
          Without any receiver-kind arm at all, a def whose body ended in
          `return b[:6]` fell to the Integer default instead
          (bug-nilpy-slice-of-variant-local-returned-is-unusable) — tyVariant
          for an unknown/variant receiver keeps that original fix (any
          non-Integer answer already unblocked it) while also handling the
          string case now that pyvar_slice's tag dispatch is trusted instead
          of guessed. Detected by a ':' at bracket depth 1. }
        if (i + 1 < endIdx) and (Tokens[i + 1].Kind = tkLBrack) and
           PySliceBracketAt(i + 1, endIdx) then
        begin
          if (tk = tyString) or (tk = tyAnsiString) or (tk = tyChar) then
            tk := tyAnsiString
          else if tk = tyClass then
          begin
            tk := tyClass;
            PyInferLastCi := FindUClass('TPyList');
          end
          else
          begin
            tk := tyVariant;
            PyInferLastCi := -1;
          end;
          i := i + 1; depth := 0;
          while i < endIdx do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(depth)
            else if Tokens[i].Kind = tkRBrack then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end;
            Inc(i);
          end;
          Result := PyWiden(Result, tk);
          Inc(i);
          Continue;
        end;
        { Subscript form `name[...]` on a list/dict/unconstrained variant: the
          element could be anything (a str, a float, a bool, another
          container), so the result is a VARIANT — not the tyInteger the
          fallthrough token walk below produced by mistakenly widening on the
          INDEX expression's own type (an int literal index made every
          `xs[i]` infer Integer, a string key happened to make `d[k]` infer
          string by the same accident). Skip the bracket group entirely so
          neither the index nor the element tokens reach that walk
          (bug-nilpy-return-type-inference-mistypes-several-expression-shapes,
          bug-nilpy-subscript-and-slice-of-a-variant-get-the-wrong-static-type).
          String/AnsiString/Char receivers are handled by the char-yielding arm
          right below instead. }
        if ((tk = tyClass) or (tk = tyVariant) or (tk = tyUnknown)) and
           (i + 1 < endIdx) and (Tokens[i + 1].Kind = tkLBrack) and
           not PySliceBracketAt(i + 1, endIdx) then
        begin
          tk := tyVariant;
          PyInferLastCi := -1;
          i := i + 1; depth := 0;
          while i < endIdx do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(depth)
            else if Tokens[i].Kind = tkRBrack then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end;
            Inc(i);
          end;
          Result := PyWiden(Result, tk);
          Inc(i);
          Continue;
        end;
        { Subscript form `name[...]` on a string yields a char; skip the
          bracket group so the index expression's int does not widen the
          result to variant. }
        if ((tk = tyString) or (tk = tyAnsiString)) and (i + 1 < endIdx) and
           (Tokens[i + 1].Kind = tkLBrack) then
        begin
          tk := tyChar;
          i := i + 1; depth := 0;
          while i < endIdx do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(depth)
            else if Tokens[i].Kind = tkRBrack then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end;
            Inc(i);
          end;
        end;
      end;
    end;
    if tk <> tyUnknown then Result := PyWiden(Result, tk);
    Inc(i);
  end;
end;

procedure PyRegisterClassShells;
var i: Integer;
begin
  { …asked PER UNIT, not flat. FindUClass matches on name alone, so once the
    MAIN PROGRAM had shelled `Filter`, an imported .py module declaring its own
    `Filter` registered no shell of its own and its declaration then FILLED the
    program's row — one row for two different classes.

    That is the same merge the Pascal-unit case was fixed for (the note in
    test_nilpy_class_named_after_its_imported_base.npy describes it exactly);
    the .py module path simply never got it. Its two faces:

      class Filter(base.Filter)    -> "cannot inherit from itself", because the
                                      base really WAS the row being declared;
      class Derived(other.Filter)  -> compiles clean and inherits the PROGRAM's
                                      Filter — a silent wrong answer, which is
                                      the half that matters.

    A class of the same name in another unit is a DIFFERENT class, so the shell
    must exist once per declaring unit.
    bug-n-a-qualified-base-class-named-like-its-subclass-is-rejected-as-self-inheritance }
  for i := PyScanLo to MainProgramTokCount - 2 do
    if (Tokens[i].Kind = tkClass) and (Tokens[i + 1].Kind = tkIdent) and
       (FindUClassInUnit(GetTokenStr(i + 1), CurrentUnitIdx) < 0) then
      { Marked FORWARD, because that is what these rows are: a stub so a class
        can be NAMED before its declaration is parsed, which the full parse then
        fills. Left unmarked they are indistinguishable from a real declaration,
        so the full parse looked like a SECOND class of the same name — which
        is what a duplicate-name diagnostic has to be able to tell apart
        (bug-pascal-duplicate-class-name-silently-shadows). The Pascal forward
        stub `TFoo = class;` already carries this flag and the class-declaration
        path already knows to reuse such a row rather than shadow it. }
      UClsForward[AddUClass(Tokens[i + 1].SOffset, Tokens[i + 1].SLen)] := True;
end;

{ (PyCollectLocals and PyCollectModuleLocals, the token-scanning local-typing
  pre-passes, were retired by PyCollectLocalsAST and PyCollectModuleLocalsAST
  — feature-n-nilpy-ast-based-typing. Both parse instead of scanning.
  PyInferExprType survives only for the CTOR FIELD scan, which still has no
  parseable block of its own: fields must exist before any body is parsed.) }


function PyFindBodyEnd(bodyStart: Integer): Integer;
var i, depth: Integer;
begin
  depth := 1;
  i := bodyStart;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if depth = 0 then begin Result := i; Exit; end;
    end;
    Inc(i);
  end;
  Error('Nil Python: unterminated indented block');
  Result := MainProgramTokCount;
end;

{ The bare pointer symbol holding a cell-promoted name's shared heap cell.
  Only the binders want this — everything else wants the VALUE. }
function PyMakeCellPtr(symIdx: Integer): Integer;
begin
  Result := AllocNode(AN_IDENT);
  ASTIVal[Result] := SymCellPtr[symIdx];
  ASTTk[Result] := Ord(tyPointer);
end;

function PyMakeIdent(symIdx: Integer): Integer;
begin
  { A cell-promoted name denotes the CELL'S CONTENTS, at every read and every
    write: `hidden^`, typed as the name's own logical type. Address-of a deref
    collapses back to the pointer (IRLowerAddress), so passing such a name to
    the by-ref parameter a `nonlocal` capture gets hands the callee the very
    same cell — which is the whole point (see SymCellPtr). }
  if SymCellPtr[symIdx] >= 0 then
  begin
    Result := AllocNode(AN_DEREF);
    ASTLeft[Result] := PyMakeCellPtr(symIdx);
    ASTTk[Result] := Ord(Syms[symIdx].TypeKind);
    Exit;
  end;
  Result := AllocNode(AN_IDENT);
  ASTIVal[Result] := symIdx;
  ASTTk[Result] := Ord(Syms[symIdx].TypeKind);
end;

function PyIntLiteralText(n: Int64): AnsiString;
var rev, res: AnsiString; negative: Boolean; i: Integer;
begin
  rev := '';
  res := '';
  negative := n < 0;
  if negative then n := -n;
  if n = 0 then
    AppendChar(rev, '0')
  else
    while n > 0 do
    begin
      AppendChar(rev, Chr(Ord('0') + (n mod 10)));
      n := n div 10;
    end;
  if negative then AppendChar(res, '-');
  for i := Length(rev) downto 1 do AppendChar(res, rev[i]);
  Result := res;
end;

function PyStoredName(const s: AnsiString): Integer;
var i: Integer;
begin
  Result := TokCharLen;
  for i := 1 to Length(s) do
  begin
    if TokCharLen >= STRING_CAP then Error('token char buffer overflow');
    TokChars[TokCharLen] := s[i];
    Inc(TokCharLen);
  end;
end;

function PyRawName(off, len: Integer): AnsiString;
var i: Integer; s: AnsiString;
begin
  s := '';
  for i := 0 to len - 1 do AppendChar(s, TokChars[off + i]);
  Result := s;
end;

{ A class ATTRIBUTE constant (`name = "x"` at class level) — the entry index for
  class ci or an inherited one, or -1. See the PyClsAttr* note in defs.inc. }
function PyFindClsAttr(ci: Integer; const nm: AnsiString): Integer;
var i, c: Integer;
begin
  Result := -1;
  c := ci;
  while c >= 0 do
  begin
    for i := 0 to PyClsAttrCount - 1 do
      if (PyClsAttrCi[i] = c) and
         CaseEqual(PyRawName(PyClsAttrNOff[i], PyClsAttrNLen[i]), nm) then
      begin
        Result := i;
        Exit;
      end;
    c := UClsParent[c];
  end;
end;

{ The hidden GLOBAL that holds a non-literal class attribute's one value —
  `mode = Inner()` evaluated once, as Python evaluates a class body once. Named
  rather than tracked in a side table on purpose: the symbol table already is
  the registry, and the construction path finds the value by rebuilding the same
  name from the class and field it is copying. }
{ The hidden global holding a dataclass field's evaluated EXPRESSION default.
  Its own namespace, not the class-attribute one, because the two are different
  storage models that happen to share an evaluation point. }
function PyDcDefaultGlobalName(ci: Integer; const nm: AnsiString): AnsiString;
begin
  Result := '$dcdef.' + PyRawName(UClsNOff[ci], UClsNLen[ci]) + '.' + nm;
end;

function PyClsAttrGlobalName(ci: Integer; const nm: AnsiString): AnsiString;
begin
  Result := '$clsattr.' + PyRawName(UClsNOff[ci], UClsNLen[ci]) + '.' + nm;
end;

function PyClassDepth(ci: Integer): Integer;
{ How many classes are in ci's chain, ci itself included. }
begin
  Result := 0;
  while ci >= 0 do begin Inc(Result); ci := UClsParent[ci]; end;
end;

function PyClassAncestorAt(ci, up: Integer): Integer;
{ ci's ancestor `up` steps above it — 0 is ci, PyClassDepth(ci)-1 is the root.

  The pair exists so that both class-attribute emitters can walk the chain
  ROOT-FIRST without a local array and without agreeing on one by accident:
  a subclass that redeclares an attribute must store LAST, so its value wins.
  Class hierarchies are shallow, so the quadratic walk is free and the absence
  of a shared buffer is worth more than the saved steps. }
begin
  Result := ci;
  while (up > 0) and (Result >= 0) do begin Result := UClsParent[Result]; Dec(up); end;
end;

function PyClsAttrEnsureGlobal(ci, nOff, nLen: Integer; tk: TTypeKind;
                              rec: Integer; needsOvr: Boolean): Integer;
{ The single shared slot behind a class attribute, registered as a CLASS VAR of
  `ci` so that all three access routes reach it with no new lookup code:

    C.attr        parser.inc's ClassName.member branch (FindClassVar)
    attr          the bare-name branch inside a method body
    inst.attr     the "class variable through an instance" branch — which fires
                  only when the class has no instance FIELD of that name, i.e.
                  exactly when this attribute was lowered as a shared slot

  Registering it for EVERY class attribute (not only the shared-slot ones) is
  what makes `C.attr` readable in the copy-at-construction rows too: there the
  field carries the instance reads and this global carries the class-name ones,
  and nothing can make them disagree because nothing writes through the class
  name (PyClsAttrWriteScan). }
var nm: AnsiString; i: Integer;
begin
  nm := PyRawName(nOff, nLen);
  Result := FindSym(PyClsAttrGlobalName(ci, nm));
  if Result < 0 then
  begin
    Result := AllocVar(PyClsAttrGlobalName(ci, nm), tk);
    Syms[Result].RecName := rec;
    SymSyncTypeRef(Result);
  end;
  { own-class registration only — FindClassVar walks the PARENT chain, so using
    it here would let a subclass that redeclares the attribute silently share
    the ancestor's slot }
  for i := 0 to ClassVarCount - 1 do
    if (ClassVarCi[i] = ci) and
       (GetTokenStrFromRaw(ClassVarNOff[i], ClassVarNLen[i]) = nm) then
    begin
      if needsOvr then ClassVarPyOvr[i] := True;
      Exit;
    end;
  if ClassVarCount >= MAX_TYPEALIAS then Error('too many class variables');
  ClassVarCi[ClassVarCount]   := ci;
  ClassVarNOff[ClassVarCount] := nOff;
  ClassVarNLen[ClassVarCount] := nLen;
  ClassVarSym[ClassVarCount]  := Result;
  ClassVarPyOvr[ClassVarCount] := needsOvr;
  Inc(ClassVarCount);
end;

function PyClassIsKinOf(a, b: Integer): Boolean;
{ Is a an ancestor or a descendant of b (or b itself)? The same walk
  PyClassKinUsedAsValueEx does inline. }
var c: Integer;
begin
  Result := False;
  c := a;
  while c >= 0 do begin if c = b then begin Result := True; Exit; end; c := UClsParent[c]; end;
  c := b;
  while c >= 0 do begin if c = a then begin Result := True; Exit; end; c := UClsParent[c]; end;
end;

function PyClsAttrRedeclaredCi(ci: Integer; const nm: AnsiString): Boolean;
{ Do TWO classes in ci's line of descent declare a class attribute of this name?
  Then a read through an instance cannot be resolved at COMPILE time: which slot
  is right depends on the receiver's runtime class, and resolving it against the
  class that declares the METHOD is what made `self.kind` inside a base method
  answer the base's value for a Derived instance.

  Asked of the CLASSVAR table rather than by re-scanning tokens (which is what
  PyClsAttrRedeclaredInChain does, in the pre-pass, before the table exists):
  by the time a method BODY is parsed every declaring class has its slot.
  bug-nilpy-self-class-attribute-in-an-inherited-method-reads-the-base-value }
var i, c, n: Integer;
begin
  Result := False;
  if ci < 0 then Exit;
  n := 0;
  for c := 0 to UClsCount - 1 do
  begin
    if UClsIsRecord[c] then Continue;
    if not (PyClassIsKinOf(c, ci)) then Continue;
    for i := 0 to ClassVarCount - 1 do
      if (ClassVarCi[i] = c) and
         (GetTokenStrFromRaw(ClassVarNOff[i], ClassVarNLen[i]) = nm) then
      begin
        Inc(n);
        Break;
      end;
  end;
  Result := n > 1;
end;

function PyMakeClsAttrInstGet(baseNode: Integer; const fname: AnsiString): Integer;
{ `self.attr` / `obj.attr` where attr is a class attribute REDECLARED in the
  chain — read it off the RECEIVER's runtime class instead of the declaring
  one. Built here so both the `self.` site and the instance site in parser.inc
  emit the same call.
  bug-nilpy-self-class-attribute-in-an-inherited-method-reads-the-base-value }
var procIdx, a0, a1, nameNode: Integer;
begin
  Result := -1;
  procIdx := FindProc('pyclsattr_inst_get');
  if procIdx < 0 then Exit;
  nameNode := AllocNode(AN_STR_LIT);
  ASTSOffset[nameNode] := PyStoredName(fname);
  ASTSLen[nameNode] := Length(fname);
  ASTTk[nameNode] := Ord(tyString);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := PyMakeObjPtr(baseNode);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameNode; ASTRight[a1] := -1;
  ASTRight[a0] := a1;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := procIdx;
  ASTTk[Result] := Ord(tyVariant);
  ASTLeft[Result] := a0;
end;

function PyClsAttrOvrSlot(ci: Integer; const fname: AnsiString): Integer;
{ The shared slot of a class attribute that ALSO needs per-instance overrides —
  written through the class name AND through an instance. -1 for every other
  attribute, including the shared-slot ones that no instance ever writes, which
  read straight from the slot with no run-time check. Walks the parent chain, as
  FindClassVar does, so a subclass instance sees the ancestor's attribute. }
var i, cur: Integer;
begin
  Result := -1;
  cur := ci;
  while cur >= 0 do
  begin
    for i := 0 to ClassVarCount - 1 do
      if (ClassVarCi[i] = cur) and ClassVarPyOvr[i] and
         (GetTokenStrFromRaw(ClassVarNOff[i], ClassVarNLen[i]) = fname) then
      begin Result := ClassVarSym[i]; Exit; end;
    cur := UClsParent[cur];
  end;
end;

function PyClsAttrSharedSym(const fname: AnsiString; var needsOvr: Boolean): Integer;
{ The shared class-attribute slot named `fname`, for a receiver whose class is
  NOT known statically — a plain NilPy local, which the frontend types as a
  variant. The statically-typed routes reach the same slot through FindClassVar;
  this is the variant receiver's equivalent, and it sits beside
  PyMakeVariantField (resolve-by-name across the declared classes) for the same
  reason: there is no class to key on, only a name.

  Only slots with no instance FIELD of that name qualify — those are exactly the
  class-written attributes, the ones where the field was deliberately not
  emitted. Returns -1 when no class offers the name, and ALSO when more than one
  distinct slot does: an ambiguous guess here would be a silently wrong value,
  where falling through leaves today's loud AttributeError. }
var i: Integer;
begin
  Result := -1;
  needsOvr := False;
  for i := 0 to ClassVarCount - 1 do
    if (GetTokenStrFromRaw(ClassVarNOff[i], ClassVarNLen[i]) = fname) and
       (FindUField(ClassVarCi[i], fname) < 0) then
    begin
      if Result < 0 then
      begin Result := ClassVarSym[i]; needsOvr := ClassVarPyOvr[i]; end
      else if Result <> ClassVarSym[i] then
      begin Result := -1; needsOvr := False; Exit; end;
    end;
end;

function PyClsAttrOvrGet(baseNode: Integer; const fname: AnsiString;
                         gsym: Integer): Integer;
{ `inst.attr` for a class attribute with per-instance overrides — Python's
  fall-through, spelled out:

      pydynattr_has(inst, "attr") ? pydynattr_get(inst, "attr") : <shared slot>

  The override store is the SAME `pydynattr` machinery an undeclared dynamic
  attribute uses, which is why this is wiring rather than new runtime: an
  instance write of a declared class attribute and one of an ad-hoc attribute
  are the same operation in Python, and now in the lowering too.

  Both arms are boxed to a variant so the ternary has one representation — the
  slot's own type is whatever the initialiser produced, and letting a raw scalar
  arm meet a variant arm reads the wrong bits. }
var hasIdx, boxIdx, a0, a1, nameN, hasCall, slotN, boxCall, pairN: Integer;
begin
  { the receiver appears in BOTH the test and the get arm, and an AST node used
    twice is EMITTED twice — `make_one().attr` would construct two objects and
    ask the second one about the first one's override }
  baseNode := PyEvalOnce(baseNode);
  hasIdx := FindProc('pydynattr_has');
  if hasIdx < 0 then Error('Nil Python: pylib (pydynattr_has) not loaded');
  boxIdx := FindProc('pyvar_box');
  if boxIdx < 0 then Error('Nil Python: pylib (pyvar_box) not loaded');

  nameN := AllocNode(AN_STR_LIT);
  ASTSOffset[nameN] := PyStoredName(fname);
  ASTSLen[nameN] := Length(fname);
  ASTTk[nameN] := Ord(tyString);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := PyMakeObjPtr(baseNode);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := nameN; ASTRight[a1] := -1;
  ASTRight[a0] := a1;
  hasCall := AllocNode(AN_CALL);
  ASTIVal[hasCall] := hasIdx;
  ASTTk[hasCall] := Ord(tyBoolean);
  ASTLeft[hasCall] := a0;

  slotN := AllocNode(AN_IDENT);
  ASTIVal[slotN] := gsym;
  ASTTk[slotN] := Ord(Syms[gsym].TypeKind);
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := slotN; ASTRight[a0] := -1;
  boxCall := AllocNode(AN_CALL);
  ASTIVal[boxCall] := boxIdx;
  ASTTk[boxCall] := Ord(tyVariant);
  ASTLeft[boxCall] := a0;

  pairN := AllocNode(AN_PAIR);
  ASTLeft[pairN] := PyForceVariant(PyMakeDynAttrGet(baseNode, fname));
  ASTRight[pairN] := boxCall;
  Result := AllocNode(AN_TERNARY);
  ASTLeft[Result] := hasCall;
  ASTRight[Result] := pairN;
  ASTTk[Result] := Ord(tyVariant);
end;

procedure PyClsAttrWriteScan(const clsName, attrName: AnsiString;
                             var classW, instW: Boolean);
{ The whole-module scan that picks the lowering for one class attribute.
  Answers two separate questions about `.attrName` STORES:

    classW - written through the CLASS NAME (`C.attr = 5`, `C.attr += 1`)
    instW  - written through anything else (`self.attr = 5`, `obj.attr = 5`,
             `f().attr = 5`)

  Python's model is that a class attribute lives on the CLASS and an instance
  read falls through to it, while an instance write creates a per-instance
  override. Copy-at-construction — what this frontend does — is provably
  indistinguishable from that model as long as nothing writes through the class
  name after construction, which is why `classW` is the whole question: without
  it the cheap lowering stays correct, with it the attribute must become one
  shared slot. `instW` then separates the two remaining rows: class-written but
  never instance-written is still a single slot (no override can exist);
  BOTH written is the only row that needs a real per-instance override.

  A receiver that is not a bare identifier counts as an instance write: it
  cannot be the class name spelled literally, and over-counting here only ever
  costs generality, never correctness.

  `setattr` anywhere forces the instance side on for the same reason
  PyDynAttrEverAssigned does — the target is not visible in the tokens. }
var j: Integer;
begin
  classW := False;
  instW := False;
  if attrName = '' then Exit;
  j := 1;
  while j < MainProgramTokCount do
  begin
    if (Tokens[j].Kind = tkIdent) and CaseEqual(GetTokenStr(j), 'setattr') then
      instW := True
    else if (Tokens[j].Kind = tkIdent) and (Tokens[j - 1].Kind = tkDot) and
            (j + 1 < MainProgramTokCount) and
            (Tokens[j + 1].Kind in [tkAssign, tkPlusEq, tkMinusEq, tkStarEq,
                                    tkSlashEq, tkModEq, tkTrueDivEq, tkAmpEq,
                                    tkPipeEq, tkXorEq, tkShlEq, tkShrEq,
                                    tkAtEq]) and
            (GetTokenStr(j) = attrName) then
    begin
      if (j >= 2) and (Tokens[j - 2].Kind = tkIdent) and
         (GetTokenStr(j - 2) = clsName) then
        classW := True
      else
        instW := True;
    end;
    Inc(j);
  end;
end;

function PyClsAttrEqIdx(nameIdx, stopIdx: Integer): Integer;
{ Token index of the `=` binding the class attribute whose NAME sits at nameIdx,
  stepping over an optional `: <annotation>`. -1 when the line has no
  initialiser (`n: int`, which in Python is an annotation and binds nothing).

  Annotated class attributes were invisible on BOTH sides: the class body only
  matched a name followed directly by `=`, so `n: int = 0` fell through to the
  method branch and died with "Expected: def, but got: n"; and the member
  pre-pass matched the same shape, so even once it parsed there was no FIELD to
  read. Only a @dataclass accepted them, through its own field branch
  (bug-nilpy-annotated-class-attribute-fails-to-parse). One helper for both
  readers, deliberately: they must agree on where the initialiser starts, and a
  disagreement here is a field registered at one type and read at another.

  Brackets are balanced so a subscripted annotation (`List[int]`,
  `ClassVar[int]`, `Dict[str, int]`) cannot end the scan early. }
var k, depth: Integer;
begin
  Result := -1;
  k := nameIdx + 1;
  if k >= stopIdx then Exit;
  if Tokens[k].Kind = tkAssign then begin Result := k; Exit; end;
  if Tokens[k].Kind <> tkColon then Exit;
  Inc(k);
  depth := 0;
  while k < stopIdx do
  begin
    if Tokens[k].Kind in [tkLBrack, tkLParen] then Inc(depth)
    else if Tokens[k].Kind in [tkRBrack, tkRParen] then Dec(depth)
    else if (depth = 0) and (Tokens[k].Kind = tkAssign) then begin Result := k; Exit; end
    else if Tokens[k].Kind in [tkNewline, tkDedent, tkEOF] then Exit;
    Inc(k);
  end;
end;

function PyClsAttrAssignAt: Integer;
{ The cursor-side spelling: CurTok is the attribute name, so its token index is
  TokPos - 1. }
begin
  Result := PyClsAttrEqIdx(TokPos - 1, TokCount);
end;

{ Is the class-body line at CurTok an attribute whose initialiser needs REAL
  evaluation? CurTok is the name, eqAt the index of its '='. A single literal
  followed by the end of the line is the folded-constant case the pre-pass
  already took. }
function PyClsAttrExprAhead(eqAt: Integer): Boolean;
var k: Integer;
begin
  Result := False;
  if eqAt < 0 then Exit;
  k := eqAt + 1;                  { the token after '=' }
  if k >= TokCount then Exit;
  if (Tokens[k].Kind in [tkInteger, tkFloat, tkString, tkTrue, tkFalse, tkNil]) and
     (k + 1 < TokCount) and (Tokens[k + 1].Kind in [tkNewline, tkDedent, tkEOF]) then
    Exit;
  Result := True;
end;

procedure PyClsAttrRedeclScan;
{ Build the redeclaration table: every class-level attribute declaration in the
  module, with its class and that class's base, from TOKENS.

  Why a whole-module scan and not the class registration itself: the question
  "does another class in this chain declare the same attribute" depends on
  classes declared LATER in the module, and the lowering for the BASE has to be
  chosen before those are seen. Same reason, and the same shape, as
  PyClsAttrWriteScan and PyDynAttrEverAssigned.

  The header walk and the class-level-attribute predicate are deliberately
  copied from PyRegisterClassFieldsPrepass and PyRegisterClassMembers: if the
  two disagree about what a class body or a class attribute IS, the demotion
  lands on a different set of attributes than the lowering does, which is the
  double-reader bug that already cost this family a segfault
  (bug-nilpy-non-literal-class-attribute-corrupts-the-class-layout). }
var i, j, d, bs, be, ci, bodyDepth: Integer;
begin
  if PyRdScanned then Exit;
  PyRdScanned := True;
  PyRdCount := 0;
  PyRdAtCount := 0;
  PyRdOverflow := False;
  { PyScanLo, not 1 — the same start PyRegisterClassFieldsPrepass uses. Starting
    at 1 stepped over a class declared at the very top of the module, which is
    where a BASE class usually sits, so the one declaration the chain check most
    needed was the one always missing. }
  i := PyScanLo;
  while i < MainProgramTokCount - 2 do
  begin
    if (Tokens[i].Kind = tkClass) and (Tokens[i + 1].Kind = tkIdent) then
    begin
      if PyRdCount >= 256 then begin PyRdOverflow := True; Exit; end;
      ci := PyRdCount;
      PyRdClsTok[ci] := i + 1;
      PyRdBaseTok[ci] := -1;
      if (Tokens[i + 2].Kind = tkLParen) and (Tokens[i + 3].Kind = tkIdent) then
        PyRdBaseTok[ci] := i + 3;
      Inc(PyRdCount);
      { header -> the colon that ends it, honouring a parenthesised base list }
      j := i + 2;
      d := 0;
      while j < MainProgramTokCount do
      begin
        if Tokens[j].Kind = tkLParen then Inc(d)
        else if Tokens[j].Kind = tkRParen then Dec(d)
        else if (Tokens[j].Kind = tkColon) and (d = 0) then Break
        else if Tokens[j].Kind in [tkNewline, tkEOF] then Break;
        Inc(j);
      end;
      { the indented shape is COLON NEWLINE INDENT; anything else is one-line
        and declares nothing this scan cares about }
      if (j + 2 < MainProgramTokCount) and (Tokens[j].Kind = tkColon) and
         (Tokens[j + 1].Kind = tkNewline) and (Tokens[j + 2].Kind = tkIndent) then
      begin
        bs := j + 3;
        be := PyFindBodyEnd(bs);
        bodyDepth := 0;
        j := bs;
        while j < be do
        begin
          if Tokens[j].Kind = tkIndent then Inc(bodyDepth)
          else if Tokens[j].Kind = tkDedent then Dec(bodyDepth)
          else if (bodyDepth = 0) and (Tokens[j].Kind = tkIdent) and
                  ((j = bs) or
                   (Tokens[j - 1].Kind in [tkNewline, tkIndent, tkDedent])) and
                  (PyClsAttrEqIdx(j, be) >= 0) then
          begin
            if PyRdAtCount >= 1024 then begin PyRdOverflow := True; Exit; end;
            PyRdAtCls[PyRdAtCount] := ci;
            PyRdAtTok[PyRdAtCount] := j;
            Inc(PyRdAtCount);
          end;
          Inc(j);
        end;
      end;
      { deliberately NOT jumping i past the body: PyFindBodyEnd can land exactly
        ON the next `class` token, and `i := be` plus the loop's Inc(i) then
        stepped straight over it — three classes found where the module had
        four, so the last redeclaration went unseen and nothing demoted. Walking
        token by token also picks up a class nested inside another body. }
    end;
    Inc(i);
  end;
end;

function PyRdIsAncestor(descIdx, ancIdx: Integer): Boolean;
{ Does `descIdx`'s base chain reach `ancIdx`? Bounded by the table size so a
  cyclic or self-referential base list cannot spin. }
var cur, k, guard: Integer; baseNm: AnsiString;
begin
  Result := False;
  cur := descIdx;
  guard := 0;
  while (cur >= 0) and (guard <= PyRdCount) do
  begin
    if cur = ancIdx then begin Result := True; Exit; end;
    if PyRdBaseTok[cur] < 0 then Exit;
    baseNm := GetTokenStr(PyRdBaseTok[cur]);
    cur := -1;
    for k := 0 to PyRdCount - 1 do
      if GetTokenStr(PyRdClsTok[k]) = baseNm then begin cur := k; Break; end;
    Inc(guard);
  end;
end;

function PyClsAttrRedeclaredInChain(const clsName, attrName: AnsiString): Boolean;
{ True when some OTHER class related to clsName by inheritance — in either
  direction — also declares a class-level attribute called attrName.

  Either direction on purpose: the base must leave the copy lowering just as the
  subclass must. FindUField walks the parent chain, so if the base keeps a field
  while the subclass takes the shared slot, a subclass instance still finds the
  INHERITED field and the class-var arm never fires. The whole chain has to
  agree or nothing does.

  Name-keyed and case-SENSITIVE, matching Python and the rest of the NilPy
  frontend. On table overflow answers True — demotion is the correct model and
  merely costs the copy optimization, so failing that way is safe. }
var a, b, ia, ib: Integer;
begin
  Result := False;
  PyClsAttrRedeclScan;
  if PyRdOverflow then begin Result := True; Exit; end;
  for a := 0 to PyRdAtCount - 1 do
  begin
    if GetTokenStr(PyRdAtTok[a]) <> attrName then Continue;
    ia := PyRdAtCls[a];
    if GetTokenStr(PyRdClsTok[ia]) <> clsName then Continue;
    for b := 0 to PyRdAtCount - 1 do
    begin
      if b = a then Continue;
      if GetTokenStr(PyRdAtTok[b]) <> attrName then Continue;
      ib := PyRdAtCls[b];
      if ib = ia then Continue;
      if PyRdIsAncestor(ib, ia) or PyRdIsAncestor(ia, ib) then
      begin Result := True; Exit; end;
    end;
  end;
end;

{ Evaluate one such attribute into its hidden global, at the point the class
  statement runs. CurTok is the attribute name. }
procedure PyEmitClassAttrExpr(ci: Integer; eqAt: Integer);
var nm, gname: AnsiString; gsym, valNode, asgn, fi: Integer;
begin
  nm := CurTok.SVal;
  { jump to the '=' rather than assuming it is the very next token — an
    ANNOTATED attribute (`mode: Mode = Inner()`) has the annotation in between }
  TokPos := eqAt;
  Next;                            { CurTok = '=' }
  Next;                            { onto the expression }
  PyParseBoolExpr;
  valNode := CurASTNode;
  gname := PyClsAttrGlobalName(ci, nm);
  { the member pre-pass already allocated this slot and registered it as a class
    var (PyClsAttrEnsureGlobal) — RETYPE it here rather than allocating a second
    one, because the pre-pass had only the tokens to go on }
  gsym := FindSym(gname);
  if gsym < 0 then
  begin
    gsym := AllocVar(gname, IntToTypeKind(ASTTk[valNode]));
    Syms[gsym].RecName := ResolveNodeRec(valNode);
    SymSyncTypeRef(gsym);
  end
  else if PyClsAttrExprAhead(eqAt) then
  begin
    { retype only for an EXPRESSION initialiser — see the field note below }
    Syms[gsym].TypeKind := IntToTypeKind(ASTTk[valNode]);
    Syms[gsym].RecName := ResolveNodeRec(valNode);
    SymSyncTypeRef(gsym);
  end;
  { RETYPE the field to what the initialiser actually produced. The pre-pass had
    only the tokens to go on and defaulted to a variant; a list or dict literal
    yields a CLASS handle, and storing one into a variant slot left the tag
    garbage — `Cfg().LIMITS[1]` read None. The slot was laid out variant-sized
    (16 bytes), so a narrower kind always fits. }
  fi := FindUField(ci, nm);
  { ...but only for a genuine EXPRESSION initialiser. A single-literal one is now
    routed through here too (so its shared slot gets a value like every other
    attribute's), and there the pre-pass's typing is the authority: it maps
    tkString to tyAnsiString, while the literal NODE is tyString — and a tyString
    FIELD means an inline string[N] to the store path, which is a different
    layout entirely. }
  if (fi >= 0) and PyClsAttrExprAhead(eqAt) then
  begin
    UFldTk[fi] := ASTTk[valNode];
    UFldRec_[fi] := Syms[gsym].RecName;
  end;
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(gsym);
  ASTRight[asgn] := valNode;
  PyHoistStmt(asgn);
  while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
end;

{ That constant as an expression node. }
function PyClsAttrNode(ai: Integer): Integer;
begin
  case PyClsAttrKind[ai] of
    PYDC_STR:
      begin
        Result := AllocNode(AN_STR_LIT);
        ASTSOffset[Result] := PyClsAttrSOff[ai];
        ASTSLen[Result] := PyClsAttrSLen[ai];
        ASTTk[Result] := Ord(tyString);
      end;
    PYDC_FLOAT:
      begin
        Result := AllocNode(AN_FLOAT_LIT);
        ASTIVal[Result] := PyClsAttrIVal[ai];
        ASTTk[Result] := Ord(tyDouble);
      end;
    PYDC_BOOL:
      begin
        Result := AllocNode(AN_INT_LIT);
        ASTIVal[Result] := PyClsAttrIVal[ai];
        ASTTk[Result] := Ord(tyBoolean);
      end;
    PYDC_NIL:
      Result := PyMakeNone;
  else
    begin
      Result := AllocNode(AN_INT_LIT);
      ASTIVal[Result] := PyClsAttrIVal[ai];
      ASTTk[Result] := Ord(tyInt64);
    end;
  end;
end;

function PyClassCreate: Integer; forward;
{ Defined far below, next to the method-call paths that were its first callers;
  PyClassCreate uses it too, and the FPC SEED needs the forward because it
  compiles this include top-down (bug-a-fpc-seed-drift-emitasmx64-forward — the
  self-hosted build resolves it either way, so only the seed canary sees this). }
procedure PyStarExpandCallArgs(procIdx, firstSlot: Integer;
                               var headArg, lastArg: Integer); forward;

{ Is the construction at CurTok followed by a `.name(` suffix — `Cls().m(...)`?
  Then the statement's right-hand side is a CALL whose receiver happens to be a
  construction, not a construction on its own. Scans past the ctor's own
  argument list, which may itself contain parentheses. }
function PyCtorSuffixAhead: Boolean;
var i, depth: Integer;
begin
  Result := False;
  i := TokPos;                     { the '(' after the class name }
  depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then
      begin
        Result := (i + 2 < TokCount) and (Tokens[i + 1].Kind = tkDot) and
                  (Tokens[i + 2].Kind = tkIdent);
        Exit;
      end;
    end
    else if Tokens[i].Kind in [tkNewline, tkEOF] then Exit;
    Inc(i);
  end;
end;

function PyCtorEndsRhs: Boolean;
{ Does the construction at CurTok END the right-hand side, or is it merely the
  FIRST operand of a larger expression? `x = C(1)` is a construction
  assignment; `x = C(1) == y`, `x = C(1) is y`, `x = C(1) if c else C(2)` are
  expressions that happen to start with one.

  The construction fast-path used to be claimed on the OPENING shape alone
  (class name + `(`, minus the `.method(` suffix case), i.e. it claimed the
  first token without checking the construct ended — so every binary operator
  after a bare construction died at statement level: `K(1) == k2` and
  `K(1) in [k1]` reported "expected expression", `K(1) is k2` reported
  "undefined variable (is)". The identical expressions with the construction
  bound to a NAME first, or merely parenthesised (`(K(1)) is k2`), were always
  fine, which is what disguised this as an `is`-specific parse bug.
  bug-nilpy-construction-on-the-right-of-is-does-not-parse }
var i, depth: Integer;
begin
  PyCtorEndsRhs := False;
  i := TokPos;                     { the '(' after the class name }
  depth := 0;
  while i < TokCount do
  begin
    if Tokens[i].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(depth)
    else if Tokens[i].Kind in [tkRParen, tkRBrack, tkEnd] then
    begin
      Dec(depth);
      if depth = 0 then
      begin
        PyCtorEndsRhs := (i + 1 >= TokCount) or
                         (Tokens[i + 1].Kind in [tkNewline, tkDedent, tkEOF,
                                                 tkSemicolon]);
        Exit;
      end;
    end
    else if Tokens[i].Kind in [tkNewline, tkEOF] then Exit;
    Inc(i);
  end;
end;

{ `_count(1)` (the itertools.count alias) -> a fresh TPyCounter. }
(* `set()` — Python's empty-set constructor. There is no empty-set LITERAL in
   Python (empty braces are a dict), so this call is the only way to write one,
   and it is how the uforth VM initialises its required-files guard.

   Recognised at the assignment-RHS intercepts rather than as a general
   expression: `set` is not a registered proc, so anywhere else it still says
   "undefined variable (set)". Every censused use is an assignment; widen this
   if a corpus ever calls set() in an argument position. *)
{ A CONSTANT parameter default at token index j (`= None`, `= False`,
  `= 0`, `= -1`, `= ""`), for both the class pre-pass and PyParseDef. Advances
  j past the value and returns the ordinal; a string default reports itself
  through isStr plus the char-pool span, matching the ProcParamDefault* arrays
  the shared call path already fills omitted trailing args from.

  None is 0 — the same sentinel PyAnnTypeAt gives Optional[X], so `x: Optional[Word] = None`
  and a nil class reference agree. A NON-constant default (a name, a call, a
  list) is a clean error rather than a guess: Python evaluates it ONCE at
  definition time, and quietly picking either "once" or "per call" would be a
  silent semantic difference. }
{ The pending-slot index for a default identified by its hidden global. One
  entry per (def, param), because the `$pdef.*` name is fully qualified -- a def
  re-parsed on a later pass finds its own entry again rather than adding a
  second one that could never be resolved. }
function PyDfltPendFor(key: Integer): Integer;
var i: Integer;
begin
  { Keyed on the hidden global's NAME, not its symbol INDEX. A trial parse that
    is rolled back re-allocates the symbol at whatever index is free next, so
    the def-time store (built during the header parse) and EmitPySignatures
    (which reads ProcParamDefaultSym after every registration site has settled)
    can hold two different indices for one parameter. Keyed on the index they
    then missed each other, the store went to the bit bucket, and the slot kept
    PYSIG_DFLT_UNSET -- which surfaced as "parameter 2 has no recorded default"
    on a perfectly ordinary `def r(a, i=7, s="hi", L=None)` as soon as a second
    def in the same file had a default too. The `$pdef.<cls>.<nest>.<def>.<param>`
    NAME is stable across the re-allocation, which is the whole reason it is
    fully qualified. Same recycled-index hazard as
    bug-nilpy-a-nested-defs-default-parameter-is-read-from-a-rolled-back-symbol,
    one level up. }
  if key < 0 then begin Result := 0; Exit; end;
  for i := 0 to PyDfltPendCount - 1 do
    if PyDfltPendSym[i] = key then begin Result := i; Exit; end;
  if PyDfltPendCount >= PY_MAX_DFLT_PEND then
  begin
    Error('too many non-constant parameter defaults in one module '
          + '(see PY_MAX_DFLT_PEND in compiler/defs.inc)');
    Result := 0;
    Exit;
  end;
  Result := PyDfltPendCount;
  PyDfltPendSym[Result] := key;
  PyDfltPendOff[Result] := -1;
  Inc(PyDfltPendCount);
end;

function PyEvalParamDefault(var j: Integer; const pname: AnsiString): Integer;
{ Evaluate a NON-CONSTANT parameter default into a hidden global and return that
  global's symbol (-1 if the expression could not be parsed as a value).

  Python evaluates a default ONCE, at DEF time, in the scope where the def
  stands. `j` is a token INDEX (the header is walked by index, not by the
  cursor), so the cursor is parked here, moved to the expression, and put back —
  and put back by RE-READING Tokens[], never by restoring a saved copy of
  CurTok: `Next` does SetLength(CurTok.SVal, ...) in place, so a record copy
  taken beforehand comes back holding whatever token the detour stopped on.
  That is a compiler segfault, not a subtle wrong type. Same rule as the trial
  parse in PyCollectLocalsAST.

  The global is named, not serial-numbered, so the typing pre-pass and the real
  parse converge on the SAME symbol: a serial would hand the real parse a fresh
  symbol while ProcParamDefaultSym still pointed at one the pre-pass rolled
  back — a recycled index, i.e. a plausible wrong value. }
var gname: AnsiString; gsym, valNode, asgn, savedTok, savedHoist, h: Integer;
    slot, slotAddr, sigAsgn: Integer;
    savedCurProc: Integer;
begin
  Result := -1;
  savedTok := TokPos;
  { A value is not always ONE expression node: a list/dict literal, an f-string
    and a comprehension all HOIST setup statements (the pylist_new plus an
    append per element) and hand back a node that merely names the result. Those
    statements must travel with the assignment into the def-init queue — left on
    the hoist chain they are discarded by PyParseDef on the way out, and the
    default global then held a list that was never built: `len(b)` reported
    "expected an object with a length, got object". Swapped out and spliced
    below, the same way the nested-comprehension parse does it. }
  savedHoist := PyHoistHead;
  PyHoistHead := -1;
  TokPos := j;
  Next;
  PyParseBoolExpr;
  valNode := CurASTNode;
  j := TokPos - 1;
  if valNode < 0 then
  begin
    PyHoistHead := savedHoist;
    TokPos := savedTok - 1;
    Next;
    Exit;
  end;
  gname := '$pdef.';
  if PyDefaultClsName <> '' then gname := gname + PyDefaultClsName + '.';
  if PyNestPrefix <> '' then gname := gname + PyNestPrefix + '.';
  gname := gname + PyHdrName + '.' + pname;
  gsym := FindSym(gname);
  if gsym < 0 then
  begin
    { Force a BSS GLOBAL even when this runs INSIDE a routine, which it does for
      a NESTED def: its defaults are evaluated at the `def` statement (the only
      point the enclosing scope is live), so CurProc is the enclosing routine and
      AllocVar would otherwise hand back a LOCAL OF THAT ROUTINE. The nested body
      is compiled later as its own top-level proc and reads the symbol as a
      global, so a local produced "invalid IR symbol reference in store_sym".
      Safe as a straight save/restore: the two AllocVar branches are disjoint —
      the global arm touches only BSSSize, the local arm only FrameSize — so the
      enclosing frame is untouched.
      bug-nilpy-non-constant-parameter-defaults-silently-become-none }
    savedCurProc := CurProc;
    CurProc := -1;
    gsym := AllocVar(gname, IntToTypeKind(ASTTk[valNode]));
    CurProc := savedCurProc;
    Syms[gsym].RecName := ResolveNodeRec(valNode);
    SymSyncTypeRef(gsym);
  end;
  { the value's own setup first, then the store — order matters }
  h := PyHoistHead;
  PyHoistHead := savedHoist;
  while h >= 0 do
  begin
    if ASTLeft[h] >= 0 then PyQueueDefInit(ASTLeft[h]);
    h := ASTRight[h];
  end;
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(gsym);
  ASTRight[asgn] := valNode;
  PyQueueDefInit(asgn);
  { ...and copy it into this def's SIGNATURE defaults array, so a call made
    THROUGH A CALLABLE VALUE can fill an omitted parameter the same way a direct
    call does. Queued after the store above and so ordered behind it, which is
    what makes this a COPY of the def-time value rather than a second
    evaluation -- Python evaluates a default exactly once, and re-evaluating is
    how the shared-mutable-default idiom stops accumulating.
    The slot address is a pending sentinel: the Proc does not exist yet.
    feature-n-a-callable-value-carries-its-signature-type }
  slotAddr := AllocNode(AN_PYSIGDSLOT);
  ASTIVal[slotAddr] := PyDfltPendFor(InternStr(gname));
  ASTTk[slotAddr] := Ord(tyPointer);
  slot := AllocNode(AN_DEREF);
  ASTLeft[slot] := slotAddr;
  ASTTk[slot] := Ord(tyVariant);
  sigAsgn := AllocNode(AN_ASSIGN);
  ASTLeft[sigAsgn] := slot;
  ASTRight[sigAsgn] := PyMakeIdent(gsym);
  PyQueueDefInit(sigAsgn);
  TokPos := savedTok - 1;
  Next;
  Result := gsym;
end;

function PyParamDefaultAt(var j: Integer; const pname: AnsiString;
                          var isStr: Boolean; var sOff, sLen: Integer): Int64;
var depth: Integer; lone, loneNeg: Boolean;
begin
  Result := 0;
  isStr := False;
  sOff := 0;
  sLen := 0;
  { `= None` has to stay distinguishable from `= 0` and `= False`, which record
    the same ordinal: a NilPy parameter is a VARIANT, and filling an omitted one
    means building the actual value — None, an int, or a string. Reported
    through a global rather than another var parameter, since every caller of
    this function wants the same answer right after the call. }
  PyDefaultWasNone := True;
  PyDefaultWasFloat := False;
  PyDefaultWasBool := False;
  PyDefaultSym := -1;
  { A literal is the CONSTANT default only when it is the WHOLE default — the
    next token must close it. Unchecked, `def f(b=1+2)` claimed the `1`, left the
    cursor on `+` and the header then died on "Expected: )", so a perfectly
    ordinary Python default failed to parse at all. Everything else falls through
    to the expression path below, which now evaluates it. }
  lone := (j + 1 < TokCount) and (Tokens[j + 1].Kind in [tkComma, tkRParen]);
  loneNeg := (j + 2 < TokCount) and (Tokens[j].Kind = tkMinus) and
             (Tokens[j + 2].Kind in [tkComma, tkRParen]);
  if lone or loneNeg then
  case Tokens[j].Kind of
    tkNil:     begin Inc(j); Exit; end;
    { A FLOAT default (`max_zoom=2.0`). The token already carries the IEEE 754
      bits in IVal, which is what ProcParamDefaultVal stores, so the value
      travels as-is and only needs to be FLAGGED. Without this it fell through
      to the non-constant branch and became None — `min(max_zoom, ...)` then
      compared against 0 and songformatter's preview rendered its whole page
      into a 128x76 corner at the minimum zoom. }
    tkFloat:   begin Result := Tokens[j].IVal; PyDefaultWasNone := False;
                     PyDefaultWasFloat := True; Inc(j); Exit; end;
    tkTrue:    begin Result := 1; PyDefaultWasNone := False; PyDefaultWasBool := True; Inc(j); Exit; end;
    tkFalse:   begin PyDefaultWasNone := False; PyDefaultWasBool := True; Inc(j); Exit; end;
    tkInteger: begin Result := Tokens[j].IVal; PyDefaultWasNone := False; Inc(j); Exit; end;
    tkString:
      begin
        isStr := True;
        PyDefaultWasNone := False;
        sOff := Tokens[j].SOffset;
        sLen := Tokens[j].SLen;
        { A string default ALSO gets the hidden global, unlike the other
          constants. It is not bakeable -- VT_STRING's payload is a MANAGED
          AnsiString ref, so the signature defaults array can only be filled at
          run time -- and the global is what the def-time store copies from, and
          what pairs the store with its slot. The direct-call path is untouched:
          it still has sOff/sLen and builds the literal itself. }
        if PyDefaultEvalMode then
          PyDefaultSym := PyEvalParamDefault(j, pname)
        else
          Inc(j);
        Exit;
      end;
    tkMinus:
      if loneNeg and (Tokens[j + 1].Kind = tkInteger) then
      begin
        Result := -Tokens[j + 1].IVal;
        PyDefaultWasNone := False;
        j := j + 2;
        Exit;
      end
      else if loneNeg and (Tokens[j + 1].Kind = tkFloat) then
      begin
        { negate by flipping the IEEE sign bit — the bits are the value here }
        Result := Tokens[j + 1].IVal xor Int64($8000000000000000);
        PyDefaultWasNone := False;
        PyDefaultWasFloat := True;
        j := j + 2;
        Exit;
      end;
  end;
  { NON-CONSTANT default: `b=[]`, `b={}`, `b=w`, any expression that is not a
    literal scalar token.

    Python evaluates it ONCE, at DEF time, in the scope where the def stands —
    which is exactly what makes the shared-mutable-default idiom observable
    (`def acc(v, bucket=[])` accumulates across calls). So the value goes into a
    hidden global evaluated at the def statement, and the call site reads that
    global; a fresh value per call would get the common case right and diverge
    on the accumulator idiom, trading one silent wrong answer for a subtler one.

    This used to SKIP the expression and leave the parameter None — silently, so
    `bucket.append(v)` failed with AttributeError on NoneType far from the cause
    (bug-nilpy-non-constant-parameter-defaults-silently-become-none). The old
    behaviour was justified for uforth's native-word bodies, which only ever run
    through the exec/native stub; that justification never covered ordinary
    Python.

    In a pre-pass (PyDefaultEvalMode off) the span is still merely skipped: the
    signature is all those passes want, and the names the expression reads may
    not exist yet. }
  begin
    if PyDefaultEvalMode then
    begin
      PyDefaultSym := PyEvalParamDefault(j, pname);
      if PyDefaultSym >= 0 then
      begin
        PyDefaultWasNone := False;
        Exit;
      end;
    end;
    depth := 0;
    while j < TokCount do
    begin
      case Tokens[j].Kind of
        tkLParen, tkLBrack, tkBegin: Inc(depth);
        tkRParen:
          begin
            if depth = 0 then Exit;   { the closing ) of the param list }
            Dec(depth);
          end;
        tkRBrack, tkEnd: Dec(depth);
        tkComma: if depth = 0 then Exit;
      end;
      Inc(j);
    end;
  end;
end;

procedure PySkipParamDefaultAtCursor;
{ Step the CURSOR over a parameter default of any shape, CurTok on the `=`.

  The method header used to step exactly one token (plus an optional leading
  `-`), which is every literal and nothing else: a list or dict default on a
  method died with "unexpected token" on its closing bracket — a method could
  not carry a container default at all, so the None behaviour the ticket
  describes was not even reachable for those forms. Brackets are balanced and the scan stops at
  the top-level `,` or `)`, the same rule PyParamDefaultAt uses on token
  indices; the VALUE itself was already recorded by the class member pre-pass,
  which is what the call path reads. }
var depth: Integer;
begin
  Next;                              { past '=' }
  depth := 0;
  while CurTok.Kind <> tkEOF do
  begin
    if CurTok.Kind in [tkLParen, tkLBrack] then Inc(depth)
    else if CurTok.Kind in [tkRBrack] then Dec(depth)
    else if CurTok.Kind = tkRParen then
    begin
      if depth = 0 then Exit;        { the closing ) of the parameter list }
      Dec(depth);
    end
    else if (CurTok.Kind = tkComma) and (depth = 0) then Exit;
    Next;
  end;
end;

{ Does a user definition of this name shadow the builtin spelling HERE — in the
  module being parsed right now? Python's rule is per-module: a name counts if
  this module defines it (a def or a module-level variable, both tagged with the
  current unit) or imported it by name. A def in some OTHER module does not,
  even though flat unit scope makes it findable. bug-nilpy-imported-name-shadows-builtin-everywhere. }
function PyUserNameShadowsHere(const nm: AnsiString): Boolean;
var si, i, ni, pi: Integer;
begin
  Result := True;
  { ...but a module-level def does not shadow the builtin ABOVE its own `def`
    statement — `print(set([1,1]))` standing over a `def set(x)` is the builtin's
    `{1}` in CPython, and reached the user's def here. PyDefBoundHere is the one
    place that question is answered.
    bug-nilpy-intrinsic-only-builtin-is-shadowed-from-the-top-of-the-module }
  pi := FindProcInUnit(nm, CurrentUnitIdx);
  if (pi >= 0) and PyDefBoundHere(pi) then Exit;
  si := FindSym(nm);
  if (si >= 0) and (SymUnitIdx[si] = CurrentUnitIdx) then Exit;
  ni := InternStr(LowerCase(nm));
  for i := 0 to PyImpNameCount - 1 do
    if (PyImpName[i] = ni) and (PyImpNameUnit[i] = CurrentUnitIdx) then Exit;
  Result := False;
end;

{ `set(...)`, empty or over an iterable. NOT a hook when THIS module declares or
  imports its own `set` — songformatter's settings.py has `def set(section,
  option, value)` and convertrawtext.py imports it by name, and a user
  definition must win over a builtin spelling where it is in scope. }
function PyIsSetCall: Boolean;
begin
  Result := (CurTok.Kind = tkIdent) and
            (CaseEqual(CurTok.SVal, 'set') or CaseEqual(CurTok.SVal, 'frozenset')) and
            (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
            (not PyUserNameShadowsHere(CurTok.SVal));
end;

{ Is the set call being parsed the FROZEN spelling? The value a frozenset holds
  is a set's, so both go down one parse path and differ only in the stamp —
  and in what that stamp makes VISIBLE: repr, type().__name__ and isinstance.
  feature-nilpy-frozenset }
function PyIsFrozenSetCall: Boolean;
begin
  Result := (CurTok.Kind = tkIdent) and CaseEqual(CurTok.SVal, 'frozenset');
end;

{ Stamp a TPyList-producing node as a SET (pylib's pylist_mark_set). Every form
  that yields a Python set must go through this — `set()`, a `{a, b}` literal
  and a `{x for x in xs}` comprehension — because a bare TPyList is a LIST by
  default, and the FKind tag is what the repr, isinstance and the set operators
  all read. Returns the node unchanged when pylib is not loaded. }
function PyMarkAsSeqKind(node: Integer; const marker: AnsiString): Integer;
var mkPi, markArg, markCall, ci: Integer;
begin
  PyMarkAsSeqKind := node;
  if node < 0 then Exit;
  mkPi := FindProc(marker);
  if mkPi < 0 then Exit;
  markArg := AllocNode(AN_ARG);
  ASTLeft[markArg] := node;
  ASTRight[markArg] := -1;
  markCall := AllocNode(AN_CALL);
  ASTIVal[markCall] := mkPi;
  ASTTk[markCall] := Ord(tyClass);
  ci := FindUClass('TPyList');
  if ci >= 0 then ASTRight[markCall] := REC_UCLASS_BASE + ci;
  ASTLeft[markCall] := markArg;
  PyMarkAsSeqKind := markCall;
end;

function PyMarkAsSet(node: Integer): Integer;
begin
  PyMarkAsSet := PyMarkAsSeqKind(node, 'pylist_mark_set');
end;

function PyMarkAsFrozenSet(node: Integer): Integer;
begin
  PyMarkAsFrozenSet := PyMarkAsSeqKind(node, 'pylist_mark_frozenset');
end;

function PyIsEmptySetCall: Boolean;
begin
  Result := PyIsSetCall and (TokPos + 1 < TokCount) and
            (Tokens[TokPos + 1].Kind = tkRParen);
end;

{ A set is a TPyList (the representation annotations and `in` already use), so
  `set()` is an empty one and `set(xs)` is a duplicate-skipping copy through
  pylib's pyset_of — which also accepts a dict (its keys) and a string (its
  characters), like CPython. }
function PyParseEmptySet: Integer;
var ci, recId, sizeNode, argNode, mkPi, markArg, markCall: Integer;
    isFrozen: Boolean;
begin
  isFrozen := PyIsFrozenSetCall;
  if not PyIsEmptySetCall then
  begin
    Next;                          (* set *)
    Expect(tkLParen, '(');
    { A bare generator expression argument — `set(t.kind for t in toks)`. This
      arm hand-rolls its argument instead of going through the shared call-arg
      loop, so it was the ONE builtin that did not take a genexpr: list, tuple,
      dict, sorted, sum, min, max, any and all all did, which is what made the
      gap read as a genexpr limitation rather than as set()'s own.
      Same two lines as the shared loop, and they must stay the same two.
      feature-nilpy-generator-expression-arg }
    if PyBareGenExprAhead then
      CurASTNode := PyParseCompExprValue(False)
    else
      PyParseBoolExpr;
    argNode := AllocNode(AN_ARG);
    ASTLeft[argNode] := CurASTNode;
    Result := AllocNode(AN_CALL);
    ASTIVal[Result] := FindProc('pyset_of');
    if ASTIVal[Result] < 0 then Error('Nil Python: pylib (pyset_of) not loaded');
    ASTTk[Result] := Ord(tyClass);
    ASTRight[Result] := REC_UCLASS_BASE + FindUClass('TPyList');
    ASTLeft[Result] := argNode;
    Expect(tkRParen, ')');
    { pyset_of stamps a SET; the frozen spelling re-stamps on the way out. One
      parse path, one value, two tags — see PyIsFrozenSetCall. }
    if isFrozen then Result := PyMarkAsFrozenSet(Result);
    CurASTNode := Result;
    Exit;
  end;
  Next; Next; Next;                (* set ( ) *)
  ci := FindUClass('TPyList');
  if ci < 0 then Error('Nil Python: pylib (TPyList) not loaded');
  recId := REC_UCLASS_BASE + ci;
  Result := AllocNode(AN_CALL);
  ASTIVal[Result] := -Ord(tkGetMem);
  ASTTk[Result] := Ord(tyClass);
  ASTRight[Result] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[Result] := argNode;
  { ...and stamp it a SET. A bare TPyList allocation is a LIST by default, so
    without this `set()` reprs as `[]` and answers isinstance(x, list) True.
    The non-empty arm above gets its kind inside pyset_of. }
  if isFrozen then Result := PyMarkAsFrozenSet(Result)
  else Result := PyMarkAsSet(Result);
  CurASTNode := Result;
end;

function PyIsCountCall: Boolean;
begin
  Result := (PyCountAlias <> '') and (CurTok.Kind = tkIdent) and
            CaseEqual(CurTok.SVal, PyCountAlias) and
            (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen);
end;

function PyParseCountCreate: Integer;
var ci, recId, node, argNode, sizeNode, valArg: Integer;
begin
  ci := FindUClass('TPyCounter');
  if ci < 0 then Error('Nil Python: pylib (TPyCounter) not loaded');
  recId := REC_UCLASS_BASE + ci;
  Next;                       { the alias ident }
  Expect(tkLParen, '(');
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  PyParseBoolExpr;
  valArg := AllocNode(AN_ARG);
  ASTLeft[valArg] := CurASTNode;
  ASTRight[argNode] := valArg;
  Expect(tkRParen, ')');
  Result := node;
end;

function PyClassCreateExpr: Integer;
begin
  Result := PyClassCreate;
end;

{ The default VALUE node for dataclass field `fidx` of class ci, where dcBase
  is the class's first entry in the PyDc* default table. Extracted so BOTH the
  trailing-argument fill and the keyword-argument hole fill use ONE
  construction: a factory default is re-parsed per construction site, so a
  second copy would quietly diverge. }
const
  { widest dataclass argument list the keyword binder handles; the ctor
    synthesiser already caps a dataclass at 15 fields }
  PY_MAX_DC_KW = 32;

{ Evaluate a dataclass field's EXPRESSION default at the class statement, into
  a hidden global named after the class and the field.

  Deliberately NOT PyEmitClassAttrExpr, which does this for a plain class
  attribute: that routine also registers the name as a CLASS ATTRIBUTE — a
  shared slot with per-instance overrides — and a dataclass field is a real
  instance field. Reusing it compiled and then SEGFAULTED on the ordinary read
  `p.x`, because the read went through the class-attribute override path
  instead of the field. Same value, different storage model; only the
  evaluate-once-into-a-global half is shared, so only that half is copied.
  CurTok is the field NAME on entry; the line is consumed.
  feature-nilpy-dataclass-expression-field-default }
procedure PyEmitDcExprDefault(ci: Integer; eqAt: Integer);
var nm, gname: AnsiString; gsym, valNode, asgn: Integer;
begin
  nm := CurTok.SVal;
  TokPos := eqAt;
  Next;                            { CurTok = '=' }
  Next;                            { onto the expression }
  PyParseBoolExpr;
  valNode := CurASTNode;
  gname := PyDcDefaultGlobalName(ci, nm);
  gsym := FindSym(gname);
  if gsym < 0 then
  begin
    gsym := AllocVar(gname, IntToTypeKind(ASTTk[valNode]));
    Syms[gsym].RecName := ResolveNodeRec(valNode);
    SymSyncTypeRef(gsym);
  end;
  asgn := AllocNode(AN_ASSIGN);
  ASTLeft[asgn] := PyMakeIdent(gsym);
  ASTRight[asgn] := valNode;
  PyHoistStmt(asgn);
  while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
end;

{ The recorded default KIND of dataclass field `nm` on class ci, or PYDC_NONE.
  The class-body pass needs it to tell an EXPRESSION default (which it must
  evaluate here, once) from every other form (which it steps over) — asking
  "does an expression follow the '='" instead would also claim
  `field(default_factory=list)`, whose `field` is not a callable that exists.
  feature-nilpy-dataclass-expression-field-default }
function PyDcFieldKind(ci: Integer; const nm: AnsiString): Integer;
var i, fidx, base: Integer;
begin
  Result := PYDC_NONE;
  fidx := FindUField(ci, nm);
  if fidx < 0 then Exit;
  fidx := fidx - UClsFBase[ci];
  base := -1;
  for i := 0 to PyDcCount - 1 do
    if PyDcCi[i] = ci then begin base := i; Break; end;
  if base < 0 then Exit;
  if base + fidx >= PyDcCount then Exit;
  if PyDcCi[base + fidx] <> ci then Exit;
  Result := PyDcKind[base + fidx];
end;

function PyDcDefaultNode(ci, dcBase, fidx: Integer): Integer;
var i, k, valNode, tkNode: Integer; tkF: TTypeKind;
begin
  i := dcBase + fidx;
  if (i >= PyDcCount) or (PyDcCi[i] <> ci) or (PyDcKind[i] = PYDC_NONE) then
    Error('Nil Python: missing argument for dataclass field without default');
case PyDcKind[i] of
    PYDC_INT:
    begin
      valNode := AllocNode(AN_INT_LIT);
      ASTIVal[valNode] := PyDcIVal[i];
      ASTTk[valNode] := Ord(tyInteger);
    end;
    PYDC_FLOAT:
    begin
      valNode := AllocNode(AN_FLOAT_LIT);
      ASTIVal[valNode] := PyDcIVal[i];
      ASTTk[valNode] := Ord(tyDouble);
    end;
    PYDC_STR:
    begin
      valNode := AllocNode(AN_STR_LIT);
      ASTSOffset[valNode] := PyDcSOff[i];
      ASTSLen[valNode] := PyDcSLen[i];
      ASTTk[valNode] := Ord(tyString);
    end;
    PYDC_NIL:
    begin
      tkF := IntToTypeKind(UFldTk[UClsFBase[ci] + (i - dcBase)]);
      if tkF = tyAnsiString then
        Error('Nil Python: None default for a str field is not supported yet');
      { A VARIANT field's None is the VT_EMPTY variant, not the ordinal 0 that
        every other field kind maps it to: a variant is 16 bytes passed by
        address, so the bare literal handed the constructor a 0 where it wanted
        a slot and `DC("x")` — omitting a `Callable[...] = None` field — died
        in the constructor before its first statement. Same substitution
        ir.inc's ProcParamDefaultIsNone branch already makes for a variant
        PARAMETER's omitted default, for the same reason.
        bug-nilpy-closure-stored-in-a-callable-field-jumps-through-the-variant-tag }
      if tkF = tyVariant then
        valNode := PyMakeNone
      else
      begin
        valNode := AllocNode(AN_INT_LIT);
        ASTIVal[valNode] := 0;
        ASTTk[valNode] := Ord(tkF);
      end;
    end;
    PYDC_FACTORY_EXPR:
    begin
      { re-parse the captured lambda-body span at this construction
        site: evaluated per construction, like CPython's factory }
      k := TokPos - 1;              { restore point (CurTok's index) }
      TokPos := PyDcIVal[i];
      Next;
      PyParseBoolExpr;
      valNode := CurASTNode;
      TokPos := k;
      Next;
    end;
    PYDC_FACTORY_LIST:
    begin
      { fresh empty TPyList (same GetMem+ctor shape as a [] literal) }
      k := FindUClass('TPyList');
      if k < 0 then Error('Nil Python: pylib (TPyList) not loaded');
      valNode := AllocNode(AN_CALL);
      ASTIVal[valNode] := -Ord(tkGetMem);
      ASTTk[valNode] := Ord(tyClass);
      ASTRight[valNode] := REC_UCLASS_BASE + k;
      tkNode := AllocNode(AN_INT_LIT);
      ASTIVal[tkNode] := RecSize(REC_UCLASS_BASE + k);
      ASTTk[tkNode] := Ord(tyInteger);
      k := AllocNode(AN_ARG);
      ASTLeft[k] := tkNode;
      ASTLeft[valNode] := k;
    end;
    PYDC_FACTORY_DICT:
    begin
      { fresh empty TPyDict (same GetMem+ctor shape as a {} literal) }
      k := FindUClass('TPyDict');
      if k < 0 then Error('Nil Python: pylib (TPyDict) not loaded');
      valNode := AllocNode(AN_CALL);
      ASTIVal[valNode] := -Ord(tkGetMem);
      ASTTk[valNode] := Ord(tyClass);
      ASTRight[valNode] := REC_UCLASS_BASE + k;
      tkNode := AllocNode(AN_INT_LIT);
      ASTIVal[tkNode] := RecSize(REC_UCLASS_BASE + k);
      ASTTk[tkNode] := Ord(tyInteger);
      k := AllocNode(AN_ARG);
      ASTLeft[k] := tkNode;
      ASTLeft[valNode] := k;
    end;
    PYDC_EXPR:
    begin
      { the hidden global the class statement evaluated this default into —
        one object shared by every construction, as Python has it }
      k := FindSym(PyDcDefaultGlobalName(ci,
             PyRawName(UFldNOff[UClsFBase[ci] + fidx],
                       UFldNLen[UClsFBase[ci] + fidx])));
      if k < 0 then
        Error('Nil Python: dataclass expression default was not evaluated at the '
              + 'class statement — internal (feature-nilpy-dataclass-expression-'
              + 'field-default)');
      valNode := PyMakeIdent(k);
    end;
    else { PYDC_BOOL }
    begin
      valNode := AllocNode(AN_INT_LIT);
      ASTIVal[valNode] := PyDcIVal[i];
      ASTTk[valNode] := Ord(tyBoolean);
    end;
  end;
  Result := valNode;
end;

{ Two tiny builders for the multi-argument Exception fold in PyClassCreate: a
  string literal, and a `+` of two AnsiString expressions. Separate so the fold
  reads as the concatenation it is rather than twelve node allocations.
  bug-nilpy-multi-arg-exception-constructor-segfaults }
function PyExcFoldLit(const t: AnsiString): Integer;
begin
  Result := AllocNode(AN_STR_LIT);
  ASTSOffset[Result] := PyStoredName(t);
  ASTSLen[Result] := Length(t);
  ASTTk[Result] := Ord(tyString);
end;

function PyExcFoldCat(a, b: Integer): Integer;
begin
  Result := AllocNode(AN_BINOP);
  ASTIVal[Result] := Ord(tkPlus);
  ASTLeft[Result] := a;
  ASTRight[Result] := b;
  ASTTk[Result] := Ord(tyAnsiString);
end;

function PyClassCreate: Integer;
var name: AnsiString; ci, recId, node, argNode, lastArg, sizeNode: Integer;
    nArgs, i, k, dcBase, valNode, tkNode, ctorMi, ctorPi: Integer; tkF: TTypeKind;
    kwI, kwJ, kwFld, kwMax, kwPos, kwDcBase: Integer; kwName: AnsiString;
    kwCtorMi, kwCtorPi, kwPk, kwVal: Integer;
    kwAny: Boolean; kwSlot: array[0..PY_MAX_DC_KW - 1] of Integer;
    attrAny: Boolean; attrSym, attrAsgn, attrFld, attrFi, attrGSym: Integer;
    attrD, attrCur: Integer;   { the ancestor-chain walk, root first }
    excFoldCi, excFoldPi, excFoldStr, excFoldN, excFoldI, excArgsTup: Integer;
    excFoldA, excFoldC: Integer;   { the multi-arg Exception fold }
    szArgNode, starHead: Integer;  { *args packing (see below) }
    kwExtraHead, kwExtraLast, kwKeyNode: Integer;   { keywords bound for **kwargs }
    noParens: Boolean;   { `raise ValueError` — construct with no argument list }
begin
  name := CurTok.SVal;
  ci := -1;
  excArgsTup := -1;
  if PyCtorQualUnit >= 0 then ci := FindUClassInUnit(name, PyCtorQualUnit);
  { A qualifier binds the ONE class name it precedes — never the constructions
    nested in that class's own ARGUMENTS. It was left set across the argument
    parse, so `codecs.CodecInfo(Codec().m)` resolved the inner `Codec` in
    mimic_codecs and built the SHIM's class instead of the user's: the user's
    __init__ never ran and the call died at run time with
    "'Codec' object has no attribute 'm'".

    Silent and shape-dependent, which is what made it expensive to place — the
    SAME class through a named receiver (`z = Codec(); codecs.CodecInfo(z.m)`)
    was correct, because the construction had already happened outside the
    qualified call. So did any name the qualified unit does not happen to
    declare, since FindUClassInUnit then misses and the ordinary lookup answers.
    It bites exactly the names a shim exports — Codec, StreamReader,
    IncrementalEncoder — which is every real `encodings` module's vocabulary.

    Cleared here rather than at the call site because THIS is the construction
    the qualifier was for; the sibling flag below already scopes itself the same
    way ("one construction only — never inherited inwards") and this one was
    simply missed. The caller still clears it after the whole expression.
    bug-n-a-temporary-receiver-resolves-to-the-shim-type-not-the-user-class }
  PyCtorQualUnit := -1;
  { skip a same-named RECORD (the RTL's `Text` file type against tkinter's Text
    widget): a construction always means the class }
  if ci < 0 then ci := FindUClassNonRecord(name);
  if ci < 0 then ci := FindUClass(name);
  if ci < 0 then Error('Nil Python: class not found: ' + name);
  recId := REC_UCLASS_BASE + ci;
  noParens := PyCtorNoParens;
  PyCtorNoParens := False;   { one construction only — never inherited inwards }
  Next;
  if not noParens then Expect(tkLParen, '(');
  node := AllocNode(AN_CALL);
  ASTIVal[node] := -Ord(tkGetMem);
  ASTTk[node] := Ord(tyClass);
  ASTRight[node] := recId;
  sizeNode := AllocNode(AN_INT_LIT);
  ASTIVal[sizeNode] := RecSize(recId);
  ASTTk[sizeNode] := Ord(tyInteger);
  argNode := AllocNode(AN_ARG);
  ASTLeft[argNode] := sizeNode;
  ASTLeft[node] := argNode;
  szArgNode := argNode;          { the GetMem SIZE slot; ctor args hang off it }
  lastArg := argNode;
  nArgs := 0;
  { `Word(name=n, wid=w)` — keyword arguments. A @dataclass has no ctor METHOD
    (its arguments map straight onto the fields, in declaration order), so a
    keyword binds to a FIELD index rather than to a proc parameter. Collected
    into kwSlot here and re-emitted in field order below. }
  for kwI := 0 to PY_MAX_DC_KW - 1 do kwSlot[kwI] := -1;
  kwAny := False;
  kwMax := -1;
  kwPos := 0;
  kwExtraHead := -1; kwExtraLast := -1;
  { `C(*xs)` — the whole argument list is one unpack, the shape the METHOD paths
    already handle via PyStarUnpackMethodArgs and this one did not (it reached
    PyParseBoolExpr on the '*' and died with "expected expression"). Handled
    before the keyword/slot loop rather than inside it: the expansion fills
    every remaining declared slot at once, so there is nothing for the slot
    bookkeeping to do, and an argument after the unpack is refused by the shared
    expander anyway.
    bug-nilpy-kwargs-and-star-unpack-at-a-construction-are-refused }
  if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
     (Tokens[TokPos].Kind <> tkStar) then
  begin
    ctorMi := FindUMeth(ci, 'create');
    if ctorMi < 0 then
      Error('Nil Python: *unpacking into ' + name
            + '() needs a constructor to unpack into');
    ctorPi := UMthProc_[ctorMi];
    { A ctor that itself takes *args or **kwargs would need the LIST passed
      through as its packed parameter rather than expanded into declared slots
      — a different lowering. The shared expander counts EVERY signature slot,
      the packed ones included, so it would demand one element per container
      and fail at run time with an arity message about a call the program never
      wrote. Refused at compile time by name instead. }
    if (ProcPyStarIdx[ctorPi] >= 0) or (ProcPyKwIdx[ctorPi] >= 0) then
      Error('Nil Python: ' + name + '(*xs) where the constructor itself takes '
            + '*args or **kwargs is not supported yet — pass the elements '
            + 'positionally');
    starHead := ASTRight[szArgNode];
    PyStarExpandCallArgs(ctorPi, 1, starHead, lastArg);
    if starHead >= 0 then ASTRight[szArgNode] := starHead;
    if lastArg < 0 then lastArg := szArgNode;
    if CurTok.Kind = tkComma then
      Error('Nil Python: an argument after *unpacking is not supported yet');
    Expect(tkRParen, ')');
    Result := node;
    LastExprTk := tyClass;
    CurASTNode := node;
    Exit;
  end;
  while (not noParens) and (CurTok.Kind <> tkRParen) do
  begin
    kwFld := -1;
    if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind = tkAssign) then
    begin
      kwName := CurTok.SVal;
      { The CONSTRUCTOR's parameters come FIRST when there is one. A
        hand-written `__init__` names its options as parameters, and it usually
        stores them into fields of the same name — `def __init__(self, parent,
        on_next, on_change=None): self.on_next = on_next`. Matching the FIELD
        first then bound the keyword to a field INDEX while the positional
        argument had already taken that slot, and the construction was rejected
        with "got multiple values for field 'on_next'" — an argument list that
        is plain Python. Only a class with NO ctor (the dataclass shape, whose
        arguments map straight onto its fields) falls through to the fields. }
      kwCtorMi := FindUMeth(ci, 'create');
      kwFld := -1;
      if kwCtorMi >= 0 then
      begin
        kwCtorPi := UMthProc_[kwCtorMi];
        for kwPk := 1 to Procs[kwCtorPi].ParamCount - 1 do
          if ParamNameEq(kwCtorPi, Procs[kwCtorPi].Params[kwPk].Name, kwName) then
            kwFld := kwPk - 1;
      end;
      { …and a ctor taking `**kwargs` accepts a name that is NOT one of its
        parameters — that is what the dict is for. Checked BEFORE the field
        fallback, which is the third shape this ticket is about: `def
        __init__(self, a, *rest, **kw)` storing `self.k = len(kw)` declares a
        FIELD named k, so `F(1, 2, k=9)` matched that field, found its slot
        already taken by the positional 2, and was rejected with "got multiple
        values for field 'k'" — a class punished for naming a field after one
        of its own keyword options, which is the ordinary thing to do.
        The key literal travels on the argument's ASTIVal as -(node+1), the
        same convention PyKwArgIndex uses for a method; PyPackStarArgs below
        decodes it into the dict.
        bug-nilpy-kwargs-and-star-unpack-at-a-construction-are-refused }
      if (kwFld < 0) and (kwCtorMi >= 0) and (ProcPyKwIdx[kwCtorPi] >= 0) then
      begin
        kwKeyNode := AllocNode(AN_STR_LIT);
        ASTSOffset[kwKeyNode] := PyStoredName(kwName);
        ASTSLen[kwKeyNode] := Length(kwName);
        ASTTk[kwKeyNode] := Ord(tyString);
        Next; Next;                        { the name and the '=' }
        PyParseBoolExpr;
        argNode := AllocNode(AN_ARG);
        ASTLeft[argNode] := CurASTNode;
        ASTIVal[argNode] := -(kwKeyNode + 1);
        ASTRight[argNode] := -1;
        if kwExtraHead < 0 then kwExtraHead := argNode
        else ASTRight[kwExtraLast] := argNode;
        kwExtraLast := argNode;
        Inc(nArgs);
        if not Eat(tkComma) then Break;
        Continue;
      end;
      if kwFld < 0 then
      begin
        kwFld := FindUField(ci, kwName);
        if kwFld >= 0 then
          kwFld := kwFld - UClsFBase[ci]   { absolute -> field INDEX }

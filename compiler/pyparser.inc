        i := TokPos - 1;      { the statement's terminating token }
        continue;
      end
      { A TUPLE-UNPACK target list, `a, b = <expr>`. The arm above requires the
        token after the name to be '=', and here it is a COMMA, so the targets
        were never registered at all — and then a LATER bare assignment whose
        RHS reads one of them (`c = a`) got trial-parsed against a symbol table
        that had never heard of it and died with "undefined variable (a)".
        `len(a)` was fine, because only a bare assignment's RHS is trial-parsed;
        that asymmetry is what made the shape hard to guess from the message.

        `rows, errs = parse(text)` followed by anything that assigns from
        `rows` is an ordinary Python shape, so this is worth registering even
        though the RHS cannot be typed here: the elements of an arbitrary
        unpack have no token-visible types, and trial-parsing the RHS is the
        thing this pre-pass must not do at a name it cannot yet see.

        tyVariant is therefore the honest answer AND the conservative one — it
        widens rather than asserts, and the real parse still types the binding
        properly when it runs. What matters is only that the name RESOLVES, so
        the later trial parse gets that far.
        bug-nilpy-tuple-unpacked-name-undefined-in-a-later-assignment }
      else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
              (i + 1 < MainProgramTokCount) and (Tokens[i + 1].Kind = tkComma) and
              ((i = PyScanLo) or (Tokens[i - 1].Kind in [tkNewline, tkIndent,
                                                         tkDedent, tkSemicolon])) and
              PyTupleTargetRun(i, tupEnd) then
      begin
        bodyIx := i;
        while bodyIx < tupEnd do
        begin
          if Tokens[bodyIx].Kind = tkIdent then
          begin
            blkName := GetTokenStr(bodyIx);
            if PyProgSym(blkName) < 0 then
            begin
              PyNoteLocalType(blkName, tyVariant, REC_NONE);
              si := AllocVar(blkName, tyVariant);
            end;
          end;
          Inc(bodyIx);
        end;
        i := tupEnd;          { the '=' — the RHS is deliberately not parsed }
        continue;
      end
      else if (depth = 0) and
              ((Tokens[i].Kind = tkFor) or
               ((Tokens[i].Kind = tkIdent) and CaseEqual(GetTokenStr(i), 'for'))) and
              { a STATEMENT BOUNDARY, exactly like the bare-assignment match
                above — a comprehension/generator's inline `for` (`next((c for
                c in cs if ...), ...)`) is the SAME token at depth 0 (parens
                do not change depth) but mid-expression, not a new statement. }
              ((i = PyScanLo) or (Tokens[i - 1].Kind in [tkNewline, tkIndent,
                                                         tkDedent, tkSemicolon])) and
              (i + 2 < MainProgramTokCount) and (Tokens[i + 1].Kind = tkIdent) and
              PyForTargetRun(i + 1, forCnt, forIn) then
      begin
        { A MULTI-NAME target — `for k, v in …`, whatever the iterable. Unlike
          the single-name case below this needs no look at the iterable at all:
          unpacking yields VARIANT slots whatever the container is, so the
          element type is a property of the target list rather than of what is
          being iterated, and the arm stays a pure token peek.

          Without it the names kept whatever type an ORDINARY assignment
          elsewhere in the module gave them, and PyParseForIn's
          `symIdx := PyProgSym(name)` bound a variant element into that fixed
          slot: `a = ["p"]` followed by `for k, a in pairs:` read an empty value
          and then SIGSEGV'd. Every prior binding kind reproduced, including a
          binding of the SAME type — the slot is wrong because it is not a
          variant, not because the two types disagree.
          bug-nilpy-multi-name-for-target-reuses-a-module-name-and-reads-garbage }
        if forCnt > 1 then
        begin
          { `enumerate(...)` is the one exception: its FIRST name is the index,
            so noting it a variant would widen an ordinary arithmetic loop
            counter. Same guarded token peek the `range` arm below uses —
            trusted only while nothing has shadowed the name. }
          if (forIn + 2 < MainProgramTokCount) and
             (Tokens[forIn + 1].Kind = tkIdent) and
             (GetTokenStr(forIn + 1) = 'enumerate') and
             (Tokens[forIn + 2].Kind = tkLParen) and
             (PyFindModuleConstraint('enumerate') < 0) and
             (PyProgSym('enumerate') < 0) then
            forElemTk := tyInt64
          else
            forElemTk := tyVariant;
          bodyIx := i + 1;
          while bodyIx < forIn do
          begin
            if Tokens[bodyIx].Kind = tkIdent then
            begin
              PyNoteLocalType(GetTokenStr(bodyIx), forElemTk, REC_NONE);
              forElemTk := tyVariant;   { only the first name can be an index }
            end;
            Inc(bodyIx);
          end;
          i := forIn;       { the `in` — the iterable is scanned as usual }
          continue;
        end;
        { `for name in ITER:` at module level: fold the loop TARGET's element
          type into the SAME whole-program widening table a bare assignment
          feeds via PyNoteLocalType. Without this, a name already bound to a
          SCALAR elsewhere (`c = 5`) and later used as a for-TARGET over a
          STRING (or any element-typed container) never got that binding's
          type folded in — the flat scanner only recognises `name = expr`,
          and `for` is a different shape entirely. The real pass then created
          the name from its ONLY known assignment (the scalar one) and the
          loop stored a str/variant element into that fixed scalar slot
          (bug-nilpy-for-variable-reused-after-a-non-string-binding-iterates-garbage).

          Deliberately NOT a trial-parse of the statement (unlike the bare-
          assignment branch above): `Error` calls `Halt` directly, so a real
          PyParseStatement/PyParseForIn call here that referenced a name only
          a construct this scanner does not enter (`with`, `if`, `try`, a
          class body — anything but a bare assignment) would abort the WHOLE
          COMPILE the instant the pre-pass reached it, not just skip the one
          statement — hit immediately by `test_nilpy_file_open.npy`'s
          `with open(...) as f: lines = [...]` followed by `for ln in
          lines:`. So this only ever PEEKS at tokens and never calls into the
          parser: only the two cheap, safe-to-recognise iterable shapes get
          noted (a string literal, or a name already resolvable to a type);
          anything else — a call, a subscript, `d.items()`, a comprehension —
          is silently left alone, same as before this fix, and the real pass
          (which runs after every earlier statement has actually executed)
          sorts it out as it always did. Single-name targets only — a
          two-name target (dict.items()/enumerate/pair-unpack) is rarer for
          this specific conflict and stays unhandled rather than guessed at. }
        forName := GetTokenStr(i + 1);
        forJ := i + 3;
        forElemTk := tyUnknown;
        if (forJ < MainProgramTokCount) and (Tokens[forJ].Kind = tkString) then
          forElemTk := tyAnsiString
        else if (forJ < MainProgramTokCount) and
                (Tokens[forJ].Kind in [tkLBrack, tkBegin]) then
          forElemTk := tyVariant
        else if (forJ + 1 < MainProgramTokCount) and (Tokens[forJ].Kind = tkIdent) and
                (GetTokenStr(forJ) = 'range') and
                (Tokens[forJ + 1].Kind = tkLParen) and
                (PyFindModuleConstraint('range') < 0) and (PyProgSym('range') < 0) then
          { `for i in range(...)` — the induction variable is an int, and the
            single most common loop in Python. Left unnoted before, so an
            accumulator in the body could not be recognised as arithmetic over
            known ints (PyBlkIntArith) and module-scope factorial kept wrapping.
            Still a pure token peek: `range` is only trusted when nothing has
            shadowed it. }
          forElemTk := tyInt64
        else if (forJ < MainProgramTokCount) and (Tokens[forJ].Kind = tkIdent) and
                (forJ + 1 < MainProgramTokCount) and
                (Tokens[forJ + 1].Kind in [tkColon, tkNewline]) then
        begin
          forCi := PyFindModuleConstraint(GetTokenStr(forJ));
          if forCi >= 0 then
          begin
            if PyModuleLocals[forCi].TypeKind in [tyString, tyAnsiString] then
              forElemTk := tyAnsiString
            else
              forElemTk := tyVariant;
          end
          else if PyProgSym(GetTokenStr(forJ)) >= 0 then
          begin
            si := PyProgSym(GetTokenStr(forJ));
            if Syms[si].TypeKind in [tyString, tyAnsiString] then
              forElemTk := tyAnsiString
            else
              forElemTk := tyVariant;
          end;
        end
        { ...and `for x in name.values()` / `.keys()`, which is a token shape
          like the others and needs no parse either: a known name, a dot, the
          method name, and '('. Both yield VARIANT elements.

          The comment above lists "a call, a subscript, d.items()" as
          deliberately unhandled, and for `.items()` that still holds — it binds
          a TWO-name target, which this arm does not do. But leaving `.values()`
          out was not free: a name bound at MODULE level and then used as the
          target of a `.values()` loop kept the module binding's CLASS type,
          and the variant element was written into a class-typed slot. It read
          back as garbage or SEGFAULTED depending on layout, and
          `for sec in cfg.values()` after any earlier `sec` is an ordinary shape.
          bug-nilpy-module-name-reassigned-from-a-subscript-in-a-block-reads-garbage }
        else if (forJ + 3 < MainProgramTokCount) and (Tokens[forJ].Kind = tkIdent) and
                (Tokens[forJ + 1].Kind = tkDot) and
                (Tokens[forJ + 2].Kind = tkIdent) and
                (Tokens[forJ + 3].Kind = tkLParen) and
                ((LowerCase(GetTokenStr(forJ + 2)) = 'values') or
                 (LowerCase(GetTokenStr(forJ + 2)) = 'keys')) and
                ((PyFindModuleConstraint(GetTokenStr(forJ)) >= 0) or
                 (PyProgSym(GetTokenStr(forJ)) >= 0)) then
          forElemTk := tyVariant
        { ...and the three sequence WRAPPERS people put around an iterable —
          `for x in list(...)`, `sorted(...)`, `reversed(...)`. Each yields a
          TPyList whose elements are variants whatever the argument was, so the
          element type needs no look inside the parentheses and this stays a
          token peek. They are named individually rather than accepting any
          call, because an arbitrary call's element type is exactly what this
          arm must not guess at. }
        else if (forJ + 1 < MainProgramTokCount) and (Tokens[forJ].Kind = tkIdent) and
                (Tokens[forJ + 1].Kind = tkLParen) and
                ((LowerCase(GetTokenStr(forJ)) = 'list') or
                 (LowerCase(GetTokenStr(forJ)) = 'sorted') or
                 (LowerCase(GetTokenStr(forJ)) = 'reversed')) and
                (PyProgSym(GetTokenStr(forJ)) < 0) then   { not a user def of that name }
          forElemTk := tyVariant;
        if forElemTk <> tyUnknown then PyNoteLocalType(forName, forElemTk, REC_NONE);
      end;
      Inc(i);
    end;
    PyTypingPass := False;
    PyExprMode := savedExprMode;
    if PyTypingChanged then changed := True;
    { A name with BOTH a readable and an unreadable binding cannot be pinned to
      the shape that happened to be readable — the other binding stores a value
      of a different shape through the same slot, and nothing converts it.
      Measured: `z = c.two(1)` then `z = 3.5` in one block printed
      4615063718147915776, which is 3.5's IEEE bits read as an integer.
      Widened to tyVariant, which holds either.

      Only the INTERSECTION. A name whose unreadable binding is its only one is
      left exactly as it is today: blanket tyVariant was tried before and broke
      `tok is None` for a str-typed Optional (see PyPhantomNames), and that
      failure is the single-binding case this does not touch. }
    for i := 0 to PyLocalCount - 1 do
      if (PyLocals[i].TypeKind <> tyVariant) and
         PyHasUnkBinding(PyLocals[i].Name) then
      begin
        PyLocals[i].TypeKind := tyVariant;
        PyLocals[i].RecCi := -1;
        changed := True;
      end;
    for i := savedSC to SymCount - 1 do
    begin
      nm := Syms[i].Name;
      if nm = '' then Continue;
      { A PHANTOM contributes nothing. It exists only so the trial parse above
        could resolve the name; harvesting it would assert the tyVariant its
        scratch symbol happens to wear, which is precisely the widening that
        broke `tok is None` when this was tried as a real constraint.
        See PyPhantomNames. }
      if PyIsPhantom(nm) then Continue;
      tk := Syms[i].TypeKind;
      si := PyFindConstraint(nm);
      if si < 0 then
      begin
        if PyLocalCount >= PY_MAX_LOCALS then
          Error('Nil Python: too many inferred module locals');
        PyLocals[PyLocalCount].Name := nm;
        PyLocals[PyLocalCount].TypeKind := tk;
        if Syms[i].RecName >= REC_UCLASS_BASE then
          PyLocals[PyLocalCount].RecCi := Syms[i].RecName - REC_UCLASS_BASE
        else
          PyLocals[PyLocalCount].RecCi := -1;
        PyLocals[PyLocalCount].Poly := False;
        Inc(PyLocalCount);
        changed := True;
      end
      else
      begin
        w := PyWidenBinding(PyLocals[si].TypeKind, tk);
        if w <> PyLocals[si].TypeKind then
        begin
          PyLocals[si].TypeKind := w;
          changed := True;
        end;
        { NOT guarded on RecCi already being SET (the original form of this
          rule): a name reassigned across ROUNDS to a call returning a
          DIFFERENT class kept its FIRST round's class identity forever, so
          `with open(p,"w") as f: ...` then a later plain `f = open(p, "r")`
          left f dispatching as a TPyFile while it now held a TPyList --
          .readlines() / len() read the wrong class's layout and printed the
          RTTI blob (the same disclosure shape as
          bug-nilpy-file-write-drops-data-and-read-to-print-dumps-rtti-memory,
          via a different trigger than that ticket's write() overload). Take
          the latest resolved class whenever it differs. }
        { ...but "the latest" is only right when the two classes are RELATED,
          i.e. one refines the other. A name that genuinely holds instances of
          two UNRELATED classes has no single static layout, and picking either
          one makes every member access on the other read a field at the wrong
          offset -- `o = DC(...); o.native(1); o = PC(...); o.native(2)`
          segfaulted before printing anything, because it JUMPED through
          whatever sat at DC's `native` offset inside a PC.
          (It only bites when the layouts differ, which is why it hid for so
          long behind same-offset shapes.) The honest answer there is the one
          the method and field scans already reach: no single answer, so go
          dynamic. Poly is sticky -- see TPyLocalConstraint.
          bug-nilpy-local-reassigned-across-classes-keeps-one-static-class }
        if (Syms[i].RecName >= REC_UCLASS_BASE) and (not PyLocals[si].Poly) then
        begin
          newCi := Syms[i].RecName - REC_UCLASS_BASE;
          oldCi := PyLocals[si].RecCi;
          if oldCi <> newCi then
          begin
            if (oldCi >= 0) and (not IsSubclassOf(newCi, oldCi))
                            and (not IsSubclassOf(oldCi, newCi)) then
            begin
              PyLocals[si].Poly := True;
              PyLocals[si].RecCi := -1;
              PyLocals[si].TypeKind := tyVariant;
              changed := True;
            end
            else
            begin
              PyLocals[si].RecCi := newCi;
              changed := True;
            end;
          end;
        end;
      end;
    end;
    SymRollbackTo(savedSC);
    ASTNodeCount := savedAST;
    FrameSize := savedFS;
    BSSSize := savedBSS;
    CurASTNode := savedCur;
    PyHoistHead := -1;   { discard trial-queued hoists — see PyCollectLocalsAST }
    PyDefInitHead := -1; { and trial-queued def-time defaults — same reason }
    TokPos := savedTok - 1;
    Next;
    Inc(rnd);
  until (not changed) or (rnd >= PY_INFER_ROUNDS);
  { PXXDBG=n.locals — PyDbgDumpLocals was already called for each PROC, but
    never for the MODULE table, so `n.locals` printed nothing at all for a
    module-scope name and the constraint that types every global was
    unobservable. That gap is what made
    bug-nilpy-global-shadowed-by-method-param-name-loses-class-type expensive
    to chase. }
  PyDbgDumpLocals('<module>');
  PyModuleLocalCount := PyLocalCount;
  for i := 0 to PyLocalCount - 1 do
    PyModuleLocals[i] := PyLocals[i];
end;

{ Parse one `def` header into the PyHdr* globals, leaving the cursor just
  past the `:` NEWLINE INDENT that opens the body. The single implementation
  of the header grammar — see the PyHdr* declaration for why that matters. }
function PyInferDefRetType(methodStart: Integer; var retRec: Integer): TTypeKind; forward; { defined with the pre-pass helpers below }
function PyDefHasValueReturn(defIdx: Integer): Boolean; forward; { lying `-> None` detector (with the pre-pass helpers) }
{ the annotation-vs-body join; PyParseDefHeader below calls it and its body sits
  with the pre-pass helpers, so FPC needs the forward even though pxx does not }
function PyJoinRetAnnotation(annTk: TTypeKind; methodStart: Integer;
                             var annRec: Integer): TTypeKind; forward;

function PyDefUsedAsValue(const nm: AnsiString): Boolean;
{ True iff the module mentions `nm` as a VALUE (a bare name that is not being
  called and is not the `def` line or an attribute) — i.e. the routine is
  passed around as a function object, typically into a `Callable[...]`
  parameter.

  An IMPORT statement does not count. `from m import run2` names the def with a
  bare identifier, which used to make every def an imported module exports take
  the function-object ABI — variant result AND every parameter boxed. For most
  parameter types that is only wasteful; for a `Callable[...]` parameter it is
  fatal, since the callee then holds a variant (by reference) where the caller
  passed a function VALUE and `call_ind` jumped to the variant's tag word
  (bug-nilpy-import-name-forces-function-object-abi). The scan is NOT narrowed
  to the current unit instead: a def defined in a module and passed as a value
  by the main program is the genuine case, and that lives outside PyScanLo.

  Such a def must use the one ABI every Callable signature marshals against.
  A `Callable[..., R]` cannot know which def it will receive, so both sides are
  normalised to the VARIANT (hidden-destination) result convention here and in
  PyAnnTypeAt's 'callable' branch. Without that, a def whose body infers a
  variant result (`return d.get(k, [])`) handed to a `Callable[[str], list[str]]`
  parameter returned through the hidden-destination convention while the
  indirect call site expected a register result — the callee then wrote its
  variant through whatever the caller happened to leave in the destination
  register. See bug-nilpy-callable-return-abi-mismatch. }
var j: Integer;
    atStmtStart, inImport: Boolean;
begin
  Result := False;
  j := 0;
  atStmtStart := True;
  inImport := False;
  while j < MainProgramTokCount do
  begin
    if Tokens[j].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon] then
    begin
      atStmtStart := True;
      inImport := False;
    end
    else if atStmtStart then
    begin
      inImport := (Tokens[j].Kind = tkUses) or
                  ((Tokens[j].Kind = tkIdent) and CaseEqual(GetTokenStr(j), 'from'));
      atStmtStart := False;
    end;
    if (not inImport) and
       (Tokens[j].Kind = tkIdent) and CaseEqual(GetTokenStr(j), nm) then
    begin
      if not (((j + 1 < MainProgramTokCount) and (Tokens[j + 1].Kind = tkLParen)) or
              ((j > 0) and (Tokens[j - 1].Kind = tkDot)) or
              ((j > 0) and (Tokens[j - 1].Kind = tkFunction))) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(j);
  end;
end;

{ Parses `def name(params) [-> ann]:` and leaves the cursor on the first BODY
  token, filling the PyHdr* globals.

  Contract worth stating because two recon sessions concluded otherwise and
  proposed patching this routine: the header is always followed by
  `: NEWLINE INDENT`, including for a ONE-LINE suite (`def f(): return 1`) —
  the LEXER synthesises the NEWLINE/INDENT/DEDENT when real code follows the
  header colon (a843c17d4, pylexer.inc). So every token-level body scan
  downstream finds an INDENT, and a missing one is a lexer-rule change, not a
  header bug. bug-nilpy-one-line-class-body-restraint-is-no-longer-enforced }
procedure PyParseDefHeader;
var annIdx, hdrDefIdx, hdrRetRec, starCi: Integer;
    isKwParam: Boolean;
begin
  if CurTok.Kind <> tkFunction then Error('Nil Python: expected def');
  hdrDefIdx := TokPos - 1;          { the `def` token, for return inference }
  Next;
  if CurTok.Kind <> tkIdent then Error('Nil Python: expected function name');
  PyHdrName := CurTok.SVal;
  Next;
  Expect(tkLParen, '(');
  PyHdrNParams := 0;
  PyHdrStarIdx := -1;
  PyHdrKwIdx := -1;
  while CurTok.Kind <> tkRParen do
  begin
    if PyHdrNParams >= 32 then Error('Nil Python: too many parameters');
    { A bare `*` marks the parameters after it keyword-only (PEP 3102). It is a
      MARKER, not a parameter: consumed and dropped, so the ones after it are
      ordinary parameters here. The DIFFERENCE from CPython is laxity — a
      keyword-only parameter can also be passed positionally in NilPy, which
      accepts programs CPython would reject but runs every program it accepts
      the same way. songformatter's analyze_key(chords, *, chord_to_notes=...)
      is the shape that needs it. `*args` / `**kwargs` proper are
      feature-nilpy-star-args-kwargs. }
    if (CurTok.Kind = tkStar) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind = tkComma) then
    begin
      Next;              { the '*' }
      Next;              { the ',' }
      Continue;
    end;
    { `*args` / `**kwargs` — the COLLECTION side (feature-nilpy-star-args-kwargs
      rung 1). The callee is ordinary: `*args` is ONE TPyList parameter and
      `**kwargs` ONE TPyDict, so the body indexes, iterates and len()s them with
      the machinery lists and dicts already have. Each CALL site packs its
      surplus positional arguments into the list and its unmatched keyword
      arguments into the dict — see PyPackStarArgs. `**` reaches here as two
      tkStar tokens, since the NilPy lexer has no `**` token. }
    if CurTok.Kind = tkStar then
    begin
      Next;                                   { the '*' }
      isKwParam := CurTok.Kind = tkStar;
      if isKwParam then Next;                 { the second '*' of `**` }
      if CurTok.Kind <> tkIdent then
        Error('Nil Python: expected a name after * in the parameter list');
      if (isKwParam and (PyHdrKwIdx >= 0)) or ((not isKwParam) and (PyHdrStarIdx >= 0)) then
        Error('Nil Python: ' + PyHdrName + '() has more than one * parameter of the same kind');
      PyHdrPNames[PyHdrNParams] := CurTok.SVal;
      Next;
      { `*args: str` annotates the ELEMENT type; the parameter itself is still a
        list, so the annotation is parsed (to consume it) and dropped. }
      if CurTok.Kind = tkColon then
      begin
        annIdx := TokPos - 1;
        PyAnnTypeAt(annIdx);
        TokPos := annIdx;
        Next;
      end;
      if isKwParam then starCi := FindUClass('TPyDict')
      else starCi := FindUClass('TPyList');
      if starCi < 0 then Error('Nil Python: pylib (TPyList/TPyDict) not loaded');
      PyHdrPTypes[PyHdrNParams] := tyClass;
      PyHdrPCis[PyHdrNParams] := starCi;
      PyHdrPSigs[PyHdrNParams] := -1;
      PyHdrDefHas[PyHdrNParams] := False;
      if isKwParam then PyHdrKwIdx := PyHdrNParams
      else PyHdrStarIdx := PyHdrNParams;
      Inc(PyHdrNParams);
      if not Eat(tkComma) then break;
      Continue;
    end;
    if CurTok.Kind <> tkIdent then Error('Nil Python: expected parameter name');
    PyHdrPNames[PyHdrNParams] := CurTok.SVal;
    Next;
    if CurTok.Kind <> tkColon then
    begin
      { UNANNOTATED parameter — Python does not require a type. Defaults to Any
        (variant), the same fallback an unannotated local gets. uforth's native
        word bodies are all `def w(vm):`. }
      PyHdrPTypes[PyHdrNParams] := tyVariant;
      PyHdrPCis[PyHdrNParams] := -1;
      PyHdrPSigs[PyHdrNParams] := -1;
    end
    else
    begin
      Expect(tkColon, ':');
      { same full annotation grammar as a method parameter }
      annIdx := TokPos - 1;
      PyAnnParamScope := True;
      PyHdrPTypes[PyHdrNParams] := PyAnnTypeAt(annIdx);
      PyAnnParamScope := False;
      PyHdrPCis[PyHdrNParams] := PyAnnLastCi;
      PyHdrPSigs[PyHdrNParams] := PyAnnLastProcSig;
      if PyHdrPTypes[PyHdrNParams] = tyUnknown then
      begin
        PyWarnUnreadAnnotation('parameter ' + PyHdrPNames[PyHdrNParams], Tokens[annIdx].Line);
        PyHdrPTypes[PyHdrNParams] := tyVariant;
        PyHdrPCis[PyHdrNParams] := -1;
        PyHdrPSigs[PyHdrNParams] := -1;
      end;
      TokPos := annIdx;
      Next;
    end;
    PyHdrDefHas[PyHdrNParams] := False;
    PyHdrDefSym[PyHdrNParams] := -1;
    PyHdrDefGName[PyHdrNParams] := -1;
    if CurTok.Kind = tkAssign then
    begin
      annIdx := TokPos;
      PyHdrDefHas[PyHdrNParams] := True;
      PyHdrDefVal[PyHdrNParams] :=
        PyParamDefaultAt(annIdx, PyHdrPNames[PyHdrNParams],
                         PyHdrDefIsStr[PyHdrNParams],
                         PyHdrDefSOff[PyHdrNParams],
                         PyHdrDefSLen[PyHdrNParams]);
      PyHdrDefIsNone[PyHdrNParams] := PyDefaultWasNone;
      PyHdrDefIsFloat[PyHdrNParams] := PyDefaultWasFloat;
      PyHdrDefIsBool[PyHdrNParams] := PyDefaultWasBool;
      PyHdrDefSym[PyHdrNParams] := PyDefaultSym;
      if PyDefaultSym >= 0 then
        PyHdrDefGName[PyHdrNParams] := InternStr(Syms[PyDefaultSym].Name)
      else PyHdrDefGName[PyHdrNParams] := -1;
      TokPos := annIdx;
      Next;
    end;
    Inc(PyHdrNParams);
    if not Eat(tkComma) then break;
  end;
  Expect(tkRParen, ')');
  PyHdrRetCi := -1;
  if CurTok.Kind <> tkMinus then
  begin
    { NO return annotation. Python does not require one, and 15 of uforth's
      defs omit it. Registered exactly as the member PRE-PASS already does for
      this case (PyMethodRetType yields tyUnknown, which it maps to tyInteger)
      — the two MUST agree, since the pre-pass decides the signature and this
      decides the frame, and a disagreement is a silent ABI mismatch. Kept a
      FUNCTION rather than a proc so `return <value>` still has a Result. }
    PyHdrIsProc := False;
    PyHdrRetType := PyInferDefRetType(hdrDefIdx, hdrRetRec);
    if PyHdrRetType = tyClass then
      PyHdrRetCi := hdrRetRec - REC_UCLASS_BASE;
  end
  else
  begin
    Expect(tkMinus, '- in ->');
    Expect(tkGt, '> in ->');
    { `-> None` declares a procedure (no Result) — UNLESS the body returns a
      value anyway (CPython ignores annotations; uforth's finalize_definition
      lies). Then the annotation loses and the type is inferred, or the caller
      reads a discarded Result as garbage. }
    PyHdrIsProc := CurTok.Kind = tkNil;
    if PyHdrIsProc and PyDefHasValueReturn(hdrDefIdx) then
    begin
      PyHdrIsProc := False;
      Next;   { the None }
      PyHdrRetType := PyInferDefRetType(hdrDefIdx, hdrRetRec);
      if PyHdrRetType = tyClass then
        PyHdrRetCi := hdrRetRec - REC_UCLASS_BASE;
    end
    else if PyHdrIsProc then begin PyHdrRetType := tyInteger; Next; end
    else
    begin
      PyAnnRetScope := True;
      PyHdrRetType := PyParseRetTypeOrAny;
      PyAnnRetScope := False;
      PyHdrRetCi := PyLastTypeCi;
      { the annotation is metadata, not enforcement — see PyJoinRetAnnotation.
        Its twin in PyMethodRetType must stay in step or the signature (decided
        there) and the frame (decided here) disagree, which is a silent ABI
        mismatch. }
      hdrRetRec := REC_NONE;
      if PyJoinRetAnnotation(PyHdrRetType, hdrDefIdx, hdrRetRec) = tyVariant then
      begin
        PyHdrRetType := tyVariant;
        PyHdrRetCi := -1;
      end;
    end;
  end;
  { `-> str` is an unbounded Python string, so the Result var is MANAGED — the
    method path has mapped it this way all along, and a def returning a string
    built past 255 characters truncated silently without it
    (bug-nilpy-string-local-truncates-at-255). }
  if PyHdrRetType = tyString then PyHdrRetType := tyAnsiString;
  { A def that is also used as a VALUE returns through the function-object ABI
    (see PyDefUsedAsValue): variant result, so every `Callable[...]` call site
    marshals the same way whichever def it received.

    A `-> None` PROCEDURE is normalised too, and that is not an optimisation —
    it is the whole point. The bridges call a function value through a
    VARIANT-RETURNING pointer type unconditionally (pyeval's TBF0..TBF13 in
    pyboundfn_callvn, pybound_callv*, and every `Callable[...]` signature —
    PyAnnTypeAt's callable branch says so in as many words: "a Callable
    signature is ALWAYS a variant-returning function"). A real procedure never
    sets the result register, so the bridge read its result from whatever was
    left there and dereferenced it.

    That is UNDEFINED, not reliably fatal, which is what made it look fixed:
    uforth's `-> None` native words `w_include` and `w_backslash` returned with
    a mapped address in the register and the junk read was harmless, then
    `w_colon` returned 0 and it segfaulted — three words into loading STD.UFO,
    with nothing wrong at the call site. Minimal repros of the shape PASSED for
    the same reason, so a pass/fail test of this is blind; the proof is that
    the compiled body ends `leave; ret` with no result written.

    The METHOD path (PyMethodUsedAsValue, PyRegisterClassMembers) has always
    normalised unconditionally and records the identical history — "a
    value-returning bound method crashed, a `-> None` one worked, which is why
    this looked like a receiver bug rather than an ABI one". Two arms of one
    rule that disagreed; this is the sibling.
    bug-nilpy-uforth-compiles-but-segfaults-at-runtime }
  { `__repr__` and `__str__` MUST return a str — CPython raises TypeError if
    they do not — and the runtime renderer (PyUserObjStr) will only call a
    dunder whose RetKind is AnsiString. An unannotated `def __repr__(self):
    return self.n` over an unannotated field infers VARIANT, so the renderer
    declined it and `repr(obj)` came back EMPTY while `print(obj)` (which takes
    the frontend's own class arm) was right. Spelling `-> str` fixed it, which
    is the measurement that found this: the annotation is doing nothing the
    dunder's contract does not already say.
    Forced in BOTH passes -- here for the frame, and in PyMethodRetType for the
    signature -- because a disagreement between them is a silent ABI mismatch.
    bug-nilpy-repr-returning-a-bare-string-field-is-empty }
  if PyStrDunderName(PyHdrName) and (not PyHdrIsProc) and
     (PyHdrRetType <> tyAnsiString) then
  begin
    PyHdrRetType := tyAnsiString;
    PyHdrRetCi := -1;
  end;
  if PyDefUsedAsValue(PyHdrName) then
  begin
    if PyHdrIsProc or (PyHdrRetType <> tyVariant) then
    begin
      PyHdrIsProc := False;
      PyHdrRetType := tyVariant;
      PyHdrRetCi := -1;
    end;
    { ...and its parameters, for the same reason (see PyAnnTypeAt's 'callable'
      branch). `*args` / `**kwargs` are already packed containers and keep their
      own types. }
    for hdrRetRec := 0 to PyHdrNParams - 1 do
      if (hdrRetRec <> PyHdrStarIdx) and (hdrRetRec <> PyHdrKwIdx) then
      begin
        PyHdrPTypes[hdrRetRec] := tyVariant;
        PyHdrPCis[hdrRetRec] := -1;
      end;
  end;
  Expect(tkColon, ':');
  Expect(tkNewline, 'newline');
  Expect(tkIndent, 'indent');
end;

{ Copy the parsed header's defaults and result class onto a registered Proc. }
procedure PyApplyDefSignature(procIdx: Integer);
var i: Integer;
begin
  { A class-returning def must record WHICH class, or the call site has a
    tyClass value with no identity and a later field access reads the object
    POINTER (test_nilpy_class_return). }
  if (PyHdrRetType = tyClass) and (PyHdrRetCi >= 0) then
    ProcRetRecId[procIdx] := REC_UCLASS_BASE + PyHdrRetCi;
  { which parameter is `*args` / `**kwargs`, for the call-site packing. The rec
    id is recorded too: a param symbol is reused once the callee's scope closes,
    so overload matching reads the class from ProcParamRecId. }
  ProcPyStarIdx[procIdx] := PyHdrStarIdx;
  ProcPyKwIdx[procIdx] := PyHdrKwIdx;
  if (PyHdrStarIdx >= 0) and (PyHdrStarIdx < MAX_PROC_PARAMS) then
    ProcParamRecId[procIdx * MAX_PROC_PARAMS + PyHdrStarIdx] :=
      REC_UCLASS_BASE + PyHdrPCis[PyHdrStarIdx];
  if (PyHdrKwIdx >= 0) and (PyHdrKwIdx < MAX_PROC_PARAMS) then
    ProcParamRecId[procIdx * MAX_PROC_PARAMS + PyHdrKwIdx] :=
      REC_UCLASS_BASE + PyHdrPCis[PyHdrKwIdx];
  for i := 0 to PyHdrNParams - 1 do
    if PyHdrDefHas[i] and (i < MAX_PROC_PARAMS) then
    begin
      ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + i] := True;
      ProcParamDefaultVal[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefVal[i];
      ProcParamDefaultIsStr[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefIsStr[i];
      ProcParamDefaultIsNone[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefIsNone[i];
      ProcParamDefaultIsFloat[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefIsFloat[i];
      ProcParamDefaultIsBool[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefIsBool[i];
      ProcParamDefaultSOff[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefSOff[i];
      ProcParamDefaultSLen[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefSLen[i];
      { -1 unless the default was non-constant and actually evaluated — a
        pre-pass leaves it -1, and the REAL parse must not be left holding the
        pre-pass's answer, so this is written unconditionally with the rest. }
      ProcParamDefaultSym[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefSym[i];
      ProcParamDefaultGName[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefGName[i];
    end;
end;

{ Register every TOP-LEVEL def's SIGNATURE before anything is typed or
  compiled.

  PyDefReturnType used to answer "what does this def return?" with its own
  token scan, because module-local inference runs before any def body is
  parsed and therefore before any Proc exists. That is the same parse-it-twice
  drift the local-typing pre-pass had, and it only ever recovered the return
  TYPE — not the result class, not the parameter defaults, not the signature
  for a forward call.

  Parse each header ONCE here instead, with the real header parser, and
  register the Proc. From then on inference and codegen both just call
  FindProc. Bodies are skipped by span, so this emits no code and allocates no
  symbols. }
{ Is the `def` at token index i decorated with `@overload`? The stub must be
  invisible to the shell pre-pass as well as to the body parse: the pre-pass
  registers a bodyless shell from the HEADER, so a skipped stub would still have
  bound its annotated signature and the implementation's own registration would
  lose to it — `f(1)` then failed with "by-reference argument must be a
  variable", pointing at the call rather than at the stub that mis-registered.

  Accepts `@overload` and `@typing.overload`; walks back over the newlines
  between the decorator and the def, and over any dotted qualifier.
  bug-n-overload-decorator-is-refused }
function PyDefAtIsOverloadStub(i: Integer): Boolean;
var j: Integer;
begin
  Result := False;
  j := i - 1;
  while (j >= 1) and (Tokens[j].Kind in [tkNewline, tkIndent, tkDedent]) do Dec(j);
  if (j < 1) or (Tokens[j].Kind <> tkIdent) then Exit;
  if GetTokenStr(j) <> 'overload' then Exit;
  Dec(j);
  while (j >= 1) and (Tokens[j].Kind = tkDot) do
  begin
    Dec(j);
    if (j >= 1) and (Tokens[j].Kind = tkIdent) then Dec(j) else Exit;
  end;
  Result := (j >= 0) and (Tokens[j].Kind = tkAt);
end;

{ ===== Nil Python generators =====
  A `def` whose body contains a `yield` is a GENERATOR, and Python decides that
  at compile time from the body alone — there is no marker in the header. So the
  frontend scans the def's token span before parsing it (PyDefBodyHasYield) and,
  when it hits, rewrites the routine onto the STACKLESS generator ABI the Pascal
  frontend already uses: `function(__genself: Pointer): Boolean`, a state-machine
  step function over lib/rtl/slgen.pas. Nothing about the engine is new here —
  the transform (SLCheckEligible / AssignStacklessSlots / BuildStacklessStep) and
  the consumption protocol (ParseForInGeneratorAST) are shared with Pascal and
  were built and proven there. What follows is the wiring.

  Stackless rather than stackful deliberately: the stackful strategy costs a
  64 KB heap stack per LIVE generator, and a Python filter pipeline holds several
  open at once. Measured over the ladder corpora: 19 generator functions, 76
  yield sites, ZERO with a yield inside a try or with — the two shapes the
  stackless transform refuses. See feature-nilpy-yield-outside-a-for-loop. }

{ Does this def's body contain a statement-position `yield`?

  Scanned, not inferred from the header, because that is where Python keeps the
  answer. A NESTED def's yield makes the INNER routine a generator and says
  nothing about this one, so the scan stops descending at a `def` and resumes at
  the matching dedent — without that, `def outer(): def inner(): yield 1` marked
  outer a generator and its ordinary `return` then had nowhere to go. }
function PyDefBodyHasYield(bodyStart: Integer): Boolean;
var i, depth, nestDepth: Integer;
begin
  Result := False;
  i := bodyStart;
  depth := 1;        { the caller has already consumed the body's own INDENT }
  nestDepth := -1;   { depth at which a nested def was seen; -1 = not inside one }
  while i < TokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      if (nestDepth >= 0) and (depth <= nestDepth) then nestDepth := -1;
      if depth <= 0 then Break;
    end
    else if (nestDepth < 0) and (Tokens[i].Kind = tkFunction) then
      nestDepth := depth
    else if (nestDepth < 0) and (Tokens[i].Kind = tkIdent) and (i > 0) and
            (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]) and
            (GetTokenStr(i) = 'yield') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ Does the def/method whose `def` keyword sits at token `defTok` contain a
  yield in its own body? PyDefBodyHasYield answers that from the body's first
  token, which the two DEF paths already have in hand; the two METHOD paths do
  not — they reach a method by its `def` token — so this walks the header first.

  The walk stops at the `:` that closes the header at bracket depth zero, which
  is why the depth counts braces as well as parens: a parameter default can be a
  dict literal, and its colons are not the header's. }
function PyDefAtHasYield(defTok: Integer): Boolean;
var i, depth: Integer;
begin
  Result := False;
  i := defTok;
  depth := 0;
  while i < TokCount do
  begin
    { `{` / `}` are tkBegin / tkEnd in the Nil Python token stream }
    if (Tokens[i].Kind = tkLParen) or (Tokens[i].Kind = tkLBrack) or
       (Tokens[i].Kind = tkBegin) then Inc(depth)
    else if (Tokens[i].Kind = tkRParen) or (Tokens[i].Kind = tkRBrack) or
            (Tokens[i].Kind = tkEnd) then Dec(depth)
    else if (depth <= 0) and (Tokens[i].Kind = tkColon) then Break
    else if (depth <= 0) and (Tokens[i].Kind = tkNewline) then Exit;  { not a def header }
    Inc(i);
  end;
  if i >= TokCount then Exit;
  Inc(i);
  { A RUN of newlines, not one: a blank (or whitespace-only) line between the
    header and the first statement emits another. Consuming exactly one left
    this scan looking at a NEWLINE where it wanted the INDENT, so it fell
    through to the inline-suite branch and answered "no yield" — while
    PyParseMethod, which starts from the real body token, answered "yes". The
    two passes then built a method with different arities and the program
    segfaulted: precisely the silent ABI mismatch this file warns about
    everywhere the pre-pass and the real parse both read a signature. }
  while (i < TokCount) and (Tokens[i].Kind = tkNewline) do Inc(i);
  if (i < TokCount) and (Tokens[i].Kind = tkIndent) then
  begin
    Result := PyDefBodyHasYield(i + 1);
    Exit;
  end;
  { an INLINE suite — `def f(): yield 1` — is one line and has no INDENT }
  while (i < TokCount) and (Tokens[i].Kind <> tkNewline) do
  begin
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = 'yield') then
    begin
      Result := True;
      Exit;
    end;
    Inc(i);
  end;
end;

{ Rewrite the parsed header onto the stackless step ABI:
  `function(__genself: Pointer): Boolean`. The DECLARED parameters describe the
  produced sequence and shift to 1..n, where they become persistent instance
  slots the transform restores each step; the step function itself takes only
  the instance pointer and returns has-next. Mirrors the Pascal rewrite in
  ParseRoutine (parser.inc), on this frontend's own header arrays.

  Every per-param array shifts, not just the interesting ones: the ONE array
  left behind in the Pascal twin wrote a real parameter's attribute into the
  injected slot and read stale data for the parameter itself, silently. }
procedure PyApplyGeneratorABI;
var i: Integer;
begin
  if PyHdrNParams >= 31 then
    Error('Nil Python: too many parameters for a generator');
  if PyHdrNParams > SL_MAX_PARAMS then
    Error('Nil Python: a generator takes at most ' + AIntToStr(SL_MAX_PARAMS) +
          ' parameters (v1)');
  PyGenDeclParams := PyHdrNParams;
  { Nil Python's values are variants, so that is the element type regardless of
    what the return-type inference made of a body whose only exits are yields.
    Fixing it here rather than inferring keeps the consumer side (the for-in
    desugar's variant arm) from having to agree with a second inference pass. }
  PyGenElemTk := tyVariant;
  for i := PyHdrNParams downto 1 do
  begin
    PyHdrPNames[i]     := PyHdrPNames[i - 1];
    PyHdrPTypes[i]     := PyHdrPTypes[i - 1];
    PyHdrPCis[i]       := PyHdrPCis[i - 1];
    PyHdrPSigs[i]      := PyHdrPSigs[i - 1];
    PyHdrDefHas[i]     := PyHdrDefHas[i - 1];
    PyHdrDefIsStr[i]   := PyHdrDefIsStr[i - 1];
    PyHdrDefIsNone[i]  := PyHdrDefIsNone[i - 1];
    PyHdrDefIsFloat[i] := PyHdrDefIsFloat[i - 1];
    PyHdrDefIsBool[i]  := PyHdrDefIsBool[i - 1];
    PyHdrDefSym[i]     := PyHdrDefSym[i - 1];
    PyHdrDefGName[i]   := PyHdrDefGName[i - 1];
    PyHdrDefVal[i]     := PyHdrDefVal[i - 1];
    PyHdrDefSOff[i]    := PyHdrDefSOff[i - 1];
    PyHdrDefSLen[i]    := PyHdrDefSLen[i - 1];
  end;
  if PyHdrKwIdx >= 0 then Inc(PyHdrKwIdx);
  if PyHdrStarIdx >= 0 then Inc(PyHdrStarIdx);
  PyHdrPNames[0]     := '__genself';
  PyHdrPTypes[0]     := tyPointer;
  PyHdrPCis[0]       := -1;
  PyHdrPSigs[0]      := -1;
  PyHdrDefHas[0]     := False;
  PyHdrDefIsStr[0]   := False;
  PyHdrDefIsNone[0]  := False;
  PyHdrDefIsFloat[0] := False;
  PyHdrDefIsBool[0]  := False;
  PyHdrDefSym[0]     := -1;
  PyHdrDefGName[0]   := -1;
  PyHdrDefVal[0]     := 0;
  PyHdrDefSOff[0]    := 0;
  PyHdrDefSLen[0]    := 0;
  Inc(PyHdrNParams);
  { The step function RETURNS has-next; the declared result type describes the
    yielded ELEMENT and is remembered separately (ProcGenElemTk). }
  PyHdrRetType := tyBoolean;
  PyHdrRetCi := -1;
  PyHdrIsProc := False;
end;

{ Record the generator properties on the Proc, so the for-in desugar can see
  them from a call site and the body compile can drive the transform. Must run
  on BOTH registration paths — the shell pre-pass and the real parse — or the
  two disagree about the routine's arity by exactly one. }
procedure PyMarkGeneratorProc(procIdx: Integer);
begin
  if procIdx < 0 then Exit;
  ProcIsGenerator[procIdx] := True;
  ProcIsStackless[procIdx] := True;
  ProcGenElemTk[procIdx]   := PyGenElemTk;
  ProcGenElemRec[procIdx]  := REC_NONE;
  ProcGenParamCnt[procIdx] := PyGenDeclParams;
end;

{ Pull lib/rtl/slgen into scope when the module defines any generator. The
  transform and the for-in desugar both call SlNew/SlGet/SlSet/SlCurrent/SlFree
  by name, so without the unit they fail at build time with "the slgen unit is
  not in scope" — a true statement about a unit the user never asked for. }
procedure PyPullSlgenIfGenerators;
var i: Integer;
begin
  if FindProc('SlNew') >= 0 then Exit;      { already in scope }
  for i := PyScanLo to MainProgramTokCount - 1 do
    if (Tokens[i].Kind = tkIdent) and (i > 0) and
       (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon]) and
       (GetTokenStr(i) = 'yield') then
    begin
      ParseUsesUnit('slgen');
      Exit;
    end;
end;

procedure PyRegisterDefShells;
var savedTok, i, depth, procIdx, savedHoist: Integer;
    isGenDef: Boolean;
begin
  savedTok := TokPos;
  { This pass parses HEADERS ONLY, but a header can queue a hoisted setup
    statement (a default's value, an inferred return's trial parse), and the
    hoist queue is global. Left queued, that node was flushed into whatever
    statement came next — in a MODULE, after the symbols it names had been
    rolled back, which the IR verifier then rejected at the module's last line
    with nothing there to explain it. Nothing this pass queues is wanted: it
    emits no code and the real parse builds its own. }
  savedHoist := PyHoistHead;
  i := PyScanLo;
  depth := 0;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkFunction) and
            not PyDefAtIsOverloadStub(i) then
    begin
      TokPos := i;
      Next;                      { CurTok = 'def' }
      PyParseDefHeader;
      { A def whose body yields is a GENERATOR, and its registered signature must
        already be the stackless step ABI — the real parse rewrites the same
        header the same way, and a shell registered with the declared arity would
        disagree with the body's frame by exactly the injected __genself. }
      isGenDef := PyDefBodyHasYield(TokPos - 1);
      if isGenDef then PyApplyGeneratorABI;
      { "has the MAIN PROGRAM already declared this name", not "does any proc of
        this name exist anywhere". The old test was FindProc, which also sees
        UNIT procs — so a module-level `def len(x)` was never registered at all,
        because pylib already declares `len`, and everything downstream behaved
        as if the user had not written it
        (bug-nilpy-user-def-len-of-a-container-still-binds-the-builtin). }
      if FindProcInUnit(PyHdrName, -1) < 0 then
      begin
        procIdx := RegisterProc(PyHdrName, not PyHdrIsProc, PyHdrRetType,
                                PyHdrNParams, PyHdrPNames, PyHdrPTypes);
        PyApplyDefSignature(procIdx);
        if isGenDef then PyMarkGeneratorProc(procIdx);
        { Record WHERE the def stands. The shell has to exist from the top of the
          module or the name is not visible at all (that was the `len` bug), but
          Python only rebinds a name when the `def` STATEMENT runs — so a call
          ABOVE it must still reach whatever the name meant before, which for a
          builtin is the builtin. test_nilpy_min_max_variadic pins exactly that:
          `min(3, 1, 2)` above a `def min(a, b, c, d, e)` is the builtin's 1.
          Only PyUserShadowsProc reads this, so it costs nothing anywhere else. }
        ProcPyDefTok[procIdx] := i;
      end;
      { Resume at the body's INDENT, not past it. After PyParseDefHeader the
        cursor sits on the first BODY token, so TokPos-2 is the INDENT and the
        loop's own Inc(i) must land ON it — resuming at TokPos-2 skipped it,
        depth never rose, and every method inside a later class then looked
        top-level (a `self` parameter with no annotation, reported as a stray
        token 40 lines away). }
      i := TokPos - 3;
    end;
    Inc(i);
  end;
  PyHoistHead := savedHoist;
  { Re-READ the saved token rather than restoring a copy of CurTok: Next
    rewrites CurTok.SVal in place
    (project_curtok_record_copy_shares_sval_landmine). }
  TokPos := savedTok - 1;
  Next;
end;

{ Compile a LIFTED lambda's body: the queued proc's frame, then one
  `return <expr>` parsed from the body's token span. Mirrors PyParseDef's body
  half — a lambda has no statements, no locals and no nested defs, so what is
  left is the prologue, the expression, and the epilogue.
  (feature-nilpy-lambda-compiled-closure) }
{ Is this lambda body's value a FRESHLY BUILT object the body itself owns, as
  opposed to an alias of something that outlives the call?

  The distinction matters because PyCompileLambdaBody refuses to return a
  tyClass/tyRecord value at all — see the note at its exit-wrap — and that
  blanket refusal was aimed at `lambda s: log.append(s)`, whose result is the
  CAPTURED list itself. A container LITERAL is the opposite case: its lowering
  hoists `__py_lit_N := <new>` and hands back a read of that temp, which OWNS
  the construction ref (see PyParseListLiteralT), so returning it is exactly
  what every other body path does with a `return [..]`.

  Structural, not by name: an AN_IDENT of a LOCAL allocated inside this body's
  own scope. A capture arrives as a PARAMETER and so is excluded, which is the
  aliasing case the refusal exists for; a method-call result is an AN_CALL and
  is excluded too. A lambda body is a single expression, so a local here can
  only be a hoist temp.

  SECOND CASE (2026-08-09): a call to one of pylib's own CONSTRUCTOR builtins —
  `list(s)`, `tuple(s)`, `sorted(s)`, `dict(x)`, `bytes(b)`, `reversed(l)`.
  These were on the wrong side of the line and the cost was not "returns None":
  the refusal emits the call and NO exit at all, so `$pyresult` is never stored
  and the caller reads an uninitialised slot — `lambda x: list(x)` gave None and
  `lambda x: sorted(x)` SEGFAULTED, from the same cause.

  The distinction that matters is fresh-vs-alias, not call-vs-ident, and these
  are provably fresh: every one of them does `r := TPyList.Create` (or the
  bytes/dict equivalent) and fills a NEW object, so the value owns its
  construction ref exactly as a literal's hoist temp does. Verified by reading
  the bodies in pylib.pas, not assumed from the Python semantics — `bytes(b)`
  in particular could have returned its argument and does not, it copies.

  A USER def returning a list stays excluded even though it is also an AN_CALL:
  it may return a captured global, which is the aliasing case again. Hence the
  unit check — the name alone is not enough, because a user `def list(...)`
  shadows by argument fit (project_findproc_by_name_ignores_overloads), and
  matching it by name would hand back an alias under a builtin's name. }
function PyProcIsFreshContainerCtor(pi: Integer): Boolean;
{ A pylib builtin that ALWAYS returns a newly constructed container. Named
  rather than structural because "does this callee alias one of its arguments?"
  is not answerable from the signature; the unit check is what keeps a
  same-named user def out. }
var nm, un: AnsiString;
begin
  PyProcIsFreshContainerCtor := False;
  if (pi < 0) or (pi >= ProcCount) then Exit;
  if ProcUnitIdx[pi] < 0 then Exit;      { the main program — a user def }
  un := Strs[ProcUnitIdx[pi]].Text;
  nm := Procs[pi].Name;
  if un = 'pylib' then
    PyProcIsFreshContainerCtor :=
      CaseEqual(nm, 'list') or CaseEqual(nm, 'tuple') or CaseEqual(nm, 'dict') or
      CaseEqual(nm, 'bytes') or CaseEqual(nm, 'bytearray') or
      CaseEqual(nm, 'reversed')
  else if un = 'pyeval' then
    { `sorted` lives in pyeval, not pylib, because it takes a key CALLBACK. Its
      body is `r := TPyList.Create` then append, same as the pylib rows. }
    PyProcIsFreshContainerCtor := CaseEqual(nm, 'sorted');
end;

function PyLambdaResultIsOwnedTemp(n, procIdx: Integer): Boolean;
var s: Integer;
begin
  PyLambdaResultIsOwnedTemp := False;
  if n < 0 then Exit;
  if ASTKind[n] = AN_CALL then
  begin
    PyLambdaResultIsOwnedTemp := PyProcIsFreshContainerCtor(ASTIVal[n]);
    Exit;
  end;
  if ASTKind[n] <> AN_IDENT then Exit;
  s := ASTIVal[n];
  if (s < 0) or (s >= SymCount) then Exit;
  if Syms[s].Kind <> skLocal then Exit;
  PyLambdaResultIsOwnedTemp := s >= Procs[procIdx].ScopeBase;
end;

procedure PyCompileLambdaBody(procIdx, bStart, realProcIdx: Integer);
var i, idx, patchPos, savedSC, savedFS, nparams, node, seqNode, exitNode,
    wArgSeq, wArgLast, wArgNode, wIdentNode, wCallNode: Integer;
    savedExprMode: Boolean;
begin
  { NilPy expression rules must be ON while this body parses — the module-level
    drain runs after ParsePyProgram turned them off, and without them a `.name`
    read off a VARIANT parameter fell through to a raw field read at offset 0
    (it printed the variant's TYPE TAG instead of the attribute). }
  savedExprMode := PyExprMode;
  PyExprMode := True;
  nparams := Procs[procIdx].ParamCount;
  savedSC := SymCount;
  savedFS := FrameSize;
  FrameSize := 0;
  CurProc := procIdx;
  Procs[procIdx].ScopeBase := SymCount;
  for i := 0 to nparams - 1 do
  begin
    idx := AllocParam(Procs[procIdx].Params[i].Name, Procs[procIdx].Params[i].TypeKind,
                      Procs[procIdx].Params[i].TypeKind = tyVariant, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    Procs[procIdx].Params[i].IsRef := Procs[procIdx].Params[i].TypeKind = tyVariant;
    if i < MAX_PROC_PARAMS then
      ProcParamIsConst[procIdx * MAX_PROC_PARAMS + i] :=
        Procs[procIdx].Params[i].TypeKind = tyVariant;
    { AllocParam seeds RecName from LastTypeRecId — the type the parser last
      saw ANYWHERE — and this body is compiled far from its own header, so the
      leftover made every variant param look like a class instance and
      `event.width` reported "no such member" instead of reading a dynamic
      attribute. Set the class identity explicitly, or clear it. }
    if (Procs[procIdx].Params[i].TypeKind = tyClass) and (i < MAX_PROC_PARAMS) and
       (ProcParamRecId[procIdx * MAX_PROC_PARAMS + i] >= REC_UCLASS_BASE) then
      Syms[idx].RecName := ProcParamRecId[procIdx * MAX_PROC_PARAMS + i]
    else
      Syms[idx].RecName := REC_NONE;
    SymSyncTypeRef(idx);
  end;
  { A lifted lambda RETURNS a variant, because every bridge that invokes one
    (pyboundfn_call_ptr, pyvar_callv*) declares the callee that way — a Variant
    result rides a hidden destination the caller allocates AND comes back as a
    pointer in the result register. Compiled as a procedure, that register held
    whatever the body's last call left there, and the caller's `rv := f(...)`
    dereferenced it: `lambda x: body()` crashed the moment the def it called
    took no arguments, and survived by luck when it took one. The Result slot is
    zero-initialised, so a lambda whose value nobody reads yields None. }
  if Procs[procIdx].RetType = tyVariant then
  begin
    idx := AllocVar('$pyresult', tyVariant);
    Procs[procIdx].RetSymIdx := idx;
    Syms[idx].Kind := skLocal;       { gates the prologue zero-init }
    if RetViaHiddenDest(tyVariant) then
    begin
      idx := AllocVar('', tyPointer);
      ProcAggregateDestSym[procIdx] := idx;
    end;
  end;
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue;
  Procs[procIdx].FramePatch := patchPos;
  { Stash the hidden destination pointer the caller passed for the Variant
    result. Every other NilPy body path emits this; the lambda path did not, so
    the epilogue's 16-byte result copy went to whatever stale stack bytes sat in
    the dest slot. The text segment is writable, so on the first call that
    garbage happened to be a RETURN ADDRESS and the copy zeroed 16 bytes of the
    runtime's own code (pynone's); the program then died on the NEXT call into
    the clobbered routine, arbitrarily far from here — which is why this read as
    "a lambda crashes the second time it runs"
    (bug-nilpy-nested-def-capture-sets-are-not-final, face 2). }
  EmitAggregateDestStash(procIdx);
  PyEmitParamSpills(procIdx, nparams);
  PyInitVariantLocals(Procs[procIdx].ScopeBase);
  EmitManagedLocalsZeroInit(Procs[procIdx].ScopeBase);
  if bStart = -1 then
  begin
    { A CALLABLE-VALUE WRAPPER (feature-nilpy-callable-value-unified-dispatch):
      no source span to parse -- hand-build `return REALPROC(a0, a1, ...)`,
      one AN_IDENT per own Variant parameter feeding the real proc's call
      exactly the way a genuine `return realproc(a0)` would parse, so the
      ordinary argument/return coercion (Variant param -> the real proc's
      actual param type, and back) applies unchanged. }
    wArgSeq := -1; wArgLast := -1;
    for i := 0 to nparams - 1 do
    begin
      wIdentNode := AllocNode(AN_IDENT);
      ASTIVal[wIdentNode] := Procs[procIdx].Params[i].SymIdx;
      ASTTk[wIdentNode] := Ord(tyVariant);
      wArgNode := AllocNode(AN_ARG);
      ASTLeft[wArgNode] := wIdentNode; ASTRight[wArgNode] := -1;
      if wArgLast < 0 then wArgSeq := wArgNode else ASTRight[wArgLast] := wArgNode;
      wArgLast := wArgNode;
    end;
    wCallNode := AllocNode(AN_CALL);
    ASTIVal[wCallNode] := realProcIdx;
    ASTTk[wCallNode] := Ord(Procs[realProcIdx].RetType);
    ASTRight[wCallNode] := ProcRetRecId[realProcIdx];
    ASTLeft[wCallNode] := wArgSeq;
    CurASTNode := wCallNode;
  end
  else
  begin
    TokPos := bStart;
    Next;
    PyParseBoolExpr;
  end;
  { the expression IS the whole lambda body, so its VALUE is what the lambda
    evaluates to -- wrap it in a real AN_EXIT (exactly what a written
    `return <expr>` produces) so it stores into $pyresult through the SAME
    coercion CompileAST already gives every other `return`, rather than being
    evaluated for its side effect alone and thrown away. Before this, ANY
    lifted lambda whose value was actually read back answered None
    unconditionally -- `h = lambda s: len(s); h("abcde")` -- since nothing
    ever wrote $pyresult; only a lambda used purely for its side effect (the
    shape the lifter was first built for) happened to look correct.

    EXCLUDES a tyClass/tyRecord result: `lambda s: log.append(s)` (append
    returns Self) boxed into $pyresult and released by a caller that discards
    it drove the SAME captured `log` to refcount 0 and freed it out from under
    the enclosing scope that still owned it (traced with -dPXX_OBJTRACE: 4
    retains/5 releases where the scalar/string case balances at 2/2) --
    an aliased captured object's ownership around the bound-fn bridge is not
    accounted for correctly here, and is the ARC gap
    bug-nilpy-bound-fn-closure-objects-are-never-freed already tracks. Keep
    the old discard-only behaviour for that shape rather than risk it; every
    scalar and managed-STRING result (checked with -dPXX_OBJTRACE too, and
    balances) is fixed.
    bug-nilpy-lifted-lambda-discards-its-return-value

    A container LITERAL is carved back OUT of that exclusion: `lambda x: [x, 1]`
    and `lambda x: (x, x+1)` hand back a read of a hoist temp that OWNS its
    construction ref, so there is no second owner to unbalance — and being
    swept up by the blanket refusal made every such lambda return None, silently
    (bug-nilpy-a-tuple-returned-from-a-lambda-becomes-a-list). }
  if (IntToTypeKind(ASTTk[CurASTNode]) in [tyClass, tyRecord]) and
     not PyLambdaResultIsOwnedTemp(CurASTNode, procIdx) then
    node := CurASTNode
  else
  begin
    exitNode := AllocNode(AN_EXIT);
    ASTLeft[exitNode] := CurASTNode;
    node := exitNode;
  end;
  { any temporaries the expression hoisted must be emitted before it, and
    CompileAST wants a BLOCK the way every other body path hands it one }
  node := PySeqAppend(PyFlushHoist(-1), node);
  seqNode := AllocNode(AN_BLOCK);
  ASTLeft[seqNode] := node;
  ASTTk[seqNode] := Ord(tyUnknown);
  CompileAST(seqNode);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
    ProcBodyEnd[procIdx] := CodeLen;   { DWARF -g — see PyParseDef's note }
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  if DebugInfo and ProcDbgMain[procIdx] then DbgCaptureProcLocals(procIdx);
  SymRollbackTo(savedSC);
  FrameSize := savedFS;
  CurProc := -1;
  PyExprMode := savedExprMode;
end;

{ Drain the lambda bodies queued while compiling the routine that just ended,
  back to the mark it took on entry — the same discipline the nested-def queue
  follows, and for the same reason: a lambda inside a lifted lambda would queue
  onto this list too. }
procedure PyDrainPendingLambdas(mark: Integer);
var savedTok, savedSelf: Integer; savedPfx: AnsiString;
begin
  while PyPendLamCount > mark do
  begin
    Dec(PyPendLamCount);
    savedTok := TokPos;
    { RESTORE the nest prefix the lambda was WRITTEN under, the same way the
      nested-def drain in PyParseDef restores PyPendNestPfx. A lifted lambda's
      body is compiled after the enclosing def's epilogue, by which point
      PyNestPrefix has been popped back to the enclosing scope's — so a call to
      a SIBLING NESTED def could not be qualified and failed with "undefined
      variable (add)". It had nothing to do with captures or with the lambda's
      position, which is how the ticket originally read it: a NON-capturing
      sibling and an argument-position lambda failed identically, while a
      top-level callee worked (bug-nilpy-lambda-over-a-capturing-nested-def-
      does-not-compile). }
    savedPfx := PyNestPrefix;
    savedSelf := CurSelfClass;
    PyNestPrefix := PyPendLamPfx[PyPendLamCount];
    CurSelfClass := PyPendLamSelf[PyPendLamCount];
    PyCompileLambdaBody(PyPendLamProc[PyPendLamCount], PyPendLamTok[PyPendLamCount],
                        PyPendLamWrapReal[PyPendLamCount]);
    CurSelfClass := savedSelf;
    PyNestPrefix := savedPfx;
    TokPos := savedTok - 1;
    Next;
  end;
end;

procedure PyParseDef;
var isGenDef: Boolean;
    savedGenerator, savedGenStackless, savedGenSeen, savedGenIsVariant: Boolean;
    savedGenStateCtr, savedGenSlotNext, savedGenScopeBase, savedGenElemOff: Integer;
    name, savedPfx, savedPfx2: AnsiString;
    nparams, i, procIdx, idx, savedSC, savedFS, patchPos, bodyStart, bodyNode: Integer;
    pbInit, pbAsgn, pbOwn: Integer;
    pbLocal: array[0..MAX_PROC_PARAMS - 1] of Integer;
    savedNest, savedTok, savedLam, savedHoist, savedSelf2: Integer;
    defTok0: Integer;   { this def's `def` token — the redefinition key }
    savedDefGlobals: array[0..PY_MAX_DEF_GLOBALS-1] of AnsiString;
    savedDefGlobalCount, dgI, cellInit: Integer;
    retType: TTypeKind; isProc, capByRef: Boolean;
begin
  { Captured BEFORE the header parse moves TokPos: PyParseDef is entered with
    the cursor just past the `def` keyword (the queue driver does
    `TokPos := <def token>; Next`), which is the same token the queueing pass
    keyed the redefinition on. }
  defTok0 := TokPos - 1;
  { A nested def is drained at the END of this routine, by re-entering here — so
    every bit of generator context is per-invocation and must be stacked, or a
    plain nested def inside a generator would compile as a second generator. }
  savedGenerator     := CurProcIsGenerator;
  savedGenStackless  := CurProcIsStackless;
  savedGenSeen       := CurGenSeenYield;
  savedGenIsVariant  := CurGenElemIsVariant;
  savedGenStateCtr   := CurGenStateCtr;
  savedGenSlotNext   := CurGenSlotNext;
  savedGenScopeBase  := CurGenScopeBase;
  savedGenElemOff    := CurGenElemOff;
  savedHoist := PyHoistHead;
  { PARK the queue on a fresh chain rather than merely remembering its head.
    `PyHoistHead := savedHoist` at the end cannot UNLINK anything: PySeqAppend
    mutates the saved chain's tail in place, so with a hoist already pending
    (a class attribute with a non-literal initialiser queues one at the class
    statement) this body's own hoisted statements stayed reachable through it
    and were flushed into the MODULE body — where they reference this routine's
    locals. The visible symptom was a class losing a whole tuple return to
    silence or a segfault, three lines away from an attribute nothing read
    (bug-nilpy-non-literal-class-attribute-corrupts-the-class-layout). A body's
    own hoists are flushed by its statement loop; the rest is stale by
    construction, which is what the restore always meant to express. }
  PyHoistHead := -1;
  { Python's binding rule is per-FUNCTION, so the `global`/`nonlocal` set is a
    property of THIS body — saved and restored so a nested def (drained at the
    end of this routine) cannot leak its declarations into the enclosing one. }
  savedDefGlobalCount := PyDefGlobalCount;
  for dgI := 0 to PyDefGlobalCount - 1 do savedDefGlobals[dgI] := PyDefGlobalName[dgI];
  { The REAL header parse — non-constant defaults are evaluated here, at the
    point the def statement stands, which is where Python evaluates them.

    NOT for a NESTED def (PyNestPrefix <> ''): those are queued at their `def`
    statement and compiled AFTER the enclosing routine's epilogue, so by the
    time this runs the enclosing scope is gone and `def inner(b=q)` would report
    `q` undefined. A nested def with a non-constant default therefore keeps the
    old None behaviour on the direct-call path; the closure-VALUE path already
    evaluates it (PyNestedDefClosureValue). Tracked on the ticket. }
  PyDefaultEvalMode := PyNestPrefix = '';
  PyParseDefHeader;
  PyDefaultEvalMode := False;
  name := PyHdrName;
  nparams := PyHdrNParams;
  isProc := PyHdrIsProc;
  retType := PyHdrRetType;
  bodyStart := TokPos - 1;
  { A `yield` anywhere in the body makes this a GENERATOR — the same scan and the
    same ABI rewrite the shell pass ran, so the two agree about the arity. From
    here on the routine is a stackless state-machine step function; the body
    compile below drives the transform instead of emitting an ordinary frame. }
  isGenDef := PyDefBodyHasYield(bodyStart);
  if isGenDef then
  begin
    PyApplyGeneratorABI;
    nparams := PyHdrNParams;
    isProc := PyHdrIsProc;
    retType := PyHdrRetType;
    { Set BEFORE the local-typing pre-pass, not after. That pre-pass TRIAL-PARSES
      the body, so it meets the `yield` statements too — with the context still
      unset they are refused there, several passes before anything a user could
      recognise. The ordering is not obvious and cost a cycle to find. }
    CurProcIsGenerator := True;
    CurProcIsStackless := True;
    CurGenSeenYield := False;
  end;
  PyScanDefGlobals(bodyStart);

  { Reuse the shell PyRegisterDefShells registered for this def. A shell has
    BodyAddr = -1; anything else means the name is being DEFINED AGAIN, which
    Python allows, so that gets its own Proc rather than overwriting the first
    one's body address out from under earlier callers -- UNLESS the new def
    has the SAME arity as the existing one (below), in which case it is the
    SAME name bound to a new value (Python has no function declarations, only
    assignments), and it must WIN: FindProc's hash chain returns the OLDEST
    registration for a name, so a second same-arity Proc is one no call site
    can ever reach, and every call kept running the FIRST body forever
    (bug-nilpy-redefining-a-def-is-ignored-the-first-body-still-runs). A
    DIFFERENT arity is left to the existing path (its own Proc): that shape
    already resolves correctly today, by whatever call-site arity matching
    picks it out from the chain, and must keep working. }
  { A NESTED def registers under its enclosing def's qualifier, which is what
    PyParseStatement already put in the queue entry — see PyNestPrefix. The
    same helper the queueing pass used, so a REDEFINITION's body lands in the
    proc its own name resolves to. }
  name := PyNestedDefQName(defTok0, name);
  { Look in the MAIN PROGRAM first. FindProc walks the whole table and returns
    the OLDEST registration of a name, so for a def that shadows a builtin —
    `def len(x)` against pylib's `len` — it answered the UNIT's proc, this
    parse registered a second one, and the shell PyRegisterDefShells had made
    was left bodyless: "unresolved forward: len". A def is a main-program
    routine; its own shell is the one to reuse. }
  procIdx := FindProcInUnit(name, -1);
  if procIdx < 0 then procIdx := FindProc(name);
  if (procIdx >= 0) and (Procs[procIdx].BodyAddr >= 0) and
     (Procs[procIdx].ParamCount = nparams) then
  begin
    { SAY SO. Reusing the first def's Proc is what makes the redefinition win,
      and it also makes it win for the calls written ABOVE it — which CPython
      binds to the FIRST body, because a `def` is an assignment executed where
      it stands. That divergence used to be entirely silent, and it is not
      bounded by "you get the other function's answer": when the two bodies
      return different TYPES the earlier call site was compiled for the first
      signature and runs the second body, which printed kilobytes of raw memory
      in the case that surfaced it.

      A warning is not the fix — the fix is a Proc per def plus positional
      binding, designed in the ticket and deliberately not attempted here — but
      it converts a silent wrong value into a message naming both lines, which
      is the difference between a debuggable program and a haunted one.
      bug-nilpy-redefining-a-def-rebinds-calls-that-came-before-it }
    if NilPyUserCode and (ProcPyDefTok[procIdx] >= 0) then
      Warn('Nil Python: `' + name + '` is defined again here; calls written '
        + 'ABOVE this line will run THIS body, not the earlier one (CPython '
        + 'binds them to the earlier one). Rename one of the two if that is '
        + 'not what you meant');
    for i := 0 to nparams - 1 do
    begin
      Procs[procIdx].Params[i].Name := PyHdrPNames[i];
      Procs[procIdx].Params[i].TypeKind := PyHdrPTypes[i];
    end;
    Procs[procIdx].RetType := retType;
    Procs[procIdx].IsFunc := not isProc;
    PyApplyDefSignature(procIdx);
  end
  else if (procIdx < 0) or (Procs[procIdx].BodyAddr >= 0) then
  begin
    procIdx := RegisterProc(name, not isProc, retType, nparams,
                            PyHdrPNames, PyHdrPTypes);
    PyApplyDefSignature(procIdx);
  end;
  { Record the def-time default globals unconditionally, because the common case
    reaches NEITHER branch above: a def whose shell PyRegisterDefShells already
    registered (BodyAddr = -1) keeps that Proc untouched, so PyApplyDefSignature
    does not run here. The shell pass parses the header with evaluation OFF — it
    only wants the signature — so the symbols exist only after THIS parse, and
    without this loop they were never carried onto the Proc and every
    non-constant default stayed None. }
  if procIdx >= 0 then
    for i := 0 to nparams - 1 do
      if (i < MAX_PROC_PARAMS) and PyHdrDefHas[i] and (PyHdrDefSym[i] >= 0) then
      begin
        ProcParamDefaultSym[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefSym[i];
        ProcParamDefaultGName[procIdx * MAX_PROC_PARAMS + i] := PyHdrDefGName[i];
        ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + i] := True;
        ProcParamDefaultIsNone[procIdx * MAX_PROC_PARAMS + i] := False;
      end;
  { The BODY must build the frame the registered SIGNATURE describes, not what
    a second inference pass makes of the same header. The two can disagree: the
    shell pass runs before any def is compiled, so a return expression it cannot
    type comes back dynamic, while the same expression re-inferred here may type
    concretely. Callers use the signature. When they disagreed, a variant-
    returning def got NO hidden destination slot (`RetViaHiddenDest(retType)`
    below tested the re-inferred type) and wrote its result through an
    uninitialised pointer — `def s(a, b=2): return a + b` segfaulted ON RETURN,
    and only when a parameter carried a default, which is what made it look like
    a defaults bug. }
  if Procs[procIdx].BodyAddr < 0 then retType := Procs[procIdx].RetType;
  { …and the generator properties, on whichever Proc this parse settled on. The
    shell pass already marked its own; a REDEFINITION or a name the shell pass
    skipped reaches a Proc that has not been marked. }
  if isGenDef then PyMarkGeneratorProc(procIdx);

  { A nested def's shell carries MORE parameters than its header: the trailing
    ones stand for the enclosing locals it captures. Take the count from the
    Proc, or the captured names get no frame slot and the body reports them as
    undefined variables (feature-nilpy-nested-defs). }
  { the def's OWN declared parameters, before the capture block below appends
    the enclosing frame's names as extra ones. Only those are Python
    parameters; a CAPTURE is the outer variable itself, and giving one a
    private slot would break `nonlocal` — a nested `label = t` under
    `nonlocal label` stopped reaching the enclosing frame
    (test_nilpy_selfassigned_comprehension). }
  pbOwn := nparams;
  if Procs[procIdx].ParamCount > nparams then
  begin
    for i := nparams to Procs[procIdx].ParamCount - 1 do
    begin
      PyHdrPNames[i] := Procs[procIdx].Params[i].Name;
      PyHdrPTypes[i] := Procs[procIdx].Params[i].TypeKind;
      { restore a captured object's class id (stashed at capture time) so
        `obj.field` resolves inside the body — else it reads as Integer }
      if (Procs[procIdx].Params[i].TypeKind = tyClass) and
         (i < MAX_PROC_PARAMS) and
         (ProcParamRecId[procIdx * MAX_PROC_PARAMS + i] >= REC_UCLASS_BASE) then
        PyHdrPCis[i] := ProcParamRecId[procIdx * MAX_PROC_PARAMS + i] - REC_UCLASS_BASE
      else
        PyHdrPCis[i] := -1;
      PyHdrPSigs[i] := -1;
    end;
    nparams := Procs[procIdx].ParamCount;
  end;
  { NOTE: BodyAddr is recorded at the PROLOGUE below, not here. Between this
    point and the prologue sits the local-typing pre-pass, which trial-parses
    the body — and a body containing an `import` compiles that unit right
    there, emitting the whole unit's code into the gap. A BodyAddr taken here
    then pointed at the imported unit's first routine instead of this def:
    calling `def w(): try: import math ...` ran math's code and returned its
    pi, with the def's own body never entered and no diagnostic
    (bug-nilpy-import-inside-def-clobbers-proc-context). }
  { Defs nested in THIS body qualify with this def's own (already qualified)
    name, so `outer.inner.deeper` stays unique at any depth. Set BEFORE the
    local-typing pre-pass: that pre-pass trial-parses the body, so it meets the
    nested defs too and must register their shells under the same qualifier the
    real parse will look for. }
  savedPfx := PyNestPrefix;
  savedNest := PyPendNestCount;
  savedLam := PyPendLamCount;
  PyNestPrefix := name;
  savedSC := SymCount;
  savedFS := FrameSize;
  FrameSize := 0;
  CurProc := procIdx;
  Procs[procIdx].ScopeBase := SymCount;
  for i := 0 to nparams - 1 do
  begin
    { Any/variant params are const-by-ref (the internal convention passes a
      variant's ADDRESS), so the 8-byte slot holds the pointer }
    { a `nonlocal` capture is by-ref whatever its type — see ProcParamCapRef }
    capByRef := (PyHdrPTypes[i] = tyVariant) or
                ((i < MAX_PROC_PARAMS) and
                 ProcParamCapRef[procIdx * MAX_PROC_PARAMS + i]);
    idx := AllocParam(PyHdrPNames[i], PyHdrPTypes[i], capByRef, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    Procs[procIdx].Params[i].IsRef := capByRef;
    if i < MAX_PROC_PARAMS then
      ProcParamIsConst[procIdx * MAX_PROC_PARAMS + i] := PyHdrPTypes[i] = tyVariant;
    if (PyHdrPTypes[i] = tyClass) and (PyHdrPCis[i] >= 0) then
      Syms[idx].RecName := REC_UCLASS_BASE + PyHdrPCis[i];
    { A `Callable[...]` parameter is callable INSIDE the body, and its bare name
      at a CALL SITE must become the routine's address rather than a call — both
      need the signature on the symbol (feature-nilpy-function-values). }
    if PyHdrPSigs[i] >= 0 then SymProcSig[idx] := PyHdrPSigs[i];
    SymSyncTypeRef(idx);
  end;
  { A variant parameter this body REBINDS gets a private slot, and the name in
    the body means that slot. A variant travels const-by-REF here, so the
    parameter symbol IS the caller's storage and `p = p + [9]` wrote through it
    — the callee's rebinding reached the caller, which Python never does.

    Done by RENAMING the parameter out of the way rather than by teaching the
    assignment path about parameters: every read, every write, the locals
    inference and the nested-def capture scan then see one ordinary local, so
    there is no second path that can disagree with the first.
    bug-nilpy-rebinding-a-list-parameter-aliases-the-callers-list }
  for i := 0 to nparams - 1 do
  begin
    pbLocal[i] := -1;
    if (i < pbOwn) and (i < MAX_PROC_PARAMS) and (PyHdrPTypes[i] = tyVariant) and
       (Procs[procIdx].Params[i].SymIdx >= 0) and
       PyParamRebound(bodyStart, PyHdrPNames[i]) then
    begin
      Syms[Procs[procIdx].Params[i].SymIdx].Name := '$byref.' + PyHdrPNames[i];
      { tyVariant, not whatever the locals pre-pass infers from the REBINDING:
        the incoming argument is an Any, and only the parameter's own type
        describes every value the slot may hold. }
      pbLocal[i] := AllocVar(PyHdrPNames[i], tyVariant);
    end;
  end;
  if not isProc then
  begin
    { NOT literally 'Result': Pascal's implicit result variable is case-insensitive,
      and `for result in detector_results:` is ordinary Python (songformatter's
      key_analysis writes it). Spelled that way, the loop variable RESOLVED to the
      function's result and the def returned the last element instead of what it
      computed. `return` targets RetSymIdx by index, never by name, so a name no
      Python source can spell keeps the two apart.
      See bug-nilpy-local-named-result-aliases-the-function-result. }
    idx := AllocVar('$pyresult', retType);
    Procs[procIdx].RetSymIdx := idx;
    Syms[idx].Kind := skLocal;   { gates prologue zero-init -- see the method path }
    if (retType = tyClass) and (PyHdrRetCi >= 0) then
    begin
      Syms[idx].RecName := REC_UCLASS_BASE + PyHdrRetCi;
      SymSyncTypeRef(idx);
    end;
    if RetViaHiddenDest(retType) then
    begin
      { variant (Any) results ride the hidden-destination convention }
      idx := AllocVar('', tyPointer);
      ProcAggregateDestSym[procIdx] := idx;
    end;
  end;
  PyCollectLocalsAST(bodyStart);
  PyDbgDumpLocals(Procs[procIdx].Name);
  for i := 0 to PyLocalCount - 1 do
    if PyAssignTargetSym(PyLocals[i].Name) < 0 then
    begin
      idx := AllocVar(PyLocals[i].Name, PyLocals[i].TypeKind);
      if (PyLocals[i].TypeKind = tyClass) and (PyLocals[i].RecCi >= 0) then
      begin
        Syms[idx].RecName := REC_UCLASS_BASE + PyLocals[i].RecCi;
        SymSyncTypeRef(idx);
      end;
    end;

  { A local some NESTED def declares `nonlocal` becomes ONE shared heap cell for
    this frame — done here, after the locals are laid out and before the body is
    parsed, so the body, the nested defs' capture scan and the closure binders
    all agree about what the name is (see SymCellPtr). }
  cellInit := PyPromoteNonlocalCells(bodyStart);

  Procs[procIdx].BodyAddr := CodeLen;   { see the note above: AFTER the pre-pass }
  patchPos := EmitProcPrologue;
  Procs[procIdx].FramePatch := patchPos;
  EmitAggregateDestStash(procIdx);
  PyEmitParamSpills(procIdx, nparams);
  PyInitVariantLocals(Procs[procIdx].ScopeBase);
  { Managed locals must start nil, exactly as in the Pascal routine body — a
    NilPy string local is a MANAGED AnsiString now, and without this the first
    assignment released stale stack bytes (`decq -0x10(%rax)` on garbage). }
  EmitManagedLocalsZeroInit(Procs[procIdx].ScopeBase);
  bodyNode := PyParseBlock;
  Expect(tkDedent, 'dedent');
  { ...and the private parameter slots are seeded before either: the body may
    READ the parameter before it rebinds it. }
  pbInit := -1;
  for i := 0 to nparams - 1 do
    if (i < MAX_PROC_PARAMS) and (pbLocal[i] >= 0) then
    begin
      pbAsgn := AllocNode(AN_ASSIGN);
      ASTLeft[pbAsgn] := PyMakeIdent(pbLocal[i]);
      ASTRight[pbAsgn] := PyMakeIdent(Procs[procIdx].Params[i].SymIdx);
      pbInit := PySeqAppend(pbInit, pbAsgn);
    end;
  if pbInit >= 0 then bodyNode := PySeqAppend(pbInit, bodyNode);
  { the cells are allocated FIRST: the body's first assignment stores through one }
  if cellInit >= 0 then bodyNode := PySeqAppend(cellInit, bodyNode);
  if isGenDef then
  begin
    { The generator body is not compiled as written: it becomes a flat
      goto/label STATE MACHINE — restore the persistent slots, jump to the
      resume point, run to the next yield (which checkpoints and returns True),
      and on fall-off mark done and return False. Every step of this is the
      SHARED machinery the Pascal frontend drives (parser.inc); nothing about
      the transform is Nil-Python-specific, which is the whole reason this
      feature is wiring rather than an implementation.

      No PyPrependResultZero: the step function's Result is the Boolean has-next
      and every exit — each yield, and the fall-off tail BuildStacklessStep
      appends — assigns it explicitly. }
    if not CurGenSeenYield then
      Error('Nil Python: internal — a def marked generator has no yield');
    SLCheckEligible(bodyNode);
    AssignStacklessSlots(procIdx);
    bodyNode := BuildStacklessStep(bodyNode, procIdx);
    ProcGenInstSize[procIdx] := SL_OFF_SLOTS + 8 * CurGenSlotNext;
  end
  else
    bodyNode := PyPrependResultZero(procIdx, bodyNode);
  CompileAST(bodyNode);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
    { DWARF -g: same three lines every Pascal routine body ends with
    (parser.inc's routine-body tail). Without them a NilPy def had NO
    DW_TAG_subprogram at all — `break combine` in gdb answered "Function not
    defined", so the frontend where the hard bugs live was the one frontend you
    could not debug. ProcBodyEnd must be taken here, after the epilogue, and
    the locals snapshot before the scope is rolled back. }
  ProcBodyEnd[procIdx] := CodeLen;
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  if DebugInfo and ProcDbgMain[procIdx] then DbgCaptureProcLocals(procIdx);
  SymRollbackTo(savedSC);
  { Anything the BODY left on the hoist queue names this routine's locals, and
    they have just been rolled back. The queue is global, so the residue was
    flushed into whatever statement came next — inside a module that is the
    import-time init, which then loaded a symbol index past SymCount and the IR
    verifier rejected the whole compile at the module's LAST line, naming a
    `def` header 1700 lines earlier only in the DWARF line. A body's own hoists
    are flushed by its statement loop; whatever is left is stale by
    construction. }
  PyHoistHead := savedHoist;
  CurProcIsGenerator := savedGenerator;
  CurProcIsStackless := savedGenStackless;
  CurGenSeenYield    := savedGenSeen;
  CurGenElemIsVariant := savedGenIsVariant;
  CurGenStateCtr     := savedGenStateCtr;
  CurGenSlotNext     := savedGenSlotNext;
  CurGenScopeBase    := savedGenScopeBase;
  CurGenElemOff      := savedGenElemOff;
  FrameSize := savedFS;
  CurProc := -1;
  PyNestPrefix := savedPfx;
  { Now that the enclosing routine's code is complete, compile the bodies its
    statement parser queued — each re-enters here at its own `def` token, with
    the qualifier it registered its shell under. Draining back to savedNest
    keeps nesting depth honest: a nested def's own nested defs are queued and
    drained by its own invocation. }
  while PyPendNestCount > savedNest do
  begin
    Dec(PyPendNestCount);
    savedTok := TokPos;
    savedPfx2 := PyNestPrefix;
    { ...and the CLASS `self` stands for. This drain runs after the enclosing
      method's epilogue has already restored CurSelfClass, so without carrying
      it a nested def's `self.<field>` had no class to resolve against and its
      RETURN TYPE came out wrong — silently, and only for `self`: the same
      nested def capturing a method LOCAL or PARAM was correct
      (bug-nilpy-nested-def-capturing-self-called-from-a-sibling-returns-nothing). }
    savedSelf2 := CurSelfClass;
    PyNestPrefix := PyPendNestPfx[PyPendNestCount];
    CurSelfClass := PyPendNestSelf[PyPendNestCount];
    TokPos := PyPendNestTok[PyPendNestCount];
    Next;
    PyParseDef;
    CurSelfClass := savedSelf2;
    PyNestPrefix := savedPfx2;
    TokPos := savedTok - 1;
    Next;
  end;
  PyDrainPendingLambdas(savedLam);
  PyDefGlobalCount := savedDefGlobalCount;
  for dgI := 0 to savedDefGlobalCount - 1 do PyDefGlobalName[dgI] := savedDefGlobals[dgI];
end;

{ Is the `def` at token index defIdx decorated with @property or @x.setter?
  Returns the prefix its method name must be MANGLED with, or '' for a plain
  method.

  Python names the getter and the setter identically (`base` twice), which
  Pascal cannot hold, so each accessor becomes a distinct hidden method and the
  PROPERTY keeps the plain name. The member pre-pass and PyParseMethod both
  call this one helper, deliberately: they derive the name independently and a
  disagreement between them is a silent ABI mismatch. }
function PyPropAccessorPrefixAt(defIdx: Integer): AnsiString;
var i: Integer;
begin
  Result := '';
  i := defIdx - 1;
  while (i >= 0) and (Tokens[i].Kind in [tkNewline, tkIndent, tkDedent]) do Dec(i);
  if i < 1 then Exit;
  if (Tokens[i - 1].Kind = tkAt) and (LowerCase(GetTokenStr(i)) = 'property') then
  begin
    Result := '__prop_get_';
    Exit;
  end;
  if (i >= 3) and (Tokens[i - 3].Kind = tkAt) and (Tokens[i - 1].Kind = tkDot) and
     (LowerCase(GetTokenStr(i)) = 'setter') then
    Result := '__prop_set_';
end;

{ Is the `def` at defIdx decorated `@staticmethod`?

  Deliberately the same backward scan as PyPropAccessorPrefixAt above, and for
  the same reason its comment gives: BOTH the class-member pre-pass and the real
  method parse ask independently, and a disagreement between them is a silent
  ABI mismatch rather than an error. One function, asked twice.

  `@classmethod` is NOT accepted here. It needs a metaclass `cls` receiver
  rather than merely dropping the instance one, and half-implementing it would
  bind `cls` to the compile-time class instead of the runtime one — wrong for a
  subclass, and silently wrong. It stays refused BY NAME.
  feature-nilpy-staticmethod-and-classmethod }
function PyIsStaticMethodAt(defIdx: Integer): Boolean;
var i: Integer;
begin
  Result := False;
  i := defIdx - 1;
  while (i >= 0) and (Tokens[i].Kind in [tkNewline, tkIndent, tkDedent]) do Dec(i);
  if i < 1 then Exit;
  Result := (Tokens[i - 1].Kind = tkAt) and
            (LowerCase(GetTokenStr(i)) = 'staticmethod');
end;

function PyMethodName(const name: AnsiString): AnsiString;
begin
  if name = '__init__' then Result := 'create' else Result := name;
end;

{ Is `name` one of this method's parameters at all — annotated or not? Used to
  tell "assigned from an unannotated parameter" (fine, the field becomes a
  variant) from "assigned from something we could not type" (still an error). }
function PyHeaderHasParam(methodStart, stopIdx: Integer; const name: AnsiString): Boolean;
var i, depth: Integer;
begin
  Result := False;
  depth := 0;
  for i := methodStart to stopIdx - 1 do
  begin
    if Tokens[i].Kind = tkLParen then Inc(depth)
    else if Tokens[i].Kind = tkRParen then
    begin
      Dec(depth);
      if depth <= 0 then Exit;         { past the parameter list }
    end
    else if (depth = 1) and (Tokens[i].Kind = tkIdent) and
            (GetTokenStr(i) = name) then
    begin
      { a parameter NAME sits right after '(' or a ',' }
      if (Tokens[i - 1].Kind = tkLParen) or (Tokens[i - 1].Kind = tkComma) then
      begin
        Result := True;
        Exit;
      end;
    end;
  end;
end;

function PyHeaderParamType(methodStart, stopIdx: Integer; const name: AnsiString): TTypeKind;
{ The full annotation grammar, not the single-token reader: a ctor parameter may
  be annotated `Callable[[VM], None]` / `Optional[T]` / `List[T]` just like any
  other, and reading only one token typed the field tyUnknown and errored with
  "annotate it" on an annotation that was already there
  (feature-nilpy-function-values). PyAnnLastProcSig is left set for the caller,
  which is how a Callable FIELD gets its call signature. }
var i, k: Integer;
begin
  Result := tyUnknown;
  PyAnnLastProcSig := -1;
  for i := methodStart to stopIdx - 2 do
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = name) and
       (Tokens[i + 1].Kind = tkColon) then
    begin
      k := i + 2;
      { PARAMETER scope, like the real parameter read: a `Callable[...]`
        PARAMETER travels as a VARIANT (see PyAnnParamScope), and a FIELD typed
        from that parameter must agree or the store puts a variant's TAG word
        into a pointer slot and the later call jumps through it.

        This was a live regression, not a hypothetical: giving Callable
        parameters the variant ABI (so a bound method could pass through one)
        left this site still answering tyPointer, and the mismatch was MASKED by
        the `-> None` procedure-ABI bug — both shapes crashed, so the second one
        looked pre-existing. Fixing the ABI unmasked it.
        bug-nilpy-callable-field-typed-only-by-a-ctor-parameter-has-no-signature }
      PyAnnParamScope := True;
      Result := PyAnnTypeAt(k);
      PyAnnParamScope := False;
      Exit;
    end;
end;

{ The CLASS a type-annotation token names, as a rec id (REC_NONE if it is not a
  user class). PyTypeFromTokenIndex reports tyClass but throws the identity
  away, and a tyClass field stored with REC_NONE cannot resolve its own members —
  `o.inner.name` fell back to Integer and printed the raw object pointer,
  silently (bug-nilpy-class-typed-field-loses-identity). The dataclass path
  already did this via PyAnnLastCi; these two give the __init__-annotation path
  the same.

  Fixes the direct chain only, which is the parser path. Two siblings are STILL
  broken and tracked in that ticket, both blocked on the same ordering problem:
  PyCollectModuleLocals runs BEFORE any class member is registered
  (PyRegisterClassShells registers names only), so at module-local inference
  time every class has zero fields —
    x = o.inner   (local hop)   the local cannot learn the field's class
    o.inner.m()   (method call) returns garbage
  Do not "fix" those by walking fields during inference; there is nothing to
  walk yet. }
function PyRecFromTokenIndex(i: Integer): Integer;
var ci: Integer;
begin
  Result := REC_NONE;
  if (i < 0) or (i >= TokCount) then Exit;
  if Tokens[i].Kind <> tkIdent then Exit;
  { NonRecord: this answers "which CLASS does this name denote" for a NilPy
    field/parameter type, and FindUClass returns the first row of the name
    whatever it is. With the RTL's `Text` RECORD ahead of `lib/pcl`'s `Text`
    class, `self.t = Text(...)` recorded the RECORD as the field's type — the
    field then had no methods and the receiver fell back to dynamic dispatch,
    which is why a bound method as a VALUE (`command=self.text.yview`) failed
    while the direct call worked.
    bug-nilpy-text-class-name-binds-the-rtl-file-record. }
  ci := FindUClassNonRecord(GetTokenStr(i));
  if ci >= 0 then Result := REC_UCLASS_BASE + ci;
end;

function PyHeaderParamRec(methodStart, stopIdx: Integer; const name: AnsiString): Integer;
var i: Integer;
begin
  Result := REC_NONE;
  for i := methodStart to stopIdx - 2 do
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = name) and
       (Tokens[i + 1].Kind = tkColon) then
    begin
      Result := PyRecFromTokenIndex(i + 2);
      Exit;
    end;
end;

function PyTypeName(tk: TTypeKind): AnsiString;
begin
  if tk = tyAnsiString then PyTypeName := 'str'
  else if tk = tyVariant then PyTypeName := 'Any'
  else PyTypeName := 'that type';
end;

{ A method's declared `-> TYPE`. PyRegisterClassMembers used to register every
  method with a hardcoded tyInteger return type, so only `-> int` worked by
  luck: `-> str` returned garbage, `-> float` returned 0, `-> bool` printed 1
  (bug-nilpy-method-returning-str-garbage). PyDefReturnType covers TOP-LEVEL
  defs only (it scans at depth 0), which is why methods were missed.
  Returns tyUnknown for `-> None` and for an unannotated method; the caller
  keeps tyInteger there, preserving today's behaviour for those. }
{ The return type of a def with NO `-> ret`, inferred from the FIRST
  `return <expr>` in its body. Defaulting such a def to tyInteger — which is
  what the pre-pass did while the annotation was still mandatory — silently
  truncates anything else: `return (a, b)` builds a TPyList and handed back its
  pointer as an integer, printing garbage. A def with no value-returning
  `return` is tyInteger, which is the harmless case.

  Shared by PyMethodRetType and PyParseDefHeader on purpose: the pre-pass
  decides the registered signature and the header decides the frame, so the two
  must reach the same answer or the mismatch is a silent ABI bug. }
{ The return type of a def NESTED in the body being scanned. Only top-level
  defs are hoisted (PyRegisterDefShells scans at depth 0), so a call to a nested
  helper has no registered signature when the ENCLOSING def's signature is
  decided — and falling back to the Integer default made the enclosing function
  hand a string result back as a number, silently.
  bug-nilpy-nested-def-nonint-result-garbage. }
function PyNestedDefRetType(scanFrom, scanTo: Integer; const nm: AnsiString;
                            var retRec: Integer): TTypeKind;
var i: Integer;
begin
  PyNestedDefRetType := tyUnknown;
  retRec := REC_NONE;
  for i := scanFrom to scanTo - 2 do
    if (Tokens[i].Kind = tkFunction) and (Tokens[i + 1].Kind = tkIdent) and
       CaseEqual(GetTokenStr(i + 1), nm) then
    begin
      PyNestedDefRetType := PyInferDefRetType(i, retRec);
      Exit;
    end;
end;

{ "the scanner learned nothing better than an integer". Expressible as EITHER
  kind and both must be tested: this routine's own no-value-return default is
  tyInteger, while an integer LITERAL token now reports tyInt64 (the two
  disagreeing at 4 vs 8 bytes is what put a 2^31 cliff on a field, fixed
  separately). Testing only tyInteger silently switched every chase below OFF
  for a return expression containing an int literal — `return v + 1` over a
  float local kept the literal's own type and handed back the double's BITS. }
function PyRetIsIntDefault(tk: TTypeKind): Boolean;
begin
  PyRetIsIntDefault := (tk = tyInteger) or (tk = tyInt64);
end;

{ The type a NAME assigned in this body ends up holding, read from tokens
  alone: scan every `name = <rhs>` before the return and take the last one the
  expression scanner can type. Used by the returned-EXPRESSION chase, which
  cannot consult PyLocals — the shell pre-pass has none, and answering
  differently in the two passes is a silent ABI mismatch.

  A name rebound across kinds (`v = 3` then `v = 0.5`) reports the LAST kind,
  which is what the value at the return actually is in the straight-line case
  this can see. Returns tyUnknown when nothing typed. }
function PyRetFieldType(scanFrom, scanTo: Integer; const recvNm, fldNm: AnsiString;
                        var fldRec: Integer): TTypeKind;
{ The type of `recv.fld` where `recv` is a local of this body — for a def whose
  whole return is a FIELD READ.

  `def a(): q = Item(5); return q.n` was typed tyClass (Item), the RECEIVER's
  class, while the value returned is the field's int. It printed correctly only
  because the wrong type renders through the integer path and the value happens
  to be an integer; `type(a()).__name__` SEGFAULTS on it, and so does anything
  else that treats a tyClass node as an object.
  bug-nilpy-a-def-returning-a-field-is-typed-as-the-receivers-class

  Token-only, like every other chase in this scan: PyInferExprType's own field
  walk reads `PyLocals[..].RecCi`, which exists in the body pass and NOT in the
  shell pre-pass, and the two passes answering differently is a silent ABI
  mismatch. So the receiver's class is recovered the way the rest of this file
  does it — from the `recv = ClassName(` assignment in the body — and the field
  type from the class's own registered field. }
var k, ci, fi: Integer;
begin
  PyRetFieldType := tyUnknown;
  fldRec := REC_NONE;
  ci := -1;
  for k := scanFrom to scanTo - 1 do
    if (Tokens[k].Kind = tkIdent) and (k + 3 < TokCount) and
       (Tokens[k + 1].Kind = tkAssign) and (Tokens[k + 2].Kind = tkIdent) and
       (Tokens[k + 3].Kind = tkLParen) and
       CaseEqual(GetTokenStr(k), recvNm) and
       (FindUClassNonRecord(GetTokenStr(k + 2)) >= 0) then
      { the LAST such binding wins, as everywhere else in this scan }
      ci := FindUClassNonRecord(GetTokenStr(k + 2));
  if ci < 0 then Exit;
  fi := FindUField(ci, fldNm);
  if fi < 0 then Exit;
  PyRetFieldType := IntToTypeKind(UFldTk[fi]);
  if (PyRetFieldType = tyClass) and (UFldRec_[fi] >= REC_UCLASS_BASE) then
    fldRec := UFldRec_[fi];
end;

function PyRetNameType(scanFrom, scanTo: Integer; const nm: AnsiString): TTypeKind;
var k, e2: Integer; t2: TTypeKind;
begin
  PyRetNameType := tyUnknown;
  for k := scanFrom to scanTo - 1 do
    if (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount) and
       (Tokens[k + 1].Kind = tkAssign) and CaseEqual(GetTokenStr(k), nm) then
    begin
      e2 := k + 2;
      while (e2 < TokCount) and
            not (Tokens[e2].Kind in [tkNewline, tkDedent, tkEOF]) do Inc(e2);
      t2 := PyInferExprType(k + 2, e2);
      if t2 <> tyUnknown then PyRetNameType := t2;
    end;
end;

{ Is `nm` bound INSIDE this def — as a parameter, or by an assignment in the
  body? Used to tell a name that merely SPELLS a class from one that denotes it.

  Token-only, and that is not a style choice: PyInferExprType runs in the shell
  pre-pass (no PyLocals) and again in the body pass (PyLocals populated), and
  the two answering differently is a silent ABI mismatch — the signature and the
  frame then describe different types. See the notes above the bare-ident chase.
  Reading PyLocals here would reintroduce exactly that. }
function PyNameBoundInDef(hdrFrom, hdrTo, bodyFrom, bodyTo: Integer;
                          const nm: AnsiString): Boolean;
var k, depth: Integer;
begin
  Result := False;
  { a PARAMETER name is an ident at paren depth 1 that follows '(' or ',' —
    which skips annotations and default values, both of which can name types }
  depth := 0;
  for k := hdrFrom to hdrTo - 1 do
  begin
    if Tokens[k].Kind = tkLParen then Inc(depth)
    else if Tokens[k].Kind = tkRParen then Dec(depth)
    else if (depth = 1) and (Tokens[k].Kind = tkIdent) and (k > hdrFrom) and
            (Tokens[k - 1].Kind in [tkLParen, tkComma]) and
            CaseEqual(GetTokenStr(k), nm) then
    begin
      Result := True;
      Exit;
    end;
  end;
  { a LOCAL: `nm = ...` earlier in the body, the same shape PyRetNameType scans }
  for k := bodyFrom to bodyTo - 1 do
    if (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount) and
       (Tokens[k + 1].Kind = tkAssign) and CaseEqual(GetTokenStr(k), nm) then
    begin
      Result := True;
      Exit;
    end;
end;

{ Step over a nested def/class's whole suite, from its introducing token to
  just past the DEDENT that closes it. Returns -1 when the construct has NO
  suite of its own — which is the answer the three callers below must not
  confuse with a position.

  The bound matters more than the walk. These scans used to hunt for the next
  tkIndent with `while (k < TokCount) and (Tokens[k].Kind <> tkIndent)`, which
  cannot fail: with no INDENT of its own the walk runs on into a LATER
  construct and the caller then treats that construct's body as this one's.
  That exact failure has shipped before — `class G(Exception): pass` had no
  INDENT, the scan ran on to the next class's, and G was credited with the
  other class's members ("unresolved forward: G.create", see
  PyRegisterClassMembers). It is unreachable today only because the lexer
  synthesises NEWLINE INDENT ... DEDENT for a one-line suite
  (pylexer.inc), so an INDENT always exists — a single load-bearing guarantee
  standing behind every one of these scans. This stops at the end of the
  construct's HEADER instead: a second NEWLINE, or another def/class, means the
  suite is not there and the next INDENT belongs to somebody else.
  bug-nilpy-def-body-scans-run-on-when-no-indent-is-found }
function PyFindSuiteIndent(start, limit: Integer): Integer;
{ The index of the INDENT opening the suite of the def/class at `start`, or -1
  when it has none. Never walks past the end of that construct's HEADER — see
  PySkipNestedSuite for why an unbounded hunt is the bug. }
var k, nl: Integer;
begin
  PyFindSuiteIndent := -1;
  if limit > TokCount then limit := TokCount;
  k := start;
  nl := 0;
  while k < limit do
  begin
    if Tokens[k].Kind = tkIndent then begin PyFindSuiteIndent := k; Exit; end;
    if Tokens[k].Kind = tkEOF then Exit;
    if Tokens[k].Kind = tkNewline then
    begin
      Inc(nl);
      { the FIRST newline ends the header; a second means no suite followed }
      if nl > 1 then Exit;
    end
    else if (k > start) and
            ((Tokens[k].Kind = tkFunction) or (Tokens[k].Kind = tkClass)) then
      Exit;
    Inc(k);
  end;
end;

function PySkipNestedSuite(start: Integer): Integer;
var k, depth: Integer;
begin
  PySkipNestedSuite := -1;
  k := PyFindSuiteIndent(start, TokCount);
  if k < 0 then Exit;
  depth := 0;
  while k < TokCount do
  begin
    if Tokens[k].Kind = tkIndent then Inc(depth)
    else if Tokens[k].Kind = tkDedent then
    begin
      Dec(depth);
      if depth = 0 then begin Inc(k); Break; end;
    end;
    Inc(k);
  end;
  PySkipNestedSuite := k;
end;

function PyInferDefRetTypeScan(methodStart: Integer; var retRec: Integer;
                               var sawNone: Boolean): TTypeKind;
var j, pdepth, bdepth, e, k, e2, rec2, bodyScanStart, curRec: Integer;
    tupDepth, chainRec: Integer;
    t2, cur, chainCur: TTypeKind;
    seenAny, tupComma: Boolean;
    bigRet: Boolean;   { the return holds `**` or a wide literal — arbitrary precision }
begin
  Result := tyInteger;
  retRec := REC_NONE;
  rec2 := -1;
  seenAny := False;
  sawNone := False;
  PyInferRetSeenAny := False;
  j := methodStart + 2;
  pdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkLParen then Inc(pdepth)
    else if Tokens[j].Kind = tkRParen then
    begin
      Dec(pdepth);
      if pdepth = 0 then begin Inc(j); Break; end;
    end;
    Inc(j);
  end;
  bodyScanStart := j;
  bdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkIndent then Inc(bdepth)
    else if Tokens[j].Kind = tkDedent then
    begin
      Dec(bdepth);
      if bdepth <= 0 then Exit;              { end of this def's body }
    end
    else if Tokens[j].Kind = tkFunction then
    begin
      { A nested def: SKIP its body and keep scanning this one. Stopping here
        meant the enclosing def's own `return` was never seen when a helper was
        declared above it, so the type fell to the Integer default and a string
        result came back as a number — silently
        (bug-nilpy-nested-def-nonint-result-garbage). The nested def's own
        returns must not be read as this def's, hence skip rather than descend. }
      { step past the nested def's INDENT..matching DEDENT }
      k := PySkipNestedSuite(j);
      { no suite of its own: stop rather than guess. Advancing into a later
        construct would attribute ITS returns to this def, which is the silent
        wrong answer this scan exists to avoid. }
      if k < 0 then Exit;
      j := k;
      Continue;
    end
    else if (Tokens[j].Kind = tkExit) and (bdepth >= 1) then
    begin
      if j + 1 >= TokCount then Exit;
      { A BARE `return` is exactly `return None` in Python, so it says nothing
        about the type either -- keep scanning, the same way the None case
        below does. Exiting here let the value-less default (tyInteger) win
        over the REAL returns that followed it, so

            if n == 0:
                return
            return "str"

        handed the string back as an address, and a later `return [1]` came
        back as one too. A later `return 5` survived only by coincidence
        (bug-nilpy-return-type-inference-mistypes-several-expression-shapes).
        A def whose returns are ALL value-less still ends at the DEDENT below
        with the tyInteger default intact, which is the harmless case the
        comment above describes. }
      if Tokens[j + 1].Kind in [tkNewline, tkDedent, tkEOF] then
      begin
        sawNone := True;
        Inc(j);
        Continue;
      end;
      { `return None` says nothing about the type — None is compatible with
        every result — so keep scanning for a return that does. uforth's
        _parse_compound_string returns None on its guard paths and the TUPLE
        only at the end; taking the first return typed it as an integer and
        the tuple came back truncated. }
      if (Tokens[j + 1].Kind = tkNil) and (j + 2 < TokCount) and
         (Tokens[j + 2].Kind in [tkNewline, tkDedent, tkEOF]) then
      begin
        sawNone := True;
        Inc(j);
        Continue;
      end;
      e := j + 1;
      while (e < TokCount) and not (Tokens[e].Kind in [tkNewline, tkDedent, tkEOF]) do
        Inc(e);
      { `return a, b` is a TUPLE, which is a TPyList here (see PyMakeTupleFrom).
        Detected before the general inference, which would otherwise type the
        def by the FIRST element — `return 5,` came back as an integer, so the
        caller could not even len() it. Depth-tracked so a comma inside a call
        or a subscript does not count. }
      tupDepth := 0;
      tupComma := False;
      for k := j + 1 to e - 1 do
      begin
        if Tokens[k].Kind in [tkLParen, tkLBrack, tkBegin] then Inc(tupDepth)
        else if Tokens[k].Kind in [tkRParen, tkRBrack, tkEnd] then Dec(tupDepth)
        else if (Tokens[k].Kind = tkComma) and (tupDepth = 0) then tupComma := True;
      end;
      if tupComma then
      begin
        cur := tyClass;
        PyInferLastCi := FindUClass('TPyList');
        if PyInferLastCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
      end
      { `return lambda ...` is a CALLABLE VALUE, which travels as a variant.
        The scanner had no case for it and fell to the Integer default, so the
        boxed callable was converted to a number on the way out and the caller
        could not call what it got back. It only showed when the lambda
        captures NOTHING — a capturing one reaches the variant answer by
        another route — which is why the ticket had this recorded as being
        about the enclosing def's empty parameter list
        (bug-nilpy-function-value-call-gaps). }
      else if (Tokens[j + 1].Kind = tkIdent) and
              CaseEqual(GetTokenStr(j + 1), 'lambda') then
        cur := tyVariant
      else
        cur := PyInferExprType(j + 1, e);
      { `def h(b): return b` beside `class B: pass` came back as a raw pointer.
        PyInferExprType tests IsClassType(name) BEFORE consulting the locals
        table, and every later refinement there is guarded on `tk = tyUnknown`,
        so once a class name matches, the parameter that SHADOWS it can never
        win. The def then registered a class result and the caller read the
        handle as an object pointer — silently.

        Python scoping is the rule being restored: a parameter or local shadows
        a class of the same name. Exact-case collisions (`class Item` + a
        parameter `Item`) fail too, so this is not merely IsClassType matching
        case-insensitively (bug-nilpy-identifiers-are-case-insensitive) — that
        only widens the blast radius from `Item` to `item`/`ITEM`.

        Only the NAME-based conclusion is dropped, not the type: `cur` goes back
        to tyUnknown so the bare-ident chase just below re-derives the type from
        what the name was ASSIGNED. So `w = Word(); return w` still types as
        Word even when a class happens to be called `w`, and a genuine
        `return SomeClass(...)` construction is untouched (it is not a bare
        ident). bug-nilpy-a-local-named-like-a-class-is-typed-as-that-class. }
      if (cur = tyClass) and (e = j + 2) and (Tokens[j + 1].Kind = tkIdent) and
         IsClassType(GetTokenStr(j + 1)) and
         PyNameBoundInDef(methodStart, bodyScanStart, bodyScanStart, j,
                          GetTokenStr(j + 1)) then
      begin
        cur := tyUnknown;
        PyInferLastCi := -1;
      end;
      { `return B` — the CLASS itself, not an instance of it. Since
        feature-nilpy-class-as-a-value that expression is a VT_CLASSREF
        VARIANT, so a tyClass result hands the caller a variant to read as an
        object pointer — it segfaults at the first use, not at the return.
        A bare class name with no `(` is the value form; `return B(...)` is
        construction and keeps tyClass, and a name the def SHADOWS was already
        cleared to tyUnknown by the block above, so reaching here with tyClass
        means a genuine class reference. }
      if (cur = tyClass) and (e = j + 2) and (Tokens[j + 1].Kind = tkIdent) and
         IsClassType(GetTokenStr(j + 1)) then
      begin
        cur := tyVariant;
        PyInferLastCi := -1;
      end;
      { `return w` — a bare ident the scanner cannot type: chase the ident's
        ASSIGNMENT earlier in the body and infer from its right-hand side
        (uforth's finalize_definition: `w = self.define_word(...)`, whose
        annotated Word return carries the class). Last well-typed assignment
        wins. }
      { PROMO also re-chases: PyInferExprType consults PyLocals for a bare
        ident, and a local widened to promo by the body is only visible in the
        HEADER pass (the pre-pass has no PyLocals) — trusting it here made the
        two passes infer different return types, a silent ABI mismatch. The
        token-only chase below gives both passes the same answer. }
      rec2 := -1;
      { tyVARIANT re-chases too, and that is the whole point: in the BODY pass
        PyInferExprType can see PyLocals and answers `variant` for a bare ident,
        while the SHELL pre-pass has no locals, chases the assignment and answers
        (say) `str`. The two passes then registered DIFFERENT return types for
        the same def — the silent ABI mismatch this comment warns about — and a
        def returning `s` where `s = str(x)` crashed on return. The token-only
        chase gives both passes the same answer, so it must run in both. }
      if ((cur = tyUnknown) or PyRetIsIntDefault(cur) or (cur = tyVariant) or
          TypeIsPromoInt(cur)) and
         (e = j + 2) and (Tokens[j + 1].Kind = tkIdent) then
      begin
        chainCur := tyUnknown;
        chainRec := -1;
        for k := bodyScanStart to j - 1 do
          if (Tokens[k].Kind = tkIdent) and (k + 1 < TokCount) and
             (Tokens[k + 1].Kind = tkAssign) and
             CaseEqual(GetTokenStr(k), GetTokenStr(j + 1)) then
          begin
            e2 := k + 2;
            while (e2 < TokCount) and not (Tokens[e2].Kind in [tkNewline, tkDedent, tkEOF]) do
              Inc(e2);
            t2 := PyInferExprType(k + 2, e2);
            { Self-referential accumulator (`acc = acc + chr(97)`): this raw
              re-scan has no PyLocals here, so the leading `acc` on the RHS
              resolves to tyUnknown and contributes nothing, and the type comes
              from the REST of the expression alone — `acc + chr(97)` inferred
              tyChar from chr() and threw away that acc already held a string
              built up by an earlier assignment, truncating the returned value
              to one byte
              (bug-nilpy-return-type-inference-mistypes-several-expression-shapes).
              Fold in the type accumulated across the chain so far instead. }
            if (chainCur <> tyUnknown) and (k + 2 < e2) and
               (Tokens[k + 2].Kind = tkIdent) and
               CaseEqual(GetTokenStr(k + 2), GetTokenStr(j + 1)) then
            begin
              t2 := PyWiden(chainCur, t2);
              { ...and the class IDENTITY travels with the kind. PyWiden folds
                a TTypeKind and knows nothing of PyInferLastCi, so
                `out = out + [i]` came back tyClass with ci = -1: the chain said
                "still a class", the re-scan of `out + [i]` found no class of its
                own, and the def registered a CLASS RESULT WITH NO CLASS. The
                caller then read the TPyList handle as a bare pointer and
                `print(build(4))` showed a 15-digit integer.
                A one-element list literal is what exposes it — `[i, 1]` widened
                to an int default and the whole assignment was skipped, so the
                first assignment's class survived by accident.
                bug-nilpy-rebinding-a-list-parameter-aliases-the-callers-list }
              if (t2 = tyClass) and (PyInferLastCi < 0) then
                PyInferLastCi := chainRec;
            end;
            if (t2 <> tyUnknown) and (not PyRetIsIntDefault(t2)) and (t2 <> tyVariant) then
            begin
              cur := t2;
              chainCur := t2;
              chainRec := PyInferLastCi;
              rec2 := PyInferLastCi;
            end;
          end;
        if (cur = tyClass) and (rec2 >= 0) then
          PyInferLastCi := rec2;
      end;
      { `return 2 ** 70` — and any `**` at all. It has no binary token in this
        frontend: PyMakePow lowers it to a `pypow_v` CALL, whose result is a
        VARIANT (NilPy ints are arbitrary precision, so a power has to be). The
        token scan sees only the integer literals and answers Int64, so the
        body handed a variant back through an Int64 result slot and
        `def f(): return 2 ** 70` printed **0** — 2^70 mod 2^64 — with
        `f() + 1` then continuing from 0.

        A WIDE integer literal is the same fact one shape over: the lexer marks
        one that does not fit Int64 by setting SLen on the token (see the
        literal arm in parser.inc), and `return 1180591620717411303424` was
        truncated for want of reading that mark.

        Binding to a local first always worked, because the local takes its
        type from the NODE — which is the variant — rather than from this scan.
        bug-nilpy-a-def-returning-a-big-int-expression-directly-answers-zero }
      if (cur = tyUnknown) or PyRetIsIntDefault(cur) then
      begin
        bigRet := False;
        for k := j + 1 to e - 1 do
        begin
          if (Tokens[k].Kind = tkInteger) and (Tokens[k].SLen > 0) then
            bigRet := True;
          if (Tokens[k].Kind = tkStar) and (k + 1 < e) and
             (Tokens[k + 1].Kind = tkStar) then
            bigRet := True;
        end;
        if bigRet then
        begin
          cur := tyVariant;
          PyInferLastCi := -1;
        end;
      end;
      { `return q.n` — the whole return is a FIELD READ off a local. The scans
        above answer the RECEIVER's class (tyClass Item) while the value is the
        field's own type, and nothing downstream can tell: it prints correctly
        because an integer field renders through the integer path, and
        `type(...)` on it segfaults.
        Resolved token-only through PyRetFieldType, so the shell pre-pass and
        the body pass still agree.
        bug-nilpy-a-def-returning-a-field-is-typed-as-the-receivers-class }
      if (e = j + 4) and (Tokens[j + 1].Kind = tkIdent) and
         (Tokens[j + 2].Kind = tkDot) and (Tokens[j + 3].Kind = tkIdent) then
      begin
        rec2 := REC_NONE;
        t2 := PyRetFieldType(bodyScanStart, j, GetTokenStr(j + 1),
                             GetTokenStr(j + 3), rec2);
        if t2 <> tyUnknown then
        begin
          cur := t2;
          if (t2 = tyClass) and (rec2 >= REC_UCLASS_BASE) then
            PyInferLastCi := rec2 - REC_UCLASS_BASE
          else
            PyInferLastCi := -1;
        end;
      end;
      { The same chase, for an EXPRESSION rather than a bare ident.

        `def e(): v = 0.5; return v + 1` returned 4609434218613702656 — the
        double's IEEE bits scalar-loaded as an integer. The bare-ident chase
        above only fires for a single-token return, so `v + 1` went to
        PyInferExprType, which in this pass has no PyLocals, could not type
        `v`, and took tyInteger from the literal `1` alone. The float local was
        invisible and the result type was decided by the smallest operand in
        the expression (bug-nilpy-def-return-coerces-a-float-to-the-inferred-
        int-result, row e — measured worse than the ticket recorded, which had
        it as a truncation).

        Chases each NAME in the returned expression to its last well-typed
        assignment in this body and widens. Token-only, exactly like the bare
        chase, so the shell pre-pass and the body pass still answer the same
        thing — they must, or the signature and the frame disagree.

        Only when the expression scan produced the tyInteger DEFAULT, and only
        for names that chase to something better than tyInteger, so an ordinary
        integer expression keeps its scalar result and boxes nothing. A name
        followed by `(` is a call and a name after `.` is an attribute; neither
        is a local, and both keep their existing routes. }
      if ((cur = tyUnknown) or PyRetIsIntDefault(cur)) and (e > j + 2) then
        for k := j + 1 to e - 1 do
          if (Tokens[k].Kind = tkIdent) and
             not ((k + 1 < TokCount) and (Tokens[k + 1].Kind = tkLParen)) and
             not ((k > 0) and (Tokens[k - 1].Kind = tkDot)) then
          begin
            t2 := PyRetNameType(bodyScanStart, j, GetTokenStr(k));
            if (t2 <> tyUnknown) and (not PyRetIsIntDefault(t2)) then
              cur := PyWiden(cur, t2);
          end;
      { A return EXPRESSION the scanner cannot type is DYNAMIC, not an integer.
        `def g(a): return a` with an untyped parameter is the plain case, and
        typing it tyInteger made the result a number: `g("a b").split(" ")`
        had a string method applied to an "integer" and did not parse, and
        anything that consumed the value read a string handle as a number.
        A def with NO value-returning return stays tyInteger — that is the
        harmless case this rule was written for, and it is decided elsewhere. }
      { `return inner()` / `s = inner(); return s` where `inner` is a def
        NESTED in this body: it has no registered signature yet, so the scans
        above answer Integer by default and the enclosing function then hands a
        string result back as a number. Find the nested def and take ITS type.
        bug-nilpy-nested-def-nonint-result-garbage. }
      if ((cur = tyUnknown) or PyRetIsIntDefault(cur)) and (j + 2 < TokCount) and
         (Tokens[j + 1].Kind = tkIdent) and (Tokens[j + 2].Kind = tkLParen) and
         (FindProc(GetTokenStr(j + 1)) < 0) then
      begin
        t2 := PyNestedDefRetType(bodyScanStart, j, GetTokenStr(j + 1), rec2);
        if t2 <> tyUnknown then
        begin
          cur := t2;
          if (t2 = tyClass) and (rec2 >= REC_UCLASS_BASE) then
            PyInferLastCi := rec2 - REC_UCLASS_BASE;
        end;
      end;
      { the same through a local: `s = inner()` then `return s` }
      if ((cur = tyUnknown) or PyRetIsIntDefault(cur)) and
         (e = j + 2) and (Tokens[j + 1].Kind = tkIdent) then
        for k := bodyScanStart to j - 1 do
          if (Tokens[k].Kind = tkIdent) and (k + 3 < TokCount) and
             (Tokens[k + 1].Kind = tkAssign) and
             (Tokens[k + 2].Kind = tkIdent) and (Tokens[k + 3].Kind = tkLParen) and
             CaseEqual(GetTokenStr(k), GetTokenStr(j + 1)) and
             (FindProc(GetTokenStr(k + 2)) < 0) then
          begin
            t2 := PyNestedDefRetType(bodyScanStart, k, GetTokenStr(k + 2), rec2);
            if t2 <> tyUnknown then
            begin
              cur := t2;
              if (t2 = tyClass) and (rec2 >= REC_UCLASS_BASE) then
                PyInferLastCi := rec2 - REC_UCLASS_BASE;
            end;
          end;
      { NOTE tyInteger, not tyVariant. Making an untypable return DYNAMIC is
        the honest answer and was tried (0843fbb7) — but a variant-returning
        def returns through a hidden destination, and a def whose parameters
        carry DEFAULTS then segfaults ON RETURN (`def s(a, b=2): return a + b`,
        called with both arguments written). That is a codegen gap, not an
        inference question, and it is filed as
        bug-nilpy-variant-return-with-defaulted-param-segfaults; flip this line
        back when it is fixed. The shape 0843fbb7 was written for —
        `get(a,b,c).split("x")` — keeps working through the runtime-dispatch
        suffix loop that commit added, which does not depend on this. }
      if cur = tyUnknown then cur := tyVariant;
      if cur = tyString then cur := tyAnsiString;
      { A PROMOTABLE INT cannot cross the call boundary raw: its rvalue is the
        frame SLOT ADDRESS and the frame dies at return — the caller read a
        stack address as the value (uforth /STRING returned garbage and the
        word list was walked through it -> wild jump). Box to a variant
        (inline -> VT_INT64, heap -> VT_PROMO), which the Result store and
        every caller already handle. }
      if TypeIsPromoInt(cur) then cur := tyVariant;
      curRec := REC_NONE;
      if (cur = tyClass) and (PyInferLastCi >= 0) then
        curRec := REC_UCLASS_BASE + PyInferLastCi;
      { Merge with the other returns instead of taking the first and exiting:
        a def whose arms return DIFFERENT kinds (`return "pos"` / `return 42`)
        must produce a VARIANT result — the first-return rule stored the int
        as a string handle and the consumer crashed on it
        (bug-nilpy-mixed-str-int-return-segfault). Identical kinds (and the
        single-return case) keep exactly the old answer. }
      if not seenAny then
      begin
        seenAny := True;
        PyInferRetSeenAny := True;
        Result := cur;
        retRec := curRec;
      end
      else if (Result <> cur) or
              ((Result = tyClass) and (retRec <> curRec)) then
      begin
        Result := tyVariant;
        retRec := REC_NONE;
      end;
      j := e;
      Continue;
    end;
    Inc(j);
  end;
end;

{ "`return None` says nothing about the type" — the rule the scan above is
  built on — holds for every result kind EXCEPT a CLASS. A None result is a
  sentinel in the result's own representation (0 for an int, a nil handle for a
  str), and for a class that sentinel is a nil object pointer: correct for
  IDENTITY (`is None` answers True, `type()` answers NoneType) and unusable for
  everything else, because every consumer dereferences it. `len(x)`, `x[0]`,
  `x + [1]`, `for q in x` and `x.append(1)` all SIGSEGV'd where CPython raises
  TypeError, and `print(x)` / `repr(x)` / `str(x)` rendered `[]` — a wrong VALUE
  with no diagnostic, which is the worse half.

  So a def that returns None on one arm and a class on another returns a
  VARIANT. That path is already correct today: a None boxes as VT_EMPTY and a
  container as VT_OBJECT, which is exactly how list ELEMENTS and dict VALUES
  have always carried the two apart. It is the same call
  decide-nilpy-optional-int-none-vs-zero made for Optional[int].

  Not covered, and deliberately: falling off the END of a def also yields None
  in Python, but recognising that needs flow analysis rather than a token scan.
  bug-nilpy-none-returned-beside-a-container-is-an-unusable-nil-handle }
function PyInferDefRetType(methodStart: Integer; var retRec: Integer): TTypeKind;
var sawNone: Boolean;
begin
  Result := PyInferDefRetTypeScan(methodStart, retRec, sawNone);
  if PxxDbgEnabled('n.ret') then
    WriteLn('PXXDBG n.ret def@', methodStart, ' ', GetTokenStr(methodStart + 1),
            ' tk=', Ord(Result), ' rec=', retRec, ' sawNone=', Ord(sawNone),
            ' trial=', Ord(PyTypingPass));
  { A def that returns None on one path and a VALUE on another answers Any, and
    that is true of every kind — not only tyClass, which is all this rule used
    to cover.

    None has no representation inside a static scalar: `return None` beside
    `return 7` stored a plain 0, so `fi(2) is None` was False and `str(fi(2))`
    printed `0` — indistinguishable from a genuine zero, with nothing left for
    any later conversion to recover. The str spelling loses it one step later
    (a nil AnsiString handle IS a None sentinel, but boxing it into a variant
    produced VT_STRING+nil, which `is None` does not accept). One rule fixes
    both; fixing only the str arm would have left the int arm silently wrong and
    made the bug harder to find, because str is the spelling people reproduce
    with (bug-nilpy-a-def-returned-none-loses-its-none-ness-in-a-variant-slot).

    A def whose returns are ALL bare is the same rule with nothing on the other
    side: it answers None in Python, and it was already compiled as a FUNCTION
    (an unannotated def is never a procedure here), so it was handing back the
    tyInteger default's 0 — `plain(nothing(2))` said False. A variant Result is
    zero-initialised, i.e. VT_EMPTY, so it needs no store to be None. }
  if sawNone and (Result <> tyVariant) then
  begin
    Result := tyVariant;
    retRec := REC_NONE;
  end;
end;

{ Does the def's body contain a VALUE-bearing `return`? (`return` bare and
  `return None` do not count.) Used to override a LYING `-> None` annotation:
  CPython ignores annotations entirely, and uforth's finalize_definition is
  annotated `-> None` yet returns the new Word — trusting the annotation
  compiled it as a procedure and the caller read garbage (the :NONAME xt). }
function PyIsScalarRetKind(tk: TTypeKind): Boolean;
{ Is this a NUMERIC/boolean/variant method result — the kinds that fit a
  register and that an override may legitimately disagree with its base about?
  Deliberately NOT tyClass (a differing class result is covariance, a separate
  question) and NOT a managed/aggregate kind: an AnsiString base with a variant
  override is the configparser `optionxform` case the block above was written
  for, where adopting the base's type is RIGHT, and a str result from a method
  is rejected outright further down anyway.

  tyVariant is IN because it is the common override shape — an unannotated
  `def area(self): return self.w * self.h` over fields infers variant, and
  against a `-> 0.0` base that meant the int product came back as 6.0 where
  CPython says 6. Used by the override-signature block in
  PyRegisterClassMembers. }
begin
  PyIsScalarRetKind := (tk = tyInteger) or (tk = tyInt64) or (tk = tyDouble) or
                       (tk = tyBoolean) or TypeIsPromoInt(tk) or (tk = tyVariant);
end;

function PyMethodReturnsSelf(defIdx: Integer): Boolean;
{ Does this method's body `return self`? That is the fluent-builder idiom —
  `def add(self, x): ...; return self` — and its result type is the method's own
  class. Inferred by the scanner alone: `self` is a parameter whose class only
  the enclosing class knows, so the general expression inference answers unknown,
  the method registered an Integer result, and the SECOND link of a chain
  (`B().add(1).add(2)`) had no class to resolve against — "expected expression"
  (bug-nilpy-method-chaining-on-a-call-result). Nested defs are skipped, as in
  PyDefHasValueReturn, so an inner helper's `return self` is not read as this
  method's. }
var j, pdepth, bdepth, k, e2: Integer;
begin
  Result := False;
  j := defIdx + 2;
  pdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkLParen then Inc(pdepth)
    else if Tokens[j].Kind = tkRParen then
    begin
      Dec(pdepth);
      if pdepth = 0 then begin Inc(j); Break; end;
    end;
    Inc(j);
  end;
  bdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkIndent then Inc(bdepth)
    else if Tokens[j].Kind = tkDedent then
    begin
      Dec(bdepth);
      if bdepth <= 0 then Exit;
    end
    else if Tokens[j].Kind = tkFunction then
    begin
      k := PySkipNestedSuite(j);
      { no suite of its own: stop rather than guess. Advancing into a later
        construct would attribute ITS returns to this def, which is the silent
        wrong answer this scan exists to avoid. }
      if k < 0 then Exit;
      j := k;
      Continue;
    end
    else if (Tokens[j].Kind = tkExit) and (bdepth >= 1) then
    begin
      if (j + 2 < TokCount) and (Tokens[j + 1].Kind = tkIdent) and
         CaseEqual(GetTokenStr(j + 1), 'self') and
         (Tokens[j + 2].Kind in [tkNewline, tkDedent, tkEOF]) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(j);
  end;
end;

function PyDefHasValueReturn(defIdx: Integer): Boolean;
var j, pdepth, bdepth, k, e2: Integer;
begin
  Result := False;
  j := defIdx + 2;
  pdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkLParen then Inc(pdepth)
    else if Tokens[j].Kind = tkRParen then
    begin
      Dec(pdepth);
      if pdepth = 0 then begin Inc(j); Break; end;
    end;
    Inc(j);
  end;
  bdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkIndent then Inc(bdepth)
    else if Tokens[j].Kind = tkDedent then
    begin
      Dec(bdepth);
      if bdepth <= 0 then Exit;
    end
    else if Tokens[j].Kind = tkFunction then
    begin
      { A nested def: SKIP its body and keep scanning this one. Stopping here
        meant the enclosing def's own `return` was never seen when a helper was
        declared above it, so the type fell to the Integer default and a string
        result came back as a number — silently
        (bug-nilpy-nested-def-nonint-result-garbage). The nested def's own
        returns must not be read as this def's, hence skip rather than descend. }
      { step past the nested def's INDENT..matching DEDENT }
      k := PySkipNestedSuite(j);
      { no suite of its own: stop rather than guess. Advancing into a later
        construct would attribute ITS returns to this def, which is the silent
        wrong answer this scan exists to avoid. }
      if k < 0 then Exit;
      j := k;
      Continue;
    end
    else if (Tokens[j].Kind = tkExit) and (bdepth >= 1) then
    begin
      if (j + 1 < TokCount) and
         not (Tokens[j + 1].Kind in [tkNewline, tkDedent, tkEOF]) and
         not ((Tokens[j + 1].Kind = tkNil) and (j + 2 < TokCount) and
              (Tokens[j + 2].Kind in [tkNewline, tkDedent, tkEOF])) then
      begin
        Result := True;
        Exit;
      end;
    end;
    Inc(j);
  end;
end;

{ An annotated result type joined with what the BODY actually returns.

  A Python annotation is metadata, not enforcement: `def g() -> int` that
  returns 2.5 returns 2.5. Trusting `-> int` coerced on the way out, and the
  worst case was not even a truncation — `def a() -> int: return 2.5` printed
  4612811918334230528, the double's IEEE bits scalar-loaded as an integer. The
  mirror was wrong too: `def b() -> float: return 1` printed 1.0 where CPython
  prints the int 1 (bug-nilpy-def-return-coerces-a-float-to-the-inferred-int-result).

  The rule is the one already written down a few lines below for `-> None`
  ("CPython ignores annotations… then the annotation loses"), extended from
  None to every annotation. A disagreement yields a VARIANT, which carries
  either and renders each as itself.

  DELIBERATELY only when the join is a variant, i.e. only for the int-meets-
  float pair PyWidenBinding redirects. Every other annotation keeps exactly its
  old answer — in particular `-> str` stays the MANAGED tyAnsiString the method
  path has always mapped it to, rather than being re-joined with the tyString
  an inference might report and quietly becoming a frozen string[N].

  Gated on PyInferRetSeenAny: with no value-bearing return the inference
  answers tyInteger by default, which is not a disagreement with anything.

  BOTH callers must apply this identically. The result type IS the calling
  convention — a variant returns through the hidden-destination path, a scalar
  in a register — and PyMethodRetType decides the signature while
  PyParseDefHeader decides the frame, so a difference between them is a silent
  ABI mismatch, not a typing nit. }
function PyJoinRetAnnotation(annTk: TTypeKind; methodStart: Integer;
                             var annRec: Integer): TTypeKind;
var infTk: TTypeKind; infRec: Integer;
begin
  PyJoinRetAnnotation := annTk;
  infRec := REC_NONE;
  infTk := PyInferDefRetType(methodStart, infRec);
  if not PyInferRetSeenAny then Exit;
  { The int-meets-float pair, and ONLY that pair — PyWidenBinding's own redirect
    condition, tested directly rather than by asking whether it answered
    tyVariant.

    Asking for the ANSWER was the first version and it regressed forward calls
    (regression-test-nilpy-test-nilpy-class-return, bisected by Track T to the
    commit that added this). PyWidenBinding falls through to PyWiden for
    everything outside that pair, and PyWiden(tyClass, tyInteger) is ALSO
    tyVariant — so `def build_later() -> P: return named_p()` where `named_p` is
    defined LATER joined its annotation against the inference's tyInteger
    default (the body's type is not resolved yet on a forward edge) and lost P's
    class identity, after which `build_later().name` did not parse. Reordering
    the two defs made the identical program compile, which is the tell.

    On a forward edge the annotation is the ONLY type information that exists at
    that moment, so it has to survive. }
  if PyNumeric(annTk) and PyNumeric(infTk) and (annTk <> infTk) and
     (not TypeIsPromoInt(annTk)) and (not TypeIsPromoInt(infTk)) and
     (TypeIsFloat(annTk) <> TypeIsFloat(infTk)) then
  begin
    PyJoinRetAnnotation := tyVariant;
    annRec := REC_NONE;
  end;
end;

function PyMethodRetType(methodStart: Integer; var retRec: Integer): TTypeKind;
var j, pdepth, k: Integer;
begin
  Result := tyUnknown;
  retRec := REC_NONE;
  j := methodStart + 2;
  pdepth := 0;
  while j < TokCount do
  begin
    if Tokens[j].Kind = tkLParen then Inc(pdepth)
    else if Tokens[j].Kind = tkRParen then
    begin
      Dec(pdepth);
      if pdepth = 0 then Break;
    end;
    Inc(j);
  end;
  if (j + 3 < TokCount) and (Tokens[j + 1].Kind = tkMinus) and
     (Tokens[j + 2].Kind = tkGt) then
  begin
    { The FULL annotation grammar, not the single-token reader: a return type
      may be `Optional[Word]` / `List[T]` / `Callable[...]` exactly as a
      parameter may. PyTypeFromTokenIndex saw only the leading `Optional` and
      dropped the class, so a local assigned from the call lost its identity
      and the next `.method()` on it did not resolve. Same "two readers for one
      grammar, and the narrow one wins wherever it is still wired up" bug the
      parameter path already carries a note about
      (bug-nilpy-optional-return-annotation-loses-the-class). }
    { the same lying `-> None` override as PyParseDefHeader — the pre-pass and
      the real parse MUST agree or the signature silently mismatches }
    if (Tokens[j + 3].Kind = tkNil) and PyDefHasValueReturn(methodStart) then
    begin
      Result := PyInferDefRetType(methodStart, retRec);
      Exit;
    end;
    k := j + 3;
    PyAnnRetScope := True;
    Result := PyAnnTypeAt(k);
    PyAnnRetScope := False;
    if Result = tyUnknown then
    begin
      { An annotation this reader cannot interpret is worth exactly as much as
        an ABSENT one, so take the absent one's answer: infer from the body.
        NOT tyInteger — the member pre-pass maps tyUnknown to Integer, so
        `-> Sequence[int]` registered a method that returns a number and
        returning the list raised "expected a number, got object" at RUN time,
        far from the annotation. bug-n-an-uninterpretable-annotation-refuses-the-program }
      Result := PyInferDefRetType(methodStart, retRec);
      Exit;
    end;
    if (Result = tyClass) and (PyAnnLastCi >= 0) then
      retRec := REC_UCLASS_BASE + PyAnnLastCi
    else
      retRec := REC_NONE;
    { the annotation is metadata, not enforcement — see PyJoinRetAnnotation.
      Its twin in PyParseDefHeader must stay in step or the signature and the
      frame disagree. }
    Result := PyJoinRetAnnotation(Result, methodStart, retRec);
  end
  else
    { no annotation: infer from the body rather than defaulting to Integer }
    Result := PyInferDefRetType(methodStart, retRec);
end;

{ fieldsOnly = the PRE-PASS: register this class's FIELDS and nothing else.
  PyCollectModuleLocals runs before the main loop that parses classes, so
  without a pre-pass every class has zero fields during module-local inference
  and `x = o.inner` cannot learn the field's class
  (bug-nilpy-class-typed-field-loses-identity). Sharing one procedure keeps the
  field rules in ONE place instead of a drifting copy.
  The later real call resets UClsFBase/UClsFCount on entry, so it rebuilds the
  window from scratch and the pre-pass entries are simply orphaned — which also
  means the dataclass duplicate-field check cannot see them and mis-fire. }
{ Does this class GROW the named field by arithmetic on ITSELF?

  `self.v = self.v * 2`, `self.total = self.total + n`, `self.n += 1`. The field
  is declared from its first initialiser (`self.v = 1` -> tyInt64), and nothing
  widened it afterwards, so a value that grew past 2^63 wrapped in silence —
  2**70 stored back as 0, while the identical accumulator written as a plain
  local was exact (bug-nilpy-class-field-and-recursive-return-narrow-an-
  arbitrary-precision-int).

  The answer types the field tyVariant, NOT tyPromoInt64: a promo rvalue is a
  slot ADDRESS and IRPromoAddrOf only knows how to take one for a plain
  identifier, so a promo FIELD has no lowering today. A variant does, it is
  already the boxing the promo RETURN and CAPTURE paths use, and it is lossless
  — VT_PROMO_INT64 carries the exact decimal.

  Deliberately narrow: it requires the field to appear on BOTH sides of its own
  assignment, so a field merely assigned from somewhere else keeps its machine
  type and its cheap storage. That is the accumulator shape the bug is about. }
function PyFieldIsIntAccumulator(bodyStart, bodyEnd: Integer; const fld: AnsiString): Boolean;
var k, e: Integer; sawSelf, sawOp: Boolean;
begin
  PyFieldIsIntAccumulator := False;
  k := bodyStart;
  while k + 3 < bodyEnd do
  begin
    if (Tokens[k].Kind = tkIdent) and (GetTokenStr(k) = 'self') and
       (Tokens[k + 1].Kind = tkDot) and (Tokens[k + 2].Kind = tkIdent) and
       CaseEqual(GetTokenStr(k + 2), fld) then
    begin
      { `self.f += 1` — the self-reference is implicit in the operator }
      if Tokens[k + 3].Kind in [tkPlusEq, tkMinusEq, tkStarEq] then
      begin
        PyFieldIsIntAccumulator := True;
        Exit;
      end;
      if Tokens[k + 3].Kind = tkAssign then
      begin
        e := k + 4;
        sawSelf := False;
        sawOp := False;
        while (e < bodyEnd) and
              not (Tokens[e].Kind in [tkNewline, tkDedent, tkSemicolon]) do
        begin
          if Tokens[e].Kind in [tkPlus, tkMinus, tkStar] then
            sawOp := True
          else if (Tokens[e].Kind = tkIdent) and (GetTokenStr(e) = 'self') and
                  (e + 2 < bodyEnd) and (Tokens[e + 1].Kind = tkDot) and
                  (Tokens[e + 2].Kind = tkIdent) and
                  CaseEqual(GetTokenStr(e + 2), fld) then
            sawSelf := True;
          Inc(e);
        end;
        if sawSelf and sawOp then
        begin
          PyFieldIsIntAccumulator := True;
          Exit;
        end;
      end;
    end;
    Inc(k);
  end;
end;

{ The four comparison dunders `@dataclass(order=True)` generates, in the order
  PyDcCmpProc indexes them. ONE function, because the registration and the body
  emitter must agree about which slot is which. }
function PyDcCmpName(k: Integer): AnsiString;
begin
  if k = 0 then Result := '__lt__'
  else if k = 1 then Result := '__le__'
  else if k = 2 then Result := '__gt__'
  else Result := '__ge__';
end;

{ ---- multiple inheritance by FLATTENING ----------------------------------
  bug-nilpy-multiple-inheritance-does-not-parse, re-scoped by
  decide-nilpy-multiple-inheritance-c3-or-delegate.

  The first base stays a REAL parent (single-inheritance object model); every
  further base is flattened — its body span is replayed against the derived
  class, so its methods compile with `self` = the derived object, which is what
  Python means by a mixin. Conflicts go C3 left-to-right: the derived class
  wins, then the first base, then each further base in order. }

{ is `x` `a` or one of its ancestors? }
function PyClsHasAncestor(a, x: Integer): Boolean;
var g: Integer;
begin
  Result := False;
  g := a;
  while g >= 0 do
  begin
    if g = x then begin Result := True; Exit; end;
    g := UClsParent[g];
  end;
end;

{ The ancestor `a` and `b` share, or -1. A shared ancestor is the DIAMOND: C3
  gives one copy of it and naive flattening would give two, after which the two
  copies' state diverges silently. Refused rather than guessed. }
function PySharedAncestor(a, b: Integer): Integer;
var g: Integer;
begin
  Result := -1;
  g := a;
  while g >= 0 do
  begin
    if PyClsHasAncestor(b, g) then begin Result := g; Exit; end;
    g := UClsParent[g];
  end;
end;

{ The member name a `def` at token `i` registers under. ONE function, because
  the registration pass and the body pass must agree exactly about which
  definitions a later base loses — a disagreement compiles a proc for a member
  that was never registered, or registers one nothing ever compiles. The
  property-accessor prefix is part of the key: `@property def base` and
  `@base.setter def base` are two members with one source name. }
function PyDefMemberKeyAt(i: Integer): AnsiString;
begin
  Result := PyMethodName(GetTokenStr(i + 1));
  if PyPropAccessorPrefixAt(i) <> '' then
    Result := PyPropAccessorPrefixAt(i) + GetTokenStr(i + 1);
end;

procedure PyMixSkipAdd(const nm: AnsiString);
begin
  if PyMixSkipN > High(PyMixSkip) then Exit;
  PyMixSkip[PyMixSkipN] := nm;
  Inc(PyMixSkipN);
end;

function PyMixSkipHas(const nm: AnsiString): Boolean;
var k: Integer;
begin
  Result := True;
  for k := 0 to PyMixSkipN - 1 do
    if PyMixSkip[k] = nm then Exit;
  Result := False;
end;

{ Every member name a body span defines at its own indentation — the def keys
  and the class-attribute names. Called on the derived class's own span and on
  each EARLIER base's span to build the losing set before a later base's span
  is replayed, so both passes derive it the same way instead of one of them
  accumulating state the other has to reproduce. }
procedure PyMixCollectKeys(bs, be: Integer);
var i, depth: Integer;
begin
  depth := 0;
  i := bs;
  while i < be do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkFunction) then
      PyMixSkipAdd(PyDefMemberKeyAt(i))
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            ((i = bs) or (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) and
            (Tokens[i + 1].Kind in [tkAssign, tkColon]) then
      PyMixSkipAdd(GetTokenStr(i));
    Inc(i);
  end;
end;

{ Does this class's body call `super()` anywhere? A flattened body cannot: see
  the refusal in PyParseClass's base list. }
function PyMixBodyUsesSuper(bci: Integer): Boolean;
var i: Integer;
begin
  Result := False;
  if (PyClsBodyS[bci] < 0) or (PyClsBodyE[bci] < 0) then Exit;
  for i := PyClsBodyS[bci] to PyClsBodyE[bci] - 1 do
    if (Tokens[i].Kind = tkIdent) and (GetTokenStr(i) = 'super') and
       (Tokens[i + 1].Kind = tkLParen) then
    begin
      Result := True;
      Exit;
    end;
end;

{ Rebuild the losing set for base number `upTo` of the class whose own body is
  ownBS..ownBE: everything the derived class itself defines, plus everything an
  EARLIER base already supplied. }
procedure PyMixBuildSkip(ci, ownBS, ownBE, upTo: Integer);
var k, g, mi: Integer;
begin
  PyMixSkipN := 0;
  PyMixCollectKeys(ownBS, ownBE);
  { Everything the REAL parent chain already supplies — but ONLY for a base
    that stands AFTER the parent in the declared list. C3 is left-to-right, so
    the parent and its ancestors come ahead of a base written after it and that
    base's definition of an inherited name loses (without this it silently WON,
    by being registered as an override of the parent's slot) — while a base
    written BEFORE the parent beats it, and overriding the parent's slot is
    then exactly the right outcome. The parent is not always the first base:
    an imported one has no body to flatten and so is chosen from wherever it
    stands. bug-nilpy-multiple-inheritance-from-an-imported-base-is-refused }
  if not PyMixBeforeParent[upTo] then
  begin
    g := UClsParent[ci];
    while g >= 0 do
    begin
      for mi := UClsMBase[g] to UClsMBase[g] + UClsMCount[g] - 1 do
        PyMixSkipAdd(PyRawName(UMthNOff[mi], UMthNLen[mi]));
      g := UClsParent[g];
    end;
  end;
  for k := 0 to upTo - 1 do
    if PyMixCi[k] >= 0 then
      PyMixCollectKeys(PyClsBodyS[PyMixCi[k]], PyClsBodyE[PyMixCi[k]]);
end;

procedure PyRegisterClassMembers(ci, bodyStart, bodyEnd: Integer; isDC: Boolean;
                                 fieldsOnly: Boolean);
var i, j, k, depth, methodStart, nparams, procIdx, mmi, inhMmi, slot, curOff, align, sz: Integer;
    ovMmi, ovPi: Integer;   { the inherited method an override must match }
    fldAnn, rhsAt, k2, fldSig: Integer;
    origName, name, fullName, rhsName: AnsiString; isCtor: Boolean;
    fldRec, mRetRec, pri: Integer; mRet: TTypeKind;
    ownBS, ownBE, mixIx: Integer;  { the span loop — own body, then each flattened base }
    dcCmp: Integer;   { @dataclass(order=True): 0=lt 1=le 2=gt 3=ge }
    inMixin: Boolean;
    caVal: Integer;   { class-attribute initialiser token, past any annotation }
    caClassW, caInstW: Boolean;   { how this attribute is written module-wide }
    mStarIdx, mKwIdx, starCi: Integer;   { `*args` / `**kwargs` parameter slots }
    isGenM: Boolean;   { this method's body contains a yield — see PyDefAtHasYield }
    pnames: array[0..15] of AnsiString; ptypes: array[0..15] of TTypeKind;
    pdefHas: array[0..15] of Boolean; pdefIsStr: array[0..15] of Boolean;
    pdefIsNone: array[0..15] of Boolean; pdefIsFloat: array[0..15] of Boolean;
    pdefIsBool: array[0..15] of Boolean;
    pdefVal: array[0..15] of Int64;
    pdefSOff: array[0..15] of Integer; pdefSLen: array[0..15] of Integer;
    tk: TTypeKind; defKind: Integer; defIVal: Int64; defSOff, defSLen: Integer;
    dcExprDef: Boolean;   { this field's default is an EXPRESSION, evaluated at the class statement }
begin
  UClsFBase[ci] := UFldCount;
  UClsFCount[ci] := 0;
  UClsMBase[ci] := UMthCount;
  UClsMCount[ci] := 0;
  UClsPBase[ci] := UPropCount;
  UClsPCount[ci] := 0;
  { A SUBCLASS continues the parent's layout: its own fields start past the
    parent's instance size and its virtual slots past the parent's slot count.
    Starting both at zero made `class B(A)` overlay B's fields on A's and reuse
    A's VMT slots, so an INHERITED method silently ran a subclass method with
    the same slot number (bug-a-nilpy-subclass-overlays-parent-layout). }
  curOff := 8;
  if UClsParent[ci] >= 0 then
  begin
    curOff := UClsSize_[UClsParent[ci]];
    if curOff < 8 then curOff := 8;
    UClsVirtCount[ci] := UClsVirtCount[UClsParent[ci]];
  end;
  align := 8;
  ownBS := bodyStart; ownBE := bodyEnd;
  mixIx := 0; inMixin := False;
  { The span loop: the class's OWN body first, then each flattened base's body
    replayed against this ci. Layout simply continues — a flattened base's
    fields take fresh offsets and its methods fresh virtual slots, because they
    ARE members of this class now, not of a parent it shares nothing with. }
  while True do
  begin
  depth := 0;
  i := bodyStart;
  while i < bodyEnd do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then Dec(depth)
    else if (depth = 0) and inMixin and (Tokens[i].Kind = tkFunction) and
            PyMixSkipHas(PyDefMemberKeyAt(i)) then
    begin
      { this base loses the name to the derived class or to an earlier base }
      i := PySkipNestedSuite(i);
      if i < 0 then Break;
      Continue;
    end
    else if (depth = 0) and inMixin and (Tokens[i].Kind = tkIdent) and
            ((i = bodyStart) or
             (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) and
            (Tokens[i + 1].Kind in [tkAssign, tkColon]) and
            PyMixSkipHas(GetTokenStr(i)) then
    begin
      { same, for a class ATTRIBUTE the derived class redefines }
      while (i < bodyEnd) and (Tokens[i].Kind <> tkNewline) do Inc(i);
    end
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            ((i = bodyStart) or
             (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) and
            { the ANNOTATED shape is a PLAIN class's attribute only. In a
              @dataclass `label: str = ""` is a FIELD, owned by the isDC branches
              below which also record its default in the PyDc* tables and build
              the generated ctor from them. Matching it here hijacked that —
              test_nilpy_dataclass_dict_factory segfaulted
              (regression-nilpy-dataclass-dict-factory-test-core-red). A
              dataclass keeps the pre-existing unannotated-only rule. }
            ((not isDC) or (Tokens[i + 1].Kind = tkAssign)) and
            (PyClsAttrEqIdx(i, bodyEnd) >= 0) and
            (PyClsAttrEqIdx(i, bodyEnd) + 1 < bodyEnd) and
            (Tokens[PyClsAttrEqIdx(i, bodyEnd) + 1].Kind in
               [tkInteger, tkFloat, tkString, tkTrue, tkFalse, tkNil]) and
            { ...and that literal must BE the whole initialiser. `g = 2 + 3`
              starts with a literal token but is an expression, and claiming it
              here folded the `2` and dropped the rest — while the class body's
              own test (PyClsAttrExprAhead, which DOES check the line ends)
              evaluated it as an expression into a hidden global. The two
              readers then disagreed about what kind of attribute `g` is, and a
              class holding one lost an unrelated tuple of its OTHER attributes
              to a segfault or to silence
              (bug-nilpy-non-literal-class-attribute-corrupts-the-class-layout).
              Same shape as the parameter-default constant path, which claimed
              the `1` of `b=1+2` for the same reason. }
            (PyClsAttrEqIdx(i, bodyEnd) + 2 < bodyEnd) and
            (Tokens[PyClsAttrEqIdx(i, bodyEnd) + 2].Kind in
               [tkNewline, tkDedent, tkEOF]) then
    begin
      { the initialiser token, past an optional `: <annotation>` — the class
        body's own branch finds it with the same helper, and the two MUST agree }
      caVal := PyClsAttrEqIdx(i, bodyEnd) + 1;
      { A CLASS ATTRIBUTE — `name = "note_counting"`, unannotated, at class
        level. Held as a per-class compile-time constant (see the PyClsAttr*
        note in defs.inc): the read `self.name` becomes the literal, and an
        assignment to it is refused rather than pretending Python's shared
        class attribute exists. Registered in the pre-pass with everything
        else, so a method body parsed later can already see it. }
      case Tokens[caVal].Kind of
        tkInteger:      tk := tyInt64;
        tkFloat:        tk := tyDouble;
        tkString:       tk := tyAnsiString;
        tkTrue, tkFalse: tk := tyBoolean;
      else
        tk := tyVariant;
      end;
      { WHICH lowering — see PyClsAttrWriteScan. Without a write through the
        class name the copy-at-construction form below is indistinguishable from
        Python's fall-through; with one the attribute has to become the single
        shared slot the global already is.

        ...and REDECLARATION forces the same demotion. The "indistinguishable"
        argument above silently assumed one declaration per inheritance chain.
        It is false when a subclass redeclares the attribute, with no class
        write anywhere: the copy is applied by a prologue keyed on the
        CONSTRUCTOR's class, but a construction runs whichever constructors the
        chain has, so `super().__init__()` re-ran the base's prologue over the
        derived values, and a subclass with no own ctor never ran its own at
        all. The shared slot has no such problem — it is read by walking from
        the RECEIVER's class (FindClassVar), which is the right question. So the
        cheap lowering stays exactly where it is provably right and the correct
        model carries the rest, which is what
        decide-nilpy-class-attribute-instance-read-model asked for. }
      PyClsAttrWriteScan(PyRawName(UClsNOff[ci], UClsNLen[ci]), GetTokenStr(i),
                         caClassW, caInstW);
      if PyClsAttrRedeclaredInChain(PyRawName(UClsNOff[ci], UClsNLen[ci]),
                                    GetTokenStr(i)) then
        caClassW := True;
      { ...and so does a class used as a VALUE. A reference has no class index
        at compile time, so its writes have to land in the shared slot at run
        time (pylib's PyClsAttrRefSet) — and under the copy-at-construction
        lowering an instance built earlier would keep its own copy and never see
        one, which is the difference between `c.num = 9` being invisible and
        being Python. Kin-wide for the same reason the ctor widening below is:
        the attribute may be declared on an ancestor of the class that is held.
        bug-nilpy-class-attribute-through-a-class-reference-reads-garbage }
      if PyClassKinUsedAsValueEx(ci, True) then caClassW := True;
      PyClsAttrEnsureGlobal(ci, Tokens[i].SOffset, Tokens[i].SLen, tk, REC_NONE,
                            caClassW and caInstW);
      { The attribute is a real FIELD on the instance (typed from its literal),
        so reads and the construction-time store go through the ordinary field
        path. Registered here in the pre-pass, before any method body is parsed. }
      if (not caClassW) and (FindUField(ci, GetTokenStr(i)) < 0) then
      begin
        sz := TypeSize(tk);
        curOff := AlignTo(curOff, TypeAlign(tk));
        AddUField(ci, Tokens[i].SOffset, Tokens[i].SLen, curOff, Ord(tk), REC_NONE);
        Inc(curOff, sz);
      end;
      if (not caClassW) and (PyClsAttrCount < 256) then
      begin
        PyClsAttrCi[PyClsAttrCount]   := ci;
        PyClsAttrNOff[PyClsAttrCount] := Tokens[i].SOffset;
        PyClsAttrNLen[PyClsAttrCount] := Tokens[i].SLen;
        PyClsAttrSOff[PyClsAttrCount] := 0;
        PyClsAttrSLen[PyClsAttrCount] := 0;
        PyClsAttrIVal[PyClsAttrCount] := 0;
        case Tokens[caVal].Kind of
          tkInteger: begin PyClsAttrKind[PyClsAttrCount] := PYDC_INT;
                           PyClsAttrIVal[PyClsAttrCount] := Tokens[caVal].IVal; end;
          tkFloat:   begin PyClsAttrKind[PyClsAttrCount] := PYDC_FLOAT;
                           PyClsAttrIVal[PyClsAttrCount] := Tokens[caVal].IVal; end;
          tkString:  begin PyClsAttrKind[PyClsAttrCount] := PYDC_STR;
                           PyClsAttrSOff[PyClsAttrCount] := Tokens[caVal].SOffset;
                           PyClsAttrSLen[PyClsAttrCount] := Tokens[caVal].SLen; end;
          tkTrue:    begin PyClsAttrKind[PyClsAttrCount] := PYDC_BOOL;
                           PyClsAttrIVal[PyClsAttrCount] := 1; end;
          tkFalse:   begin PyClsAttrKind[PyClsAttrCount] := PYDC_BOOL; end;
        else
          PyClsAttrKind[PyClsAttrCount] := PYDC_NIL;
        end;
        Inc(PyClsAttrCount);
      end;
      while (i < bodyEnd) and (Tokens[i].Kind <> tkNewline) do Inc(i);
      Inc(i);
      continue;
    end
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            ((i = bodyStart) or
             (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) and
            { the ANNOTATED shape is a PLAIN class's attribute only. In a
              @dataclass `label: str = ""` is a FIELD, owned by the isDC branches
              below which also record its default in the PyDc* tables and build
              the generated ctor from them. Matching it here hijacked that —
              test_nilpy_dataclass_dict_factory segfaulted
              (regression-nilpy-dataclass-dict-factory-test-core-red). A
              dataclass keeps the pre-existing unannotated-only rule. }
            ((not isDC) or (Tokens[i + 1].Kind = tkAssign)) and
            (PyClsAttrEqIdx(i, bodyEnd) >= 0) and
            (PyClsAttrEqIdx(i, bodyEnd) + 1 < bodyEnd) then
    begin
      { the initialiser token, past an optional `: <annotation>` — same helper
        as the literal branch above, so the two agree on where the value is }
      caVal := PyClsAttrEqIdx(i, bodyEnd) + 1;
      { A class attribute whose initialiser is NOT a literal — `mode = Inner()`,
        the attribute-namespace idiom (songformatter's render backend declares
        reportlab's blend modes exactly this way). The literal branch above
        cannot hold it: there is no constant to fold. Registered here as an
        ordinary FIELD, and PyParseClass evaluates the expression ONCE into a
        hidden global that construction copies in — so every instance shares the
        one object, as Python's class attribute does.

        Before this, the line matched no branch at all: no field, no constant,
        and `self.mode.NORMAL` then compiled against nothing and SEGFAULTED at
        run time (bug-nilpy-class-attr-instance-traversal-crashes). }
      tk := tyVariant;
      k := REC_NONE;
      { `name = Cls(...)` — the field carries Cls's identity, which is what
        makes the traversal `self.name.attr` resolve to a real field. }
      if (Tokens[caVal].Kind = tkIdent) and (caVal + 1 < bodyEnd) and
         (Tokens[caVal + 1].Kind = tkLParen) then
      begin
        j := FindUClass(GetTokenStr(caVal));
        if j >= 0 then begin tk := tyClass; k := REC_UCLASS_BASE + j; end;
      end;
      { same lowering choice as the literal branch above }
      PyClsAttrWriteScan(PyRawName(UClsNOff[ci], UClsNLen[ci]), GetTokenStr(i),
                         caClassW, caInstW);
      if PyClassKinUsedAsValueEx(ci, True) then caClassW := True;
      PyClsAttrEnsureGlobal(ci, Tokens[i].SOffset, Tokens[i].SLen, tk, k,
                            caClassW and caInstW);
      if (not caClassW) and (FindUField(ci, GetTokenStr(i)) < 0) then
      begin
        sz := TypeSize(tk);
        curOff := AlignTo(curOff, TypeAlign(tk));
        AddUField(ci, Tokens[i].SOffset, Tokens[i].SLen, curOff, Ord(tk), k);
        Inc(curOff, sz);
      end;
      while (i < bodyEnd) and (Tokens[i].Kind <> tkNewline) do Inc(i);
      Inc(i);
      continue;
    end
    else if isDC and (depth = 0) and (Tokens[i].Kind = tkIdent) and
            (i + 2 < bodyEnd) and (Tokens[i + 1].Kind = tkColon) and
            ((i = bodyStart) or
             (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) then
    begin
      { line-start guard: a method header's `-> bool:` return annotation
        would otherwise re-match as a field named 'bool' }
      { ClassVar annotation: a class-level static — register it as a class
        variable (the same registry Pascal `class var` uses, so
        ClassName.name resolves through FindClassVar). Typed tyClass; the
        assignment that populates it fixes RecName (see PyParseStatement). }
      if (Tokens[i + 2].Kind = tkIdent) and
         CaseEqual(GetTokenStr(i + 2), 'ClassVar') then
      begin
        if ClassVarCount >= MAX_TYPEALIAS then Error('too many class variables');
        k := AllocVar('', tyClass);
        ClassVarCi[ClassVarCount]   := ci;
        ClassVarNOff[ClassVarCount] := Tokens[i].SOffset;
        ClassVarNLen[ClassVarCount] := Tokens[i].SLen;
        ClassVarSym[ClassVarCount]  := k;
        ClassVarPyOvr[ClassVarCount] := False;   { a Pascal/ClassVar-annotated slot never needs the NilPy per-instance override }
        Inc(ClassVarCount);
        while (i < bodyEnd) and (Tokens[i].Kind <> tkNewline) do Inc(i);
        Inc(i);
        continue;
      end;
      { @dataclass field: name : annotation [= literal-default] }
      j := i + 2;
      tk := PyAnnTypeAt(j);
      { Captured HERE, before the default-value scan below can clobber it: a
        `Callable[...]` field carries a procedural signature, and AddUField
        reads it from LastTypeProcSig. Without it the field was registered as
        a plain pointer and `w.native(vm)` was not recognised as a call at all
        — the parse stopped before the '(' (bug-nilpy-dataclass-callable-field). }
      fldSig := PyAnnLastProcSig;
      if tk = tyUnknown then
      begin
        { Same degrade as an unreadable PARAMETER annotation: a field whose
          annotation this reader cannot interpret becomes Any (a variant slot),
          which is where an unannotated value already lives, rather than
          refusing the module over metadata CPython never enforces.
          bug-n-an-uninterpretable-annotation-refuses-the-program }
        PyWarnUnreadAnnotation('dataclass field ' + GetTokenStr(i),
                               Tokens[i].Line);
        tk := tyVariant;
        fldSig := -1;
      end;
      { A tyString FIELD means inline `string[N]` to the shared store path
        (capacity-clamped content copy); NilPy str is pointer-semantics, so
        class fields hold managed strings instead. }
      if tk = tyString then tk := tyAnsiString;
      defKind := PYDC_NONE; defIVal := 0; defSOff := 0; defSLen := 0;
      if (j < bodyEnd) and (Tokens[j].Kind = tkAssign) then
      begin
        Inc(j);
        { An EXPRESSION default is decided FIRST, by looking at the whole run
          rather than at its first token. Deciding per-token could not work: the
          literal arms below claim `2` of `2 + 3` and the ident arm rejects
          `BASE * 2` outright with the field(...)/lambda message, so the two
          halves of one feature failed in two different ways and neither said
          "expression". A run is a scalar default only when it is ONE literal
          token (or `-` and one numeric), and a factory only when it opens with
          `field(` or `lambda`; everything else is an expression, evaluated once
          at the class statement.
          feature-nilpy-dataclass-expression-field-default }
        dcExprDef := False;
        k := j;
        while (k < bodyEnd) and
              not (Tokens[k].Kind in [tkNewline, tkDedent, tkEOF]) do Inc(k);
        if (Tokens[j].Kind = tkIdent) and
           (CaseEqual(GetTokenStr(j), 'field') or CaseEqual(GetTokenStr(j), 'lambda')) then
          { a factory form — the arms below own it }
        else if (k = j + 1) or
                ((Tokens[j].Kind = tkMinus) and (k = j + 2)) then
          { a single literal token, or a negated one }
        else
          dcExprDef := True;
        if dcExprDef then
        begin
          defKind := PYDC_EXPR;
          defIVal := 0; defSOff := 0; defSLen := 0;
          { k is the line's NEWLINE; leave j one short of it so the shared
            Inc(j) below lands ON the newline, exactly where the single-literal
            arms leave it. Landing one PAST it made the line-skip at the bottom
            of this loop eat the NEXT field line whole — so a class with two
            expression defaults registered only the first, and the second read
            as "no such member". }
          j := k - 1;
        end
        else
        case Tokens[j].Kind of
          tkInteger: begin defKind := PYDC_INT; defIVal := Tokens[j].IVal; end;
          tkFloat:   begin defKind := PYDC_FLOAT; defIVal := Tokens[j].IVal; end;
          tkString:  begin defKind := PYDC_STR;
                           defSOff := Tokens[j].SOffset;
                           defSLen := Tokens[j].SLen; end;
          tkTrue:    begin defKind := PYDC_BOOL; defIVal := 1; end;
          tkFalse:   begin defKind := PYDC_BOOL; defIVal := 0; end;
          tkNil:     begin defKind := PYDC_NIL; defIVal := 0; end;
          tkIdent:
          begin
            { field(default_factory=list) -> fresh empty list per construction }
            if CaseEqual(GetTokenStr(j), 'field') and (j + 4 < bodyEnd) and
               (Tokens[j + 1].Kind = tkLParen) and
               (Tokens[j + 2].Kind = tkIdent) and
               CaseEqual(GetTokenStr(j + 2), 'default_factory') and
               (Tokens[j + 3].Kind = tkAssign) and
               (Tokens[j + 4].Kind = tkIdent) and
               (CaseEqual(GetTokenStr(j + 4), 'list') or
                CaseEqual(GetTokenStr(j + 4), 'dict')) and
               (j + 5 < bodyEnd) and (Tokens[j + 5].Kind = tkRParen) then
            begin
              if CaseEqual(GetTokenStr(j + 4), 'dict') then
                defKind := PYDC_FACTORY_DICT
              else
                defKind := PYDC_FACTORY_LIST;
              j := j + 5;   { onto ')'; the common Inc(j) below steps past it }
            end
            else if CaseEqual(GetTokenStr(j), 'field') and (j + 6 < bodyEnd) and
               (Tokens[j + 1].Kind = tkLParen) and
               (Tokens[j + 2].Kind = tkIdent) and
               CaseEqual(GetTokenStr(j + 2), 'default_factory') and
               (Tokens[j + 3].Kind = tkAssign) and
               (Tokens[j + 4].Kind = tkIdent) and
               CaseEqual(GetTokenStr(j + 4), 'lambda') and
               (Tokens[j + 5].Kind = tkColon) then
            begin
              { zero-arg lambda: capture the body's token span; the matching
                ')' closes field( — track bracket depth from that paren }
              defKind := PYDC_FACTORY_EXPR;
              defIVal := j + 6;         { body start token index }
              j := j + 6; defSLen := 1; { depth inside field( }
              while (j < bodyEnd) and (defSLen > 0) do
              begin
                if Tokens[j].Kind = tkLParen then Inc(defSLen)
                else if Tokens[j].Kind = tkRParen then
                begin
                  Dec(defSLen);
                  if defSLen = 0 then break;
                end;
                Inc(j);
              end;
              defSOff := j;             { body end (the closing paren) }
              defSLen := 0;
            end
            else
              Error('Nil Python: unsupported dataclass field default (field(default_factory=list), field(default_factory=dict) and a zero-arg lambda are the supported forms)');
          end;
          tkMinus:
          begin
            Inc(j);
            if Tokens[j].Kind = tkInteger then
            begin defKind := PYDC_INT; defIVal := -Tokens[j].IVal; end
            else if Tokens[j].Kind = tkFloat then
            begin defKind := PYDC_FLOAT;
                  { negate an IEEE double by flipping its sign bit }
                  defIVal := Tokens[j].IVal xor (Int64(1) shl 63); end
            else Error('Nil Python: unsupported dataclass field default');
          end;
          else Error('Nil Python: unsupported dataclass field default (scalar literal only)');
        end;
        Inc(j);
        { ...and the default must END here. Without this the scalar path claimed
          the FIRST token and the rest of the line was skipped in silence, so
          `x: int = 2 + 3` compiled and the field held 2 — a wrong VALUE, which
          is worse than the refusal the neighbouring arms already give for the
          forms they cannot take. Third sighting of this shape in one day: the
          parameter-default path claimed the `1` of `b=1+2`, and the class-
          attribute pre-pass claimed the `2` of `g = 2 + 3`. Both are fixed by
          EVALUATING the expression; a dataclass default cannot follow yet
          because it travels as a folded constant in the PyDc* tables that build
          the generated ctor — feature-nilpy-dataclass-expression-field-default. }
        { the scalar arms must still END at the line, which is what caught
          `x: int = 2 + 3` silently becoming 2 before the run-scan above
          existed. Unreachable for an expression now, and kept as the guard for
          any shape the scan lets through. }
        if (not dcExprDef) and (j < bodyEnd) and
           not (Tokens[j].Kind in [tkNewline, tkDedent, tkEOF]) then
          Error('Nil Python: a dataclass field default must be a scalar '
                + 'literal, an expression, field(default_factory=list/dict) or '
                + 'a zero-arg lambda');
      end;
      if (defKind = PYDC_INT) and (tk = tyDouble) then
      begin
        defKind := PYDC_FLOAT;
        defIVal := StrToDoubleBits(PyIntLiteralText(defIVal));
      end;
      if FindUField(ci, GetTokenStr(i)) >= 0 then
        Error('Nil Python: duplicate dataclass field ' + GetTokenStr(i));
      sz := TypeSize(tk);
      curOff := AlignTo(curOff, TypeAlign(tk));
      LastTypeProcSig := fldSig;   { procedural field — see the capture above }
      if (tk = tyClass) and (PyAnnLastCi >= 0) then
        AddUField(ci, Tokens[i].SOffset, Tokens[i].SLen, curOff, Ord(tk),
                  REC_UCLASS_BASE + PyAnnLastCi)
      else
        AddUField(ci, Tokens[i].SOffset, Tokens[i].SLen, curOff, Ord(tk), REC_NONE);
      LastTypeProcSig := -1;
      Inc(curOff, sz);
      if not fieldsOnly then
      begin
      if PyDcCount >= PY_MAX_DC_FIELDS then
        Error('Nil Python: too many dataclass fields');
      PyDcCi[PyDcCount] := ci;
      PyDcKind[PyDcCount] := defKind;
      PyDcIVal[PyDcCount] := defIVal;
      PyDcSOff[PyDcCount] := defSOff;
      PyDcSLen[PyDcCount] := defSLen;
      Inc(PyDcCount);
      end;
      i := j;
      while (i < bodyEnd) and (Tokens[i].Kind <> tkNewline) do Inc(i);
    end
    else if (depth = 0) and (Tokens[i].Kind = tkFunction) and
            PyDefAtIsOverloadStub(i) then
    begin
      { an `@overload` stub METHOD — invisible here for the same reason its
        module-level twin is invisible to PyRegisterDefShells: registering the
        stub's annotated signature would make the implementation that follows
        lose to it. bug-n-overload-decorator-is-refused }
      i := PySkipNestedSuite(i);
      if i < 0 then Break;
      Continue;
    end
    else if (depth = 0) and (Tokens[i].Kind = tkFunction) then
    begin
      methodStart := i;
      origName := GetTokenStr(i + 1);
      name := PyMethodName(origName);
      if PyPropAccessorPrefixAt(i) <> '' then
        name := PyPropAccessorPrefixAt(i) + origName;
      isCtor := name = 'create';
      nparams := 0;
      { @staticmethod: a HIDDEN receiver at slot 0. Python's static method
        declares no receiver, but UMthIsStatic is Pascal's `class procedure`
        flag, and every call path that consults it passes the CLASS as
        parameter 0 (that is what makes the metaclass idiom work). So the two
        line up exactly if the parameter list is given the slot the dispatch
        already fills — rather than teaching those paths a third convention.

        The body never reads it: it is not named `self`, so nothing in the
        method can bind to it. Both passes inject it, and they must agree —
        a disagreement here is a silent ABI mismatch, not an error, which is
        the whole reason PyIsStaticMethodAt is one function asked twice. }
      if PyIsStaticMethodAt(i) and (not isCtor) then
      begin
        pnames[0] := '$clsrecv'; ptypes[0] := tyPointer;
        nparams := 1;
      end;
      for k := 0 to 15 do begin pdefHas[k] := False; pdefIsBool[k] := False; end;
      j := i + 3;
      mStarIdx := -1; mKwIdx := -1;
      while Tokens[j].Kind <> tkRParen do
      begin
        { `*` / `*args` / `**kwargs` in a METHOD header. The top-level def path
          (PyParseDefHeader) has taken these since feature-nilpy-star-args-kwargs;
          the method path never did, so `def drawImage(self, ..., **kw)` failed
          to parse while the identical free function compiled. Both passes need
          it and both must agree, since the pre-pass decides the registered
          signature and PyParseMethod builds the frame from it. }
        if Tokens[j].Kind = tkStar then
        begin
          Inc(j);
          { a BARE `*` is the keyword-only marker — no parameter of its own }
          if Tokens[j].Kind = tkComma then
          begin
            Inc(j);
            Continue;
          end;
          if Tokens[j].Kind = tkStar then
          begin
            mKwIdx := nparams;
            Inc(j);
          end
          else mStarIdx := nparams;
          pnames[nparams] := GetTokenStr(j);
          Inc(j);
          { `*args: str` annotates the ELEMENT; the parameter stays a list }
          if Tokens[j].Kind = tkColon then
          begin
            Inc(j);
            PyAnnTypeAt(j);
            Inc(j);
          end;
          ptypes[nparams] := tyClass;
          Inc(nparams);
          if Tokens[j].Kind = tkComma then Inc(j);
          Continue;
        end;
        pnames[nparams] := GetTokenStr(j);
        if (nparams = 0) and (pnames[nparams] = 'self') then
        begin
          ptypes[nparams] := tyClass;
          Inc(j);
        end
        else
        begin
          Inc(j);
          if Tokens[j].Kind <> tkColon then
          begin
            { UNANNOTATED parameter — defaults to Any (variant), matching
              PyParseDefHeader. Must agree with the header parse or the
              registered signature and the frame disagree. }
            ptypes[nparams] := tyVariant;
          end
          else
          begin
          Inc(j);
          { PyAnnTypeAt, not PyTypeFromTokenIndex: a method parameter takes
            the SAME annotation grammar as a field or a dataclass member —
            List/Dict/set/Optional/Callable/Any/forward refs. The narrow
            single-token reader here meant a method could not accept a
            container, which is most of uforth's method signatures, and it
            reported the failure with no line of its own. }
          PyAnnParamScope := True;
          ptypes[nparams] := PyAnnTypeAt(j);
          PyAnnParamScope := False;
          if ptypes[nparams] = tyUnknown then
          begin
            PyWarnUnreadAnnotation('parameter ' + pnames[nparams], Tokens[j].Line);
            ptypes[nparams] := tyVariant;
          end;
          end;
          if Tokens[j].Kind = tkAssign then
          begin
            Inc(j);
            pdefHas[nparams] := True;
            pdefVal[nparams] := PyParamDefaultAt(j, pnames[nparams],
                                                 pdefIsStr[nparams],
                                                 pdefSOff[nparams],
                                                 pdefSLen[nparams]);
            pdefIsNone[nparams] := PyDefaultWasNone;
            pdefIsFloat[nparams] := PyDefaultWasFloat;
            pdefIsBool[nparams] := PyDefaultWasBool;
          end;
        end;
        Inc(nparams);
        if Tokens[j].Kind = tkComma then Inc(j);
      end;
      fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
      AppendChar(fullName, '.');
      for k := 1 to Length(name) do AppendChar(fullName, name[k]);
      mRet := PyMethodRetType(methodStart, mRetRec);
      if mRet = tyUnknown then mRet := tyInteger;   { `-> None` / unannotated }
      { __repr__/__str__ return a str by contract — the SIGNATURE half of the
        forcing in PyParseDefHeader (see the note there). Without it an
        unannotated `return self.n` over an unannotated field infers variant,
        the runtime renderer declines a non-AnsiString dunder, and repr(obj)
        comes back empty while print(obj) is right.
        bug-nilpy-repr-returning-a-bare-string-field-is-empty }
      if (not fieldsOnly) and (not isCtor) and PyStrDunderName(name) and
         (mRet <> tyAnsiString) then
      begin
        mRet := tyAnsiString;
        mRetRec := REC_NONE;
      end;
      { `return self` types the method as its OWN class — the fluent-builder
        idiom, and the only way a chain's second link has something to resolve
        against. The scanner cannot get there on its own: `self` is a parameter
        whose class only this pre-pass knows. }
      if (not fieldsOnly) and (not isCtor) and PyMethodReturnsSelf(methodStart) then
      begin
        mRet := tyClass;
        mRetRec := REC_UCLASS_BASE + ci;
      end;
      { An OVERRIDE takes the base method's signature. Python overrides need no
        annotations, so `def optionxform(self, s): return s` infers a variant
        result — but the inherited method occupies a VMT slot with the base's
        types, and the base's own body calls THROUGH that slot. The two must
        agree or the base reads the override's result as the wrong kind
        (configparser's optionxform, overridden by every case-preserving
        subclass, returned a variant where an AnsiString was expected). The
        base's parameter types come with it, for the same reason. }
      if (not fieldsOnly) and (not isCtor) and (UClsParent[ci] >= 0) then
      begin
        ovMmi := FindUMeth(UClsParent[ci], name);
        if ovMmi >= 0 then
        begin
          ovPi := UMthProc_[ovMmi];
          if (ovPi >= 0) and (Procs[ovPi].ParamCount = nparams) then
          begin
            { ...unless the two DISAGREE about a scalar result, in which case
              taking the base's is not a fit but a reinterpretation. `def v:
              return 0` in the base and `return 1.5` in the override printed
              4609434218613702656 — 1.5's IEEE bits read as an integer, and the
              `+ 1` after it kept going from there. The mirror direction was
              worse in a different way: an int override of a float base either
              rendered 6 as 6.0 or, for anything past a bare literal, failed to
              emit at all ("invalid IR node reference in store_sym").

              A VARIANT is the one answer that reproduces CPython for both
              directions — B().v() really IS an int there, not a float — and the
              VMT slot stays consistent because the BASE is widened too, which
              is safe here: this is a pre-pass, no body has been compiled yet,
              and a second subclass widening it again is idempotent.

              Scalars only. A class result that differs is covariance, a
              separate question, and the base's type is the defensible answer
              there; a str result from a method is rejected outright further
              down. bug-nilpy-an-override-returning-a-different-type-than-the-
              base-reads-float-bits }
            if (mRet <> Procs[ovPi].RetType) and
               PyIsScalarRetKind(mRet) and PyIsScalarRetKind(Procs[ovPi].RetType) then
            begin
              Procs[ovPi].RetType := tyVariant;
              ProcRetRecId[ovPi] := REC_NONE;
              mRet := tyVariant;
              mRetRec := REC_NONE;
            end
            else
            begin
              mRet := Procs[ovPi].RetType;
              mRetRec := ProcRetRecId[ovPi];
            end;
            for k := 1 to nparams - 1 do
              ptypes[k] := Procs[ovPi].Params[k].TypeKind;
          end;
        end;
      end;
      { str is managed here as everywhere else in NilPy }
      if mRet = tyString then mRet := tyAnsiString;
      if mRet <> tyClass then mRetRec := REC_NONE;
      { A method taken as a BOUND VALUE (`cb = self.on_key`) is called back
        through the function-object ABI, so it is normalised exactly as
        PyDefUsedAsValue normalises a def: variant result, variant parameters.
        Without it the pair held a method returning in a register while
        pybound_callv* passed a hidden destination — a value-returning bound
        method crashed, a `-> None` one worked, which is why this looked like a
        receiver bug rather than an ABI one. Applied AFTER the override block so
        a normalised base and its override still agree (both share the name, so
        both normalise). }
      if (not fieldsOnly) and (not isCtor) and PyMethodUsedAsValue(origName) then
      begin
        if mRet <> tyVariant then begin mRet := tyVariant; mRetRec := REC_NONE; end;
        for k := 1 to nparams - 1 do
          if (k <> mStarIdx) and (k <> mKwIdx) then ptypes[k] := tyVariant;
      end;
      { The CONSTRUCTOR arm of the same normalisation. A class reached as a
        VALUE is constructed through pyeval's PyClassRefNew, which reflects
        `create` out of the RTTI method table and calls it with boxed args — so
        every candidate class must present the ONE all-variant signature, the
        same way a Callable parameter forces one on every def it might receive.
        Without it the ctor stays specialised on a raw Int64 and the widened
        call site would hand it a variant to read as an integer.

        `not isCtor` is dropped HERE only: the neighbouring exclusions are about
        RESULT types (a ctor does not return) and stay. Self (index 0) and the
        `*args`/`**kwargs` slots are skipped exactly as the method arm skips
        them (feature-nilpy-class-as-a-value). }
      if (not fieldsOnly) and isCtor and PyClassKinUsedAsValue(ci) then
        for k := 1 to nparams - 1 do
          if (k <> mStarIdx) and (k <> mKwIdx) then ptypes[k] := tyVariant;
      { An aggregate/managed return from a METHOD is not wired up: a managed
        str return segfaults and a hidden-destination return has no caller-side
        destination. Reject with a diagnostic rather than ship the silent
        garbage this used to produce (bug-nilpy-method-returning-str-garbage) —
        before the return type was honoured at all, `-> str` printed an integer.
        Scalars (int, bool, float) and class returns are unaffected and now DO
        honour their annotation, which is what fixed `-> bool` printing 1 and
        `-> float` returning 0. A top-level `def` returning str works; only
        methods are limited. }
      { tyVariant is NO LONGER in this restriction: variant-returning routines
        got the record-style hidden-dest treatment, so a method can return Any
        the same way a top-level def already could. The guard still stands for
        the string/record kinds it was written for. }
      if (not fieldsOnly) and (not isCtor) and
         (RetViaHiddenDest(mRet)) and (mRet <> tyVariant) then
        { ErrorAt with the DEF's own line: plain Error here printed the line of
          whatever the parser cursor was on, which for a class pre-pass is the
          `class` header — so every one of a class's offending methods reported
          the same line and no way to tell them apart. }
        ErrorAt(Tokens[methodStart].Line,
                'Nil Python: method ' + origName + ' returns ' + PyTypeName(mRet)
                + ', which is not supported yet '
                + '(bug-nilpy-method-returning-str-garbage); '
                + 'a top-level def returning it works, or return it through a field');
      { A method whose body yields is a GENERATOR method, and its REGISTERED
        signature must already be the stackless step ABI — this pre-pass and
        PyParseMethod both build the parameter list, and the file's own comments
        record what happens when the two disagree by one slot: a silent ABI
        mismatch. So the shift happens in both, off the same scan. }
      isGenM := (not fieldsOnly) and (not isCtor) and PyDefAtHasYield(methodStart);
      if isGenM then
      begin
        if nparams >= 15 then
          Error('Nil Python: too many parameters for a generator method');
        if nparams > SL_MAX_PARAMS then
          Error('Nil Python: a generator takes at most ' + AIntToStr(SL_MAX_PARAMS)
                + ' parameters including self (v1)');
        for k := nparams downto 1 do
        begin
          pnames[k]     := pnames[k - 1];
          ptypes[k]     := ptypes[k - 1];
          pdefHas[k]    := pdefHas[k - 1];
          pdefIsStr[k]  := pdefIsStr[k - 1];
          pdefIsNone[k] := pdefIsNone[k - 1];
          pdefIsFloat[k]:= pdefIsFloat[k - 1];
          pdefIsBool[k] := pdefIsBool[k - 1];
          pdefVal[k]    := pdefVal[k - 1];
          pdefSOff[k]   := pdefSOff[k - 1];
          pdefSLen[k]   := pdefSLen[k - 1];
        end;
        if mStarIdx >= 0 then Inc(mStarIdx);
        if mKwIdx >= 0 then Inc(mKwIdx);
        pnames[0] := '__genself';  ptypes[0] := tyPointer;
        pdefHas[0] := False;  pdefIsStr[0] := False;  pdefIsNone[0] := False;
        pdefIsFloat[0] := False;  pdefIsBool[0] := False;
        pdefVal[0] := 0;  pdefSOff[0] := 0;  pdefSLen[0] := 0;
        PyGenDeclParams := nparams;   { self + the declared ones }
        PyGenElemTk := tyVariant;
        Inc(nparams);
        mRet := tyBoolean;            { the step function returns has-next }
        mRetRec := REC_NONE;
      end;
      if fieldsOnly then procIdx := -1
      else
      begin
        procIdx := RegisterProc(fullName, not isCtor, mRet, nparams, pnames, ptypes);
        if isGenM then PyMarkGeneratorProc(procIdx);
        if mRetRec >= REC_UCLASS_BASE then ProcRetRecId[procIdx] := mRetRec;
        { the call-site packing reads these two, and overload matching reads the
          parameter's class out of ProcParamRecId — same wiring the def path
          does at the end of PyParseDefHeader }
        ProcPyStarIdx[procIdx] := mStarIdx;
        ProcPyKwIdx[procIdx] := mKwIdx;
        if (mStarIdx >= 0) and (mStarIdx < MAX_PROC_PARAMS) then
        begin
          starCi := FindUClass('TPyList');
          if starCi < 0 then Error('Nil Python: pylib (TPyList) not loaded');
          ProcParamRecId[procIdx * MAX_PROC_PARAMS + mStarIdx] :=
            REC_UCLASS_BASE + starCi;
        end;
        if (mKwIdx >= 0) and (mKwIdx < MAX_PROC_PARAMS) then
        begin
          starCi := FindUClass('TPyDict');
          if starCi < 0 then Error('Nil Python: pylib (TPyDict) not loaded');
          ProcParamRecId[procIdx * MAX_PROC_PARAMS + mKwIdx] :=
            REC_UCLASS_BASE + starCi;
        end;
        { Trailing constant defaults. The shared call path already fills
          omitted trailing args from these arrays (symtab.inc), so a NilPy
          method with defaults needs no call-site work of its own. }
        for k := 0 to nparams - 1 do
          if pdefHas[k] and (k < MAX_PROC_PARAMS) then
          begin
            ProcParamHasDefault[procIdx * MAX_PROC_PARAMS + k] := True;
            ProcParamDefaultVal[procIdx * MAX_PROC_PARAMS + k] := pdefVal[k];
            ProcParamDefaultIsStr[procIdx * MAX_PROC_PARAMS + k] := pdefIsStr[k];
            ProcParamDefaultIsNone[procIdx * MAX_PROC_PARAMS + k] := pdefIsNone[k];
            ProcParamDefaultIsFloat[procIdx * MAX_PROC_PARAMS + k] := pdefIsFloat[k];
            ProcParamDefaultIsBool[procIdx * MAX_PROC_PARAMS + k] := pdefIsBool[k];
            ProcParamDefaultSOff[procIdx * MAX_PROC_PARAMS + k] := pdefSOff[k];
            ProcParamDefaultSLen[procIdx * MAX_PROC_PARAMS + k] := pdefSLen[k];
          end;
      end;
      if fieldsOnly then
        { skip method/property registration entirely; fall through to the ctor
          field scan below, which is the only thing the pre-pass wants }
      else if isCtor then
      begin
        k := PyStoredName('create');
        AddUMeth(ci, k, 6, procIdx);
        { mark it a real constructor, like the Pascal declaration does — the
          metaclass and ctor-overload paths test UMthIsCtor, not the name }
        UMthIsCtor[UMthCount - 1] := True;
      end
      else if PyPropAccessorPrefixAt(methodStart) <> '' then
      begin
        { the accessor is registered under its MANGLED name, matching the proc
          RegisterProc just made; AddUMeth otherwise keys on the raw source
          token, leaving the method called `base` while the property looks for
          `__prop_get_base`. }
        AddUMeth(ci, PyStoredName(name), Length(name), procIdx);
        { The PROPERTY is registered HERE, in the pre-pass, and not when the
          decorated def is later parsed: a method defined EARLIER in the class
          may already use `self.base`, and it is parsed before the accessor's
          own def is reached. }
        if not fieldsOnly then
        begin
          pri := FindUProp(ci, origName);
          if pri < 0 then
          begin
            pri := AddUProperty(ci, PyStoredName(origName), Length(origName),
                                Ord(mRet), mRetRec);
            UPropPub[pri] := 1;
          end;
          if PyPropAccessorPrefixAt(methodStart) = '__prop_set_' then
          begin
            UPropWriteMOff[pri] := PyStoredName(name);
            UPropWriteMLen[pri] := Length(name);
          end
          else
          begin
            { the getter defines the property's TYPE }
            UPropReadMOff[pri] := PyStoredName(name);
            UPropReadMLen[pri] := Length(name);
            UPropTk[pri] := Ord(mRet);
            UPropRec[pri] := mRetRec;
          end;
        end;
      end
      else
        AddUMeth(ci, Tokens[i + 1].SOffset, Tokens[i + 1].SLen, procIdx);
      { @staticmethod: no receiver. UMthIsStatic is the SAME flag Pascal's
        `class procedure` sets, and parser.inc's call paths already consult it
        (including the PyExprMode arm), so marking it here is the whole of the
        dispatch change — `C.s(1)` and `inst.s(1)` both stop passing an
        instance. Nothing needs to suppress a `self` parameter, because a
        static method simply does not declare one and the self handling is
        keyed on the literal NAME at position 0. }
      if (not fieldsOnly) and (not isCtor) and PyIsStaticMethodAt(methodStart) then
        UMthIsStatic[UMthCount - 1] := True;
      if not fieldsOnly then
      begin
        mmi := UMthCount - 1;
        { A static method is not dispatched through the VMT, so it takes no
          virtual slot — handing it one would consume a slot the subclass's
          override numbering then disagrees about. }
        if (not isCtor) and (not UMthIsStatic[mmi]) then
        begin
          { An OVERRIDE takes the slot the parent already assigned to that name,
            so a base-typed reference to a subclass instance dispatches to the
            override. A new name gets the next free slot. }
          slot := -1;
          if UClsParent[ci] >= 0 then
          begin
            inhMmi := FindUMeth(UClsParent[ci],
                                PyRawName(Tokens[i + 1].SOffset, Tokens[i + 1].SLen));
            if inhMmi >= 0 then slot := UMthVirSlot[inhMmi];
          end;
          if slot < 0 then
          begin
            slot := UClsVirtCount[ci];
            UClsVirtCount[ci] := UClsVirtCount[ci] + 1;
          end;
          UMthVirSlot[mmi] := slot;
        end;
      end;
      { `self.name = ...` declares a field — in ANY method, not only the
        constructor. Python creates the attribute wherever the assignment runs,
        and real classes split their setup: songformatter's SettingsFrame builds
        its widgets in `_build_layout`, so restricting this scan to `__init__`
        left `self.canvas` unregistered and every use of it fell through to the
        dynamic-attribute path (no class identity, no keyword arguments, no
        method resolution). The scan only ADDS fields, and a name already
        registered by an earlier method keeps its first type. }
      begin
        { bounded: a method with no suite of its own must contribute NO fields,
          rather than running on and harvesting the next method's
          (bug-nilpy-def-body-scans-run-on-when-no-indent-is-found) }
        j := PyFindSuiteIndent(j, bodyEnd);
        if j < 0 then j := bodyEnd else Inc(j);
        while (j + 4 < bodyEnd) and (Tokens[j].Kind <> tkDedent) do
        begin
          { Both `self.NAME = expr` and `self.NAME: ann = expr` declare a
            field. The annotated form used to be invisible here — the match
            required '=' at j+3 — so a class that annotates its ctor fields
            (the idiomatic Python form, and the one the uforth VM uses)
            registered NO fields at all and every later `self.x` mis-resolved
            against an empty class. }
          fldAnn := -1;
          fldSig := -1;
          if (Tokens[j].Kind = tkIdent) and (GetTokenStr(j) = 'self') and
             (Tokens[j + 1].Kind = tkDot) and (Tokens[j + 2].Kind = tkIdent) then
          begin
            if Tokens[j + 3].Kind = tkAssign then fldAnn := 0
            { `self.x: int = 5` — an ANNOTATED declaration, which is a STATEMENT
              and therefore always starts one. Without that requirement the
              colon of a compound-statement HEADER matched: `if not
              self.compiling:` reads as `self` `.` `compiling` `:` and declared a
              phantom variant field named after whatever the condition tested.
              Harmless for a name that is a real field (it is already
              registered, and the guard below skips a duplicate) — but for a
              @property it declared a FIELD SHADOWING THE PROPERTY, so every
              access resolved to a slot nobody writes. `if self.x:`, `while
              self.x:`, `{self.x: 1}` and `a[self.x:]` are all this shape.
              bug-nilpy-property-setter-is-skipped-on-a-dynamically-typed-receiver }
            else if (Tokens[j + 3].Kind = tkColon) and
                    ((j = 0) or
                     (Tokens[j - 1].Kind in [tkNewline, tkIndent, tkDedent,
                                             tkSemicolon])) then
              fldAnn := j + 4;
          end;
          if fldAnn >= 0 then
          begin
            if fldAnn > 0 then
            begin
              { annotated: the annotation IS the type, exactly as for a
                dataclass field — same PyAnnTypeAt grammar (Optional/Any/
                List/Callable/forward refs). }
              k2 := fldAnn;
              tk := PyAnnTypeAt(k2);
              fldSig := PyAnnLastProcSig;
              fldRec := REC_NONE;
              if (tk = tyClass) and (PyAnnLastCi >= 0) then
                fldRec := REC_UCLASS_BASE + PyAnnLastCi;
              if tk = tyUnknown then
              begin
                { An annotation this reader cannot interpret fell THROUGH to the
                  infer-from-the-right-hand-side path below and came out as
                  "cannot infer the type of field self.xs - annotate it" — about
                  a field that IS annotated. Degrade to Any, same as everywhere
                  else. bug-n-an-uninterpretable-annotation-refuses-the-program }
                PyWarnUnreadAnnotation('field self.' + GetTokenStr(j + 2),
                                       Tokens[j].Line);
                tk := tyVariant;
                fldSig := -1;
              end;
            end
            else
            begin
              rhsAt := j + 4;
              { A QUALIFIED construction first — `self.canvas = tk.Canvas(root)`.
                Reading the type off the FIRST token would resolve the module
                alias `tk`, and a class may well be named for it (tkinter's own
                `Tk` root window, matched case-insensitively): the field was then
                recorded as a Tk, so `self.canvas.create_text(...)` found no such
                method and fell through to the dynamic-attribute path — which
                cannot bind keyword arguments. }
              tk := tyUnknown;
              fldRec := REC_NONE;
              if (rhsAt + 3 < bodyEnd) and (Tokens[rhsAt].Kind = tkIdent) and
                 (Tokens[rhsAt + 1].Kind = tkDot) and (Tokens[rhsAt + 2].Kind = tkIdent) and
                 (Tokens[rhsAt + 3].Kind = tkLParen) and
                 (FindUClassNonRecord(GetTokenStr(rhsAt + 2)) >= 0) then
              begin
                { NonRecord, both times: a QUALIFIED construction
                  `self.t = tk.Text(...)` names a class, and the first row of
                  that name may be a same-named RECORD — which is how this arm
                  typed a Text field as the RTL's file record and then reported
                  "Text has no method insert".
                  bug-nilpy-text-class-name-binds-the-rtl-file-record. }
                tk := tyClass;
                fldRec := REC_UCLASS_BASE + FindUClassNonRecord(GetTokenStr(rhsAt + 2));
              end;
              { A bare identifier that names a PARAMETER of this method is a
                VALUE, and that reading has to win before the type scanners see
                it. PyTypeFromTokenIndex maps an identifier that names a class
                to tyClass, case-INSENSITIVELY (Pascal rules), so in

                    class Node:
                        def __init__(self, node: int):
                            self.node = node

                the right-hand `node` matched the class `Node` and the field was
                registered as an instance of its own class. `str(self.node)`
                then took the object route and dispatched __str__ on the
                integer, which SEGFAULTED — with the name being the only
                trigger, so the identical class called `A` with a field `v` was
                fine (bug-nilpy-str-of-object-segfaults-when-dunder-builds-a-
                string). Any field whose name matches ANY class name, not only
                its own, hit it.

                Order only: a right-hand side that is not a parameter still
                falls through to exactly the scanners it used before. }
              if (tk = tyUnknown) and (Tokens[rhsAt].Kind = tkIdent) then
              begin
                rhsName := GetTokenStr(rhsAt);
                tk := PyHeaderParamType(methodStart, j, rhsName);
                fldSig := PyAnnLastProcSig;
                fldRec := PyHeaderParamRec(methodStart, j, rhsName);
              end;
              if tk = tyUnknown then
              begin
                tk := PyTypeFromTokenIndex(rhsAt);
                fldRec := PyRecFromTokenIndex(rhsAt);
              end;
              if tk = tyUnknown then
              begin
                { Anything richer than a literal or a bare parameter — a list
                  literal (`self.base_stack = [10]`), a call, a construction.
                  One scanner already knows how to type an expression; reuse
                  it rather than erroring or growing a second half-scanner
                  here. }
                k2 := rhsAt;
                while (k2 < bodyEnd) and
                      not (Tokens[k2].Kind in [tkNewline, tkDedent]) do Inc(k2);
                tk := PyInferExprType(rhsAt, k2);
                if (tk = tyClass) and (PyInferLastCi >= 0) then
                  fldRec := REC_UCLASS_BASE + PyInferLastCi;
              end;
            end;
            { Assigned from a MODULE GLOBAL: `self.state = NEW`, the ordinary
              Python module-level constant. None of the scanners above can see
              it — the name is bound outside this class body — and the field was
              rejected outright with "cannot infer the type of field", uniformly
              for a str / int / float / list / bool global.
              PyModuleGlobalLiteralType reads it straight off the module's
              tokens — PyCollectModuleLocalsAST, which would know, does not run
              until after this pre-pass.
              bug-nilpy-a-field-assigned-from-a-module-global-has-no-inferable-type }
            if (tk = tyUnknown) and (Tokens[j + 4].Kind = tkIdent) and
               PyBlkRhsEndsAt(j + 4) and
               (not PyHeaderHasParam(methodStart, j, GetTokenStr(j + 4))) then
            begin
              tk := PyModuleGlobalLiteralType(GetTokenStr(j + 4));
              if tk <> tyUnknown then fldRec := REC_NONE
              else
              begin
                { ...and the same global holding a class INSTANCE, `G = K()`,
                  which needs the class identity as well as the kind — see
                  PyModuleGlobalCtorClass for why reporting only the kind
                  produced a plausible wrong number. }
                k2 := PyModuleGlobalCtorClass(GetTokenStr(j + 4));
                if k2 >= 0 then
                begin
                  tk := tyClass;
                  fldRec := REC_UCLASS_BASE + k2;
                end;
              end;
            end;
            if tk = tyUnknown then
            begin
              { Assigned from a bare ctor PARAMETER that carries no annotation:
                `def __init__(self, parent, on_next)` then `self.on_next =
                on_next`. Python does not require the annotation and neither can
                we — that is the shape of an ordinary class, and erroring here
                rejected whole modules over it (songformatter's FormatText).
                The field takes the variant type, which is what an unannotated
                LOCAL already gets, so the value keeps its runtime tag.

                Only for that case: a right-hand side the scanners could not
                type at all still errors, because guessing there would hide a
                real mistake. }
              if ((Tokens[j + 4].Kind = tkIdent) and
                  PyHeaderHasParam(methodStart, j, GetTokenStr(j + 4))) or
                 (Tokens[j + 4].Kind = tkNil) then
              begin
                { ...or assigned None outright: `self.file_path = None`, which is
                  how Python declares a field that gets a value later. There is
                  no type to read off None, and demanding an annotation for it
                  rejected the class. Variant, so the tag is whatever is stored
                  next. }
                tk := tyVariant;
                fldRec := REC_NONE;
                fldSig := -1;
              end
              else if not isCtor then
                { OUTSIDE the constructor an unreadable right-hand side is not a
                  diagnostic: `self.items = self.load()` in a helper is ordinary
                  Python, and the field is already declared (or will be) where
                  its type IS readable. The variant keeps the runtime tag; only
                  the ctor, where a field is normally introduced, still insists
                  on something it can type. }
                tk := tyVariant
              else
                ErrorAt(Tokens[j].Line,
                        'Nil Python: cannot infer the type of field self.'
                        + GetTokenStr(j + 2) + ' - annotate it (self.'
                        + GetTokenStr(j + 2) + ': int = ...)');
            end;
            { An int field this class GROWS by arithmetic on itself becomes a
              VARIANT, so an accumulator stays exact past 2^63 instead of
              wrapping in silence — see PyFieldIsIntAccumulator for why variant
              and not promo, and for why the test is deliberately narrow. }
            if PyIsMachineIntTk(tk) and
               PyFieldIsIntAccumulator(bodyStart, bodyEnd, GetTokenStr(j + 2)) then
            begin
              tk := tyVariant;
              fldSig := -1;
            end;
            { see the dataclass branch: str fields are managed, not string[N] }
            if tk = tyString then tk := tyAnsiString;
            if tk <> tyClass then fldRec := REC_NONE;
            { ...unless the name is a CLASS ATTRIBUTE lowered as a shared slot
              with per-instance overrides. There `self.x = ...` is precisely the
              write that creates the override, and giving it a field as well
              would make the instance read that field instead of falling through
              to the slot — so a later `C.x = ...` would be invisible to every
              instance, which is the divergence the whole lowering exists to
              avoid. Same rule as the class-attribute branches: a shared slot
              has no instance field, deliberately. }
            if (FindUField(ci, GetTokenStr(j + 2)) < 0) and
               (PyClsAttrOvrSlot(ci, GetTokenStr(j + 2)) < 0) then
            begin
              sz := TypeSize(tk);
              curOff := AlignTo(curOff, TypeAlign(tk));
              { AddUField reads LastTypeProcSig for a procedural field, which is
                what makes `w.native(vm)` lower to an indirect call rather than
                "field is not callable" (feature-nilpy-function-values). }
              LastTypeProcSig := fldSig;
              AddUField(ci, Tokens[j + 2].SOffset, Tokens[j + 2].SLen, curOff, Ord(tk), fldRec);
              LastTypeProcSig := -1;
              Inc(curOff, sz);
            end;
          end;
          Inc(j);
        end;
      end;
    end;
    Inc(i);
  end;
    { next flattened base, or done }
    if mixIx >= PyMixN then Break;
    inMixin := True;
    PyMixBuildSkip(ci, ownBS, ownBE, mixIx);
    bodyStart := PyClsBodyS[PyMixCi[mixIx]];
    bodyEnd := PyClsBodyE[PyMixCi[mixIx]];
    Inc(mixIx);
  end;
  bodyStart := ownBS; bodyEnd := ownBE;
  if isDC and not fieldsOnly then
  begin
    { Synthesize the create ctor: self + one param per field, in order. }
    if UClsFCount[ci] > 15 then
      Error('Nil Python: too many dataclass fields for the ctor');
    pnames[0] := 'self'; ptypes[0] := tyClass;
    nparams := 1;
    for k := UClsFBase[ci] to UClsFBase[ci] + UClsFCount[ci] - 1 do
    begin
      pnames[nparams] := PyRawName(UFldNOff[k], UFldNLen[k]);
      ptypes[nparams] := IntToTypeKind(UFldTk[k]);
      Inc(nparams);
    end;
    fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
    AppendChar(fullName, '.');
    name := 'create';
    for k := 1 to Length(name) do AppendChar(fullName, name[k]);
    procIdx := RegisterProc(fullName, False, tyInteger, nparams, pnames, ptypes);
    k := PyStoredName('create');
    AddUMeth(ci, k, 6, procIdx);
    { CPython's @dataclass also generates __eq__, comparing the declared fields
      — `P(1) == P(1)` is True there and was False here, an identity compare
      with no method to dispatch to (bug-nilpy-dataclass-no-generated-eq).
      Registered as an ordinary method so the `==` dispatch in ParseExpr picks
      it up like a hand-written one; a hand-written __eq__ WINS (it is already
      in the method table by now, and eq=False is not modelled). }
    if FindUMeth(ci, '__eq__') < 0 then
    begin
      pnames[0] := 'self'; ptypes[0] := tyClass;
      pnames[1] := 'other'; ptypes[1] := tyClass;
      fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
      AppendChar(fullName, '.');
      name := '__eq__';
      for k := 1 to Length(name) do AppendChar(fullName, name[k]);
      procIdx := RegisterProc(fullName, True, tyBoolean, 2, pnames, ptypes);
      k := PyStoredName('__eq__');
      AddUMeth(ci, k, 6, procIdx);
      PyDcEqProc[ci] := procIdx;
    end;
    { ...and `__repr__`, the other half of what the decorator generates.
      Without it `print(p)` printed the instance HANDLE — a bare 15-digit
      number, different every run — where CPython prints `P(x=1, y=5)`. That is
      the single most visible thing a dataclass does, and the failure is silent:
      the number IS a value, so nothing raises.
      A hand-written __repr__ wins, same rule as __eq__ (repr=False is not
      modelled). bug-nilpy-dataclass-no-generated-repr }
    if FindUMeth(ci, '__repr__') < 0 then
    begin
      pnames[0] := 'self'; ptypes[0] := tyClass;
      fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
      AppendChar(fullName, '.');
      name := '__repr__';
      for k := 1 to Length(name) do AppendChar(fullName, name[k]);
      procIdx := RegisterProc(fullName, True, tyAnsiString, 1, pnames, ptypes);
      k := PyStoredName(name);
      { Length(name), NOT a literal: AddUMeth's third argument is the name
        LENGTH, and copying the neighbouring __eq__ registration's literal 6
        registered this method as `__repr` — which compiles, emits a correct
        body, and is simply never found. }
      AddUMeth(ci, k, Length(name), procIdx);
      PyDcReprProc[ci] := procIdx;
    end;
    { `@dataclass(order=True)` — the four comparison dunders, over the field
      tuple in declaration order, which is exactly what CPython generates. A
      hand-written one WINS, the same rule __eq__ and __repr__ follow.
      bug-nilpy-dataclass-keyword-arguments-do-not-parse }
    if PyDcOrder[ci] then
      for dcCmp := 0 to 3 do
      begin
        name := PyDcCmpName(dcCmp);
        if FindUMeth(ci, name) >= 0 then Continue;
        pnames[0] := 'self'; ptypes[0] := tyClass;
        pnames[1] := 'other'; ptypes[1] := tyClass;
        fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
        AppendChar(fullName, '.');
        for k := 1 to Length(name) do AppendChar(fullName, name[k]);
        procIdx := RegisterProc(fullName, True, tyBoolean, 2, pnames, ptypes);
        AddUMeth(ci, PyStoredName(name), Length(name), procIdx);
        PyDcCmpProc[ci * 4 + dcCmp] := procIdx;
      end;
  end;
  UClsSize_[ci] := AlignTo(curOff, align);

  { RTTI backlink word (VMT-8) + LAYOUT backlink word (VMT-16) before the VMT —
    same layout the Pascal path reserves, so an instance can reach its class RTTI
    at [[instance+0] - 8] and its managed-field layout at [[instance+0] - 16].
    Keep the two in step. }
  for i := 0 to 15 do
  begin
    Data[DataLen] := 0;
    Inc(DataLen);
  end;
  UClsVMTOffset[ci] := DataLen;
  for i := 0 to UClsVirtCount[ci] * 8 - 1 do
  begin
    Data[DataLen] := 0;
    Inc(DataLen);
  end;
  for i := UClsMBase[ci] to UClsMBase[ci] + UClsMCount[ci] - 1 do
    if UMthVirSlot[i] >= 0 then
    begin
      MethodFixups[MethodFixCount].DataPos := UClsVMTOffset[ci] + UMthVirSlot[i] * 8;
      MethodFixups[MethodFixCount].ProcIdx := UMthProc_[i];
      Inc(MethodFixCount);
    end;
  { INHERITED slots this class does not override still need an entry: the VMT is
    per-class and starts zeroed, so an un-filled slot is a call through NIL. Walk
    the ancestor chain nearest-first and take the first method holding the slot. }
  for slot := 0 to UClsVirtCount[ci] - 1 do
  begin
    inhMmi := -1;
    for i := UClsMBase[ci] to UClsMBase[ci] + UClsMCount[ci] - 1 do
      if UMthVirSlot[i] = slot then inhMmi := i;
    if inhMmi < 0 then
    begin
      k := UClsParent[ci];
      while (k >= 0) and (inhMmi < 0) do
      begin
        for i := UClsMBase[k] to UClsMBase[k] + UClsMCount[k] - 1 do
          if UMthVirSlot[i] = slot then inhMmi := i;
        k := UClsParent[k];
      end;
      if inhMmi >= 0 then
      begin
        MethodFixups[MethodFixCount].DataPos := UClsVMTOffset[ci] + slot * 8;
        MethodFixups[MethodFixCount].ProcIdx := UMthProc_[inhMmi];
        Inc(MethodFixCount);
      end;
    end;
  end;
end;

procedure PyParseMethod(ci: Integer);
var isGenDef: Boolean;
    savedGenerator, savedGenStackless, savedGenSeen, savedGenIsVariant: Boolean;
    savedGenStateCtr, savedGenSlotNext, savedGenScopeBase, savedGenElemOff: Integer;
    savedHoist: Integer; clsAttrSeq: Integer;
    origName, name, fullName: AnsiString; procIdx, i, idx, nparams, savedSC, savedFS,
    savedSelf, patchPos, bodyNode, bodyStart, annIdx: Integer; pnames: array[0..15] of AnsiString;
    ptypes: array[0..15] of TTypeKind; pcis: array[0..15] of Integer;
    psigs: array[0..15] of Integer;   { Callable signature per parameter, or -1 }
    isCtor: Boolean; isKwP: Boolean; starCi: Integer;
    savedNest, savedTok, savedLam, savedSelf2: Integer; savedPfx, savedPfx2: AnsiString;
    savedDefGlobals: array[0..PY_MAX_DEF_GLOBALS-1] of AnsiString;
    savedDefGlobalCount, dgI, cellInit: Integer;
    pbInit, pbAsgn: Integer;
    pbLocal: array[0..MAX_PROC_PARAMS - 1] of Integer;
begin
  { REPLAY of a flattened base's body: a definition the derived class or an
    earlier base already supplied was skipped by the registration pass, so
    there is no member to compile it into. Checked here rather than at the two
    call sites, because a decorated method (@property, @staticmethod) reaches
    this one with its decorator already consumed.
    bug-nilpy-multiple-inheritance-does-not-parse }
  if PyMixReplay and (CurTok.Kind = tkFunction) and
     PyMixSkipHas(PyDefMemberKeyAt(TokPos - 1)) then
  begin
    PySkipOverloadStubDef;
    Exit;
  end;
  { per-invocation, exactly as in PyParseDef: this routine re-enters itself
    through the nested-def drain at the end. }
  savedGenerator     := CurProcIsGenerator;
  savedGenStackless  := CurProcIsStackless;
  savedGenSeen       := CurGenSeenYield;
  savedGenIsVariant  := CurGenElemIsVariant;
  savedGenStateCtr   := CurGenStateCtr;
  savedGenSlotNext   := CurGenSlotNext;
  savedGenScopeBase  := CurGenScopeBase;
  savedGenElemOff    := CurGenElemOff;
  savedHoist := PyHoistHead;
  { PARK the queue on a fresh chain rather than merely remembering its head.
    `PyHoistHead := savedHoist` at the end cannot UNLINK anything: PySeqAppend
    mutates the saved chain's tail in place, so with a hoist already pending
    (a class attribute with a non-literal initialiser queues one at the class
    statement) this body's own hoisted statements stayed reachable through it
    and were flushed into the MODULE body — where they reference this routine's
    locals. The visible symptom was a class losing a whole tuple return to
    silence or a segfault, three lines away from an attribute nothing read
    (bug-nilpy-non-literal-class-attribute-corrupts-the-class-layout). A body's
    own hoists are flushed by its statement loop; the rest is stale by
    construction, which is what the restore always meant to express. }
  PyHoistHead := -1;
  { Python's binding rule is per-FUNCTION, so the `global`/`nonlocal` set is a
    property of THIS body — saved and restored so a nested def (drained at the
    end of this routine) cannot leak its declarations into the enclosing one. }
  savedDefGlobalCount := PyDefGlobalCount;
  for dgI := 0 to PyDefGlobalCount - 1 do savedDefGlobals[dgI] := PyDefGlobalName[dgI];

  Expect(tkFunction, 'def');
  origName := CurTok.SVal; name := PyMethodName(origName);
  { same mangling the pre-pass applied. TokPos-2 is the `def`, since CurTok is
    the name that follows it. }
  if PyPropAccessorPrefixAt(TokPos - 2) <> '' then
    name := PyPropAccessorPrefixAt(TokPos - 2) + origName;
  Next;
  isCtor := name = 'create';
  Expect(tkLParen, '(');
  nparams := 0;
  { the same hidden receiver the member pre-pass injected — see its note.

    TokPos-4, not -3: TokPos sits ONE PAST CurTok (which is why the property
    check above is TokPos-2 when CurTok is the name). Here `(` is already
    consumed, so CurTok is the first parameter token and the tokens run
    [def][name][(][CurTok] — putting `def` four back. Off by one, only the
    pre-pass saw the decorator, and the two passes registered DIFFERENT
    signatures: exactly the silent ABI mismatch this pairing is warned about. }
  if PyIsStaticMethodAt(TokPos - 4) and (not isCtor) then
  begin
    pnames[0] := '$clsrecv'; ptypes[0] := tyPointer; pcis[0] := -1;
    psigs[0] := -1;
    nparams := 1;
  end;
  while CurTok.Kind <> tkRParen do
  begin
    { `*` / `*args` / `**kwargs` — mirrors the member pre-pass above; the two
      must produce the same parameter list or the frame and the registered
      signature disagree. }
    if CurTok.Kind = tkStar then
    begin
      Next;
      if CurTok.Kind = tkComma then     { bare `*`: keyword-only marker }
      begin
        Next;
        Continue;
      end;
      isKwP := CurTok.Kind = tkStar;
      if isKwP then Next;
      pnames[nparams] := CurTok.SVal; Next;
      if CurTok.Kind = tkColon then
      begin
        annIdx := TokPos - 1;
        Inc(annIdx);
        PyAnnTypeAt(annIdx);
        TokPos := annIdx;
        Next;
      end;
      if isKwP then starCi := FindUClass('TPyDict')
      else starCi := FindUClass('TPyList');
      if starCi < 0 then Error('Nil Python: pylib (TPyList/TPyDict) not loaded');
      ptypes[nparams] := tyClass;
      pcis[nparams] := starCi;
      psigs[nparams] := -1;
      Inc(nparams);
      if not Eat(tkComma) then break;
      Continue;
    end;
    pnames[nparams] := CurTok.SVal; Next;
    psigs[nparams] := -1;
    if (nparams = 0) and (pnames[nparams] = 'self') then
    begin ptypes[nparams] := tyClass; pcis[nparams] := ci; end
    else if CurTok.Kind <> tkColon then
    begin
      { UNANNOTATED parameter -> Any (variant); must match the pre-pass. }
      ptypes[nparams] := tyVariant; pcis[nparams] := -1;
      if CurTok.Kind = tkAssign then PySkipParamDefaultAtCursor;
    end
    else
    begin
      Expect(tkColon, ':');
      { PyAnnTypeAt, bridged onto the cursor, so the header accepts exactly
        what the class pre-pass accepted — List/Dict/set/Optional/Callable.
        The two must agree: the pre-pass decides the registered signature and
        this decides the frame, and a disagreement is a silent ABI mismatch. }
      annIdx := TokPos - 1;
      PyAnnParamScope := True;
      ptypes[nparams] := PyAnnTypeAt(annIdx);
      PyAnnParamScope := False;
      pcis[nparams] := PyAnnLastCi;
      { A `Callable[...]` parameter carries a procedural SIGNATURE, and without
        it the name is not callable inside the body — the def path has recorded
        this since function values landed, the METHOD path never did, so
        `def analyze(self, chord_to_notes: Callable[[str], list[str]])` compiled
        but `chord_to_notes(chord)` did not parse (feature-nilpy-function-values,
        the method half). }
      psigs[nparams] := PyAnnLastProcSig;
      TokPos := annIdx;
      Next;
      { the default VALUE was recorded by the pre-pass, which is what the
        call path reads; here it only has to be stepped over }
      if CurTok.Kind = tkAssign then PySkipParamDefaultAtCursor;
    end;
    Inc(nparams);
    if not Eat(tkComma) then break;
  end;
  Expect(tkRParen, ')');
  { the annotation is OPTIONAL — see PyParseDefHeader for why the default here
    has to match the pre-pass exactly }
  if CurTok.Kind = tkMinus then
  begin
    Expect(tkMinus, '- in ->'); Expect(tkGt, '> in ->');
  { `-> None` on a NON-ctor method: accept it. Only the ctor was allowed to
    say None, so an ordinary `def m(self) -> None:` died in PyParseType with
    "expected type annotation" — while the identical top-level def has worked
    since day one (PyParseDef's isProc path). PyMethodRetType already maps the
    None annotation to tyInteger for registration, so nothing downstream
    changes; the header parse was simply stricter than the pre-pass. }
    if isCtor then Expect(tkNil, 'None')
    else if CurTok.Kind = tkNil then Next
    { the result is DISCARDED here — PyMethodRetType's pre-pass already decided
      the type, and this call only walks the tokens. So it must not be STRICTER
      than that pre-pass, which tolerates an unreadable annotation: with
      PyParseType it refused `-> Sequence[int]` on a method while the pre-pass
      had already degraded it to Any. Same shape as the `-> None` note above.
      bug-n-an-uninterpretable-annotation-refuses-the-program }
    else PyParseRetTypeOrAny;
  end;
  { An UNANNOTATED `__init__` is ordinary Python — `def __init__(self, parent):`
    is what songformatter's SettingsEditor writes — and it registers exactly as
    the annotated form does: PyMethodRetType yields tyUnknown for both, which
    the member pre-pass maps to tyInteger, so accepting it here changes no
    signature. The requirement was a syntax rule with nothing behind it. }
  Expect(tkColon, ':'); Expect(tkNewline, 'newline'); Expect(tkIndent, 'indent');
  bodyStart := TokPos - 1;
  { The SAME rewrite the member pre-pass applied to this method's registered
    signature (PyRegisterClassMembers) — off the same scan, so the frame this
    body builds and the signature its callers use agree. A generator method is
    otherwise an ordinary generator whose first declared parameter is `self`. }
  isGenDef := PyDefBodyHasYield(bodyStart);
  if isGenDef then
  begin
    if nparams >= 15 then
      Error('Nil Python: too many parameters for a generator method');
    if nparams > SL_MAX_PARAMS then
      Error('Nil Python: a generator takes at most ' + AIntToStr(SL_MAX_PARAMS)
            + ' parameters including self (v1)');
    for i := nparams downto 1 do
    begin
      pnames[i] := pnames[i - 1];
      ptypes[i] := ptypes[i - 1];
      pcis[i]   := pcis[i - 1];
      psigs[i]  := psigs[i - 1];
    end;
    pnames[0] := '__genself';  ptypes[0] := tyPointer;
    pcis[0] := -1;  psigs[0] := -1;
    Inc(nparams);
    { …and the same ordering constraint as the def path: the local-typing
      pre-pass trial-parses this body, so the context must be on before it. }
    CurProcIsGenerator := True;
    CurProcIsStackless := True;
    CurGenSeenYield := False;
  end;
  PyScanDefGlobals(bodyStart);
  fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]); AppendChar(fullName, '.');
  for i := 1 to Length(name) do AppendChar(fullName, name[i]);
  procIdx := FindProc(fullName);
  { An OVERRIDE's parameters take the BASE method's types — the member pre-pass
    did the same when it registered this signature (see PyRegisterClassMembers),
    and the two passes MUST agree or the frame disagrees with the signature.
    Python overrides carry no annotations, so without this
    `def optionxform(self, s)` bound a variant parameter to an AnsiString slot
    and the inherited caller read the wrong kind. }
  { The member pre-pass and this parse decide generator-ness independently, off
    two different scans of the same body (PyDefAtHasYield there, from the `def`
    token; PyDefBodyHasYield here, from the body token). If they ever disagree,
    the signature callers use and the frame this body builds differ by exactly
    one parameter slot, and the program SEGFAULTS with nothing to point at — the
    file's standing warning about this pairing, made checkable. }
  if (procIdx >= 0) and (ProcIsStackless[procIdx] <> isGenDef) then
    Error('Nil Python: internal — the class-member pre-pass and the method '
          + 'parse disagree about whether `' + fullName + '` is a generator; '
          + 'this would build a frame that does not match its registered '
          + 'signature');
  if procIdx >= 0 then
    for i := 1 to nparams - 1 do
      if (i < Procs[procIdx].ParamCount) and
         ((not isGenDef) or (i > 1)) then   { 0 = __genself, 1 = self }
        ptypes[i] := Procs[procIdx].Params[i].TypeKind;
  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  for i := 0 to nparams - 1 do
  begin
    idx := AllocParam(pnames[i], ptypes[i], ptypes[i] = tyVariant, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    Procs[procIdx].Params[i].IsRef := ptypes[i] = tyVariant;
    if i < MAX_PROC_PARAMS then
      ProcParamIsConst[procIdx * MAX_PROC_PARAMS + i] := ptypes[i] = tyVariant;
    if (ptypes[i] = tyClass) and (pcis[i] >= 0) then
      Syms[idx].RecName := REC_UCLASS_BASE + pcis[i];
    if psigs[i] >= 0 then SymProcSig[idx] := psigs[i];   { Callable parameter }
    SymSyncTypeRef(idx);
  end;
  { A rebound variant parameter gets a private slot — see the identical block in
    PyParseDef for why (a variant is const-by-REF, so `p = ...` wrote into the
    CALLER's slot). A method needs it for the same reason a def does: the two
    parameter paths are separate code, and a fix in one leaves the other wrong.
    bug-nilpy-rebinding-a-list-parameter-aliases-the-callers-list }
  for i := 0 to nparams - 1 do
  begin
    pbLocal[i] := -1;
    if (i < MAX_PROC_PARAMS) and (ptypes[i] = tyVariant) and
       (Procs[procIdx].Params[i].SymIdx >= 0) and
       PyParamRebound(bodyStart, pnames[i]) then
    begin
      Syms[Procs[procIdx].Params[i].SymIdx].Name := '$byref.' + pnames[i];
      pbLocal[i] := AllocVar(pnames[i], tyVariant);
    end;
  end;
  if not isCtor then
  begin
    { see the note in the def path — a Python local may be named `result` }
    idx := AllocVar('$pyresult', Procs[procIdx].RetType);
    Procs[procIdx].RetSymIdx := idx;
    { skLocal is what gates the prologue zero-init (IR_ZERO_SYM checks it), and
      the Pascal path sets it. Without it a MANAGED Result slot held stack
      garbage, so the first `Result := ...` released a wild handle -- a method
      returning str segfaulted, and only when the layout happened to leave
      non-zero there, which is why it needed a ctor to reproduce
      (bug-nilpy-method-returning-str-garbage). }
    Syms[idx].Kind := skLocal;
    if RetViaHiddenDest(Procs[procIdx].RetType) then
    begin
      idx := AllocVar('', tyPointer);
      ProcAggregateDestSym[procIdx] := idx;
    end;
  end;
  { Methods used to have NO local pre-pass at all: a method local took the type
    of its FIRST assignment and never widened, so `x = 1` then `x = "s"` in a
    method was an Integer local silently holding a string handle — the same
    def/method asymmetry that made `-> str` methods a separate bug from `-> str`
    defs. One pre-pass now serves both. }
  { SET THE NEST PREFIX FIRST — the pre-pass parses this body too, and a nested
    def it meets registers under `PyNestPrefix + '.' + name`. With the prefix
    still empty here, two methods of one class each declaring a nested def of
    the SAME name both registered it as the bare name, so the second method's
    call bound the FIRST method's def and failed on arity:

        class C:
            def a(self):
                def draw(v): ...
            def b(self):
                def draw(): ...        -> no overload of draw matches

    A plain def already sets its prefix before its own PyCollectLocalsAST call
    (PyParseDef); the method path set it after, and that asymmetry was the whole
    bug — which is also why two same-named nested defs in two plain FUNCTIONS
    never collided (bug-nilpy-same-named-nested-defs-in-two-methods-collide). }
  savedPfx := PyNestPrefix; PyNestPrefix := fullName;
  PyCollectLocalsAST(bodyStart);
  PyDbgDumpLocals(Procs[procIdx].Name);
  for i := 0 to PyLocalCount - 1 do
    if PyAssignTargetSym(PyLocals[i].Name) < 0 then
    begin
      idx := AllocVar(PyLocals[i].Name, PyLocals[i].TypeKind);
      if (PyLocals[i].TypeKind = tyClass) and (PyLocals[i].RecCi >= 0) then
      begin
        Syms[idx].RecName := REC_UCLASS_BASE + PyLocals[i].RecCi;
        SymSyncTypeRef(idx);
      end;
    end;
  { see PyParseDef: a `nonlocal`-claimed local becomes one shared frame cell }
  cellInit := PyPromoteNonlocalCells(bodyStart);
  Procs[procIdx].BodyAddr := CodeLen;
  { A method may contain nested defs (`def helper(): ...` inside it). They queue
    their bodies just like a plain def's do, so the method must set the nest
    prefix (for capture + qualified registration) and drain the queue after its
    epilogue — otherwise the shells stay forward-declared and never link
    (feature-nilpy-nested-defs-in-methods). }
  savedNest := PyPendNestCount;
  savedLam := PyPendLamCount;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  EmitAggregateDestStash(procIdx);
  PyEmitParamSpills(procIdx, nparams);
  PyInitVariantLocals(Procs[procIdx].ScopeBase);
  { Managed locals must start nil, exactly as in the Pascal routine body — a
    NilPy string local is a MANAGED AnsiString now, and without this the first
    assignment released stale stack bytes (`decq -0x10(%rax)` on garbage). }
  EmitManagedLocalsZeroInit(Procs[procIdx].ScopeBase);
  bodyNode := PyParseBlock; Expect(tkDedent, 'dedent');
  pbInit := -1;
  for i := 0 to nparams - 1 do
    if (i < MAX_PROC_PARAMS) and (pbLocal[i] >= 0) then
    begin
      pbAsgn := AllocNode(AN_ASSIGN);
      ASTLeft[pbAsgn] := PyMakeIdent(pbLocal[i]);
      ASTRight[pbAsgn] := PyMakeIdent(Procs[procIdx].Params[i].SymIdx);
      pbInit := PySeqAppend(pbInit, pbAsgn);
    end;
  if pbInit >= 0 then bodyNode := PySeqAppend(pbInit, bodyNode);
  if cellInit >= 0 then bodyNode := PySeqAppend(cellInit, bodyNode);
  if isGenDef then
  begin
    { the same state-machine transform the def path runs — see PyParseDef }
    if not CurGenSeenYield then
      Error('Nil Python: internal — a method marked generator has no yield');
    SLCheckEligible(bodyNode);
    AssignStacklessSlots(procIdx);
    bodyNode := BuildStacklessStep(bodyNode, procIdx);
    ProcGenInstSize[procIdx] := SL_OFF_SLOTS + 8 * CurGenSlotNext;
  end
  else
    bodyNode := PyPrependResultZero(procIdx, bodyNode);
  { A CONSTRUCTOR applies the class attributes first — see PyClassAttrInitSeq.
    Prepended to the body so `__init__`'s own writes win, as in Python. }
  if isCtor and (nparams > 0) then
  begin
    clsAttrSeq := PyClassAttrInitSeq(ci, Procs[procIdx].Params[0].SymIdx);
    if clsAttrSeq >= 0 then bodyNode := PySeqAppend(clsAttrSeq, bodyNode);
  end;
  CompileAST(bodyNode); EmitProcEpilog(Procs[procIdx].RetSymIdx); PatchProcPrologue(patchPos, FrameSize);
    ProcBodyEnd[procIdx] := CodeLen;   { DWARF -g — see PyParseDef's note }
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  if DebugInfo and ProcDbgMain[procIdx] then DbgCaptureProcLocals(procIdx);
  SymRollbackTo(savedSC); FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
  { Whatever the BODY left queued names this method's locals, which the
    rollback above has just discarded. The queue is global, so the residue was
    flushed into the next statement — at module level that is the import-time
    body, which then referenced a symbol that no longer existed. A body's own
    hoists are flushed by its statement loop; the rest is stale by
    construction. Same rule as PyParseDef. }
  PyHoistHead := savedHoist;
  CurProcIsGenerator := savedGenerator;
  CurProcIsStackless := savedGenStackless;
  CurGenSeenYield    := savedGenSeen;
  CurGenElemIsVariant := savedGenIsVariant;
  CurGenStateCtr     := savedGenStateCtr;
  CurGenSlotNext     := savedGenSlotNext;
  CurGenScopeBase    := savedGenScopeBase;
  CurGenElemOff      := savedGenElemOff;
  PyNestPrefix := savedPfx;
  { drain the nested-def bodies this method queued — each re-enters PyParseDef at
    its own `def` token under the qualifier it registered with. }
  while PyPendNestCount > savedNest do
  begin
    Dec(PyPendNestCount);
    savedTok := TokPos;
    savedPfx2 := PyNestPrefix;
    { ...and the CLASS `self` stands for. This drain runs after the enclosing
      method's epilogue has already restored CurSelfClass, so without carrying
      it a nested def's `self.<field>` had no class to resolve against and its
      RETURN TYPE came out wrong — silently, and only for `self`: the same
      nested def capturing a method LOCAL or PARAM was correct
      (bug-nilpy-nested-def-capturing-self-called-from-a-sibling-returns-nothing). }
    savedSelf2 := CurSelfClass;
    PyNestPrefix := PyPendNestPfx[PyPendNestCount];
    CurSelfClass := PyPendNestSelf[PyPendNestCount];
    TokPos := PyPendNestTok[PyPendNestCount];
    Next;
    PyParseDef;
    CurSelfClass := savedSelf2;
    PyNestPrefix := savedPfx2;
    TokPos := savedTok - 1;
    Next;
  end;
  PyDrainPendingLambdas(savedLam);
  PyDefGlobalCount := savedDefGlobalCount;
  for dgI := 0 to savedDefGlobalCount - 1 do PyDefGlobalName[dgI] := savedDefGlobals[dgI];
end;

{ Emit the synthesized @dataclass ctor body: spill params, then
  self.field_i := param_i for every field, via the ordinary AST path. }
{ An AST node for type tk's zero value, or -1 if tk isn't one of the plain
  scalar kinds this covers (see PyPrependResultZero). }
function PyZeroLitFor(tk: TTypeKind): Integer;
var node: Integer;
begin
  case tk of
    tyInteger, tyInt8, tyUInt8, tyInt16, tyUInt16, tyInt32, tyUInt32,
    tyInt64, tyUInt64, tyNativeInt, tyNativeUInt:
      begin
        node := AllocNode(AN_INT_LIT);
        ASTIVal[node] := 0;
        ASTTk[node] := Ord(tk);
        Result := node;
      end;
    tyBoolean:
      begin
        node := AllocNode(AN_BOOL_LIT);
        ASTIVal[node] := 0;
        ASTTk[node] := Ord(tyBoolean);
        Result := node;
      end;
    tySingle, tyDouble:
      begin
        node := AllocNode(AN_FLOAT_LIT);
        ASTIVal[node] := 0;
        ASTTk[node] := Ord(tk);
        Result := node;
      end;
  else
    Result := -1;
  end;
end;

{ Zero (or otherwise deterministically init) a Result slot at body entry.

  A method's Result is allocated by the class-member pre-pass, where CurProc is
  not yet set, so AllocVar marks it skGlobal -- and IR_ZERO_SYM's codegen only
  zeroes skLocal. The slot therefore kept stale stack bytes, and the first
  `Result := <str>` released that garbage as if it were a string handle:
  `decq -0x10(%rax)` on a wild pointer. It only reproduced when the frame
  happened to hold something non-zero there, which is why a class needed a
  constructor before `-> str` crashed (bug-nilpy-method-returning-str-garbage).

  Emitting an ordinary AN_VAR_DECL at the head of the body reuses the normal
  local zero-init path for the managed kinds (AnsiString/Variant).

  A plain SCALAR Result (Integer/Boolean/Float) that falls off the end with no
  explicit return used to be left alone here on the theory that reading stale
  stack bytes was "harmless" — measured (not assumed) to be false: it is
  genuine uninitialized-read undefined behaviour, and an unrelated later
  change (a sibling proc using more registers before this one runs) turned a
  reliably-looking `0` into an arbitrary garbage integer with no visible cause
  (bug-nilpy-implicit-return-is-0-and-math-floor-returns-a-float). An explicit
  `Result := 0`-shaped assignment closes exactly that gap, prepended the same
  way the managed-kind AN_VAR_DECL is. }
function PyPrependResultZero(procIdx, bodyNode: Integer): Integer;
var rs, declNode, seqNode, rtk, zeroNode, assignNode: Integer;
begin
  PyPrependResultZero := bodyNode;
  rs := Procs[procIdx].RetSymIdx;
  if rs < 0 then Exit;
  rtk := Ord(Syms[rs].TypeKind);
  if (rtk = Ord(tyAnsiString)) or (rtk = Ord(tyVariant)) then
  begin
    Syms[rs].Kind := skLocal;      { it IS a frame slot; the pre-pass mislabelled it }
    declNode := AllocNode(AN_VAR_DECL);
    ASTIVal[declNode] := rs;
    ASTLeft[declNode] := -1;
    seqNode := AllocNode(AN_SEQ);
    ASTLeft[seqNode] := declNode;
    ASTRight[seqNode] := AllocNode(AN_SEQ);
    ASTLeft[ASTRight[seqNode]] := bodyNode;
    PyPrependResultZero := seqNode;
    Exit;
  end;
  zeroNode := PyZeroLitFor(Syms[rs].TypeKind);
  if zeroNode < 0 then Exit;
  Syms[rs].Kind := skLocal;
  assignNode := AllocNode(AN_ASSIGN);
  ASTLeft[assignNode] := PyMakeIdent(rs);
  ASTRight[assignNode] := zeroNode;
  seqNode := AllocNode(AN_SEQ);
  ASTLeft[seqNode] := assignNode;
  ASTRight[seqNode] := AllocNode(AN_SEQ);
  ASTLeft[ASTRight[seqNode]] := bodyNode;
  PyPrependResultZero := seqNode;
end;

procedure PyEmitDataclassCtor(ci: Integer);
var fullName, name: AnsiString;
    procIdx, i, k, idx, nparams, savedSC, savedFS, savedSelf, patchPos: Integer;
    selfNode, fieldNode, paramNode, assignNode, seqHead: Integer;
begin
  fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
  AppendChar(fullName, '.');
  name := 'create';
  for k := 1 to Length(name) do AppendChar(fullName, name[k]);
  procIdx := FindProc(fullName);
  if procIdx < 0 then Error('Nil Python: internal: dataclass ctor not registered');
  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  nparams := Procs[procIdx].ParamCount;
  for i := 0 to nparams - 1 do
  begin
    if i = 0 then name := 'self'
    else name := PyRawName(UFldNOff[UClsFBase[ci] + i - 1],
                           UFldNLen[UClsFBase[ci] + i - 1]);
    idx := AllocParam(name, Procs[procIdx].Params[i].TypeKind, False, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    if i = 0 then Syms[idx].RecName := REC_UCLASS_BASE + ci
    else if Procs[procIdx].Params[i].TypeKind = tyClass then
      Syms[idx].RecName := UFldRec_[UClsFBase[ci] + i - 1];
    SymSyncTypeRef(idx);
  end;
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  PyEmitParamSpills(procIdx, nparams);
  seqHead := -1;
  for i := 1 to nparams - 1 do
  begin
    k := UClsFBase[ci] + i - 1;
    selfNode := AllocNode(AN_IDENT);
    ASTIVal[selfNode] := Procs[procIdx].Params[0].SymIdx;
    ASTTk[selfNode] := Ord(tyClass);
    fieldNode := AllocNode(AN_FIELD);
    ASTLeft[fieldNode] := selfNode;
    ASTSOffset[fieldNode] := UFldNOff[k];
    ASTSLen[fieldNode] := UFldNLen[k];
    ASTTk[fieldNode] := UFldTk[k];
    paramNode := PyMakeIdent(Procs[procIdx].Params[i].SymIdx);
    assignNode := AllocNode(AN_ASSIGN);
    ASTLeft[assignNode] := fieldNode;
    ASTRight[assignNode] := paramNode;
    seqHead := PySeqAppend(seqHead, assignNode);
  end;
  CompileAST(seqHead);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
    ProcBodyEnd[procIdx] := CodeLen;   { DWARF -g — see PyParseDef's note }
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  if DebugInfo and ProcDbgMain[procIdx] then DbgCaptureProcLocals(procIdx);
  SymRollbackTo(savedSC); FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
end;

{ A class whose `__iter__` is a GENERATOR gets an extra, compiler-generated
  method: `__pxx_gen_iter__(self): TPyIter`, which allocates the generator
  instance, seeds `self` into its first slot, and wraps both in a cursor. One
  statement, and it is what makes such an object ITERABLE at run time —
  `for v in obj`, `list(obj)`, `iter(obj)`.

  Why a SEPARATE name rather than replacing `__iter__`: `__iter__` is the hook
  the runtime calls, and a generator method is a state-machine STEP function
  whose ABI is `(instance, self) -> Boolean`. The runtime cannot call that, and
  is safe by construction not to try (PyUserObjNoArgDunder requires arity 1), so
  before this the object simply was not iterable and said so plainly. Mangling
  `__iter__` out of the way and synthesizing a replacement under that name would
  work too, and was tried first — but the generated method then inherits the
  virtual SLOT of the base class's `__iter__`, whose override numbering is keyed
  on the SOURCE token, and the two would disagree for a subclass. An added name
  is purely additive: it takes a fresh slot, `FindUMeth` walks parents for it
  exactly as for any other method, and every existing route to a generator
  method keeps working untouched.

  Non-virtual deliberately. It is registered AFTER the class body is parsed
  (the instance size is only final once the generator's own body has been
  transformed), so claiming a VMT slot here would renumber a layout that
  subclasses processed earlier already committed to. The runtime finds it by
  name on the instance's DYNAMIC class, which is what dispatch needed anyway. }
procedure PyEmitGeneratorIterCursor(ci: Integer);
var mmi, genPi, procIdx, iterPi, idx, k: Integer;
    savedSC, savedFS, savedSelf, patchPos: Integer;
    gIdx, seq, allocCall, instLit, stepNode, a0, a1, callNode: Integer;
    pnames: array[0..1] of AnsiString; ptypes: array[0..1] of TTypeKind;
    fullName, nm: AnsiString;
begin
  { the class's OWN window, not FindUMeth: an INHERITED generator `__iter__` is
    already served by the base's cursor method, and generating a second one here
    would allocate a fresh instance seeded with the wrong receiver type }
  genPi := -1;
  for k := 0 to UClsMCount[ci] - 1 do
  begin
    mmi := UClsMBase[ci] + k;
    if PyRawName(UMthNOff[mmi], UMthNLen[mmi]) = '__iter__' then
    begin
      genPi := UMthProc_[mmi];
      Break;
    end;
  end;
  if genPi < 0 then Exit;
  if (not ProcIsStackless[genPi]) or (not ProcIsGenerator[genPi]) then Exit;
  iterPi := FindProc('pygen_iter_new');
  if iterPi < 0 then Exit;
  if (FindProc('SlNew') < 0) or (FindProc('SlSet') < 0) then Exit;

  nm := '__pxx_gen_iter__';
  fullName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
  AppendChar(fullName, '.');
  for k := 1 to Length(nm) do AppendChar(fullName, nm[k]);
  pnames[0] := 'self'; ptypes[0] := tyClass;
  procIdx := RegisterProc(fullName, True, Procs[iterPi].RetType, 1, pnames, ptypes);
  ProcRetRecId[procIdx] := ProcRetRecId[iterPi];
  ProcParamRecId[procIdx * MAX_PROC_PARAMS] := REC_UCLASS_BASE + ci;
  AddUMeth(ci, PyStoredName(nm), Length(nm), procIdx);
  UMthVirSlot[UMthCount - 1] := -1;

  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  idx := AllocParam('self', tyClass, False, False);
  Procs[procIdx].Params[0].SymIdx := idx;
  Syms[idx].RecName := REC_UCLASS_BASE + ci;
  SymSyncTypeRef(idx);
  idx := AllocVar('$pyresult', Procs[procIdx].RetType);
  Procs[procIdx].RetSymIdx := idx;
  Syms[idx].Kind := skLocal;
  Syms[idx].RecName := ProcRetRecId[iterPi];
  SymSyncTypeRef(idx);
  gIdx := AllocVar('', tyPointer);
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  PyEmitParamSpills(procIdx, 1);

  instLit := GenMakeIntLit(ProcGenInstSize[genPi]);
  allocCall := GenMakeCall6(FindProc('SlNew'), tyPointer, instLit, -1, -1, -1, -1, -1);
  seq := PySeqAppend(-1, PyMakeAssignNode(GenMakeIdent(gIdx, tyPointer), allocCall));
  { `self` is the generator's first DECLARED parameter, so it is slot 0 — the
    numbering the state-machine transform assigns and the for-in desugar uses. }
  seq := PySeqAppend(seq, GenMakeCall6(FindProc('SlSet'), tyInt64,
           GenMakeIdent(gIdx, tyPointer), GenMakeIntLit(SL_OFF_SLOTS),
           PyMakeIdent(Procs[procIdx].Params[0].SymIdx), -1, -1, -1));
  stepNode := AllocNode(AN_PROCADDR);
  ASTIVal[stepNode] := genPi;
  ASTTk[stepNode] := Ord(tyPointer);
  a1 := AllocNode(AN_ARG); ASTLeft[a1] := stepNode; ASTRight[a1] := -1;
  a0 := AllocNode(AN_ARG); ASTLeft[a0] := GenMakeIdent(gIdx, tyPointer); ASTRight[a0] := a1;
  callNode := AllocNode(AN_CALL);
  ASTIVal[callNode] := iterPi;
  ASTTk[callNode] := Ord(Procs[iterPi].RetType);
  ASTLeft[callNode] := a0;
  if Procs[iterPi].RetType = tyClass then ASTRight[callNode] := ProcRetRecId[iterPi];
  seq := PySeqAppend(seq,
           PyMakeAssignNode(PyMakeIdent(Procs[procIdx].RetSymIdx), callNode));

  CompileAST(seq);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
  ProcBodyEnd[procIdx] := CodeLen;
  SymRollbackTo(savedSC);
  FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
end;

procedure PyEmitDataclassEq(ci: Integer);
{ Emit the synthesized @dataclass `__eq__`: `Result := (self.f1 = other.f1) and
  ... ` over every declared field, in declaration order — what CPython's
  decorator generates. Registered next to the ctor in PyRegisterClassMembers;
  this emits the body once the field window is final.

  A CLASS-typed field whose own class declares `__eq__` dispatches to it, so a
  nested dataclass compares by value the way CPython does rather than by
  handle. Every other field kind compares with the ordinary `=`, which is what
  the parser builds for the same operand types.
  bug-nilpy-dataclass-no-generated-eq }
var procIdx, i, k, idx, savedSC, savedFS, savedSelf, patchPos: Integer;
    selfNode, otherNode, lhs, rhs, cmp, acc, retNode, fci: Integer;
    fieldTk: TTypeKind;
    name: AnsiString;
begin
  procIdx := PyDcEqProc[ci];
  if procIdx < 0 then Exit;
  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  for i := 0 to 1 do
  begin
    if i = 0 then name := 'self' else name := 'other';
    idx := AllocParam(name, tyClass, False, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    Syms[idx].RecName := REC_UCLASS_BASE + ci;
    SymSyncTypeRef(idx);
  end;
  idx := AllocVar('$pyresult', tyBoolean);
  Procs[procIdx].RetSymIdx := idx;
  Syms[idx].Kind := skLocal;
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  PyEmitParamSpills(procIdx, 2);
  acc := -1;
  for i := 0 to UClsFCount[ci] - 1 do
  begin
    k := UClsFBase[ci] + i;
    fieldTk := IntToTypeKind(UFldTk[k]);
    selfNode := PyMakeIdent(Procs[procIdx].Params[0].SymIdx);
    otherNode := PyMakeIdent(Procs[procIdx].Params[1].SymIdx);
    lhs := AllocNode(AN_FIELD);
    ASTLeft[lhs] := selfNode;
    ASTSOffset[lhs] := UFldNOff[k]; ASTSLen[lhs] := UFldNLen[k];
    ASTTk[lhs] := UFldTk[k]; ASTRight[lhs] := UFldRec_[k];
    rhs := AllocNode(AN_FIELD);
    ASTLeft[rhs] := otherNode;
    ASTSOffset[rhs] := UFldNOff[k]; ASTSLen[rhs] := UFldNLen[k];
    ASTTk[rhs] := UFldTk[k]; ASTRight[rhs] := UFldRec_[k];
    cmp := -1;
    if (fieldTk = tyClass) and (UFldRec_[k] >= REC_UCLASS_BASE) then
    begin
      fci := UFldRec_[k] - REC_UCLASS_BASE;
      if (not PyRecIsPylibOwnClass(UFldRec_[k])) and
         (FindUMeth(fci, '__eq__') >= 0) then
        cmp := PyCallMeth1(fci, '__eq__', lhs, rhs);
    end;
    if cmp < 0 then
    begin
      cmp := AllocNode(AN_BINOP);
      ASTIVal[cmp] := Ord(tkEq);
      ASTLeft[cmp] := lhs; ASTRight[cmp] := rhs;
      ASTTk[cmp] := Ord(tyBoolean);
    end;
    if acc < 0 then acc := cmp
    else
    begin
      retNode := AllocNode(AN_BINOP);
      ASTIVal[retNode] := Ord(tkAnd);
      ASTLeft[retNode] := acc; ASTRight[retNode] := cmp;
      ASTTk[retNode] := Ord(tyBoolean);
      acc := retNode;
    end;
  end;
  { a field-less @dataclass compares equal to any other instance, as CPython's
    empty tuple comparison does }
  if acc < 0 then
  begin
    acc := AllocNode(AN_BOOL_LIT);
    ASTIVal[acc] := 1; ASTTk[acc] := Ord(tyBoolean);
  end;
  retNode := AllocNode(AN_ASSIGN);
  ASTLeft[retNode] := PyMakeIdent(Procs[procIdx].RetSymIdx);
  ASTRight[retNode] := acc;
  CompileAST(retNode);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
  ProcBodyEnd[procIdx] := CodeLen;
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  SymRollbackTo(savedSC); FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
end;

procedure PyEmitDataclassOrder(ci: Integer; which: Integer);
{ Emit one of the four `@dataclass(order=True)` comparisons. CPython compares
  the FIELD TUPLES, so the body is tuple ordering written as an expression:

    acc := <base>
    for i := last downto first:  acc := (a_i OP b_i) or ((a_i = b_i) and acc)

  with OP `<` for lt/le and `>` for gt/ge, and the base being what an
  all-fields-equal comparison answers — False for the strict pair, True for the
  or-equal pair. Built backwards for the same reason CPython's own tuple
  compare short-circuits forwards: the first differing field decides, and every
  later one only matters while the earlier ones are equal.

  Written as ONE expression rather than a chain of early returns because that is
  what the AST here builds cheaply, and because the shape then matches
  PyEmitDataclassEq's accumulator next door.
  bug-nilpy-dataclass-keyword-arguments-do-not-parse }
var procIdx, i, k, idx, savedSC, savedFS, savedSelf, patchPos: Integer;
    selfNode, otherNode, lhs, rhs, cmp, eqN, andN, orN, acc, retNode: Integer;
    opTok: Integer; baseTrue: Boolean;
    name: AnsiString;
begin
  procIdx := PyDcCmpProc[ci * 4 + which];
  if procIdx < 0 then Exit;
  if which < 2 then opTok := Ord(tkLt) else opTok := Ord(tkGt);
  baseTrue := (which = 1) or (which = 3);        { __le__ / __ge__ }
  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  for i := 0 to 1 do
  begin
    if i = 0 then name := 'self' else name := 'other';
    idx := AllocParam(name, tyClass, False, False);
    Procs[procIdx].Params[i].SymIdx := idx;
    Syms[idx].RecName := REC_UCLASS_BASE + ci;
    SymSyncTypeRef(idx);
  end;
  idx := AllocVar('$pyresult', tyBoolean);
  Procs[procIdx].RetSymIdx := idx;
  Syms[idx].Kind := skLocal;
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  PyEmitParamSpills(procIdx, 2);
  acc := AllocNode(AN_BOOL_LIT);
  if baseTrue then ASTIVal[acc] := 1 else ASTIVal[acc] := 0;
  ASTTk[acc] := Ord(tyBoolean);
  for i := UClsFCount[ci] - 1 downto 0 do
  begin
    k := UClsFBase[ci] + i;
    selfNode := PyMakeIdent(Procs[procIdx].Params[0].SymIdx);
    otherNode := PyMakeIdent(Procs[procIdx].Params[1].SymIdx);
    lhs := AllocNode(AN_FIELD);
    ASTLeft[lhs] := selfNode;
    ASTSOffset[lhs] := UFldNOff[k]; ASTSLen[lhs] := UFldNLen[k];
    ASTTk[lhs] := UFldTk[k]; ASTRight[lhs] := UFldRec_[k];
    rhs := AllocNode(AN_FIELD);
    ASTLeft[rhs] := otherNode;
    ASTSOffset[rhs] := UFldNOff[k]; ASTSLen[rhs] := UFldNLen[k];
    ASTTk[rhs] := UFldTk[k]; ASTRight[rhs] := UFldRec_[k];
    cmp := AllocNode(AN_BINOP);
    ASTIVal[cmp] := opTok;
    ASTLeft[cmp] := lhs; ASTRight[cmp] := rhs;
    ASTTk[cmp] := Ord(tyBoolean);
    { the equality arm needs its OWN field nodes — a node used twice is emitted
      twice, and reusing these would evaluate the field access again inside the
      other operand }
    selfNode := PyMakeIdent(Procs[procIdx].Params[0].SymIdx);
    otherNode := PyMakeIdent(Procs[procIdx].Params[1].SymIdx);
    lhs := AllocNode(AN_FIELD);
    ASTLeft[lhs] := selfNode;
    ASTSOffset[lhs] := UFldNOff[k]; ASTSLen[lhs] := UFldNLen[k];
    ASTTk[lhs] := UFldTk[k]; ASTRight[lhs] := UFldRec_[k];
    rhs := AllocNode(AN_FIELD);
    ASTLeft[rhs] := otherNode;
    ASTSOffset[rhs] := UFldNOff[k]; ASTSLen[rhs] := UFldNLen[k];
    ASTTk[rhs] := UFldTk[k]; ASTRight[rhs] := UFldRec_[k];
    eqN := AllocNode(AN_BINOP);
    ASTIVal[eqN] := Ord(tkEq);
    ASTLeft[eqN] := lhs; ASTRight[eqN] := rhs;
    ASTTk[eqN] := Ord(tyBoolean);
    andN := AllocNode(AN_BINOP);
    ASTIVal[andN] := Ord(tkAnd);
    ASTLeft[andN] := eqN; ASTRight[andN] := acc;
    ASTTk[andN] := Ord(tyBoolean);
    orN := AllocNode(AN_BINOP);
    ASTIVal[orN] := Ord(tkOr);
    ASTLeft[orN] := cmp; ASTRight[orN] := andN;
    ASTTk[orN] := Ord(tyBoolean);
    acc := orN;
  end;
  retNode := AllocNode(AN_ASSIGN);
  ASTLeft[retNode] := PyMakeIdent(Procs[procIdx].RetSymIdx);
  ASTRight[retNode] := acc;
  CompileAST(retNode);
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
  ProcBodyEnd[procIdx] := CodeLen;
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  SymRollbackTo(savedSC); FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
end;

procedure PyEmitDataclassRepr(ci: Integer);
{ Emit the synthesized @dataclass `__repr__`:
  `Result := 'P(' + 'x=' + repr(self.x) + ', ' + 'y=' + repr(self.y) + ')'`,
  in field-declaration order — what CPython's decorator generates.

  Each field goes through `pyvar_repr`, NOT `pyrepr_of`: pyrepr_of is OVERLOADED
  five ways and FindProc resolves by NAME ALONE, so it would silently pick one
  arm and hand an Int64 field to the AnsiString one
  (project_findproc_by_name_ignores_overloads). pyvar_repr has a single
  signature, and PyForceVariant boxes the field first, so one call site serves
  every field type — and it is the variant repr that knows about None, the pylib
  containers and nested USER objects, so a dataclass holding a dataclass prints
  the way CPython prints it rather than as a handle.

  repr, not str, for the FIELDS — `P(name='x')` keeps the quotes. That falls out
  of using pyvar_repr and is the distinction the test pins.
  bug-nilpy-dataclass-no-generated-repr }
var procIdx, i, k, idx, savedSC, savedFS, savedSelf, patchPos: Integer;
    selfNode, fld, callN, argN, acc, retNode: Integer;
    clsName, sep: AnsiString;
begin
  procIdx := PyDcReprProc[ci];
  if procIdx < 0 then Exit;
  clsName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
  savedSC := SymCount; savedFS := FrameSize; savedSelf := CurSelfClass;
  FrameSize := 0; CurProc := procIdx; CurSelfClass := REC_UCLASS_BASE + ci;
  Procs[procIdx].ScopeBase := SymCount;
  idx := AllocParam('self', tyClass, False, False);
  Procs[procIdx].Params[0].SymIdx := idx;
  Syms[idx].RecName := REC_UCLASS_BASE + ci;
  SymSyncTypeRef(idx);
  { tyAnsiString, not tyString: the result is a MANAGED refcounted handle, and
    the frozen inline-length kind cannot hold a concatenation. }
  idx := AllocVar('$pyresult', tyAnsiString);
  Procs[procIdx].RetSymIdx := idx;
  Syms[idx].Kind := skLocal;
  Procs[procIdx].BodyAddr := CodeLen;
  patchPos := EmitProcPrologue; Procs[procIdx].FramePatch := patchPos;
  PyEmitParamSpills(procIdx, 1);
  acc := PyExcFoldLit(clsName + '(');
  for i := 0 to UClsFCount[ci] - 1 do
  begin
    k := UClsFBase[ci] + i;
    if i = 0 then sep := '' else sep := ', ';
    acc := PyExcFoldCat(acc,
             PyExcFoldLit(sep + PyRawName(UFldNOff[k], UFldNLen[k]) + '='));
    selfNode := PyMakeIdent(Procs[procIdx].Params[0].SymIdx);
    fld := AllocNode(AN_FIELD);
    ASTLeft[fld] := selfNode;
    ASTSOffset[fld] := UFldNOff[k]; ASTSLen[fld] := UFldNLen[k];
    ASTTk[fld] := UFldTk[k]; ASTRight[fld] := UFldRec_[k];
    argN := AllocNode(AN_ARG);
    ASTLeft[argN] := PyForceVariant(fld);
    ASTRight[argN] := -1;
    callN := AllocNode(AN_CALL);
    ASTIVal[callN] := FindProc('pyvar_repr');
    if ASTIVal[callN] < 0 then Error('Nil Python: pylib (pyvar_repr) not loaded');
    ASTTk[callN] := Ord(tyAnsiString);
    ASTLeft[callN] := argN;
    acc := PyExcFoldCat(acc, callN);
  end;
  acc := PyExcFoldCat(acc, PyExcFoldLit(')'));
  retNode := AllocNode(AN_ASSIGN);
  ASTLeft[retNode] := PyMakeIdent(Procs[procIdx].RetSymIdx);
  ASTRight[retNode] := acc;
  { The result slot MUST be zeroed before the first assignment: a managed
    AnsiString handle full of stale stack bytes gets RELEASED as if it were a
    live string. Reusing PyPrependResultZero rather than open-coding it is the
    point of that helper — bug-nilpy-method-returning-str-garbage is the same
    fault, found the hard way once already. }
  CompileAST(PyPrependResultZero(procIdx, retNode));
  EmitProcEpilog(Procs[procIdx].RetSymIdx);
  PatchProcPrologue(patchPos, FrameSize);
  ProcBodyEnd[procIdx] := CodeLen;
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  SymRollbackTo(savedSC); FrameSize := savedFS; CurProc := -1; CurSelfClass := savedSelf;
end;

{ FIELD pre-pass. PyRegisterClassShells registers class NAMES only, and
  PyCollectModuleLocals runs before the main loop that parses class bodies — so
  without this every class has zero fields during module-local inference and a
  module-level `x = o.inner` cannot learn the field's class
  (bug-nilpy-class-typed-field-loses-identity).

  Walks the raw token stream for `class NAME ...:` headers, locates each body
  the same way PyParseClass does (the tkIndent after the header, then
  PyFindBodyEnd) and registers that class's FIELDS via the shared
  PyRegisterClassMembers in fieldsOnly mode — so the field rules live in one
  place. isDC is read off a preceding @dataclass decorator.

  The real pass later resets each class's field window and rebuilds it, so
  these entries are orphaned rather than duplicated. }
procedure PyRegisterClassFieldsPrepass;
var i, j, k, ci, bs, be, depth, baseCi: Integer;
    isDC, hoist, multiBase: Boolean;
begin
  { FIRST: which classes are named as a SECOND base anywhere? They are flattened
    into their host and not compiled standalone (see PyClsUsedAsMixin), and both
    this pass and PyParseClass have to know it before they register anything. }
  i := PyScanLo;
  while i < MainProgramTokCount - 2 do
  begin
    if (Tokens[i].Kind = tkClass) and (Tokens[i + 1].Kind = tkIdent) and
       (Tokens[i + 2].Kind = tkLParen) then
    begin
      j := i + 2; depth := 0;
      while j < MainProgramTokCount do
      begin
        if Tokens[j].Kind = tkLParen then Inc(depth)
        else if Tokens[j].Kind = tkRParen then
        begin
          Dec(depth);
          if depth = 0 then Break;
        end
        else if (depth = 1) and (Tokens[j].Kind = tkComma) and
                (Tokens[j + 1].Kind = tkIdent) then
        begin
          k := j + 1;
          { a DOTTED base names the module it came from; the class is the last
            segment, exactly as the header parse takes it }
          while (k + 2 < MainProgramTokCount) and (Tokens[k + 1].Kind = tkDot) and
                (Tokens[k + 2].Kind = tkIdent) do k := k + 2;
          baseCi := FindUClassNonRecord(GetTokenStr(k));
          if baseCi >= 0 then PyClsUsedAsMixin[baseCi] := True;
        end
        else if Tokens[j].Kind in [tkNewline, tkEOF] then Break;
        Inc(j);
      end;
    end;
    Inc(i);
  end;
  i := PyScanLo;
  while i < MainProgramTokCount - 2 do
  begin
    if (Tokens[i].Kind = tkClass) and (Tokens[i + 1].Kind = tkIdent) then
    begin
      ci := FindUClass(GetTokenStr(i + 1));
      if ci >= 0 then
      begin
        { @dataclass on the line(s) before the header }
        isDC := False;
        j := i - 1;
        while (j >= 1) and (Tokens[j].Kind in [tkNewline, tkIndent, tkDedent]) do Dec(j);
        { `@dataclass(eq=True)` puts a ')' where the bare form puts the name, so
          step back over a balanced argument list first. Without this the
          pre-pass and PyParseClass disagreed about isDC — the pre-pass would
          register the class WITHOUT its dataclass fields while the parse pass
          treated it as one, which is the two-passes-disagree hazard, not a
          missing feature. bug-nilpy-dataclass-keyword-arguments-do-not-parse }
        if (j >= 1) and (Tokens[j].Kind = tkRParen) then
        begin
          depth := 0;
          while j >= 1 do
          begin
            if Tokens[j].Kind = tkRParen then Inc(depth)
            else if Tokens[j].Kind = tkLParen then
            begin
              Dec(depth);
              if depth = 0 then begin Dec(j); Break; end;
            end;
            Dec(j);
          end;
        end;
        if (j >= 1) and (Tokens[j].Kind = tkIdent) and
           CaseEqual(GetTokenStr(j), 'dataclass') and (Tokens[j - 1].Kind = tkAt) then
        begin
          isDC := True;
          { `@dataclass(order=True)` — scan the argument list this pass just
            stepped BACK over. Recorded here rather than in
            PyParseDataclassArgs because that routine runs on the cursor before
            the class is reached and has no `ci` to record it against, while
            this pass sees every class and both passes reach
            PyRegisterClassMembers, which registers the four methods.
            bug-nilpy-dataclass-keyword-arguments-do-not-parse }
          k := j + 1;
          if (k < MainProgramTokCount) and (Tokens[k].Kind = tkLParen) then
            while (k < MainProgramTokCount) and (Tokens[k].Kind <> tkRParen) do
            begin
              if (Tokens[k].Kind = tkIdent) and CaseEqual(GetTokenStr(k), 'order') and
                 (k + 2 < MainProgramTokCount) and (Tokens[k + 1].Kind = tkAssign) and
                 (Tokens[k + 2].Kind = tkTrue) then
                PyDcOrder[ci] := True;
              Inc(k);
            end;
        end;
        { The FULL registration (methods included) needs the parent link set
          first — a subclass's field offsets and virtual slots continue the
          parent's layout. Resolve the base list here, exactly as PyParseClass
          does (including the auto-shelled Exception base). If the base cannot
          be resolved yet, fall back to fields-only and let PyParseClass do
          the full run as before. }
        hoist := True;
        multiBase := False;
        { a class that exists to be flattened registers FIELDS only — its
          methods are compiled into each host, never into itself }
        if PyClsUsedAsMixin[ci] then hoist := False;
        if Tokens[i + 2].Kind = tkLParen then
        begin
          baseCi := -1;
          if Tokens[i + 3].Kind = tkIdent then
          begin
            { NonRecord — same reason as PyParseClass's own base lookup below:
              the first row of the name may be a same-named RECORD.
              bug-nilpy-text-class-name-binds-the-rtl-file-record. }
            { `Exception` FIRST and by unit: sysutils declares a class of that
              name too now, and a flat lookup would inherit the Pascal one
              order-dependently. PyEnsureExceptionClass is the unit-scoped
              answer (with the lazy shell when pylib is absent). }
            if CaseEqual(GetTokenStr(i + 3), 'Exception') then
              baseCi := PyEnsureExceptionClass
            else
              baseCi := FindUClassNonRecord(GetTokenStr(i + 3));
          end;
          { MULTIPLE BASES — a comma at the header's own paren depth. The extra
            bases are FLATTENED, which needs each one's recorded body span, and
            spans are recorded in source order by PyParseClass. So the whole
            decision is deferred to there — rather than resolving a base list a
            second way in this pass and risking the two passes disagreeing.
            bug-nilpy-multiple-inheritance-does-not-parse

            Deferred INCLUDING the parent, which this pass used to set from the
            first base before even looking for a comma. With more than one base
            the parent is a CHOICE (an imported base can only be the parent —
            nothing here can flatten it), PyParseClass makes it, and a different
            answer here laid the fields out over the WRONG parent's size.
            bug-nilpy-multiple-inheritance-from-an-imported-base-is-refused }
          j := i + 2; depth := 0;
          while j < MainProgramTokCount do
          begin
            if Tokens[j].Kind = tkLParen then Inc(depth)
            else if Tokens[j].Kind = tkRParen then
            begin
              Dec(depth);
              if depth = 0 then Break;
            end
            else if (depth = 1) and (Tokens[j].Kind = tkComma) then
            begin
              multiBase := True;
              hoist := False;
              Break;
            end
            else if Tokens[j].Kind in [tkNewline, tkEOF] then Break;
            Inc(j);
          end;
          if not multiBase then
          begin
            if (baseCi >= 0) and not PyClsUsedAsMixin[baseCi] then
              UClsParent[ci] := baseCi
            else
              hoist := False;
          end;
        end;
        { Skip the header to the COLON that ends it, honouring a parenthesised
          base list — then decide from what FOLLOWS the colon whether there is
          an indented body at all.

          Scanning straight to the first tkIndent (what this did) is wrong for a
          ONE-LINE class body: `class G(Exception): pass` has no INDENT of its
          own, so the scan ran on to the NEXT class's indent and registered THAT
          class's members against G — `class G(Exception): pass` followed by a
          class with an `__init__` failed with "unresolved forward: G.create",
          the ctor having been attributed to the wrong class.

          Since a843c17d4 the LEXER synthesises the `NEWLINE INDENT` for a
          one-line body that has real CONTENT, so the only shape that still
          reaches here without an INDENT is a genuinely empty one (`pass`),
          which declares no members — registering none is the right answer.
          This is defensive, not a live path: `class C: x = 1` gets its INDENT
          from the lexer and its member IS registered. Do not read the check as
          evidence that a one-line body with content is unsupported; it is
          supported and matches CPython
          (bug-nilpy-one-line-class-body-restraint-is-no-longer-enforced). }
        j := i + 2;
        depth := 0;
        while j < MainProgramTokCount do
        begin
          if Tokens[j].Kind = tkLParen then Inc(depth)
          else if Tokens[j].Kind = tkRParen then Dec(depth)
          else if (Tokens[j].Kind = tkColon) and (depth = 0) then Break
          else if Tokens[j].Kind in [tkNewline, tkEOF] then Break;
          Inc(j);
        end;
        { the indented shape is COLON NEWLINE INDENT; anything else is one-line }
        if (j + 2 < MainProgramTokCount) and (Tokens[j].Kind = tkColon) and
           (Tokens[j + 1].Kind = tkNewline) and (Tokens[j + 2].Kind = tkIndent) then
        begin
          j := j + 2;
          bs := j + 1;   { first BODY token, matching PyParseClass's bodyStart
                           (it takes TokPos-1 after Expect(tkIndent)) }
          be := PyFindBodyEnd(bs);
        end
        else
        begin
          { One-line body: an EMPTY member span, not a skipped call. The pass
            does more than register members — it computes the class SIZE and
            emits the VMT — so skipping it left the class unsized and every
            construction crashed. An empty span registers nothing and still
            lays the class out. }
          bs := j + 1;
          be := bs;
        end;
        if bs < MainProgramTokCount then
        begin
          { Full members when the parent is settled: methods registered here
            let the module-collect trial parse resolve `x = obj.method()`.
            PyParseClass skips its own (second) full run via the flag — the
            append-only PyDc* default tables must be filled exactly once. }
          PyRegisterClassMembers(ci, bs, be, isDC, not hoist);
          if hoist then PyMembersHoisted[ci] := True;
        end;
      end;
    end;
    Inc(i);
  end;
end;

{ Evaluate the NON-CONSTANT parameter defaults of a class's methods.

  Methods never reach PyParseDef, which is the single place PyDefaultEvalMode is
  turned on, so `def go(self, b=[])` recorded no symbol and the call site built
  None (bug-nilpy-non-constant-parameter-defaults-silently-become-none). The
  member pre-pass cannot do it either: it runs from two places, one of them
  hoisted well before the class statement's position in the stream, so the names
  a default expression reads may not exist yet.

  Run from the statement loop AFTER PyParseClass returns, which is where the
  class body would execute in Python — that is when CPython evaluates a method
  default, and it is why the initialiser belongs here rather than at the method.

  Deliberately NOT a second header parser: the `=` is located mechanically and
  the default itself goes through PyParamDefaultAt, the same routine the member
  pre-pass uses, so the constant-vs-expression rule and the span skipping stay
  in ONE place. A second parser that disagrees with the first is the recurring
  failure mode in this frontend. }
procedure PyEvalMethodDefaults(ci, lo, hi: Integer);
var j, depth, pIdx, mmi, mpi, savedTok: Integer;
    dSOff, dSLen: Integer;
    dVal: Int64;
    dIsStr: Boolean;
    savedEval: Boolean;
    savedHdr, savedCls, mname, pname: AnsiString;
begin
  if (ci < 0) or (lo < 0) or (hi <= lo) then Exit;
  savedEval := PyDefaultEvalMode;
  savedHdr := PyHdrName;
  savedCls := PyDefaultClsName;
  savedTok := TokPos;
  PyDefaultClsName := PyRawName(UClsNOff[ci], UClsNLen[ci]);
  j := lo;
  while j < hi do
  begin
    if (Tokens[j].Kind = tkFunction) and (j + 2 < hi) and
       (Tokens[j + 1].Kind = tkIdent) and (Tokens[j + 2].Kind = tkLParen) then
    begin
      { PyMethodName, not the raw token: `__init__` is registered as `create`,
        so looking the ctor up by its Python spelling finds nothing and
        `def __init__(self, items=[])` kept the old None behaviour. }
      mname := PyMethodName(GetTokenStr(j + 1));
      mmi := FindUMeth(ci, mname);
      mpi := -1;
      if mmi >= 0 then mpi := UMthProc_[mmi];
      PyHdrName := mname;
      { parameter 0 is self, matching the index the member pre-pass records
        under and the one parser.inc / ir.inc read back }
      pIdx := 0;
      pname := '';
      depth := 0;
      j := j + 2;
      while j < hi do
      begin
        if Tokens[j].Kind = tkLParen then Inc(depth)
        else if Tokens[j].Kind = tkRParen then
        begin
          Dec(depth);
          if depth = 0 then begin Inc(j); Break; end;
        end
        else if (depth = 1) and (Tokens[j].Kind = tkComma) then
        begin
          Inc(pIdx);
          pname := '';
        end
        else if (depth = 1) and (Tokens[j].Kind = tkIdent) and (pname = '') and
                (Tokens[j - 1].Kind in [tkLParen, tkComma]) then
          pname := GetTokenStr(j)
        else if (depth = 1) and (Tokens[j].Kind = tkAssign) and (mpi >= 0) and
                (pIdx < MAX_PROC_PARAMS) then
        begin
          Inc(j);
          PyDefaultEvalMode := True;
          dVal := PyParamDefaultAt(j, pname, dIsStr, dSOff, dSLen);
          PyDefaultEvalMode := False;
          if dVal = 0 then ;   { the ordinal is the pre-pass's business, not ours }
          if PyDefaultSym >= 0 then
          begin
            ProcParamDefaultSym[mpi * MAX_PROC_PARAMS + pIdx] := PyDefaultSym;
            ProcParamDefaultGName[mpi * MAX_PROC_PARAMS + pIdx] :=
              InternStr(Syms[PyDefaultSym].Name);
            ProcParamHasDefault[mpi * MAX_PROC_PARAMS + pIdx] := True;
            { the pre-pass left this True for every non-constant default, and
              the consumers check it before the symbol on some paths }
            ProcParamDefaultIsNone[mpi * MAX_PROC_PARAMS + pIdx] := False;
          end;
          Continue;   { PyParamDefaultAt left j past the default }
        end;
        Inc(j);
      end;
      Continue;
    end;
    Inc(j);
  end;
  TokPos := savedTok;
  PyDefaultClsName := savedCls;
  PyHdrName := savedHdr;
  PyDefaultEvalMode := savedEval;
end;

{ Is the base at the cursor one of typing's ERASED bases — `Generic[T]`,
  `Protocol[T]`? NilPy erases generics, and after
  bug-n-an-uninterpretable-annotation-refuses-the-program the type parameter is
  only ever read in annotations, which degrade to Any. So the base contributes
  nothing to the layout, the method table or `super()`, and the honest
  registration is the one `class C:` gets — the same call `object` already gets
  one line below, for the same reason.

  A user class of that name WINS: these are erased because nothing here can be
  pointed at, so if something can be, point at it. That also means this only
  ever fires where the alternative was `unknown base class Generic`.
  bug-n-typevar-call-is-an-undefined-variable }
function PyBaseIsErasedTyping: Boolean;
begin
  Result := False;
  if CurTok.Kind <> tkIdent then Exit;
  if (CurTok.SVal <> 'Generic') and (CurTok.SVal <> 'Protocol') then Exit;
  Result := FindUClassNonRecord(CurTok.SVal) < 0;
end;

procedure PyParseClass(isDC: Boolean);
var ci, bodyStart, bodyEnd, baseCi, k, clsEqAt: Integer;
    realBases, baseDepth, baseQUnit, parentIx: Integer;
    baseCiList: array[0..6] of Integer;
    baseAtTok: array[0..6] of Integer;
    baseQName: AnsiString;
    mixK, sharedCi, myMixN, savedTokPos: Integer;
    myMixCi: array[0..5] of Integer;
    myMixBP: array[0..5] of Boolean;
    propName: AnsiString;
begin
  Expect(tkClass, 'class');
  { the flattened-base handshake is per class statement, and a class NESTED in
    this body reaches PyParseClass again — so the header fills the globals, and
    the two consumers below re-publish from this frame's own copy }
  PyMixN := 0;
  { This unit's own row first — the shell pre-pass now registers one per unit,
    and a flat lookup would still hand an imported module's declaration the
    PROGRAM's same-named row and merge the two. The flat fallback stays for the
    rows that pre-pass does not cover (a class NESTED in a body, and the
    compiler-minted shells). Same rule the shell test above states. }
  ci := FindUClassInUnit(CurTok.SVal, CurrentUnitIdx);
  if ci < 0 then ci := FindUClass(CurTok.SVal);
  Next;
  if CurTok.Kind = tkLParen then
  begin
    { base class: class Name(Base): — Exception is auto-registered as an
      empty shell (the try/except semantics rung is its own ticket) }
    Next;
    { A base LIST, not a single base. `class Bus(Service, Generic[T])` is
      ordinary in typed code, and the erasable entries — `object`, `Generic[T]`,
      `Protocol[T]` — must not count toward the multiple-inheritance refusal
      below: erasing them is what makes such a header single-inheritance, which
      it genuinely is. Before this the header was one base plus a hard error on
      the comma, so a `Generic[T]` in second position refused a class that names
      exactly one real parent. bug-n-typevar-call-is-an-undefined-variable }
    realBases := 0;
    repeat
    if CurTok.Kind <> tkIdent then Error('Nil Python: expected a base class name');
    { A DOTTED base — `class Cfg(configparser.ConfigParser)` — names the module
      it came from. Unit scope is flat here (an `import X` is a `uses X`, and its
      symbols resolve unqualified), so the qualifier is consumed and the LAST
      segment is the class. Without this, subclassing anything imported was
      impossible: the parser took `configparser` as the base name and reported
      it unknown. }
    { …and the qualifier is RESOLVED, not merely discarded. `class Codec(
      codecs.Codec)` — a class whose own name equals its base's, which is how
      EVERY codec module in CPython's stdlib is written — registered `Codec`
      before parsing the header, so the flat lookup below answered with the
      class being declared and made it its own parent. The compiler then span
      forever: no diagnostic, no progress, no partial binary.
      A qualified base names the module it came from, so the answer can never be
      the class being declared. ConsumeUnitQualifier handles dotted packages
      too (`a.b.C`) and leaves CurTok on the member; it consumes nothing when
      the prefix is not a loaded unit, so the plain loop below still covers a
      qualifier that is not one.
      bug-nilpy-class-named-after-its-imported-base-hangs-the-compiler }
    baseQName := CurTok.SVal;
    baseQUnit := ConsumeUnitQualifier(baseQName);
    while (TokPos < TokCount) and (Tokens[TokPos].Kind = tkDot) do
    begin
      Next;                { onto the '.' }
      Next;                { onto the segment after it }
      if CurTok.Kind <> tkIdent then
        Error('Nil Python: expected a class name after . in the base class');
      baseQUnit := -1;     { a deeper path this resolver did not follow }
    end;
    { `class C(object):` — Python 2's explicit new-style spelling, still all over
      real code (html5lib writes it). In Python 3 every class derives from
      `object` anyway, so naming it is a NO-OP: the class is registered with no
      parent, exactly as `class C:` is. Consumed here rather than resolved,
      because there is no `object` class to point at and inventing one would put
      a real base in the chain that `super()` and the method tables would then
      have to explain. }
    if (CurTok.SVal = 'object') or PyBaseIsErasedTyping then
    begin
      Next;
      { `Generic[T]` / `Protocol[T]` carry a SUBSCRIPT that is part of the base,
        not a separate construct — step over it, balanced, so the comma or `)`
        the loop below reads is the real one. }
      if CurTok.Kind = tkLBrack then
      begin
        baseDepth := 0;
        repeat
          if CurTok.Kind = tkLBrack then Inc(baseDepth)
          else if CurTok.Kind = tkRBrack then Dec(baseDepth);
          Next;
        until (baseDepth = 0) or (CurTok.Kind = tkEOF);
      end;
      { fall through to the closing paren / multiple-inheritance handling below
        with no parent set }
      baseCi := -1;
    end
    else
    begin
    { NonRecord: a base class is a CLASS position, and FindUClass answers with
      the FIRST row of the name — the RTL's `Text` RECORD sits ahead of a `Text`
      class, so `class H(Text)` inherited a record with no methods.
      bug-nilpy-text-class-name-binds-the-rtl-file-record. }
    { see the sibling site above: `Exception` resolves by UNIT, not flat. }
    if CaseEqual(CurTok.SVal, 'Exception') then
      baseCi := PyEnsureExceptionClass
    else if baseQUnit >= 0 then
    begin
      { qualified: the named MODULE's class, so a same-named class being
        declared here cannot be the answer }
      baseCi := FindUClassInUnit(CurTok.SVal, baseQUnit);
      if baseCi < 0 then baseCi := FindUClassNonRecord(CurTok.SVal);
    end
    else
      baseCi := FindUClassNonRecord(CurTok.SVal);
    { A BUILTIN type as the base — `class MethodDispatcher(dict)`. NilPy's
      containers are real classes (pylib's TPyList / TPyDict / TPyBytes), they
      are just not spelled the way Python spells them, so the user-class lookup
      above finds nothing and the whole builtin surface was refused.
      SCOPING PROBE 2026-08-18: resolving the name is the easy half; see the
      ticket for what the run-time dispatch still keys on. }
    if baseCi < 0 then baseCi := PyBuiltinBaseCi(CurTok.SVal);
    { `class S(str)` cannot work the way `class L(list)` does and should say so:
      NilPy's str is an AnsiString, a managed VALUE, not a class with a vtable,
      so there is nothing to descend from. Naming it keeps the reader out of a
      hunt for a missing registration. }
    if (baseCi < 0) and
       (CaseEqual(CurTok.SVal, 'str') or CaseEqual(CurTok.SVal, 'int') or
        CaseEqual(CurTok.SVal, 'float') or CaseEqual(CurTok.SVal, 'tuple')) then
      Error('Nil Python: ' + CurTok.SVal + ' cannot be subclassed — it is a ' +
            'value type here, not a class (list, dict, set, bytes can be)');
    if baseCi < 0 then
      Error('Nil Python: unknown base class ' + CurTok.SVal);
    { A CYCLE guard, independent of the lookup fix above: a class can never be
      its own ancestor, and a resolver that says otherwise must SAY SO rather
      than spin. A hang is the worst failure mode available — it reads as a slow
      build, so the first response is to wait longer — and this one had no
      diagnostic at all. Checked against the whole ancestor chain, not just
      self, so any future cause reports too.
      bug-nilpy-class-named-after-its-imported-base-hangs-the-compiler }
    if (baseCi = ci) or ((ci >= 0) and PyClsHasAncestor(baseCi, ci)) then
      Error('Nil Python: class ' + CurTok.SVal + ' cannot inherit from itself'
            + ' — a base class must not be the class being declared, nor one of'
            + ' its descendants');
    Inc(realBases);
    { Collected, not decided: WHICH base becomes the parent cannot be settled
      until the whole list is known (see the choice below). }
    if realBases > High(baseCiList) + 1 then
      Error('Nil Python: too many base classes');
    baseCiList[realBases - 1] := baseCi;
    baseAtTok[realBases - 1] := TokPos;
    Next;
    end;
    until not Eat(tkComma);

    { WHICH base becomes the Pascal PARENT is a CHOICE, and making it one is
      what lets the ordinary stdlib mixin idiom compile.

      Everything except the parent is FLATTENED into this class, and flattening
      REPLAYS the base's body tokens — so a base whose body is not in this file
      (imported, built-in) can only ever be the parent. Taking the first base
      unconditionally refused

          class StreamWriter(Codec, codecs.StreamWriter): pass

      which is how every one of CPython's ~100 `encodings/*.py` modules — and
      webencodings' x_user_defined.py — is written.
      bug-nilpy-multiple-inheritance-from-an-imported-base-is-refused

      It also happens to give the RIGHT resolution order. Python resolves
      attributes along the C3 linearisation, so in `class D(B, C)` B's members
      win over C's; a flattened member becomes D's OWN and therefore shadows the
      parent's. Flattening the LOCAL base and parenting the IMPORTED one is
      exactly Python's answer for the `(local mixin, imported protocol)` shape.

      Two imported bases have no answer at all here and are refused rather than
      half-taken — the second one's members would silently go missing. }
    parentIx := -1;
    for k := 0 to realBases - 1 do
      if (PyClsBodyS[baseCiList[k]] < 0) or (PyClsBodyE[baseCiList[k]] < 0) then
      begin
        if parentIx >= 0 then
        begin
          TokPos := baseAtTok[k];
          Error('Nil Python: `class ' + PyRawName(UClsNOff[ci], UClsNLen[ci]) +
                '` names TWO base classes whose bodies are not in this file. ' +
                'Only one of them can become the parent; every other base is ' +
                'flattened into this class, and flattening replays the base''s ' +
                'own body, which an imported or built-in class does not have ' +
                'here. Restructure to one imported base plus local mixins');
        end;
        parentIx := k;
      end;
    if parentIx < 0 then
      { every base is flattenable — keep the historical choice: the FIRST base
        is the parent, unless it is flattened somewhere else in the program, in
        which case it is flattened HERE too. A class is one thing or the other
        program-wide: its body is compiled into its hosts, so a host that made
        it a parent instead would inherit a class with no method bodies.
        bug-nilpy-multiple-inheritance-does-not-parse }
      if (realBases >= 1) and not PyClsUsedAsMixin[baseCiList[0]] then
        parentIx := 0;
    if parentIx >= 0 then UClsParent[ci] := baseCiList[parentIx];
    for k := 0 to realBases - 1 do
      if k <> parentIx then
      begin
        { a base that is not the parent is FLATTENED into this class.
          See PyClsHasAncestor's block comment. }
        if PyMixN > High(PyMixCi) then
          Error('Nil Python: too many base classes');
        { `super()` inside a body that is going to be FLATTENED cannot be
          honoured. CPython routes it along the MRO — from a mixin it reaches the
          NEXT class in the derived class's linearisation, which is often not the
          mixin's own parent at all — and a flattened body's `super()` can only
          mean the derived class's single parent. Silence here is a wrong call at
          run time, so it is refused. }
        if PyMixBodyUsesSuper(baseCiList[k]) then
        begin
          TokPos := baseAtTok[k];
          Error('Nil Python: base class ' +
                PyRawName(UClsNOff[baseCiList[k]], UClsNLen[baseCiList[k]]) +
                ' calls `super()` and is flattened into `class ' +
                PyRawName(UClsNOff[ci], UClsNLen[ci]) +
                '`. Python resolves that call along the derived class''s MRO, ' +
                'which a flattened body cannot see — it would silently reach ' +
                'this class''s own parent instead. Name the intended class''s ' +
                'method explicitly, or restructure to single inheritance');
        end;
        PyMixCi[PyMixN] := baseCiList[k];
        PyMixBeforeParent[PyMixN] := (parentIx >= 0) and (k < parentIx);
        Inc(PyMixN);
      end;
    { MULTIPLE INHERITANCE — `class D(B, C):`. Refused BY NAME rather than
      accepted-and-ignored: Python resolves attributes by C3 linearisation, so
      `D().who()` must give B's, and with a diamond the order is D, B, C, A.
      The Pascal object model underneath is single-inheritance, so a second base
      cannot be a real parent; taking it and dropping it would turn a compile
      error into the WRONG METHOD being called at run time, which is the one
      outcome worse than not supporting it
      (bug-nilpy-multiple-inheritance-does-not-parse — option 3 there, explicitly
      worth doing regardless of which of the real implementations is chosen
      later).

      The message replaces a bare "unexpected token" pointing at the comma,
      which read like a parser bug rather than a missing feature. }
    { THE DIAMOND is refused. Two bases sharing an ancestor get ONE copy of it
      under C3 and TWO under flattening, after which the two copies' state
      diverges — a silently wrong answer, which is the one outcome worse than
      not supporting the shape. Named explicitly so the reader can see which
      ancestor is shared. }
    for mixK := 0 to PyMixN - 1 do
    begin
      sharedCi := PySharedAncestor(UClsParent[ci], PyMixCi[mixK]);
      for k := 0 to mixK - 1 do
        if sharedCi < 0 then
          sharedCi := PySharedAncestor(PyMixCi[k], PyMixCi[mixK]);
      if sharedCi >= 0 then
        Error('Nil Python: `class ' + PyRawName(UClsNOff[ci], UClsNLen[ci]) +
              '` is a DIAMOND — two of its bases share the ancestor `' +
              PyRawName(UClsNOff[sharedCi], UClsNLen[sharedCi]) +
              '`. Multiple inheritance here flattens the extra bases into the ' +
              'derived class, which would give that ancestor two copies where ' +
              'Python''s C3 order gives one, and the two copies'' state would ' +
              'then diverge. Refused rather than answered wrongly: give the ' +
              'bases disjoint ancestries, or compose');
    end;
    Expect(tkRParen, ')');
  end;
  Expect(tkColon, ':');
  { ONE-LINE class body — `class C: pass`, `class E(Exception): pass`. The
    idiomatic empty placeholder, and it is everywhere in stubs, exception
    hierarchies and protocol classes; it used to be a hard compile error
    ("unexpected token") because the header required `: NEWLINE INDENT`
    (bug-nilpy-one-line-def-and-class-bodies-do-not-parse).

    UNREACHABLE for a real one-line body since a843c17d4: the LEXER now
    synthesises `NEWLINE INDENT … DEDENT` after a `def`/`class` header colon
    whenever real code follows on the same line (pylexer.inc), so CurTok is
    always tkNewline here and control takes the ordinary indented path below —
    which handles a one-line body with CONTENT correctly. `class C: x = 1`
    compiles and matches CPython; test_nilpy_one_line_class_body.npy pins it.

    This branch is kept as a defensive fallback, not deleted: its empty member
    span is what keeps a class SIZED and its VMT emitted (see the note below),
    and a0cf42cb6 records that skipping the call outright crashed every
    construction.

    An earlier version of this comment said only `pass` was accepted
    "deliberately", and that the one-line DEF half of the ticket was still open
    because two indent-keyed scanners would harvest a one-line def's locals as
    module globals. Both statements are false: the def half shipped 2026-08-03
    and the harvest was MEASURED not to happen. Leaving them here cost one
    session a 200-line patch plan against already-correct code
    (bug-nilpy-one-line-class-body-restraint-is-no-longer-enforced). }
  if CurTok.Kind <> tkNewline then
  begin
    { Not a user-facing restriction — see above; the lexer makes this
      unreachable for `def`/`class`. Kept as an assertion so a future narrowing
      of the lexer rule reports itself here instead of silently mis-attributing
      a body. }
    if not PyIsIdent('pass') then
      Error('Nil Python: internal — a one-line class body reached the parser '
            + 'without the lexer''s synthesised INDENT. Put the body on its own '
            + 'indented line, and please report this: the lexer normalises this '
            + 'shape and nothing should get here');
    Next;
    { An EMPTY member span rather than no call at all: PyRegisterClassMembers
      also computes the class SIZE and emits its VMT, so skipping it leaves the
      class unsized and every construction crashes. }
    PyClsEvalCi := -1;   { a one-line body declares no methods to evaluate }
    bodyStart := TokPos - 1;
    if not PyMembersHoisted[ci] then
      PyRegisterClassMembers(ci, bodyStart, bodyStart, isDC, False);
    if CurTok.Kind = tkNewline then Next;
    PySkipNewlines;
    if isDC then begin PyEmitDataclassCtor(ci); PyEmitDataclassEq(ci); PyEmitDataclassRepr(ci); PyEmitDataclassOrder(ci, 0); PyEmitDataclassOrder(ci, 1); PyEmitDataclassOrder(ci, 2); PyEmitDataclassOrder(ci, 3); end;
    PyEmitGeneratorIterCursor(ci);   { a generator __iter__ makes the object iterable }
    Exit;
  end;
  Expect(tkNewline, 'newline'); Expect(tkIndent, 'indent');
  bodyStart := TokPos - 1; bodyEnd := PyFindBodyEnd(bodyStart);
  { Record the span so a LATER class naming this one as a second base can
    replay it — nothing is copied, the tokens stay where they were lexed. }
  PyClsBodyS[ci] := bodyStart; PyClsBodyE[ci] := bodyEnd;
  myMixN := PyMixN;
  for k := 0 to PyMixN - 1 do
  begin myMixCi[k] := PyMixCi[k]; myMixBP[k] := PyMixBeforeParent[k]; end;
  { A class that exists to be FLATTENED is not compiled here: its methods are
    compiled once per host, against the host's layout, which is the only place
    the members it reads but does not declare exist. Fields are registered so
    the class is sized and named; the body tokens are stepped over. }
  if PyClsUsedAsMixin[ci] then
  begin
    PyClsEvalCi := -1;
    if not PyMembersHoisted[ci] then
      PyRegisterClassMembers(ci, bodyStart, bodyEnd, isDC, True);
    TokPos := bodyEnd; Next;
    Expect(tkDedent, 'dedent');
    PySkipNewlines;
    Exit;
  end;
  { hand the span to the statement loop, which evaluates this class's METHOD
    parameter defaults once we return — see PyEvalMethodDefaults }
  PyClsEvalCi := ci; PyClsEvalLo := bodyStart; PyClsEvalHi := bodyEnd;
  { The member pre-pass may have already done the FULL registration (methods
    + fields + PyDc* defaults) so the module-collect trial parse could resolve
    method calls; re-running it would duplicate the append-only defaults and
    re-register every method proc. }
  if not PyMembersHoisted[ci] then
    PyRegisterClassMembers(ci, bodyStart, bodyEnd, isDC, False);
  if isDC and (ci < PY_MAX_DC_FIELDS) then PyDcClassIsDc[ci] := True;
  PySkipNewlines;
  { The body loop, run once for this class's own body and then once per
    flattened base — replaying the base's tokens with ci = THIS class, so every
    method compiles with `self` = the derived object. bug-nilpy-multiple-
    inheritance-does-not-parse }
  mixK := 0;
  while True do
  begin
  while CurTok.Kind <> tkDedent do
  begin
    if PyMixReplay and (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
       (Tokens[TokPos].Kind in [tkAssign, tkColon]) and
       PyMixSkipHas(CurTok.SVal) then
    begin
      { a class ATTRIBUTE this base loses to the derived class or an earlier
        base — the registration pass skipped it, so evaluating its initialiser
        here would write a slot that does not exist }
      while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
      PySkipNewlines;
      Continue;
    end;
    if CurTok.Kind = tkString then
    begin
      { class docstring }
      Next;
      PySkipNewlines;
    end
    else if PyIsIdent('pass') then
    begin
      { `class Foo(Exception): pass` -- a whole-body `pass` (no fields, no
        methods) fell into the unconditional PyParseMethod branch below and
        errored "expected def"; every OTHER `pass` site in the grammar already
        has its own skip (see the statement-level one a few hundred lines up).
        bug-nilpy-class-with-pass-body-fails-to-parse }
      Next;
      PySkipNewlines;
    end
    else if isDC and (CurTok.Kind = tkIdent) then
    begin
      { A dataclass field line is already registered by the pre-pass and is
        normally just stepped over — its default is a folded constant. An
        EXPRESSION default is not: it goes through the SAME routine a plain
        class attribute's initialiser does, so it is evaluated exactly once, at
        the class statement, into the hidden global that routine creates.
        PyDcDefaultNode then reads that global at each construction.
        feature-nilpy-dataclass-expression-field-default }
      clsEqAt := PyClsAttrAssignAt;
      if (clsEqAt >= 0) and (PyDcFieldKind(ci, CurTok.SVal) = PYDC_EXPR) then
        PyEmitDcExprDefault(ci, clsEqAt)
      else
        while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
      PySkipNewlines;
    end
    else if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
            (Tokens[TokPos].Kind in [tkAssign, tkColon]) then
    begin
      { Class-attribute line, ANNOTATED or not — `n = 0`, `n: int = 0`,
        `n: ClassVar[int] = 0`, `items: List[int] = []`. The annotated forms had
        no branch at all and fell through to the method branch below, which
        reported "Expected: def"; only a @dataclass accepted them, via its own
        field branch (bug-nilpy-annotated-class-attribute-fails-to-parse).

        A LITERAL initialiser is already a folded constant from the pre-pass and
        only has to be stepped over; anything else — `mode = Inner()` — is
        evaluated HERE, at the point the class statement runs, which is where
        Python evaluates a class body too. The value goes into a hidden global
        named after the class and the attribute, and construction copies it into
        the instance field the pre-pass registered, so every instance shares the
        one object.

        A bare `n: int` with no initialiser binds nothing in Python either — it
        is an annotation — so it simply steps over. }
      clsEqAt := PyClsAttrAssignAt;
      { A LITERAL initialiser goes through the same routine now: its folded
        constant still drives construction, but the attribute's SHARED SLOT — the
        one `C.attr` names and the one an instance falls through to when the
        attribute is class-written — has to be given a value too, and there is
        exactly one place a class body's value is evaluated. }
      if clsEqAt >= 0 then PyEmitClassAttrExpr(ci, clsEqAt)
      else
      begin
        while not (CurTok.Kind in [tkNewline, tkDedent, tkEOF]) do Next;
      end;
      PySkipNewlines;
    end
    else if CurTok.Kind = tkAt then
    begin
      { @property / @<name>.setter. The accessors were name-mangled and the
        property registered by the member pre-pass, so this only has to consume
        the decorator and parse the def that follows. }
      Next;
      { `@overload` on a METHOD — dropped, header and body, exactly as at module
        level. bug-n-overload-decorator-is-refused }
      if PyEatOverloadDecorator then
      begin
        PySkipNewlines;
        if CurTok.Kind <> tkFunction then
          Error('Nil Python: @overload must precede a def');
        PySkipOverloadStubDef;
        Continue;
      end;
      if CurTok.Kind <> tkIdent then
        Error('Nil Python: unsupported decorator inside class (only @property, '
              + '@<name>.setter and @staticmethod)');
      propName := CurTok.SVal;
      Next;
      if CurTok.Kind = tkDot then
      begin
        Next;
        if (CurTok.Kind <> tkIdent) or (LowerCase(CurTok.SVal) <> 'setter') then
          Error('Nil Python: unsupported decorator inside class (only @property, '
                + '@<name>.setter and @staticmethod)');
        Next;
      end
      { @staticmethod is consumed here exactly as @property is: the member
        pre-pass already registered the method and set UMthIsStatic, so this
        only has to step over the decorator and parse the def.

        @classmethod is named in its own right rather than falling into the
        generic message, because "unsupported decorator" reads like a parser
        limitation when the real answer is that its `cls` receiver is not
        modelled yet. }
      else if LowerCase(propName) = 'classmethod' then
        Error('Nil Python: @classmethod is not supported yet — its `cls` '
              + 'receiver is not modelled, and binding it to the declaring '
              + 'class would be silently wrong in a subclass. @staticmethod works.')
      else if (LowerCase(propName) <> 'property') and
              (LowerCase(propName) <> 'staticmethod') then
        Error('Nil Python: unsupported decorator inside class (only @property, '
              + '@<name>.setter and @staticmethod)');
      PySkipNewlines;
      if CurTok.Kind <> tkFunction then
        Error('Nil Python: @property/@staticmethod must be followed by a def');
      PyParseMethod(ci);
      PySkipNewlines;
    end
    else if CurTok.Kind = tkClass then
    begin
      { A class NESTED in a class body — songformatter's render backend declares
        a small `class _BlendModes:` holding two constants, which is how a
        Python file writes an attribute namespace. Parsed as an ordinary class:
        the class namespace is flat here, so the inner one is simply registered
        under its own name and the enclosing body continues.
        (That flatness is the subject of
        decide-unit-local-names-leak-to-global-scope; a nested class SHOULD be
        scoped to its outer one, and today it is not.) }
      PyParseClass(False);
      PySkipNewlines;
    end
    else
    begin
      PyParseMethod(ci);
      PySkipNewlines;
    end;
  end;
  Expect(tkDedent, 'dedent');
    if mixK >= myMixN then Break;
    if mixK = 0 then savedTokPos := TokPos;
    PyMixN := myMixN;
    for k := 0 to myMixN - 1 do
    begin PyMixCi[k] := myMixCi[k]; PyMixBeforeParent[k] := myMixBP[k]; end;
    PyMixBuildSkip(ci, bodyStart, bodyEnd, mixK);
    PyMixReplay := True;
    TokPos := PyClsBodyS[myMixCi[mixK]];
    Next;                { CurTok := the base body's first token }
    Inc(mixK);
    PySkipNewlines;
  end;
  if myMixN > 0 then begin PyMixReplay := False; TokPos := savedTokPos - 1; Next; end;
  if isDC then begin PyEmitDataclassCtor(ci); PyEmitDataclassEq(ci); PyEmitDataclassRepr(ci); PyEmitDataclassOrder(ci, 0); PyEmitDataclassOrder(ci, 1); PyEmitDataclassOrder(ci, 2); PyEmitDataclassOrder(ci, 3); end;
    PyEmitGeneratorIterCursor(ci);   { a generator __iter__ makes the object iterable }
  { AFTER the body: the attribute slots' types are only final once every
    initialiser has been parsed (PyEmitClassAttrExpr retypes them), and the bind
    carries the kind. }
  PyEmitClsAttrBinds(ci);
end;

{ One run of `import` / `from ... import` statements, wherever they appear.
  Extracted from ParsePyProgram's leading-import loop so that an import which is
  NOT at the top of the file is handled by the SAME code. Python allows an import
  anywhere, and songformatter's convertrawtext.py puts a whole block of them
  after a try/except — those were silently IGNORED (no error, no registration),
  which surfaced much later as `undefined variable (tempfile)` at the first use.
  Silently dropping an import is the worst shape a gap can take. }
{ Consume a module path — `reportlab` or `reportlab.pdfgen` — and return the
  UNIT name it maps to: the dots become underscores, so `reportlab.lib.colors`
  is the unit `reportlab_lib_colors` (and, failing that, `mimic_reportlab_lib_
  colors`, which the resolver falls back to). A Pascal unit name cannot hold a
  dot and a package DIRECTORY would buy nothing here, so the mangling is the
  whole of it. rootName gets the first segment, which is what the
  consume-and-defer stdlib checks are about (`import os.path` is as skipped as
  `import os`). feature-nilpy-dotted-package-imports. }
{ Does the compiler PROVIDE `<dotted root>.<member>` — as a mapped call or as a
  modelled value? The question both from-import arms ask before binding a bare
  name, so the answer can never differ between the two spellings. }
function PyStdProvidesMember(const dottedRoot, member: AnsiString): Boolean;
begin
  Result := (PyStdlibCallProc(LowerCase(dottedRoot) + '.' + LowerCase(member)) <> '') or
            PyIsStdlibMemberValue(LowerCase(dottedRoot), LowerCase(member), False);
end;

{ Bind `alias` to `<dottedRoot>.<member>` for THIS module, if the compiler
  provides it. Called from both from-import arms — the consumed-only one (sys,
  os, textwrap, select) and the resolvable-unit one (random), because which arm
  a root takes is about whether it has a backing UNIT and says nothing about
  whether its members are compiler-provided. `from random import randint` proved
  that: random takes the unit arm and its members live in the same call table
  sys.exit does. }
procedure PyStdAliasRecord(const dottedRoot, member, alias: AnsiString);
begin
  if PyStdAliasCount >= 128 then Exit;
  if not PyStdProvidesMember(dottedRoot, member) then Exit;
  PyStdAliasName[PyStdAliasCount] := InternStr(LowerCase(alias));
  PyStdAliasMember[PyStdAliasCount] := InternStr(LowerCase(member));
  PyStdAliasBase[PyStdAliasCount] := InternStr(LowerCase(dottedRoot));
  PyStdAliasUnit[PyStdAliasCount] := CurrentUnitIdx;
  Inc(PyStdAliasCount);
end;

function PyConsumeDottedModule(var rootName: AnsiString): AnsiString;
var dotted: AnsiString;
begin
  rootName := CurTok.SVal;
  Result := CurTok.SVal;
  dotted := CurTok.SVal;
  Next;
  while (CurTok.Kind = tkDot) and (TokPos < TokCount) and
        (Tokens[TokPos].Kind = tkIdent) do
  begin
    Next;
    Result := Result + '_' + CurTok.SVal;
    dotted := dotted + '.' + CurTok.SVal;
    Next;
  end;
  { Hand the UNMANGLED path to the resolver, which needs it to find a package
    on disk (`mypkg/core/bus.py`). See PyDottedImport's note in defs.inc. }
  PyDottedImport := dotted;
end;

{ Module roots whose `from ROOT import a, b` is CONSUMED AND IGNORED rather than
  resolved to a unit: what they export is either a compile-time annotation with
  no run-time existence, or an ordinary pylib symbol already in scope. An
  unsupported name from one of them walls visibly at its USE site ("undefined
  variable"), which is the right failure — silently dropping the import is not.

  This list had TWO copies, one per import routine, and they had already drifted
  (`collections` was in one and not the other). One predicate, both call sites.

  `__future__` is here because in NilPy every `from __future__ import ...` is a
  genuine no-op: `annotations` asks CPython to stop EVALUATING annotations at
  run time, and NilPy never evaluates them at all — it reads them statically as
  types, which is the behaviour the import is requesting. Before this it was the
  first error in 86 of the neuzelaar corpus's 168 files, and it is line 1 of
  each, so it walled the file before anything diagnostic could be learned from
  it. }
{ Consume the leading dots of a RELATIVE import — `from .labels import LABELS`,
  `from ..pkg.mod import x`, `from . import labels`. Returns True when the
  remaining `from` target is EMPTY (the `from . import mod` spelling), so the
  caller knows the names after `import` are MODULES rather than members.

  The dots are simply skipped. NilPy's unit scope is FLAT — a dotted module path
  already becomes one underscore-joined unit name — so "the package this file is
  in" and "the units reachable from here" are the same set, and a leading dot
  adds no information to resolve. `from .labels import LABELS` therefore lands on
  exactly the unit `from labels import LABELS` does, which is the right answer
  for the single-dot case and the closest available one for `..`.

  Before this, a relative import failed with "expected a module name after from"
  — and essentially every real package uses them internally, so it walled the
  compile-the-source strategy at the first library
  (feature-nilpy-thirdparty-libraries-as-targets). webencodings is the worked
  example: `from labels import LABELS` compiles and yields all 214 entries,
  while the `.labels` spelling the package actually ships did not parse. }
{ How many leading dots a relative import has: 0 = not relative, N = `.`xN.
  Consumes them.

  This REPLACED a Boolean that answered "is this the bare `from . import x`
  form" while every caller asked it "was this a relative import?". Those are
  different questions and the call sites could not tell them apart, so
  `from .labels import LABELS` — dots, then an identifier — got False back
  AFTER the dots had already been eaten, and the caller resumed mid-statement
  with no idea a relative import had been intended. The error surfaced as
  `undefined variable (from)`, naming neither the dot nor the import.

  A lookahead that consumes on the failing path is the actual defect; the
  missing feature was downstream of it. There is no ambiguity to resolve here:
  in Python, dots after `from` mean a relative import and nothing else, so the
  count is the whole answer and the caller branches on what FOLLOWS the dots —
  `import` for the bare form, an identifier for `from .mod import X`.
  bug-n-relative-import-from-a-package-is-not-parsed }
function PyRelativeImportLevel: Integer;
begin
  Result := 0;
  while CurTok.Kind = tkDot do begin Next; Inc(Result); end;
end;

function PyImportRootHasNoBackingUnit(const root: AnsiString): Boolean;
{ The roots with NO unit and NO mimic_ shim anywhere on disk: the compiler
  either provides them directly (sys, os, textwrap, select) or they have no
  run-time existence at all (typing, dataclasses, __future__, itertools for
  now). Handing one of these to the unit resolver cannot do anything except
  produce "no unit named X", so BOTH import spellings must consume them and let
  an unsupported name wall visibly at its USE site instead.

  This is the single source of truth, and it exists because there were three
  hardcoded copies of this list — one here for `from X import a`, two inline in
  the plain `import X` path — and they had drifted apart in BOTH directions:
  `from sys import argv` / os / textwrap / select died on the resolver while
  `import sys` was fine, and symmetrically `import dataclasses` / `__future__`
  died while the from-spelling was fine. Two spellings of one concept, so the
  membership test is one function; the ONE root each path legitimately treats
  differently is named at that path, where the reason is visible.
  bug-n-from-sys-import-fails-while-import-sys-works }
begin
  Result := CaseEqual(root, 'sys') or CaseEqual(root, 'os') or
            CaseEqual(root, 'textwrap') or CaseEqual(root, 'select') or
            CaseEqual(root, 'typing') or CaseEqual(root, 'itertools') or
            CaseEqual(root, 'dataclasses') or CaseEqual(root, '__future__');
end;

function PyImportIsConsumedOnly(const root, dotted: AnsiString): Boolean;
{ `from X import a, b`. Adds `collections`: it HAS a unit (lib/rtl/collections),
  but the names it exports that we support are ordinary pylib symbols
  (Counter -> pylib's TPyCounter constructors), so consuming the from-import is
  enough and an unsupported name walls visibly at its use site.

  NOTE the two arms test DIFFERENT things, and that is the point rather than an
  inconsistency. PyImportRootHasNoBackingUnit is keyed on the ROOT because those
  roots are absent as a whole SUBTREE — there is no `typing.io` unit either, so
  every submodule is equally unresolvable and consuming the lot is right. The
  `collections` rule is about what ONE MODULE EXPORTS, which says nothing at all
  about its submodules, so it must match the full dotted path.

  Testing only the root swallowed `collections.abc` whole: `from collections.abc
  import Mapping` bound NOTHING while `import collections.abc as cabc` reached
  mimic_collections_abc perfectly well, so the shim was correct and unreachable.
  That walled 7 corpus files (html5lib's _utils, _trie/*, serializer,
  treebuilders, treewalkers) at `unknown base class Mapping`, and the contrast
  that proves it is `from xml.etree.ElementTree import Element` — which works,
  because `xml` is not on either list.
  bug-n-from-collections-abc-import-is-swallowed-by-the-collections-root-rule }
begin
  Result := PyImportRootHasNoBackingUnit(root) or
            (CaseEqual(root, 'collections') and CaseEqual(dotted, 'collections'));
end;

function PyImportRootPlainIsConsumedOnly(const root: AnsiString): Boolean;
{ Plain `import X`. Adds `random`, which also has a unit (lib/rtl/random) whose
  symbols arrive as pylib builtins anyway. `collections` is deliberately NOT
  here, unlike the from-spelling above: `import collections` must keep reaching
  the resolver so a `collections.Sym` qualifier has a unit to resolve against. }
begin
  Result := PyImportRootHasNoBackingUnit(root) or
            CaseEqual(root, 'random');
end;

{ ParseUsesUnit for a NilPy IMPORT STATEMENT — the one place that records the
  fact every import site shares: this `uses` was written as Python.

  Every user-facing import arm goes through here rather than calling
  ParseUsesUnit directly, so the resolver's rule ("a bare import means Python")
  is keyed on something the parser KNOWS instead of on a predicate that merely
  correlates with it. The two that correlate both break: `isNilPy` is true for
  the whole compilation, so it also covers the `uses` clauses of the Pascal RTL
  units a NilPy program pulls in; `NilPyUserCode` goes false inside an imported
  .py module, whose own imports are Python too. See PyImportLang in defs.inc.

  The COMPILER'S OWN uses of ParseUsesUnit — the auto-used `math`, the ambient
  pylib/pyeval/builtin units, the `mimic_` re-entry inside the resolver — stay
  on the bare call on purpose: they are not import statements and must keep
  resolving under the unchanged Pascal rules. }
procedure PyParseImportUnitAs(const name, lang: AnsiString);
begin
  PyImportLang := lang;
  ParseUsesUnit(name);
end;

procedure PyParseImportUnit(const name: AnsiString);
begin
  PyParseImportUnitAs(name, 'py');
end;

{ `import 'sysutils.pas' as su` — the QUOTED import: a module named with an
  explicit extension, which is how a NilPy program reaches a unit written in
  another language. A bare import means Python, so this is the escape hatch
  that makes that rule affordable (decide-nilpy-imports-that-collide-with-a-
  pascal-rtl-unit). Consumes the string token, sets PyImportLang to the
  language its extension names, and returns the name to hand the resolver.

  A STRING LITERAL rather than a dotted `import math.pas`, because a quoted
  name cannot be confused with Python's own package syntax — `import xml.dom`
  stays a submodule import with nothing to disambiguate, so no whitelist of
  language extensions is needed and none can misfire on a package whose
  submodule really is called `c`. It also matches what the repo already
  ships: Pascal's `uses './mymod.pas' as m` (feature-uses-alias-as) and C's
  `#include "./lib2.c"`. User, 2026-08-19: the spelling may be language
  dependent, and consistency with the repo beats symmetry with CPython — both
  spellings are outside CPython anyway.

  TWO SHAPES, split on the slash, and the split is deliberate rather than an
  artefact (user, 2026-08-19):

    'x.pas'    no slash — a unit NAME carrying an explicit extension, resolved
               through the ordinary search chain with the language pinned.
               This is the shape that reaches lib/rtl, and without it the
               escape hatch cannot open the units it exists for.
    './x.pas'  with a slash — today's authoritative path, resolved against the
               importing file's directory with no search chain, exactly as the
               Pascal spelling already behaves. Unchanged.

  keyName gets the name the ALIAS and the unit key hang off — the basename with
  no directory and no extension — since that is what ParseUsesUnitBody keys a
  path-form load on. }
function PyConsumeQuotedModule(var keyName: AnsiString): AnsiString;
var raw, ext: AnsiString; i, lastSlash, lastDot: Integer;
begin
  raw := CurTok.SVal;
  Next;
  lastSlash := 0; lastDot := 0;
  for i := 1 to Length(raw) do
  begin
    if raw[i] = '/' then lastSlash := i;
    if raw[i] = '.' then lastDot := i;
  end;
  ext := '';
  if lastDot > lastSlash then
    ext := LowerCase(Copy(raw, lastDot + 1, Length(raw) - lastDot));
  if (ext = 'pas') or (ext = 'pp') then
    PyImportLang := 'pas'
  else if (ext = 'c') or (ext = 'h') then
    PyImportLang := 'c'
  else
    { no extension, or one we do not have a frontend for: say so HERE. The
      alternative is a "unit source not found" naming a file the program never
      wrote, one resolution step away from the actual mistake. }
    Error('Nil Python: a quoted import must name the language by extension — '
          + '.pas/.pp or .c/.h, as in `import ''sysutils.pas'' as su` (got ''' 
          + raw + ''')');
  if lastSlash > 0 then
    Result := raw            { authoritative path; the resolver keys on its basename }
  else
    Result := Copy(raw, 1, lastDot - 1);
  keyName := LowerCase(GetFileBaseName(raw));
end;


{ A single `import X [as Y]` / `from X import a, b` statement, leaving the
  parser ON the terminating newline. Shares the resolver with PyParseImportRun;
  see the note at the statement-level call site for why the newline matters. }
procedure PyParseOneImport;
var impName, impAlias, impRoot: AnsiString; aStrIdx, realStrIdx: Integer;
    impLevel: Integer;
    { the unit key and language of a quoted import; see PyConsumeQuotedModule }
    impKey, impLang: AnsiString;
begin
  { SoftUnitMissed describes THIS import, and nothing else. It is a global, and
    a soft miss recorded by an earlier one — a module's own `try: from PIL
    import Image / except ImportError:` — used to still be set here: the alias
    for a LATER import was then skipped and its name bound to None, so
    `from tkinter import ttk` left `ttk` unbound and every `ttk.Widget(...)`
    raised at RUN time with no diagnostic. Clear it at the start of each
    import; the fallback-import path sets it again for the block it guards. }
  SoftUnitMissed := False;
  if PyIsIdent('from') then
  begin
    Next;
    { level > 0 with an IDENTIFIER after the dots is `from .mod import X`: fall
      straight through to the ordinary from-import below, which resolves the
      module with ParseUsesUnit and binds the names through flat unit scope.
      The relative and absolute forms differ only in how the module NAME is
      spelled, so there is nothing to duplicate here. }
    impLevel := PyRelativeImportLevel;
    if (impLevel > 0) and (CurTok.Kind = tkUses) then
    begin
      { `from . import a, b` — the names ARE the modules. }
      Next;                                { past `import` }
      while CurTok.Kind = tkIdent do
      begin
        PyRelativeLevel := impLevel;
        PyParseImportUnit(CurTok.SVal);
        Next;
        if PyIsIdent('as') then
        begin
          Next;
          if CurTok.Kind = tkIdent then Next;
        end;
        if not Eat(tkComma) then Break;
      end;
      Exit;
    end;
    if CurTok.Kind <> tkIdent then
      Error('Nil Python: expected a module name after from');
    impName := PyConsumeDottedModule(impRoot);
    if CurTok.Kind <> tkUses then
      Error('Nil Python: expected import after from ' + impName);
    Next;
    if not PyImportIsConsumedOnly(impRoot, impName) then
    begin
      PyRelativeLevel := impLevel;
      PyParseImportUnit(impName);
    end;
    while CurTok.Kind = tkIdent do
    begin
      Next;
      if PyIsIdent('as') then
      begin
        Next;
        if CurTok.Kind = tkIdent then Next;
      end;
      if not Eat(tkComma) then Break;
    end;
  end
  else
  begin
    Next;
    while (CurTok.Kind = tkIdent) or (CurTok.Kind = tkString) do
    begin
      if CurTok.Kind = tkString then
      begin
        { `import 'x.pas'` — see PyConsumeQuotedModule; twin site in
          PyParseImportRun. An explicit extension names a FILE, so it is never
          one of the consumed-only roots. }
        impName := PyConsumeQuotedModule(impKey);
        impLang := PyImportLang;
        PyImportPending := True;
        PyParseImportUnitAs(impName, impLang);
        PyImportPending := False;
      end
      else
      begin
      impName := PyConsumeDottedModule(impRoot);
      impKey := impName;
      { `import typing` joins the consumed roots. The from-import form was
        already consumed; the PLAIN form was not, so `import typing` died with
        "no unit named typing" — which matters now that `@typing.overload` is a
        spelling this frontend accepts. typing has no run-time existence at all,
        so consuming it drops nothing: a name from it that IS called walls
        loudly at its use site, as the from-import path already does.
        That fix has since been generalised — the two spellings now share
        PyImportRootHasNoBackingUnit rather than each carrying its own list, so
        the next root only has to be added once. `collections` is still NOT
        consumed here; the reason lives on PyImportRootPlainIsConsumedOnly.
        bug-n-overload-decorator-is-refused }
      if not PyImportRootPlainIsConsumedOnly(impRoot) then
      begin
        { A PLAIN `import X` binds one name. If X resolves to a PASCAL unit, its
          contents must NOT join the Python builtin namespace — see
          PyImportPending. `from X import a, b` is a different statement and is
          left alone: it names what it publishes, which is the whole point of
          writing it. }
        PyImportPending := True;
        PyParseImportUnit(impName);
        PyImportPending := False;
      end;
      end;
      if PyIsIdent('as') then
      begin
        Next;
        if CurTok.Kind <> tkIdent then
          Error('Nil Python: expected a name after `as` in an import');
        aStrIdx := InternStr(LowerCase(CurTok.SVal));
        { impKey, not impName: a quoted import's name is a path or carries an
          extension, while the unit is keyed on its basename. Identical to
          impName for every unquoted import. }
        realStrIdx := InternStr(LowerCase(impKey));
        if (UnitAliasCount < MAX_UNIT_ALIASES) and (aStrIdx <> realStrIdx) then
        begin
          UnitAliasName[UnitAliasCount] := aStrIdx;
          UnitAliasReal[UnitAliasCount] := realStrIdx;
          Inc(UnitAliasCount);
        end;
        Next;
      end;
      if not Eat(tkComma) then Break;
    end;
  end;
end;

procedure PyParseImportRun;
var impName, impAlias, impRoot, impReal: AnsiString; isCount: Boolean;
    { the unit key and language of a quoted import; see PyConsumeQuotedModule }
    impKey, impLang: AnsiString;
    { The DOTTED module spelling, captured before ParseUsesUnit: PyDottedImport
      is a global, and pulling a unit parses ITS imports and overwrites it. The
      unit arm read it after the pull and bound nothing. }
    impDotted: AnsiString;
    aStrIdx, realStrIdx, optSym, impLevel: Integer;
    aliasSym, aliasCi, aliasRealSym, aliasRealProc: Integer;
    aliasUnitTarget: Integer;   { the unit a from-imported SUBMODULE name really names }
begin
  while (CurTok.Kind = tkUses) or PyIsIdent('from') do
  begin
    if PyIsIdent('from') then
    begin
      Next;
      { see the sibling above: dots + identifier falls through to the ordinary
        from-import path rather than growing a second one. }
      impLevel := PyRelativeImportLevel;
      if (impLevel > 0) and (CurTok.Kind = tkUses) then
      begin
        { `from . import a, b` — see PyRelativeImportLevel }
        Next;                              { past `import` }
        while CurTok.Kind = tkIdent do
        begin
          PyRelativeLevel := impLevel;
          PyParseImportUnit(CurTok.SVal);
          Next;
          if PyIsIdent('as') then
          begin
            Next;
            if CurTok.Kind = tkIdent then Next;
          end;
          if not Eat(tkComma) then Break;
        end;
        PySkipNewlines;
        Continue;
      end;
      if CurTok.Kind <> tkIdent then
        Error('Nil Python: expected a module name after from');
      impName := PyConsumeDottedModule(impRoot);
      impDotted := PyDottedImport;
      if CurTok.Kind <> tkUses then
        Error('Nil Python: expected import after from ' + impName);
      Next;
      { itertools is consumed-but-unresolved for now: uforth only needs
        count(); its use sites wall visibly until a shim lands (Track B). }
      { `collections` joins these: the names it exports that we support are
        ordinary pylib symbols (Counter -> pylib's TPyCounter constructors), so
        consuming the from-import is enough — an unsupported name from it walls
        visibly at its use site as an undefined variable, same as itertools. }
      if PyImportIsConsumedOnly(impRoot, impName) then
      begin
        while CurTok.Kind = tkIdent do
        begin
          isCount := CaseEqual(impRoot, 'itertools') and
                     CaseEqual(CurTok.SVal, 'count');
          if isCount then PyCountAlias := CurTok.SVal;
          { The name the compiler DOES provide under this root, remembered
            against the root it came from. Consuming the import used to drop it,
            so `from sys import argv` bound nothing and a bare `argv` was
            `undefined variable` while `sys.argv` worked — the spelling real
            CPython programs use was the broken one.
            `as` rebinds, so the record is written after the alias is known.
            bug-n-a-from-import-of-a-compiler-provided-module-binds-no-names }
          impReal := CurTok.SVal;
          impAlias := impReal;
          Next;
          if PyIsIdent('as') then
          begin
            Next;
            if CurTok.Kind = tkIdent then
            begin
              if isCount then PyCountAlias := CurTok.SVal;
              impAlias := CurTok.SVal;
              Next;
            end;
          end;
          PyStdAliasRecord(impDotted, impReal, impAlias);
          if not Eat(tkComma) then Break;
        end;
      end
      else
      begin
        { `from X import a, b` where X is a resolvable UNIT: pull the unit and
          let the names resolve unqualified, which is how `import X` already
          works (unit scope is flat). This is the form real code uses to reach a
          shim — `from configparser import ConfigParser`. An unknown module still
          fails, with the unit resolver's own "unit source not found: X". }
        PyRelativeLevel := impLevel;
        PyParseImportUnit(impName);
        while CurTok.Kind = tkIdent do
        begin
          { Record the name against the IMPORTING module (ParseUsesUnit has
            restored CurrentUnitIdx by now), so a builtin spelling it shadows
            is shadowed here and nowhere else. `as` rebinds it, so the ALIAS is
            the name in scope. }
          impReal := CurTok.SVal;
          impAlias := impReal;
          Next;
          if PyIsIdent('as') then
          begin
            Next;
            if CurTok.Kind = tkIdent then
            begin
              impAlias := CurTok.SVal;
              Next;
            end;
          end;
          { `from mod import NAME as ALIAS`. Unit scope is flat, so NAME itself
            is already in scope after ParseUsesUnit — but ALIAS is a second
            spelling that has to resolve to the same thing, and there is no
            general name-alias registry to point it at. Before this the alias
            was parsed and discarded, so every `as` form died with "undefined
            variable" (bug-nilpy-from-import-as-alias-is-discarded).

            Rather than inventing a registry, the alias is desugared to what
            Python actually does: `ALIAS = NAME`, a real binding in the
            importing module. That gets REBINDING right for free — a later
            `ALIAS = x` rebinds the alias and leaves the exporting module's
            name alone, exactly as CPython does, which a storage-sharing alias
            would have got wrong.

            A CLASS cannot go through an assignment (a class held in a variable
            is not constructible here — measured), so it takes the class-alias
            registry, which resolves the alias onto the same class row for var
            decls, ALIAS(), casts and is/as alike. That is the same registry a
            Pascal `TOptionList = TList;` uses. }
          { The SAME binding is needed when there is no `as` at all, and only
            inside a MODULE. `from .sub import VALUE` in a package's
            `__init__.py` left VALUE living in unit `sub` and bound nothing in
            `pkg`, so `from pkg import VALUE` in the importer found nothing —
            while the *aliased* spelling re-exported fine, because the alias
            makes a real symbol here. That asymmetry is the whole of
            bug-n-a-package-does-not-re-export-what-its-init-imports, and
            binding the plain name closes it with the mechanism that already
            works rather than by making `uses` transitive (ruled out by the
            user, 2026-08-15: a clause names units in the namespace of the unit
            that wrote it and in no other).

            It is also what CPython does: a from-import BINDS a name in the
            importer's namespace, it does not open a window onto the exporter's.
            Flat unit scope has been standing in for that binding, and stops at
            the first module boundary.

            MODULES ONLY, and deliberately: the main program has no importers,
            so a binding there re-exports to nobody and would only add a symbol
            that shadows the flat-scope resolution every existing NilPy program
            already relies on. Widening it to the program is a change with a
            large blast radius and no measured demand. }
          { Also bind it if the compiler PROVIDES this member — `from random
            import randint`. random has a backing unit, so it takes this arm
            rather than the consumed-only one, but its members are mapped by
            the same table sys.exit uses and the unit alone does not bind them. }
          PyStdAliasRecord(impDotted, impReal, impAlias);
          if (impAlias <> impReal) or (CurrentUnitIdx >= 0) then
          begin
            aliasCi := FindUClass(impReal);
            { An UN-aliased class needs neither arm: the registry would map the
              name onto the name it already has, and the assignment path cannot
              carry a class at all. }
            if (aliasCi >= 0) and (impAlias = impReal) then
              { nothing to do }
            else if aliasCi >= 0 then
              RegisterUClassAlias(PyStoredName(impAlias), Length(impAlias), aliasCi)
            else if PyImpAliasCount < 64 then
            begin
              { FindSym, not PyProgSym: the name belongs to the EXPORTING unit
                and PyProgSym deliberately hides other units' symbols. Flat unit
                scope is what makes the un-aliased spelling resolve, and this is
                the same lookup. }
              aliasRealSym := FindSym(impReal);
              aliasRealProc := -1;
              if aliasRealSym < 0 then aliasRealProc := FindProc(impReal);
              if (aliasRealSym >= 0) or (aliasRealProc >= 0) then
              begin
                aliasSym := PyProgSym(impAlias);
                if aliasSym < 0 then
                begin
                  if aliasRealSym >= 0 then
                    aliasSym := AllocVar(impAlias, Syms[aliasRealSym].TypeKind)
                  else
                    aliasSym := AllocVar(impAlias, tyVariant);
                end;
                if aliasRealSym >= 0 then
                begin
                  Syms[aliasSym].RecName := Syms[aliasRealSym].RecName;
                  SymSyncTypeRef(aliasSym);
                end;
                PyImpAliasSym[PyImpAliasCount] := aliasSym;
                if aliasRealSym >= 0 then
                  PyImpAliasSrc[PyImpAliasCount] := aliasRealSym
                else
                  PyImpAliasSrc[PyImpAliasCount] := -(aliasRealProc + 1);
                Inc(PyImpAliasCount);
              end;
              { Neither a symbol nor a proc: the real name is something this
                frontend does not know. Left alone — the alias stays undefined
                and walls at its use site, which is the pre-existing behaviour
                and still the honest one. }
            end;
          end;
          { A from-imported name may be a SUBMODULE rather than a value —
            `from reportlab.pdfgen import canvas` then `canvas.Canvas(...)`,
            `from tkinter import ttk` then `ttk.Notebook(...)`. Point the name
            at the unit that answered the import so the qualifier resolves; a
            name that is a plain value never gets qualified, so this is inert
            for it. Skipped when a real unit already carries the name, which is
            the only way this could hijack a genuine qualifier. }
          { …but NOT for a name that is a CLASS: `from tkinter import Canvas`
            imports a class, and the alias table folds case, so it claimed the
            name `canvas` and beat the MODULE of that name imported later by
            `from reportlab.pdfgen import canvas`. Python keeps them apart
            because it is case-sensitive; here the class is the one that is
            certainly not a submodule, so it is the one that does not register.

            FindUnitOrAlias, NOT FindCompiledUnit: impName is the name the
            SOURCE wrote, and for a shim that is the bare module (`xml.dom`,
            `probe`) while the class lives in `mimic_xml_dom` / `mimic_probe`.
            Asking the spelling which classes it declares gets -1 — no unit is
            compiled under it — so this guard silently stood down for every
            shim, the class name registered as a MODULE alias, and the next
            `Node.ELEMENT_NODE` was consumed by ConsumeUnitQualifier as a
            qualifier: name became ELEMENT_NODE, looked up as a bare symbol in
            mimic_probe, and reported `undefined variable (ELEMENT_NODE)` while
            the qualified and literal spellings both worked. FindUnitOrAlias
            chases the shim mapping (and the `as` chain) to the unit that
            actually declares things.

            And impREAL, not impAlias: the name that might be a class is the
            one the exporting module declares, not the new spelling. With the
            alias, `from mod import Node as N2` asked whether the unit declares
            a class called `N2` -- it declares `Node` -- so the guard missed,
            `N2` registered as a module alias, and `N2.ELEMENT_NODE` was eaten
            by ConsumeUnitQualifier exactly as the un-renamed shim case was.
            Identical for the un-renamed spelling, where the two are the same
            string. bug-n-a-renamed-class-loses-its-class-level-attributes

            Third instance today of one shape: a lookup done on the SPELLING
            where visibility and declarations live under the RESOLVED unit
            (bug-a-a-shim-classes-are-invisible-when-two-modules-import-the-same-shim
            was the same mistake at ParseUsesUnit's early exit).
            bug-n-from-a-shim-import-a-class-loses-its-class-level-attributes }
          if (UnitAliasCount < MAX_UNIT_ALIASES) and (not SoftUnitMissed) and
             (FindCompiledUnit(impAlias) < 0) and
             (not UnitDeclaresClassExactly(impReal, FindUnitOrAlias(impName))) then
          begin
            { Point the alias at what the imported NAME resolves to, not at the
              module the import was written against. `from sm import
              urllib_parse` works today only because sm's own
              `import pp as urllib_parse` left a global alias that
              FindUnitOrAlias chases: the name is registered against sm, and the
              chase happens to find pp anyway. Rename it — `from sm import
              urllib_parse as up` — and the new name is registered against sm
              with nothing to chase, so `up.urlparse(...)` reported `undefined
              variable (urlparse)` while the un-renamed spelling worked. That is
              html5lib/filters/sanitizer.py:15 exactly.

              So resolve impReal first and register the alias against THAT unit;
              fall back to impName when the name is not itself a module, which
              is the `from tkinter import ttk` case this registration exists for
              (ttk names no unit, so the import's own module is the right
              target and behaviour is unchanged).
              bug-n-from-import-with-an-as-rename-loses-what-it-renames }
            aliasUnitTarget := FindUnitOrAlias(impReal);
            UnitAliasName[UnitAliasCount] := InternStr(LowerCase(impAlias));
            if aliasUnitTarget >= 0 then
              UnitAliasReal[UnitAliasCount] := aliasUnitTarget
            else
              UnitAliasReal[UnitAliasCount] := InternStr(LowerCase(impName));
            Inc(UnitAliasCount);
          end;
          { The module did not resolve and we are inside a `try:` whose handler
            will be compiled instead — bind what it would have imported to
            None, so code that references the name COMPILES and fails when it
            RUNS. CPython raises NameError there; either way the failure is at
            use, not at import, which is the whole point of the guard the
            application wraps around such calls (`if not HAVE_PIL: return`).
            A variant global is born VT_EMPTY, which IS None. }
          if SoftUnitMissed then
          begin
            if PyProgSym(impAlias) < 0 then optSym := AllocVar(impAlias, tyVariant);
            PyNoteOptionalMissingName(impAlias);
          end;
          if PyImpNameCount < 256 then
          begin
            PyImpName[PyImpNameCount] := InternStr(LowerCase(impAlias));
            PyImpNameUnit[PyImpNameCount] := CurrentUnitIdx;
            Inc(PyImpNameCount);
          end;
          if not Eat(tkComma) then Break;
        end;
      end;
      PySkipNewlines;
    end
    else
    begin
      Next;
      while (CurTok.Kind = tkIdent) or (CurTok.Kind = tkString) do
      begin
        { Python stdlib modules without a shim yet: consume-and-defer, use
          sites wall visibly (same policy as itertools above). Everything
          else goes through the unit resolver (sqlite3, C headers, ...). }
        if CurTok.Kind = tkString then
        begin
          { `import 'x.pas'` — see PyConsumeQuotedModule. Never consumed-only:
            an explicit extension is a request for a specific FILE, so there is
            no stdlib root to defer. Twin site in PyParseOneImport. }
          impName := PyConsumeQuotedModule(impKey);
          impLang := PyImportLang;
          PyImportPending := True;
          PyParseImportUnitAs(impName, impLang);
          PyImportPending := False;
        end
        else
        begin
        impName := PyConsumeDottedModule(impRoot);
        impKey := impName;
        { `typing` — see the twin list in PyParseOneImport for why only this
          root is added and the others are not. }
        if PyImportRootPlainIsConsumedOnly(impRoot) then
          { skip }
        else
        begin
          { plain `import X` — qualified-only if X is a Pascal unit; see
            PyImportPending and the twin site in PyParseOneImport }
          PyImportPending := True;
          PyParseImportUnit(impName);
          PyImportPending := False;
        end;
        end;
        { `import X as Y` — Python's module alias, and the same thing a Pascal
          `uses X as Y` already does (feature-uses-alias-as): register the alias
          with the unit resolver so a `Y.Sym` qualifier resolves onto X's
          symbols. Unqualified names keep working either way, since unit scope
          is flat — the alias only has to make the PREFIX acceptable.
          `import tkinter as tk` is the shape songformatter uses. }
        if PyIsIdent('as') then
        begin
          Next;
          if CurTok.Kind <> tkIdent then
            Error('Nil Python: expected a name after `as` in an import');
          aStrIdx := InternStr(LowerCase(CurTok.SVal));
          { impKey, not impName — see the twin site in PyParseOneImport }
          realStrIdx := InternStr(LowerCase(impKey));
          if (UnitAliasCount < MAX_UNIT_ALIASES) and (aStrIdx <> realStrIdx) then
          begin
            UnitAliasName[UnitAliasCount] := aStrIdx;
            UnitAliasReal[UnitAliasCount] := realStrIdx;
            Inc(UnitAliasCount);
          end;
          Next;
        end;
        if not Eat(tkComma) then Break;
      end;
      PySkipNewlines;
    end;
  end;
end;

{ Every TOP-LEVEL import in the file, wherever it sits. The leading run handles
  the ones before the first statement; this one exists because Python allows an
  import anywhere and real files use that — songformatter's convertrawtext.py has
  a block of them after a try/except. Those were silently DROPPED: no error, no
  registration, and the first use failed much later as `undefined variable`.

  It has to run BEFORE the module-local pre-pass, not at statement level: that
  pre-pass trial-parses the whole body, so it meets the use site before the body
  parse would ever reach the import. Imports are re-encountered by the body parse
  and handled there too (PyParseStatement); registering a unit twice is a no-op. }
{ Imports at ANY depth are pulled HERE, before any body is parsed. A unit pull
  APPENDS the unit's tokens to the stream, and a body whose extent was already
  measured (PyFindBodyEnd) then ran past its end — the enclosing function
  silently produced nothing, which is what an in-body `import` used to do. The
  statement itself is still parsed later; the unit is compiled by then, so the
  pull is a no-op and appends nothing.

  Inside a `try:` an import must stay SOFT — that is the fallback-import idiom
  (`try: import reportlab / except ImportError:`), whose whole point is that the
  module may be absent. It is pulled here all the same, with the resolver in
  soft mode, so a module that IS present is loaded at MODULE scope like every
  other import; one that is absent is left entirely to the block parse, which
  decides the branch (PyParseFallbackImportTry) exactly as before.

  Skipping the pull outright is what made an in-`try` import inside a DEF a
  compile error. The unit's globals were then allocated inside the def's symbol
  range, the def's `SymRollbackTo(savedSC)` discarded them, and the pending
  global initializers the unit had queued outlived their symbols — a dangling
  IR_LEA in main, reported by the strict-IR verifier as "invalid symbol in lea"
  and pointing at a symbol index past the end of the table (measured: sym=439,
  SymCount=400). Loading at module scope puts those globals BELOW every def's
  savedSC, where every other import already puts them.

  This is the same failure the hoist-queue reset inside PyParseFallbackImportTry
  already guards against ("a stray IR_LEA of a rolled-back temp"); that fix
  covered the hoisted STATEMENTS and not the queued INITIALIZERS, which is the
  other thing an import run leaves behind.
  regression-test-core-test-nilpy-star-methods-and-targets }
procedure PyPreScanImports;
var i, depth, savedTok, tryAt, j: Integer;
    savedSoft, savedMissed: Boolean;
begin
  savedTok := TokPos;
  i := PyScanLo;
  depth := 0;
  tryAt := -1;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then
    begin
      Dec(depth);
      { Left the try STATEMENT — not merely its first block: an `except` or
        `finally` block is a sibling at the same depth and its imports are just
        as soft (the fallback idiom's handler is `from pxxpdf import canvas`).
        Look past the newlines for the clause that follows. }
      if (tryAt >= 0) and (depth <= tryAt) then
      begin
        j := i + 1;
        while (j < MainProgramTokCount) and (Tokens[j].Kind = tkNewline) do Inc(j);
        if (j >= MainProgramTokCount) or
           not (Tokens[j].Kind in [tkExcept, tkFinally, tkElse]) then tryAt := -1;
      end;
    end
    else if (Tokens[i].Kind = tkTry) and (tryAt < 0) then
      tryAt := depth
    else if ((Tokens[i].Kind = tkUses) or
             ((Tokens[i].Kind = tkIdent) and CaseEqual(GetTokenStr(i), 'from') and
              (i + 1 < MainProgramTokCount) and
              (Tokens[i + 1].Kind in [tkIdent, tkDot]))) and
            ((i = PyScanLo) or (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent])) then
    begin
      TokPos := i;
      Next;
      { in a `try:` the module may legitimately be absent — resolve softly and
        leave the branch decision to the block parse }
      savedSoft := SoftUnitResolve;
      savedMissed := SoftUnitMissed;
      if tryAt >= 0 then SoftUnitResolve := True;
      PyParseImportRun;
      SoftUnitResolve := savedSoft;
      SoftUnitMissed := savedMissed;
      i := TokPos - 2;
    end;
    Inc(i);
  end;
  TokPos := savedTok - 1;
  Next;
end;

{ A `.py` MODULE, pulled in by an import (`from settings import get`,
  `import key_analysis`). Parsed with the same frontend as a program, but its
  declarations land in a UNIT: ParseUsesUnit has already set CurrentUnitIdx, so
  every proc, class and module-level variable registered here is tagged with it
  and scoped like a Pascal unit's — which is what keeps `settings.get` from
  colliding with an importer's own `get`.

  A module's top-level STATEMENTS are its import-time code (settings.py runs
  `ensure_default_settings()` there, and the importer depends on it having run),
  so they compile into an `__init_<module>` proc registered in InitProcs — the
  same place a Pascal unit's `initialization` section goes, run in dependency
  order before the program body. They are PARSED with CurProc = -1, exactly as a
  program's top-level statements are, so the names they bind stay module-level
  variables rather than becoming locals of the init proc.
  (feature-nilpy-py-module-loader) }
{ Create every module-level name the type pre-pass found, BEFORE any def or
  class body is parsed. Python binds a global at CALL time, so a function may
  read a name the module assigns further down the file — songformatter's menu
  callbacks all reach for widgets built at the bottom of SongFormatter.py. The
  pre-pass types these names but rolls its symbols back, and the real symbol was
  created only when the assignment statement was reached, i.e. AFTER the def
  that used it: the body reported "undefined variable" for an ordinary global.
  Pre-creating them changes nothing about the assignment itself — it stores into
  the same symbol either way. }
{ Is `nm` a target of a module-level UNPACKING assignment (`a, b = f()`)? The
  type pre-pass does not model those, and the type it happens to record for one
  is not the value it receives — creating the global from it turned
  `a, b = two()` into a store of a string into an integer slot. Such a name is
  left to the unpack path, which creates it from the actual value. }
function PyIsModuleUnpackTarget(const nm: AnsiString): Boolean;
var i, j, depth: Integer; sawName, sawComma: Boolean;
begin
  Result := False;
  depth := 0;
  i := PyScanLo;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            (i + 1 < MainProgramTokCount) and (Tokens[i + 1].Kind = tkComma) and
            { at a STATEMENT boundary. Without this, `Button(x, textvariable=v,
              command=f)` matched: `v , command =` is an identifier, a comma and
              an `=`, and the whole module global was then skipped. }
            ((i = 0) or (Tokens[i - 1].Kind in [tkNewline, tkIndent, tkDedent,
                                                tkSemicolon, tkEOF])) then
    begin
      { scan the comma-separated name list; it is an unpack target only if it
        ends at `=` }
      j := i;
      sawName := False;
      sawComma := False;
      while j < MainProgramTokCount do
      begin
        if Tokens[j].Kind = tkIdent then
        begin
          sawName := True;
          Inc(j);
          { an ATTRIBUTE target counts as one name }
          if (j + 1 < MainProgramTokCount) and (Tokens[j].Kind = tkDot) and
             (Tokens[j + 1].Kind = tkIdent) then Inc(j, 2);
        end
        else if Tokens[j].Kind = tkComma then
        begin
          sawComma := True;
          Inc(j);
        end
        else Break;
      end;
      if sawName and sawComma and (j < MainProgramTokCount) and
         (Tokens[j].Kind = tkAssign) then
      begin
        j := i;
        while (j < MainProgramTokCount) and (Tokens[j].Kind <> tkAssign) do
        begin
          if (Tokens[j].Kind = tkIdent) and (GetTokenStr(j) = nm) then
          begin
            Result := True;
            Exit;
          end;
          Inc(j);
        end;
      end;
    end;
    Inc(i);
  end;
end;

{ Does the `def` header starting at token defTok bind `nm` as one of its
  PARAMETERS? A parameter SHADOWS a module global of the same name for the whole
  body (Python scoping, and unlike a plain local assignment no `global nm` can
  take it back), so uses of that name inside the body are NOT reads of the
  global — which is the question PyAllocModuleGlobals's scan below is asking.
  Only the name POSITIONS count: `def f(other)` binds `other`, but the `int` in
  `def f(x: int)` and the `other` in `def f(x = other)` are a type and a
  DEFAULT-value expression evaluated in the ENCLOSING scope, so both must keep
  reading as ordinary uses. }
function PyDefHeaderBindsName(defTok: Integer; const nm: AnsiString): Boolean;
var j, pdepth: Integer; expectName: Boolean;
begin
  Result := False;
  j := defTok;
  while (j < MainProgramTokCount) and (Tokens[j].Kind <> tkLParen) do
  begin
    { a `def` header's '(' is on its own line; a NEWLINE first means there is
      no parameter list to read (a syntax error the real parse will report) }
    if Tokens[j].Kind in [tkNewline, tkColon, tkEOF] then Exit;
    Inc(j);
  end;
  if j >= MainProgramTokCount then Exit;
  pdepth := 0;
  expectName := False;
  while j < MainProgramTokCount do
  begin
    if Tokens[j].Kind = tkLParen then
    begin
      Inc(pdepth);
      if pdepth = 1 then expectName := True;
    end
    else if Tokens[j].Kind = tkRParen then
    begin
      Dec(pdepth);
      if pdepth = 0 then Exit;
    end
    else if pdepth = 1 then
    begin
      if Tokens[j].Kind = tkComma then expectName := True
      else if Tokens[j].Kind = tkIdent then
      begin
        { only the FIRST ident after '(' or ',' is the parameter's own name;
          an annotation or default that follows is not a binding }
        if expectName and (GetTokenStr(j) = nm) then begin Result := True; Exit; end;
        expectName := False;
      end
      else if Tokens[j].Kind <> tkStar then
        { `*args` / `**kwargs` (two tkStar): a star keeps the next ident in name
          position; anything else (':', '=', a literal) ends it }
        expectName := False;
    end;
    Inc(j);
  end;
end;

{ Does the def whose header starts at defTok BIND `nm` in its BODY? Python's
  rule is that an assignment ANYWHERE in a function makes the name local for the
  WHOLE function — even textually before the assignment — so a body that assigns
  `nm` never reads the module global, and its uses must not force that global
  into existence. `global nm` takes it back: then the body really does write the
  module global and its uses DO count, so that wins wherever it appears.
  Covers plain `nm =` and `for nm in`; `with ... as nm` and comprehension
  targets are not detected yet and stay conservative (treated as NOT binding,
  i.e. today's behaviour). Cost note: def bodies do not overlap, so summing
  these scans over one caller pass is still one pass over the tokens — this does
  NOT reintroduce the PyFindBodyEnd-per-construct blowup. }
function PyDefBindsNameLocally(defTok: Integer; const nm: AnsiString): Boolean;
var j, k, bdepth: Integer; atStart: Boolean;
begin
  Result := False;
  { bounded at the header's end: without a suite of its own this used to find a
    LATER construct's INDENT and answer about that construct's bindings
    (bug-nilpy-def-body-scans-run-on-when-no-indent-is-found). False — "binds
    nothing" — is the conservative answer. }
  j := PyFindSuiteIndent(defTok, MainProgramTokCount);
  if j < 0 then Exit;
  bdepth := 0;
  while j < MainProgramTokCount do
  begin
    if Tokens[j].Kind = tkIndent then Inc(bdepth)
    else if Tokens[j].Kind = tkDedent then
    begin
      Dec(bdepth);
      if bdepth <= 0 then Exit;
    end
    else if (Tokens[j].Kind = tkIdent) or (Tokens[j].Kind = tkFor) then
    begin
      atStart := Tokens[j - 1].Kind in [tkNewline, tkIndent, tkDedent, tkSemicolon];
      if atStart and (Tokens[j].Kind = tkIdent) and (GetTokenStr(j) = 'global') then
      begin
        { `global a, nm, b` — scan the whole name list }
        k := j + 1;
        while (k < MainProgramTokCount) and
              (Tokens[k].Kind in [tkIdent, tkComma]) do
        begin
          if (Tokens[k].Kind = tkIdent) and (GetTokenStr(k) = nm) then
          begin
            Result := False;   { declared global — NOT a local binding }
            Exit;
          end;
          Inc(k);
        end;
      end
      else if atStart and (Tokens[j].Kind = tkIdent) and (GetTokenStr(j) = nm) and
              (j + 1 < MainProgramTokCount) and (Tokens[j + 1].Kind = tkAssign) then
        Result := True
      else if atStart and
              ((Tokens[j].Kind = tkFor) or CaseEqual(GetTokenStr(j), 'for')) and
              (j + 1 < MainProgramTokCount) and (Tokens[j + 1].Kind = tkIdent) and
              (GetTokenStr(j + 1) = nm) then
        Result := True;
    end;
    Inc(j);
  end;
end;

procedure PyAllocModuleGlobals;
const PY_ALLOCMOD_MAXDEPTH = 255;
var i, j, k, depth, idx, ci, pci: Integer; nm: AnsiString;
    usedEarlier, pendingDef, pendingShadow: Boolean;
    inDefStack: array[0..PY_ALLOCMOD_MAXDEPTH] of Boolean;
    shadowStack: array[0..PY_ALLOCMOD_MAXDEPTH] of Boolean;
begin
  { ONLY the names a routine ABOVE them reads — the shape that fails outright:
    `def refresh(): bpm_label.set(...)` at the top of the file,
    `bpm_label = tk.StringVar(...)` at the bottom. Everything else keeps being
    created by its own assignment, with the concrete type that gives it:
    pre-creating every module name from the type pre-pass instead was tried and
    is too eager — the pre-pass's guess is not always the assignment's type, and
    a name it typed one way then took stores of another. }
  depth := 0;
  i := PyScanLo;
  while i < MainProgramTokCount do
  begin
    if Tokens[i].Kind = tkIndent then Inc(depth)
    else if Tokens[i].Kind = tkDedent then Dec(depth)
    else if (depth = 0) and (Tokens[i].Kind = tkIdent) and
            (i + 1 < MainProgramTokCount) and (Tokens[i + 1].Kind = tkAssign) and
            { a STATEMENT BOUNDARY — see the note in PyCollectModuleLocalsAST:
              a keyword argument inside a call is not an assignment }
            ((i = PyScanLo) or (Tokens[i - 1].Kind in [tkNewline, tkIndent,
                                                       tkDedent, tkSemicolon])) then
    begin
      nm := GetTokenStr(i);
      if (PyProgSym(nm) < 0) and not PyIsModuleUnpackTarget(nm) then
      begin
        { the read has to be INSIDE A DEF (a routine), not merely inside any
          indented block: a module-level use before the assignment is a
          genuine "used before defined", and pre-creating the symbol would
          hide it — but plain generic indent-depth tracking (k > 0) also
          counts an `if`/`while`/`for`/`with` suite, which indents exactly
          like a def body does. `with open(p, "w") as f: f.write(...)`
          followed later at module level by `f = open(p, "r")` then read
          the WITH block's own `f` reference as "used earlier", pre-created
          `f` as a bare tyVariant BEFORE the with-statement's real parse ever
          ran, and PyParseWith stored the raw TPyFile pointer into that
          variant slot with no boxing — write() dispatched against garbage
          and silently wrote nothing
          (bug-nilpy-file-write-drops-data-and-read-to-print-dumps-rtti-memory,
          a second trigger for the same disclosure shape). Track which
          indent levels actually descend from a `def` header, not just any
          block. }
        usedEarlier := False;
        k := 0;
        pendingDef := False;
        pendingShadow := False;
        inDefStack[0] := False;
        shadowStack[0] := False;
        for j := PyScanLo to i - 1 do
        begin
          if Tokens[j].Kind = tkFunction then
          begin
            pendingDef := True;
            { A def whose PARAMETER list binds this very name: every use of the
              name in its body reads the PARAMETER, not the module global, so
              the body must not count as "used earlier" and must not force the
              global into existence as a bare tyVariant. `def __add__(self,
              other)` beside a module-level `other` is the idiomatic Python
              collision this got wrong — the global lost its class and every
              operator dunder on it stopped dispatching
              (bug-nilpy-global-shadowed-by-method-param-name-loses-class-type). }
            pendingShadow := PyDefHeaderBindsName(j, nm) or
                             PyDefBindsNameLocally(j, nm);
          end
          else if Tokens[j].Kind = tkIndent then
          begin
            if k < PY_ALLOCMOD_MAXDEPTH then
            begin
              if pendingDef then inDefStack[k + 1] := True
              else if k > 0 then inDefStack[k + 1] := inDefStack[k]
              else inDefStack[k + 1] := False;
              { a nested def inherits the shadow: an inner body's use of the
                name still resolves to the OUTER def's parameter, never to the
                module global }
              if pendingDef then shadowStack[k + 1] := pendingShadow or
                                                       ((k > 0) and shadowStack[k])
              else if k > 0 then shadowStack[k + 1] := shadowStack[k]
              else shadowStack[k + 1] := False;
            end;
            Inc(k);
            pendingDef := False;
            pendingShadow := False;
          end
          else if Tokens[j].Kind = tkDedent then Dec(k)
          else if (k > 0) and (k <= PY_ALLOCMOD_MAXDEPTH) and inDefStack[k] and
                  (not shadowStack[k]) and
                  (Tokens[j].Kind = tkIdent) and (GetTokenStr(j) = nm) then
          begin
            usedEarlier := True;
            Break;
          end;
        end;
        if usedEarlier then
        begin
          { The pre-created symbol is what the assignment below then STORES
            into, so whatever type it gets here is the type the global keeps.
            A bare tyVariant with REC_NONE therefore threw away the class
            identity `b = Counter()` would have given it, and the loss was
            silent: `b.hit(3)` still worked (the call path re-resolves), while
            `gb = b.hit` raised AttributeError and `x = b; x.hit(3)` SEGFAULTED.
            Ordinary Python — define the functions, then the module-level
            singletons they use — and the failure appears on a line that reads
            correctly (bug-nilpy-global-named-like-a-ctor-param-breaks-a-bound-
            method-value; same loss as bug-nilpy-global-shadowed-by-method-
            param-name-loses-class-type, reached by the other door).

            So take the class the type pre-pass already inferred, exactly as
            PyCollectModuleLocalsAST does for its own symbols. ONLY the class
            case is upgraded: every other kind still becomes tyVariant, which
            keeps the "pre-creating from the pre-pass is too eager" note above
            true — the pre-pass's guess for a scalar may disagree with the
            assignment, but a name it has resolved to a user CLASS is exactly
            the information being discarded here. }
          pci := PyFindConstraint(nm);
          if (pci >= 0) and (PyLocals[pci].TypeKind = tyClass) and
             (PyLocals[pci].RecCi >= 0) then
          begin
            ci := AllocVar(nm, tyClass);
            Syms[ci].RecName := REC_UCLASS_BASE + PyLocals[pci].RecCi;
          end
          else
          begin
            ci := AllocVar(nm, tyVariant);
            Syms[ci].RecName := REC_NONE;
          end;
          SymSyncTypeRef(ci);
        end;
      end;
    end;
    Inc(i);
  end;
end;

procedure ParsePyUnit(const uname: AnsiString);
var stmt, seqNode, lastSeq, procIdx, patchPos, savedSC, savedFS: Integer;
    dbgI: Integer;
    savedScanLo, savedMainTok, savedNest, savedLam, savedHoist, savedFloor: Integer;
    savedSelf2, savedImpAlias: Integer;
    savedExprMode: Boolean;
    dummyNames: array[0..0] of AnsiString;
    dummyTypes: array[0..0] of TTypeKind;
begin
  { Record that THIS unit is a NilPy module. `ProcUnitIdx >= 0` was standing in
    for "a Pascal library facade" at DefaultArgValueNode (parser.inc), and an
    imported .py module met the proxy while needing the opposite answer for its
    parameter defaults. bug-n-a-default-argument-is-dropped-on-every-cross-module-call }
  MarkUnitPyModule(CurrentUnitIdx);
  savedScanLo := PyScanLo;
  savedMainTok := MainProgramTokCount;
  savedExprMode := PyExprMode;
  savedNest := PyPendNestCount;
  savedLam := PyPendLamCount;
  { the import-alias queue is GLOBAL and the main program's entries are still
    on it here — flush only what THIS module adds. See PyFlushImportAliasesFrom. }
  savedImpAlias := PyImpAliasCount;
  { the pre-passes below scan "the compilation unit": for a module that is its
    own token span, not the program's }
  PyScanLo := TokPos - 1;
  MainProgramTokCount := TokCount;

  { The pre-passes TRIAL-PARSE: they emit no code, and anything they queue on
    the global hoist list is a leftover of a parse that is about to be redone.
    Left queued, such a node was flushed into a later statement — in a MODULE,
    after the symbols it names had been rolled back with the scope that made
    them, so the IR verifier rejected the compile at the module's LAST line
    with nothing there to explain it. Drop the queue instead. }
  savedHoist := PyHoistHead;
  { On BEFORE the pre-passes, not after: the pre-passes REGISTER symbols (class
    shells, def shells, module globals), and DeclCaseSensitive keys on
    NilPyUserCode, which for a `.py` MODULE (CurrentUnitIdx >= 0) is carried by
    PyExprMode alone. Set after the pre-passes, a module's own names were
    registered case-INsensitively while the program's were sensitive
    (bug-nilpy-identifiers-are-case-insensitive). Pascal units pulled in by
    PyPreScanImports still parse with it off — ParseUnit saves/clears/restores. }
  PyExprMode := True;
  PyDefInitHead := -1;
  PyDefaultClsName := '';
  PyClsEvalCi := -1;
  PyRegisterClassShells;          { the class ROWS the field pre-pass fills in }
  PyPreScanImports;
  PyPullSlgenIfGenerators;        { a module that yields needs lib/rtl/slgen }
  PyRegisterClassFieldsPrepass;
  PyRegisterDefShells;
  PyCollectModuleLocalsAST;
  PyAllocModuleGlobals;           { a def may read a global assigned further down }
  PyHoistHead := savedHoist;

  seqNode := AllocNode(AN_SEQ);
  lastSeq := seqNode;
  { From here this module's import-time statement list is LIVE across the whole
    file, and parsing it compiles other units whose per-body resets would hand
    these nodes out again — see ASTArenaFloor in defs.inc. }
  savedFloor := ASTArenaFloor;
  ASTArenaFloor := ASTNodeCount;
  { `from mod import NAME as ALIAS` in THIS module's own imports. The prescan
    above allocated the alias symbol and queued the binding; nothing materialised
    it, because the only flush point was the main program's (:32821). So the
    symbol existed, the assignment never ran, and every aliased import inside a
    pulled module read as 0 — silently, which is what made it expensive.
    Emitted as the module body's FIRST statement, which is where Python binds it.
    bug-n-from-import-as-alias-binds-zero-inside-a-pulled-module }
  stmt := PyFlushImportAliasesFrom(-1, savedImpAlias);
  if stmt >= 0 then ASTLeft[lastSeq] := stmt;
  PySkipNewlines;
  while CurTok.Kind <> tkEOF do
  begin
    if CurTok.Kind = tkClass then
    begin
      PyClsEvalCi := -1;
      PyParseClass(False);
      PyEvalMethodDefaults(PyClsEvalCi, PyClsEvalLo, PyClsEvalHi);
      PyClsEvalCi := -1;
      { a METHOD default is evaluated when the CLASS BODY executes, so its
        initialiser belongs at the class statement — the same shape the def
        branch below uses for its own }
      stmt := PyFlushDefInit(-1);
      if stmt >= 0 then
      begin
        if ASTLeft[lastSeq] = -1 then ASTLeft[lastSeq] := stmt
        else
        begin
          ASTRight[lastSeq] := AllocNode(AN_SEQ);
          lastSeq := ASTRight[lastSeq];
          ASTLeft[lastSeq] := stmt;
        end;
      end;
      ASTArenaFloor := ASTNodeCount;
    end
    else if CurTok.Kind = tkAt then
    begin
      Next;
      { `@overload` — the stub is dropped, header and body: CPython registers it
        and then the IMPLEMENTATION def that follows REPLACES it, so the stub's
        body never runs and its signature never binds.
        bug-n-overload-decorator-is-refused }
      if PyEatOverloadDecorator then
      begin
        PySkipNewlines;
        if CurTok.Kind <> tkFunction then
          Error('Nil Python: @overload must precede a def');
        PySkipOverloadStubDef;
        Continue;
      end;
      if not PyIsIdent('dataclass') then
        Error('Nil Python: unsupported decorator (only @dataclass and @overload)');
      Next;
      PyParseDataclassArgs;
      Expect(tkNewline, 'newline');
      PySkipNewlines;
      if CurTok.Kind <> tkClass then
        Error('Nil Python: @dataclass must precede a class');
      PyClsEvalCi := -1;
      PyParseClass(True);
      PyEvalMethodDefaults(PyClsEvalCi, PyClsEvalLo, PyClsEvalHi);
      PyClsEvalCi := -1;
      stmt := PyFlushDefInit(-1);
      if stmt >= 0 then
      begin
        if ASTLeft[lastSeq] = -1 then ASTLeft[lastSeq] := stmt
        else
        begin
          ASTRight[lastSeq] := AllocNode(AN_SEQ);
          lastSeq := ASTRight[lastSeq];
          ASTLeft[lastSeq] := stmt;
        end;
      end;
      ASTArenaFloor := ASTNodeCount;
    end
    else if CurTok.Kind = tkFunction then
    begin
      PyParseDef;
      { same as the program loop: a def's non-constant defaults are evaluated
        where the def statement stands, and that is the def's only run-time
        effect. Routed through the module's own statement list below. }
      stmt := PyFlushDefInit(-1);
      if stmt >= 0 then
      begin
        if ASTLeft[lastSeq] = -1 then ASTLeft[lastSeq] := stmt
        else
        begin
          ASTRight[lastSeq] := AllocNode(AN_SEQ);
          lastSeq := ASTRight[lastSeq];
          ASTLeft[lastSeq] := stmt;
        end;
      end;
      ASTArenaFloor := ASTNodeCount;
    end
    else
    begin
      stmt := PyParseStatement;
      stmt := PySeqAppend(PyFlushHoist(-1), stmt);
      if stmt >= 0 then
      begin
        if ASTLeft[lastSeq] = -1 then ASTLeft[lastSeq] := stmt
        else
        begin
          ASTRight[lastSeq] := AllocNode(AN_SEQ);
          lastSeq := ASTRight[lastSeq];
          ASTLeft[lastSeq] := stmt;
        end;
      end;
      ASTArenaFloor := ASTNodeCount;   { see the note at the loop head }
    end;
    PySkipNewlines;
  end;

  { DRAIN WHAT THE LAST STATEMENT HOISTED. Only the ordinary-statement branch
    above flushes the hoist queue, so anything a TRAILING construct queued had
    nothing after it to carry it in and was silently dropped. A class is the case
    that bites: PyEmitClsAttrBinds hoists one pyclsattr_bind per class attribute,
    so the LAST class in a module published none of them and every attribute read
    back as its type's zero value — `Node.ELEMENT_NODE` was 0, a string was ''.
    No diagnostic; the storage exists and was simply never initialised.

    Ending a module with a class is an entirely ordinary way to write one, and a
    constants class (DOM node types, enum-like flags, status codes) is exactly
    the shape that ends up there. It survived because the same class in the
    READING file is fine — there, any use of the class is itself a following
    statement, which flushes the queue.
    bug-n-the-last-class-in-a-module-reads-every-attribute-as-zero }
  stmt := PyFlushHoist(-1);
  if stmt >= 0 then
  begin
    if ASTLeft[lastSeq] = -1 then ASTLeft[lastSeq] := stmt
    else
    begin
      ASTRight[lastSeq] := AllocNode(AN_SEQ);
      lastSeq := ASTRight[lastSeq];
      ASTLeft[lastSeq] := stmt;
    end;
    ASTArenaFloor := ASTNodeCount;
  end;

  { the module's import-time code, as this unit's initialization section }
  procIdx := RegisterProc('__init_' + uname, False, tyInteger, 0,
                          dummyNames, dummyTypes);
  Procs[procIdx].BodyAddr := CodeLen;
  savedSC := SymCount;
  savedFS := FrameSize;
  FrameSize := 0;
  CurProc := procIdx;
  Procs[procIdx].ScopeBase := SymCount;
  patchPos := EmitProcPrologue;
  Procs[procIdx].FramePatch := patchPos;
  CompileAST(seqNode);
  EmitProcEpilog(-1);
  { DWARF -g: the module's import-time body is a real proc, so give it a
    subprogram DIE too — without one gdb showed the outermost NilPy frame as
    `?? ()` and no module-level name was in scope anywhere. Its own top-level
    names are GLOBALS (Python module scope), recorded as CU-level variable DIEs
    exactly like a Pascal program's globals. Main module only: an imported .py
    lexes past DbgMainTokEnd, and the Tier 1 line table describes one file. }
  ProcBodyEnd[procIdx] := CodeLen;
  ProcDbgMain[procIdx] := DbgTokIsDebuggable(TokPos);
  { NOT DbgMainBodyStart/End: those drive a SECOND, anonymous program-body
    subprogram in DbgEmitSubprograms, which would overlap this proc's DIE on
    the same address range. The named proc DIE is the better of the two. }
  if DebugInfo and ProcDbgMain[procIdx] then
    for dbgI := savedSC to SymCount - 1 do
      if Syms[dbgI].Kind = skGlobal then DbgRecordVar(-1, dbgI, True);
  PatchProcPrologue(patchPos, FrameSize);
  { The symbols this body allocated are NOT rolled back. The IR it emitted
    still names them, and the IR buffer outlives the proc — a later verify then
    met an index past SymCount and rejected the whole compile
    ("invalid IR symbol reference in load_sym" at the module's last line, with
    nothing at that line to explain it). A module's import-time code runs once
    at start-up and its temps are module-lifetime anyway, so keeping them costs
    symbol slots and nothing else. }
  FrameSize := savedFS;
  CurProc := -1;
  if InitProcCount < 256 then
  begin
    InitProcs[InitProcCount] := procIdx;
    Inc(InitProcCount);
  end;

  { bodies queued while compiling this module (nested defs, lifted lambdas) }
  PyDrainPendingLambdas(savedLam);
  while PyPendNestCount > savedNest do
  begin
    Dec(PyPendNestCount);
    stmt := TokPos;
    savedSelf2 := CurSelfClass;
    PyNestPrefix := PyPendNestPfx[PyPendNestCount];
    CurSelfClass := PyPendNestSelf[PyPendNestCount];
    TokPos := PyPendNestTok[PyPendNestCount];
    Next;
    PyParseDef;
    CurSelfClass := savedSelf2;
    PyNestPrefix := '';
    TokPos := stmt - 1;
    Next;
  end;

  ASTArenaFloor := savedFloor;
  PyExprMode := savedExprMode;
  MainProgramTokCount := savedMainTok;
  PyScanLo := savedScanLo;
end;

procedure ParsePyProgram;
var mainNode, stmt, blockNode, jmpPatch, i, savedUnitIdx: Integer; needsBuiltin: Boolean;
    pyHasExceptions: Boolean;
    dummyNames: array[0..3] of AnsiString;
    dummyTypes: array[0..3] of TTypeKind;
    impName: AnsiString; isCount: Boolean;
    aStrIdx, realStrIdx: Integer;
    pyWantsPow: Boolean;
    powSym, powPi, powAddr, powAsgn: Integer;
begin
  needsBuiltin := True;
  pyHasExceptions := False;
  for i := 0 to MainProgramTokCount - 1 do
  begin
    if (Tokens[i].Kind = tkIdent) and (i + 1 < MainProgramTokCount) and
       (Tokens[i + 1].Kind = tkLParen) and
       (CaseEqual(GetTokenStr(i), 'str') or CaseEqual(GetTokenStr(i), 'val')) then
      needsBuiltin := True;
    { `try` / `raise` anywhere in the program pulls in the exception runtime
      (setjmp/longjmp helpers, the unwind globals). The Pascal driver has the
      same pre-scan; this driver had none, so a .npy try emitted an
      IR_EXC_ENTER whose `call ExcSetJmpAddr` went to address 0 — an instant
      stack-smash segfault with no output, not a diagnostic. }
    if Tokens[i].Kind in [tkTry, tkRaise] then pyHasExceptions := True;
  end;
  PyCountAlias := '';
  PyImpNameCount := 0;
  PyStdAliasCount := 0;
  PyOptMissingCount := 0;
  PyExprHadOptionalMissing := False;
  PyDcCount := 0;
  for i := 0 to PY_MAX_DC_FIELDS - 1 do PyDcClassIsDc[i] := False;
  for i := 0 to MAX_UCLASS - 1 do PyMembersHoisted[i] := False;
  for i := 0 to MAX_UCLASS - 1 do
  begin
    PyClsBodyS[i] := -1;
    PyClsBodyE[i] := -1;
    PyClsUsedAsMixin[i] := False;
    PyDcOrder[i] := False;
  end;
  for i := 0 to MAX_UCLASS * 4 - 1 do PyDcCmpProc[i] := -1;
  PyMixN := 0; PyMixSkipN := 0; PyMixReplay := False;
  PyRegisterClassShells;
  BSS_INITIAL_RSP := BSSSize; Inc(BSSSize, 8);
  BSS_HEAP_PTR    := BSSSize; Inc(BSSSize, 8);
  BSS_HEAP_END    := BSSSize; Inc(BSSSize, 8);
  BSS_FREE_LIST   := BSSSize; Inc(BSSSize, 8);
  BSS_HEAP_LOCK   := BSSSize; Inc(BSSSize, 8);
  EmitB($48); EmitB($89); EmitB($24); EmitB($25); EmitGlobRef(BSS_INITIAL_RSP);
  MovRsiImm(HEAP_ARENA_SIZE);
  EmitMmapArena;
  EmitB($48); EmitB($89); EmitB($04); EmitB($25); EmitGlobRef(BSS_HEAP_PTR);
  EmitB($48); EmitB($89); EmitB($C2);
  EmitB($48); EmitB($81); EmitB($C2); EmitI32(HEAP_ARENA_SIZE);
  EmitB($48); EmitB($89); EmitB($14); EmitB($25); EmitGlobRef(BSS_HEAP_END);
  EmitB($E9); jmpPatch := CodeLen; EmitI32(0);
  { Integer div-by-zero abort stub — same latent hole as the C driver: a
    builtinheap div site compiled before PXXDivZero registers fell back to a
    zero Div0StubAddr. Python '//'/'%' always need the check; unconditional. }
  if TargetArch = TARGET_X86_64 then EmitDiv0Stub;
  { --threadsafe statement-atomic I/O lock stubs. Shared dispatcher, and a
    call every frontend driver needs: without it IOLockAddr stays 0 and any
    AN_WRITE lowering under --threadsafe calls code offset 0 -- the ELF entry
    point -- which jumps back to main and hangs until the stack is gone
    (bug-a-threadsafe-segfaults-on-every-nilpy-program). }
  EmitIoLockStubsForTarget;
  { Bitwise-on-float TypeError abort stub — EmitVarBinOp's double path calls it
    when a bitwise op has a float variant operand (Python raises, we abort like
    pylib's PyTypeError). bug-nilpy-bitwise-on-float-variant-truncates. }
  if TargetArch = TARGET_X86_64 then EmitPyBitFloatErrStub;
  if pyHasExceptions then EnableExceptionRuntime;
  { Forward-declare the builtin heap allocator before emitting the string
    runtime, which calls Alloc. The unit body (compiled by ParseUsesUnit below)
    fills these in. Mirrors the Pascal ParseProgram path; without it a .npy that
    touches the heap fails FindProc('PXXAlloc') during EmitAnsiStringRuntime. }
  savedUnitIdx := CurrentUnitIdx;
  CurrentUnitIdx := InternStr('builtinheap');
  dummyNames[0] := 'size';  dummyTypes[0] := tyNativeInt;
  dummyNames[1] := 'align'; dummyTypes[1] := tyInteger;
  i := RegisterProc('PXXAlloc', True, tyPointer, 2, dummyNames, dummyTypes);
  dummyNames[0] := 'p';     dummyTypes[0] := tyPointer;
  i := RegisterProc('PXXFree', False, tyPointer, 1, dummyNames, dummyTypes);
  { the emitted obj blobs call these (feature-nilpy-object-reclamation) }
  i := RegisterProc('PXXObjRetain', False, tyPointer, 1, dummyNames, dummyTypes);
  i := RegisterProc('PXXObjRelease', False, tyPointer, 1, dummyNames, dummyTypes);
  dummyNames[0] := 'p';     dummyTypes[0] := tyPointer;
  dummyNames[1] := 'newSize'; dummyTypes[1] := tyNativeInt;
  dummyNames[2] := 'align'; dummyTypes[2] := tyInteger;
  i := RegisterProc('PXXRealloc', True, tyPointer, 3, dummyNames, dummyTypes);
  dummyNames[0] := 'len';   dummyTypes[0] := tyNativeInt;
  dummyNames[1] := 'src';   dummyTypes[1] := tyPointer;
  i := RegisterProc('PXXStrFromLit', True, tyPointer, 2, dummyNames, dummyTypes);
  dummyNames[0] := 'lenA';  dummyTypes[0] := tyNativeInt;
  dummyNames[1] := 'srcA';  dummyTypes[1] := tyPointer;
  dummyNames[2] := 'srcB';  dummyTypes[2] := tyPointer;
  dummyNames[3] := 'lenB';  dummyTypes[3] := tyNativeInt;
  i := RegisterProc('PXXStrConcat', True, tyPointer, 4, dummyNames, dummyTypes);
  dummyNames[0] := 'strSlot'; dummyTypes[0] := tyPointer;
  dummyNames[1] := 'srcB';    dummyTypes[1] := tyPointer;
  dummyNames[2] := 'lenB';    dummyTypes[2] := tyNativeInt;
  i := RegisterProc('PXXStrAppend', False, tyPointer, 3, dummyNames, dummyTypes);
  dummyNames[0] := 'dest';    dummyTypes[0] := tyPointer;
  dummyNames[1] := 'right';   dummyTypes[1] := tyPointer;
  i := RegisterProc('PXXVarStrAppend', True, tyInt64, 2, dummyNames, dummyTypes);
  dummyNames[0] := 'path';  dummyTypes[0] := tyPointer;
  i := RegisterProc('PXXStrLoadFile', True, tyPointer, 1, dummyNames, dummyTypes);
  CurrentUnitIdx := savedUnitIdx;
  EmitAnsiStringRuntime;
  { builtinheap declares TInterfacedObject/IInterface, whose signatures name
    TGuid and TObject — register the builtin rows first (idempotent), exactly
    like the Pascal and C paths. }
  RegisterBuiltinTGuid;
  RegisterBuiltinTObject;
  ParseUsesUnitAmbient('builtinheap');
  if needsBuiltin then ParseUsesUnitAmbient('builtin');
  { Resolve TVarRec now that builtinheap declared it, exactly as ParseProgram
    does. Without this TVarRecId stayed REC_NONE for .npy programs, so ANY unit
    an import pulls in that takes an `array of const` parameter was rejected with
    "array of const requires the builtinheap unit" — while builtinheap was in
    fact loaded. That blocked every RTL unit reaching sysutils (Format), which is
    most of them, and is what `import json` actually died on. A .npy program has
    no uses clause of its own, so it could not work around it. }
  FixupTVarRecLayout;
  { NilPy's `**` on a FLOAT operand lowers to the RTL's `Power` — the same
    routine `math.pow` already resolves to, and measured bit-exact against
    CPython where pylib's own series pow is 1282 ulp out at `1.0001 ** 10000`
    (see PyMakePow). So the unit has to be pulled the same on-demand way the
    Pascal side pulls it for a bare `sqrt(`.

    `**` has no token of its own in this frontend, so the tell is two adjacent
    tkStar — which also matches `f(**kw)`, paying for the unit with nothing to
    show. That is a SIZE cost, not a correctness one, and it is the same trade
    the Pascal scan already makes for a bare `pi`; the alternative is a second
    place that has to tell a power from an unpacking.

    BEFORE `PyProgramMode := True` on purpose: math.pas is ordinary Pascal and
    its own `div`/`mod` must keep truncating semantics
    (project_pyprogrammode_is_program_wide_not_user_code).
    bug-a-nilpy-star-star-has-its-own-low-precision-pow }
  pyWantsPow := False;
  for i := 0 to TokCount - 2 do
    if (Tokens[i].Kind = tkStar) and (Tokens[i + 1].Kind = tkStar) then
    begin
      if not NoDefaultRtl then
      begin
        { QUALIFIED-ONLY, exactly as a user's own `import math` is. The program
          did not ask for this unit at all — the compiler pulled it because the
          source contains `**` — so publishing its Abs/Min/Max/Round into the
          Python builtin namespace would be the leak of
          bug-nilpy-import-leaks-the-units-names-into-the-python-namespace with
          nobody even able to see the import that caused it. Without this,
          adding the pull made `max(1.5, 2)` answer 2.0 and reversed the
          min/max tie, which is what kept this ticket parked twice. }
        PyImportPending := True;
        ParseUsesUnit('math');
        PyImportPending := False;
        pyWantsPow := True;
      end;
      Break;
    end;
  { AFTER math on purpose: the LAST unit named wins a name, and math declares
    Abs/Min/Max/Round of its own. Named last, its integer `Abs` hid pylib's
    float one and `abs(-1.5)` stopped resolving with only `abs(LongInt)`
    offered — measured, and it is why the pull sits above this line rather than
    beside the `Power` intercept that wants it. `Power` is still reachable:
    FindProcArityDouble scans the proc table, not the visible scope. }
  ParseUsesUnitAmbient('pylib');
  ParseUsesUnitAmbient('pyeval');
  { Only NOW: the units above are ORDINARY PASCAL and their own div/mod must
    keep truncating semantics. Setting this at entry rewrote pylib's own
    `a div b` into a call to the helper being defined. }
  PyProgramMode := True;
  PyCompTarget := -1;   { no comprehension in progress by default }
  PyHoistHead := -1;    { no pending hoisted statements }
  PyDefInitHead := -1;
  PyDefaultEvalMode := False;
  PyDefaultClsName := '';
  PyClsEvalCi := -1;
  PySkipNewlines;
  { A leading module docstring may precede the imports; consume it. }
  if (CurTok.Kind = tkString) and (TokPos < TokCount) and
     (Tokens[TokPos].Kind = tkNewline) then
  begin
    Next;
    PySkipNewlines;
  end;
  { Nil Python `import name[, name]` maps each module onto the same unit
    resolver as a Pascal `uses` clause, so a C header in /usr/include
    (e.g. sqlite3) is imported and dynamically linked identically. The
    lexer rewrites `import` to tkUses; leading imports are processed before
    the program body so their symbols are registered for the main code.
    `from dataclasses|typing import ...` is consumed and ignored (those
    names are built in); any other from-import is a clean unsupported. }
  PyParseImportRun;

  { Module-local type collection runs AFTER the units above so proc return
    types (len, VariantToStr, pylib methods) resolve during inference. }
  PyPreScanImports;               { every top-level import, not just the leading ones }
  PyPullSlgenIfGenerators;        { a module that yields needs lib/rtl/slgen }
  PyRegisterClassFieldsPrepass;   { fields must exist before local inference }
  PyRegisterDefShells;            { def signatures must exist before it too }
  PyCollectModuleLocalsAST;
  PyAllocModuleGlobals;           { a def may read a global assigned further down }
  PyExprMode := True;   { Pascal RTL units are loaded; from here on, .npy expression
                          parsing uses Python and/or/not precedence }
  { -g: module-level names declared from here on are the PROGRAM's own globals,
    not the runtime units' — the same boundary Pascal's DbgGlobalScopeBase
    marks. PyAllocModuleGlobals runs first because the names it pre-creates are
    the program's too. }
  DbgGlobalScopeBase := SymCount;
  mainNode := -1;
  { Install the RTL's `Power` as pylib's float-power hook, as the program's
    first statement. This is what makes the DYNAMIC `**` correct too — a loop
    variable or a list element is a Variant, so it goes to pypow_v at run time
    and no static intercept can reach it. pylib cannot name `Power` itself (it
    is a builtin unit, and `uses math` hides pylib's own `abs` overloads), so
    the frontend, which just pulled the unit two hundred lines above, hands the
    address over — the same shape builtinheap uses for its object finalizer.
    bug-a-nilpy-star-star-has-its-own-low-precision-pow }
  if pyWantsPow then
  begin
    powSym := FindSym('PyPowHook');
    powPi := FindProcArityDouble('Power', 2);
    if (powSym >= 0) and (powPi >= 0) then
    begin
      powAddr := AllocNode(AN_PROCADDR);
      ASTIVal[powAddr] := powPi;
      ASTTk[powAddr] := Ord(tyPointer);
      powAsgn := AllocNode(AN_ASSIGN);
      ASTLeft[powAsgn] := PyMakeIdent(powSym);
      ASTRight[powAsgn] := powAddr;
      mainNode := PySeqAppend(mainNode, powAsgn);
    end;
  end;
  PySkipNewlines;
  { `from mod import NAME as ALIAS` bindings, at the head of the module body —
    before any of its statements, which is where Python runs an import too. }
  mainNode := PyFlushImportAliases(mainNode);
  { The program's own statement list is live until the body is compiled at the
    end of this routine, and parsing it compiles units whose per-body resets
    would hand these nodes out again — the same hazard ParsePyUnit guards, and
    the program's nodes sit just ABOVE the reserve, so they are the first to be
    recycled. See ASTArenaFloor in defs.inc. }
  ASTArenaFloor := ASTNodeCount;
  while CurTok.Kind <> tkEOF do
  begin
    if CurTok.Kind = tkClass then
    begin
      PyClsEvalCi := -1;
      PyParseClass(False);
      PyEvalMethodDefaults(PyClsEvalCi, PyClsEvalLo, PyClsEvalHi);
      PyClsEvalCi := -1;
      { as in the def branch below — a method default runs when the class body
        does, so its initialiser is queued at the class statement }
      mainNode := PyFlushDefInit(mainNode);
      ASTArenaFloor := ASTNodeCount;
    end
    else if CurTok.Kind = tkAt then
    begin
      Next;
      { `@overload` — the stub is dropped, header and body: CPython registers it
        and then the IMPLEMENTATION def that follows REPLACES it, so the stub's
        body never runs and its signature never binds.
        bug-n-overload-decorator-is-refused }
      if PyEatOverloadDecorator then
      begin
        PySkipNewlines;
        if CurTok.Kind <> tkFunction then
          Error('Nil Python: @overload must precede a def');
        PySkipOverloadStubDef;
        Continue;
      end;
      if not PyIsIdent('dataclass') then
        Error('Nil Python: unsupported decorator (only @dataclass and @overload)');
      Next;
      PyParseDataclassArgs;
      Expect(tkNewline, 'newline');
      PySkipNewlines;
      if CurTok.Kind <> tkClass then
        Error('Nil Python: @dataclass must precede a class');
      PyClsEvalCi := -1;
      PyParseClass(True);
      PyEvalMethodDefaults(PyClsEvalCi, PyClsEvalLo, PyClsEvalHi);
      PyClsEvalCi := -1;
      mainNode := PyFlushDefInit(mainNode);
      ASTArenaFloor := ASTNodeCount;
    end
    else if CurTok.Kind = tkFunction then
    begin
      PyParseDef;
      { `def f(b=[])` evaluates its default HERE, where the def statement
        stands — the def itself emits no code, so this is the whole of its
        run-time effect. }
      mainNode := PyFlushDefInit(mainNode);
      ASTArenaFloor := ASTNodeCount;
    end
    else
    begin
      stmt := PyParseStatement;
      mainNode := PyFlushHoist(mainNode);
      mainNode := PySeqAppend(mainNode, stmt);
      { the list just grew — everything it now holds must sit BELOW the floor,
        or the next unit compile hands those nodes out again }
      ASTArenaFloor := ASTNodeCount;
      { several simple statements on one line, as in PyParseBlock }
      while CurTok.Kind = tkSemicolon do
      begin
        Next;
        if CurTok.Kind in [tkNewline, tkDedent, tkEOF] then Break;
        stmt := PyParseStatement;
        mainNode := PyFlushHoist(mainNode);
        mainNode := PySeqAppend(mainNode, stmt);
        ASTArenaFloor := ASTNodeCount;
      end;
    end;
    PySkipNewlines;
  end;
  { The same final drain the module loop needs, for the same reason — see the
    note there. In the PROGRAM this is masked rather than absent: a trailing
    class's binds go unflushed here too, but any use of the class is itself a
    following statement, so a program that reads the attribute has already
    flushed them. Fixed on both arms deliberately: this is one defect reachable
    through two loops, and the arm nobody can observe is the one that stays
    broken (devdocs/dev/normalise-dont-special-case.md).
    bug-n-the-last-class-in-a-module-reads-every-attribute-as-zero }
  mainNode := PyFlushHoist(mainNode);
  ASTArenaFloor := ASTNodeCount;
  Patch32(jmpPatch, CodeLen - (jmpPatch + 4));
  { Unit INITIALISATION, in dependency order, before the program's own body —
    the same thing ParseProgram does for Pascal. An imported `.py` module's
    top-level code lives in one of these (`settings.py` runs
    `ensure_default_settings()` there, and a module-level name has no value
    until it has run), so without this an importer read zeroes and crashed on
    the first module-level list (feature-nilpy-py-module-loader). }
  { -g: the module's own top-level code is the program body — the range that
    becomes the main DW_TAG_subprogram. Without it gdb had no subprogram
    covering module-level addresses, so a breakpoint there reported `?? ()`
    and no module-level name was in scope. The main module is compiled INLINE
    here (ParsePyUnit handles imported .py files), which is why the def/method
    wiring alone did not cover it. }
  DbgMainBodyStart := CodeLen;
  { TYPED CONSTANTS. `const Name: T = value` is writable storage with an initial
    value, recorded into PendingInit at parse time and turned into real
    assignments here. ParseProgram (Pascal) and the C frontend's `main` both did
    this; the NilPy driver never did, so under a Nil Python main EVERY typed
    constant in EVERY used Pascal unit read as the zero value of its type —
    silently, with no diagnostic
    (bug-nilpy-typed-const-import-reads-zero). It is not an import-boundary
    bug: Pascal code INSIDE a unit reading its own typed constant got zero too,
    because the initializers were simply never emitted for this main.

    BEFORE the unit initialisation sections below, exactly as ParseProgram
    orders it and for the reason recorded there: a constant's value cannot
    depend on what an init section does, but an init section very much may read
    a constant, and with the reverse order it reads zeros. }
  CompilePendingGlobalInits;
  for i := 0 to InitProcCount - 1 do
    EmitCallProc(InitProcs[i]);
  blockNode := AllocNode(AN_BLOCK);
  ASTLeft[blockNode] := mainNode;
  ASTTk[blockNode] := Ord(tyUnknown);
  PyExprMode := False;
  CompileAST(blockNode);
  { Unit FINALIZATION, in reverse init order, after the program body — like
    Pascal's driver, and like FPC. `atexit.register(fn)` is a finalization
    handler, so without this an imported module's exit code never ran. }
  if (FiniProcCount > 0) or (FiniRunnerProc >= 0) then
    EmitCallProc(GetFiniRunnerProc);
  EmitExit(0);
  DbgMainBodyEnd := CodeLen;
  { -g: the program's module-level names, as CU-level globals (Python module
    scope IS global scope). Same snapshot Pascal's ParseProgram takes. }
  if DebugInfo then
    for i := DbgGlobalScopeBase to SymCount - 1 do
      if Syms[i].Kind = skGlobal then DbgRecordVar(-1, i, True);
  { A lambda LIFTED at module level queues its body like one inside a def does,
    and nothing else drains the module's queue. Emitted after the exit on
    purpose: the code below is only ever reached by a call, and EmitExit never
    falls through into it. }
  PyDrainPendingLambdas(0);
  { Patch forward proc-call placeholders (e.g. the builtin heap allocator,
    whose body is compiled after the string runtime that calls it). Pascal
    ParseProgram does this; .npy needs it too now that string/variant codegen
    calls PXXAlloc. }
  EmitFinalizerRunnerBody;   { resolve any Halt-site __pxx_run_finalizers forward calls }
  ApplyCallFixups;
end;

{ ===== NilPy selector/subscript parsing =====
  The NilPy-only twin of parser.inc's ParseClassRecordSelectors, split out on
  2026-08-09 (task-a-carve-nilpy-selectors-out-of-parser-inc). The user's rule:
  once two languages diverge inside a shared parse helper, copy the helper and
  specialise it -- the shared thing is the AST/IR, not the parser.

  Why, concretely: the shared routine carried nine dialect forks, and in BOTH
  bugs it produced, the PASCAL behaviour was the default and the NilPy arm was
  something a reader had to remember to add (`f()[1]` on a string result applied
  Pascal's 1-based index; a dataclass `str` default was eaten by a defensive
  fill loop). A NilPy-only routine cannot accidentally do the Pascal thing,
  because the Pascal code is not in it.

  ParseClassRecordSelectors dispatches here whenever PyExprMode is on, so every
  existing call site is unchanged. PyExprMode is only ever set by pyparser.inc,
  so inside this copy PyExprMode / isNilPy / NilPyUserCode are all constantly
  True and their guards are gone. Arms that are genuinely Pascal-only (the
  interface IMT path, class-reference operations, `Free`) are still here on
  purpose: pylib's classes are Pascal classes reached from NilPy code, so
  proving an arm dead needs a measurement, not a reading. Delete them in a
  later, separately gated pass -- narrowing is what this split makes safe, not
  what it does. }

function PyParseClassRecordSelectors(node, recId: Integer; var outTk: TTypeKind): Integer;
var crBlob, crNode: Integer;   { class-reference ops on a chained value }
var dfCi, dfPri, dfMmi, dfMpi, dfI, dfSelf, dfIdxHead, dfIdxTail: Integer;   { default property on a chained value }
    dfW, dfValArg: Integer; dfAssign: Boolean;
    dfName: AnsiString;
var sub, prevTok: Integer; fieldName, accName: AnsiString; tk: TTypeKind;
    ci, mmi, mpi, callN, selfArg, lastA, aSeq, aNode, aIdx, mai: Integer;
    pri, i, w, margIdx: Integer; isAssign: Boolean;
    cvIdx: Integer;
begin
  tk := IntToTypeKind(ASTTk[node]);
  { EVALUATE THE RECEIVER ONCE. `f(args).m()` arrives here with the CALL as the
    base, and an AST value node used in two places is re-emitted, not shared — so
    `b.add(2).add(3)` ran add(2) TWICE and printed 7 where CPython prints 5.
    Silent, and the more links a chain has the further the answer drifts. Bound
    to a hidden temp, which is also what Python's evaluation order says. The
    Pascal twin in parser.inc keeps its current codegen, so the self-host
    binary is untouched. }
  if (ASTKind[node] = AN_CALL) and (CurTok.Kind in [tkDot, tkLBrack]) then
    node := PyEvalOnce(node);
  while CurTok.Kind in [tkDot, tkLBrack] do
  begin
    { The chain has reached a VARIANT — `make()[0]` yields one, a list holding
      variants — and a method on it dispatches at run time, not through this
      class machinery. Without this the '.' was left unconsumed and reported as
      an unexpected token, so `make()[0].upper()` did not compile at all. }
    if (tk = tyVariant) and (CurTok.Kind = tkDot) and
       (TokPos + 1 < TokCount) and (Tokens[TokPos].Kind = tkIdent) and
       (Tokens[TokPos + 1].Kind = tkLParen) then
    begin
      Next;                       { consume '.'; CurTok = the method name }
      i := TokPos - 1;
      Next;                       { consume the name; CurTok = '(' }
      node := PyParseVariantMethod(node, GetTokenStr(i));
      tk := IntToTypeKind(ASTTk[node]);
      Continue;
    end;

    { …and the same receiver with a BARE ATTRIBUTE, `.n` with no parentheses.
      The method arm above requires a '(' after the name, so an attribute fell
      straight through to the class/field path below, which built an AN_FIELD
      over the variant SLOT and read its first word — the TAG. Every field
      answered 7 (VT_OBJECT) whatever its declared type, which is what named the
      cause: `mk()[0].n` printed 7 where CPython prints 3, and so did a str
      field. The METHOD spelling `mk()[0].get()` was always right, which is
      exactly the asymmetry that pins it to this missing arm rather than to the
      subscript or the attribute read.

      Only a CALL receiver reaches here (PyEvalOnce above runs for AN_CALL),
      which is why `xs = mk(); xs[0].n` was correct all along and why the dict
      spelling `d["k"].n` looked correct too — it is a name receiver. Through a
      call, `mkd()["k"].n` was wrong the same way.

      PyMakeAttrLoad is the shared builder: it keeps the static-field path when
      the receiver has a known class and falls back to pydynattr_get_v for a
      variant, so this arm does not duplicate a lowering.

      An assignment TARGET is left alone — a store through this chain does not
      parse today at all (a loud error, filed as
      bug-nilpy-assigning-to-an-attribute-of-a-list-element-does-not-parse), and
      turning it into a dynattr READ here would only move the diagnostic.
      bug-nilpy-attribute-off-a-subscript-of-a-call-result-yields-the-variant-tag }
    if (tk = tyVariant) and (CurTok.Kind = tkDot) and
       (TokPos < TokCount) and (Tokens[TokPos].Kind = tkIdent) and
       ((TokPos + 1 >= TokCount) or
        not (Tokens[TokPos + 1].Kind in [tkLParen, tkAssign])) then
    begin
      Next;                       { consume '.'; CurTok = the attribute name }
      i := TokPos - 1;
      Next;                       { consume the name }
      node := PyMakeAttrLoad(node, GetTokenStr(i));
      tk := IntToTypeKind(ASTTk[node]);
      recId := REC_NONE;
      Continue;
    end;

    if CurTok.Kind = tkDot then
    begin
      Next;
      if CurTok.Kind in [tkEOF, tkSemicolon, tkAssign, tkRBrack, tkRParen] then
        Error('expected field name after .');
      prevTok := TokPos - 1;
      fieldName := GetTokenStr(prevTok);

      ci := -1;
      if recId >= REC_UCLASS_BASE then ci := recId - REC_UCLASS_BASE;

      { The pylib name remap runs HERE, before the property and method
        resolution below, not beside the method lookup further down: TPyDict's
        three view methods are spelled keylist/vallist/itemlist precisely to
        dodge the default `Items[]` PROPERTY, so `mk().items()` matched that
        PROPERTY first and then died on the '(' with "unexpected token" — while
        `mk().keys()` and `mk().values()`, which collide with nothing, worked.
        One remap, and it has to come before whatever the collision is with.
        bug-nilpy-selector-on-a-call-returning-a-dict-does-not-parse }
      if ci >= 0 then fieldName := PyMethNameFor(ci, fieldName);

      { The class-reference OPERATIONS on a chained value: `(Data as TJSONArray).ClassType`,
        `(b as TD).ClassName`. They are not methods, so the method path below never matched --
        and a pointer accepts any member name silently, so the selector was simply DROPPED and
        the expression evaluated to the object pointer. It printed a number where a class name
        was expected, with no error at all.

        An INSTANCE reaches its blob through AN_RTTIOF; a class REFERENCE is the blob. A real
        member of that name on the class still wins. }
      if (ci >= 0) and (CurTok.Kind = tkIdent) and IsClassRefOpName(fieldName) and
         (FindUMeth(ci, fieldName) < 0) and (FindUField(ci, fieldName) < 0) and
         (not UClsIsRecord[ci]) then
      begin
        crBlob := GenMakeRttiOfCall(node);
        if crBlob >= 0 then
        begin
          Next;                          { consume the operation name }
          crNode := GenMakeClassRefOp(crBlob, fieldName, outTk);
          if crNode >= 0 then
          begin
            node := ParseClassRefOpTail(crNode, outTk);
            recId := REC_NONE;
            Continue;
          end;
        end;
      end;

      { Method call on the value: `.M(args)` (or 0-arg `.M`). Checked before the
        field path so a method name isn't mistaken for a field. Mirrors the
        instance-method arg parsing (ref/array params taken by lvalue). Self =
        the current node; virtual methods dispatch dynamically on the real object
        (a hard cast doesn't change the dynamic type). }

      { Property on the value: TT(c).Prop — resolve to the backing field
        (rename the AN_FIELD to the accessor field) or the getter/setter call,
        mirroring the plain member-access property path (~2200). Previously the
        property name fell through to the field builder unresolved, so
        RecFieldOffset found nothing and read offset 0 — the VMT pointer
        (bug-downcast-inherited-property-wrong-offset). }
      pri := -1;
      if ci >= 0 then pri := FindUProp(ci, fieldName);
      if pri >= 0 then
      begin
        isAssign := (TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign);
        { Indexed property write: `:=` follows the subscript — peek past the
          bracket group (CurTok = name, TokPos = `[`). }
        if UPropIsIndexed[pri] and (not isAssign) and
           (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLBrack) then
        begin
          i := TokPos; w := 0;
          while i < TokCount do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(w)
            else if Tokens[i].Kind = tkRBrack then
            begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
            Inc(i);
          end;
          if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
        end;
        if isAssign then
        begin
          if UPropWriteFLen[pri] > 0 then
          begin
            { field-backed write: rename to the backing field; the caller
              consumes the `:=` and builds the assignment }
            sub := AllocNode(AN_FIELD);
            ASTLeft[sub] := node;
            ASTSOffset[sub] := UPropWriteFOff[pri];
            ASTSLen[sub] := UPropWriteFLen[pri];
            accName := '';
            for i := 0 to UPropWriteFLen[pri] - 1 do
              AppendChar(accName, TokChars[UPropWriteFOff[pri] + i]);
            tk := RecFieldType(recId, accName);
            recId := RecFieldRecId(recId, accName);
            ASTTk[sub] := Ord(tk);
            Next; { consume property name }
            node := sub;
            Continue;
          end
          else if UPropWriteMLen[pri] > 0 then
          begin
            accName := '';
            for i := 0 to UPropWriteMLen[pri] - 1 do
              AppendChar(accName, TokChars[UPropWriteMOff[pri] + i]);
            mmi := FindUMeth(ci, accName);
            if mmi < 0 then Error('setter method not found: ' + accName);
            mpi := UMthProc_[mmi];
            Next; { consume property name }
            margIdx := -1;
            if UPropIsIndexed[pri] then ParsePropIndexArgs(margIdx, lastA)
            else PropIndexConstArg(pri, margIdx, lastA);
            Expect(tkAssign, ':=');
            ParseExpr;
            if UMthVirSlot[mmi] >= 0 then
            begin
              callN := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[callN] := UMthVirSlot[mmi];
            end
            else
              callN := AllocNode(AN_CALL);
            ASTIVal[callN] := mpi;
            ASTTk[callN] := Ord(Procs[mpi].RetType);
            selfArg := AllocNode(AN_ARG);
            ASTLeft[selfArg] := node;
            ASTLeft[callN] := selfArg;
            aSeq := AllocNode(AN_ARG);
            ASTLeft[aSeq] := CurASTNode;   { value }
            { Setter args: self [, index...], value }
            if margIdx >= 0 then
            begin
              ASTRight[selfArg] := margIdx;
              ASTRight[lastA] := aSeq;
            end
            else
              ASTRight[selfArg] := aSeq;
            outTk := Procs[mpi].RetType;
            Result := callN;   { a complete call statement; caller uses it as-is }
            Exit;
          end
          else
            Error('property is read-only');
        end
        else
        begin
          if UPropReadFLen[pri] > 0 then
          begin
            sub := AllocNode(AN_FIELD);
            ASTLeft[sub] := node;
            ASTSOffset[sub] := UPropReadFOff[pri];
            ASTSLen[sub] := UPropReadFLen[pri];
            accName := '';
            for i := 0 to UPropReadFLen[pri] - 1 do
              AppendChar(accName, TokChars[UPropReadFOff[pri] + i]);
            tk := RecFieldType(recId, accName);
            recId := RecFieldRecId(recId, accName);
            ASTTk[sub] := Ord(tk);
            Next; { consume property name }
            node := sub;
            Continue;
          end
          else if UPropReadMLen[pri] > 0 then
          begin
            accName := '';
            for i := 0 to UPropReadMLen[pri] - 1 do
              AppendChar(accName, TokChars[UPropReadMOff[pri] + i]);
            mmi := FindUMeth(ci, accName);
            if mmi < 0 then Error('getter method not found: ' + accName);
            mpi := UMthProc_[mmi];
            Next; { consume property name }
            margIdx := -1;
            if UPropIsIndexed[pri] then ParsePropIndexArgs(margIdx, lastA)
            else PropIndexConstArg(pri, margIdx, lastA);
            if UMthVirSlot[mmi] >= 0 then
            begin
              callN := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[callN] := UMthVirSlot[mmi];
            end
            else
              callN := AllocNode(AN_CALL);
            ASTIVal[callN] := mpi;
            ASTTk[callN] := Ord(Procs[mpi].RetType);
            selfArg := AllocNode(AN_ARG);
            ASTLeft[selfArg] := node;
            ASTLeft[callN] := selfArg;
            { Getter args: self [, index...] }
            if margIdx >= 0 then ASTRight[selfArg] := margIdx;
            tk := Procs[mpi].RetType;
            if (tk = tyClass) or (tk = tyRecord) then recId := ProcRetRecId[mpi]
            else recId := REC_NONE;
            node := callN;
            Continue;
          end
          else
            Error('property is write-only');
        end;
      end;

      { `mk().__class__.__name__`, `xs[0].__class__.__name__` — the same chain
        parser.inc's bare-identifier path takes, here for every receiver that
        reaches the selector instead. One builder, both routes. }
      if PyIsClassNameChainAhead then
      begin
        node := PyMakeClassNameOf(node);
        tk := tyAnsiString; recId := REC_NONE; outTk := tk;
        Result := node;
        Exit;
      end;
      mmi := -1;
      if ci >= 0 then mmi := FindUMethOverloadAhead(ci, fieldName, CountCallArgsAhead);
      if mmi >= 0 then
      begin
        EnforceMethVis(mmi, fieldName);
        mpi := UMthProc_[mmi];
        { NilPy: `<expr>.method` with NO following call is a BOUND-METHOD VALUE,
          exactly as ParseLValueAST treats `name.method`. That was the ONLY site
          building one, so the value form worked only when the receiver was a
          bare identifier: `C().m`, `objs[0].m`, `a.b.m` — every receiver that
          reaches the selector path instead — fell through to the call path and
          yielded a bare code address with no receiver, which SEGFAULTED when
          called (bug-nilpy-bound-method-of-a-temporary-receiver-segfaults).

          The same bare-vs-selector split that hid a class-attribute read
          through a non-bare receiver, in this same routine. Two paths for one
          construct, and the second one stays broken —
          devdocs/dev/normalise-dont-special-case.md.

          A TEMPORARY receiver survives because the pair RETAINS it
          (pybound_new), so `C().m` keeps its instance alive for the pair's
          lifetime rather than reading a freed block. }
        if (TokPos < TokCount) and (Tokens[TokPos].Kind <> tkLParen) and
           (ci >= 0) and not UClsIsInterface[ci] then
        begin
          Next;                                  { consume the method name }
          node := PyMakeBoundMethod(mpi, node);
          ASTTk[node] := Ord(tyVariant);
          outTk := tyVariant;
          Result := node;
          Exit;
        end;
        if (ci >= 0) and UClsIsInterface[ci] then
        begin
          { INTERFACE receiver reached through a chained value — `IFoo(List[i]).M`,
            `(x as IFoo).M`. Must dispatch through the IMT slot like the
            ParseLValueAST path does: an interface method's proc is a body-less
            SIGNATURE, so building a plain AN_CALL to it called address 0. }
          callN := AllocNode(AN_INTF_CALL);
          ASTRight[callN] := node;                  { the interface value }
          ASTIVal[callN] := mpi;                    { signature proc (marshalling) }
          ASTSOffset[callN] := UMthVirSlot[mmi];    { IMT slot }
          ASTTk[callN] := Ord(Procs[mpi].RetType);
          lastA := -1;
          Next; { consume method name }
          if CurTok.Kind = tkLParen then
          begin
            Next;
            mai := 1;   { param 0 = Self, supplied by the interface value }
            while CurTok.Kind <> tkRParen do
            begin
              ParseArgExpr; aNode := CurASTNode;
              aSeq := AllocNode(AN_ARG); ASTLeft[aSeq] := aNode;
              if lastA = -1 then ASTLeft[callN] := aSeq else ASTRight[lastA] := aSeq;
              lastA := aSeq;
              Inc(mai);
              if CurTok.Kind = tkComma then Next
              else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
            end;
            Expect(tkRParen, ')');
          end;
          outTk := Procs[mpi].RetType;
          tk := outTk;
          recId := ProcRetRecId[mpi];
          if (tk <> tyClass) and (tk <> tyRecord) then recId := REC_NONE;
          node := callN;
          Continue;
        end;
        if UMthVirSlot[mmi] >= 0 then
        begin
          callN := AllocNode(AN_VIRTUAL_CALL);
          ASTRight[callN] := UMthVirSlot[mmi];
        end
        else
          callN := AllocNode(AN_CALL);
        ASTIVal[callN] := mpi;
        ASTTk[callN] := Ord(Procs[mpi].RetType);
        selfArg := AllocNode(AN_ARG);
        ASTLeft[selfArg] := node;
        ASTLeft[callN] := selfArg;
        lastA := selfArg;
        Next; { consume method name }
        if CurTok.Kind = tkLParen then
        begin
          Next;
          mai := 1;  { param 0 = Self }
          { `obj.F()` -- EMPTY parens on a method whose parameters ALL have defaults. FPC
            accepts it (fcl-json's own suite calls `J.FormatJSON()`); without this the loop hands
            the `)` to ParseExpr and reports "expected expression". A method with NO parameters
            already worked, because the loop simply never ran. }
          if CurTok.Kind = tkRParen then
          begin
            if (Procs[mpi].ParamCount > 1) and CanFillDefaultsFrom(mpi, 1) then
              FillDefaultArgs(mpi, 1, callN, lastA);
            mai := Procs[mpi].ParamCount;   { nothing to parse; Expect(tkRParen) consumes it }
          end;
          while mai <= Procs[mpi].ParamCount - 1 do
          begin
            { NilPy keyword argument on a method — `.decode(enc, errors="x")`.
              The censused uses pass keywords in declaration order, so the
              `name=` prefix is consumed and the value binds positionally. }
            if (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
               (Tokens[TokPos].Kind = tkAssign) then
            begin Next; Next; end;
            if (CurTok.Kind = tkLBrack) and ParamIsVarRecArray(mpi, mai) then
            begin
              { `[...]` array-of-const literal to a method reached through a
                value/selector chain — same as the plain-call path (b287) }
              aNode := ParseVarRecLiteralAST;
            end
            else if (CurTok.Kind = tkLBrack) and ParamIsOpenArrayScalar(mpi, mai) then
            begin
              { `[...]` open-array literal (r.SumAll([10,20]) on a record
                method) — was parsed as a SET literal and crashed (b334) }
              aNode := ParseArrayCtorAST(Procs[mpi].Params[mai].TypeKind,
                ProcParamElemRowLen[mpi * MAX_PROC_PARAMS + mai], ProcParamElemRowLo[mpi * MAX_PROC_PARAMS + mai]);
            end
            else if Procs[mpi].Params[mai].IsRef or Procs[mpi].Params[mai].IsArray then
            begin
              if ByRefArgStartsExpression(ParamIsConstVariant(mpi, mai)) then
              begin
                { non-ident by-ref/array arg (@obj.Method to a method-pointer
                  param, [..] literals, casts): parse as an expression }
                ParseArgExpr; aNode := CurASTNode;
              end
              else
              begin
                aIdx := FindSym(CurTok.SVal); Next;
                aNode := ParseLValueAST(aIdx, TokPos - 2);
              end;
            end
            else
            begin
              ParseArgExpr; aNode := CurASTNode;
            end;
            aSeq := AllocNode(AN_ARG); ASTLeft[aSeq] := aNode;
            ASTRight[lastA] := aSeq; lastA := aSeq;
            if (mai < Procs[mpi].ParamCount-1) and CanFillDefaultsFrom(mpi, mai+1) then
            begin
              FillDefaultArgs(mpi, mai+1, callN, lastA);
              mai := Procs[mpi].ParamCount-1;
            end
            else if mai < Procs[mpi].ParamCount-1 then Expect(tkComma, ',')
            else if CurTok.Kind = tkComma then Next;  { Python trailing comma }
            Inc(mai);
          end;
          Expect(tkRParen, ')');
        end;
        tk := Procs[mpi].RetType;
        if (tk = tyClass) or (tk = tyRecord) then recId := ProcRetRecId[mpi]
        else recId := REC_NONE;
        node := callN;
        { A method whose result is a STRING (e.g. bytes.decode) may be followed
          by str methods — `bytes(b).decode("latin-1").upper()`. The generic
          selector loop cannot resolve `.upper` (the result is not a class), so
          chain them here, exactly as ParseFactor does for a call result. }
        while PyIsStrBaseTk(tk) and (CurTok.Kind = tkDot) and
              (TokPos < TokCount) and (Tokens[TokPos].Kind = tkIdent) and
              (TokPos + 1 < TokCount) and (Tokens[TokPos + 1].Kind = tkLParen) do
        begin
          Next;                          { consume '.'; CurTok = method name }
          prevTok := TokPos - 1;
          Next;                          { consume the name; CurTok = '(' }
          node := PyParseStrMethod(node, GetTokenStr(prevTok));
          tk := IntToTypeKind(ASTTk[node]);
          recId := REC_NONE;
        end;
        outTk := tk;
        Continue;
      end;

      { `(o as T).Free;` and friends — see BuiltinFreeHere. Same reason and same
        guard as the ParseLValueAST site; this is the path a `(`-led statement
        takes. }
      if BuiltinFreeHere(node, recId, fieldName, TokPos) then
      begin
        Next;                        { consume 'Free' }
        outTk := tyInteger;
        Result := GenMakeFreeObjectExpr(node, recId - REC_UCLASS_BASE);
        Exit;
      end;
      { Class variable / class ATTRIBUTE reached through a NON-BARE receiver —
        the same fall-through the bare-identifier path already does in
        ParseFactor ("class variable accessed via an instance"). A class-written
        class attribute has no instance field BY CONSTRUCTION (it is one shared
        slot), so without this arm `Base(1).made` reaches RequireRecMember and
        dies as "no such member" while `b.made` on the very same object works —
        the sibling arm of a double case (normalise-dont-special-case.md). }
      if (recId >= REC_UCLASS_BASE) and
         (FindUField(recId - REC_UCLASS_BASE, fieldName) < 0) then
      begin
        { An attribute that instances ALSO write needs the per-instance override
          fall-through, not the bare slot — same precedence as the ParseFactor
          site, where this branch sits ahead of the plain class-var one. Reading
          the slot directly here would ignore an override that `self.attr = x`
          in a constructor had just created. }
        cvIdx := PyClsAttrOvrSlot(recId - REC_UCLASS_BASE, fieldName);
        if cvIdx >= 0 then
        begin
          Next;                        { consume the field name }
          node := PyClsAttrOvrGet(node, fieldName, cvIdx);
          tk := tyVariant;
          recId := REC_NONE;
          outTk := tk;
          Continue;
        end;
        cvIdx := FindClassVar(recId - REC_UCLASS_BASE, fieldName);
        if cvIdx >= 0 then
        begin
          sub := AllocNode(AN_IDENT);
          ASTIVal[sub] := cvIdx;
          ASTTk[sub] := Ord(Syms[cvIdx].TypeKind);
          tk := Syms[cvIdx].TypeKind;
          recId := REC_NONE;
          Next;                        { consume the field name }
          node := sub;
          outTk := tk;
          Continue;
        end;
      end;
      { In NilPy an unresolved member is a RUNTIME question, not a compile-time
        refusal — the attribute may have been set dynamically, and a class that
        declares __getattr__ answers for names its layout does not have at all.
        Route the miss to the runtime getter, which resolves the instance store
        and the declared members first and reaches the dunder last, exactly as
        CPython orders them.

        A BARE-identifier receiver already did this through the lvalue path and
        raised AttributeError at run time; only this chained-selector arm
        (`D().missing`, `mk(3).missing`) refused at COMPILE time, so the two
        spellings of one access disagreed — the receiver-shape split again
        (member access has two parsers). Matching them here is what lets
        `try: obj.maybe / except AttributeError:` compile for every receiver.
        bug-nilpy-getattr-dunder-not-supported }
      if isNilPy and (recId >= REC_UCLASS_BASE) and
         (FindUField(recId - REC_UCLASS_BASE, fieldName) < 0) then
      begin
        Next;                          { consume the field name }
        node := PyMakeDynAttrGet(node, fieldName);
        tk := tyVariant;
        recId := REC_NONE;
        outTk := tk;
        Continue;
      end;
      RequireRecMember(recId, fieldName);
      sub := AllocNode(AN_FIELD);
      ASTLeft[sub] := node;
      ASTSOffset[sub] := Tokens[prevTok].SOffset;
      ASTSLen[sub] := Tokens[prevTok].SLen;
      EnforceFieldVis(recId, fieldName);   { --strict-visibility member access control }
      tk := RecFieldType(recId, fieldName);
      recId := RecFieldRecId(recId, fieldName);
      ASTTk[sub] := Ord(tk);
      Next;
      node := sub;
    end
    else { tkLBrack — a DEFAULT PROPERTY on a class value, else index the array just selected }
    begin
      { `(Data as TJSONArray)[0]` (fcl-json's suite), `obj.Child[i]`. A class value with a
        DEFAULT property means the getter, not an array index -- and building a raw AN_INDEX
        over it left the base (an as-cast, say) with no address to take, which surfaced as
        "IR_UNSUPPORTED: could not lower AST node". ParseLValueAST's suffix loop has always
        dispatched this; the chained loop never did. }
      { NilPy SLICE on a SELECTED member, e.g. `self.memory[a:b]`. This is the
        chained-selector twin of the divert in ParseLValueAST: same reason
        (ParsePropIndexArgs below consumes the bracket), same lookahead. A
        plain `[i]` is untouched and still becomes the getter call. }
      if PyIsSliceBase(node) and PySliceBracketAt(TokPos - 1) then
      begin
        Next;                     { consume '[' }
        if CurTok.Kind = tkColon then
          node := PyParseSliceTail(node, -1)
        else
        begin
          PyParseBoolExpr;
          node := PyParseSliceTail(node, CurASTNode);
        end;
        tk := IntToTypeKind(ASTTk[node]);
        recId := ASTRight[node];
        CurASTNode := node;
        continue;
      end;
      { A CHAINED subscript whose base is now a VARIANT — `f()[0][0]`,
        `g()["k"]["j"]`. The first subscript of a container-returning call
        yields a variant, and this loop had no arm for indexing one: it fell
        through to the raw array index below, which silently produced the
        FIRST subscript's value again (`f()[0][0]` gave ['a', 1] instead of
        'a'), or None, or SEGFAULTED for a dict of dicts.

        PyMakeSuffixIndex is the same dispatcher a named receiver uses, so the
        chained spelling and `x = f(); x[0][0]` now agree by construction
        rather than by two paths happening to match — which is the failure this
        function's own header already records twice for other cases.
        bug-nilpy-subscript-of-a-call-result-ignores-the-index }
      if tk = tyVariant then
      begin
        Next;                     { consume '[' }
        PyParseBoolExpr;
        node := PyMakeSuffixIndex(node, CurASTNode);
        Expect(tkRBrack, ']');
        tk := IntToTypeKind(ASTTk[node]);
        recId := ASTRight[node];
        CurASTNode := node;
        continue;
      end;
      { A user class declaring `__getitem__` as the CHAINED base — `mk(5)[2]`,
        `C(5)[2]`, `obj.child()[k]`. A NAMED receiver has dispatched this since
        the subscript protocol landed (ParseLValueAST's loop); this loop never
        did, so the subscript fell to the raw AN_INDEX below — pointer
        arithmetic on the instance handle — and `mk(5)[2]` PRINTED THE OBJECT
        POINTER where CPython prints the element. Silent, and only when the
        receiver was an expression rather than a name, which is the
        one-concept-two-parsers shape this function's header already records
        twice (project_nilpy_lvalue_vs_selector_path_must_both_know).

        pylib's OWN classes are excluded: TPyList and friends carry a DEFAULT
        PROPERTY and are served by the arm below, the same exclusion the named
        path makes. }
      if (tk = tyClass) and (recId >= REC_UCLASS_BASE) and
         (not PyRecIsPylibOwnClass(recId)) and
         ((FindUMeth(recId - REC_UCLASS_BASE, '__getitem__') >= 0) or
          (FindUMeth(recId - REC_UCLASS_BASE, '__setitem__') >= 0)) then
      begin
        ci := recId - REC_UCLASS_BASE;
        { WRITE or read? Peek past the balanced [...] for a trailing '=', the
          same way the default-property write arm below settles the same
          question. `mk()[k] = v` used to be refused outright ("expected
          expression"), so the chained spelling could read nothing and write
          nothing. }
        isAssign := False;
        i := TokPos - 1; w := 0;            { TokPos-1 = the '[' }
        while i < TokCount do
        begin
          if Tokens[i].Kind = tkLBrack then Inc(w)
          else if Tokens[i].Kind = tkRBrack then
          begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
          Inc(i);
        end;
        if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
        Next;                     { consume '[' }
        PyParseBoolExpr;
        margIdx := CurASTNode;    { the key }
        Expect(tkRBrack, ']');
        if isAssign then
        begin
          Expect(tkAssign, '=');
          PyParseBoolExpr;
          if FindUMeth(ci, '__setitem__') < 0 then
          begin
            node := PyClassErrCallNode('PyNoSetitemError', ci);
            if node < 0 then Error('Nil Python: pylib (PyNoSetitemError) not loaded');
          end
          else
            node := PyCallMeth2(ci, '__setitem__', node, margIdx, CurASTNode);
          outTk := IntToTypeKind(ASTTk[node]);
          Result := node;
          Exit;
        end;
        if FindUMeth(ci, '__getitem__') < 0 then
        begin
          { declares only __setitem__: a READ has no getter, and CPython raises
            at RUN time — the same trade the named path makes }
          node := PyNotSubscriptableNode(ci);
          if node < 0 then Error('Nil Python: pylib (not-subscriptable) not loaded');
          tk := tyInt64; recId := REC_NONE;
          CurASTNode := node;
          continue;
        end;
        node := PyCallMeth1(ci, '__getitem__', node, margIdx);
        tk := IntToTypeKind(ASTTk[node]);
        recId := ResolveNodeRec(node);
        CurASTNode := node;
        continue;
      end;
      dfCi := -1;
      if (tk = tyClass) and (recId >= REC_UCLASS_BASE) then dfCi := recId - REC_UCLASS_BASE;
      dfPri := -1;
      if dfCi >= 0 then dfPri := FindDefaultProp(dfCi);
      { Default-property WRITE on a chained base — `f(x)[k] = v`, where the base
        is a call result (a dict/list reference) rather than a named lvalue, so
        the whole target reaches this expression loop instead of ParseLValueAST.
        Peek past the [...] group for a trailing '=' and, if present, build the
        setter (mirrors the ParseLValueAST default-property write path). }
      if (dfPri >= 0) and (UPropWriteMLen[dfPri] > 0) then
      begin
        dfAssign := False;
        dfI := TokPos - 1; dfW := 0;      { TokPos-1 = the '[' }
        while dfI < TokCount do
        begin
          if Tokens[dfI].Kind = tkLBrack then Inc(dfW)
          else if Tokens[dfI].Kind = tkRBrack then
          begin Dec(dfW); if dfW = 0 then begin Inc(dfI); Break; end; end;
          Inc(dfI);
        end;
        if (dfI < TokCount) and (Tokens[dfI].Kind = tkAssign) then dfAssign := True;
        if dfAssign then
        begin
          dfName := '';
          for dfI := 0 to UPropWriteMLen[dfPri] - 1 do
            AppendChar(dfName, TokChars[UPropWriteMOff[dfPri] + dfI]);
          dfMmi := FindUMeth(dfCi, dfName);
          if dfMmi < 0 then Error('default property setter not found: ' + dfName);
          dfMpi := UMthProc_[dfMmi];
          dfIdxHead := -1; dfIdxTail := -1;
          ParsePropIndexArgs(dfIdxHead, dfIdxTail);   { consumes [ .. ] }
          Expect(tkAssign, '=');
          ParseExpr;
          if UMthVirSlot[dfMmi] >= 0 then
          begin sub := AllocNode(AN_VIRTUAL_CALL); ASTRight[sub] := UMthVirSlot[dfMmi]; end
          else sub := AllocNode(AN_CALL);
          ASTIVal[sub] := dfMpi; ASTTk[sub] := Ord(Procs[dfMpi].RetType);
          dfSelf := AllocNode(AN_ARG); ASTLeft[dfSelf] := node; ASTLeft[sub] := dfSelf;
          dfValArg := AllocNode(AN_ARG); ASTLeft[dfValArg] := CurASTNode;  { value }
          ASTRight[dfSelf] := dfIdxHead; ASTRight[dfIdxTail] := dfValArg;
          node := sub; outTk := Procs[dfMpi].RetType; Result := node; Exit;
        end;
      end;
      if (dfPri >= 0) and (UPropReadMLen[dfPri] > 0) then
      begin
        dfName := '';
        for dfI := 0 to UPropReadMLen[dfPri] - 1 do
          AppendChar(dfName, TokChars[UPropReadMOff[dfPri] + dfI]);
        dfMmi := FindUMeth(dfCi, dfName);
        if dfMmi < 0 then Error('default property getter not found: ' + dfName);
        dfMpi := UMthProc_[dfMmi];

        dfIdxHead := -1; dfIdxTail := -1;
        ParsePropIndexArgs(dfIdxHead, dfIdxTail);   { consumes [ .. ] }

        if UMthVirSlot[dfMmi] >= 0 then
        begin
          sub := AllocNode(AN_VIRTUAL_CALL);
          ASTRight[sub] := UMthVirSlot[dfMmi];
        end
        else
          sub := AllocNode(AN_CALL);
        ASTIVal[sub] := dfMpi;
        ASTTk[sub] := Ord(Procs[dfMpi].RetType);
        dfSelf := AllocNode(AN_ARG);
        ASTLeft[dfSelf] := node;
        ASTLeft[sub] := dfSelf;
        ASTRight[dfSelf] := dfIdxHead;       { self, index... }

        node := sub;
        tk := Procs[dfMpi].RetType;
        if (tk = tyClass) or (tk = tyRecord) then recId := ProcRetRecId[dfMpi]
        else recId := REC_NONE;
        Continue;
      end;

      Next;
      sub := AllocNode(AN_INDEX);
      ASTLeft[sub] := node;
      ParseExpr;
      ASTRight[sub] := CurASTNode;
      Expect(tkRBrack, ']');
      if (tk = tyString) or (tk = tyAnsiString) then tk := tyChar;
      ASTTk[sub] := Ord(tk);
      node := sub;
    end;
  end;
  outTk := tk;
  Result := node;
end;

{ ---------------------------------------------------------------------------
  PyParseLValueAST — the NilPy half of ParseLValueAST, carved out of the shared
  parser.inc on 2026-08-19 (task-a-carve-nilpy-lvalue-parsing-out-of-parser-inc,
  split 2). ParseLValueAST dispatches here whenever PyExprMode is set, so every
  existing call site is untouched.

  Inside this routine PyExprMode is TRUE by construction (it is the dispatch
  condition, and only pyparser.inc ever sets it), so its guards fold away. The
  `isNilPy` / `NilPyUserCode` guards do NOT fold in the Pascal original and are
  therefore left in place THERE: isNilPy still holds while an .npy program's
  Pascal RTL units are parsed, with PyExprMode false.
  --------------------------------------------------------------------------- }
function PyParseLValueAST(idx: Integer; identTokIdx: Integer): Integer;
var
  augBin: TTokenKind; augRead, augNode: Integer;   { `d[k] += v` }
  augPow: Boolean;   { `d[k] **= v` — `**` has no binary token, see PyAugDunderName }
  viaProp: Boolean;   { fieldName was rewritten from a PROPERTY's backing field — visibility is the property's, skip the field check }
  mblobNode, cpPri, cpMmi, cpMpi: Integer;
  mkw, mslot, mnArgs: Integer;   { NilPy keyword argument: binding+1, target param, rebound count }
  cpIsAssign: Boolean;
  cpName: AnsiString;
  node, indexNode, fieldNode, prevTok, recName, i: Integer;
  derefNode: Integer;   { NilPy frame-cell read: `hidden^` (SymCellPtr) }
  baseNode, baseRec, fIdx, aliasIdx: Integer;
  remDepth, ptrBaseTk, ptrBaseRec: Integer;
  isND: Boolean; nIdx: Integer; alreadyResolved: Boolean;
  tk: TTypeKind;
  fieldName: AnsiString;
  mci, mmi, mpi, mcallNode, mselfArg, mlastArg, margSeq, margIdx, mexprNode, mai, pri, ci: Integer;
  mkwIdx, mkwCount: Integer;   { keyword binding for the UNBOUND `A.m(self, k=v)` spelling }
  methName: AnsiString;
  isAssign: Boolean;
  selfClassCi, selfIdx, fldIdx, selfNode: Integer;
  cvIdx: Integer;
  w, withNode, recId: Integer;
  propFOff, propFLen: Integer;
  propRecvNode, propRecvCi: Integer;   { NilPy @property on a VARIANT receiver }
  withResolved: Boolean;
  fldSigPi, callIndNode, argsHead2, lastArg2, argSeq2, baseRecFld: Integer;
  isMethodPtr: Boolean;
  autoDeref, peRec: Integer;
  ccReg, ccNode: Integer; ccKey: AnsiString; ccTk: TTypeKind;   { qualified TClass.Const }
  keyNode: Integer;   { __getitem__/__setitem__ subscript key }
  pyInitCall: Boolean;   { NilPy `Base.__init__(self, ...)` — run the ctor BODY on self, never construct }
  setTmpSym, setTmpAssign, setInnerComma: Integer;   { chained subscript-assign value }
  binNode: Integer; augTk2: TTokenKind;   { `v[k] op= x` on a variant base }
  sharedNeedsOvr: Boolean;   { the shared class-attribute slot also has per-instance overrides }
begin
  prevTok := identTokIdx;
  if DebugTrace then writeln('PyParseLValueAST: idx = ', idx, ' prevTok = ', prevTok, ' TokenStr = "', GetTokenStr(prevTok), '" CurTok.Line = ', CurTok.Line, ' TokPos = ', TokPos);

  fieldName := GetTokenStr(prevTok);
  withResolved := False;

  { Indirect call through a proc-var / METHOD-POINTER ident: v(args). A
    method-pointer var is tyRecord, so ParseFactor routes it here (not its
    own proc-var branch) and it used to fall into the field path and die on
    the '('. Mirrors ParseProcVarCallAST minus the name consume. }
  if (idx >= 0) and (SymProcSig[idx] >= 0) and (CurTok.Kind = tkLParen) then
  begin
    isMethodPtr := Syms[idx].TypeKind = tyRecord;
    fldSigPi := SymProcSig[idx];
    node := AllocNode(AN_IDENT);
    ASTIVal[node] := idx;
    if isMethodPtr then ASTTk[node] := Ord(tyRecord)
    else ASTTk[node] := Ord(tyPointer);
    Next; { consume '(' }
    argsHead2 := -1; lastArg2 := -1; i := 0;
    while CurTok.Kind <> tkRParen do
    begin
      ParseExpr;
      argSeq2 := AllocNode(AN_ARG);
      ASTLeft[argSeq2] := CurASTNode;
      if argsHead2 = -1 then argsHead2 := argSeq2
      else ASTRight[lastArg2] := argSeq2;
      lastArg2 := argSeq2;
      Inc(i);
      if CurTok.Kind = tkComma then Next
      else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
    end;
    Expect(tkRParen, ')');
    if i <> Procs[fldSigPi].ParamCount then
      Error('procedural call: wrong number of arguments');
    callIndNode := AllocNode(AN_CALL_IND);
    ASTLeft[callIndNode]  := argsHead2;
    ASTRight[callIndNode] := node;
    ASTIVal[callIndNode]  := fldSigPi;
    ASTTk[callIndNode]    := Ord(Procs[fldSigPi].RetType);
    if isMethodPtr then ASTSLen[callIndNode] := 1 else ASTSLen[callIndNode] := 0;
    Result := callIndNode;
    Exit;
  end;

  { TYPE-HELPER dispatch: a '.' member on a plain (non-class/record) receiver
    whose type has a `record helper for T` in scope, and the member names one
    of the helper's methods — `s.ToLower` with s: AnsiString. Reuses the
    class/record selector machinery with the HELPER as the record id; the
    method's Self (param 0) is the target BY REFERENCE, so passing the
    receiver node as the Self argument takes its address, exactly like an
    advanced-record method. Guarded on the member actually existing, so every
    other '.' path is untouched. }
  if (idx >= 0) and (CurTok.Kind = tkDot) and
     (Syms[idx].RecName < REC_UCLASS_BASE) and (not Syms[idx].IsArray) and
     not (Syms[idx].TypeKind in [tyRecord, tyClass, tyVariant, tyPointer]) and
     (TokPos < TokCount) and (Tokens[TokPos].Kind = tkIdent) then
  begin
    mci := FindHelperForType(Syms[idx].TypeKind, Syms[idx].RecName);
    if (mci >= 0) and (FindUMeth(mci, GetTokenStr(TokPos)) >= 0) then
    begin
      node := AllocNode(AN_IDENT);
      ASTIVal[node] := idx;
      ASTTk[node] := Ord(Syms[idx].TypeKind);
      tk := Syms[idx].TypeKind;
      node := ParseClassRecordSelectors(node, REC_UCLASS_BASE + mci, tk);
      LastExprTk := tk;
      Result := node;
      Exit;
    end;
  end;

  if WithStackDepth > 0 then
  begin
    for w := WithStackDepth - 1 downto 0 do
    begin
      withNode := WithStack[w];
      recId := ResolveNodeRec(withNode);
      if recId >= REC_UCLASS_BASE then
      begin
        selfClassCi := recId - REC_UCLASS_BASE;
        fldIdx := FindUField(selfClassCi, fieldName);
        if fldIdx < 0 then
        begin
          { with-scoped PROPERTY with a FIELD accessor — `with TFTPSend.Create
            do ... Username := User` (ftpsend): rewrite to the backing field.
            Write accessor when an assignment follows, read otherwise; method
            accessors are out of scope here (fall through). }
          pri := FindUProp(selfClassCi, fieldName);
          if pri >= 0 then
          begin
            if (CurTok.Kind = tkAssign) and (UPropWriteFLen[pri] > 0) then
            begin
              propFOff := UPropWriteFOff[pri];
              propFLen := UPropWriteFLen[pri];
            end
            else if UPropReadFLen[pri] > 0 then
            begin
              propFOff := UPropReadFOff[pri];
              propFLen := UPropReadFLen[pri];
            end
            else
              propFLen := 0;
            if propFLen > 0 then
            begin
              methName := '';
              for i := 0 to propFLen - 1 do
                AppendChar(methName, TokChars[propFOff + i]);
              fldIdx := FindUField(selfClassCi, methName);
              if fldIdx >= 0 then
              begin
                fieldNode := AllocNode(AN_FIELD);
                ASTLeft[fieldNode] := withNode;
                { codegen re-resolves the field by its own span }
                ASTSOffset[fieldNode] := propFOff;
                ASTSLen[fieldNode] := propFLen;
                tk := IntToTypeKind(UFldTk[fldIdx]);
                recName := UFldRec_[fldIdx];
                ASTTk[fieldNode] := Ord(tk);
                node := fieldNode;
                withResolved := True;
                Break;
              end;
            end;
          end;
        end;
        if fldIdx >= 0 then
        begin
          fieldNode := AllocNode(AN_FIELD);
          ASTLeft[fieldNode] := withNode;
          ASTSOffset[fieldNode] := Tokens[prevTok].SOffset;
          ASTSLen[fieldNode] := Tokens[prevTok].SLen;
          tk := IntToTypeKind(UFldTk[fldIdx]);
          recName := UFldRec_[fldIdx];
          ASTTk[fieldNode] := Ord(tk);
          node := fieldNode;
          withResolved := True;
          Break;
        end;
        { with-scoped `Free;` with no user Free method — the builtin
          TObject.Free desugar over the with operand (ftpsend's finally). }
        if CaseEqual(fieldName, 'Free') and (CurTok.Kind in [tkSemicolon, tkEnd, tkElse]) and
           (FindUMeth(selfClassCi, 'Free') < 0) then
        begin
          node := GenMakeFreeObjectExpr(CloneAST(withNode), selfClassCi);
          tk := tyInteger;
          recName := REC_NONE;
          withResolved := True;
          Break;
        end;
        { with-scoped METHOD, bare or with args — `with TFTPSend.Create do
          ... if not Login then` (ftpsend). Self = the with operand (a
          materialised temp for call operands, so evaluation is per-call of
          the METHOD, not a re-Create). }
        mmi := FindUMethOverloadAhead(selfClassCi, fieldName, CountCallArgsAhead);
        if mmi >= 0 then
        begin
          EnforceMethVis(mmi, fieldName);
          mpi := UMthProc_[mmi];
          mselfArg := AllocNode(AN_ARG);
          ASTLeft[mselfArg] := withNode;
          if UMthVirSlot[mmi] >= 0 then
          begin
            mcallNode := AllocNode(AN_VIRTUAL_CALL);
            ASTRight[mcallNode] := UMthVirSlot[mmi];
          end
          else
            mcallNode := AllocNode(AN_CALL);
          ASTIVal[mcallNode] := mpi;
          ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
          ASTLeft[mcallNode] := mselfArg;
          mlastArg := mselfArg;
          if CurTok.Kind = tkLParen then
          begin
            Next;
            while CurTok.Kind <> tkRParen do
            begin
              ParseExpr;
              margSeq := AllocNode(AN_ARG);
              ASTLeft[margSeq] := CurASTNode;
              ASTRight[mlastArg] := margSeq;
              mlastArg := margSeq;
              if CurTok.Kind = tkComma then Next
              else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
            end;
            Expect(tkRParen, ')');
          end;
          tk := Procs[mpi].RetType;
          recName := ProcRetRecId[mpi];
          node := mcallNode;
          withResolved := True;
          Break;
        end;
      end
      else if (recId <> REC_NONE) and (recId < REC_UCLASS_BASE) then
      begin
        tk := RecFieldType(recId, fieldName);
        if tk <> tyUnknown then
        begin
          fieldNode := AllocNode(AN_FIELD);
          ASTLeft[fieldNode] := withNode;
          ASTSOffset[fieldNode] := Tokens[prevTok].SOffset;
          ASTSLen[fieldNode] := Tokens[prevTok].SLen;
          recName := RecFieldRecId(recId, fieldName);
          ASTTk[fieldNode] := Ord(tk);
          node := fieldNode;
          withResolved := True;
          Break;
        end;
      end;
    end;
  end;

  if not withResolved then
  begin
    if idx < 0 then
    begin
      fldIdx := -1;
      if (CurSelfClass >= REC_UCLASS_BASE) and (CurProc >= 0) and (Procs[CurProc].ParamCount > 0) then
      begin
        selfClassCi := CurSelfClass - REC_UCLASS_BASE;
        fldIdx := FindUField(selfClassCi, fieldName);
      end;

      { Bare `GetInterface(IID, Obj)` inside a method — implicit Self, which is how
        testutils' QueryInterface calls it. Only when the class has no method of that
        name, so a user's own GetInterface still wins. }
      if (CurSelfClass >= REC_UCLASS_BASE) and (CurProc >= 0) and
         (Procs[CurProc].ParamCount > 0) and
         CaseEqual(fieldName, 'GetInterface') and (CurTok.Kind = tkLParen) and
         (FindUMeth(CurSelfClass - REC_UCLASS_BASE, 'GetInterface') < 0) and
         (FindProc('__pxxGetInterface') >= 0) then
      begin
        selfIdx := Procs[CurProc].Params[0].SymIdx;
        selfNode := AllocNode(AN_IDENT);
        ASTIVal[selfNode] := selfIdx;
        { Self is tyClass for a class method but tyRecord for an ADVANCED RECORD's method
          — take the symbol's real type rather than assuming a class, or a record Self is
          dereferenced as an object pointer and the field access segfaults. }
        ASTTk[selfNode] := Ord(Syms[selfIdx].TypeKind);
        fldIdx := GenMakeGetInterfaceCall(selfNode);
        if fldIdx >= 0 then
        begin
          tk := tyBoolean;
          recName := REC_NONE;
          Result := fldIdx;
          Exit;
        end;
      end;

      { Bare `class var` name inside a method body (fpcunit's `Inc(AssertCount)`).
        Keyed on CurMethClass, not CurSelfClass, so it also resolves in a `class
        procedure` — that is static, has no Self, and a class var needs none: its
        storage is one shared global. An instance field of the same name wins,
        matching FPC. }
      cvIdx := -1;
      if (fldIdx < 0) and (CurMethClass >= REC_UCLASS_BASE) and (CurProc >= 0) then
        cvIdx := FindClassVar(CurMethClass - REC_UCLASS_BASE, fieldName);
      if cvIdx >= 0 then
      begin
        { Re-enter with the backing global resolved: the idx >= 0 path already
          handles every suffix (index, field, deref) on it. }
        Result := ParseLValueAST(cvIdx, identTokIdx);
        Exit;
      end;

      if fldIdx >= 0 then
    begin
      { --strict-visibility: a bare (implicit-Self) field access. Own-class members
        always pass; the check bites an INHERITED strict-private field reached from
        a descendant method (tclass12b). }
      if StrictVisibility then
        EnforceMemberVis(FieldDeclClass(fldIdx), UFldVis[fldIdx], fieldName);
      selfIdx := Procs[CurProc].Params[0].SymIdx;
      selfNode := AllocNode(AN_IDENT);
      ASTIVal[selfNode] := selfIdx;
      ASTTk[selfNode] := Ord(Syms[selfIdx].TypeKind);   { tyRecord for an advanced-record method }

      fieldNode := AllocNode(AN_FIELD);
      ASTLeft[fieldNode] := selfNode;
      ASTSOffset[fieldNode] := Tokens[prevTok].SOffset;
      ASTSLen[fieldNode] := Tokens[prevTok].SLen;

      tk := IntToTypeKind(UFldTk[fldIdx]);
      recName := UFldRec_[fldIdx];
      ASTTk[fieldNode] := Ord(tk);

      node := fieldNode;

      { Indirect call through a procedural-type FIELD, unqualified inside a
        method: FOnKeyPtrCompare(a, b) == Self.FOnKeyPtrCompare(a, b)
        (fgl's compare-callback fields). Mirrors the qualified rec.field(args)
        path below. }
      if (CurTok.Kind = tkLParen) and (not UFldIsArray[fldIdx]) and
         ((tk = tyPointer) or (tk = tyRecord)) and (UFldProcSig[fldIdx] >= 0) then
      begin
        fldSigPi := UFldProcSig[fldIdx];
        isMethodPtr := (tk = tyRecord);
        Expect(tkLParen, '(');
        argsHead2 := -1; lastArg2 := -1;
        while CurTok.Kind <> tkRParen do
        begin
          ParseExpr;
          argSeq2 := AllocNode(AN_ARG);
          ASTLeft[argSeq2] := CurASTNode;
          if argsHead2 = -1 then argsHead2 := argSeq2
          else ASTRight[lastArg2] := argSeq2;
          lastArg2 := argSeq2;
          if CurTok.Kind = tkComma then Next
          else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
        end;
        Expect(tkRParen, ')');
        callIndNode := AllocNode(AN_CALL_IND);
        ASTLeft[callIndNode]  := argsHead2;
        ASTRight[callIndNode] := fieldNode;
        ASTIVal[callIndNode]  := fldSigPi;
        ASTTk[callIndNode]    := Ord(Procs[fldSigPi].RetType);
        if isMethodPtr then ASTSLen[callIndNode] := 1 else ASTSLen[callIndNode] := 0;
        node := callIndNode;
        tk := Procs[fldSigPi].RetType;
        recName := ProcRetRecId[fldSigPi];
      end;
    end
    else if (CurSelfClass >= REC_UCLASS_BASE) and (CurProc >= 0)
            and (Procs[CurProc].ParamCount > 0)
            and (FindUProp(CurSelfClass - REC_UCLASS_BASE, fieldName) >= 0) then
    begin
      { Bare (unqualified) property access inside a method -> implicit Self.<prop>.
        Field-backed read/write rewrites to the backing field (like the bare-field
        path above) using the correct accessor for the context. Method-backed READ
        builds the getter call; an INDEXED property builds the getter/setter call
        with the [index] args (fgl's InternalItems[i] / [i] := v). A non-indexed
        method-backed WRITE stays Self.<prop> := ... (needs the RHS earlier than
        this path sees it). See bug-unqualified-property-in-method. }
      selfClassCi := CurSelfClass - REC_UCLASS_BASE;
      pri := FindUProp(selfClassCi, fieldName);
      isAssign := (CurTok.Kind = tkAssign);
      selfIdx := Procs[CurProc].Params[0].SymIdx;
      selfNode := AllocNode(AN_IDENT);
      ASTIVal[selfNode] := selfIdx;
      ASTTk[selfNode] := Ord(Syms[selfIdx].TypeKind);   { tyRecord for an advanced-record method }
      if UPropIsIndexed[pri] then
      begin
        if CurTok.Kind <> tkLBrack then
          Error('indexed property requires an index: ' + fieldName);
        { write iff `:=` follows the bracket group (CurTok = '[', at TokPos-1) }
        isAssign := False;
        i := TokPos - 1; w := 0;
        while i < TokCount do
        begin
          if Tokens[i].Kind = tkLBrack then Inc(w)
          else if Tokens[i].Kind = tkRBrack then
          begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
          Inc(i);
        end;
        if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
        ParsePropIndexArgs(margIdx, mlastArg);
        methName := '';
        if isAssign then
        begin
          if UPropWriteMLen[pri] = 0 then Error('indexed property has no setter: ' + fieldName);
          for i := 0 to UPropWriteMLen[pri] - 1 do
            AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
        end
        else
        begin
          if UPropReadMLen[pri] = 0 then Error('indexed property has no getter method: ' + fieldName);
          for i := 0 to UPropReadMLen[pri] - 1 do
            AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
        end;
        mmi := FindUMeth(selfClassCi, methName);
        if mmi < 0 then Error('property accessor method not found: ' + methName);
        mpi := UMthProc_[mmi];
        if UMthVirSlot[mmi] >= 0 then
        begin
          mcallNode := AllocNode(AN_VIRTUAL_CALL);
          ASTRight[mcallNode] := UMthVirSlot[mmi];
        end
        else
          mcallNode := AllocNode(AN_CALL);
        ASTIVal[mcallNode] := mpi;
        ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
        mselfArg := AllocNode(AN_ARG);
        ASTLeft[mselfArg] := selfNode;
        ASTLeft[mcallNode] := mselfArg;
        ASTRight[mselfArg] := margIdx;   { self, index... }
        if isAssign then
        begin
          Expect(tkAssign, ':=');
          ParseExpr;
          margSeq := AllocNode(AN_ARG);
          ASTLeft[margSeq] := CurASTNode;  { self, index..., value }
          ASTRight[mlastArg] := margSeq;
          Result := mcallNode;   { complete setter statement; the statement
                                   caller accepts a returned call node as-is }
          Exit;
        end;
        tk := Procs[mpi].RetType;
        if (tk = tyClass) or (tk = tyRecord) then recName := ProcRetRecId[mpi]
        else recName := REC_NONE;
        node := mcallNode;
        { falls through to the trailing-selector loop (e.g. InternalItems[i]^) }
      end
      else if isAssign then
      begin
        { assignment target: use the WRITE accessor }
        if UPropWriteFLen[pri] > 0 then
        begin
          fieldName := '';
          for i := 0 to UPropWriteFLen[pri] - 1 do
            AppendChar(fieldName, TokChars[UPropWriteFOff[pri] + i]);
          fldIdx := FindUField(selfClassCi, fieldName);
          if fldIdx < 0 then Error('property backing field not found: ' + fieldName);
          fieldNode := AllocNode(AN_FIELD);
          ASTLeft[fieldNode] := selfNode;
          ASTSOffset[fieldNode] := UPropWriteFOff[pri];
          ASTSLen[fieldNode] := UPropWriteFLen[pri];
          tk := IntToTypeKind(UFldTk[fldIdx]);
          recName := UFldRec_[fldIdx];
          ASTTk[fieldNode] := Ord(tk);
          node := fieldNode;
        end
        else if UPropWriteMLen[pri] > 0 then
        begin
          { unqualified setter-method write: Capacity := v -> Self.SetCapacity(v)
            (same complete-call-statement shape as the indexed branch above) }
          methName := '';
          for i := 0 to UPropWriteMLen[pri] - 1 do
            AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
          mmi := FindUMeth(selfClassCi, methName);
          if mmi < 0 then Error('setter method not found: ' + methName);
          mpi := UMthProc_[mmi];
          Expect(tkAssign, ':=');
          ParseExpr;
          if UMthVirSlot[mmi] >= 0 then
          begin
            mcallNode := AllocNode(AN_VIRTUAL_CALL);
            ASTRight[mcallNode] := UMthVirSlot[mmi];
          end
          else
            mcallNode := AllocNode(AN_CALL);
          ASTIVal[mcallNode] := mpi;
          ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
          mselfArg := AllocNode(AN_ARG);
          ASTLeft[mselfArg] := selfNode;
          ASTLeft[mcallNode] := mselfArg;
          margSeq := AllocNode(AN_ARG);
          ASTLeft[margSeq] := CurASTNode;   { value }
          ASTRight[mselfArg] := margSeq;
          Result := mcallNode;
          Exit;
        end
        else
          Error('property is read-only: ' + fieldName);
      end
      else if UPropReadFLen[pri] > 0 then
      begin
        { backing read field -> resolve + build Self.field }
        fieldName := '';
        for i := 0 to UPropReadFLen[pri] - 1 do
          AppendChar(fieldName, TokChars[UPropReadFOff[pri] + i]);
        fldIdx := FindUField(selfClassCi, fieldName);
        if fldIdx < 0 then Error('property backing field not found: ' + fieldName);
        fieldNode := AllocNode(AN_FIELD);
        ASTLeft[fieldNode] := selfNode;
        { source location of the BACKING field name (not the property name) — codegen
          re-resolves the field by this span, like the qualified Self.<prop> path. }
        ASTSOffset[fieldNode] := UPropReadFOff[pri];
        ASTSLen[fieldNode] := UPropReadFLen[pri];
        tk := IntToTypeKind(UFldTk[fldIdx]);
        recName := UFldRec_[fldIdx];
        ASTTk[fieldNode] := Ord(tk);
        node := fieldNode;
        { Indirect call through a PROCEDURAL-typed property, unqualified inside
          a method: OnStatus(Self, ...) with `property OnStatus: THook read
          FOnStatus` (blcksock's DoStatus). Same shape as the bare proc-field
          call above, over the backing field. }
        if (CurTok.Kind = tkLParen) and (not UFldIsArray[fldIdx]) and
           ((tk = tyPointer) or (tk = tyRecord)) and (UFldProcSig[fldIdx] >= 0) then
        begin
          fldSigPi := UFldProcSig[fldIdx];
          isMethodPtr := (tk = tyRecord);
          Expect(tkLParen, '(');
          argsHead2 := -1; lastArg2 := -1;
          while CurTok.Kind <> tkRParen do
          begin
            ParseExpr;
            argSeq2 := AllocNode(AN_ARG);
            ASTLeft[argSeq2] := CurASTNode;
            if argsHead2 = -1 then argsHead2 := argSeq2
            else ASTRight[lastArg2] := argSeq2;
            lastArg2 := argSeq2;
            if CurTok.Kind = tkComma then Next
            else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
          end;
          Expect(tkRParen, ')');
          callIndNode := AllocNode(AN_CALL_IND);
          ASTLeft[callIndNode]  := argsHead2;
          ASTRight[callIndNode] := fieldNode;
          ASTIVal[callIndNode]  := fldSigPi;
          ASTTk[callIndNode]    := Ord(Procs[fldSigPi].RetType);
          if isMethodPtr then ASTSLen[callIndNode] := 1 else ASTSLen[callIndNode] := 0;
          node := callIndNode;
          tk := Procs[fldSigPi].RetType;
          recName := ProcRetRecId[fldSigPi];
        end;
      end
      else if UPropReadMLen[pri] > 0 then
      begin
        { backing getter method -> build a (virtual) call with Self as arg }
        methName := '';
        for i := 0 to UPropReadMLen[pri] - 1 do
          AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
        mmi := FindUMeth(selfClassCi, methName);
        if mmi < 0 then Error('property getter method not found: ' + methName);
        mpi := UMthProc_[mmi];
        if UMthVirSlot[mmi] >= 0 then
        begin
          mcallNode := AllocNode(AN_VIRTUAL_CALL);
          ASTRight[mcallNode] := UMthVirSlot[mmi];
        end
        else
          mcallNode := AllocNode(AN_CALL);
        ASTIVal[mcallNode] := mpi;
        ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
        mselfArg := AllocNode(AN_ARG);
        ASTLeft[mselfArg] := selfNode;
        ASTLeft[mcallNode] := mselfArg;
        tk := Procs[mpi].RetType;
        recName := REC_NONE;
        node := mcallNode;
      end
      else
        Error('property is write-only: ' + fieldName);
    end
    else
    begin
      aliasIdx := FindTypeAlias(fieldName);
      if (aliasIdx >= 0) and (CurTok.Kind = tkLParen) then
      begin
        Next; { consume '(' }
        ParseExpr;
        Expect(tkRParen, ')');
        node := AllocNode(AN_PTR_CAST);
        ASTLeft[node] := CurASTNode;
        ASTIVal[node] := aliasIdx;
        ASTTk[node]   := Ord(tyPointer);
        tk := tyPointer;
        recName := AliasElemRec[aliasIdx];
      end
      else
      begin
        ci := FindUClass(fieldName);
        if PxxDbgEnabled('a.qual') then WriteLn('PXXDBG a.qual MEMBER field=', fieldName, ' flat=', ci);
        { …case-SENSITIVELY under NilPy. FindUClass is Pascal-style
          case-insensitive, so a lowercase `f` matched `class F` and became a
          CLASS REFERENCE — since classes-as-values landed that is a VT_CLASSREF
          variant, so `f(1, 2)` compiled clean and then raised "takes 0
          positional arguments" from the ctor of a class the program never
          named. Before that feature the same lookup produced a compile error
          instead; the collision is old, only its symptom moved.
          Third site of one family, after PyIsClassTypeExact (typing) and
          PyIsExactCtorName (construction)
          (bug-nilpy-a-lowercase-name-is-hijacked-by-a-case-matching-class). }
        if (ci >= 0) and (not PyIsClassTypeExact(fieldName)) then
          ci := -1;
        { A BUILTIN type name as a RECEIVER — `list.append(self, x)`,
          `dict.__getitem__(self, k)`: how a subclass of a builtin reaches the
          base implementation it just overrode, and the reason to subclass a
          container at all. PyBuiltinBaseCi already maps these onto their pylib
          classes for the BASE-CLASS position; the name resolved there and not
          here, so `class Stack(list)` compiled and its very first line did not
          (bug-n-a-builtin-types-method-cannot-be-called-unbound).
          Only ahead of a '.': a bare `list(x)` / `dict()` is the CONVERSION
          builtin and has its own path, which this must not intercept. Exact
          lowercase, because Python is case-sensitive and `List` is not `list`. }
        if (ci < 0) and (CurTok.Kind = tkDot) and
           (fieldName = LowerCase(fieldName)) then
          ci := PyBuiltinBaseCi(fieldName);
        if ci >= 0 then
        begin
          if CurTok.Kind <> tkDot then
          begin
            { Class identifier used as a value (metaclass / class reference):
              `TForm1` passed to CreateForm etc. Yields the runtime address of
              the class's RTTI blob (PClassRTTI), resolved post-EmitRTTI. }
            { NilPy REFUSES this by name instead of miscompiling it. The blob
              address is untagged, so boxing it into a variant makes it an
              ordinary INTEGER: `for cls in [A]: cls(3)` compiled clean and then
              SEGFAULTED (jumping to the RTTI blob), `print(cls)` showed a bare
              number where CPython shows `<class '__main__.A'>`, and
              `cls = A; cls(3).v` failed with "a pointer has no members".

              Measured, not assumed: in PyExprMode this site is reached ONLY by
              the broken shapes. `isinstance(x, A)`, `except A:` and `A(...)`
              construction each have their own intercept and never arrive here,
              so refusing costs none of them.

              A refusal is the whole fix the ticket asks for at this stage — a
              segfault from ordinary valid Python is the worst outcome
              available, and this replaces it with a diagnostic naming the class
              and the workaround. Supporting it for real needs a distinct
              variant tag for a class reference, which is also what
              bug-nilpy-calling-a-non-callable-segfaults needs.
              bug-nilpy-a-class-used-as-a-value-segfaults-or-refuses }
            { …and that refusal is now LIFTED. The blob address is no longer
              untagged: under PyExprMode this node lowers to a VT_CLASSREF
              variant (tag 11), which is what tells `cls(3)` apart from a call
              through a plain def — both of which would otherwise be an integer
              payload. ASTRight = 1 is the marker the IR lowering reads; the
              other AN_CLASSREF builders in this file (isinstance, `except`, a
              class-method receiver) leave it 0 and keep the raw pointer they
              need. feature-nilpy-class-as-a-value }
            node := AllocNode(AN_CLASSREF);
            ASTIVal[node] := ci;
            ASTRight[node] := 1;
            ASTTk[node] := Ord(tyVariant);
            tk := tyVariant;
            recName := REC_NONE;
            Result := node;
            Exit;
          end;
          Expect(tkDot, '.');
          if not IsMethodNameTok then Error('expected class method name');
          fieldName := GetTokenStr(TokPos - 1);  { keyword-token names carry no SVal }
          Next;

          { `TOuter.TInner.Create` — the middle name is a nested TYPE, i.e. a
            SCOPE, not a member. Without this the lookup asked touter for a
            method called `tinner` and said "class method not found", so a
            nested class could be named in a declaration and never constructed —
            a half-working feature. Loops, because nesting does.
            bug-a-duplicate-class-name-check-is-scope-blind }
          while (CurTok.Kind = tkDot) and (FindNestedType(ci, fieldName) >= 0) do
          begin
            ci := FindNestedType(ci, fieldName);
            Expect(tkDot, '.');
            if not IsMethodNameTok then Error('expected class method name');
            fieldName := GetTokenStr(TokPos - 1);
            Next;
          end;

          { Overload-aware: `TAssert.AssertNotNull(x)` and `TAssert.AssertNotNull(msg, x)`
            are different methods. FindUMeth takes the first NAME match and ignored the
            argument count, so the wrong overload was picked (and then complained about
            the arguments it did not get). CountCallArgsAhead reads the call ahead --
            the method name is already consumed here, so it is scanning from the '('. }
          { pylib spells several Python methods under other names (itemlist,
            fetch/store, at/put); PyMethNameFor is the one translator every
            resolution path goes through, and this path did not, so
            `dict.__getitem__(self, k)` said 'class method not found' even once
            the receiver resolved. A no-op for a class that declares the name
            as written, which is every user class. }
          fieldName := PyMethNameFor(ci, fieldName);
          mmi := -1;
          { Python's UNBOUND call passes the receiver POSITIONALLY, so `self` is
            already inside CountCallArgsAhead and the arity the overload matcher
            wants is one LOWER than the class-method convention it assumes.
            Invisible while every name had a single overload — the name-only
            FindUMeth below rescued it — and a silent wrong pick the moment one
            did not: `list.__len__(self)` counted 1 argument, asked for a
            2-slot `count`, and got TPyList.count(v) with `self` handed in as
            the VALUE and no receiver at all. It SEGFAULTED.
            A static reached this way takes no positional self, so a match that
            turns out to be static is dropped and the ordinary convention below
            answers instead. bug-n-a-builtin-subclass-subscript-operator-skips-
            the-override (found landing it) }
          if (CountCallArgsAhead > 0) then
          begin
            mmi := FindUMethOverloadAhead(ci, fieldName, CountCallArgsAhead - 1);
            if (mmi >= 0) and UMthIsStatic[mmi] then mmi := -1;
          end;
          if mmi < 0 then mmi := FindUMethOverloadAhead(ci, fieldName, CountCallArgsAhead);
          if mmi < 0 then mmi := FindUMeth(ci, fieldName);

          { NilPy `Base.__init__(self, n)` — the pre-super() spelling of a
            base-class constructor call, and still ordinary Python. The ctor is
            registered under PyMethodName's 'create', so the raw name above
            finds nothing and this died on 'class method not found: __init__'
            while the neighbouring `Base.show(self)` and `super().__init__(n)`
            both worked (bug-nilpy-unbound-base-class-init-call-is-rejected).

            The flag is the load-bearing half. Resolving the name alone would
            hand a CTOR to the UMthIsCtor branch below, which CONSTRUCTS via
            BuildMetaclassNew — a fresh instance, initialised and then thrown
            away, leaving self's base fields unset with no diagnostic. That is
            a silent wrong value where we currently have a clean error, so the
            flag steers past that branch into the unbound path, which calls the
            ctor BODY with the caller's self as receiver — exactly what
            `super().__init__` already lowers to. }
          pyInitCall := False;
          if (mmi < 0) and (fieldName = '__init__') then
          begin
            mmi := FindUMethOverloadAhead(ci, 'create', CountCallArgsAhead);
            if mmi < 0 then mmi := FindUMeth(ci, 'create');
            pyInitCall := mmi >= 0;
          end;

          { A CLASS PROPERTY reached through the class name: `TJSONData.CompressedJSON := False`
            (fcl-json). Its accessors are static class methods, whose Self is the METACLASS --
            so the receiver is the class reference itself, and GenMakeStaticMethodCall does the
            rest. Checked after methods (a method of that name wins) and before class vars. }
          if mmi < 0 then
          begin
            cpPri := FindUProp(ci, fieldName);
            if cpPri >= 0 then
            begin
              cpIsAssign := (CurTok.Kind = tkAssign) or
                            ((TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign));
              cpName := '';
              if cpIsAssign then
              begin
                if UPropWriteMLen[cpPri] <= 0 then Error('class property is read-only: ' + fieldName);
                for i := 0 to UPropWriteMLen[cpPri] - 1 do
                  AppendChar(cpName, TokChars[UPropWriteMOff[cpPri] + i]);
              end
              else
              begin
                if UPropReadMLen[cpPri] <= 0 then Error('class property is write-only: ' + fieldName);
                for i := 0 to UPropReadMLen[cpPri] - 1 do
                  AppendChar(cpName, TokChars[UPropReadMOff[cpPri] + i]);
              end;
              cpMmi := FindUMeth(ci, cpName);
              if cpMmi < 0 then Error('class property accessor not found: ' + cpName);
              cpMpi := UMthProc_[cpMmi];

              mselfArg := AllocNode(AN_CLASSREF);
              ASTIVal[mselfArg] := ci;
              ASTTk[mselfArg] := Ord(tyPointer);

              if cpIsAssign then
              begin
                Expect(tkAssign, ':=');
                ParseExpr;
                mcallNode := AllocNode(AN_CALL);
                ASTIVal[mcallNode] := cpMpi;
                ASTTk[mcallNode] := Ord(Procs[cpMpi].RetType);
                margSeq := AllocNode(AN_ARG);
                ASTLeft[margSeq] := mselfArg;
                ASTLeft[mcallNode] := margSeq;
                mlastArg := AllocNode(AN_ARG);
                ASTLeft[mlastArg] := CurASTNode;    { the value }
                ASTRight[margSeq] := mlastArg;
                { the index constant, if the property declares one }
                PropIndexConstArg(cpPri, margIdx, mexprNode);
                tk := tyInteger;
                recName := REC_NONE;
                Result := mcallNode;
                Exit;
              end;

              GenVirtSlot := UMthVirSlot[cpMmi];
              mcallNode := GenMakeStaticMethodCall(cpMpi, mselfArg);
              tk := Procs[cpMpi].RetType;
              recName := ProcRetRecId[cpMpi];
              if (tk <> tyClass) and (tk <> tyRecord) then recName := REC_NONE;
              Result := mcallNode;
              Exit;
            end;
          end;

          if mmi < 0 then
          begin
            { class variable: TClass.cnt -> the backing global var (an lvalue, so
              read and write both work). }
            fldIdx := FindClassVar(ci, fieldName);
            if fldIdx >= 0 then
            begin
              node := AllocNode(AN_IDENT);
              ASTIVal[node] := fldIdx;
              ASTTk[node] := Ord(Syms[fldIdx].TypeKind);
              tk := Syms[fldIdx].TypeKind; recName := REC_NONE;
              Result := node;
              Exit;
            end;

            { `TFoo.MaxItems` — a class CONST, qualified by its class. Scoped ones
              (scalar/string/set) live under a mangled key in the class-const
              registry, resolved by walking the class chain from `ci`; visibility
              enforced under --strict-visibility. bug-pascal-class-const-visibility. }
            ccReg := FindClassConst(ci, fieldName);
            if ccReg >= 0 then
            begin
              if StrictVisibility then
                EnforceMemberVis(ClassConstCi[ccReg], ClassConstVis[ccReg], fieldName);
              ccKey := ClassConstMangle(ClassConstCi[ccReg], fieldName);
              ccNode := EmitClassConstNode(ccKey, ccTk);
              if ccNode >= 0 then
              begin
                tk := ccTk; recName := REC_NONE;
                Result := ccNode;
                Exit;
              end;
            end;

            { Legacy/global fallback — a typed class const (real storage, still
              global) or a plain unit const named through its class. }
            fldIdx := FindStrConst(fieldName);     { a STRING const lives in its own table }
            if fldIdx >= 0 then
            begin
              node := AllocNode(AN_STR_LIT);
              ASTSOffset[node] := StrConstSOff[fldIdx];
              ASTSLen[node] := StrConstSLen[fldIdx];
              ASTTk[node] := Ord(tyString);
              tk := tyString;
              recName := REC_NONE;
              Result := node;
              Exit;
            end;
            fldIdx := FindSym(fieldName);
            if (fldIdx >= 0) and (Syms[fldIdx].Kind = skConst) then
            begin
              node := AllocNode(AN_INT_LIT);
              ASTIVal[node] := Syms[fldIdx].ConstVal;
              ASTTk[node] := Ord(Syms[fldIdx].TypeKind);
              tk := Syms[fldIdx].TypeKind;
              recName := REC_NONE;
              Result := node;
              Exit;
            end;

            { A class-reference operation named on the class LITERAL itself:
              `TMid.InheritsFrom(TBase)`, `TFoo.ClassName`. The class as a value IS
              its RTTI blob pointer (AN_CLASSREF), which is exactly the blob these
              operations walk. }
            if IsClassRefOpName(fieldName) then
            begin
              mcallNode := AllocNode(AN_CLASSREF);
              ASTIVal[mcallNode] := ci;
              ASTTk[mcallNode] := Ord(tyPointer);
              mcallNode := GenMakeClassRefOp(mcallNode, fieldName, tk);
              if mcallNode >= 0 then
              begin
                recName := REC_NONE;
                Result := ParseClassRefOpTail(mcallNode, tk);
                Exit;
              end;
            end;

            Error('class method not found: ' + fieldName);
          end;
          EnforceMethVis(mmi, fieldName);
          mpi := UMthProc_[mmi];

          if UMthIsCtor[mmi] and (not pyInitCall) then
          begin
            { TClass.AnyCtor(args) as an expression (raise EListError.CreateFmt
              ... shape) — construct via the metaclass path: static classref,
              virtual-or-direct ctor dispatch, defaults filled. The
              'create'-named fast path elsewhere covers only that name. }
            node := AllocNode(AN_CLASSREF);
            ASTIVal[node] := ci;
            ASTTk[node] := Ord(tyPointer);
            node := BuildMetaclassNew(node, ci, mmi);
            tk := tyClass;
            recName := REC_UCLASS_BASE + ci;
            Result := node;
            Exit;
          end;

          { Python's UNBOUND method call: `A.who(self)` names the parent's own
            implementation and passes the receiver as the first argument. It is
            one of the two spellings Python offers for reaching an overridden
            method (super() is the other), and it was rejected outright.
            Direct, non-virtual: naming the class is what says "this body, not
            the override" (bug-nilpy-super-and-unbound-parent-method-calls). }
          if (not UMthIsStatic[mmi]) and (CurTok.Kind = tkLParen) then
          begin
            Next;
            margSeq := -1; mlastArg := -1;
            mkwCount := 0;
            while CurTok.Kind <> tkRParen do
            begin
              { …taking KEYWORD arguments, like every other call spelling does.
                This loop was a bare ParseExpr per argument, so
                `Base.__init__(self, m, background=bg)` — the standard way a
                class that extends a library widget builds its base — died on
                `Expected: )` for a ctor and `undefined variable (bg)` for any
                other method, while the SAME call through `super().__init__`
                was fine. PyKwArgIndex/PyBindKwArgs are the same pair
                PyMakeSuperCall uses; firstParam is 1 because slot 0 is the
                receiver, which this spelling passes POSITIONALLY as the first
                argument.
                bug-nilpy-an-unbound-method-call-takes-no-keyword-arguments }
              mkwIdx := PyKwArgIndex(mpi, 1);
              ParseExpr;
              mexprNode := AllocNode(AN_ARG);
              ASTLeft[mexprNode] := CurASTNode;
              ASTIVal[mexprNode] := mkwIdx;
              ASTRight[mexprNode] := -1;
              if margSeq = -1 then margSeq := mexprNode
              else ASTRight[mlastArg] := mexprNode;
              mlastArg := mexprNode;
              Inc(mkwCount);
              if CurTok.Kind = tkComma then Next else Break;
            end;
            Expect(tkRParen, ')');
            { reorder into declaration order and fill the holes a keyword left
              below the highest bound parameter; a trailing hole stays for the
              existing default path }
            PyBindKwArgs(mpi, margSeq, mlastArg, mkwCount);
            mcallNode := AllocNode(AN_CALL);
            ASTIVal[mcallNode] := mpi;
            ASTLeft[mcallNode] := margSeq;
            ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            tk := Procs[mpi].RetType;
            if (tk = tyClass) and (ProcRetRecId[mpi] >= REC_UCLASS_BASE) then
              recName := ProcRetRecId[mpi]
            else
              recName := REC_NONE;
            LastExprTk := tk;
            Result := mcallNode;
            Exit;
          end;
          if not UMthIsStatic[mmi] then
            Error('cannot call non-static method on class type directly');

          { Self (param 0) is the CLASS being named -- `TMyTest.Suite` passes TMyTest,
            which is precisely what makes the metaclass idiom work. Passed even with no
            argument list, since it is not optional.

            The argument list itself goes through GenMakeStaticMethodCall, the same builder
            the bare and instance-reached forms use -- so an `array of const` LITERAL
            argument (`TJSONData.DoError(msg, ['Nil', x])`, fpjson) is recognised here too.
            This block used to hand-roll its own arg loop, which parsed the '[' as a SET and
            died on "set item must be one character". }
          if UClsIsRecord[ci] then
          begin
            { a record/type HELPER's static reached through the TYPE name
              (TU32Helper.GetSignMask): no metaclass exists — Self is a
              by-value dummy the static body may not read. }
            mselfArg := AllocNode(AN_INT_LIT);
            ASTIVal[mselfArg] := 0;
            ASTTk[mselfArg] := Ord(Procs[mpi].Params[0].TypeKind);
          end
          else
          begin
            mselfArg := AllocNode(AN_CLASSREF);
            ASTIVal[mselfArg] := ci;
            ASTTk[mselfArg] := Ord(tyPointer);
          end;
          GenVirtSlot := UMthVirSlot[mmi];
          mcallNode := GenMakeStaticMethodCall(mpi, mselfArg);
          tk := Procs[mpi].RetType;
          recName := ProcRetRecId[mpi];
          if (tk <> tyClass) and (tk <> tyRecord) then recName := REC_NONE;

          Result := mcallNode;
          Exit;
        end
        else
        begin
          ErrorIdent := fieldName;
          if HiddenByDeclOrder(fieldName) then
            Error('undefined variable — it is a global declared later, declare it before use')
          else if HiddenByForwardOrder(fieldName) then
            Error('routine used before its declaration — define it above, or add a forward; declaration (--strict/require-forward)')
          else
            Error('undefined variable');
        end;
      end;
    end;
  end
  else
  begin
    node := AllocNode(AN_IDENT);
    ASTIVal[node] := idx;
    ASTSOffset[node] := Tokens[prevTok].SOffset;
    ASTSLen[node] := Tokens[prevTok].SLen;
    tk := Syms[idx].TypeKind;
    recName := Syms[idx].RecName;
    ASTTk[node] := StrValTk(tk);   { frozen fixed/short string presents as a tyString value }
    { NilPy FRAME CELL: the name's storage is a heap word shared with every
      closure over this frame, so reading it is `hidden^`. Same rewrite
      PyMakeIdent does for the paths that build the node themselves; this is the
      one the ordinary expression grammar takes (see SymCellPtr). }
    if (SymCellPtr[idx] >= 0) then
    begin
      ASTIVal[node] := SymCellPtr[idx];   { the CELL, not the name's dead slot }
      ASTTk[node] := Ord(tyPointer);
      derefNode := AllocNode(AN_DEREF);
      ASTLeft[derefNode] := node;
      ASTTk[derefNode] := Ord(tk);
      node := derefNode;
    end;
  end;
  end;

  while CurTok.Kind in [tkLBrack, tkDot, tkCaret] do
  begin
    if CurTok.Kind = tkCaret then
    begin
      Next;
      indexNode := AllocNode(AN_DEREF);
      ASTLeft[indexNode] := node;
      if tk = tyPointer then
      begin
        remDepth := 0;
        ptrBaseTk := Ord(tyUnknown);
        ptrBaseRec := REC_NONE;
        if ASTKind[node] = AN_IDENT then
        begin
          tk := Syms[ASTIVal[node]].PtrElemTk;
          recName := Syms[ASTIVal[node]].PtrElemRec;
          if SymPtrDepth[ASTIVal[node]] > 0 then
          begin
            remDepth := SymPtrDepth[ASTIVal[node]] - 1;
            ptrBaseTk := SymPtrBaseTk[ASTIVal[node]];
            ptrBaseRec := SymPtrBaseRec[ASTIVal[node]];
          end;
        end
        else if ASTKind[node] = AN_FIELD then
        begin
          baseNode := ASTLeft[node];
          baseRec := ResolveNodeRec(baseNode);
          fieldName := GetASTIdentName(node);
          fIdx := -1;
          if baseRec >= REC_UCLASS_BASE then
            fIdx := FindUField(baseRec - REC_UCLASS_BASE, fieldName);
          if fIdx >= 0 then
          begin
            tk := IntToTypeKind(UFldPtrElemTk[fIdx]);
            recName := UFldPtrElemRec[fIdx];
          end
          else
          begin
            tk := tyUnknown;
            recName := REC_NONE;
          end;
        end
        else if ASTKind[node] = AN_INDEX then
        begin
          baseNode := ASTLeft[node];
          if ASTKind[baseNode] = AN_IDENT then
          begin
            tk := Syms[ASTIVal[baseNode]].PtrElemTk;
            recName := Syms[ASTIVal[baseNode]].PtrElemRec;
          end
          else
          begin
            tk := tyUnknown;
            recName := REC_NONE;
          end;
        end
        else if ASTKind[node] = AN_DEREF then
        begin
          if ASTSOffset[node] > 0 then
          begin
            remDepth := ASTSOffset[node] - 1;
            ptrBaseTk := ASTSLen[node];
            ptrBaseRec := ASTIVal[node];
            if remDepth >= 1 then
            begin
              tk := tyPointer;
              recName := ptrBaseRec;
            end
            else if ptrBaseTk <> Ord(tyUnknown) then
            begin
              tk := IntToTypeKind(ptrBaseTk);
              recName := ptrBaseRec;
            end
            else
            begin
              tk := tyUnknown;
              recName := REC_NONE;
            end;
          end
          else
          begin
            tk := tyInteger;
            recName := REC_NONE;
          end;
        end
        else
        begin
          tk := tyInteger;
          recName := REC_NONE;
        end;
        if remDepth >= 1 then
        begin
          tk := tyPointer;
          recName := ptrBaseRec;
        end;
        ASTSOffset[indexNode] := remDepth;
        ASTSLen[indexNode] := ptrBaseTk;
        if ptrBaseRec > 0 then ASTIVal[indexNode] := ptrBaseRec;
      end
      else
        Error('dereferenced value is not a pointer');
      ASTTk[indexNode] := StrValTk(tk);
      node := indexNode;
    end
    else if CurTok.Kind = tkLBrack then
    begin
      { `v[key]` / `v[key] = val` on a VARIANT base — dispatched to pyvar_getitem
        / pyvar_setitem at run time (dict by key, list by int). A variant that
        holds a container reaches here as an ordinary ident subscript. }
      if (tk = tyVariant) then
      begin
        Next;                     { consume '[' }
        { a `:` in the group makes it a SLICE — `token[:n]` on a variant. }
        if CurTok.Kind = tkColon then
        begin
          node := PyParseSliceTail(node, -1);
          tk := IntToTypeKind(ASTTk[node]); recName := ASTRight[node];
          CurASTNode := node;
          Continue;
        end;
        PyParseBoolExpr;
        indexNode := CurASTNode;
        if CurTok.Kind = tkColon then
        begin
          node := PyParseSliceTail(node, indexNode);
          tk := IntToTypeKind(ASTTk[node]); recName := ASTRight[node];
          CurASTNode := node;
          Continue;
        end;
        { `v[a, b]` — a TUPLE key. Python builds a tuple from the comma-separated
          subscript, which is how a 2-D lookup is written (PIL's `px[x, y]`) and
          how any dict keyed by pairs is read. A dict-typed base already did
          this; a VARIANT base stopped at the comma and demanded the ']'. }
        if CurTok.Kind = tkComma then
          indexNode := PyMakeTupleFrom(indexNode);
        Expect(tkRBrack, ']');
        if CurTok.Kind = tkAssign then
        begin
          Next;
          PyParseBoolExpr;
          node := PyMakeVariantSetItem(node, indexNode, CurASTNode);
          tk := tyUnknown;
          Result := node;
          Exit;
        end;
        { `v[k] += x` on a VARIANT base. Only tkAssign was handled, so an
          augmented token fell through to the getter below and the enclosing
          augmented-assign machinery built a value that was never stored —
          SILENTLY. `d["a"]["n"] += 1` left n at 0 while the plain
          `d["a"]["n"] = d["a"]["n"] + 1` worked, and so did `e["n"] += 1` one
          level up, because a STATICALLY dict-typed base takes the
          default-indexed-property path instead. Any variant base hits this:
          a nested container (`grid[0][0] += 1`), or a local bound from one
          (`row = grid[0]; row[0] += 1`).
          Desugared to `v[k] = v[k] OP x` like the property path does, and like
          it, the base and index expressions are evaluated TWICE — the same
          accepted trade, invisible for the pure index expressions this reaches
          (bug-nilpy-augmented-assign-through-a-variant-subscript-is-dropped). }
        augTk2 := PyAugBinTok(CurTok.Kind);
        if (augTk2 <> tkEOF) then
        begin
          Next;
          PyParseBoolExpr;
          binNode := AllocNode(AN_BINOP);
          ASTIVal[binNode] := Ord(augTk2);
          ASTLeft[binNode] := PyMakeVariantGetItem(node, indexNode);
          ASTRight[binNode] := CurASTNode;
          ASTTk[binNode] := Ord(tyVariant);
          node := PyMakeVariantSetItem(node, indexNode, binNode);
          tk := tyUnknown;
          Result := node;
          Exit;
        end;
        node := PyMakeVariantGetItem(node, indexNode);
        tk := tyVariant; recName := REC_NONE;
        Continue;
      end;
      { NilPy SLICE on an lvalue base, e.g. `self.memory[a:b]`. Diverted here,
        before the default-indexed-property path below, because that path
        consumes the bracket itself — so the decision has to be made by
        lookahead (a depth-1 ':' in the group). A plain `[i]` still falls
        through to the property machinery unchanged. }
      if PyIsSliceBase(node) and PySliceBracketAt(TokPos - 1) then
      begin
        Next;                     { consume '[' }
        if CurTok.Kind = tkColon then
          node := PyParseSliceTail(node, -1)
        else
        begin
          PyParseBoolExpr;
          node := PyParseSliceTail(node, CurASTNode);
        end;
        tk := IntToTypeKind(ASTTk[node]);
        recName := ASTRight[node];
        CurASTNode := node;
        continue;                 { a slice result can take further postfix }
      end;
      { Default indexed property: `obj[i]` → obj.<default>[i] getter/setter. }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) then
      begin
        mci := recName - REC_UCLASS_BASE;
        pri := FindDefaultProp(mci);
        { …but a class's OWN __getitem__/__setitem__ beats a default property it
          merely INHERITED. pylib's containers declare one (`Items[]`), and
          since a subclass of them became a real container to the frontend it
          inherited that property too — so `c[k] = v` on a dict subclass went
          straight to pylib's store() and the __setitem__ written for it ran
          zero times, silently. Dropping pri here hands the subscript to the
          __getitem__/__setitem__ arm below, the same one a plain user class
          takes, rather than growing a second dunder path beside it.
          bug-n-a-builtin-subclass-subscript-operator-skips-the-override }
        if (pri >= 0) and PySubscriptWantsDunder(mci, TokPos - 1) then
          pri := -1;
        if pri >= 0 then
        begin
          { peek past the [...] group for a trailing := (assignment context) }
          isAssign := False;
          i := TokPos - 1; w := 0;   { TokPos-1 = the '[' }
          while i < TokCount do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(w)
            else if Tokens[i].Kind = tkRBrack then
            begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
            Inc(i);
          end;
          if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
          { `d[k] += v` — an AUGMENTED assignment to a subscript. Python's most
            common counting idiom, and it reported "assignment target is not an
            lvalue" because the subscript lowered to a getter CALL and the
            augmented path then built an AN_ASSIGN over it. Desugared to
            `d[k] = d[k] OP v`; the index expression is evaluated twice, which is
            the same trade the `del d[k]` rewrite makes and is invisible for the
            pure index expressions the corpus uses.
            (feature-nilpy-augmented-subscript-assign) }
          augBin := tkEOF;
          augPow := False;
          if (i < TokCount) then
          begin
            augBin := PyAugBinTok(Tokens[i].Kind);
            if augBin <> tkEOF then isAssign := True
            { `xs[0] **= 5`. `**` is not a binary TOKEN in this frontend — it
              lowers through PyMakePow, not AN_BINOP — so PyAugBinTok has
              nothing to return for tkPowEq and this route saw no assignment at
              all ("expected expression"). The third and last of the three
              augmented-assign target shapes to get its own arm; the other two
              live in pyparser.inc and are keyed on tkPowEq the same way.
              bug-nilpy-pow-assign-to-a-subscript-does-not-parse }
            else if Tokens[i].Kind = tkPowEq then
            begin augPow := True; isAssign := True; end;
          end;

          ParsePropIndexArgs(margIdx, mlastArg);   { [a {, b}] (bracket consumed here) }
          { NilPy: a SEQUENCE subscript asks the index for its `__index__`, so
            `xs[C(2)]` / `b[C(2)]` on a NAMED container reach the getter with an
            integer instead of the instance HANDLE (which raised IndexError, and
            only by luck — a smaller handle would have indexed the wrong
            element). A LITERAL receiver already went through PyMakeSuffixIndex.

            Gated on the receiver being a sequence, NOT applied in
            ParsePropIndexArgs: a dict subscript comes through here too, and a
            dict KEY is the object itself. Coercing it collapsed an object key
            onto its __index__ value — measured, `d[K(1)]` and `d[1]` became one
            entry (bug-nilpy-unary-numeric-dunders-return-raw-handle). }
          if PyClassWantsIntIndex(mci) then
          begin
            { ...and an object with NO `__index__` raises TypeError rather than
              reaching the getter with its handle — the same substitution the
              literal-receiver path makes (PyIndexNotIntKind). Only for a
              sequence; PyClassWantsIntIndex is already that gate. }
            i := PyIndexNotIntKind(PyIndexSeqKindCi(mci), ASTLeft[margIdx]);
            if i >= 0 then ASTLeft[margIdx] := i
            else ASTLeft[margIdx] := PyIndexCoerce(ASTLeft[margIdx]);
          end;

          if isAssign then
          begin
            if UPropWriteMLen[pri] <= 0 then Error('default property is read-only');
            methName := '';
            for i := 0 to UPropWriteMLen[pri] - 1 do AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
            mmi := FindUMeth(mci, methName);
            if mmi < 0 then Error('setter method not found: ' + methName);
            mpi := UMthProc_[mmi];
            augRead := -1;
            if (augBin <> tkEOF) or augPow then
            begin
              { EVALUATE THE BASE AND THE INDEX ONCE. The read and the write both
                reference them, and an AST node used in two places is EMITTED
                twice — so `e[key()] += 1` called key() TWICE where CPython calls
                it once. The stored value was right, which is why only a
                SIDE-EFFECTING index could observe it.

                Binding to hidden temps first also pins Python's evaluation
                order (base, then index, then the value), and makes the clone
                below harmless: cloning an IDENT duplicates a read of a temp,
                not the expression that produced it.
                bug-nilpy-augmented-subscript-evaluates-its-index-twice }
              node := PyEvalOnce(node);
              if margIdx >= 0 then
                ASTLeft[margIdx] := PyEvalOnce(ASTLeft[margIdx]);
              { the read is built HERE, over a CLONE of the index arguments: the
                setter appends its value to margIdx's chain, and sharing that
                chain with the reader made the value an argument of the read —
                a cycle the compiler walked forever (it segfaulted). }
              augRead := PyMakeSubscriptRead(node, PyCloneArgChain(margIdx), mci, pri);
              Next;                                 { consume the `+=` token }
            end
            else Expect(tkAssign, ':=');
            { NilPy value expression: two divergences from the Pascal reader.
              (1) `d[k] = None` stores a real None (VT_EMPTY variant), not the
              nil pointer literal — parsed as nil it boxed integer 0 and
              `d[k] is None` tag-tested false afterwards
              (feature-nilpy-none-variant, same fix as the literal routes).
              (2) The value must go through the PY expression grammar:
              Python's bit operators (& | ^ << >>) live in the Py layers, so
              ParseExpr STOPPED before them — `m[addr] = len(b) & 0xFF`
              silently stored only `len(b)`'s lowering with `& 0xFF` dangling
              (uforth C" wrote a zero length byte; FIND then matched nothing). }
            if CurTok.Kind = tkNil then
            begin
              Next;
              CurASTNode := PyMakeNone;
            end
            else
              PyParseBoolExpr;
            if augPow then
              { value := <current element> ** <rhs> — PyMakePow, not AN_BINOP,
                and it carries the __pow__/__rpow__ dispatch with it. }
              CurASTNode := PyMakePow(augRead, CurASTNode)
            else if augBin <> tkEOF then
            begin
              { value := <current element> OP <rhs> }
              augNode := AllocNode(AN_BINOP);
              ASTIVal[augNode] := Ord(augBin);
              ASTLeft[augNode] := augRead;
              ASTRight[augNode] := CurASTNode;
              ASTTk[augNode] := Ord(tyVariant);
              CurASTNode := augNode;
            end;
            if UMthVirSlot[mmi] >= 0 then begin mcallNode := AllocNode(AN_VIRTUAL_CALL); ASTRight[mcallNode] := UMthVirSlot[mmi]; end
            else mcallNode := AllocNode(AN_CALL);
            ASTIVal[mcallNode] := mpi; ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            mselfArg := AllocNode(AN_ARG); ASTLeft[mselfArg] := node; ASTLeft[mcallNode] := mselfArg;
            { The setter is an ordinary Pascal PROCEDURE (no result) — store
              the value into a hidden temp FIRST, pass THAT as the setter's
              argument, then yield the temp as this store's own "value".
              Returning the void setter-call node directly silently dropped
              the value whenever this store nested inside another
              assignment's RHS (`xs[0] = xs[1] = 3`, right-associative);
              this gives Python's actual chained-assignment semantics
              instead. NilPy only: Pascal has no chained assignment and its
              own statement-level caller expects the plain call node below
              (bug-nilpy-chained-subscript-assignment-writes-only-the-last-target). }
            tk := IntToTypeKind(UPropTk[pri]);
            setTmpSym := AllocVar(PyHiddenName('setval'), tk);
            setTmpAssign := AllocNode(AN_ASSIGN);
            ASTLeft[setTmpAssign] := PyMakeIdent(setTmpSym);
            ASTRight[setTmpAssign] := CurASTNode;
            margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := PyMakeIdent(setTmpSym);
            ASTRight[mselfArg] := margIdx; ASTRight[mlastArg] := margSeq;
            setInnerComma := AllocNode(AN_COMMA);
            ASTLeft[setInnerComma] := mcallNode;
            ASTRight[setInnerComma] := PyMakeIdent(setTmpSym);
            ASTTk[setInnerComma] := Ord(tk);
            node := AllocNode(AN_COMMA);
            ASTLeft[node] := setTmpAssign;
            ASTRight[node] := setInnerComma;
            ASTTk[node] := Ord(tk);
            Result := node; Exit;
          end
          else
          begin
            if UPropReadMLen[pri] <= 0 then Error('default property is write-only');
            methName := '';
            for i := 0 to UPropReadMLen[pri] - 1 do AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
            mmi := FindUMeth(mci, methName);
            if mmi < 0 then Error('getter method not found: ' + methName);
            mpi := UMthProc_[mmi];
            if UMthVirSlot[mmi] >= 0 then begin mcallNode := AllocNode(AN_VIRTUAL_CALL); ASTRight[mcallNode] := UMthVirSlot[mmi]; end
            else mcallNode := AllocNode(AN_CALL);
            ASTIVal[mcallNode] := mpi; ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            mselfArg := AllocNode(AN_ARG); ASTLeft[mselfArg] := node; ASTLeft[mcallNode] := mselfArg;
            ASTRight[mselfArg] := margIdx;
            node := mcallNode;
            tk := IntToTypeKind(UPropTk[pri]); recName := UPropRec[pri];
            ASTTk[node] := StrValTk(tk);
            continue;   { allow further postfix on the getter result }
          end;
        end
        else if (mci >= 0) and (not PyInDelTarget) and
                (FindUMeth(mci, '__getitem__') < 0) and
                (FindUMeth(mci, '__setitem__') < 0) and
                (not PyRecIsPylibOwnClass(REC_UCLASS_BASE + mci)) and
                (PyNotSubscriptableNode(mci) >= 0) then
        begin
          { A user class with NO `__getitem__` at all. It used to fall past this
            point to the generic AN_INDEX below — pointer arithmetic on the
            instance handle — and yield a plausible NUMBER or end the program.
            Declaring a SIBLING member (`__setitem__`, `__delitem__`) did not
            rescue it, because the arm below tests `__getitem__` specifically,
            which is what made "the class clearly supports subscripting" and
            "the read is garbage" coexist.

            Replaced by a run-time TypeError naming the class, which is what
            CPython raises — at RUN time, so `try: obj[k] / except TypeError:`
            still compiles.

            This arm is now for a class declaring NEITHER member. It used to be
            `__getitem__` alone, and it said it left `obj[k] = v` on a
            `__setitem__`-only class to "the write path below" — but "below" is
            the next arm of an else-if CHAIN, so matching here skipped it, and
            the write fell to the generic AN_INDEX and reported "expected
            expression". The gate now names both members and the arm below
            accepts either, which is what actually reaches that write path
            (bug-nilpy-setitem-without-getitem-write-does-not-compile).

            A WRITE into a class with neither member gets the same treatment as
            a read: PyNoSetitemError at run time, rather than the pointer
            arithmetic on the instance handle it used to fall through to.
            bug-nilpy-subscript-read-without-getitem-yields-garbage }
          isAssign := False;
          i := TokPos - 1; w := 0;   { TokPos-1 = the '[' }
          while i < TokCount do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(w)
            else if Tokens[i].Kind = tkRBrack then
            begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
            Inc(i);
          end;
          if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
          Next;                     { consume '[' }
          ParseExpr;                { the key is still evaluated, as Python does }
          Expect(tkRBrack, ']');
          if not isAssign then
          begin
            node := PyNotSubscriptableNode(mci);
            tk := tyInt64; recName := REC_NONE;
            continue;
          end;
          { `obj[k] = v` with no __setitem__ anywhere: evaluate the value too
            (Python's left-to-right order) and raise the same runtime error the
            getter-bearing arm raises for a missing setter. }
          Expect(tkAssign, ':=');
          PyParseBoolExpr;
          node := PyClassErrCallNode('PyNoSetitemError', mci);
          if node < 0 then Error('Nil Python: pylib (PyNoSetitemError) not loaded');
          Result := node; Exit;
        end
        else if (FindUMeth(mci, '__getitem__') >= 0) or
                (FindUMeth(mci, '__setitem__') >= 0) then
        begin
          { A user class with NO Pascal default property (pylib's own
            TPyList/TPyDict declare one; a plain user class never does) but
            defining Python's `__getitem__`/`__setitem__`. Without this,
            `obj[i]` fell all the way through to the generic AN_INDEX
            fallback below — raw array/pointer arithmetic on the instance,
            a silent WRONG value (`0` observed), not even a crash.
            Single-key subscript only (no `obj[a, b]` tuple key, no `+=`
            augmented form) -- the common shape; either loudly errors below
            rather than guessing.
            bug-nilpy-dunder-protocols-ignored-fall-back-to-handle-arithmetic }
          isAssign := False;
          i := TokPos - 1; w := 0;   { TokPos-1 = the '[' }
          while i < TokCount do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(w)
            else if Tokens[i].Kind = tkRBrack then
            begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
            Inc(i);
          end;
          if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True
          else if (i < TokCount) and ((PyAugBinTok(Tokens[i].Kind) <> tkEOF)
                                      or (Tokens[i].Kind = tkPowEq)) then
            { tkPowEq is listed explicitly: `**` has no binary token, so
              PyAugBinTok returns tkEOF for it and `obj[k] **= v` fell past this
              named refusal into a bare "expected expression". }
            Error('Nil Python: augmented assignment to a __getitem__/__setitem__ '
                  + 'subscript is not supported');
          Next;                       { consume '[' }
          PyParseBoolExpr;
          keyNode := CurASTNode;
          if CurTok.Kind = tkComma then
            Error('Nil Python: __getitem__/__setitem__ with a tuple key is not supported');
          Expect(tkRBrack, ']');
          if isAssign then
          begin
            Expect(tkAssign, ':=');
            PyParseBoolExpr;
            if FindUMeth(mci, '__setitem__') < 0 then
            begin
              { A genuine runtime error (a `try/except` around this must
                still compile and run its handler), not a compile-time
                Error() -- same reasoning as PyNotContainerError /
                PyNotCallableError above. The value is still parsed/
                evaluated first, matching Python's left-to-right order. }
              node := PyClassErrCallNode('PyNoSetitemError', mci);
              if node < 0 then Error('Nil Python: pylib (PyNoSetitemError) not loaded');
              Result := node; Exit;
            end;
            node := PyCallMeth2(mci, '__setitem__', node, keyNode, CurASTNode);
            Result := node; Exit;
          end
          else
          begin
            { …and the mirror of the missing-setter case: this arm is now
              entered for a class declaring only `__setitem__`, so a READ has
              no getter to call. Same run-time TypeError the neither-member arm
              above raises, rather than a compile error — `try: obj[k] /
              except TypeError:` must still compile.
              bug-nilpy-setitem-without-getitem-write-does-not-compile }
            if FindUMeth(mci, '__getitem__') < 0 then
            begin
              node := PyNotSubscriptableNode(mci);
              if node < 0 then Error('Nil Python: pylib (not-subscriptable) not loaded');
              tk := tyInt64; recName := REC_NONE;
              continue;
            end;
            node := PyCallMeth1(mci, '__getitem__', node, keyNode);
            tk := IntToTypeKind(ASTTk[node]); recName := ResolveNodeRec(node);
            continue;   { allow further postfix on the getter result }
          end;
        end;
      end;
      Next;
      alreadyResolved := False;
      indexNode := AllocNode(AN_INDEX);
      ASTLeft[indexNode] := node;
      ParseExpr;
      { N-D fixed array (variable or record field), both syntaxes folded into one
        flattened 1-D index: m[i0,i1,..]/r.m[..] (commas) and m[i0][i1]..
        (consecutive brackets). Handled here so no bogus intermediate m[i0] is
        built. NodeArrNDInfo fills NDInfo* (dims) for the base. }
      isND := NodeArrNDInfo(node);
      if isND and (CurTok.Kind = tkComma) then
      begin
        NDIdxNode[0] := CurASTNode; nIdx := 1;
        while Eat(tkComma) do
        begin
          if nIdx >= NDInfoNDims then Error('too many subscripts for array');
          ParseExpr; NDIdxNode[nIdx] := CurASTNode; Inc(nIdx);
        end;
        if nIdx <> NDInfoNDims then Error('wrong number of array subscripts');
        ASTRight[indexNode] := BuildFlatNDIndex(nIdx);
        Expect(tkRBrack, ']');
      end
      else if isND and (CurTok.Kind = tkRBrack) and (Tokens[TokPos].Kind = tkLBrack) then
      begin
        NDIdxNode[0] := CurASTNode; nIdx := 1;
        Expect(tkRBrack, ']');
        while (CurTok.Kind = tkLBrack) and (nIdx < NDInfoNDims) do
        begin
          Expect(tkLBrack, '[');
          ParseExpr; NDIdxNode[nIdx] := CurASTNode; Inc(nIdx);
          Expect(tkRBrack, ']');
        end;
        if nIdx <> NDInfoNDims then Error('wrong number of array subscripts');
        ASTRight[indexNode] := BuildFlatNDIndex(nIdx);
      end
      else if CurTok.Kind = tkComma then
      begin
        { Comma sugar m[i,j,..] == m[i][j].. for jagged / dynamic arrays: build
          the same nested AN_INDEX chain the bracket form does. (Fixed N-D arrays
          took the isND branch above; this is the dynamic / jagged path.) }
        ASTRight[indexNode] := CurASTNode;
        if IsNodeArray(node) then
        begin
          if ASTKind[node] = AN_IDENT then
          begin tk := Syms[ASTIVal[node]].ElemType; recName := Syms[ASTIVal[node]].ElemRecName; end
          else recName := ResolveNodeRec(node);
        end;
        ASTTk[indexNode] := StrValTk(tk);
        node := indexNode;
        while Eat(tkComma) do
        begin
          ParseExpr;
          indexNode := AllocNode(AN_INDEX);
          ASTLeft[indexNode] := node;
          ASTRight[indexNode] := CurASTNode;
          if IsNodeArray(node) then
          begin
            if ASTKind[node] = AN_IDENT then
            begin tk := Syms[ASTIVal[node]].ElemType; recName := Syms[ASTIVal[node]].ElemRecName; end
            else recName := ResolveNodeRec(node);
          end;
          ASTTk[indexNode] := StrValTk(tk);
          node := indexNode;
        end;
        Expect(tkRBrack, ']');
        alreadyResolved := True;
      end
      else if isND then
      begin
        { Partial: a single leading subscript on an N-D fixed array names a whole
          row (sub-array). Scale it to the row's first-element flat index so the
          element-stride AN_INDEX yields the row base address. }
        ASTRight[indexNode] := BuildPartialNDRowIndex(CurASTNode);
        Expect(tkRBrack, ']');
      end
      else
      begin
        ASTRight[indexNode] := CurASTNode;
        Expect(tkRBrack, ']');
      end;
      if alreadyResolved then
        { type + node already set by the comma-sugar chain above }
      else if IsNodeArray(node) then
      begin
        if ASTKind[node] = AN_IDENT then
        begin
          tk := Syms[ASTIVal[node]].ElemType;
          recName := Syms[ASTIVal[node]].ElemRecName;
        end
        else
          recName := ResolveNodeRec(node);
      end
      else if TypeIsFrozenString(tk) or (tk = tyAnsiString) then
      begin
        tk := tyChar;
        { NilPy: Python subscripts are 0-based and allow negatives, Pascal's are
          1-based with neither, so route the whole thing through pylib rather
          than emitting a raw AN_INDEX (bug-nilpy-str-index-off-by-one). And the
          RESULT is a 1-character str, not a Char — Python has no char type, and
          a Char cannot hold a multi-byte character
          (feature-nilpy-text-string-kind). Pascal's own `s[i]` stays tyChar. }
        indexNode := PyMakeStrIndex(ASTLeft[indexNode], ASTRight[indexNode]);
        tk := tyAnsiString;
      end
      else if (tk = tyPointer) and (ASTKind[node] = AN_IDENT) then
      begin
        { pointer indexing: p[i] yields the pointed-at element type }
        tk := Syms[ASTIVal[node]].PtrElemTk;
        recName := Syms[ASTIVal[node]].PtrElemRec;
      end
      else if (tk = tyPointer) and (ASTKind[node] = AN_PTR_CAST) then
      begin
        aliasIdx := ASTIVal[node];
        tk := IntToTypeKind(AliasElemTk[aliasIdx]);
        recName := AliasElemRec[aliasIdx];
      end
      else if (tk = tyPointer) and (ASTKind[node] = AN_FIELD) then
      begin
        { pointer-typed field indexing FField[i]: element type/rec from the
          field's pointed-at metadata, so a trailing .field resolves correctly }
        baseNode := ASTLeft[node];
        baseRec := ResolveNodeRec(baseNode);
        fieldName := GetASTIdentName(node);
        fIdx := -1;
        if baseRec >= REC_UCLASS_BASE then
          fIdx := FindUField(baseRec - REC_UCLASS_BASE, fieldName);
        if fIdx >= 0 then
        begin
          tk := IntToTypeKind(UFldPtrElemTk[fIdx]);
          recName := UFldPtrElemRec[fIdx];
        end
        else
        begin
          tk := tyUnknown;
          recName := REC_NONE;
        end;
      end
      else
      begin
        if idx >= 0 then
        begin
          tk := Syms[idx].ElemType;
          recName := Syms[idx].ElemRecName;
        end
        else
        begin
          tk := tyUnknown;
          recName := REC_NONE;
        end;
      end;
      ASTTk[indexNode] := StrValTk(tk);
      node := indexNode;

      { Indirect call through a proc-typed array element: `arr[i](args)`. The
        element value is the proc pointer (tyPointer) or a {Code,Data} method
        pointer (tyRecord); AN_CALL_IND evaluates ASTRight (the index node) as the
        callee. Mirrors the record-field path below. The element signature is
        SymElemProcSig, captured at the array declaration. }
      baseNode := ASTLeft[indexNode];
      fldSigPi := -1;
      if (ASTKind[baseNode] = AN_IDENT) and (CurTok.Kind = tkLParen) and
         ((tk = tyPointer) or (tk = tyRecord)) then
        fldSigPi := SymElemProcSig[ASTIVal[baseNode]];
      if fldSigPi >= 0 then
      begin
        isMethodPtr := (tk = tyRecord);
        Expect(tkLParen, '(');
        argsHead2 := -1; lastArg2 := -1;
        while CurTok.Kind <> tkRParen do
        begin
          ParseExpr;
          argSeq2 := AllocNode(AN_ARG);
          ASTLeft[argSeq2] := CurASTNode;
          if argsHead2 = -1 then argsHead2 := argSeq2
          else ASTRight[lastArg2] := argSeq2;
          lastArg2 := argSeq2;
          if CurTok.Kind = tkComma then Next
          else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
        end;
        Expect(tkRParen, ')');
        callIndNode := AllocNode(AN_CALL_IND);
        ASTLeft[callIndNode]  := argsHead2;
        ASTRight[callIndNode] := indexNode;
        ASTIVal[callIndNode]  := fldSigPi;
        ASTTk[callIndNode]    := Ord(Procs[fldSigPi].RetType);
        if isMethodPtr then ASTSLen[callIndNode] := 1 else ASTSLen[callIndNode] := 0;
        node := callIndNode;
        tk := Procs[fldSigPi].RetType;
        recName := ProcRetRecId[fldSigPi];
      end;
    end
    else
    begin
      { `.member` directly on an ARRAY variable: arrays have no members in
        pxx (FPC's arr.Create constructor is only valid on the TYPE, and even
        that form is unsupported here). The old fall-through built a bogus
        field access that crashed at runtime (tarrconstr8). Element access
        `arr[i].field` takes the bracket branch above, strings take Length()
        style intrinsics — neither reaches this check. }
      if (ASTKind[node] = AN_IDENT) and (ASTIVal[node] >= 0) and
         Syms[ASTIVal[node]].IsArray and
         not (Syms[ASTIVal[node]].TypeKind in [tyRecord, tyClass]) then
        Error('an array variable has no members (use SetLength / index it)');
      Next;
      if CurTok.Kind in [tkEOF, tkSemicolon, tkAssign, tkRBrack, tkRParen] then Error('expected field name');
      prevTok := TokPos - 1;
      fieldName := '';
      for i := Tokens[prevTok].SOffset to Tokens[prevTok].SOffset + Tokens[prevTok].SLen - 1 do
        AppendChar(fieldName, TokChars[i]);
      { Default field-name source span = the parsed token; property-backed
        access overrides it below with the backing field's span. }
      propFOff := Tokens[prevTok].SOffset;
      propFLen := Tokens[prevTok].SLen;
      viaProp := False;

      { `x.__class__.__name__`, ahead of the dynamic-attribute fallback below —
        which is what used to claim it and raise AttributeError at run time. }
      if PyIsClassNameChainAhead then
      begin
        node := PyMakeClassNameOf(node);
        tk := tyAnsiString; recName := REC_NONE;
        Result := node;
        Exit;
      end;
      { NilPy DYNAMIC attribute on a class instance: `vm._trans_ptr` where the
        class declares no such field/method/property. Python adds attributes at
        run time; route reads to pydynattr_get and writes to pydynattr_set (the
        instance pointer keys the store). Guarded to genuinely undeclared names,
        so nothing that resolves today changes. }
      { Python's dict VIEWS, mapped before the dynamic-attribute fallback below:
        pylib spells them keylist/vallist/itemlist (dodging the default `Items[]`
        property, Pascal being case-insensitive). Undeclared as written, so
        `d.values()` used to become a dynamic attribute read of a name no object
        has, and CALLING that None-valued attribute jumped to address 0
        (bug-nilpy-dict-values-method-missing). }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) and
         (TokPos + 1 < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
         (Tokens[TokPos + 1].Kind = tkRParen) then
      begin
        if CaseEqual(fieldName, 'values') and
           (FindUMeth(recName - REC_UCLASS_BASE, 'vallist') >= 0) then
          fieldName := 'vallist'
        else if CaseEqual(fieldName, 'keys') and
                (FindUMeth(recName - REC_UCLASS_BASE, 'keylist') >= 0) then
          fieldName := 'keylist'
        { `w.destroy()` — Python's spelling of a name Pascal reserves for the
          destructor, so the façade declares `destroy_` and the Python form maps
          onto it here. Same treatment as the dict views above. }
        else if CaseEqual(fieldName, 'destroy') and
                (FindUMeth(recName - REC_UCLASS_BASE, 'destroy_') >= 0) then
          fieldName := 'destroy_';
      end;
      { A Python method name Pascal RESERVES — the library convention is a
        trailing underscore (`set_`, `destroy_`), and `cfg.set(section, key,
        value)` (configparser's own spelling) must reach it. Any argument list,
        unlike the view methods above, so this guard is only "a call follows". }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) and
         (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
      begin
        if (FindUMeth(recName - REC_UCLASS_BASE, fieldName) < 0) and
           (FindUProp(recName - REC_UCLASS_BASE, fieldName) < 0) and
           (FindUField(recName - REC_UCLASS_BASE, fieldName) < 0) and
           (FindUMeth(recName - REC_UCLASS_BASE, fieldName + '_') >= 0) then
          fieldName := fieldName + '_';
      end;
      { ...and the same for a pylib container method pylib declares under
        another name — `s.update(other)` on a set, which pylib spells
        setupdate. One table, shared with PyParseClassMethodCall's copy of this
        resolution (bug-nilpy-set-update-method-is-not-mapped). Guarded to
        names the class does NOT declare as written, so nothing that resolves
        today moves. }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) and
         (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
        fieldName := PyMethNameFor(recName - REC_UCLASS_BASE, fieldName);
      { A class attribute written BOTH through its class name and through an
        instance: the one row where Python's model is visibly different from
        copy-at-construction, so it is spelled out. The instance's own override
        wins; absent one the read falls through to the shared slot; and a write
        CREATES the override rather than touching the slot every other instance
        reads. The `pydynattr` store is the same machinery an undeclared dynamic
        attribute uses — in Python `self.x = ...` and `obj.x = ...` really are
        the same operation, whether or not the class declares `x`. }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) and
         (FindUField(recName - REC_UCLASS_BASE, fieldName) < 0) and
         (FindUMeth(recName - REC_UCLASS_BASE, fieldName) < 0) and
         (PyClsAttrOvrSlot(recName - REC_UCLASS_BASE, fieldName) >= 0) then
      begin
        cvIdx := PyClsAttrOvrSlot(recName - REC_UCLASS_BASE, fieldName);
        Next;   { consume the field name }
        if CurTok.Kind = tkAssign then
        begin
          Next;
          ParseArgExpr;
          node := PyMakeDynAttrSet(node, fieldName, CurASTNode);
          tk := tyUnknown; Result := node; Exit;
        end;
        if PyAugBinTok(CurTok.Kind) <> tkEOF then
        begin
          fldSigPi := Ord(PyAugBinTok(CurTok.Kind));
          Next;
          ParseArgExpr;
          callIndNode := AllocNode(AN_BINOP);
          ASTIVal[callIndNode] := fldSigPi;
          ASTLeft[callIndNode] := PyClsAttrOvrGet(node, fieldName, cvIdx);
          ASTRight[callIndNode] := CurASTNode;
          ASTTk[callIndNode] := Ord(tyVariant);
          node := PyMakeDynAttrSet(node, fieldName, callIndNode);
          tk := tyUnknown; Result := node; Exit;
        end;
        node := PyClsAttrOvrGet(node, fieldName, cvIdx);
        tk := tyVariant; recName := REC_NONE;
        Continue;
      end;

      { NilPyUserCode, not isNilPy: `isNilPy` is true for the WHOLE compilation,
        including every PASCAL unit loaded into it (pylib and friends), so this
        Python-only fallback was hijacking ordinary Pascal member resolution
        inside those units. `o.ClassName` on a plain `TObject` local became a
        dynamic attribute fetch and died at run time with "'Dog' object has no
        attribute 'ClassName'", while the identical `TObject(p).ClassName` — a
        different SHAPE, same type — resolved to the RTTI call and worked
        (bug-classname-on-a-tobject-local-compiles-to-a-dynamic-attr-fetch).
        Same predicate that gates every other NilPy-only rule. }
      if (tk = tyClass) and (recName >= REC_UCLASS_BASE) and
         (FindUField(recName - REC_UCLASS_BASE, fieldName) < 0) and
         (FindUMeth(recName - REC_UCLASS_BASE, fieldName) < 0) and
         (FindUProp(recName - REC_UCLASS_BASE, fieldName) < 0) and
         { a CLASS ATTRIBUTE lowered as a shared slot has no instance field on
           purpose — it is declared, not dynamic, and the class-variable branch
           further down resolves it. Without this the closed-world fallback
           claimed it first and every instance read raised AttributeError. }
         (FindClassVar(recName - REC_UCLASS_BASE, fieldName) < 0) then
      begin
        Next;   { consume the field name }
        if CurTok.Kind = tkAssign then
        begin
          Next;
          ParseArgExpr;
          node := PyMakeDynAttrSet(node, fieldName, CurASTNode);
          tk := tyUnknown; Result := node; Exit;
        end;
        { augmented assignment `vm._x += v` -> set(x, get(x) OP v). The base is
          re-read in the get; fine for the side-effect-free receivers here. }
        if PyAugBinTok(CurTok.Kind) <> tkEOF then
        begin
          fldSigPi := Ord(PyAugBinTok(CurTok.Kind));   { the binary op }
          Next;
          ParseArgExpr;
          callIndNode := AllocNode(AN_BINOP);
          ASTIVal[callIndNode] := fldSigPi;
          ASTLeft[callIndNode] := PyMakeDynAttrGet(node, fieldName);
          ASTRight[callIndNode] := CurASTNode;
          ASTTk[callIndNode] := Ord(tyVariant);
          node := PyMakeDynAttrSet(node, fieldName, callIndNode);
          tk := tyUnknown; Result := node; Exit;
        end;
        { A CALL of a name the class does not declare. Python would raise
          AttributeError; NilPy used to build a dynamic-attribute read, get None,
          and call it — a segfault before pyvar_callee_addr started checking, a
          runtime TypeError since, and either way no hint of which method. The
          class is a CLOSED world here, so the only way the name could be legal
          is a dynamic attribute holding a callable — which means some `.name =`
          exists somewhere in the module. If none does, say so at compile time
          (bug-nilpy-unknown-method-segfaults). }
        if (CurTok.Kind = tkLParen) and (not PyDynAttrEverAssigned(fieldName)) then
          Error('Nil Python: ' +
                PyRawName(UClsNOff[recName - REC_UCLASS_BASE],
                          UClsNLen[recName - REC_UCLASS_BASE])
                + ' has no method ' + fieldName);
        node := PyMakeDynAttrGet(node, fieldName);
        tk := tyVariant; recName := REC_NONE;
        Continue;
      end;

      { IMPLICIT DEREF: `p.field` where p is a pointer to a RECORD means `p^.field`
        (FPC/Delphi). Without this the AN_FIELD was built straight over the pointer,
        so the field resolved at an offset into the POINTER VALUE itself and read
        back garbage — silently, with no error. Only fires when the pointee is a
        record that really has this member, so nothing that resolves today changes:
        a metaclass (`class of T`) pointee is a CLASS, not a record, and keeps its
        own dispatch below. }
      if tk = tyPointer then
      begin
        autoDeref := AllocNode(AN_DEREF);
        ASTLeft[autoDeref] := node;
        peRec := ResolveNodeRec(autoDeref);
        if (peRec >= REC_UCLASS_BASE) and UClsIsRecord[peRec - REC_UCLASS_BASE] and
           ((FindUField(peRec - REC_UCLASS_BASE, fieldName) >= 0) or
            (FindUMeth(peRec - REC_UCLASS_BASE, fieldName) >= 0)) then
        begin
          ASTTk[autoDeref] := Ord(tyRecord);
          node := autoDeref;
          tk := tyRecord;
          recName := peRec;
        end;
      end;

      { Nil Python str methods: `s.upper()` on a string-typed base desugars to a
        pylib call (pystr_upper(s)). Gated on PyExprMode so the Pascal dialect,
        where a string has no members, keeps its existing diagnostics. Delegated
        to pyparser.inc like PyParseListLiteral — the shared parser only needs to
        know WHERE the form is legal, not what the method set is. `tk` is updated
        from the call's return type so the suffix loop keeps chaining
        (`s.strip().upper()`). }
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
         PyIsStrBaseTk(tk) then
      begin
        Next;   { consume the method name; CurTok is now the '(' }
        node := PyParseStrMethod(node, fieldName);
        tk := IntToTypeKind(ASTTk[node]);
        { CARRY the result's class identity. A str method that returns a
          CONTAINER — split/rsplit/partition/rpartition (tyClass = TPyList),
          encode (TPyBytes) — left `tk` as tyClass with recName cleared to
          REC_NONE, so an immediately following subscript had no class to
          resolve against and the AN_CALL reached IR lowering unlowered:
          `s.split(",")[1]` failed IR_UNSUPPORTED while `"a,b".split(",")[1]`
          and the two-step `p = s.split(","); p[1]` both worked
          (bug-n-nilpy-subscript-of-split-on-a-variable-receiver). The literal
          route resolves the rec off the node with ResolveNodeRec, and the
          to_bytes route just below already carries it; this is the same thing.
          A str-returning method still yields REC_NONE, so nothing else moves. }
        recName := ResolveNodeRec(node);
        Continue;
      end;

      { `n.to_bytes(...)` / `n.bit_length()` on an INT-typed base, the same
        asymmetry as the str methods above: an ident or field base is consumed
        here by the lvalue path and never reaches ParseFactor's suffix loop,
        which only ever sees non-lvalue bases like `(10).to_bytes(...)`. Both
        routes land in pyparser's one dispatcher. }
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
         PyIsIntMethodName(LowerCase(fieldName)) and
         PyIsIntMethodBaseTk(tk, LowerCase(fieldName)) then
      begin
        Next;   { consume the method name; CurTok is now the '(' }
        node := PyParseIntMethod(node, LowerCase(fieldName));
        tk := IntToTypeKind(ASTTk[node]);
        recName := ASTRight[node];
        Continue;
      end;

      { `x.is_integer()` / `.hex()` / `.as_integer_ratio()` / `.conjugate()` on
        a STATICALLY float base. Claimed only where the receiver's type is
        known — see PyIsFloatMethodName for why a name-only test would break
        bytes.hex(). bug-a-bytes-has-almost-none-of-its-python-methods }
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
         PyIsFloatMethodName(LowerCase(fieldName)) and
         PyIsFloatMethodBaseTk(tk, LowerCase(fieldName)) then
      begin
        Next;   { consume the method name; CurTok is now the '(' }
        node := PyParseFloatMethod(node, LowerCase(fieldName), PyIsIntBaseTk(tk));
        tk := IntToTypeKind(ASTTk[node]);
        recName := ASTRight[node];
        Continue;
      end;

      { Nil Python method call on a VARIANT receiver: `w.name()` where `w` is a
        for-in loop variable or any container element (every slot is a 16-byte
        variant). The receiver has no static class, so the call is resolved by
        METHOD NAME across the declared classes and the object pointer is
        unboxed from the slot — see PyParseVariantMethod
        (bug-a-nilpy-method-call-on-variant-receiver). }
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
         (tk = tyVariant) then
      begin
        Next;   { consume the method name; CurTok is now the '(' }
        node := PyParseVariantMethod(node, fieldName);
        tk := IntToTypeKind(ASTTk[node]);
        recName := ResolveNodeRec(node);
        Continue;
      end;

      { Same receiver, a PROPERTY — a Python @property with its @prop.setter.
        A property has no FIELD, so the variant branch below found nothing and
        the access fell all the way through to the DYNAMIC-ATTRIBUTE store:
        `v.compiling = True` wrote into pydynattr's side table while the getter
        went on reading `self._compiling`. The setter never ran and the write
        was silently dropped — the getter still worked, which is what made it
        look like a stale read rather than a lost write. uforth's Forth STATE
        flag is this shape, so every colon definition stayed in interpret mode
        and its body EXECUTED instead of compiling
        (bug-nilpy-property-setter-is-skipped-on-a-dynamically-typed-receiver).

        Deliberately NOT another member path: the receiver is rewritten to the
        unboxed, class-cast object and control FALLS THROUGH to the class-typed
        property handling below, which already routes a read to the getter and a
        write to the setter (indexed properties, virtual accessors and all).
        Teaching a second path to do that is how the two would drift apart —
        the very split this bug is. The field name is NOT consumed here for the
        same reason: that path expects CurTok still on it.

        Ordered after the variant METHOD branch (so `v.m()` stays a method) and
        before the variant FIELD branch (so a real field of that name still
        wins, matching the field-then-dynattr precedence everywhere else). }
      if (tk = tyVariant) then
      begin
        propRecvNode := PyMakeVariantPropRecv(node, fieldName, propRecvCi);
        if propRecvNode >= 0 then
        begin
          node := propRecvNode;
          tk := tyClass;
          recName := REC_UCLASS_BASE + propRecvCi;
        end;
      end;

      { Same receiver, no call: a plain FIELD READ off a variant — `x.name`
        where x is a for-in variable. Without it the access fell through and
        read the slot as though it were the object, printing an integer where
        the field's value belonged — silently
        (feature-nilpy-function-values found it via `w.name` in a dispatch
        table). Resolved by field NAME across the declared classes, like the
        method case. }
      if (tk = tyVariant) then
      begin
        Next;   { consume the field name, as the call branch above does }
        indexNode := PyMakeVariantField(node, fieldName, tk, recName);
        if indexNode >= 0 then begin node := indexNode; Continue; end;
        { No FIELD of that name — but a CLASS ATTRIBUTE that is written through
          its class name has no field by construction: it is one shared slot, and
          an instance read of it falls through to that slot (Python's model).
          The statically-typed receivers reach it via FindClassVar a few hundred
          lines down; a variant receiver has only the name to go on. }
        fldIdx := PyClsAttrSharedSym(fieldName, sharedNeedsOvr);
        if (fldIdx >= 0) and sharedNeedsOvr then
        begin
          { ...and if instances also write it, the same fall-through the
            statically-typed receiver gets a few hundred lines up }
          if CurTok.Kind = tkAssign then
          begin
            Next;
            PyParseBoolExpr;
            node := PyMakeDynAttrSet(node, fieldName, CurASTNode);
            tk := tyUnknown; Result := node; Exit;
          end;
          if PyAugBinTok(CurTok.Kind) <> tkEOF then
          begin
            fldSigPi := Ord(PyAugBinTok(CurTok.Kind));
            Next;
            PyParseBoolExpr;
            callIndNode := AllocNode(AN_BINOP);
            ASTIVal[callIndNode] := fldSigPi;
            ASTLeft[callIndNode] := PyClsAttrOvrGet(node, fieldName, fldIdx);
            ASTRight[callIndNode] := CurASTNode;
            ASTTk[callIndNode] := Ord(tyVariant);
            node := PyMakeDynAttrSet(node, fieldName, callIndNode);
            tk := tyUnknown; Result := node; Exit;
          end;
          node := PyClsAttrOvrGet(node, fieldName, fldIdx);
          tk := tyVariant; recName := REC_NONE;
          Continue;
        end;
        if fldIdx >= 0 then
        begin
          node := AllocNode(AN_IDENT);
          ASTIVal[node] := fldIdx;
          ASTTk[node] := Ord(Syms[fldIdx].TypeKind);
          tk := Syms[fldIdx].TypeKind;
          recName := Syms[fldIdx].RecName;
          Continue;
        end;
        { No class declares it -> a DYNAMIC attribute. `vm._trans_ptr = X`
          (assignment) becomes pydynattr_set; a read becomes pydynattr_get. }
        if CurTok.Kind = tkAssign then
        begin
          Next;
          PyParseBoolExpr;
          node := PyMakeDynAttrSet(node, fieldName, CurASTNode);
          tk := tyUnknown; Result := node; Exit;
        end;
        node := PyMakeDynAttrGet(node, fieldName);
        tk := tyVariant; recName := REC_NONE;
        Continue;
      end;

      { Metaclass-dispatched construction `classRef.Create(args)`: the base is a
        metaclass value — either a `class of T` variable (AN_IDENT, a tyPointer
        whose element is a class) or an inline metaclass cast `TFooClass(expr)`
        (AN_PTR_CAST over a `class of` alias, e.g. the streamer's
        `TComponentClass(GetClass(name)).Create(owner)`). Build AN_METACLASS_NEW,
        which allocates the DYNAMIC class the ref points at and runs its virtual
        constructor — see the IR lowering. Distinct from the static `TFoo.Create`
        path, which resolves the class at compile time. }
      { All five spellings of a metaclass VALUE answer through one predicate —
        a `class of T` variable, an inline metaclass cast, an element of an
        array of them, a metaclass-typed field, and a function RESULT. The first
        four used to be four copies of the test right here, added one ticket at
        a time, which is why the fifth was missing for so long.
        bug-a-a-metaclass-returned-from-a-function-is-not-a-receiver }
      ci := NodeMetaclassCi(node);
      if ci >= 0 then
      begin
        { A class-reference OPERATION on a TYPED metaclass (`AClass: TJSONDataClass`):
          `AClass.InheritsFrom(MinJSONInstanceTypes[AType])`, `AClass.ClassName` -- fpjson's
          SetJSONInstanceType does both. A typed metaclass carries a concrete class id, so it
          lands in this branch rather than the bare-class-reference one, and the ops had to be
          taught here too. A real member of that name on the class still wins. }
        if (CurTok.Kind = tkIdent) and IsClassRefOpName(fieldName) and
           (FindUMeth(ci, fieldName) < 0) then
        begin
          Next;                        { consume the operation name }
          mcallNode := GenMakeClassRefOp(node, fieldName, tk);
          if mcallNode >= 0 then
          begin
            recName := REC_NONE;
            Result := ParseClassRefOpTail(mcallNode, tk);
            Exit;
          end;
        end;

        { Any CONSTRUCTOR through the metaclass, not just one spelled `Create`. FPC
          names them freely -- fpcunit's suite builder calls `tc.CreateWith(name, sn)`
          -- and UMthIsCtor is what actually marks one. Matching on the NAME 'create'
          silently missed every other constructor, which then fell through to the
          member paths below and did something else entirely. }
        mmi := FindUMethOverloadAhead(ci, fieldName, CountCallArgsAhead);
        if mmi < 0 then mmi := FindUMeth(ci, fieldName);
        if (mmi >= 0) and UMthIsCtor[mmi] then
        begin
          EnforceMethVis(mmi, fieldName);
          Next; { consume the constructor name }
          node := BuildMetaclassNew(node, ci, mmi);
          recName := REC_UCLASS_BASE + ci;
          tk := tyClass;
          Continue;   { allow trailing .field/[i] selectors on the new instance }
        end;

        { A CLASS METHOD through the metaclass: `tc.SingleInstanceForSuite`. Now that
          Self is a real argument, this needs nothing special -- pass the metaclass
          VALUE as Self and the method runs against whatever class the variable holds.
          The dispatch is dynamic for free. }
        if (mmi >= 0) and UMthIsStatic[mmi] and (UMthProc_[mmi] >= 0) then
        begin
          mpi := UMthProc_[mmi];
          Next; { consume the method name }
          GenVirtSlot := UMthVirSlot[mmi];
          node := GenMakeStaticMethodCall(mpi, node);
          tk := Procs[mpi].RetType;
          recName := ProcRetRecId[mpi];
          if (tk <> tyClass) and (tk <> tyRecord) then recName := REC_NONE;
          Continue;
        end;
      end;

      { A class-reference OPERATION on ANY pointer-typed value: an array ELEMENT, a
        FIELD, a call result -- not just a bare identifier.

          MinJSONInstanceTypes[AType].ClassName      { fpjson }

        A class reference IS its RTTI blob pointer, and ClassName / ClassType /
        InheritsFrom need only that VALUE, not a compile-time class id -- so they can be
        answered for any pointer-typed expression. Nothing else on a pointer is spelled
        this way, which is what makes the test safe (the same reasoning as `is` against a
        class-reference value). Class-typed receivers with a concrete class id are handled
        further down, and take precedence via the mci path. }
      if (CurTok.Kind = tkIdent) and IsClassRefOpName(fieldName) and
         (tk = tyPointer) and (recName = REC_NONE) and
         (ASTKind[node] <> AN_IDENT) then
      begin
        Next;                          { consume the operation name }
        mcallNode := GenMakeClassRefOp(node, fieldName, tk);
        if mcallNode >= 0 then
        begin
          recName := REC_NONE;
          Result := ParseClassRefOpTail(mcallNode, tk);
          Exit;
        end;
      end;

      { Bare `object` reference (tyPointer whose element is tyClass with NO
        class id): member access cannot resolve — the reference carries no
        class. Require an explicit cast to a concrete class first
        (feature-object-reference-type). }
      if (ASTKind[node] = AN_IDENT) and (ASTIVal[node] >= 0) and
         (Syms[ASTIVal[node]].TypeKind = tyPointer) and
         (Syms[ASTIVal[node]].PtrElemTk = tyClass) and
         (Syms[ASTIVal[node]].PtrElemRec = REC_NONE) then
      begin
        { ...but the class-reference OPERATIONS are answerable on it: a TClass value
          IS the RTTI blob pointer. `GetN(C: TClass)` reads C.ClassName;
          `AClass.InheritsFrom(TTestCase)` walks C's parent chain. Both fpcunit. }
        if (CurTok.Kind = tkIdent) and IsClassRefOpName(fieldName) then
        begin
          Next;                     { consume the operation name }
          mcallNode := GenMakeClassRefOp(node, fieldName, tk);
          if mcallNode >= 0 then
          begin
            recName := REC_NONE;
            Result := ParseClassRefOpTail(mcallNode, tk);
            Exit;
          end;
        end;
        Error('member access on a bare object reference; cast to a concrete class first');
      end;

      { Check if it is a property on a class }
      mci := -1; pri := -1;
      if recName >= REC_UCLASS_BASE then
      begin
        mci := recName - REC_UCLASS_BASE;
        { NilPy `d.items()` — Python's spelling collides with TPyDict's DEFAULT
          indexed property `Items[k]` (Pascal is case-insensitive), so the name
          resolved to the property and the following `(` was a parse error. A
          CALL is unambiguous: `d.items()` can only mean the method. Mapped onto
          `itemlist`, the same way keylist/vallist are named to stay clear of it. }
        if CaseEqual(fieldName, 'items') and
           (TokPos + 1 < TokCount) and (Tokens[TokPos].Kind = tkLParen) and
           (Tokens[TokPos + 1].Kind = tkRParen) and
           (FindUMeth(mci, 'itemlist') >= 0) then
          fieldName := 'itemlist';
        { `d.keys()` / `d.values()` as VALUES, same treatment: Python's spellings
          map onto keylist/vallist. Unmapped, they fell through to the dynamic
          method dispatch and produced a garbage receiver — `max(d.values())`
          segfaulted (bug-nilpy-dict-values-method-missing). }
        if (TokPos + 1 < TokCount) and
           (Tokens[TokPos].Kind = tkLParen) and (Tokens[TokPos + 1].Kind = tkRParen) then
        begin
          if CaseEqual(fieldName, 'keys') and (FindUMeth(mci, 'keylist') >= 0) then
            fieldName := 'keylist'
          else if CaseEqual(fieldName, 'values') and (FindUMeth(mci, 'vallist') >= 0) then
            fieldName := 'vallist';
        end;
        pri := FindUProp(mci, fieldName);
      end;

      if pri >= 0 then
      begin
        isAssign := (CurTok.Kind = tkAssign) or ((TokPos < TokCount) and (Tokens[TokPos].Kind = tkAssign));
        { Indexed property `obj.Items[i] := v`: `:=` follows the subscript, not the
          name. Peek past the bracket group (CurTok = name, TokPos = `[`). }
        if UPropIsIndexed[pri] and (not isAssign) and
           (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLBrack) then
        begin
          i := TokPos; w := 0;
          while i < TokCount do
          begin
            if Tokens[i].Kind = tkLBrack then Inc(w)
            else if Tokens[i].Kind = tkRBrack then
            begin Dec(w); if w = 0 then begin Inc(i); Break; end; end;
            Inc(i);
          end;
          if (i < TokCount) and (Tokens[i].Kind = tkAssign) then isAssign := True;
        end;
        { AUGMENTED assignment through a method-backed property — `s.state += 1`.
          `isAssign` only ever tested for `:=`, so this fell into the READ arm
          below: the getter was called, its RESULT was handed to the assignment
          machinery as an lvalue, and the store went nowhere. Silently — the
          value simply never changed, on a STATICALLY typed receiver as much as a
          dynamic one, which is why it outlived the dropped-store bug it shares a
          concept with (bug-nilpy-property-setter-is-skipped-on-a-dynamically-
          typed-receiver: there the write vanished on the way IN, here on the way
          back OUT).

          Desugared the way Python defines it — `set(get() OP rhs)` — reusing
          this property's own accessors, so an override still dispatches through
          the VMT. The RECEIVER is evaluated twice (once per accessor); it is a
          variable, field or unboxed-cast read at every site that reaches here,
          so that is side-effect free — the same licence PyMakeTruthy and the
          dynamic-attribute augmented path already take, and the identical
          desugaring they use.

          Field-backed properties are untouched: they rewrite to their backing
          field above and the ordinary field lvalue handles `+=` correctly.
          Indexed properties keep the old path — the index expression would be
          evaluated twice too, and that is not always safe. }
        if (not isAssign) and (not UPropIsIndexed[pri]) and
           (UPropReadMLen[pri] > 0) and (UPropWriteMLen[pri] > 0) and
           (CurTok.Kind = tkIdent) and (TokPos < TokCount) and
           (PyAugBinTok(Tokens[TokPos].Kind) <> tkEOF) then
        begin
          methName := '';
          for i := 0 to UPropReadMLen[pri] - 1 do
            AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
          mmi := FindUMeth(mci, methName);
          if mmi < 0 then Error('getter method not found: ' + methName);
          mpi := UMthProc_[mmi];
          if UMthVirSlot[mmi] >= 0 then
          begin
            augRead := AllocNode(AN_VIRTUAL_CALL);
            ASTRight[augRead] := UMthVirSlot[mmi];
          end
          else
            augRead := AllocNode(AN_CALL);
          ASTIVal[augRead] := mpi;
          ASTTk[augRead] := Ord(Procs[mpi].RetType);
          mselfArg := AllocNode(AN_ARG);
          ASTLeft[mselfArg] := node;
          ASTRight[mselfArg] := -1;
          ASTLeft[augRead] := mselfArg;

          Next;                       { the property name }
          augBin := PyAugBinTok(CurTok.Kind);
          Next;                       { the augmented operator }
          ParseExpr;
          augNode := AllocNode(AN_BINOP);
          ASTIVal[augNode] := Ord(augBin);
          ASTLeft[augNode] := augRead;
          ASTRight[augNode] := CurASTNode;
          ASTTk[augNode] := Ord(Procs[mpi].RetType);

          methName := '';
          for i := 0 to UPropWriteMLen[pri] - 1 do
            AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
          mmi := FindUMeth(mci, methName);
          if mmi < 0 then Error('setter method not found: ' + methName);
          mpi := UMthProc_[mmi];
          if UMthVirSlot[mmi] >= 0 then
          begin
            mcallNode := AllocNode(AN_VIRTUAL_CALL);
            ASTRight[mcallNode] := UMthVirSlot[mmi];
          end
          else
            mcallNode := AllocNode(AN_CALL);
          ASTIVal[mcallNode] := mpi;
          ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
          mselfArg := AllocNode(AN_ARG);
          ASTLeft[mselfArg] := node;
          margSeq := AllocNode(AN_ARG);
          ASTLeft[margSeq] := augNode;
          ASTRight[margSeq] := -1;
          ASTRight[mselfArg] := margSeq;
          ASTLeft[mcallNode] := mselfArg;

          node := mcallNode;
          Result := node; Exit;
        end;
        if isAssign then
        begin
          if UPropWriteFLen[pri] > 0 then
          begin
            fieldName := '';
            for i := 0 to UPropWriteFLen[pri] - 1 do
              AppendChar(fieldName, TokChars[UPropWriteFOff[pri] + i]);
            propFOff := UPropWriteFOff[pri];
            propFLen := UPropWriteFLen[pri];
            viaProp := True;
          end
          else if UPropWriteMLen[pri] > 0 then
          begin
            methName := '';
            for i := 0 to UPropWriteMLen[pri] - 1 do
              AppendChar(methName, TokChars[UPropWriteMOff[pri] + i]);
            mmi := FindUMeth(mci, methName);
            if mmi < 0 then Error('setter method not found: ' + methName);
            mpi := UMthProc_[mmi];

            if CurTok.Kind = tkIdent then Next; { consume property name }
            margIdx := -1;
            if UPropIsIndexed[pri] then ParsePropIndexArgs(margIdx, mlastArg)
            else PropIndexConstArg(pri, margIdx, mlastArg);
            Expect(tkAssign, ':=');
            ParseExpr;

            if UMthVirSlot[mmi] >= 0 then
            begin
              mcallNode := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[mcallNode] := UMthVirSlot[mmi];
            end
            else
            begin
              mcallNode := AllocNode(AN_CALL);
            end;
            ASTIVal[mcallNode] := mpi;
            ASTTk[mcallNode] := Ord(Procs[mpi].RetType);

            mselfArg := AllocNode(AN_ARG);
            ASTLeft[mselfArg] := node;
            ASTLeft[mcallNode] := mselfArg;

            margSeq := AllocNode(AN_ARG);
            ASTLeft[margSeq] := CurASTNode;   { value }
            { Setter args: self [, index...], value }
            if margIdx >= 0 then
            begin
              ASTRight[mselfArg] := margIdx;
              ASTRight[mlastArg] := margSeq;
            end
            else
              ASTRight[mselfArg] := margSeq;

            node := mcallNode;
            Result := node; Exit;
          end
          else
            Error('property is read-only');
        end
        else
        begin
          if UPropReadFLen[pri] > 0 then
          begin
            fieldName := '';
            for i := 0 to UPropReadFLen[pri] - 1 do
              AppendChar(fieldName, TokChars[UPropReadFOff[pri] + i]);
            propFOff := UPropReadFOff[pri];
            propFLen := UPropReadFLen[pri];
            viaProp := True;
          end
          else if UPropReadMLen[pri] > 0 then
          begin
            methName := '';
            for i := 0 to UPropReadMLen[pri] - 1 do
              AppendChar(methName, TokChars[UPropReadMOff[pri] + i]);
            mmi := FindUMeth(mci, methName);
            if mmi < 0 then Error('getter method not found: ' + methName);
            mpi := UMthProc_[mmi];

            Next; { consume property name }
            margIdx := -1;
            if UPropIsIndexed[pri] then ParsePropIndexArgs(margIdx, mlastArg)
            else PropIndexConstArg(pri, margIdx, mlastArg);
            if UMthVirSlot[mmi] >= 0 then
            begin
              mcallNode := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[mcallNode] := UMthVirSlot[mmi];
            end
            else
            begin
              mcallNode := AllocNode(AN_CALL);
            end;
            ASTIVal[mcallNode] := mpi;
            ASTTk[mcallNode] := Ord(Procs[mpi].RetType);

            mselfArg := AllocNode(AN_ARG);
            ASTLeft[mselfArg] := node;
            ASTLeft[mcallNode] := mselfArg;
            { Getter args: self [, index...] }
            if margIdx >= 0 then ASTRight[mselfArg] := margIdx;

            node := mcallNode;
            { trailing ^ on the getter result — T(FList.Items[i]^) in fgl's
              enumerator: deref the returned (untyped) pointer; read as Int64,
              an outer ordinal cast narrows }
            while CurTok.Kind = tkCaret do
            begin
              Next;
              mselfArg := AllocNode(AN_DEREF);
              ASTLeft[mselfArg] := node;
              ASTTk[mselfArg] := Ord(tyInt64);
              node := mselfArg;
            end;

            { ...and then KEEP GOING. A getter's result is an ordinary value, so a selector
              may follow it: `Self.Items[I].Clone` (fpjson's TJSONArray.Clone). This path used
              to Exit here, leaving the `.Clone` unconsumed -- which the ASSIGNMENT path
              tolerated (the statement ended there anyway) but an argument list did not
              ("expected comma or close parenthesis"). That asymmetry is why it survived: the
              obvious way to write it, `x := obj.Items[i].Method`, happened to work. }
            tk := Procs[mpi].RetType;
            recName := ProcRetRecId[mpi];
            if (tk <> tyClass) and (tk <> tyRecord) then recName := REC_NONE;
            if (CurTok.Kind = tkDot) or (CurTok.Kind = tkLBrack) then
              node := ParseClassRecordSelectors(node, recName, tk);

            Result := node; Exit;
          end
          else
            Error('property is write-only');
        end;
      end;

      { Check if this is a method call on a user class }
      mci := -1; mmi := -1; mpi := -1;
      if recName >= REC_UCLASS_BASE then
      begin
        mci := recName - REC_UCLASS_BASE;
        { overload-aware: pick the entry matching the call's arg count }
        mmi := FindUMethOverloadAhead(mci, fieldName, CountCallArgsAhead);
        { …and re-target by KEYWORD name too — arity alone still picks the
          first same-arity overload, which need not be the one declaring the
          name a `key=expr` argument uses (bug-nilpy-keyword-arg-vs-overload-set) }
        if (mmi >= 0) then
          mmi := PyPromoteOverloadByKwAt(mci, mmi, PyKwNamesTokPos, fieldName);
      end;

      { FPC's TObject.MethodAddress(name) / MethodName(addr): published-method RTTI,
        available with no `uses` because FPC declares them on TObject in System.
        fcl-fpcunit finds its tests with `Self.MethodAddress(FName)`. Rewritten to
        the __pxxMethodAddress / __pxxMethodName helpers in the builtin unit (pulled
        by the token pre-scan). Only when the class has NO method of that name, so a
        user's own MethodAddress still wins. }
      { obj.GetInterface(IID, Obj) — the GUID lookup, same builtin-shadowing rule }
      if (mmi < 0) and (mci >= 0) and (CurTok.Kind = tkIdent) and
         (Tokens[TokPos].Kind = tkLParen) and
         CaseEqual(fieldName, 'GetInterface') and
         (FindProc('__pxxGetInterface') >= 0) then
      begin
        Next;                        { consume 'GetInterface' }
        mcallNode := GenMakeGetInterfaceCall(node);
        if mcallNode >= 0 then
        begin
          tk := tyBoolean;
          recName := REC_NONE;
          Result := mcallNode;
          Exit;
        end;
      end;

      { obj.ClassName / obj.ClassType / obj.InheritsFrom(C) -- FPC has them on TObject
        in System. An instance reaches its blob through __pxxRttiOf. Only when the
        class has no member of that name, so a user's own still wins. }
      if (mmi < 0) and (mci >= 0) and (CurTok.Kind = tkIdent) and
         IsClassRefOpName(fieldName) then
      begin
        mblobNode := GenMakeRttiOfCall(node);
        if mblobNode >= 0 then
        begin
          Next;                      { consume the operation name }
          mcallNode := GenMakeClassRefOp(mblobNode, fieldName, tk);
          if mcallNode >= 0 then
          begin
            recName := REC_NONE;
            Result := ParseClassRefOpTail(mcallNode, tk);
            Exit;
          end;
        end;
      end;

      if (mmi < 0) and (mci >= 0) and (CurTok.Kind = tkIdent) and
         (Tokens[TokPos].Kind = tkLParen) and
         (CaseEqual(fieldName, 'MethodAddress') or CaseEqual(fieldName, 'MethodName')) then
      begin
        if CaseEqual(fieldName, 'MethodAddress') then
          ci := FindProc('__pxxMethodAddress')
        else
          ci := FindProc('__pxxMethodName');
        if ci >= 0 then
        begin
          Next;                  { consume the method name }
          Expect(tkLParen, '(');
          mcallNode := AllocNode(AN_CALL);
          ASTIVal[mcallNode] := ci;
          ASTTk[mcallNode] := Ord(Procs[ci].RetType);

          { arg 0 = the instance }
          margSeq := AllocNode(AN_ARG);
          ASTLeft[margSeq] := node;
          ASTLeft[mcallNode] := margSeq;

          { arg 1 = the name (or the code address) }
          ParseExpr;
          mlastArg := AllocNode(AN_ARG);
          ASTLeft[mlastArg] := CurASTNode;
          ASTRight[margSeq] := mlastArg;

          Expect(tkRParen, ')');
          tk := Procs[ci].RetType;
          recName := REC_NONE;
          Result := mcallNode;
          Exit;
        end;
      end;

      if mmi >= 0 then
      begin
        EnforceMethVis(mmi, fieldName);
        mpi := UMthProc_[mmi];
        Next; { consume method name }
        { NilPy: `obj.method` with NO following call is a BOUND-METHOD VALUE, not
          a paren-less call (Python has no paren-less calls). Capture {code, self}
          as a callable variant. uforth's exec env = {"push": self.push, ...} needs
          this to STORE without dropping self and segfaulting.
          (feature-nilpy-bound-method-value.) Virtual methods bind now off the
          receiver's VMT is a later refinement; uforth's push/pop are direct. }
        { The gate is "NilPy USER code", which is the main program OR a `.py`
          MODULE — not `CurrentUnitIdx < 0`, which means the main program only.
          A class defined in an imported `.py` therefore fell through to the
          call path and `self.canvas.yview` SEGFAULTED, while the identical
          class written in the main file worked; a method CALL on the same
          field was fine, so the field's class identity was never the problem
          (bug-nilpy-settings-editor-segfaults-on-bound-method-field).
          NilPyUserCode (symtab.inc) is that predicate — the whole NilPy-only
          rule set now shares it. }
        if (CurTok.Kind <> tkLParen) and
           (mci >= 0) and not UClsIsInterface[mci] then
        begin
          node := PyMakeBoundMethod(mpi, node);
          tk := tyVariant; recName := REC_NONE;
          ASTTk[node] := Ord(tyVariant);
          Result := node;
          Exit;
        end;
        if (mci >= 0) and UClsIsInterface[mci] then
        begin
          { CORBA interface call `iface.M(args)`: dispatch through the IMT slot.
            Self comes from the fat pointer's instance word at call time. }
          mcallNode := AllocNode(AN_INTF_CALL);
          ASTRight[mcallNode] := node;                 { the interface value }
          ASTIVal[mcallNode] := mpi;                   { signature proc (marshalling) }
          ASTSOffset[mcallNode] := UMthVirSlot[mmi];   { IMT slot }
          ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
          mlastArg := -1;
          if CurTok.Kind = tkLParen then
          begin
            Next;
            mai := 1; { param 0 = Self (provided by the fat pointer) }
            { `obj.F()` -- EMPTY parens on a method whose parameters ALL have defaults. FPC
              accepts it (fcl-json's own suite calls `J.FormatJSON()`); without this the loop hands
              the `)` to ParseExpr and reports "expected expression". A method with NO parameters
              already worked, because the loop simply never ran. }
            if CurTok.Kind = tkRParen then
            begin
              if (Procs[mpi].ParamCount > 1) and CanFillDefaultsFrom(mpi, 1) then
                FillDefaultArgs(mpi, 1, mcallNode, mlastArg)
              { ...but EMPTY parens on a method with REQUIRED parameters is a
                missing-argument error, not a free pass. This shortcut set mai
                PAST the arity loop unconditionally, so the loop never ran, the
                required slots were never filled, and the callee read an
                UNINITIALISED frame: `c.m()` against `def m(self, a)` SEGFAULTED
                and `[1,2,3].count()` quietly returned a wrong value — the worse
                of the two. A plain NAME receiver is what reaches this route; a
                literal or constructor receiver goes through
                PyParseClassMethodCall, which already checks
                (bug-nilpy-too-few-args-to-container-method-compiles-and-segfaults).

                NOT NilPy-only: `c.M()` against `function M(a: Integer)` was
                accepted in Pascal too, where FPC rejects it.

                `*args`/`**kwargs` methods are variadic by construction and are
                exempt; the call-site star-unpack form is handled below. }
              else if (Procs[mpi].ParamCount > 1) and
                      (ProcPyStarIdx[mpi] < 0) and (ProcPyKwIdx[mpi] < 0) then
                Error(fieldName + '() requires ' +
                      AIntToStr(Procs[mpi].ParamCount - 1) +
                      ' argument(s), none given');
              mai := Procs[mpi].ParamCount;   { nothing to parse; Expect(tkRParen) consumes it }
            end;
            { `d.update(a=1)` / `d.update(**e)` on a plain NAME receiver — the
              route this shape actually takes. Same builder as the other loops
              (four of them ask it now; that they are four is the shape
              devdocs/dev/normalise-dont-special-case.md warns about, and asking
              ONE function is how it is kept honest). }
            if PyKwDictArgsHere(mpi) then
            begin
              margSeq := AllocNode(AN_ARG);
              ASTLeft[margSeq] := PyBuildKeywordDictHere;
              ASTIVal[margSeq] := 0;
              ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
              mai := Procs[mpi].ParamCount;
            end;
            { `obj.m(*xs)` — a call-site UNPACK (the callee declares ordinary
              parameters; the star is on the CALL). A star is not an expression, so
              the arity loop below cannot parse it: hand the whole argument list to
              the NilPy path, which expands the list across the remaining slots. }
            if (mai <= Procs[mpi].ParamCount-1) and PyStarArgAhead then
              PyStarUnpackMethodArgs(mpi, mcallNode, mlastArg, mai);
            while mai <= Procs[mpi].ParamCount-1 do
            begin
              if Procs[mpi].Params[mai].IsRef or Procs[mpi].Params[mai].IsArray then
              begin
                if ByRefArgStartsExpression(ParamIsConstVariant(mpi, mai)) then
                begin
                  { non-ident by-ref/array arg (@obj.Method to a method-pointer
                    param, [..] literals, casts): parse as an expression }
                  ParseArgExpr; mexprNode := CurASTNode;
                end
                else
                begin
                  { a bare def NAME passed as a value — Python's function object }
                  mexprNode := PyMakeFuncValue;
                  if mexprNode < 0 then
                  begin
                    margIdx := FindSym(CurTok.SVal); Next;
                    mexprNode := ParseLValueAST(margIdx, TokPos - 2);
                  end;
                end;
              end
              else begin ParseArgExpr; mexprNode := CurASTNode; end;
              margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := mexprNode;
              if mlastArg = -1 then ASTLeft[mcallNode] := margSeq
              else ASTRight[mlastArg] := margSeq;
              mlastArg := margSeq;
              if (mai < Procs[mpi].ParamCount-1) and CanFillDefaultsFrom(mpi, mai+1) then
              begin
                FillDefaultArgs(mpi, mai+1, mcallNode, mlastArg);
                mai := Procs[mpi].ParamCount-1;
              end
              else if mai < Procs[mpi].ParamCount-1 then Expect(tkComma, ',')
              else if (CurTok.Kind = tkComma) then Next;  { Python trailing comma }
              Inc(mai);
            end;
            Expect(tkRParen, ')');
          end;
          node := mcallNode;
          Result := node; Exit;
        end;
        if UMthIsStatic[mmi] then
        begin
          { A CLASS method reached through an INSTANCE: `obj.ClassMethod(...)`. FPC
            allows it, and Self is the instance's RUNTIME class -- not the static type
            of the variable -- so it comes from __pxxRttiOf(obj), not a fixed
            AN_CLASSREF. }
          mselfArg := GenMakeRttiOfCall(node);
          GenVirtSlot := UMthVirSlot[mmi];
          mcallNode := GenMakeStaticMethodCall(mpi, mselfArg);
          node := mcallNode;
          tk := Procs[mpi].RetType;
          Continue;
        end
        else
        begin
          if mmi >= 0 then
          begin
            if UMthVirSlot[mmi] >= 0 then
            begin
              mcallNode := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[mcallNode] := UMthVirSlot[mmi];
            end
            else
              mcallNode := AllocNode(AN_CALL);
          end
          else
            mcallNode := AllocNode(AN_CALL);
          ASTIVal[mcallNode] := mpi;
          ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
          mselfArg := AllocNode(AN_ARG);
          ASTLeft[mselfArg] := node;
          ASTLeft[mcallNode] := mselfArg;
          mlastArg := mselfArg;
          if CurTok.Kind = tkLParen then
          begin
            Next;
            mai := 1;
            { `obj.F()` -- EMPTY parens on a method whose parameters ALL have defaults. FPC
              accepts it (fcl-json's own suite calls `J.FormatJSON()`); without this the loop hands
              the `)` to ParseExpr and reports "expected expression". A method with NO parameters
              already worked, because the loop simply never ran. }
            if CurTok.Kind = tkRParen then
            begin
              if (Procs[mpi].ParamCount > 1) and CanFillDefaultsFrom(mpi, 1) then
                FillDefaultArgs(mpi, 1, mcallNode, mlastArg)
              { ...but EMPTY parens on a method with REQUIRED parameters is a
                missing-argument error, not a free pass. This shortcut set mai
                PAST the arity loop unconditionally, so the loop never ran, the
                required slots were never filled, and the callee read an
                UNINITIALISED frame: `c.m()` against `def m(self, a)` SEGFAULTED
                and `[1,2,3].count()` quietly returned a wrong value — the worse
                of the two. A plain NAME receiver is what reaches this route; a
                literal or constructor receiver goes through
                PyParseClassMethodCall, which already checks
                (bug-nilpy-too-few-args-to-container-method-compiles-and-segfaults).

                NOT NilPy-only: `c.M()` against `function M(a: Integer)` was
                accepted in Pascal too, where FPC rejects it.

                `*args`/`**kwargs` methods are variadic by construction and are
                exempt; the call-site star-unpack form is handled below. }
              else if (Procs[mpi].ParamCount > 1) and
                      (ProcPyStarIdx[mpi] < 0) and (ProcPyKwIdx[mpi] < 0) then
                Error(fieldName + '() requires ' +
                      AIntToStr(Procs[mpi].ParamCount - 1) +
                      ' argument(s), none given');
              mai := Procs[mpi].ParamCount;   { nothing to parse; Expect(tkRParen) consumes it }
            end;
            { `d.update(**e)` — before the star branches below, because for
              `update` a `**` is not a kwargs pack to bind: its keys ARE the
              dict to merge. The plain-keyword form is caught in the loop, and
              both go through the one builder. }
            if PyKwDictArgsHere(mpi) then
            begin
              margSeq := AllocNode(AN_ARG);
              ASTLeft[margSeq] := PyBuildKeywordDictHere;
              ASTIVal[margSeq] := 0;
              ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
              mai := Procs[mpi].ParamCount;    { the argument list is complete }
            end;
            { A method with `*args` / `**kwargs` has no fixed arity, so the
              arity-driven loop below cannot parse its call. Hand the whole
              argument list to the NilPy path, which packs the surplus. }
            if (mai <= Procs[mpi].ParamCount-1) and
               ((ProcPyStarIdx[mpi] >= 0) or (ProcPyKwIdx[mpi] >= 0)) then
              PyParseStarMethodArgs(mpi, mcallNode, mlastArg, mai);
            { `obj.m(*xs)` — a call-site UNPACK (the callee declares ordinary
              parameters; the star is on the CALL). A star is not an expression, so
              the arity loop below cannot parse it: hand the whole argument list to
              the NilPy path, which expands the list across the remaining slots. }
            if (mai <= Procs[mpi].ParamCount-1) and PyStarArgAhead then
              PyStarUnpackMethodArgs(mpi, mcallNode, mlastArg, mai);
            while mai <= Procs[mpi].ParamCount-1 do
            begin
              { `d.update(a=1)` / `d.update(**e)` — the method half of the
                keywords-are-KEYS case above; same builder, so the two forms
                cannot drift. }
              mexprNode := PyKwDictArgNode(mpi);
              if mexprNode >= 0 then
              begin
                margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := mexprNode;
                ASTIVal[margSeq] := 0;                { positional, not a keyword }
                ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
                Break;
              end;
              { NilPy `key=expr` on the METHOD path. Params[0] is Self, so names
                resolve from 1 up; mslot is the parameter this argument actually
                fills, which drives the by-ref / open-array decisions below. }
              mkw := PyKwArgIndex(mpi, 1);
              if mkw > 0 then mslot := mkw - 1 else mslot := mai;
              if (CurTok.Kind = tkLBrack) and ParamIsVarRecArray(mpi, mslot) then
                mexprNode := ParseVarRecLiteralAST
              else if (CurTok.Kind = tkLBrack) and ParamIsOpenArrayScalar(mpi, mslot) then
                { `[...]` open-array literal to an instance/record method
                  (r.SumAll([10,20])) — was parsed as a SET literal (b334) }
                mexprNode := ParseArrayCtorAST(Procs[mpi].Params[mslot].TypeKind,
                  ProcParamElemRowLen[mpi * MAX_PROC_PARAMS + mslot], ProcParamElemRowLo[mpi * MAX_PROC_PARAMS + mslot])
              else if Procs[mpi].Params[mslot].IsRef or Procs[mpi].Params[mslot].IsArray then
              begin
                if ByRefArgStartsExpression(ParamIsConstVariant(mpi, mslot)) then
                begin
                  { non-ident by-ref/array arg (@obj.Method to a method-pointer
                    param, [..] literals, casts): parse as an expression }
                  ParseArgExpr; mexprNode := CurASTNode;
                end
                else
                begin
                  { a bare def NAME passed as a value — Python's function object }
                  mexprNode := PyMakeFuncValue;
                  if mexprNode < 0 then
                  begin
                    margIdx := FindSym(CurTok.SVal); Next;
                    mexprNode := ParseLValueAST(margIdx, TokPos - 2);
                  end;
                end;
              end
              else
              begin
                ParseArgExpr; mexprNode := CurASTNode;
              end;
              SetLitCheckArg(mexprNode, mpi, mslot);
              margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := mexprNode;
              ASTIVal[margSeq] := mkw;
              ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
              if mkw > 0 then
              begin
                { a keyword argument decouples arity from position: stop at `)`
                  and let PyBindKwArgs order the chain and fill the holes }
                if CurTok.Kind = tkRParen then Break;
                Expect(tkComma, ',');
                Inc(mai);
                Continue;
              end;
              if (mai < Procs[mpi].ParamCount-1) and CanFillDefaultsFrom(mpi, mai+1) then
              begin
                FillDefaultArgs(mpi, mai+1, mcallNode, mlastArg);
                mai := Procs[mpi].ParamCount-1;
              end
              else if mai < Procs[mpi].ParamCount-1 then
              begin
                Expect(tkComma, ',');
                { Python's TRAILING comma before the closing paren — the shape a
                  multi-line call is written in:
                      w.bind(
                          "<Configure>",
                          lambda event: ...,
                      )
                  The loop would go round once more and demand another argument.
                  Stop here instead and let the omitted parameters take their
                  defaults, exactly as an argument list that simply ended. }
                if (CurTok.Kind = tkRParen) then
                begin
                  if CanFillDefaultsFrom(mpi, mai+1) then
                    FillDefaultArgs(mpi, mai+1, mcallNode, mlastArg);
                  Break;
                end;
              end
              else if (CurTok.Kind = tkComma) then Next;  { Python trailing comma }
              Inc(mai);
            end;
            Expect(tkRParen, ')');
            mnArgs := 0;
            PyBindKwArgs(mpi, mselfArg, mlastArg, mnArgs);
            ASTLeft[mcallNode] := mselfArg;
          end;
          { Continue the selector loop (not Exit) so trailing `.field` / `[i]` on
            the method result are parsed: obj.M(args).field, obj.M.field, chained
            obj.M1.M2. The result's record (ProcRetRecId) drives field
            resolution; IR lowering materializes a record result temp. }
          node := mcallNode;
          tk := Procs[mpi].RetType;
          recName := ProcRetRecId[mpi];
          { ...but a CALL carried into the next iteration becomes the receiver of
            the next link, and a virtual dispatch reads the receiver twice (VMT,
            then Self) — from the same AST node, which re-EMITS the call. So
            `b.add(2).add(3)` ran add(2) twice and printed 7 where CPython prints
            5: silent, and worse the longer the chain. Bind it once.
            PyExprMode-only, so Pascal's codegen (and the self-host binary) is
            untouched (bug-nilpy-method-chaining-on-a-call-result). }
          if (CurTok.Kind in [tkDot, tkLBrack]) then
            node := PyEvalOnce(node);
          Continue;
        end;
      end;
      { class variable accessed via an instance (obj.cnt): not an instance field —
        resolve to the shared backing global, so reads/writes hit the class var
        (FPC: a class var is reachable from instances too). }
      if (recName >= REC_UCLASS_BASE) and
         (FindUField(recName - REC_UCLASS_BASE, fieldName) < 0) then
      begin
        fldIdx := FindClassVar(recName - REC_UCLASS_BASE, fieldName);
        if fldIdx >= 0 then
        begin
          { …unless a SUBCLASS redeclares it. FindClassVar walks UPWARD from the
            static receiver class, so inside a base method `self.kind` found the
            BASE's slot and every Derived instance read the base's value —
            silently, and it is the template-method pattern that breaks.
            Which slot is right is a run-time fact about the receiver, so the
            read becomes one (PyExprMode only; Pascal's own class vars keep the
            static resolution FPC gives them).
            bug-nilpy-self-class-attribute-in-an-inherited-method-reads-the-base-value }
          if (CurTok.Kind <> tkAssign) and
             (PyAugBinTok(CurTok.Kind) = tkEOF) and
             PyClsAttrRedeclaredCi(recName - REC_UCLASS_BASE, fieldName) then
          begin
            cvIdx := PyMakeClsAttrInstGet(node, fieldName);
            if cvIdx >= 0 then
            begin
              node := cvIdx;
              tk := tyVariant;
              recName := REC_NONE;
              Next;   { consume field name }
              Continue;
            end;
          end;
          node := AllocNode(AN_IDENT);
          ASTIVal[node] := fldIdx;
          ASTTk[node] := Ord(Syms[fldIdx].TypeKind);
          tk := Syms[fldIdx].TypeKind;
          recName := REC_NONE;
          Next;   { consume field name }
          Continue;
        end;
      end;
      { An interface-typed value exposes ONLY the interface's (and ancestors'/
        IUnknown's) METHODS — never the implementing class's fields. A method or
        parameterless-method access already exited above (mmi>=0 / AN_INTF_CALL);
        reaching here with an interface base means the name is a field/backing
        field, which FPC rejects ("identifier idents no member"). Without this the
        fall-through built an AN_FIELD at the class field offset THROUGH the
        interface pointer and miscompiled to a SIGSEGV
        (bug-pascal-field-access-through-interface-var). }
      if (recName >= REC_UCLASS_BASE) and UClsIsInterface[recName - REC_UCLASS_BASE] then
        Error('interface has no member "' + fieldName + '" (an interface exposes only its methods)');
      { A pointer with NO pointee record has no member namespace to search: a plain
        `Pointer`, or a typed pointer to a non-record. The old fall-through built an
        AN_FIELD over it anyway, which lowered to "the pointer, at offset 0" — so
        `q.NoSuchThing` compiled and yielded the pointer itself, turning a typo into
        a silent no-op. A pointer TO a record has already been auto-dereffed above,
        and a metaclass has taken its own branch, so neither reaches here. }
      if (tk = tyPointer) and (recName = REC_NONE) then
        Error('"' + fieldName + '": a pointer has no members (dereference it with ^, or the pointee type is unknown here)');

      { Property-backed access: FPC checks the PROPERTY's visibility, and the
        backing field is read on the declaring class's behalf — a private FField
        behind a public Count property must stay accessible (test_tfplist_b259). }
      { `<designator>.Free;` — see BuiltinFreeHere. Placed immediately before the
        member check that would otherwise reject it, because Free is not a
        member of anything. }
      if BuiltinFreeHere(node, recName, fieldName, TokPos) then
      begin
        Next;                        { consume 'Free' }
        Result := GenMakeFreeObjectExpr(node, recName - REC_UCLASS_BASE);
        Exit;
      end;
      if not viaProp then
      begin
        RequireRecMember(recName, fieldName);
        EnforceFieldVis(recName, fieldName);   { --strict-visibility member access control }
      end;
      fieldNode := AllocNode(AN_FIELD);
      ASTLeft[fieldNode] := node;
      ASTSOffset[fieldNode] := propFOff;
      ASTSLen[fieldNode] := propFLen;
      baseRecFld := recName;
      tk := RecFieldType(recName, fieldName);
      recName := RecFieldRecId(recName, fieldName);
      ASTTk[fieldNode] := Ord(tk);
      Next;
      node := fieldNode;

      { Indirect call through a procedural-type field: `rec.field(args)`. The
        field value is the proc pointer (tyPointer) or a {Code,Data} method
        pointer (tyRecord); AN_CALL_IND evaluates ASTRight (the field node) as
        the callee. Without this the statement parser sees a non-call lvalue and
        demands ':='. }
      fldSigPi := -1;
      if (baseRecFld >= REC_UCLASS_BASE) and (CurTok.Kind = tkLParen) and
         ((tk = tyPointer) or (tk = tyRecord)) then
      begin
        fIdx := FindUField(baseRecFld - REC_UCLASS_BASE, fieldName);
        if (fIdx >= 0) and (not UFldIsArray[fIdx]) then fldSigPi := UFldProcSig[fIdx];
      end;
      if fldSigPi >= 0 then
      begin
        isMethodPtr := (tk = tyRecord);
        Expect(tkLParen, '(');
        argsHead2 := -1; lastArg2 := -1;
        while CurTok.Kind <> tkRParen do
        begin
          ParseExpr;
          argSeq2 := AllocNode(AN_ARG);
          ASTLeft[argSeq2] := CurASTNode;
          if argsHead2 = -1 then argsHead2 := argSeq2
          else ASTRight[lastArg2] := argSeq2;
          lastArg2 := argSeq2;
          if CurTok.Kind = tkComma then Next
          else if CurTok.Kind <> tkRParen then Error('expected comma or close parenthesis');
        end;
        Expect(tkRParen, ')');
        callIndNode := AllocNode(AN_CALL_IND);
        ASTLeft[callIndNode]  := argsHead2;
        ASTRight[callIndNode] := fieldNode;
        ASTIVal[callIndNode]  := fldSigPi;
        ASTTk[callIndNode]    := Ord(Procs[fldSigPi].RetType);
        if isMethodPtr then ASTSLen[callIndNode] := 1 else ASTSLen[callIndNode] := 0;
        node := callIndNode;
        tk := Procs[fldSigPi].RetType;
        recName := ProcRetRecId[fldSigPi];
        { NilPy: a Callable field (Word.native) may hold a pyeval closure rather
          than a compiled function address (uforth's VARIABLE/CONSTANT words).
          Branch at runtime on the 1-arg `-> None` shape. Pascal is unaffected
          (gated on isNilPy). }
        if (not isMethodPtr) and (argsHead2 >= 0) and
           (ASTRight[argsHead2] = -1) and (Procs[fldSigPi].RetType = tyInteger) then
          node := PyWrapClosureFieldCall(fieldNode, ASTLeft[argsHead2], callIndNode);
      end;
    end;
  end;
  Result := node;
end;

{ ---------------------------------------------------------------------------
  PyParseFactorCore — the NilPy half of ParseFactorCore, carved out of the
  shared parser.inc on 2026-08-20 (task-a-carve-nilpy-lvalue-parsing-out-of-
  parser-inc, split 3). ParseFactorCore dispatches here whenever PyExprMode is
  set, so every existing call site — and every recursive re-entry — is
  untouched.

  This commit is the VERBATIM copy: the body below is byte-identical to the
  parser.inc original except for the routine name on the header line. The fold
  (PyExprMode guards collapse to True inside this routine) and the deletion of
  the now-dead NilPy arms from the Pascal original are the two commits after
  this one, so a regression can be bisected to a stage rather than argued about.

  As in PyParseLValueAST: inside this routine PyExprMode is TRUE by
  construction, but the `isNilPy` / `NilPyUserCode` guards do NOT fold in the
  Pascal original and are therefore left in place THERE — isNilPy still holds
  while an .npy program's Pascal RTL units are parsed, with PyExprMode false.
  --------------------------------------------------------------------------- }
procedure PyParseFactorCore;
var lenSavedHoist, lenTrialHoist: Integer;   { the len() intercept's parked hoist queue }
    rndRawArg: Integer;      { round(x, n): the argument node before the float unbox }
    intBaseArg, atRecv, atFld, atDflt, atProp: Integer; atIsGet, atExists: Boolean; atName: AnsiString; name, grpAcc: AnsiString; recName: Integer; idx, procIdx, i, node, left, prevTok, valNode: Integer; tk: TTypeKind; op, argSeq, argSeq2, argSeq3, lastArg, argIdx, exprNode, szArg: Integer;
    smmiS, smSelfNode, mselfArg, mcCtorCi, parenRec, ctorCi, ctorArgN: Integer;
    nestCtorCi: Integer;   { `TOuter.TInner.Create` — the nested class, resolved by scope }
    nestScanCi, nestScanPos, nestDepth, nestI: Integer;   { …walking N levels of it }
    mthName: AnsiString;   { @TClass.Method — name read via GetTokenStr (may be a type keyword) }
    mcCtorNm: AnsiString;
    nArgs, argsHead, currArg: Integer; argTypes: array[0..MAX_PROC_PARAMS-1] of TTypeKind;
    kwIdx, slotIdx: Integer;   { NilPy keyword argument: binding+1, and the param it fills }
    pyPrintNode: Integer;      { print(...) in expression position: the write node, wrapped }
    ci, mmi, mpi, mcallNode, mlastArg, smSelfIdx, smselfArg: Integer;
    aliasIdx, fieldNode, indexNode, baseNode, baseRec, fIdx, mci, margSeq, margIdx, mexprNode, mai, pri, qUnit: Integer;
    fieldName, methName: AnsiString; isAssign: Boolean; castTk: TTypeKind;
    liftedVar, identNode, addrNode: Integer;
    rcCi, rcMmi, rcPi, rcTmp, rcSelf, rcSelfArg, savedRecId: Integer;   { advanced-record ctor call }
    castTk2: TTypeKind;   { postfix tail on a record-factory result }
    helperPi, wrapperArg, wrapperCall, sci: Integer;
    isLiftedCall, isCStringCall: Boolean;
    capSym: Integer;   { NilPy nested-def capture actual (feature-nilpy-nested-defs) }
    derefNode: Integer;   { ...through its frame cell, when it has one (SymCellPtr) }
    capIdx: Integer;   { PXXDBG=n.caps probe cursor }
    bitNot, opIsArith: Boolean; notOp: Integer; notOrdTk: TTypeKind;
    szAi, szFlatLen, szDi, szBrDepth, szNIdx, szBase, szRec: Integer; szElemTk: TTypeKind;
    seEtid, seOrd: Integer;
    lenFieldRec, lenFieldIdx: Integer;   { Length() of a static-array record field }
    cpyPi: Integer;   { Copy(s,i,n)[k]: the __pxxStrCopy proc index, kept past ci's reuse }
    ccReg, ccNode: Integer; ccKey: AnsiString; ccTk: TTypeKind;   { bare class-const in a method body }
    mapProc, mapConv: Integer; mapKind: AnsiString;   { NilPy map(<type>, xs) }
    rndArg: Integer;   { first operand of NilPy round(x, n) }
    rndIntArg: Boolean;      { …and was it an INTEGER? then round is identity }
    rndArgTk, rndRawTk: TTypeKind;   { its type, to restore after the identity }
    fwdList, fwdDict: Integer;   { `f(*args, **kwargs)` forwarded into fixed parameters }
    altPi, wpj: Integer; paramsAllVariant: Boolean;   { callable-value wrapper selection }
    vcNode: Integer;   { a typecast of a VARIANT, rewritten as the conversion }
    tiName: AnsiString; tiTk: TTypeKind;   { widened TypeInfo(T): scalar/string/class/record }
    pyLateDefPi: Integer;   { NilPy def not yet bound at this call site; -1 = none }
begin
  LastExprTk := tyInteger;
  { Nil Python: ClassName(args) in ANY expression position is construction
    (Pascal reads it as a typecast). The statement-level intercept only saw
    top-level assignments, so a ctor call in a method arg quietly became a
    cast — a Word("x") boxed into a list slot carried the string pointer
    with an int64 tag. }
  { FindUClassNonRecord, not IsClassType: the first row of that name may be a
    RECORD — the RTL's `Text` file type against tkinter's Text widget — and a
    construction in NilPy always means the class. Read as a record typecast it
    parsed with one argument and failed with two. Confined to this NilPy
    intercept: Pascal code still gets the record, which is what `var f: Text`
    means there. }
  if PyExprMode and (CurTok.Kind = tkIdent) and
     PyIsExactCtorName(CurTok.SVal) and
     (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
  begin
    CurASTNode := PyClassCreateExpr;
    LastExprTk := tyClass;
    { `C(5)[2]` — a SUBSCRIPT applied straight to a construction. `C(5).m()`
      is picked up downstream, so only the bracket was missing, and it was
      missing as a PARSE ERROR ("unexpected token") on a shape CPython accepts.
      Handed to the selector loop, exactly as the Pascal cast arm hands its
      own result over. }
    if PyExprMode and (CurTok.Kind = tkLBrack) and
       (ResolveNodeRec(CurASTNode) >= REC_UCLASS_BASE) then
    begin
      CurASTNode := PyParseClassRecordSelectors(CurASTNode,
                      ResolveNodeRec(CurASTNode), LastExprTk);
    end;
    Exit;
  end;
  { `set(xs)` in ANY expression position (`return set(...)`, an argument, a
    comparison). It used to be recognised only as an assignment RHS, and only in
    its empty form. PyIsSetCall stands down when the program declares its own
    `set`, which songformatter's settings.py does. }
  if PyExprMode and PyIsSetCall then
  begin
    CurASTNode := PyParseEmptySet;
    LastExprTk := tyClass;
    Exit;
  end;
  { The same intercept through a MODULE QUALIFIER — `tk.Frame(root, ...)`, which
    is how real tkinter code is written. Without it the cursor sits on the unit
    name, the ctor intercept above never fires, and the whole thing falls into
    the Pascal qualified-call path: that resolves a qualified PROC (which is why
    `tk.Tk_()` always worked) but cannot construct a class and does not do NilPy
    keyword arguments. Unit scope here is flat, so consuming the qualifier is
    enough — the class then resolves by its bare name.
    (feature-nilpy-qualified-class-construction) }
  if PyExprMode and (CurTok.Kind = tkIdent) and (TokPos + 2 < TokCount) and
     (Tokens[TokPos].Kind = tkDot) and (Tokens[TokPos + 1].Kind = tkIdent) and
     (Tokens[TokPos + 2].Kind = tkLParen) and
     (FindUClassNonRecord(GetTokenStr(TokPos + 1)) >= 0) and
     (FindSym(CurTok.SVal) < 0) and (FindUnitOrAlias(CurTok.SVal) >= 0) then
  begin
    { Remember WHICH unit was named: two libraries may export the same class
      name (tkinter's `Canvas` and the reportlab shim's), and resolving by the
      bare name afterwards took whichever was registered first — silently, and
      then the keyword arguments did not match. }
    PyCtorQualUnit := FindUnitOrAlias(CurTok.SVal);
    Next;                 { the module name }
    Expect(tkDot, '.');
    CurASTNode := PyClassCreateExpr;
    PyCtorQualUnit := -1;
    LastExprTk := tyClass;
    Exit;
  end;
  case CurTok.Kind of
    tkInteger:
    begin
      node := AllocNode(AN_INT_LIT); ASTIVal[node] := CurTok.IVal;
      { A literal wider than Int64 carries its DIGIT TEXT (the lexer sets SVal
        only in that case). ASTIVal holds the wrapped 64-bit reading, which is
        still the right QWord value; the span lets a promotable-int target take
        the exact value instead (feature-a-promoint-wide-literals). }
      { A literal that does not fit a signed 32-bit Integer is an Int64; the
        i386 backend keys its 64-bit codegen off this type. }
      if (CurTok.IVal > 2147483647) or (CurTok.IVal < -2147483648) then
        ASTTk[node] := Ord(tyInt64)
      else
        ASTTk[node] := Ord(tyInteger);
      if Tokens[TokPos - 1].SLen > 0 then
      begin
        ASTSOffset[node] := Tokens[TokPos - 1].SOffset;
        ASTSLen[node] := Tokens[TokPos - 1].SLen;
        { Force Int64 even though the WRAPPED value may look small: 2^64 wraps
          to 0 and would otherwise be typed tyInteger, which is both wrong and
          indistinguishable from a char literal's char-pool span. }
        ASTTk[node] := Ord(tyInt64);
        { NilPy: ints are arbitrary precision, so a wide literal IS a
          promotable int — the promo type makes the binop/assign typing carry
          promotion through everything it touches (the `& 0xFFFFFFFFFFFFFFFF`
          unsigned-mask idiom). Gated on the parse MODE, not isNilPy: the
          auto-used Pascal units compile under isNilPy too and must keep the
          Pascal reading. }
        if PyExprMode then
          ASTTk[node] := Ord(tyPromoInt64);
      end;
      CurASTNode := node; Next;
    end;
    tkLBrack:
    begin
      if PyExprMode and PyIsListCompAhead then
      begin
        { `[EXPR for x in it]` in an EXPRESSION position — a hoisted temp. }
        CurASTNode := PyParseCompExprValue(True);
        LastExprTk := tyClass;
      end
      else if PyExprMode then
      begin
        PyParseListLiteral;
        LastExprTk := tyClass;
      end
      else
      begin
        CurASTNode := ParseSetLiteralAST;
        LastExprTk := tySet;
      end;
    end;
    tkBegin:
    begin
      if not PyExprMode then Error('unexpected begin in expression');
      if PyIsDictCompAhead then
      begin
        { a brace dict comprehension in an EXPRESSION position (a field/subscript
          target's RHS, a call argument) — a hoisted hidden TPyDict temp. }
        CurASTNode := PyParseDictCompExprValue;
        LastExprTk := tyClass;
      end
      else
      begin
        PyParseSetLiteral;
        LastExprTk := tyClass;
      end;
    end;
    tkNil:
    begin
      { In NilPy `None` is a VALUE (pylib's VT_EMPTY variant), not the nil cell.
        As integer 0 it compared equal to every falsy number (`0 == None` was
        True) and `str(None)` formatted as `0`. A dozen call sites already
        substituted PyMakeNone by hand wherever they could see the token
        coming — list elements, dict values, tuple members, the `or`/`and`
        arms, print — which is why most of the language looked right; the
        positions nobody had enumerated were the wrong ones. Doing it HERE
        covers every position at once (bug-nilpy-none-equals-zero-is-true,
        bug-nilpy-str-of-literal-none-prints-zero). Pascal keeps the nil cell:
        the switch is PyExprMode. }
      if PyExprMode then
      begin
        CurASTNode := PyMakeNone; Next; LastExprTk := tyVariant;
      end
      else
      begin
        node := AllocNode(AN_INT_LIT); ASTIVal[node] := 0; ASTTk[node] := Ord(tyPointer); CurASTNode := node; Next; LastExprTk := tyPointer;
      end;
    end;
    tkPlusPlus, tkMinusMinus:
    begin
      { Prefix `++lv` / `--lv`: bump first, yield the NEW value. Operand must be
        an lvalue (parsed as a factor so postfix/suffixes still bind). }
      bitNot := CurTok.Kind = tkPlusPlus; Next;   { bitNot reused as isIncrement }
      ParseFactor;
      node := AllocNode(AN_INCDEC);
      ASTLeft[node] := CurASTNode;
      if bitNot then ASTIVal[node] := 1 else ASTIVal[node] := -1;
      ASTSOffset[node] := 0;   { prefix → new value }
      ASTTk[node] := ASTTk[CurASTNode];
      CurASTNode := node; LastExprTk := IntToTypeKind(ASTTk[node]);
    end;
    tkIf:
    begin
      { Conditional EXPRESSION `if c then a else b` (the value-bearing form the C
        frontend's ternary `c ? a : b` lowers to). Reached only in expression
        position: a statement-leading `if` is parsed by ParseStatementAST before
        any factor, so this never shadows the if-statement. `else` is mandatory —
        an expression must yield a value. Arms are full expressions; parenthesize
        when embedding in a larger one. Result type = the then-arm's type. }
      Next;                          { consume 'if' }
      ParseExpr; left := CurASTNode; { condition }
      Expect(tkThen, 'then');
      ParseExpr; identNode := CurASTNode; tk := LastExprTk;  { then-arm }
      Expect(tkElse, 'else');
      ParseExpr; addrNode := CurASTNode;                     { else-arm }
      { A frozen string-literal arm types as tyString; carry the result as a
        managed AnsiString (managed-default) so it has a real handle downstream
        (writeln arg, assignment) — the IR per-arm assign coerces the literal. }
      if tk = tyString then tk := tyAnsiString;
      valNode := AllocNode(AN_PAIR);
      ASTLeft[valNode] := identNode; ASTRight[valNode] := addrNode;
      node := AllocNode(AN_TERNARY);
      ASTLeft[node] := left; ASTRight[node] := valNode;
      ASTTk[node] := Ord(tk);
      CurASTNode := node; LastExprTk := tk;
    end;
    tkDefault:
    begin
      if (TokPos < TokCount) and (Tokens[TokPos].Kind = tkLParen) then
      begin
        { Default(T): zero value of the type — ordinals/pointers/chars in v1
          (records/strings later). `default` lexes as its own token. }
        Next; Expect(tkLParen, '(');
        { FPC-parity diagnostics: Default() is not defined for file types —
          neither TextFile itself nor a record that (transitively) contains one
          (bug-pascal-missing-diagnostics-fail-tests / tdefault2, tdefault6). }
        if CurTok.Kind = tkIdent then
        begin
          if CaseEqual(CurTok.SVal, 'text') or CaseEqual(CurTok.SVal, 'textfile') then
            Error('Default: file types are not allowed');
          i := IsRecordType(CurTok.SVal);
          if (i <> REC_NONE) and RecContainsTextRec(i) then
            Error('Default: the record type contains a file field');
          { An UNSPECIALIZED generic template is not a type — it has no size and no zero
            value, so Default(TTest) is undefined (tdefault11/12). `Default(TTest<Integer>)`
            (delphi) is fine, hence the '<' lookahead; the objfpc form starts with
            `specialize`, so CurTok is not the template name there. }
          if IsGenericTemplateName(CurTok.SVal) and
             not ((TokPos < TokCount) and (Tokens[TokPos].Kind = tkLt)) then
            Error('Default: the generic type ' + CurTok.SVal + ' must be specialized');
        end;
        node := AllocNode(AN_INT_LIT);
        ASTIVal[node] := 0;
        ASTTk[node] := Ord(tyInt64);
        i := 1;
        while (i > 0) and (CurTok.Kind <> tkEOF) do
        begin
          if CurTok.Kind = tkLParen then Inc(i)
          else if CurTok.Kind = tkRParen then Dec(i);
          if i > 0 then Next;
        end;
        Expect(tkRParen, ')');
        CurASTNode := node;
        LastExprTk := tyInt64;
      end
      else
      begin
        node := AllocNode(AN_DEFAULT);
        ASTTk[node] := Ord(tyUnknown);
        CurASTNode := node;
        LastExprTk := tyUnknown;
        Next;
      end;
    end;
    tkAt:
    begin
      Next;
      if CurTok.Kind <> tkIdent then Error('expected identifier after @');
      name := CurTok.SVal;
      idx := FindSym(name);
      { @obj.method yields a TMethod (Code+Data): obj is a class instance var,
        method one of its methods. Code = method proc address,
        Data = the instance pointer. Only valid as the RHS of an assignment to
        a TMethod-shaped target (handled in AN_ASSIGN). }
      if (idx >= 0) and (Syms[idx].RecName >= REC_UCLASS_BASE) and
         (not UClsIsRecord[Syms[idx].RecName - REC_UCLASS_BASE]) and
         (TokPos < TokCount) and (Tokens[TokPos].Kind = tkDot) then
      begin
        ci := Syms[idx].RecName - REC_UCLASS_BASE;
        Next;            { consume obj name (CurTok = '.') }
        Next;            { consume '.' (CurTok = method name) }
        if CurTok.Kind <> tkIdent then Error('expected method name after @obj.');
        mmi := FindUMeth(ci, CurTok.SVal);
        if mmi < 0 then
        begin
          { @obj.field — ADDRESS of an instance field (blcksock's
            `buf := @Value.Value`). AN_ADDR over the field lvalue. }
          mmi := FindUField(ci, CurTok.SVal);
          if mmi < 0 then Error('@obj.method: unknown method or field');
          valNode := AllocNode(AN_IDENT);
          ASTIVal[valNode] := idx;
          ASTTk[valNode] := Ord(tyClass);
          node := AllocNode(AN_FIELD);
          ASTLeft[node] := valNode;
          ASTSOffset[node] := Tokens[TokPos-1].SOffset;
          ASTSLen[node] := Tokens[TokPos-1].SLen;
          ASTTk[node] := UFldTk[mmi];
          Next;   { consume field name }
          valNode := AllocNode(AN_ADDR);
          ASTLeft[valNode] := node;
          ASTTk[valNode] := Ord(tyPointer);
          CurASTNode := valNode;
          LastExprTk := tyPointer;
          Exit;
        end;
        valNode := AllocNode(AN_IDENT);   { object value = the instance pointer }
        ASTIVal[valNode] := idx;
        ASTTk[valNode] := Ord(tyClass);
        node := AllocNode(AN_METHODREF);
        ASTIVal[node] := UMthProc_[mmi];
        ASTLeft[node] := valNode;
        { Record the method's VMT slot (>=0 virtual, -1 non-virtual) so the code
          pointer resolves through the object's VMT at runtime, not the static base
          address — `@baseref.VirtualMethod` must capture the derived override
          (bug-a-method-pointer-virtual-captures-static-address). }
        ASTRight[node] := UMthVirSlot[mmi];
        { Typed as a Pointer: in a value/argument context @obj.Method surfaces its
          CODE address (IR lowering yields IR_PROCADDR), so it matches a Pointer
          parameter — `TakesPtr(@h.M)`. Assignment to a TMethod target still
          captures code+data: AN_ASSIGN keys on the AN_METHODREF node kind, not
          this type, so `pm := @h.M` / `widget.OnClick := @h.M` are unaffected. }
        ASTTk[node] := Ord(tyPointer);
        Next;            { consume method name }
        CurASTNode := node;
        LastExprTk := tyPointer;
      end
      { @Method bare inside a method body: implicit Self — @BinaryCompareKey
        == @Self.BinaryCompareKey (an AN_METHODREF: Code+Data). Checked before
        the plain @proc case so a method wins over a same-named free routine
        (innermost scope), matching the other implicit-Self dispatches. }
      else if (idx < 0) and (CurProc >= 0) and (CurSelfClass >= REC_UCLASS_BASE) and
              (Procs[CurProc].ParamCount > 0) and
              (FindUMeth(CurSelfClass - REC_UCLASS_BASE, name) >= 0) and
              ((TokPos >= TokCount) or (Tokens[TokPos].Kind <> tkDot)) then
      begin
        mmi := FindUMeth(CurSelfClass - REC_UCLASS_BASE, name);
        valNode := AllocNode(AN_IDENT);
        ASTIVal[valNode] := Procs[CurProc].Params[0].SymIdx;   { Self }
        ASTTk[valNode] := Ord(tyClass);
        node := AllocNode(AN_METHODREF);
        ASTIVal[node] := UMthProc_[mmi];
        ASTLeft[node] := valNode;
        ASTRight[node] := UMthVirSlot[mmi];   { VMT slot (>=0 virtual): resolve via VMT }
        ASTTk[node] := Ord(tyPointer);
        Next;            { consume method name }
        CurASTNode := node;
        LastExprTk := tyPointer;
      end
      { @TClass.Method — the method's raw CODE address, reached through the TYPE
        name rather than an instance. No Data half and no VMT lookup: with no
        object there is nothing to dispatch on, so FPC yields the static address
        of that class's own implementation even for a virtual method, which is
        exactly what makes the idiom useful — hand-built VMTs (rtl-generics'
        Generics.Defaults fills its IComparer VMT records with
        `@TRawInterface._AddRef` and friends).

        Guarded on idx < 0 so a VARIABLE of the same name keeps the @obj.method
        path above; a class TYPE is not in the sym table, which is precisely why
        this used to fall through to ParseLValueAST and get diagnosed as
        `cannot call non-static method on class type directly` — the @ never
        reached the decision, so taking an address was read as calling. }
      else if (idx < 0) and (TokPos < TokCount) and (Tokens[TokPos].Kind = tkDot) and
              (FindUClass(name) >= 0) then
      begin
        ci := FindUClass(name);
        Next;            { consume class name (CurTok = '.') }
        Next;            { consume '.' (CurTok = method name) }
        { A method may be NAMED after a type keyword (generics.defaults'
          `TCompare.Single`), and those tokens carry an empty SVal — read the
          name via GetTokenStr, never SVal. }
        if not IsMethodNameTok then Error('expected method name after @' + name + '.');
        mthName := GetTokenStr(TokPos - 1);
        mmi := FindUMeth(ci, mthName);
        if mmi < 0 then Error('@' + name + '.' + mthName + ': unknown method');
        node := AllocNode(AN_PROCADDR);
        ASTIVal[node] := UMthProc_[mmi];
        ASTTk[node] := Ord(tyPointer);
        Next;            { consume method name }
        CurASTNode := node;
        LastExprTk := tyPointer;
      end
      { @proc: not a variable but a known routine → absolute code address }
      else if (idx < 0) and (FindProc(name) >= 0) then
      begin
        node := AllocNode(AN_PROCADDR);
        ASTIVal[node] := FindProc(name);
        ASTTk[node] := Ord(tyPointer);
        Next;
        CurASTNode := node;
        LastExprTk := tyPointer;
      end
      else
      begin
        Next;
        valNode := ParseLValueAST(idx, TokPos - 2);
        node := AllocNode(AN_ADDR);
        ASTLeft[node] := valNode;
        ASTTk[node] := Ord(tyPointer);
        CurASTNode := node;
        LastExprTk := tyPointer;
      end;
    end;
    tkFloat:
    begin
      node := AllocNode(AN_FLOAT_LIT); ASTIVal[node] := CurTok.IVal; ASTTk[node] := Ord(tyDouble);
      CurASTNode := node; LastExprTk := tyDouble; Next;
    end;
    tkTrue:
    begin
      node := AllocNode(AN_BOOL_LIT); ASTIVal[node] := 1; ASTTk[node] := Ord(tyBoolean); CurASTNode := node; Next; LastExprTk := tyBoolean;
    end;
    tkFalse:
    begin
      node := AllocNode(AN_BOOL_LIT); ASTIVal[node] := 0; ASTTk[node] := Ord(tyBoolean); CurASTNode := node; Next; LastExprTk := tyBoolean;
    end;
    tkString:
    begin
      prevTok := TokPos - 1;
      { A 1-character literal is a CHAR in Pascal — but Python has no char type,
        `"d"` is a 1-length str like any other. Typing it tyChar in NilPy made
        every context that expects a string depend on a char->string coercion,
        and the method/ctor call-argument paths have none: `A("d")` passed the
        character CODE where the callee dereferenced a string pointer, so a
        1-character argument segfaulted while `A("dd")` worked
        (bug-a-nilpy-one-char-string-literal-is-a-char). }
      if (Length(CurTok.SVal) = 1) and not PyExprMode then
      begin
        node := AllocNode(AN_INT_LIT); ASTIVal[node] := Ord(CurTok.SVal[1]); ASTTk[node] := Ord(tyChar);
        ASTSOffset[node] := Tokens[prevTok].SOffset; ASTSLen[node] := Tokens[prevTok].SLen;
        CurASTNode := node; Next; LastExprTk := tyChar;
      end
      else
      begin
        prevTok := TokPos - 1; Next;
        node := AllocNode(AN_STR_LIT);
        ASTSOffset[node] := Tokens[prevTok].SOffset; ASTSLen[node] := Tokens[prevTok].SLen;
        ASTTk[node] := Ord(tyString); CurASTNode := node;
        LastExprTk := tyString;
      end;
    end;
    tkLParen:
    begin
      Next; if PyExprMode then PyParseBoolExpr else ParseExpr;
      { C comma operator `(a, b, ...)`: each operand but the last is evaluated for
        its side effects then discarded; the value is the last. A parenthesised
        comma list is otherwise a syntax error in pxx, so this is conflict-free
        and reads identically to C. Skipped in Python mode (there `(a, b)` is a
        tuple). Right-nested AN_COMMA so lowering discards each Left in turn. }
      if (not PyExprMode) and (CurTok.Kind = tkComma) then
      begin
        node := CurASTNode;
        while Eat(tkComma) do
        begin
          ParseExpr;
          valNode := AllocNode(AN_COMMA);
          ASTLeft[valNode] := node;
          ASTRight[valNode] := CurASTNode;
          ASTTk[valNode] := ASTTk[CurASTNode];
          node := valNode;
        end;
        CurASTNode := node;
        LastExprTk := IntToTypeKind(ASTTk[node]);
      end;
      Expect(tkRParen, ')');
      { Record that a Python comparison came out of an explicit paren group, so
        PyBitGuard can tell `(a == b) & c` (deliberate, and the very form its
        message asks for) from `a & b == c` (the precedence typo it exists to
        catch). Only stamped on an unmarked node — PY_BINOP_IDENTITY and
        friends share this field and outrank it. }
      if PyExprMode and (ASTKind[CurASTNode] = AN_BINOP) and
         (ASTSLen[CurASTNode] = 0) then
        ASTSLen[CurASTNode] := PY_BINOP_PARENED;
      { A parenthesised CALLABLE VALUE used directly as a callee —
        `(lambda a, b: a - b)(9, 4)`. The lambda lowering yields the raw
        closure/bound-fn pointer; it is `PyBoxCallableValue` that turns one into
        the variant the dynamic-call path recognises, and until now that ran
        only on an assignment's right-hand side. So the identical lambda bound to
        a NAME first was callable and the inline form raised "object is not
        callable" (bug-nilpy-immediately-invoked-lambda-is-not-callable).

        Boxing here rather than teaching the call site a second callability
        rule: the tyVariant dynamic-call loop further down already handles
        everything after this point, including a call whose result is itself
        callable. PyBoxCallableValue is a no-op on any node that is not one of
        the callable-producing calls, so a grouped expression of any other kind
        is untouched. }
      if PyExprMode and (CurTok.Kind = tkLParen) then
        CurASTNode := PyBoxCallableValue(CurASTNode);
      { Postfix suffix on a parenthesised expression: `(p)^`, `(p+k)^`, `(r).f`,
        `(a)[i]`. Without this the `^`/`.`/`[` were left dangling and the grouped
        value was used as-is (e.g. `(p)^` returned the pointer, not the pointee). }
      node := CurASTNode;
      { `.to_bytes(` / `.bit_length(` are left for the NilPy intrinsics — see PyIsIntMethodSuffixAhead. }
      { …and in PYTHON mode, so is every other `.` and `[`. This tail is
        Pascal-shaped: it builds a raw AN_INDEX for `[` and reads a record FIELD
        for `.`, neither of which is what a Python receiver means. So
        `("ab").upper()` was "expected newline after statement" and `(x)[1]`
        SIGSEGV'd — a grouped receiver was simply not usable, while the same
        expression without the parentheses worked. ParseFactor's own Python
        suffix loops (str methods, subscript/slice, variant dispatch, class
        methods) run immediately after this and handle all of it, so the fix is
        to stand down rather than to grow a Python arm here — the same call the
        comment below makes about not writing a fourth copy of member dispatch.
        `^` stays: it has no Python spelling and no Python loop.
        bug-nilpy-postfix-after-a-parenthesised-expression }
      while ((CurTok.Kind = tkCaret) or
             ((CurTok.Kind in [tkDot, tkLBrack]) and not PyExprMode)) and
            not (PyExprMode and PyIsIntMethodSuffixAhead) do
      begin
        { A grouped value whose type is a CLASS goes to the real member/index dispatcher --
          `(Data as TJSONArray)[0].ClassType` (fcl-json's suite).

          This tail used to hand-roll `.` and `[` itself, and it did so WITHOUT the class id:
          ResolveNodeRec has always known an as-cast's class, but the tail never asked. So
          `(b as T)[i]` built a raw AN_INDEX instead of dispatching the DEFAULT PROPERTY --
          leaving the AN_AS_CAST orphaned and unlowerable -- and `(b as T).Member` silently
          DROPPED an unresolvable member and evaluated to the object pointer.

          It was the THIRD copy of member/index dispatch (ParseLValueAST's suffix loop,
          ParseClassRecordSelectors, and this). The duplication was the bug, so this hands off
          rather than growing a fourth: default properties, virtual methods, properties and the
          class-reference ops all come along for free, and cannot drift again. }
        if (CurTok.Kind in [tkDot, tkLBrack]) then
        begin
          parenRec := ResolveNodeRec(node);
          if parenRec >= REC_UCLASS_BASE then
          begin
            tk := IntToTypeKind(ASTTk[node]);
            node := ParseClassRecordSelectors(node, parenRec, tk);
            recName := ResolveNodeRec(node);
            Continue;
          end;
        end;

        if CurTok.Kind = tkCaret then
        begin
          Next;
          indexNode := AllocNode(AN_DEREF);
          ASTLeft[indexNode] := node;
          { Resolve the pointee type from the inner node, mirroring the direct
            `ident^` path. A non-trivial pointer expression (binop/cast) carries
            no element-type tag, so default to Integer (matches `else` below). }
          tk := tyInteger; recName := REC_NONE;
          if IntToTypeKind(ASTTk[node]) = tyPointer then
          begin
            if ASTKind[node] = AN_IDENT then
            begin
              tk := Syms[ASTIVal[node]].PtrElemTk;
              recName := Syms[ASTIVal[node]].PtrElemRec;
            end
            else if (ASTKind[node] = AN_INDEX) and (ASTKind[ASTLeft[node]] = AN_IDENT) then
            begin
              tk := Syms[ASTIVal[ASTLeft[node]]].PtrElemTk;
              recName := Syms[ASTIVal[ASTLeft[node]]].PtrElemRec;
            end;
          end;
          ASTTk[indexNode] := StrValTk(tk);
          node := indexNode;
        end
        else if CurTok.Kind = tkLBrack then
        begin
          Next;
          indexNode := AllocNode(AN_INDEX);
          ASTLeft[indexNode] := node;
          ParseExpr;
          ASTRight[indexNode] := CurASTNode;
          Expect(tkRBrack, ']');
          ASTTk[indexNode] := ASTTk[node];
          node := indexNode;
        end
        else { tkDot — field or method of the grouped record/class value }
        begin
          Next;
          if CurTok.Kind in [tkEOF, tkSemicolon, tkAssign, tkRBrack, tkRParen] then
            Error('expected field name after .');
          prevTok := TokPos - 1;
          fieldName := GetTokenStr(prevTok);
          baseRec := ResolveNodeRec(node);
          mci := -1; mmi := -1;
          if baseRec >= REC_UCLASS_BASE then
          begin
            mci := baseRec - REC_UCLASS_BASE;
            if FindUProp(mci, fieldName) < 0 then
            begin
              mmi := FindUMethOverloadAhead(mci, fieldName, CountCallArgsAhead);
              if isNilPy and (mmi >= 0) then
                mmi := PyPromoteOverloadByKwAt(mci, mmi, PyKwNamesTokPos, fieldName);
            end;
          end;
          if (mmi >= 0) and (mci >= 0) then EnforceMethVis(mmi, fieldName);
          if (mmi >= 0) and (mci >= 0) and UClsIsInterface[mci] then
          begin
            { `(iface-expr).M(args)` — dispatch through the IMT slot, exactly like
              the direct `iface.M` path. The grouped node is the interface value. }
            mpi := UMthProc_[mmi];
            Next; { consume method name }
            mcallNode := AllocNode(AN_INTF_CALL);
            ASTRight[mcallNode] := node;
            ASTIVal[mcallNode] := mpi;
            ASTSOffset[mcallNode] := UMthVirSlot[mmi];
            ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            mlastArg := -1;
            if CurTok.Kind = tkLParen then
            begin
              Next;
              mai := 1; { param 0 = Self (provided by the fat pointer) }
              { `obj.F()` -- EMPTY parens on a method whose parameters ALL have defaults. FPC
                accepts it (fcl-json's own suite calls `J.FormatJSON()`); without this the loop hands
                the `)` to ParseExpr and reports "expected expression". A method with NO parameters
                already worked, because the loop simply never ran. }
              if CurTok.Kind = tkRParen then
              begin
                if (Procs[mpi].ParamCount > 1) and CanFillDefaultsFrom(mpi, 1) then
                  FillDefaultArgs(mpi, 1, mcallNode, mlastArg);
                mai := Procs[mpi].ParamCount;   { nothing to parse; Expect(tkRParen) consumes it }
              end;
              { `d.update(a=1)` / `d.update(**e)` — the keywords-are-KEYS case,
                asked the same way every other argument loop asks it. }
              if PyKwDictArgsHere(mpi) then
              begin
                margSeq := AllocNode(AN_ARG);
                ASTLeft[margSeq] := PyBuildKeywordDictHere;
                ASTIVal[margSeq] := 0;
                ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
                mai := Procs[mpi].ParamCount;
              end;
              { `obj.m(*xs)` — a call-site UNPACK (the callee declares ordinary
                parameters; the star is on the CALL). A star is not an expression, so
                the arity loop below cannot parse it: hand the whole argument list to
                the NilPy path, which expands the list across the remaining slots. }
              if isNilPy and (mai <= Procs[mpi].ParamCount-1) and PyStarArgAhead then
                PyStarUnpackMethodArgs(mpi, mcallNode, mlastArg, mai);
              while mai <= Procs[mpi].ParamCount-1 do
              begin
                if Procs[mpi].Params[mai].IsRef or Procs[mpi].Params[mai].IsArray then
                begin
                  if ByRefArgStartsExpression(ParamIsConstVariant(mpi, mai)) then
                  begin
                    { non-ident by-ref/array arg (@obj.Method to a method-pointer
                      param, [..] literals, casts): parse as an expression }
                    ParseArgExpr; mexprNode := CurASTNode;
                  end
                  else
                  begin
                    margIdx := FindSym(CurTok.SVal); Next;
                    mexprNode := ParseLValueAST(margIdx, TokPos - 2);
                  end;
                end
                else begin ParseArgExpr; mexprNode := CurASTNode; end;
                SetLitCheckArg(mexprNode, mpi, mai);
                margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := mexprNode;
                if mlastArg = -1 then ASTLeft[mcallNode] := margSeq
                else ASTRight[mlastArg] := margSeq;
                mlastArg := margSeq;
                if (mai < Procs[mpi].ParamCount-1) and CanFillDefaultsFrom(mpi, mai+1) then
                begin
                  FillDefaultArgs(mpi, mai+1, mcallNode, mlastArg);
                  mai := Procs[mpi].ParamCount-1;
                end
                else if mai < Procs[mpi].ParamCount-1 then Expect(tkComma, ',')
              else if isNilPy and (CurTok.Kind = tkComma) then Next;  { Python trailing comma }
                Inc(mai);
              end;
              Expect(tkRParen, ')');
            end;
            node := mcallNode;
          end
          else if mmi >= 0 then
          begin
            { `(expr).M(args)` on a non-interface class/record value (e.g.
              `(o as T).M`). The interface branch above only handled IMT dispatch;
              without this a class method silently lowered to an AN_FIELD read and
              was never called. Mirrors ParseClassRecordSelectors: static or
              virtual dispatch, Self = the grouped value (arg 0). }
            mpi := UMthProc_[mmi];
            if UMthVirSlot[mmi] >= 0 then
            begin
              mcallNode := AllocNode(AN_VIRTUAL_CALL);
              ASTRight[mcallNode] := UMthVirSlot[mmi];
            end
            else
              mcallNode := AllocNode(AN_CALL);
            ASTIVal[mcallNode] := mpi;
            ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := node;   { Self = arg 0 }
            ASTLeft[mcallNode] := margSeq;
            mlastArg := margSeq;
            Next; { consume method name }
            if CurTok.Kind = tkLParen then
            begin
              Next;
              mai := 1;
              { `obj.F()` -- EMPTY parens on a method whose parameters ALL have defaults. FPC
                accepts it (fcl-json's own suite calls `J.FormatJSON()`); without this the loop hands
                the `)` to ParseExpr and reports "expected expression". A method with NO parameters
                already worked, because the loop simply never ran. }
              if CurTok.Kind = tkRParen then
              begin
                if (Procs[mpi].ParamCount > 1) and CanFillDefaultsFrom(mpi, 1) then
                  FillDefaultArgs(mpi, 1, mcallNode, mlastArg);
                mai := Procs[mpi].ParamCount;   { nothing to parse; Expect(tkRParen) consumes it }
              end;
              nArgs := 0;
              while mai <= Procs[mpi].ParamCount - 1 do
              begin
                { NilPy `key=expr` here too. This is the loop a receiver reached
                  through a FIELD lands in (`self.canvas.create_window(...)`),
                  and it was the one method-call path with no keyword binding —
                  so an ordinary tkinter call worked through a local and failed
                  through a field (bug-nilpy-kwargs-on-a-field-receiver). }
                kwIdx := PyKwArgIndex(mpi, 1);
                if kwIdx > 0 then slotIdx := kwIdx - 1 else slotIdx := mai;
                if Procs[mpi].Params[slotIdx].IsRef or Procs[mpi].Params[slotIdx].IsArray then
                begin
                  if ByRefArgStartsExpression(ParamIsConstVariant(mpi, slotIdx)) then
                  begin
                    { non-ident by-ref/array arg (@obj.Method to a method-pointer
                      param, [..] literals, casts): parse as an expression }
                    ParseArgExpr; mexprNode := CurASTNode;
                  end
                  else
                  begin
                    margIdx := FindSym(CurTok.SVal); Next;
                    mexprNode := ParseLValueAST(margIdx, TokPos - 2);
                  end;
                end
                else begin ParseArgExpr; mexprNode := CurASTNode; end;
                margSeq := AllocNode(AN_ARG); ASTLeft[margSeq] := mexprNode;
                ASTIVal[margSeq] := kwIdx;
                ASTRight[mlastArg] := margSeq; mlastArg := margSeq;
                Inc(nArgs);
                if (kwIdx = 0) and (mai < Procs[mpi].ParamCount-1) and
                   CanFillDefaultsFrom(mpi, mai+1) then
                begin
                  FillDefaultArgs(mpi, mai+1, mcallNode, mlastArg);
                  mai := Procs[mpi].ParamCount-1;
                end
                else if mai < Procs[mpi].ParamCount-1 then
                begin
                  if isNilPy and (CurTok.Kind = tkRParen) then Break;
                  Expect(tkComma, ',');
                end
              else if isNilPy and (CurTok.Kind = tkComma) then Next;  { Python trailing comma }
                Inc(mai);
              end;
              { reorder keyword arguments into declaration order and fill the
                holes below the highest bound parameter }
              margSeq := ASTRight[ASTLeft[mcallNode]];   { first REAL arg (past Self) }
              if margSeq >= 0 then
              begin
                PyBindKwArgs(mpi, margSeq, mlastArg, nArgs);
                ASTRight[ASTLeft[mcallNode]] := margSeq;
              end;
              Expect(tkRParen, ')');
            end;
            { result type for chaining (e.g. (o as T).GetChild.M) }
            if (Procs[mpi].RetType = tyClass) or (Procs[mpi].RetType = tyRecord) then
              ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
            node := mcallNode;
          end
          else
          begin
            { Property on a grouped/cast value `(expr).Prop` — resolve to the
              backing field or getter call like ParseClassRecordSelectors (read
              side only: a grouped value is not an lvalue). Falling through to
              the raw field builder read offset 0 — the VMT pointer
              (bug-downcast-inherited-property-wrong-offset's sibling). }
            pri := -1;
            if mci >= 0 then pri := FindUProp(mci, fieldName);
            if (pri >= 0) and (UPropReadFLen[pri] > 0) then
            begin
              fieldNode := AllocNode(AN_FIELD);
              ASTLeft[fieldNode] := node;
              ASTSOffset[fieldNode] := UPropReadFOff[pri];
              ASTSLen[fieldNode] := UPropReadFLen[pri];
              grpAcc := '';
              for i := 0 to UPropReadFLen[pri] - 1 do
                AppendChar(grpAcc, TokChars[UPropReadFOff[pri] + i]);
              ASTTk[fieldNode] := Ord(RecFieldType(baseRec, grpAcc));
              Next;
              node := fieldNode;
            end
            else if (pri >= 0) and (UPropReadMLen[pri] > 0) then
            begin
              grpAcc := '';
              for i := 0 to UPropReadMLen[pri] - 1 do
                AppendChar(grpAcc, TokChars[UPropReadMOff[pri] + i]);
              mmi := FindUMeth(mci, grpAcc);
              if mmi < 0 then Error('getter method not found: ' + grpAcc);
              mpi := UMthProc_[mmi];
              Next; { consume property name }
              margIdx := -1;
              if UPropIsIndexed[pri] then ParsePropIndexArgs(margIdx, mlastArg)
            else PropIndexConstArg(pri, margIdx, mlastArg);
              if UMthVirSlot[mmi] >= 0 then
              begin
                mcallNode := AllocNode(AN_VIRTUAL_CALL);
                ASTRight[mcallNode] := UMthVirSlot[mmi];
              end
              else
                mcallNode := AllocNode(AN_CALL);
              ASTIVal[mcallNode] := mpi;
              ASTTk[mcallNode] := Ord(Procs[mpi].RetType);
              margSeq := AllocNode(AN_ARG);
              ASTLeft[margSeq] := node;
              ASTLeft[mcallNode] := margSeq;
              { Getter args: self [, index...] }
              if margIdx >= 0 then ASTRight[margSeq] := margIdx;
              node := mcallNode;
            end
            else if pri >= 0 then
              Error('property is write-only')
            else
            begin
              fieldNode := AllocNode(AN_FIELD);
              ASTLeft[fieldNode] := node;
              ASTSOffset[fieldNode] := Tokens[prevTok].SOffset;
              ASTSLen[fieldNode] := Tokens[prevTok].SLen;
              ASTTk[fieldNode] := Ord(RecFieldType(baseRec, fieldName));
              Next;
              node := fieldNode;
            end;
          end;
        end;
      end;
      CurASTNode := node;
    end;
    tkMinus:
    begin
      Next; ParseFactor;
      left := CurASTNode;
      if PyExprMode and PyNodeIsComplex(left) then
      begin
        { `-z` on a complex negates both components. Its own arm because
          complex is a pylib class and the user-class arm below excludes those,
          which would leave it in the AN_NEG path negating the object HANDLE. }
        node := PyCallProc1('pycomplex_neg', left);
      end
      else if PyExprMode and (IntToTypeKind(ASTTk[left]) = tyClass) and
         (ResolveNodeRec(left) >= REC_UCLASS_BASE) then
      begin
        { `-n` on a user class's own `__neg__` dunder — same silent-garbage
          root cause as the binary +/-/*// dunder dispatch
          (bug-nilpy-arithmetic-operator-dunders-not-dispatched): with no
          check here, a tyClass operand fell straight into the untyped AN_NEG
          below and printed the class HANDLE negated as if it were an
          integer. }
        node := PyCallMeth1(ResolveNodeRec(left) - REC_UCLASS_BASE, '__neg__', left, -1);
        if node < 0 then
          node := PyMakeUnsupportedOperand;   { runtime TypeError, not a build abort }
      end
      else
      begin
        node := AllocNode(AN_NEG); ASTLeft[node] := left;
        { Carry the operand's type, as the additive-level sign in
          ParseSimpleExpr does. Left untagged, `-(a // b)` on an
          Int64-returning helper printed 18446744073709551613 instead of -3
          — the untyped node read unsigned. }
        ASTTk[node] := ASTTk[left];
      end;
      CurASTNode := node;
    end;
    tkNot:
    begin
      Next; ParseFactor;
      left := CurASTNode;
      { `not` is bitwise complement for integer operands (matches FPC), logical
        for Boolean and everything else. The earlier all-logical rule existed
        because a prior attempt keyed bitwise-vs-logical off the GLOBAL
        LastExprTk tracker, which is clobbered between factors — so a boolean
        `while not done` was mistyped as bitwise and hung self-compile.

        Drive it off the operand node's OWN type, but ONLY trust that type for
        operand node kinds whose type is authoritative: an integer LITERAL or an
        IDENTIFIER (its symbol's declared type). Computed expressions — AN_BINOP
        (comparisons / boolean ops) and AN_CALL (boolean-returning functions) —
        are NOT trusted here: PXX tags some of them tyInteger/tyInt64 even when
        they are logically Boolean (e.g. `not (a = b)`, `not Eat(...)` appear in
        compiler.pas with ASTTk = tyInteger), and promoting those to bitwise
        diverges from FPC and breaks self-host / cross-bootstrap. So those keep
        the long-standing logical behaviour. The IR_NOT codegen already emits
        `not rax` for ordinal-non-boolean types. }
      node := AllocNode(AN_NOT); ASTLeft[node] := left;
      { Bitwise only when the operand's integer type is AUTHORITATIVE. Beyond the
        literal/identifier base case, three more operand shapes carry a trustworthy
        integer type and so were wrongly forced boolean (the result became `xor
        rax,1` — e.g. `not Int64(0)` printed TRUE):
          - a built-in ordinal value-cast `Int64(e)`/`Cardinal(e)` (AN_PTR_CAST,
            ASTIVal=-1) and the `Integer(e)`/`LongWord(e)` token-casts (AN_CALL
            with the cast's negative op id);
          - a pure ARITHMETIC/shift AN_BINOP (`x-1`, `x shr 1`): its operator is
            unambiguously numeric, so unlike a comparison/`and`/`or`/`xor` binop
            (which PXX sometimes mistags integer though it is logically boolean)
            it can never be boolean. `shr` is lexed as an identifier, so its
            operator id is Ord(tkIdent) — the only ident-operator binop.
        and/or/xor stay logical (ambiguous), matching the prior behaviour, so the
        compiler's own `not (a or b)` / `not (r and v)` keep self-host identical. }
      notOp := Integer(ASTIVal[left]);
      opIsArith := (notOp = Ord(tkPlus)) or (notOp = Ord(tkMinus)) or
                   (notOp = Ord(tkStar)) or (notOp = Ord(tkDiv)) or
                   (notOp = Ord(tkMod)) or (notOp = Ord(tkShl)) or
                   (notOp = Ord(tkIdent)) or
                   { and/or/xor are distrusted in general because a LOGICAL
                     and/or is sometimes mistagged tyInteger (self-host relies
                     on those staying logical — trusting all integer-tagged
                     and/or breaks the fixedpoint). But an EXPLICIT sized type
                     tag (tyInt8..tyNativeUInt, 7..16) never comes from that
                     mistag — it means both operands really are that integer
                     type — so `not (q3 or q4)` on qwords is bitwise
                     (tint642's testnotqword printed a boolean flip). Plain
                     tyInteger(1)-tagged and/or/xor stays logical. }
                   (((notOp = Ord(tkAnd)) or (notOp = Ord(tkOr)) or
                     (notOp = Ord(tkXor))) and
                    (ASTTk[left] >= 7) and (ASTTk[left] <= 16));
      bitNot :=
        ((ASTTk[left] = 1) or ((ASTTk[left] >= 7) and (ASTTk[left] <= 16))) and
        ((ASTKind[left] = AN_INT_LIT) or (ASTKind[left] = AN_IDENT) or
         { An ARRAY ELEMENT, a record/class FIELD and a DEREF carry the declared type of
           the element / field / pointee, which is exactly as authoritative as a variable's
           — and they were missing from this list, so `not arr[i]` and `not rec.f` were
           lowered as a BOOLEAN not. `not rb[0]` printed TRUE, and `mask[i] and not
           rhs[i]` silently produced garbage: bit manipulation on array elements (masks,
           hashing, crypto) was quietly wrong while the same code on a plain variable was
           right. The tyBoolean guard above still keeps a genuine Boolean element logical. }
         (ASTKind[left] = AN_INDEX) or (ASTKind[left] = AN_FIELD) or
         (ASTKind[left] = AN_DEREF) or
         { a nested BITWISE not: its integer tag (checked above) is ours to
           trust — `not(not(q))` flipped the outer one to boolean (tint642
           error 2701). An inner LOGICAL not is tyBoolean and never gets here. }
         (ASTKind[left] = AN_NOT) or
         ((ASTKind[left] = AN_PTR_CAST) and
          ((Integer(ASTIVal[left]) = -1) or (Integer(ASTIVal[left]) = -3))) or
         ((ASTKind[left] = AN_CALL) and
          ((Integer(ASTIVal[left]) = -Ord(tkInteger_T)) or
           (Integer(ASTIVal[left]) = -Ord(tkLongWord_T)) or
           { Ord(x) is an integer by definition — it was missing here, so
             `not ord(e)` lowered as a BOOLEAN not (xor 1): silently wrong
             integers in any hash/mask over an ordinal
             (bug-pascal-not-of-ord-uses-boolean-negation). }
           (Integer(ASTIVal[left]) = -Ord(tkOrd)))) or
         { A user function call whose DECLARED return type is a non-boolean
           ordinal is authoritative (unlike the node's ASTTk, which PXX sometimes
           mistags). This trusts `not f()` for an Int64/Integer-returning f
           (e.g. C const-eval `~CEvalConstPrimary()`) as bitwise, while a
           Boolean-returning f (RetType = tyBoolean, e.g. `not Eat(..)`) still
           falls through to logical. }
         ((ASTKind[left] = AN_CALL) and (Integer(ASTIVal[left]) >= 0) and
          (Integer(ASTIVal[left]) < ProcCount) and
          TypeIsOrdinal(Procs[Integer(ASTIVal[left])].RetType) and
          (Procs[Integer(ASTIVal[left])].RetType <> tyBoolean)) or
         ((ASTKind[left] = AN_BINOP) and opIsArith));
      if bitNot then
      begin
        ASTTk[node] := ASTTk[left];
        { FPC complements `ord(x)` at the OPERAND's width: ord(char/boolean) is
          byte-sized (`not ord('a')` = 158, not -98); a subword/64-bit integer
          operand keeps its own width; an enum stays the 4-byte default. }
        if (ASTKind[left] = AN_CALL) and (Integer(ASTIVal[left]) = -Ord(tkOrd)) then
        begin
          notOrdTk := IntToTypeKind(ASTTk[ASTLeft[ASTLeft[left]]]);
          if (notOrdTk = tyChar) or (notOrdTk = tyBoolean) then
            ASTTk[node] := Ord(tyUInt8)
          else if (Ord(notOrdTk) >= 7) and (Ord(notOrdTk) <= 16) then
            ASTTk[node] := Ord(notOrdTk);
        end;
        LastExprTk := IntToTypeKind(ASTTk[node]);
      end
      else
      begin
        ASTTk[node] := Ord(tyBoolean);
        LastExprTk := tyBoolean;
      end;
      CurASTNode := node;
    end;
    tkInteger_T, tkLongWord_T:
    begin
      { 'byte'/'longword' collide with 'integer'/'longint' on token KIND (all
        four lex as tkInteger_T/tkLongWord_T -- see asmenc.inc's documented
        landmine on this), so disambiguate on the source text, same technique
        SizeOf's type-name parsing already uses. A genuine byte/cardinal cast
        needs real width truncation (AN_PTR_CAST, routes through the masking
        logic in ir.inc's AN_PTR_CAST case) -- not the Integer/LongWord
        "value-pun" passthrough (AN_CALL, result bit pattern = operand's,
        unchanged), which stays exactly as it was for actual Integer/LongInt
        casts. See bug-narrowing-typecast-rvalue-no-truncate. }
      if CaseEqual(CurTok.SVal, 'byte') then
      begin
        Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
        { demote a promotable operand first — see PromoDemoteToInt64 }
        CurASTNode := PromoDemoteToInt64(CurASTNode);
        vcNode := VariantCastToTemp(CurASTNode, tyUInt8);   { Byte(v) converts }
        if vcNode >= 0 then
        begin
          CurASTNode := vcNode;
          LastExprTk := tyUInt8;
        end
        else
        begin
          node := AllocNode(AN_PTR_CAST);
          ASTLeft[node] := CurASTNode;
          ASTIVal[node] := -1;
          ASTTk[node] := Ord(tyUInt8);
          CurASTNode := node;
          LastExprTk := tyUInt8;
        end;
      end
      else if CaseEqual(CurTok.SVal, 'longword') then
      begin
        Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
        { demote a promotable operand first — see PromoDemoteToInt64 }
        CurASTNode := PromoDemoteToInt64(CurASTNode);
        vcNode := VariantCastToTemp(CurASTNode, tyUInt32);   { LongWord(v) converts }
        if vcNode >= 0 then
        begin
          CurASTNode := vcNode;
          LastExprTk := tyUInt32;
        end
        else
        begin
          node := AllocNode(AN_PTR_CAST);
          ASTLeft[node] := CurASTNode;
          ASTIVal[node] := -1;
          ASTTk[node] := Ord(tyUInt32);
          CurASTNode := node;
          LastExprTk := tyUInt32;
        end;
      end
      else
      begin
        op := Ord(CurTok.Kind);
        Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
        { a promotable operand demotes before the pun — see PromoDemoteToInt64 }
        CurASTNode := PromoDemoteToInt64(CurASTNode);
        { …and a VARIANT operand is a CONVERSION, not a pun — see
          VariantCastToTemp. Same Exit shape as the Explicit-operator arm
          just below. }
        vcNode := VariantCastToTemp(CurASTNode, tyInteger);
        if vcNode >= 0 then
        begin
          CurASTNode := vcNode;
          LastExprTk := tyInteger;
          Exit;
        end;
        { `operator Explicit(a: TFoo): Integer` — an Integer(recordValue)
          cast with a matching Explicit overload is the conversion CALL
          (toperator11), not the value-pun. }
        if ((IntToTypeKind(ASTTk[CurASTNode]) = tyRecord) or
            (IntToTypeKind(ASTTk[CurASTNode]) = tyClass)) then
        begin
          i := FindOpOverload(OPK_EXPLICIT, ASTTk[CurASTNode], ResolveNodeRec(CurASTNode));
          if (i >= 0) and TypeIsOrdinal(Procs[i].RetType) then
          begin
            argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
            node := AllocNode(AN_CALL); ASTIVal[node] := i;
            ASTTk[node] := Ord(Procs[i].RetType);
            ASTLeft[node] := argSeq;
            CurASTNode := node;
            LastExprTk := Procs[i].RetType;
            Exit;
          end;
        end;
        node := AllocNode(AN_CALL); ASTIVal[node] := -op;
        ASTTk[node] := Ord(tyInteger);
        argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
        ASTLeft[node] := argSeq;
        CurASTNode := node;
      end;
    end;
    tkChar_T, tkBoolean_T:
    begin
      { `Char(x)` / `Boolean(x)` value-puns — same passthrough model as Chr/Ord:
        the result type is the cast type, the bit pattern is the operand's. }
      op := Ord(CurTok.Kind);
      if CurTok.Kind = tkChar_T then LastExprTk := tyChar else LastExprTk := tyBoolean;
      Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
      { demote a promotable operand first, or the pun takes the low byte of the
        SLOT ADDRESS — `Char(n)` for n = 65 gave a character from the pointer,
        not 'A'. See PromoDemoteToInt64. }
      CurASTNode := PromoDemoteToInt64(CurASTNode);
      { a VARIANT operand converts instead of punning — see VariantCastToTemp.
        `Char(v)` punned the tag word into a control character and `Boolean(v)`
        was right only by accident (a non-zero tag reads as True). }
      if op = Ord(tkChar_T) then castTk := tyChar else castTk := tyBoolean;
      vcNode := VariantCastToTemp(CurASTNode, castTk);
      if vcNode >= 0 then
      begin
        CurASTNode := vcNode;
        LastExprTk := castTk;
      end
      else
      begin
        node := AllocNode(AN_CALL); ASTIVal[node] := -op;
        if op = Ord(tkChar_T) then ASTTk[node] := Ord(tyChar) else ASTTk[node] := Ord(tyBoolean);
        argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
        ASTLeft[node] := argSeq;
        CurASTNode := node;
      end;
    end;
    tkSingle_T, tkDouble_T, tkExtended_T:
    begin
      { Value typecast to a float type, `Single(expr)` / `Double(expr)`. Unlike
        the integer/char puns this is a real conversion (int->float, or
        double->single narrowing), so desugar to a hidden temp of the cast type
        plus an assignment — the ordinary store path already coerces the operand.
        Reuses the generic assign-then-yield node (AN_STR_FROM_CHAR: Left = the
        store side-effect, Right = the temp read). `Extended` aliases Double. }
      { The temp's type is the CAST's, not the OPERAND's: `ParseExpr` overwrites
        LastExprTk with the operand's kind, so `op := AllocVar('', LastExprTk)`
        handed the "conversion" a temp of the source type and the conversion
        never happened — `Single(d)` in expression position printed the
        unnarrowed double (3.7000000000 vs FPC's 3.7000000480), and for a
        VARIANT operand it built a VARIANT temp, so `Double(v)` stored the
        16-byte record through an 8-byte value and SEGFAULTED. Capturing the
        kind before ParseExpr fixes both: a variant temp becomes a real Double
        temp, and the store path then emits the variant unbox by itself.
        bug-p-a-typecast-of-a-variant-reinterprets-it-instead-of-converting }
      if CurTok.Kind = tkSingle_T then castTk := tySingle else castTk := tyDouble;
      LastExprTk := castTk;
      Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
      LastExprTk := castTk;
      op := AllocVar('', castTk);
      node := AllocNode(AN_STR_FROM_CHAR);
      argSeq := AllocNode(AN_IDENT);             { store LHS = the temp }
      ASTIVal[argSeq] := op; ASTTk[argSeq] := Ord(Syms[op].TypeKind);
      left := AllocNode(AN_ASSIGN);
      ASTLeft[left] := argSeq; ASTRight[left] := CurASTNode;
      ASTTk[left] := Ord(Syms[op].TypeKind);
      ASTLeft[node] := left;
      identNode := AllocNode(AN_IDENT);          { yielded value = the temp }
      ASTIVal[identNode] := op; ASTTk[identNode] := Ord(Syms[op].TypeKind);
      ASTRight[node] := identNode;
      ASTTk[node] := Ord(Syms[op].TypeKind);
      CurASTNode := node;
    end;
    tkString_T:
    begin
      { `String(x)`. For a string operand it is identity (passthrough). For a Char
        operand it must produce a *string value*; route through AN_STR_FROM_CHAR
        which reuses the `s := c` store into a hidden temp, then yields the temp —
        so it works in both frozen and managed string modes with no backend code. }
      LastExprTk := tyString;
      Next; Expect(tkLParen, '('); ParseExpr; Expect(tkRParen, ')');
      if (IntToTypeKind(ASTTk[CurASTNode]) = tyString) or
         (IntToTypeKind(ASTTk[CurASTNode]) = tyAnsiString) then
      begin
        node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkString_T);
        ASTTk[node] := ASTTk[CurASTNode];
        argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
        ASTLeft[node] := argSeq;
        CurASTNode := node;
      end
      else if IntToTypeKind(ASTTk[CurASTNode]) = tyChar then
      begin
        { Build the desugar at parse time so it goes through the same AST passes
          as hand-written code: a hidden string temp, `__t := c` (char->string
          store), and a read of __t. AN_STR_FROM_CHAR.Left = the assign (side
          effect), .Right = the temp read (the yielded value). The temp is tyString
          to match the `String` keyword (always frozen tyString in this dialect,
          even under PXX_MANAGED_STRING where only `AnsiString` is managed). }
        op := AllocVar('', tyString);
        node := AllocNode(AN_STR_FROM_CHAR);
        argSeq := AllocNode(AN_IDENT);       { LHS of the store }
        ASTIVal[argSeq] := op; ASTTk[argSeq] := Ord(Syms[op].TypeKind);
        left := AllocNode(AN_ASSIGN);
        ASTLeft[left] := argSeq; ASTRight[left] := CurASTNode;
        ASTTk[left] := Ord(Syms[op].TypeKind);
        ASTLeft[node] := left;
        identNode := AllocNode(AN_IDENT);     { the yielded value }
        ASTIVal[identNode] := op; ASTTk[identNode] := Ord(Syms[op].TypeKind);
        ASTRight[node] := identNode;
        ASTTk[node] := Ord(Syms[op].TypeKind);
        CurASTNode := node;
      end
      else
      begin
        { A VARIANT operand is the variant->string CONVERSION (FPC's
          `String(v)`), which the store into a string temp already emits —
          see VariantCastToTemp. Before this it was a hard error. }
        vcNode := VariantCastToTemp(CurASTNode, tyString);
        if vcNode >= 0 then
        begin
          CurASTNode := vcNode;
          LastExprTk := tyString;
        end
        else
          Error('String(): operand must be Char or string');
      end;
    end;
    tkSysOpen:
    begin
      Next; Expect(tkLParen, '(');
      if CurTok.Kind <> tkIdent then Error('SysOpen: expected string var');
      idx := FindSym(CurTok.SVal); Next;
      valNode := ParseLValueAST(idx, TokPos - 2);
      if (idx < 0) or ((not TypeIsFrozenString(Syms[idx].TypeKind)) and
                       (Syms[idx].TypeKind <> tyAnsiString)) then Error('SysOpen: not a string var');
      Expect(tkComma, ',');

      argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := valNode;
      ParseExpr;
      argSeq2 := AllocNode(AN_ARG); ASTLeft[argSeq2] := CurASTNode;
      ASTRight[argSeq] := argSeq2;
      Expect(tkRParen, ')');

      node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkSysOpen);
      ASTLeft[node] := argSeq;
      CurASTNode := node;
    end;
    tkSysRead:
    begin
      Next; Expect(tkLParen, '(');
      ParseExpr;
      argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
      Expect(tkComma, ',');
      if CurTok.Kind <> tkIdent then Error('SysRead: expected array var');
      idx := FindSym(CurTok.SVal); Next;
      valNode := ParseLValueAST(idx, TokPos - 2);
      if (idx < 0) or not Syms[idx].IsArray then Error('SysRead: not an array var');
      Expect(tkComma, ',');

      argSeq2 := AllocNode(AN_ARG); ASTLeft[argSeq2] := valNode;
      ASTRight[argSeq] := argSeq2;
      ParseExpr;
      argSeq3 := AllocNode(AN_ARG); ASTLeft[argSeq3] := CurASTNode;
      ASTRight[argSeq2] := argSeq3;
      Expect(tkRParen, ')');

      node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkSysRead);
      ASTLeft[node] := argSeq;
      CurASTNode := node;
    end;
    tkSyswrite:
    begin
      Next; Expect(tkLParen, '(');
      ParseExpr;
      argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
      Expect(tkComma, ',');
      if CurTok.Kind <> tkIdent then Error('Syswrite: expected array var');
      idx := FindSym(CurTok.SVal); Next;
      valNode := ParseLValueAST(idx, TokPos - 2);
      if (idx < 0) or not Syms[idx].IsArray then Error('Syswrite: not an array var');
      Expect(tkComma, ',');

      argSeq2 := AllocNode(AN_ARG); ASTLeft[argSeq2] := valNode;
      ASTRight[argSeq] := argSeq2;
      ParseExpr;
      argSeq3 := AllocNode(AN_ARG); ASTLeft[argSeq3] := CurASTNode;
      ASTRight[argSeq2] := argSeq3;
      Expect(tkRParen, ')');

      node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkSyswrite);
      ASTLeft[node] := argSeq;
      CurASTNode := node;
    end;
    tkArgCount:
    begin
      Next;
      if CurTok.Kind = tkLParen then begin Next; Expect(tkRParen, ')'); end;
      node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkArgCount);
      { ParamCount is an Integer, and the node has to SAY so. Left unset it
        defaulted to tyUnknown, and anything that materialises the value into a
        hidden temp copied that: `for i := 0 to ParamCount do` gave the loop
        LIMIT temp no type. x86-64 and the other backends do not inspect it and
        happened to work; i386 checks every symbol it touches, so it refused —
        which is why `uses pylib` could not be built for i386 AT ALL (pylib's
        pysys_argv is exactly this loop), taking base64, http and
        examples/net/httpdemo.pas with it, and every NilPy program besides.
        The tkArgStr arm below never had the bug because it allocates its
        destination temp explicitly typed. Hoisting the limit into a variable,
        or using a USER function as the limit, both worked — that pair is what
        localised it here rather than to the for-loop lowering.
        bug-a-paramcount-node-has-no-type-so-i386-refuses-any-pylib-user }
      ASTTk[node] := Ord(tyInteger);
      CurASTNode := node;
    end;
    tkArgStr:
    begin
      { Inline ParamStr(i): the 2-arg ArgStr(i, var) codegen needs a destination
        string. Synthesize a hidden frozen-string temp, copy argv[i] into it
        (EmitArgvToString — a frozen buffer write, no managed release, so the temp
        needs no nil-init), and yield the temp. Lets ParamStr(i) be used directly
        in any expression (comparison, argument), not only as an assignment RHS.
        The temp is tyString (frozen) even under managed strings, matching the
        `String` keyword temp above. }
      Next; Expect(tkLParen, '(');
      ParseExpr;                            { index expression }
      Expect(tkRParen, ')');
      op := AllocVar('', tyString);
      { 2-arg ArgStr call: arg0 = index, arg1 = the temp (lvalue) }
      argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
      identNode := AllocNode(AN_IDENT);
      ASTIVal[identNode] := op; ASTTk[identNode] := Ord(Syms[op].TypeKind);
      argSeq2 := AllocNode(AN_ARG); ASTLeft[argSeq2] := identNode;
      ASTRight[argSeq] := argSeq2;
      node := AllocNode(AN_CALL); ASTIVal[node] := -Ord(tkArgStr);
      ASTLeft[node] := argSeq;
      { AN_STR_FROM_CHAR: Left = the ArgStr side-effect, Right = read the temp. }
      left := AllocNode(AN_STR_FROM_CHAR);
      ASTLeft[left] := node;
      identNode := AllocNode(AN_IDENT);
      ASTIVal[identNode] := op; ASTTk[identNode] := Ord(Syms[op].TypeKind);
      ASTRight[left] := identNode;
      ASTTk[left] := Ord(Syms[op].TypeKind);
      CurASTNode := left;
    end;
    tkIdent:
    begin
      name := CurTok.SVal;
      { A GENERATOR called in VALUE position — `g = gen()`, `list(gen())`,
        `next(gen())`. The `for` header has its own desugar and never reaches
        here; everything else becomes a cursor object (PyBuildGeneratorValue,
        pyparser.inc). Ahead of every other arm because the name resolves to an
        ordinary proc and would otherwise be CALLED — which, with the injected
        instance parameter, is a step function invoked with the user's
        arguments. That is why this used to be an arity error rather than a
        wrong answer, and the arm must keep it from becoming one. }
      { PyProgSym, not FindSym: FindSym also answers for a PARAMETER symbol left
        behind by some RTL unit's routine, so a user generator named `src` — a
        parameter name in json.pas and ed25519.pas — was refused here and fell
        through to be CALLED, while the same generator named `gen` worked. The
        question this guard asks is whether the PROGRAM binds the name to
        something else, and only the program's own scope can answer it. }
      if PyExprMode and (Tokens[TokPos].Kind = tkLParen) and
         (PyProgSym(name) < 0) then
      begin
        procIdx := FindProcInUnit(name, -1);
        if procIdx < 0 then procIdx := FindProc(name);
        if (procIdx >= 0) and ProcIsStackless[procIdx] and
           ProcIsGenerator[procIdx] then
        begin
          CurASTNode := PyBuildGeneratorValue(procIdx);
          LastExprTk := IntToTypeKind(ASTTk[CurASTNode]);
          Exit;
        end;
      end;
      { A bare def NAME in a value position is that function's ADDRESS. Python
        has no paramless call without parentheses — `f` is the function, `f()`
        calls it — so unlike Pascal there is nothing to disambiguate, and
        without this the name fell through to the paramless-call/Result path
        (feature-nilpy-function-values). Only when a '(' does NOT follow, and
        only for a name that resolves to a proc and not to a variable.

        A '.' does not follow either: there the name is a QUALIFIER or a
        receiver, never a function value — a function value has no members. The
        C library namespace is flat and shares names with Python modules
        (crtl's <stdlib.h> declares `atexit`), so pulling any C unit used to
        make this branch swallow `atexit` in `atexit.register(fn)`, leaving the
        parser on the dot and reporting "Expected: =". The module had imported
        and resolved perfectly well; only the dotted form broke.
        bug-nilpy-import-lost-after-a-fallback-import-block. }
      { A BUILTIN TYPE NAME in VALUE position — `t = str`, `f(str)`,
        `string_types = (str,)`, `{"k": int}`, `[str, int]`.

        AHEAD of the function-value arm below and of every conversion arm
        further down, and it has to be both. The conversion arms all open with
        `Next; Expect(tkLParen, '(')`, so with no '(' after the name they
        reported a bare "unexpected token" — a builtin type could be CALLED and
        never BOUND. And `list` / `dict` / `tuple` / `bytes` / `bool` are also
        pylib PROCS, so the function-value arm below claimed those five first
        and `print([str, list])` rendered `[<class 'str'>, <function at 0x...>]`
        — the same name answering two different things depending on which
        builtin happened to exist. One arm for all eleven names.

        A following '.' is excluded for the same reason that arm excludes it:
        `str.lower` as an unbound method value is a different construct with its
        own path. bug-n-a-type-name-is-not-a-first-class-value }
      if isNilPy and PyExprMode and (TokPos <= TokCount) and
         (Tokens[TokPos].Kind <> tkLParen) and (Tokens[TokPos].Kind <> tkDot) and
         (PyBuiltinTypeCode(name) > 0) and (not PyUserShadowsProc(name)) and
         (FindSym(name) < 0) then
      begin
        Next;
        CurASTNode := PyMakeBuiltinTypeValue(PyBuiltinTypeCode(name));
        LastExprTk := tyVariant;
        Exit;
      end;
      if PyExprMode and (CurTok.Kind = tkIdent) and
         (Tokens[TokPos].Kind <> tkLParen) and (Tokens[TokPos].Kind <> tkDot) and
         ((FindSym(name) < 0) or PyNestedDefOutranksSym(name)) and
         (FindProcExactCase(PyQualifyNested(name)) >= 0) then
      begin
        { EXACT case, as in PyMakeFuncValue's twin arm: a Python name is
          case-sensitive and Pascal's proc lookup is not, so `Counter` used to
          answer for `counter`. }
        idx := FindProcExactCase(PyQualifyNested(name));
        { Same fix as PyMakeFuncValue's twin case, needed here too since a
          bare callable in an ordinary expression position (a `key=`/`cmp=`
          keyword argument, not an assignment RHS) reaches THIS handler
          instead: the first FindProc match may not be the SAFE overload
          (`len`'s first declared one takes a TPyBytes, not a Variant), and
          even the safe one's RETURN isn't the Variant-hidden-destination-
          pointer convention every callable-value dispatcher assumes --
          `sorted(xs, key=len)` crashed even though `f = len; sorted(xs,
          key=f)` (going through PyMakeFuncValue) already worked.
          feature-nilpy-callable-value-unified-dispatch }
        altPi := PyFindVariantParamOverload(name, Procs[idx].ParamCount);
        if altPi >= 0 then idx := altPi;
        if Procs[idx].RetType <> tyVariant then
        begin
          paramsAllVariant := True;
          for wpj := 0 to Procs[idx].ParamCount - 1 do
            if Procs[idx].Params[wpj].TypeKind <> tyVariant then
            begin
              paramsAllVariant := False;
              Break;
            end;
          if paramsAllVariant and (Procs[idx].ParamCount = 1) and
             Procs[idx].IsFunc and PyScalarWrappableRetType(Procs[idx].RetType) then
            idx := PyGetOrMakeCallableWrapper(idx);
        end;
        Next;
        { A nested def whose meaning depends on values live NOW (default-arg
          expressions, captured enclosing locals) cannot travel as a bare
          address — bind those values into a closure (uforth's DOES>).
          -1 = nothing to bind, the plain address stays. }
        node := PyNestedDefClosureValue(idx);
        if node < 0 then
        begin
          { A callee that COLLECTS cannot travel as a bare address either: the
            packing of surplus arguments into its one TPyList parameter is
            work the CALL SITE does, and an address carries nothing that says
            so. The {code, recv} pair does — pybound_new_star records the star
            position — so a variadic def takes that road even with no captures.
            `return wrapper` over `def wrapper(*args)` (the shape every Python
            decorator has) otherwise called the body with loose Variants where
            it declares a list. }
          { ...and NEITHER CAN A CALLEE WITH DEFAULTS, for exactly the same
            reason one word later. The star case above was written when the
            pair's only extra cargo was the star position; the pair now also
            carries the SIGNATURE record -- ReqN/TotN, the def-time default
            values and the parameter names -- and a bare address carries none
            of it. So a def with any defaulted parameter must take the same
            road, or `fs = [g]` / `take(g)` on `def g(a, b=7)` enters a
            two-parameter body through a one-parameter pointer and reads
            whatever the previous call left where `b` lives.

            This is the sibling-arm shape from
            devdocs/dev/normalise-dont-special-case.md: one concept ("this
            callee cannot travel as a bare address") served by a condition
            listing the reasons, and only the first reason was listed. Measured
            rather than reasoned -- `f = g` went through PyMakeFuncValueFor and
            worked while `fs = [g]` did not reach it at all, which is what
            pointed here.
            bug-n-a-module-level-def-taken-as-a-value-loses-its-defaults }
          if (idx >= 0) and (idx < ProcCount) and
             ((ProcPyStarIdx[idx] >= 0) or PyProcHasDefaultParam(idx)) then
            node := PyMakeFuncValueFor(idx, name);
          if node >= 0 then
          begin
            CurASTNode := node;
            LastExprTk := tyVariant;
            Exit;
          end;
          node := AllocNode(AN_PROCADDR);
          ASTIVal[node] := idx;
          ASTTk[node] := Ord(tyPointer);
          CurASTNode := node;
          LastExprTk := tyPointer;
          Exit;
        end;
        CurASTNode := node;
        LastExprTk := tyPointer;
        Exit;
      end;

      { A NilPy def nested in another def is registered QUALIFIED
        (`outer.inner`) so two parents may each define a `helper` without the
        first registration winning every lookup. Inside the enclosing body the
        call is written unqualified, so rewrite the name here, before any
        lookup — overload matching resolves by name too, not just FindProc
        (feature-nilpy-nested-defs). }
      if PyExprMode and (PyNestPrefix <> '') and
         ((FindSym(name) < 0) or PyNestedDefOutranksSym(name)) then
        name := PyQualifyNested(name);
      if CaseEqual(name, 'await') and CurProcIsAsync then

            local truncate it at the store (`start = int(vm.pop())` of
            maxint read back as -1 — uforth's DO index). }
          ASTIVal[node] := -200; ASTTk[node] := Ord(tyInt64);
        end;
        argSeq := AllocNode(AN_ARG); ASTLeft[argSeq] := CurASTNode;
        ASTLeft[node] := argSeq;
        CurASTNode := node;
        LastExprTk := tyInt64;
        Exit;

             (atRecv <> REC_UCLASS_BASE + FindUClass('TPyDict')) and
             (atRecv <> REC_UCLASS_BASE + FindUClass('TPyRange')) and
             (atRecv <> REC_UCLASS_BASE + FindUClass('TPyBytes')) then

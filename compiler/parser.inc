            ASTRight[argSeq] := -1;
            node := AllocNode(AN_CALL);
            ASTIVal[node] := atDflt;
            ASTLeft[node] := argSeq;
            ASTTk[node] := Ord(tyAnsiString);
            CurASTNode := node; LastExprTk := tyAnsiString;

    'm': Result := 496;
    'n': Result := 552;
    'o': Result := 80;
    'p': Result := 248;
    'q': Result := 32;
    'r': Result := 5104;
    's': Result := 4080;
    't': Result := 496;
    'u': Result := 352;
    'v': Result := 896;
    'w': Result := 96;

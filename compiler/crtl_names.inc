      ' utimensat:time.h utimes:sys/time.h utmpxname:utmpx.h ';
    'v': Result :=
      ' valloc:stdlib.h vasprintf:stdio.h vdprintf:stdio.h verr:err.h verrx:err.h vfork:unistd.h ' +
      ' vfprintf:stdio.h vfscanf:stdio.h vprintf:stdio.h vscanf:stdio.h vsnprintf:stdio.h ' +
      ' vsprintf:stdio.h vsscanf:stdio.h vsyslog:syslog.h vwarn:err.h vwarnx:err.h ';
    'w': Result :=
      ' wait:sys/wait.h wait3:sys/wait.h wait4:sys/wait.h waitpid:sys/wait.h warn:err.h ' +
      ' warnx:err.h wcrtomb:wchar.h wcscat:wchar.h wcschr:wchar.h wcscmp:wchar.h wcscpy:wchar.h ' +
      ' wcscspn:wchar.h wcsdup:wchar.h wcslen:wchar.h wcsncat:wchar.h wcsncmp:wchar.h ' +
      ' wcsncpy:wchar.h wcsnlen:wchar.h wcspbrk:wchar.h wcsrchr:wchar.h wcsspn:wchar.h ' +
      ' wcsstr:wchar.h wcstombs:stdlib.h wcswidth:wchar.h wctob:wchar.h wctomb:stdlib.h ' +
      ' wctype:wctype.h wcwidth:wchar.h wmemchr:wchar.h wmemcmp:wchar.h wmemcpy:wchar.h ' +
      ' wmemmove:wchar.h wmemset:wchar.h write:unistd.h writev:sys/uio.h ';
  else Result := '';
  end;
end;

{ Bit L set = this bucket holds a name of length L (1..30). The implicit-call
  sweep tests this BEFORE scanning the bucket, which rejects almost every
  identifier in real C source in one AND: crtl's names are short and a
  codebase's own are not (sqlite3VdbeMemGrow is 18 characters and no bucket
  has an 18). Without it the sweep cost +25% on sqlite's amalgamation, since
  it can no longer stop early the way five fixed headers allowed. }
function CrtlNameLenMask(c: Char): Integer;
begin
  case c of
    '_': Result := 544;
    'a': Result := 288760;
    'b': Result := 9585592;
    'c': Result := 180216;
    'd': Result := 4088;
    'e': Result := 32760;
    'f': Result := 65520;
    'g': Result := 131024;
    'h': Result := 608;
    'i': Result := 229360;
    'j': Result := 128;
    'k': Result := 208;
    'l': Result := 7928;
    'm': Result := 301040;
    'n': Result := 360376;
    'o': Result := 16592;
    'p': Result := 1737621496;
    'q': Result := 160;
    'r': Result := 8176;
    's': Result := 4620280;
    't': Result := 8184;
    'u': Result := 992;
    'v': Result := 1008;
    'w': Result := 496;
  else Result := 0;
  end;
end;


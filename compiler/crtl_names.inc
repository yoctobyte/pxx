{ Bit L set = this bucket holds a name of length L (1..30). The implicit-call
  sweep tests this BEFORE scanning the bucket, which rejects almost every
  identifier in real C source in one AND: crtl's names are short and a
  codebase's own are not (sqlite3VdbeMemGrow is 18 characters and no bucket
  has an 18). Without it the sweep cost +25% on sqlite's amalgamation, since
  it can no longer stop early the way five fixed headers allowed. }
function CrtlNameLenMask(c: Char): Integer;
begin
  case c of
    '_': Result := 32;
    'a': Result := 1016;
    'b': Result := 400;
    'c': Result := 143352;
    'd': Result := 440;
    'e': Result := 6008;
    'f': Result := 64496;
    'g': Result := 81872;
    'h': Result := 608;
    'i': Result := 88032;
    'k': Result := 144;
    'l': Result := 3832;
    'm': Result := 496;
    'n': Result := 2600;
    'o': Result := 208;
    'p': Result := 108792;
    'q': Result := 32;
    'r': Result := 5104;
    's': Result := 4333560;
    't': Result := 3064;
    'u': Result := 992;
    'v': Result := 992;
    'w': Result := 240;
